(
  deftype Expr
  (
    Expr ExprInner
  )
)
(
  defn Expr.inner
  (
    e
  )
  (
    match e
    (
      Expr i i
    )
  )
)
(
  defn ast-nth
  (
    xs n fb
  )
  (
    match xs
    (
      Nil fb
    )
    (
      Cons h t
      (
        if
        (
          = n 0
        )
        h
        (
          ast-nth t
          (
            - n 1
          )
          fb
        )
      )
    )
  )
)
(
  defn ast-list-last
  (
    xs fb
  )
  (
    match xs
    (
      Nil fb
    )
    (
      Cons h t
      (
        if
        (
          nil? t
        )
        h
        (
          ast-list-last t fb
        )
      )
    )
  )
)
(
  defn ast-list-butlast
  (
    xs
  )
  (
    ast-list-butlast-acc xs Nil
  )
)
(
  defn ast-list-butlast-acc
  (
    xs acc
  )
  (
    match xs
    (
      Nil
      (
        list-reverse acc
      )
    )
    (
      Cons h t
      (
        if
        (
          nil? t
        )
        (
          list-reverse acc
        )
        (
          ast-list-butlast-acc t
          (
            Cons h acc
          )
        )
      )
    )
  )
)
(
  defn ast-has-at-least
  (
    xs n
  )
  (
    if
    (
      = n 0
    )
    true
    (
      match xs
      (
        Nil false
      )
      (
        Cons d1 t
        (
          ast-has-at-least t
          (
            - n 1
          )
        )
      )
    )
  )
)
(
  defn unwrap-or-expr
  (
    opt fb
  )
  (
    match opt
    (
      Some e e
    )
    (
      None fb
    )
  )
)
(
  defn convert-ast
  (
    ast
  )
  (
    match ast
    (
      AstIdent s
      (
        let
        (
          atom
          (
            AIdent s
          )
        )
        (
          Expr
          (
            EAtom atom
          )
        )
      )
    )
    (
      AstInt n
      (
        let
        (
          atom
          (
            AInt n
          )
        )
        (
          Expr
          (
            EAtom atom
          )
        )
      )
    )
    (
      AstFloat s
      (
        let
        (
          atom
          (
            AFloat s
          )
        )
        (
          Expr
          (
            EAtom atom
          )
        )
      )
    )
    (
      AString s
      (
        let
        (
          atom
          (
            AStr s
          )
        )
        (
          Expr
          (
            EAtom atom
          )
        )
      )
    )
    (
      AstBool b
      (
        let
        (
          atom
          (
            ABool b
          )
        )
        (
          Expr
          (
            EAtom atom
          )
        )
      )
    )
    (
      AList lst
      (
        if
        (
          nil? lst
        )
        (
          Expr
          (
            EAtom ANil
          )
        )
        (
          convert-list-to-exprinner lst
        )
      )
    )
  )
)
(
  defn convert-ast-list
  (
    ast-list
  )
  (
    match ast-list
    (
      Nil Nil
    )
    (
      (
        Cons a rest
      )
      (
        Cons
        (
          convert-ast a
        )
        (
          convert-ast-list rest
        )
      )
    )
  )
)
(
  defn convert-list-to-exprinner
  (
    ast-list
  )
  (
    match ast-list
    (
      Nil
      (
        Expr
        (
          EAtom ANil
        )
      )
    )
    (
      Cons head rest
      (
        match head
        (
          AstIdent n
          (
            dispatch-special n rest
          )
        )
        (
          d1
          (
            Expr
            (
              ECall
              (
                convert-ast head
              )
              (
                convert-ast-list rest
              )
            )
          )
        )
      )
    )
  )
)
