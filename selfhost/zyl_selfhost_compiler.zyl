    kv-get
    (
      mc-ktypes ctx
    )
    name
    (
      TVar 0
    )
  )
)
(
  defn filter-non-tvar
  (
    lst
  )
  (
    match lst
    (
      Nil Nil
    )
    (
      (
        Cons h t
      )
      (
        if
        (
          = h
          (
            TVar 0
          )
        )
        (
          filter-non-tvar t
        )
        (
          Cons h
          (
            filter-non-tvar t
          )
        )
      )
    )
  )
)
(
  defn add-builtin-numeric-types
  (
    result
  )
  (
    let r1
    (
      if
      (
        list-contains result TInt
      )
      result
      (
        list-push result TInt
      )
    )
    (
      let r2
      (
        if
        (
          list-contains r1 TFloat
        )
        r1
        (
          list-push r1 TFloat
        )
      )
      (
        if
        (
          list-contains r2 TBool
        )
        r2
        (
          list-push r2 TBool
        )
      )
    )
  )
)
(
  defn is-auto-derived-trait
  (
    trait-name
  )
  (
    or
    (
      = trait-name
      "Eq"
    )
    (
      or
      (
        = trait-name
        "Ord"
      )
      (
        or
        (
          = trait-name
          "Debug"
        )
        (
          or
          (
            = trait-name
            "Clone"
          )
          (
            = trait-name
            "Hash"
          )
        )
      )
    )
  )
)
(
  defn find-satisfying-types
  (
    ctx trait-name
  )
  (
    let impls
    (
      kv-get
      (
        mc-timpls ctx
      )
      trait-name Nil
    )
    (
      let result
      (
        filter-non-tvar impls
      )
      (
        if
        (
          is-auto-derived-trait trait-name
        )
        (
          add-builtin-numeric-types result
        )
        result
      )
    )
  )
)
(
  defn check-trait-bound
  (
    ctx ty trait-name
  )
  (
    if
    (
      or
      (
        = ty TInt
      )
      (
        = ty TFloat
      )
      (
        = ty TBool
      )
      (
        = ty TString
      )
    )
    true
    (
      let impls
      (
        kv-get
        (
          mc-timpls ctx
        )
        trait-name Nil
      )
      (
        list-contains impls ty
      )
    )
  )
)
(
  defn extract-mono-params
  (
    params
  )
  (
    match params
    (
      Nil Nil
    )
    (
      Cons p rest
      (
        let pname
        (
          match p
          (
            P n d1 n
          )
        )
        (
          let pbounds
          (
            match
            (
              P.type p
            )
            (
              Some v
              (
                Cons v Nil
              )
            )
            (
              d1 Nil
            )
          )
          (
            if
            (
              is-uppercase-ident pname
            )
            (
              Cons
              (
                MP pname pbounds
              )
              (
                extract-mono-params rest
              )
            )
            (
              extract-mono-params rest
            )
          )
        )
      )
    )
  )
)
(
  defn ast-ident-name
  (
    a
  )
  (
    match a
    (
      EAtom
      (
        AIdent n2
      )
      (
        Some n2
      )
    )
    (
      d1 Nil
    )
  )
)
(
  defn ast-apply-args
  (
    a
  )
  (
    match a
    (
      EApply d2 ps ps
    )
    (
      ECall d3 ps ps
    )
    (
      d1 Nil
    )
  )
)
(
  defn discover-mono-param
  (
    i p
  )
  (
    let pn
    (
      match
      (
        ast-ident-name p
      )
      (
        Some v v
      )
      (
        d1
        (
          str-concat
          "T"
          (
            string i
          )
        )
      )
    )
    (
      MP pn Nil
    )
  )
)
(
  defn discover-from-ast-one
  (
    gen-fns expr
  )
  (
    match
    (
      Expr.inner expr
    )
    (
      EDefn name params body
      (
        let mp
        (
          extract-mono-params params
        )
        (
          if
          (
            >
            (
              list-length mp
            )
            0
          )
          (
            kv-set gen-fns name
            (
              list-push
              (
                kv-get gen-fns name Nil
              )
              (
                list-first mp
              )
            )
          )
          gen-fns
        )
      )
    )
    (
      EApply
      "defn"
      args
      (
        if
        (
          >
          (
            list-length args
          )
          2
        )
        (
          let n
          (
            match
            (
              ast-ident-name
              (
                list-nth args 0
              )
            )
            (
              Some v v
            )
            (
              d1 nil
            )
          )
          (
            let pexprs
            (
              ast-apply-args
              (
                list-nth args 1
              )
            )
            (
              let mp
              (
                list-map-indexed discover-mono-param pexprs
              )
              (
                if
                (
                  and n
                  (
                    >
                    (
                      list-length mp
                    )
                    0
                  )
                )
                (
                  kv-set gen-fns n
                  (
                    list-push
                    (
                      kv-get gen-fns n Nil
                    )
                    (
                      list-first mp
                    )
                  )
                )
                gen-fns
              )
            )
          )
        )
        gen-fns
      )
    )
    (
      d1 gen-fns
    )
  )
)
(
  defn discover-from-ast-loop
  (
    gen-fns exprs
  )
  (
    match exprs
    (
      Nil gen-fns
    )
    (
      Cons expr rest
      (
        discover-from-ast-loop
        (
          discover-from-ast-one gen-fns expr
        )
        rest
      )
    )
  )
)
(
  defn discover-from-ast
  (
    ctx exprs
  )
