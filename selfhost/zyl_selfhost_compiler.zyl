      )
    )
  )
)
(
  defn lookup-fn-sigs
  (
    ctx name
  )
  (
    kv-get
    (
      mc-known-fns ctx
    )
    name Nil
  )
)
(
  defn mono-lookup-known-type
  (
    ctx name
  )
  (
    kv-get
    (
      mc-ktypes ctx
    )
    name
    (
      TVar 0 TUnit
    )
  )
)
(
  defn filter-non-tvar
  (
    lst
  )
  (
    match lst
    (
      Nil Nil
    )
    (
      (
        Cons h t
      )
      (
        if
        (
          = h
          (
            TVar 0 TUnit
          )
        )
        (
          filter-non-tvar t
        )
        (
          Cons h
          (
            filter-non-tvar t
          )
        )
      )
    )
  )
)
(
  defn add-builtin-numeric-types
  (
    result
  )
  (
    let r1
    (
      if
      (
        list-contains result TInt
      )
      result
      (
        list-push result TInt
      )
    )
    (
      let r2
      (
        if
        (
          list-contains r1 TFloat
        )
        r1
        (
          list-push r1 TFloat
        )
      )
      (
        if
        (
          list-contains r2 TBool
        )
        r2
        (
          list-push r2 TBool
        )
      )
    )
  )
)
(
  defn is-auto-derived-trait
  (
    trait-name
  )
  (
    or
    (
      = trait-name
      "Eq"
    )
    (
      or
      (
        = trait-name
        "Ord"
      )
      (
        or
        (
          = trait-name
          "Debug"
        )
        (
          or
          (
            = trait-name
            "Clone"
          )
          (
            = trait-name
            "Hash"
          )
        )
      )
    )
  )
)
(
  defn find-satisfying-types
  (
    ctx trait-name
  )
  (
    let impls
    (
      kv-get
      (
        mc-timpls ctx
      )
      trait-name Nil
    )
    (
      let result
      (
        filter-non-tvar impls
      )
      (
        if
        (
          is-auto-derived-trait trait-name
        )
        (
          add-builtin-numeric-types result
        )
        result
      )
    )
  )
)
(
  defn check-trait-bound
  (
    ctx ty trait-name
  )
  (
    if
    (
      or
      (
        = ty TInt
      )
      (
        = ty TFloat
      )
      (
        = ty TBool
      )
      (
        = ty TString
      )
    )
    true
    (
      let impls
      (
        kv-get
        (
          mc-timpls ctx
        )
        trait-name Nil
      )
      (
        list-contains impls ty
      )
    )
  )
)
(
  defn extract-mono-params
  (
    params
  )
  (
    match params
    (
      Nil Nil
    )
    (
      Cons p rest
      (
        let pname
        (
          match p
          (
            P n d1 n
          )
        )
        (
          let pbounds
          (
            match
            (
              P.type p
            )
            (
              Some v
              (
                Cons v Nil
              )
            )
            (
              d1 Nil
            )
          )
          (
            if
            (
              is-uppercase-ident pname
            )
            (
              Cons
              (
                MP pname pbounds
              )
              (
                extract-mono-params rest
              )
            )
            (
              extract-mono-params rest
            )
          )
        )
      )
    )
  )
)
(
  defn ast-ident-name
  (
    a
