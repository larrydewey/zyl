; ===== AUTO-ASSEMBLED SELF-HOSTED COMPILER (boot source) =====

; ---------- stdlib/core/list.zyl ----------
; === Zyl Standard Library — List ADT ===
; Module: list
; Provides: Generic List<T> ADT and list utilities
;
; list-car returns Option<T>, requires Option to be in scope
; (provided via core/core.zyl which imports option before list)

; ===========================================================================
; LIST ADT — Generic: List<T>
; ===========================================================================

(deftype List (Cons T (List T)) None)

; ===========================================================================
; LIST OPERATIONS
; ===========================================================================

(defn is-nil (xs)
  (match xs
    (Cons _ _ false)
    (None true)))

(defn list-car (xs)
  (match xs
    (Cons v _ (Some v))
    (None None)))

(defn list-cdr (xs)
  (match xs
    (Cons _ rest rest)
    (None None)))

; Length
(defn list-length (xs)
  (match xs
    (None 0)
    (Cons _ rest (+ 1 (list-length rest)))))

; Append
(defn list-append (xs ys)
  (match xs
    (None ys)
    (Cons h t (Cons h (list-append t ys)))))

; Reverse
(defn list-reverse (xs)
  (list-reverse-acc xs None))

(defn list-reverse-acc (xs acc)
  (match xs
    (None acc)
    (Cons h t (list-reverse-acc t (Cons h acc)))))

; Sum of list (Int only — monomorphized by use site)
(defn list-sum (xs)
  (match xs
    (None 0)
    (Cons h t (+ h (list-sum t)))))

; ---------- stdlib/allocator/allocator.zyl ----------
; === Zyl Standard Library — Allocator ===
; Module: allocator
; Provides: Raw memory arena backed by C runtime helpers.
;           All addresses are Ints (64-bit pointers).
;
; NOTE: No garbage collection or refcounting. Callers are responsible for
;       freeing memory via `alloc-free`. Deterministic by design (region §).

; ===========================================================================
; RAW ALLOCATION
; ===========================================================================

; Allocate `size` bytes on the heap. Returns address as Int, or 0 on failure.
; Returns: Int (address)
(defn alloc-malloc (size)
  (ffi-call "zyl_mem_alloc" size 1000))

; Free memory previously returned by `alloc-malloc`.
; Returns: Unit
(defn alloc-free (ptr)
  (ffi-call "zyl_mem_free" ptr 1000))

; ===========================================================================
; TYPED ACCESS
; ===========================================================================

; Read a 64-bit integer from `addr`.
; Returns: Int
(defn alloc-read-int (addr)
  (ffi-call "zyl_mem_read" addr 1000))

; Write a 64-bit integer to `addr`.
; Returns: Unit
(defn alloc-write-int (addr value)
  (ffi-call "zyl_mem_write" addr value 1000))

; Allocate a single 64-bit integer slot initialized to `value`.
; Returns: Int (address)
(defn alloc-int (value)
  (let p (alloc-malloc 8)
    (begin
      (alloc-write-int p value)
      p)))

; ===========================================================================
; STRING LENGTH
; ===========================================================================

; Return the byte length of a NUL-terminated C string at `ptr`, excluding the
; terminator. Returns: Int
(defn alloc-strlen (ptr)
  (ffi-call "zyl_cstr_len" ptr 1000))

; ===========================================================================
; BOXED HELPERS
; ===========================================================================

; Increment the integer stored at `addr` by 1 (non-atomic).
; Returns: Unit
(defn alloc-incr (addr)
  (alloc-write-int addr (+ (alloc-read-int addr) 1)))

; Decrement the integer stored at `addr` by 1 (non-atomic).
; Returns: Unit
(defn alloc-decr (addr)
  (alloc-write-int addr (- (alloc-read-int addr) 1)))

; ===========================================================================
; REGION-BASED ARENA ALLOCATOR
; ===========================================================================
;
; Arenas give deterministic, zero-fragmentation bulk reclamation:
;   - bump allocation from growable 16-byte-aligned blocks
;   - `arena-reset` frees every block at once (handle stays valid)
;   - `arena-destroy` frees everything including the handle
; No per-object free. Arenas are single-threaded by design (one per
; actor/scope, matching actor isolation). All addresses are Ints.
;
; Usage:
;   (let a (arena-create 0)         ; default 64 KiB blocks
;     (begin
;       (let p (arena-alloc-zeroed a 1024)
;         (begin
;           ... use p ...
;           (arena-reset a)))       ; reclaim, reuse `a`
;       (arena-destroy a)))         ; release everything

; Create a new arena. `block-size` is the default block size in bytes;
; values < 16 select the default (64 KiB). Returns a handle (Int), or 0
; on failure.
; Returns: Int (handle)
(defn arena-create (block-size)
  (ffi-call "zyl_arena_create" block-size 1000))

; Allocate `size` bytes from `arena`, 16-byte aligned. Returns an address
; (Int), or 0 on failure.
; Returns: Int (address)
(defn arena-alloc (arena size)
  (ffi-call "zyl_arena_alloc" arena size 1000))

; Allocate `size` zero-initialized bytes from `arena`. Returns an address
; (Int), or 0 on failure.
; Returns: Int (address)
(defn arena-alloc-zeroed (arena size)
  (ffi-call "zyl_arena_alloc_zeroed" arena size 1000))

; Free every block in `arena` at once. The handle stays valid and the arena
; can be reused immediately.
; Returns: Unit
(defn arena-reset (arena)
  (ffi-call "zyl_arena_reset" arena 1000))

; Free every block in `arena` and invalidate the handle.
; Returns: Unit
(defn arena-destroy (arena)
  (ffi-call "zyl_arena_destroy" arena 1000))

; Bytes currently allocated from `arena`.
; Returns: Int
(defn arena-used (arena)
  (ffi-call "zyl_arena_used" arena 1000))

; Total block capacity backing `arena`.
; Returns: Int
(defn arena-capacity (arena)
  (ffi-call "zyl_arena_capacity" arena 1000))

; ===========================================================================
; STRING HELPERS
; ===========================================================================

; Byte length of a NUL-terminated string at `ptr`, excluding terminator.
; Returns: Int
(defn str-len (ptr)
  (alloc-strlen ptr))

; Intern a String into `arena`: copy its bytes (including terminator) into a
; fresh zeroed buffer. Returns the buffer pointer.
; Returns: Int (pointer)
(defn str-intern (arena s)
  (let n (alloc-strlen s)
    (let p (arena-alloc-zeroed arena (+ n 1))
      (begin
        (buf-append p s)
        p))))

; Whether two NUL-terminated strings are byte-identical.
; Returns: Bool (0/1)
(defn str-eq (p1 p2)
  (ffi-call "zyl_cstr_eq" p1 p2 1000))

; ---------- stdlib/compiler/ast.zyl ----------
; === Zyl Standard Library — Compiler AST types ===
; Module: compiler/ast
;
; The compiler front-end is built entirely on recursive algebraic data
; types (spec §9 deftype). There are no flat pools, no raw arena record
; layouts, and no index-based node tables anywhere in stdlib/compiler.
;
;   Token  — lexer output; a token stream is a (List Token)
;   Ast    — reader/parser output; source trees are nested AList forms
;            (Zyl's no-dispatch parsing: special forms are recognised by
;            the consumer, not by the parser)
;   Env    — immutable name→slot chain used by lowering/codegen
;   VTable — immutable variant-name→(tag, arity) chain for ADTs
;   Icnf   — lowered instruction tree (see compiler/icnf)
;
; All recursion is structural over these types.

(deftype Token
  (TkEof)
  (TkIdent String)
  (TkInt Int)
  (TkFloat String)
  (TkString String)
  (TkBool Bool)
  (TkSymbol String)
  (TkKeyword String)
  (TkLParen)
  (TkRParen)
  (TkLBrace)
  (TkRBrace)
  (TkLBracket)
  (TkRBracket)
  (TkColon))

; A parsed s-expression: an atom or a parenthesised list of forms.
(deftype Ast
  (AIdent String)
  (AInt Int)
  (AFloat String)
  (AString String)
  (ABool Bool)
  (AList (List Ast)))

; Immutable environment chain: name -> stack slot offset from rbp.
(deftype Env
  (EnvBind String Int Int Env)   ; name, rbp-offset, kind (0 int,1 str,2 float)
  (EnvNil))

; Look up a name in an Env chain.
; Returns: Int (offset, or 0 if unbound)
(defn env-lookup (env name)
  (match env
    (EnvBind n off  w1 rest (if (str-eq n name) off (env-lookup rest name)))
    (EnvNil 0)))

; Look up the kind of a name in an Env chain.
; Returns: Int (0 int, 1 str, 2 float, 0 if unbound)
(defn env-kind-of (env name)
  (match env
    (EnvBind n  w2 k rest (if (str-eq n name) k (env-kind-of rest name)))
    (EnvNil 0)))

; Immutable variant table: variant name -> tag + field count.
(deftype VTable
  (VTEntry String Int Int VTable)  ; variant name, tag, arity
  (VTNil))

(defn vt-tag-of (vt name)
  (match vt
    (VTEntry n tag  w3 rest (if (str-eq n name) tag (vt-tag-of rest name)))
    (VTNil -1)))

(defn vt-arity-of (vt name)
  (match vt
    (VTEntry n  w4 ar rest (if (str-eq n name) ar (vt-arity-of rest name)))
    (VTNil -1)))

; Head of a token stream (TkEof when empty).
(defn toks-head (toks)
  (match toks
    (Cons t rest t)
    (None (TkEof))))

(defn toks-tail (toks)
  (match toks
    (Cons t rest rest)
    (None None)))

; ---------- stdlib/compiler/lexer.zyl ----------
; === Zyl Standard Library — Compiler Lexer ===
; Module: compiler/lexer
; Provides: A deterministic tokenizer for Zyl source.
;
; Input:  a NUL-terminated source buffer (Int pointer).
; Output: a (List Token) in source order (see compiler/ast), ending with
;         a single TkEof.
;
; Determinism: source scanned strictly left-to-right; stream order
; preserved by construction (each step conses onto the returned stream).
; Strings are not deduplicated (source order).
;
; NOTE: comments (`;` .. end of line) are skipped inline, producing the
; same token stream as the Rust lexer for identical source.



; ===========================================================================
; CHARACTER CLASSES (byte values; ASCII)
; ===========================================================================

(defn is-ws (c)
  (if (= c 32) 1 (if (= c 9) 1 (if (= c 13) 1 (if (= c 10) 1 0)))))

(defn is-digit (c)
  (if (>= c 48)
    (if (<= c 57) 1 0)
    0))

(defn is-upper (c)
  (if (>= c 65)
    (if (<= c 90) 1 0)
    0))

(defn is-lower (c)
  (if (>= c 97)
    (if (<= c 122) 1 0)
    0))

(defn is-alpha (c)
  (if (is-upper c) 1 (is-lower c)))

; Mirror Rust lexer.rs is_ident_start: alpha | _ - ? ! + / = < > * %
(defn is-ident-start (c)
  (if (is-alpha c)
    1
    (if (= c 95) 1
      (if (= c 45) 1
        (if (= c 63) 1
          (if (= c 33) 1
            (if (= c 43) 1
              (if (= c 47) 1
                (if (= c 61) 1
                  (if (= c 60) 1
                    (if (= c 62) 1
                      (if (= c 42) 1
                        (if (= c 37) 1 0)))))))))))))

; Mirror Rust lexer.rs is_ident_continue: alnum | _ - ? ! / = + % .
(defn is-ident-cont (c)
  (if (is-alpha c)
    1
    (if (is-digit c)
      1
      (if (= c 95) 1
        (if (= c 45) 1
          (if (= c 63) 1
            (if (= c 33) 1
              (if (= c 47) 1
                (if (= c 61) 1
                  (if (= c 43) 1
                    (if (= c 37) 1
                      (if (= c 46) 1 0))))))))))))

(defn is-semicolon (c) (if (= c 59) 1 0))

; ===========================================================================
; SCANS
; ===========================================================================

; Byte at `i` in `src` (NUL-terminated).
; Returns: Int
(defn byte-at (src i)
  (ffi-call "zyl_cstr_byte_at" src i 1000))

; End index of an identifier starting at `start`. Returns: end (exclusive)
(defn scan-ident-from (src len i)
  (if (>= i len)
    i
    (if (= (is-ident-cont (byte-at src i)) 1)
      (scan-ident-from src len (+ i 1))
      i)))

(defn scan-ident (src len start)
  (scan-ident-from src len (+ start 1)))

; End index of a numeric literal starting at `start`: optional sign,
; digits/'.' run, then optional e/E [+-] digits. Returns: end (exclusive)
(defn scan-num-chars (src len i)
  (if (>= i len)
    i
    (let c (byte-at src i)
      (if (= (is-digit c) 1)
        (scan-num-chars src len (+ i 1))
        (if (= c 46)
          (scan-num-chars src len (+ i 1))
          i)))))

(defn scan-exp-digits (src len i)
  (if (>= i len)
    i
    (if (= (is-digit (byte-at src i)) 1)
      (scan-exp-digits src len (+ i 1))
      i)))

(defn scan-exp (src len i)
  ; i points at e/E
  (let j (+ i 1)
    (if (>= j len)
      j
      (let b (byte-at src j)
        (let j2 (if (or2 (= b 43) (= b 45)) (+ j 1) j))
        (scan-exp-digits src len j2)))))

; small helper: logical or on two 0/1 values (avoids and/or forms)
(defn or2 (a b)
  (if (= a 0)
    (if (= b 0) 0 1)
    1))

(defn scan-number (src len start)
  (let i (if (= (byte-at src start) 45) (+ start 1) start)
    (let mid (scan-num-chars src len i)
      (if (>= mid len)
        mid
        (let c (byte-at src mid)
          (if (or2 (= c 101) (= c 69))
            (scan-exp src len mid)
            mid))))))

; Index of the closing '"' (or -1 if unterminated) for a string whose
; opening quote is at `start`. Handles escapes (skip byte after '\').
; Returns: Int (index of closing quote)
(defn scan-str (src len i)
  (if (>= i len)
    -1
    (let b (byte-at src i)
      (if (= b 92)
        (if (<= (+ i 1) (- len 1))
          (scan-str src len (+ i 2))
          0)
        (if (= b 34)
          i
          (scan-str src len (+ i 1)))))))

(defn str-end (src len start)
  (scan-str src len (+ start 1)))

; Whether a numeric text contains '.' or 'e'/'E' (i.e. is a float literal).
; Returns: Bool (0/1)
(defn has-float-marker (text)
  (let n (alloc-strlen text)
    (scan-float-marker text n 0)))

(defn scan-float-marker (text n i)
  (if (>= i n)
    0
    (let c (byte-at text i)
      (if (= (or2 (= c 46) (or2 (= c 101) (= c 69))) 1)
        1
        (scan-float-marker text n (+ i 1))))))

; End of a `;`-comment: first '\n' index (exclusive), or len.
; Returns: Int
(defn comment-end (src len i)
  (if (>= i len)
    len
    (if (= (byte-at src i) 10)
      i
      (comment-end src len (+ i 1)))))

; Index of the first non-whitespace byte at or after `i`, or -1 if none.
; Returns: Int
(defn peek-nonws (src len i)
  (if (>= i len)
    -1
    (if (is-ws (byte-at src i))
      (peek-nonws src len (+ i 1))
      i)))

; Delimiters that stop a keyword/symbol head: ( ) { } [ ] : ~
(defn is-punctuator (c)
  (if (= c 40) 1
    (if (= c 41) 1
      (if (= c 123) 1
        (if (= c 125) 1
          (if (= c 91) 1
            (if (= c 93) 1
              (if (= c 58) 1 (if (= c 126) 1 0)))))))))

; ===========================================================================
; MAIN LEXER
; ===========================================================================
;
; NOTE: the scanner threads its cursor through a small state record
; (arena cells) rather than long argument lists — the Rust codegen's
; >6-argument call path is known-fragile, and the self-hosted compiler
; therefore keeps every call at 6 arguments or fewer.
;
; State cells: [0]=arena [8]=src [16]=len [24]=i [32]=line [40]=col

(defn lex-state-new (arena src)
  (let st (arena-alloc-zeroed arena 48)
    (begin
      (alloc-write-int st arena)
      (alloc-write-int (+ st 8) src)
      (alloc-write-int (+ st 16) (alloc-strlen src))
      (alloc-write-int (+ st 24) 0)
      (alloc-write-int (+ st 32) 1)
      (alloc-write-int (+ st 40) 1)
      st)))

(defn lex-st-arena (st) (alloc-read-int st))
(defn lex-st-src (st) (alloc-read-int (+ st 8)))
(defn lex-st-len (st) (alloc-read-int (+ st 16)))

(defn lex-st-i (st) (alloc-read-int (+ st 24)))
(defn lex-st-line (st) (alloc-read-int (+ st 32)))
(defn lex-st-col (st) (alloc-read-int (+ st 40)))

(defn lex-st-set-i (st v) (alloc-write-int (+ st 24) v))
(defn lex-st-set-line (st v) (alloc-write-int (+ st 32) v))
(defn lex-st-set-col (st v) (alloc-write-int (+ st 40) v))

; Advance past one character.
(defn lex-st-adv (st n)
  (begin
    (lex-st-set-col st (+ (lex-st-col st) n))
    (lex-st-set-i st (+ (lex-st-i st) n))))

; Newline: advance line, reset column.
(defn lex-st-nl (st)
  (begin
    (lex-st-set-line st (+ (lex-st-line st) 1))
    (lex-st-set-col st 1)
    (lex-st-set-i st (+ (lex-st-i st) 1))))

; Lex `src` (NUL-terminated) into a (List Token) in source order,
; terminated by a single TkEof.
; Returns: List(Token)
(defn zyl-lex (arena src)
  (let st (lex-state-new arena src)
    (let rev (lex-loop st None)
      ; rev is reverse source order with the TkEof at its head; reversing
      ; yields source order terminated by the single TkEof.
      (list-reverse rev))))

; The scanner loop: consume whitespace/comments, then one token per step.
; Returns: List(Token) in reverse source order.
(defn lex-loop (st acc)
  (if (>= (lex-st-i st) (lex-st-len st))
    (Cons (TkEof) acc)
    (let c (byte-at (lex-st-src st) (lex-st-i st))
      (if (= (is-ws c) 1)
        (if (= c 10)
          (begin
            (lex-st-nl st)
            (lex-loop st acc))
          (begin
            (lex-st-adv st 1)
            (lex-loop st acc)))
        (if (= (is-semicolon c) 1)
          (begin
            (lex-st-set-i st (comment-end (lex-st-src st) (lex-st-len st) (+ (lex-st-i st) 1)))
            (lex-loop st acc))
          (lex-token st acc c))))))

; Character -> kind code: 1-6 punctuators, 7 colon-kw, 8 symbol,
; 9 string, 10 digit, 11 '-', 12 ident-start, 0 unrecognized.
(defn lex-kind (c)
  (if (= c 40) 1
  (if (= c 41) 2
  (if (= c 123) 3
  (if (= c 125) 4
  (if (= c 91) 5
  (if (= c 93) 6
  (if (= c 58) 7
  (if (= c 126) 8
  (if (= c 34) 9
  (if (> (is-digit c) 0) 10
  (if (= c 45) 11
  (if (> (is-ident-start c) 0) 12
    0)))))))))))))

; Lex one token starting at the cursor, then continue scanning.
; Returns: List(Token)
(defn lex-token (st acc c)
  (let k (lex-kind c)
    (if (> k 0)
      (if (< k 7)
        (lex-dispatch-punct st acc k)
        (if (< k 9)
          (lex-keywordish st acc (- k 7))
          (if (= k 9)
            (lex-string st acc)
            (lex-word st acc c))))
      (Cons (TkEof) acc))))   ; unrecognized char -> terminate with EOF

; Punctuator tokens: kinds 1..6.
(defn lex-dispatch-punct (st acc k)
  (let tok (if (= k 1)
             (TkLParen)
             (if (= k 2)
               (TkRParen)
               (if (= k 3)
                 (TkLBrace)
                 (if (= k 4)
                   (TkRBrace)
                   (if (= k 5)
                     (TkLBracket)
                     (TkRBracket))))))
    (begin
      (lex-st-adv st 1)
      (lex-loop st (Cons tok acc)))))

; ':' / '~' followed by an ident char -> keyword / symbol; bare colon otherwise.
; kind: 0 = keyword branch, 1 = symbol branch.
(defn lex-keywordish (st acc kind)
  (let src (lex-st-src st))
  (let len (lex-st-len st))
  (let i (lex-st-i st))
  (let probe (+ i 1))
  (let pk (peek-nonws src len probe))
  (let ok1 (>= pk 0))
  (let ok2 (if (> ok1 0) (is-ident-start (byte-at src pk)) 0))
  (let ok3 (if (> ok2 0) (- 1 (is-punctuator (byte-at src pk))) 0))
  (if (= ok3 1)
    (begin
      (let end (scan-ident src len pk))
      (let text (ffi-call "zyl_cstr_sub" (lex-st-arena st) src pk (- end pk) 1000))
      (let tok (if (= kind 0) (TkKeyword text) (TkSymbol text)))
      (begin
        (lex-st-set-col st (+ (lex-st-col st) (+ 1 (- end i))))
        (lex-st-set-i st end)
        (lex-loop st (Cons tok acc))))
    (begin
      (lex-st-adv st 1)
      (lex-loop st (Cons (TkColon) acc)))))

; String literal at the cursor.
(defn lex-string (st acc)
  (let src (lex-st-src st))
  (let len (lex-st-len st))
  (let i (lex-st-i st))
  (let e (str-end src len i)
    (if (< e 0)
      (Cons (TkEof) acc)   ; unterminated -> EOF
      (let text (ffi-call "zyl_cstr_decode" (lex-st-arena st) src (+ i 1) e 1000)
        (let end (+ e 1)
          (begin
            (lex-st-set-col st (+ (lex-st-col st) (- end i)))
            (lex-st-set-i st end)
            (lex-loop st (Cons (TkString text) acc))))))))

; Numeric or identifier token at the cursor.
(defn lex-word (st acc c)
  (let neg-num (if (= c 45) (is-digit (byte-at (lex-st-src st) (+ (lex-st-i st) 1))) 0)
    (if (> neg-num 0)
      (lex-number st acc)
      (if (> (is-digit c) 0)
        (lex-number st acc)
        (lex-ident st acc)))))

; Numeric literal. TkInt carries the value; TkFloat the raw literal text.
(defn lex-number (st acc)
  (let src (lex-st-src st))
  (let len (lex-st-len st))
  (let i (lex-st-i st))
  (let e (scan-number src len i))
  (let text (ffi-call "zyl_cstr_sub" (lex-st-arena st) src i (- e i) 1000))
  (begin
    (lex-st-set-col st (+ (lex-st-col st) (- e i)))
    (lex-st-set-i st e)
    (if (has-float-marker text)
      (lex-loop st (Cons (TkFloat text) acc))
      (lex-loop st (Cons (TkInt (ffi-call "zyl_cstr_to_int" text 1000)) acc)))))

; Identifier / boolean literal.
(defn lex-ident (st acc)
  (let src (lex-st-src st))
  (let len (lex-st-len st))
  (let i (lex-st-i st))
  (let e (scan-ident src len i))
  (let text (ffi-call "zyl_cstr_sub" (lex-st-arena st) src i (- e i) 1000))
  (let is-true (str-eq text (str-intern (lex-st-arena st) "true")))
  (let is-false (str-eq text (str-intern (lex-st-arena st) "false")))
  (let tok (if (> is-true 0)
             (TkBool true)
             (if (> is-false 0) (TkBool false) (TkIdent text))))
  (begin
    (lex-st-set-col st (+ (lex-st-col st) (- e i)))
    (lex-st-set-i st e)
    (lex-loop st (Cons tok acc))))

; ---------- stdlib/compiler/parser.zyl ----------
; === Zyl Standard Library — Compiler Parser (reader) ===
; Module: compiler/parser
;
; A pure recursive-descent reader over a (List Token) stream, producing
; nested Ast values (see compiler/ast). This is deliberately *dispatch-
; free* (spec architecture decision): every parenthesised form becomes an
; (AList ...); special forms (defn, let, if, ...) are recognised by the
; consumer phases, never by the parser. The Rust compiler's PostProcessor
; responsibilities therefore live in the icnf lowering phase.
;
; read-* functions return an AstTok: the parsed form plus the remaining
; token stream (functional threading, no mutable state).
;
; NOTE: Zyl patterns are flat (VariantName pat* body) and exhaustive, so
;       each ADT gets one total discriminator + payload extractors; the
;       reader itself branches on integer kind codes.



; Result wrapper: parsed Ast + remaining tokens.
(deftype AstTok (AstOf Ast (List Token)))

(defn art-ast (r)  (match r (AstOf a rest a)))
(defn art-rest (r) (match r (AstOf a rest rest)))

; ===========================================================================
; TOKEN DISCRIMINATION (total, exhaustive)
; ===========================================================================
; Codes: 0 eof 1 ident 2 int 3 float 4 string 5 bool 6 symbol 7 keyword
;        8 lparen 9 rparen 10 lbrace 11 rbrace 12 lbracket 13 rbracket 14 colon

(defn tok-code (t)
  (match t
    (TkEof 0)
    (TkIdent  w1 1)
    (TkInt  w2 2)
    (TkFloat  w3 3)
    (TkString  w4 4)
    (TkBool  w5 5)
    (TkSymbol  w6 6)
    (TkKeyword  w7 7)
    (TkLParen 8)
    (TkRParen 9)
    (TkLBrace 10)
    (TkRBrace 11)
    (TkLBracket 12)
    (TkRBracket 13)
    (TkColon 14)))

; Text payload of a token ("" when none).
(defn tok-text (t)
  (match t
    (TkEof "")
    (TkIdent s s)
    (TkInt  w8 "")
    (TkFloat s s)
    (TkString s s)
    (TkBool  w9 "")
    (TkSymbol s s)
    (TkKeyword s s)
    (TkLParen "")
    (TkRParen "")
    (TkLBrace "")
    (TkRBrace "")
    (TkLBracket "")
    (TkRBracket "")
    (TkColon "")))

; Integer payload of a token (0 when none).
(defn tok-int (t)
  (match t
    (TkInt v v)
    (TkEof 0)
    (TkIdent  w10 0)
    (TkFloat  w11 0)
    (TkString  w12 0)
    (TkBool  w13 0)
    (TkSymbol  w14 0)
    (TkKeyword  w15 0)
    (TkLParen 0)
    (TkRParen 0)
    (TkLBrace 0)
    (TkRBrace 0)
    (TkLBracket 0)
    (TkRBracket 0)
    (TkColon 0)))

; Bool payload of a token (false when none).
(defn tok-bool (t)
  (match t
    (TkBool b b)
    (TkEof false)
    (TkIdent  w16 false)
    (TkFloat  w17 false)
    (TkString  w18 false)
    (TkSymbol  w19 false)
    (TkKeyword  w20 false)
    (TkInt  w21 false)
    (TkLParen false)
    (TkRParen false)
    (TkLBrace false)
    (TkRBrace false)
    (TkLBracket false)
    (TkRBracket false)
    (TkColon false)))

; ===========================================================================
; AST DISCRIMINATION
; ===========================================================================
; Codes: 0 ident 1 int 2 float 3 string 4 bool 5 list

(defn ast-code (a)
  (match a
    (AIdent  w22 0)
    (AInt  w23 1)
    (AFloat  w24 2)
    (AString  w25 3)
    (ABool  w26 4)
    (AList  w27 5)))

(defn ast-name (a)
  (match a
    (AIdent s s)
    (AInt  w28 "")
    (AFloat  w29 "")
    (AString  w30 "")
    (ABool  w31 "")
    (AList  w32 "")))

(defn ast-int (a)
  (match a
    (AInt v v)
    (AIdent  w33 0)
    (AFloat  w34 0)
    (AString  w35 0)
    (ABool  w36 0)
    (AList  w37 0)))

(defn ast-text (a)
  (match a
    (AFloat s s)
    (AString s s)
    (AIdent  w38 "")
    (AInt  w39 "")
    (ABool  w40 "")
    (AList  w41 "")))

(defn ast-bool (a)
  (match a
    (ABool b b)
    (AIdent  w42 false)
    (AInt  w43 false)
    (AFloat  w44 false)
    (AString  w45 false)
    (AList  w46 false)))

(defn ast-kids (a)
  (match a
    (AList k k)
    (AIdent  w47 None)
    (AInt  w48 None)
    (AFloat  w49 None)
    (AString  w50 None)
    (ABool  w51 None)))

; ===========================================================================
; STREAM HELPERS
; ===========================================================================

(defn toks-empty (toks)
  (if (is-nil toks)
    true
    (if (= (tok-code (toks-head toks)) 0) true false)))

; ===========================================================================
; READER
; ===========================================================================

; Read one form at the head of `toks`.
; Returns: AstTok
(defn read-form (arena toks)
  (let t (toks-head toks))
  (let rest (toks-tail toks))
  (let k (tok-code t))
  (if (= k 8)
    (read-forms arena rest None)                 ; '(' -> list form
    (if (= k 12)
      (read-forms-bracket arena rest None)       ; '['
      (if (= k 10)
        (read-forms-brace arena rest None)       ; '{'
        (read-form-atom arena t rest k)))))

; Atoms (and closers): kinds 0-7,9,11,13,14.
(defn read-form-atom (arena t rest k)
  (if (= k 2)
    (AstOf (AInt (tok-int t)) rest)
    (if (= k 5)
      (AstOf (ABool (tok-bool t)) rest)
      (if (= k 3)
        (AstOf (AFloat (tok-text t)) rest)
        (read-form-ident arena t rest k)))))

(defn read-form-ident (arena t rest k)
  (if (= k 4)
    (AstOf (AString (tok-text t)) rest)
    (if (= k 1)
      (AstOf (AIdent (tok-text t)) rest)
      (read-form-sym arena t rest k))))

(defn read-form-sym (arena t rest k)
  (if (= k 6)
    (AstOf (AIdent (tok-text t)) rest)
    (if (= k 7)
      (AstOf (AIdent (tok-text t)) rest)
      (AstOf (AList None) rest))))          ; closers/colon/eof: empty

; Read forms until ')' (or EOF), accumulating into `acc`.
; Returns: AstTok wrapping (AList forms...)
(defn read-forms (arena toks acc)
  (if (toks-empty toks)
    (AstOf (AList (list-reverse acc)) toks)
    (if (= (tok-code (toks-head toks)) 9)          ; ')'
      (AstOf (AList (list-reverse acc)) (toks-tail toks))
      (let r (read-form arena toks)
        (read-forms arena (art-rest r) (Cons (art-ast r) acc))))))

(defn read-forms-brace (arena toks acc)
  (if (toks-empty toks)
    (AstOf (AList (list-reverse acc)) toks)
    (if (= (tok-code (toks-head toks)) 11)         ; '}'
      (AstOf (AList (list-reverse acc)) (toks-tail toks))
      (let r (read-form arena toks)
        (read-forms-brace arena (art-rest r) (Cons (art-ast r) acc))))))

(defn read-forms-bracket (arena toks acc)
  (if (toks-empty toks)
    (AstOf (AList (list-reverse acc)) toks)
    (if (= (tok-code (toks-head toks)) 13)         ; ']'
      (AstOf (AList (list-reverse acc)) (toks-tail toks))
      (let r (read-form arena toks)
        (read-forms-bracket arena (art-rest r) (Cons (art-ast r) acc))))))

; Parse a whole source token stream into a program: a List of top-level
; Ast forms in source order.
; Returns: List(Ast)
(defn parse-program (arena toks)
  (list-reverse (parse-program-loop arena toks None)))

(defn parse-program-loop (arena toks acc)
  (if (toks-empty toks)
    acc
    (let r (read-form arena toks)
      (parse-program-loop arena (art-rest r) (Cons (art-ast r) acc)))))

; Convenience: lex + parse in one step from a source buffer pointer.
; Returns: List(Ast)
(defn zyl-parse (arena src)
  (parse-program arena (zyl-lex arena src)))

; ---------- stdlib/compiler/icnf.zyl ----------
; === Zyl Standard Library — Compiler ICNF lowering ===
; Module: compiler/icnf
;
; Lowers the reader's Ast (see compiler/ast) into an explicit instruction
; tree (ICNF). This is where the Rust compiler's PostProcessor
; responsibilities live in the self-hosted pipeline: special forms are
; recognised here by head-symbol name, per the no-dispatch architecture
; decision.
;
; Everything is a recursive algebraic data type — no pools, no indices.



; --- Instruction tree -----------------------------------------------------

(deftype Icnf
  (IConst Int)
  (IStr String)
  (IFlt String)                        ; raw literal text
  (ILoad String)
  (IBinop Int Icnf Icnf)
  (ICall String (List Icnf))           ; user function (symbol-sanitized name)
  (IFfi String (List Icnf))            ; C symbol call (name used verbatim)
  (IPrint Icnf)
  (IIf Icnf Icnf Icnf)
  (IWhile Icnf Icnf)
  (ISet String Icnf)
  (ILet String Icnf Icnf)              ; name, value, body
  (ISeq (List Icnf))
  (IVariant String Int (List Icnf))    ; variant name, tag, field values
  (IMatch Icnf (List IArm)))

(deftype IArm (IArm String Int (List String) Icnf)) ; variant, tag, binds, body

(deftype IFunc (IFn String (List String) Icnf))     ; name, params, body

; Binop opcodes: 0 add 1 sub 2 mul 3 div 4 rem 5 lt 6 gt 7 le 8 ge 9 eq 10 ne

(defn ic-op-of (arena s)
  (if (str-eq s (str-intern arena "+")) 0
  (if (str-eq s (str-intern arena "-")) 1
  (if (str-eq s (str-intern arena "*")) 2
  (if (str-eq s (str-intern arena "/")) 3
  (if (str-eq s (str-intern arena "%")) 4
  (if (str-eq s (str-intern arena "<")) 5
  (if (str-eq s (str-intern arena ">")) 6
  (if (str-eq s (str-intern arena "<=")) 7
  (if (str-eq s (str-intern arena ">=")) 8
  (if (str-eq s (str-intern arena "==")) 9
  (if (str-eq s (str-intern arena "=")) 9
  (if (str-eq s (str-intern arena "!=")) 10
  -1)))))))))))))

; ===========================================================================
; PROGRAM-LEVEL LOWERING
; ===========================================================================

; Lower a whole program: collect deftype variant tables and defn bodies.
; Returns: List(IFunc)
(defn ic-program (arena prog)
  (let vt (ic-collect-vt arena prog None)
    (list-reverse (ic-defns arena prog None vt))))

; Walk top-level forms; deftype forms extend the variant table.
(defn ic-collect-vt (arena forms vt)
  (if (is-nil forms)
    vt
    (let form (hd forms)
      (let rest (list-cdr forms)
        (if (= (ast-code form) 5)
          (let kids (ast-kids form)
            (if (> (list-length kids) 0)
              (if (str-eq (ast-name (hd kids)) (str-intern arena "deftype"))
                (ic-collect-vt arena rest (ic-vt-deftype arena kids vt 0))
                (ic-collect-vt arena rest vt))
              (ic-collect-vt arena rest vt)))
          (ic-collect-vt arena rest vt))))))

; Add one deftype's variants (kids = (deftype Name Variant...)).
(defn ic-vt-deftype (arena kids vt tag)
  (let rem (list-drop kids 2)
    (if (is-nil rem)
      vt
      (let v (hd rem)
        (let vname
          (if (= (ast-code v) 5)
            (ast-name (hd (ast-kids v)))
            (ast-name v))
          (let arity (- (list-length (ast-kids v)) 1)
            (ic-vt-deftype arena (list-cdr rem)
                           (Cons (VTEntry (str-intern arena vname) tag arity vt) vt)
                           (+ tag 1))))))))

; Lower all top-level defn forms to IFn records (source order preserved).
(defn ic-defns (arena forms acc vt)
  (if (is-nil forms)
    acc
    (let form (hd forms)
      (let rest (list-cdr forms)
        (if (= (ast-code form) 5)
          (let kids (ast-kids form)
            (if (> (list-length kids) 1)
              (if (str-eq (ast-name (hd kids)) (str-intern arena "defn"))
                (ic-defns arena rest (Cons (ic-defn arena kids vt) acc) vt)
                (ic-defns arena rest acc vt))
              (ic-defns arena rest acc vt)))
          (ic-defns arena rest acc vt))))))

; kids = (defn name (params...) body)
(defn ic-defn (arena kids vt)
  (let name (ast-name (hd (list-cdr kids)))
    (let params-node (hd (list-drop kids 2))
      (let body (hd (list-drop kids 3))
        (IFn (str-intern arena name)
             (list-reverse (ic-param-names params-node None))
             (ic-expr arena body None vt))))))

; Collect parameter names from a parenthesised param node. Typed params
; (name Type) take the first element.
(defn ic-param-names (node acc)
  (if (not (= (ast-code node) 5))
    acc
    (ic-param-names-kids (ast-kids node) acc)))

; Walk one parameter per list element. Typed pairs ((name Type) ...) take
; the first child's name.
(defn ic-param-names-kids (kids acc)
  (if (is-nil kids)
    acc
    (let p (hd kids)
      (let pname
        (if (= (ast-code p) 5)
          (ast-name (hd (ast-kids p)))
          (ast-name p))
        (ic-param-names-kids (list-cdr kids) (Cons pname acc))))))

; Drop the first n elements of a list.
; Head of a list of Ast forms (empty AList when nil).
(defn hd (xs)
  (match xs
    (Cons a rest a)
    (None (AList None))))

(defn list-drop (xs n)
  (if (is-nil xs)
    xs
    (if (<= n 0)
      xs
      (list-drop (list-cdr xs) (- n 1)))))

; ===========================================================================
; EXPRESSION LOWERING
; ===========================================================================

; Lower one Ast expression to Icnf. `vt` resolves ADT constructions/match.
(defn ic-expr (arena ast env vt)
  (let k (ast-code ast)
    (if (= k 0)
      (ic-ident arena (ast-name ast) env vt)
      (if (= k 1)
        (IConst (ast-int ast))
        (if (= k 2)
          (IFlt (ast-text ast))
          (if (= k 3)
            (IStr (ast-text ast))
            (if (= k 4)
              (IConst (if (ast-bool ast) 1 0))
              (ic-form arena (ast-kids ast) env vt))))))))

; Identifier: nullary variant construction or variable reference.
(defn ic-ident (arena name env vt)
  (let tag (vt-tag-of vt (str-intern arena name))
    (if (> tag -1)
      (IVariant (str-intern arena name) tag None)
      (ILoad (str-intern arena name)))))

; A parenthesised form. kids is non-empty (empty -> Const 0).
(defn ic-form (arena kids env vt)
  (if (is-nil kids)
    (IConst 0)
    (let head (hd kids)
      (let args (list-cdr kids)
        (let hname (ast-name head)
          (let op (ic-op-of arena hname)
            (if (> op -1)
              (ic-binop arena op args env vt)
                                          (if (str-eq hname (str-intern arena "let"))
                              (ic-let arena args env vt false)
                              (if (str-eq hname (str-intern arena "let-mut"))
                                (ic-let arena args env vt true)
                            (if (str-eq hname (str-intern arena "if")) (IIf (ic-expr arena (hd args) env vt) (ic-expr arena (hd (list-cdr args)) env vt) (ic-expr arena (hd (list-drop args 2)) env vt)) (if (str-eq hname (str-intern arena "while")) (IWhile (ic-expr arena (hd args) env vt) (ic-expr arena (hd (list-cdr args)) env vt)) (if (str-eq hname (str-intern arena "set!")) (ISet (str-intern arena (ast-name (hd args))) (ic-expr arena (hd (list-cdr args)) env vt)) (if (str-eq hname (str-intern arena "begin")) (ISeq (ic-arg-list arena args env vt)) (if (str-eq hname (str-intern arena "file-close")) (IFfi "zyl_file_close_c" (ic-arg-list arena args env vt)) (if (str-eq hname (str-intern arena "file-write")) (IFfi "zyl_file_write_c" (ic-arg-list arena args env vt)) (if (str-eq hname (str-intern arena "file-read")) (IFfi "zyl_file_read_c" (ic-arg-list arena args env vt)) (if (str-eq hname (str-intern arena "file-open")) (IFfi "zyl_file_open_c" (ic-arg-list arena args env vt)) (if (str-eq hname (str-intern arena "print")) (ic-print arena args env vt) (ICall (str-intern arena hname) (ic-arg-list arena args env vt))))))))))))))))))))

; (let name val body...) — extra body expressions become an implicit ISeq.
(defn ic-let (arena args env vt mutable)
  (let name (ast-name (hd args))
    (let val (ic-expr arena (hd (list-cdr args)) env vt)
      (let rest (list-drop args 2)
        (let body
          (if (= (list-length rest) 1)
            (ic-expr arena (hd rest) env vt)
            (ISeq (ic-arg-list arena rest env vt))))
          (ILet (str-intern arena name) val body)))))

; Binary operator with exactly two arguments; unary minus (- x) supported.
(defn ic-binop (arena op args env vt)
  (if (= (list-length args) 2)
    (IBinop op
            (ic-expr arena (hd args) env vt)
            (ic-expr arena (hd (list-cdr args)) env vt))
    (if (= (list-length args) 1)
      (if (= op 1)
        (IBinop 1 (IConst 0) (ic-expr arena (hd args) env vt))
        (IConst 0))
      (IConst 0))))

; print: multi-argument prints become a sequence of single prints.
(defn ic-print (arena args env vt)
  (if (is-nil args)
    (IConst 0)
    (if (is-nil (list-cdr args))
      (IPrint (ic-expr arena (hd args) env vt))
      (ISeq (Cons (IPrint (ic-expr arena (hd args)) env vt)
                  (Cons (ic-print arena (list-cdr args) env vt) None))))))

; (ffi-call "sym" a b timeout): drop the trailing timeout literal.
(defn ic-ffi (arena args env vt)
  (let sym (ast-text (hd args))
    (let real-args (list-cdr args)
      (let call-args (if (<= (list-length real-args) 1)
                        None
                        (ic-arg-list arena (list-drop-last real-args) env vt)))
      (IFfi (str-intern arena sym) call-args))))

(defn list-drop-last (xs)
  (if (is-nil xs)
    None
    (if (is-nil (list-cdr xs))
      None
      (Cons (hd xs) (list-drop-last (tl xs))))))

; (match scrutinee arm...): arm = ((Variant binds...) body) or (Variant body).
(defn ic-match (arena args env vt)
  (IMatch (ic-expr arena (hd args) env vt)
          (list-reverse (ic-arms arena (list-cdr args) None env vt))))

; One arm per call: arm kids = (VariantName pat* body).
(defn ic-arms (arena arms acc env vt)
  (if (is-nil arms)
    acc
    (ic-arm-one arena (hd arms) (list-cdr arms) acc env vt)))

(defn ic-arm-one (arena arm rest acc env vt)
  (let parts (ast-kids arm)
    (let vname (ast-name (hd parts))
      (let pats (list-drop-last (list-cdr parts))
        (let tag (vt-tag-of vt (str-intern arena vname))
          (let binds (ic-arm-binds arena pats None)
            (let body (ic-expr arena (hd (list-drop-last parts)) env vt)
              (ic-arms arena rest
                       (Cons (IArm (str-intern arena vname) tag binds body) acc)))))))))

; Variant construction with fields: (V a b ...).
(defn ic-variant (arena vname args env vt)
  (let tag (vt-tag-of vt (str-intern arena vname))
    (IVariant (str-intern arena vname) tag (ic-arg-list arena args env vt))))

; Lower argument lists left-to-right.
(defn ic-arg-list (arena args env vt)
  (ic-arg-list-acc arena args env vt None))

(defn ic-arg-list-acc (arena args env vt acc)
  (if (is-nil args)
    (list-reverse acc)
    (ic-arg-list-acc arena (list-cdr args) env vt
                     (Cons (ic-expr arena (hd args) env vt) acc))))

; Tail of a list of Ast forms.
(defn tl (xs)
  (match xs
    (Cons a rest rest)
    (None None)))

; ---------- stdlib/compiler/codegen.zyl ----------
; === Zyl Standard Library — Self-Hosting: x86_64 codegen ===
; Module: compiler/codegen
;
; Walks the recursive Icnf instruction tree (see compiler/icnf) and emits
; GAS .intel_syntax noprefix assembly text. Expression code is evaluated
; into rax (a pure stack-machine discipline): every sub-expression leaves
; its value in rax; binary operators push the left operand around the
; right operand's evaluation.
;
; Conventions:
;   - Parameters arrive in SysV registers (rdi rsi rdx rcx r8 r9) and are
;     spilled to [rbp-8*(i+1)] in the prologue.
;   - Locals (let / match bindings) get slots from a downward-growing
;     offset counter threaded through the emitter state.
;   - Names are resolved through an immutable Env chain (see ast.zyl).
;   - Calls support up to 6 register arguments; argument values are pushed
;     and popped in reverse so evaluation order stays strictly
;     left-to-right (spec evaluation-order rule).
;   - Floats travel as bit patterns in rax and move to xmm0/xmm1 for SSE
;     arithmetic; print selects %d/%f/%s by the operand's syntactic kind.




; Emitter state cells:
;   [0]=arena  [8]=text buffer  [16]=label counter  [24]=next slot offset
;   [32]=rodata list (Rodata)
(defn cg-new (arena)
  (let st (arena-alloc-zeroed arena 48)
    (let buf (arena-alloc-zeroed arena 8388608)
      (begin
        (alloc-write-int st arena)
        (alloc-write-int (+ st 8) buf)
        (alloc-write-int (+ st 16) 0)
        (alloc-write-int (+ st 24) 8)   ; params occupy slots 1..n
        (alloc-write-int (+ st 32) (RNil))
        st))))

(defn cg-emit (st s)
  (buf-append (alloc-read-int (+ st 8)) s))

(defn cg-emit-int (st n)
  (cg-emit st (ffi-call "zyl_cstr_from_int" (alloc-read-int st) n 1000)))

(defn cg-nl (st) (cg-emit st "
"))

; Fresh label .L<N>; returns the label string.
(defn cg-label-new (st)
  (let arena (alloc-read-int st)
    (let n (alloc-read-int (+ st 16))
      (let buf (arena-alloc-zeroed arena 32)
        (begin
          (alloc-write-int (+ st 16) (+ n 1))
          (buf-append buf (str-intern arena ".L"))
          (buf-append buf (ffi-call "zyl_cstr_from_int" arena n 1000))
          buf)))))

; Allocate one 8-byte local slot; returns its rbp offset (negative).
(defn cg-new-slot (st)
  (let off (alloc-read-int (+ st 24))
    (begin
      (alloc-write-int (+ st 24) (+ off 8))
      (- off))))

; ===========================================================================
; RODATA COLLECTION (threaded through state cell [32]... see cg-rodata*)
; Rodata entries live in an immutable list stored at state offset 32.
; ===========================================================================

(deftype Rodata
  (RStr String String Rodata)   ; label, content
  (RFlt String String Rodata)   ; label, literal text
  (RNil))

(defn cg-rodata-get (st) (alloc-read-int (+ st 32)))
(defn cg-rodata-put (st rd) (alloc-write-int (+ st 32) rd))

; Intern a string constant; emit `lea rax, [rip+label]`.
(defn cg-string-const (st content)
  (let lbl (cg-label-new st)
    (begin
      (cg-rodata-put st (RStr lbl content (cg-rodata-get st)))
      (cg-emit st "    lea rax, [rip+")
      (cg-emit st lbl)
      (cg-emit st "]")
      (cg-nl st))))

; Intern a float constant; load its bits into rax via xmm0.
(defn cg-float-const (st text)
  (let lbl (cg-label-new st)
    (begin
      (cg-rodata-put st (RFlt lbl text (cg-rodata-get st)))
      (cg-emit st "    movsd xmm0, [rip+")
      (cg-emit st lbl)
      (cg-emit st "]")
      (cg-nl st)
      (cg-emit st "    movq rax, xmm0")
      (cg-nl st))))

; ===========================================================================
; KINDS (for print format + float detection)
; ===========================================================================
; 0 int, 1 string, 2 float

(defn kind-of (env e)
  (match e
    (IConst 0)
    (IStr  w1 1)
    (IFlt  w2 2)
    (ILoad n (env-kind-of env n))
    (IBinop op l r
     (if (> op 4)
       0
       (let kl (kind-of env l)
         (let kr (kind-of env r)
           (if (= kl 2)
             2
             (if (= kr 2) 2 0))))))
    (IIf c t e (kind-of env t))
    (ICall  w3  w4 0)
    (IFfi  w5  w6 0)
    (IPrint  w7 0)
    (IWhile c b 0)
    (ISet  w8  w9 0)
    (ILet  w10  w11  w12 0)
    (ISeq  w13 0)
    (IVariant  w14  w15  w16 0)
    (IMatch  w17  w18 0)))

; ===========================================================================
; EXPRESSION EMISSION (result always in rax)
; ===========================================================================

(defn cg-expr (st env e)
  (match e
    (IConst v
     (begin
       (cg-emit st "    mov rax, ")
       (cg-emit-int st v)
       (cg-nl st)))
    (IStr s (cg-string-const st s))
    (IFlt t (cg-float-const st t))
    (ILoad n
     (begin
       (cg-emit st "    mov rax, [rbp")
       (cg-emit-int st (env-lookup env n))
       (cg-emit st "]")
       (cg-nl st)))
    (IBinop op l r
     (if (> (if (= (kind-of env l) 2) 1 (if (= (kind-of env r) 2) 1 0)) 0)
       (cg-fbinop st env op l r)
       (cg-ibinop st env op l r)))
    (ICall name args (cg-call-args st env name args true 0))
    (IFfi sym args (cg-call-args st env sym args false 0))
    (IPrint a (cg-print st env a))
    (IIf c t eb
     (let lelse (cg-label-new st)
       (let lend (cg-label-new st)
         (begin
           (cg-expr st env c)
           (cg-emit st "    test rax, rax")
           (cg-nl st)
           (cg-emit st "    je ")
           (cg-emit st lelse)
           (cg-nl st)
           (cg-expr st env t)
           (cg-emit st "    jmp ")
           (cg-emit st lend)
           (cg-nl st)
           (cg-emit-label st lelse)
           (cg-expr st env eb)
           (cg-emit-label st lend)))))
    (IWhile c body
     (let lstart (cg-label-new st)
       (let lend (cg-label-new st)
         (begin
           (cg-emit-label st lstart)
           (cg-expr st env c)
           (cg-emit st "    test rax, rax")
           (cg-nl st)
           (cg-emit st "    je ")
           (cg-emit st lend)
           (cg-nl st)
           (cg-expr st env body)
           (cg-emit st "    jmp ")
           (cg-emit st lstart)
           (cg-nl st)
           (cg-emit-label st lend)
           (cg-emit st "    xor eax, eax")
           (cg-nl st)))))
    (ISet n v
     (begin
       (cg-expr st env v)
       (cg-emit st "    mov [rbp")
       (cg-emit-int st (env-lookup env n))
       (cg-emit st "], rax")
       (cg-nl st)))
    (ILet n v body
     (let off (cg-new-slot st)
       (let k (kind-of env v)
         (begin
           (cg-expr st env v)
           (cg-emit st "    mov [rbp")
           (cg-emit-int st off)
           (cg-emit st "], rax")
           (cg-nl st)
           (cg-expr st (EnvBind n off k env) body)))))
    (ISeq es (cg-seq st env es))
    (IVariant  w19 tag fields (cg-variant st env tag fields))
    (IMatch scr arms (cg-match st env scr arms))))

(defn cg-seq (st env es)
  (if (is-nil es)
    (begin
      (cg-emit st "    xor eax, eax")
      (cg-nl st))
    (if (is-nil (list-cdr es))
      (cg-expr st env (ih es))
      (begin
        (cg-expr st env (ih es))
        (cg-seq st env (tl2 es))))))

; Integer binary op: lhs -> rax (pushed), rhs -> rax, lhs restored to rax,
; rhs kept in rcx. Div/Rem use cqo/idiv with divisor safe in rcx.
(defn cg-ibinop (st env op l r) (begin (cg-expr st env l) (cg-emit st "    push rax") (cg-nl st) (cg-expr st env r) (cg-emit st "    mov rcx, rax") (cg-nl st) (cg-emit st "    pop rax") (cg-nl st) (if (< op 5) (begin (let mnem (if (= op 0) "    add rax, rcx" (if (= op 1) "    sub rax, rcx" (if (= op 2) "    imul rax, rcx" "    idiv rcx"))) (begin (if (= op 3) (begin (cg-emit st "    cqo") (cg-nl st)) 0) (cg-emit st mnem) (cg-nl st) (if (= op 4) (begin (cg-emit st "    mov rax, rdx") (cg-nl st)) 0)))) (begin (cg-emit st "    cmp rax, rcx") (cg-nl st) (cg-emit st "    set") (if (= op 5) (cg-emit st "l al") (if (= op 6) (cg-emit st "g al") (if (= op 7) (cg-emit st "le al") (if (= op 8) (cg-emit st "ge al") (if (= op 9) (cg-emit st "e al") (cg-emit st "ne al")))))) (cg-nl st) (cg-emit st "    movzx rax, al") (cg-nl st)))))

; Float binary op: bits in rax; xmm0 = lhs, xmm1 = rhs.
(defn cg-fbinop (st env op l r)
  (begin
    (cg-expr st env l)
    (cg-emit st "    push rax")
    (cg-nl st)
    (cg-expr st env r)
    (cg-emit st "    movq xmm1, rax")
    (cg-nl st)
    (cg-emit st "    pop rax")
    (cg-nl st)
    (cg-emit st "    movq xmm0, rax")
    (cg-nl st)
    (if (< op 5)
      (begin
        (cg-emit st "    ")
        (if (= op 0) (cg-emit st "addsd"))
        (if (= op 1) (cg-emit st "subsd"))
        (if (= op 2) (cg-emit st "mulsd"))
        (if (= op 3) (cg-emit st "divsd"))
        (cg-emit st " xmm0, xmm1")
        (cg-nl st)
        (cg-emit st "    movq rax, xmm0")
        (cg-nl st))
      (begin
        (cg-emit st "    comisd xmm0, xmm1")
        (cg-nl st)
        (cg-emit st "    set")
        ; unsigned-comparison flags: below/above carry the usual sense here
        (if (= op 5) (cg-emit st "b al")
          (if (= op 6) (cg-emit st "a al")
            (if (= op 7) (cg-emit st "be al")
              (if (= op 8) (cg-emit st "ae al")
                (if (= op 9) (cg-emit st "e al")
                  (cg-emit st "ne al"))))))
        (cg-nl st)
        (cg-emit st "    movzx rax, al")
        (cg-nl st)))))

; Register-name dispatch by arg index (SysV).
(defn cg-reg-of (i)
  (if (= i 0) "rdi"
    (if (= i 1) "rsi"
      (if (= i 2) "rdx"
        (if (= i 3) "rcx"
          (if (= i 4) "r8"
            "r9"))))))

; Call: evaluate args left-to-right, pushing each result; then pop into
; registers in reverse; call; clean up any pad. `mangle` adds the f_ prefix
; for user functions.
(defn cg-call-args (st env name args mangle i)
  (if (is-nil args)
    (cg-call-fire st env name mangle i)
    (begin
      (cg-expr st env (ih args))
      (cg-emit st "    push rax")
      (cg-nl st)
      (cg-call-args st env name (tl2 args) mangle (+ i 1)))))

(defn cg-call-fire (st env name mangle i)
  (let pad (if (= (% i 2) 1)
             1
             0)
    (begin
      (cg-pop-regs st (- i 1))
      ; alignment pad goes AFTER the pops so it cannot shift a pushed arg
      ; out of place for the register pops.
      (if (= pad 1)
        (begin
          (cg-emit st "    sub rsp, 8")
          (cg-nl st))
        0)
      (cg-emit st "    call ")
      (if mangle (cg-emit st "f_") 0)
      (cg-emit st (ffi-call "zyl_cstr_sanitize" (alloc-read-int st) name 1000))
      (cg-nl st)
      (if (= pad 1)
        (begin
          (cg-emit st "    add rsp, 8")
          (cg-nl st))
        0))))

; Pop j+1 pushed args into their registers (reverse order).
(defn cg-pop-regs (st j)
  (if (< j 0)
    0
    (begin
      (cg-emit st "    pop ")
      (cg-emit st (cg-reg-of j))
      (cg-nl st)
      (cg-pop-regs st (- j 1)))))

; print: pick the format by the argument's kind.
(defn cg-print (st env a)
  (let k (kind-of env a)
    (begin
      (cg-expr st env a)
      (if (= k 2)
        (begin
          ; float: value already in xmm-compatible bits
          (cg-emit st "    movq xmm0, rax")
          (cg-nl st)
          (cg-emit st "    lea rdi, [rip+.Lfmtf]")
          (cg-nl st)
          (cg-emit st "    mov eax, 1")
          (cg-nl st))
        (if (= k 1)
          (begin
            (cg-emit st "    mov rsi, rax")
            (cg-nl st)
            (cg-emit st "    lea rdi, [rip+.Lfmts]")
            (cg-nl st)
            (cg-emit st "    xor eax, eax")
            (cg-nl st))
          (begin
            (cg-emit st "    mov rsi, rax")
            (cg-nl st)
            (cg-emit st "    lea rdi, [rip+.Lfmtd]")
            (cg-nl st)
            (cg-emit st "    xor eax, eax")
            (cg-nl st))))
      (cg-emit st "    call printf")
      (cg-nl st))))

; Variant construction: malloc'd block [tag][f0]..[fn-1].
; Fields are evaluated and pushed, then popped into the block (right to
; left). An odd field count gets 8 bytes of pad to keep rsp 16-aligned
; across malloc.
(defn cg-variant (st env tag fields)
  (let n (list-length fields)
    (begin
      (cg-push-fields st env fields)
      (if (= (% n 2) 1)
        (begin
          (cg-emit st "    sub rsp, 8")
          (cg-nl st))
        0)
      (cg-emit st "    mov rdi, ")
      (cg-emit-int st (* 8 (+ n 1)))
      (cg-nl st)
      (cg-emit st "    call malloc")
      (cg-nl st)
      (cg-emit st "    mov rbx, rax")
      (cg-nl st)
      (cg-emit st "    mov qword ptr [rbx], ")
      (cg-emit-int st tag)
      (cg-nl st)
      (if (= (% n 2) 1)
        (begin
          (cg-emit st "    add rsp, 8")
          (cg-nl st))
        0)
      (cg-pop-fields st (- n 1))
      (cg-emit st "    mov rax, rbx")
      (cg-nl st))))

; Evaluate each field left-to-right, pushing its value.
(defn cg-push-fields (st env fields)
  (if (is-nil fields)
    0
    (begin
      (cg-expr st env (ih fields))
      (cg-emit st "    push rax")
      (cg-nl st)
      (cg-push-fields st env (tl2 fields)))))

; Pop n fields into the block rbx points at (reverse order restores the
; original left-to-right layout).
(defn cg-pop-fields (st j)
  (if (< j 0)
    0
    (begin
      (cg-emit st "    pop rax")
      (cg-nl st)
      (cg-emit st "    mov [rbx+")
      (cg-emit-int st (* 8 (+ j 1)))
      (cg-emit st "], rax")
      (cg-nl st)
      (cg-pop-fields st (- j 1)))))

; Match: evaluate scrutinee, keep it on the stack for the whole dispatch,
; replace it with the arm-body result, pop at the end.
; Stack invariant: exactly one pushed word ([rsp] = scrutinee or result).
(defn cg-match (st env scr arms)
  (let lend (cg-label-new st)
    (let lzero (cg-label-new st)
      (begin
        (cg-expr st env scr)
        (cg-emit st "    push rax")
        (cg-nl st)
        (cg-arms st env arms lend lzero)
        ; fall-through: no arm matched -> 0
        (cg-emit-label st lzero)
        (cg-emit st "    mov qword ptr [rsp], 0")
        (cg-nl st)
        (cg-emit-label st lend)
        (cg-emit st "    pop rax")
        (cg-nl st)))))

; Emit arms[i..]. Each arm checks [rsp]'s tag; a failed check jumps to
; the next arm's label (or the zero fall-through after the last arm); a
; successful match binds pattern vars and evaluates the body.
(defn cg-arms (st env arms lend lzero)
  (if (is-nil arms)
    0
    (let arm (list-car arms)
      (match arm
        (IArm vname tag binds body
         (let rest (list-cdr arms)
           (let lnext (if (is-nil rest) lzero (cg-label-new st))
             (begin
               ; tag check: [rsp] holds the scrutinee pointer
               (cg-emit st "    mov rax, [rsp]")
               (cg-nl st)
               (cg-emit st "    mov rax, [rax]")
               (cg-nl st)
               (cg-emit st "    cmp rax, ")
               (cg-emit-int st tag)
               (cg-nl st)
               (cg-emit st "    jne ")
               (cg-emit st lnext)
               (cg-nl st)
               ; bind pattern vars to fields, then emit the body
               (let arm-env (cg-bind-fields st env binds 0)
                 (begin
                   (cg-expr st arm-env body)
                   (cg-emit st "    mov [rsp], rax")
                   (cg-nl st)
                   (cg-emit st "    jmp ")
                   (cg-emit st lend)
                   (cg-nl st)))
               (if (is-nil rest)
                 0
                 (begin
                   (cg-emit-label st lnext)
                   (cg-arms st env rest lend lzero)))))))))))

; Bind pattern variables: field j of [rsp]'s block goes into a fresh slot.
; Returns: Env (the extended environment).
(defn cg-bind-fields (st env binds j)
  (if (is-nil binds)
    env
    (let b (list-car binds)
      (begin
        (cg-emit st "    mov rax, [rsp]")
        (cg-nl st)
        (cg-emit st "    mov rax, [rax+")
        (cg-emit-int st (* 8 (+ j 1)))
        (cg-emit st "]")
        (cg-nl st)
        (if (str-eq b (str-intern (alloc-read-int st) "_"))
          (cg-bind-fields st env (tl2 binds) (+ j 1))
          (let off (cg-new-slot st)
            (begin
              (cg-emit st "    mov [rbp")
              (cg-emit-int st off)
              (cg-emit st "], rax")
              (cg-nl st)
              (cg-bind-fields st (EnvBind b off 0 env) (list-cdr binds) (+ j 1)))))))))

(defn cg-emit-label (st lbl)
  (begin
    (cg-emit st lbl)
    (cg-emit st ":")
    (cg-nl st)))

; ===========================================================================
; FUNCTION / PROGRAM EMISSION
; ===========================================================================

(defn cg-function (st f)
  (match f
    (IFn name params body
     (let env (cg-param-env params 0 None)
       (begin
         (cg-emit st "f_")
         (cg-emit st (ffi-call "zyl_cstr_sanitize" (alloc-read-int st) name 1000))
         (cg-emit st ":")
         (cg-nl st)
         (cg-emit st "    push rbp")
         (cg-nl st)
         (cg-emit st "    mov rbp, rsp")
         (cg-nl st)
         (cg-emit st "    sub rsp, 4096")
         (cg-nl st)
         (cg-param-spills st 0 (list-length params))
         (alloc-write-int (+ st 24) (* 8 (+ 1 (list-length params)))) ; locals start after params
         (cg-expr st env body)
         (cg-emit st "    mov rsp, rbp")
         (cg-nl st)
         (cg-emit st "    pop rbp")
         (cg-nl st)
         (cg-emit st "    ret")
         (cg-nl st))))))

; Immutable param environment: param i -> offset -(8*(i+1)).
(defn cg-param-env (params i acc)
  (if (is-nil params)
    acc
    (cg-param-env (tl2 params) (+ i 1)
                  (EnvBind (shd params) (- (* 8 (+ i 1))) 0 acc))))

; Spill incoming SysV registers to param slots.
(defn cg-param-spills (st i n)
  (if (>= i n)
    0
    (begin
      (cg-emit st "    mov [rbp")
      (cg-emit-int st (- (* 8 (+ i 1))))
      (cg-emit st "], ")
      (cg-emit st (cg-reg-of i))
      (cg-nl st)
      (cg-param-spills st (+ i 1) n))))

; Emit the whole program: header, functions, entry stub, rodata.
; Functions are emitted in lowering order (source order); the entry stub
; calls f_main, which the lowering guarantees exists.
(defn cg-program (st fns)
  (begin
    (cg-emit st ".intel_syntax noprefix")
    (cg-nl st)
    (cg-emit st ".text")
    (cg-nl st)
    (cg-emit st ".globl main")
    (cg-nl st)
    (cg-functions st fns)
    (cg-emit st "main:")
    (cg-nl st)
    (cg-emit st "    push rbp")
    (cg-nl st)
    (cg-emit st "    mov rbp, rsp")
    (cg-nl st)
    (cg-emit st "    call f_main")
    (cg-nl st)
    (cg-emit st "    xor eax, eax")
    (cg-nl st)
    (cg-emit st "    pop rbp")
    (cg-nl st)
    (cg-emit st "    ret")
    (cg-nl st)
    (cg-emit st ".section .rodata")
    (cg-nl st)
    (cg-emit st ".Lfmtd:")
    (cg-nl st)
    (cg-emit st "    .string \"%d\\n\"")
    (cg-nl st)
    (cg-emit st ".Lfmtf:")
    (cg-nl st)
    (cg-emit st "    .string \"%f\\n\"")
    (cg-nl st)
    (cg-emit st ".Lfmts:")
    (cg-nl st)
    (cg-emit st "    .string \"%s\\n\"")
    (cg-nl st)
    (cg-rodata-emit st (cg-rodata-get st))))


; Typed list heads (total via fallback values).
(defn ih (xs)
  (match xs
    (Cons a rest a)
    (None (IConst 0))))

(defn fh (xs)
  (match xs
    (Cons f rest f)
    (None (IFn "" None (IConst 0)))))

(defn shd (xs)
  (match xs
    (Cons s rest s)
    (None "")))

(defn cg-functions (st fns)
  (if (is-nil fns)
    0
    (begin
      (cg-function st (fh fns))
      (cg-functions st (tl2 fns)))))

(defn cg-rodata-emit (st rd)
  (match rd
    (RNil 0)
    (RStr lbl content rest
     (begin
       (cg-emit st lbl)
       (cg-emit st ":")
       (cg-nl st)
       (cg-emit st "    .string \"")
       (cg-emit st content)
       (cg-emit st "\"")
       (cg-nl st)
       (cg-rodata-emit st rest)))
    (RFlt lbl text rest
     (begin
       (cg-emit st lbl)
       (cg-emit st ":")
       (cg-nl st)
       (cg-emit st "    .double ")
       (cg-emit st text)
       (cg-nl st)
       (cg-rodata-emit st rest)))))

; Return the emitter's text buffer pointer.
(defn cg-buffer (st)
  (alloc-read-int (+ st 8)))

(defn tl2 (xs)
  (match xs
    (Cons a rest rest)
    (None None)))

; ---------- selfhost/driver.zyl ----------






(defn main () (let arena (arena-create 1048576) (let fd (file-open "/tmp/zyl_boot_in.zyl" "r") (if (> fd 0) (begin (let srcbuf (file-read fd 1048576) (begin (file-close fd) (let prog (zyl-parse arena srcbuf) (let fns (ic-program arena prog) (let cg (cg-new arena) (begin (cg-program cg fns) (let out (file-open "/tmp/zyl_boot_out.s" "w") (begin (file-write out (cg-buffer cg)) (file-close out) (print "boot: wrote /tmp/zyl_boot_out.s") 0))))))))) (begin (print "boot: cannot open input") 1)))))
