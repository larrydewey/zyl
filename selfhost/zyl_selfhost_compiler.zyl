          )
        )
        (
          else
          (
            TNominal name
          )
        )
      )
    )
    (
      EApply fname args
      (
        cond
        (
          (
            kv-contains
            (
              mc-returns ctx
            )
            fname
          )
          (
            let ret
            (
              kv-get
              (
                mc-returns ctx
              )
              fname
              (
                TVar 0
              )
            )
            (
              if
              (
                = ret
                (
                  TVar 0
                )
              )
              (
                if
                (
                  str-starts-with fname
                  "make-"
                )
                (
                  TNominal
                  (
                    str-drop fname 5
