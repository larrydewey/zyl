  deftype Expr
  (
    Expr ExprInner
  )
)
(
  defn Expr.inner
  (
    e
  )
  (
    match e
    (
      Expr i i
    )
  )
)
(
  defn convert-ast
  (
    ast
  )
  (
    match ast
    (
      AIdent s
      (
        let
        (
          atom
          (
            AIdent s
          )
        )
        (
          Expr
          (
            EAtom atom
          )
        )
      )
    )
    (
      AInt n
      (
        let
        (
          atom
          (
            AInt n
          )
        )
        (
          Expr
          (
            EAtom atom
          )
        )
      )
    )
    (
      AFloat s
      (
        let
        (
          atom
          (
            AFloat s
          )
        )
        (
          Expr
          (
            EAtom atom
          )
        )
      )
    )
    (
      AString s
      (
        let
        (
          atom
          (
            AStr s
          )
        )
        (
          Expr
          (
            EAtom atom
          )
        )
      )
    )
    (
      ABool b
      (
        let
        (
          atom
          (
            ABool b
          )
        )
        (
          Expr
          (
            EAtom atom
          )
        )
      )
    )
    (
      AList lst
      (
        if
        (
          nil? lst
        )
        (
          Expr
          (
            EAtom ANil
          )
        )
        (
          convert-list-to-exprinner
          (
            to-list lst
          )
        )
      )
    )
  )
)
(
  defn convert-ast-list
  (
    ast-list
  )
  (
    match ast-list
    (
      Nil Nil
    )
    (
      (
        Cons a rest
      )
      (
        Cons
        (
          convert-ast a
        )
        (
          convert-ast-list rest
        )
      )
    )
  )
)
(
  defn convert-list-to-exprinner
  (
    ast-list
  )
  (
    match ast-list
    (
      Nil
      (
        Expr
        (
          EAtom ANil
        )
      )
    )
    (
      (
        Cons head rest
      )
      (
        match head
        (
          AIdent
          "defn"
          (
            let
            (
              parsed
              (
                parse-defn rest
              )
            )
            (
              if
              (
                Some expr parsed
              )
              expr
              (
                Expr
                (
                  EUnknown
                  "defn"
                  (
                    convert-ast-list rest
                  )
                )
              )
            )
          )
        )
        (
          AIdent
          "deftype"
          (
            let
            (
              parsed
              (
                parse-deftype rest
              )
            )
            (
              if
              (
                Some expr parsed
              )
              expr
              (
