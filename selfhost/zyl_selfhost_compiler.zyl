(
  deftype MacroTable
  (
    MEntry String
    (
      List String
    )
    Expr MacroTable
  )
  (
    MNil
  )
)
(
  defn mt-has
  (
    mt name
  )
  (
    match mt
    (
      MNil 0
    )
    (
      MEntry n d1 d2 rest
      (
        if
        (
          >
          (
            str-eq n name
          )
          0
        )
        1
        (
          mt-has rest name
        )
      )
    )
  )
)
(
  defn mt-params
  (
    mt name
  )
  (
    match mt
    (
      MNil Nil
    )
    (
      MEntry n params d1 rest
      (
        if
        (
          >
          (
            str-eq n name
          )
          0
        )
        params
        (
          mt-params rest name
        )
      )
    )
  )
)
(
  defn mt-body
  (
    mt name
  )
  (
    match mt
    (
      MNil
      (
        Expr
        (
          EAtom ANil
        )
      )
    )
    (
      MEntry n d1 body rest
      (
        if
        (
          >
          (
            str-eq n name
          )
          0
        )
        body
        (
          mt-body rest name
        )
      )
    )
  )
)
(
  defn me-collect
  (
    forms mt
  )
  (
    match forms
    (
      Nil mt
    )
    (
      Cons e rest
      (
        match
        (
          Expr.inner e
        )
        (
          EMacroDef name params body
          (
            me-collect rest
            (
              MEntry name
              (
                me-param-names params
              )
              body mt
            )
          )
        )
        (
          d1
          (
            me-collect rest mt
          )
        )
      )
    )
  )
)
(
  defn me-param-names
  (
    params
  )
  (
    match params
    (
      Nil Nil
    )
    (
      Cons p rest
      (
        Cons
        (
          me-expr-ident p
          ""
        )
        (
          me-param-names rest
        )
      )
    )
  )
)
(
  defn me-expr-ident
  (
    e fb
  )
  (
    match
    (
      Expr.inner e
    )
    (
      EAtom atom
      (
        match atom
        (
          AIdent n n
        )
        (
          d1 fb
        )
      )
    )
    (
      d2 fb
    )
  )
)
(
  deftype SEnv
  (
    SBind String Expr SEnv
  )
  (
    SNil
  )
)
(
  defn senv-lookup
  (
    env name
  )
  (
    match env
    (
      SNil None
    )
    (
      SBind n e rest
      (
        if
        (
          >
          (
            str-eq n name
          )
          0
        )
        (
          Some e
        )
        (
          senv-lookup rest name
        )
      )
    )
  )
)
(
  defn senv-from-lists
  (
    params args
  )
  (
    match params
    (
      Nil SNil
    )
    (
      Cons p prest
      (
        match args
        (
          Nil SNil
        )
        (
          Cons a arest
