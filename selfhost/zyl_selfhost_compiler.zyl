(
  defn subst-empty
  (
  )
  (
    Subst Nil
  )
)
(
  defn subst-lookup
  (
    s n
  )
  (
    subst-lookup-binds
    (
      SBindings.binds s
    )
    n
  )
)
(
  defn subst-lookup-binds
  (
    binds n
  )
  (
    match binds
    (
      Nil None
    )
    (
      (
        TB k v
      )
      rest
      (
        if
        (
          = k n
        )
        (
          Some v
        )
        (
          subst-lookup-binds rest n
        )
      )
    )
  )
)
(
  defn subst-insert
  (
    s n t
  )
  (
    Subst
    (
      Cons
      (
        TB n t
      )
      (
        SBindings.binds s
      )
    )
  )
)
(
  defn subst-apply-type
  (
    s t
  )
  (
    match t
    (
      TInt TInt
    )
    (
      TFloat TFloat
    )
    (
      TBool TBool
    )
    (
      TString TString
    )
    (
      TUnit TUnit
    )
    (
      TFun args
      (
        subst-apply-type-list s args
      )
    )
    (
      TList elem
      (
        TList
        (
          subst-apply-type s elem
        )
      )
    )
    (
      TArray elem len
      (
        TArray
        (
          subst-apply-type s elem
        )
        len
      )
    )
    (
      TCap kind inner
      (
        TCap kind
        (
          subst-apply-type s inner
        )
      )
    )
    (
      TStruct name fields
      (
        subst-apply-type-struct s name fields
      )
    )
    (
      TVar m inner
      (
        match
        (
          subst-lookup s m
        )
        (
          Some t
          (
            subst-apply-type s t
          )
        )
        (
          None
          (
            TVar m
            (
              subst-apply-type s inner
            )
          )
        )
      )
    )
    (
      TMap k v
      (
        TMap
        (
          subst-apply-type s k
        )
        (
          subst-apply-type s v
        )
      )
    )
    (
      TResult e h
      (
        TResult
        (
          subst-apply-type s e
        )
        (
          subst-apply-type s h
        )
      )
    )
  )
)
(
  defn subst-apply-type-list
  (
    s types
  )
  (
    match types
    (
      Nil Nil
    )
    (
      (
        Cons h t
      )
      (
        Cons
        (
          subst-apply-type s h
        )
        (
          subst-apply-type-list s t
        )
      )
    )
  )
)
(
  defn subst-apply-type-struct
  (
    s name fields
  )
  (
    TStruct name
    (
      subst-apply-type-list s fields
    )
  )
)
(
  defn fst
  (
    p
  )
  (
    match p
    (
      Pair a d2 a
    )
    (
      d1
      (
        fst-pair p
      )
    )
  )
)
(
  defn fst-pair
  (
    p
  )
  (
    match p
    (
      Pair
      (
        Some a
      )
      d3 a
    )
    (
      Pair
      (
        None
      )
      d4 0
    )
  )
)
(
  defn snd
  (
    p
  )
  (
    match p
    (
      Pair a b b
    )
    (
      d1
      (
        snd-pair p
      )
    )
  )
)
(
  defn snd-pair
  (
    p
  )
  (
    match p
    (
      Pair a b b
    )
    (
      d1 0
    )
  )
)
(
  defn subst-apply
  (
    s t
  )
  (
    subst-apply-type s t
  )
)
(
  defn subst-union
  (
    s1 s2
  )
  (
    match
    (
      SBindings.binds s1
    )
    (
      Nil s2
    )
    (
      (
        TB n t
      )
      rest
      (
        let
        (
          (
            t2
            (
              subst-apply s2 t
            )
          )
        )
        (
          let
          (
            (
              new-s
              (
                subst-insert
                (
                  subst-union
                  (
                    Subst rest
                  )
                  s2
                )
                n t2
              )
            )
          )
          new-s
        )
      )
    )
  )
)
(
  defn type-free-vars
  (
    t
  )
  (
    match t
    (
      TInt Nil
    )
    (
      TFloat Nil
    )
    (
      TBool Nil
    )
    (
      TString Nil
    )
    (
      TUnit Nil
    )
    (
      TFun args
      (
        type-free-vars-list args
      )
    )
    (
      TList elem
      (
        type-free-vars elem
      )
    )
    (
      TArray elem d1
      (
        type-free-vars elem
      )
    )
    (
      TCap d2 inner
      (
        type-free-vars inner
      )
    )
    (
      TStruct d3 fields
      (
        type-free-vars-list fields
      )
    )
    (
      TVar n d4
      (
        List n
      )
    )
    (
      TMap k v
      (
        union
        (
          type-free-vars k
        )
        (
          type-free-vars v
        )
      )
    )
    (
      TResult e h
      (
        union
        (
          type-free-vars e
        )
        (
          type-free-vars h
        )
      )
    )
  )
)
(
  defn type-free-vars-list
  (
    (
      types
      (
        List Type
      )
    )
  )
  (
    match types
    (
      Nil Nil
    )
    (
      (
        Cons h t
      )
      (
        union
        (
          type-free-vars h
        )
        (
          type-free-vars-list t
        )
      )
    )
  )
)
(
  defn unify
  (
    s t1 t2
  )
  (
    let
    (
      (
        t1x
        (
          subst-apply s t1
        )
      )
    )
    (
      let
      (
        (
          t2x
          (
            subst-apply s t2
          )
        )
      )
      (
        unify-terms s t1x t2x
      )
    )
  )
)
(
  defn unify-terms
  (
    s t1 t2
  )
  (
    match
    (
      Pair t1 t2
    )
    (
      (
        Pair TInt TInt
      )
      (
        UOk s
      )
    )
    (
      (
        Pair TFloat TFloat
      )
      (
        UOk s
      )
    )
    (
      (
        Pair TBool TBool
      )
      (
        UOk s
      )
    )
    (
      (
        Pair TString TString
      )
      (
        UOk s
      )
    )
    (
      (
        Pair TUnit TUnit
      )
      (
        UOk s
      )
    )
    (
      (
        Pair
        (
          TFun args1
        )
        (
          TFun args2
        )
      )
      (
        if
        (
          =
          (
            list-length args1
          )
          (
            list-length args2
          )
        )
        (
          unify-args s args1 args2
        )
        (
          UErr
          "Function arity mismatch"
        )
      )
    )
    (
      (
        Pair
        (
          TList e1
        )
        (
          TList e2
        )
      )
      (
        unify s e1 e2
      )
    )
    (
      (
        Pair
        (
          TArray e1 l1
        )
        (
          TArray e2 l2
        )
      )
      (
        if
        (
          = l1 l2
        )
        (
          unify s e1 e2
        )
        (
          UErr
          "Array length mismatch"
        )
      )
    )
    (
      (
        Pair
        (
          TCap k1 a
        )
        (
          TCap k2 b
        )
      )
      (
        if
        (
          = k1 k2
        )
        (
          unify s a b
        )
        (
          UErr
          "Capability kind mismatch"
        )
      )
    )
    (
      (
        Pair
        (
          TStruct n1 fs1
        )
        (
          TStruct n2 fs2
        )
      )
      (
        if
        (
          = n1 n2
        )
        (
          if
          (
            =
            (
              list-length fs1
            )
            (
              list-length fs2
            )
          )
          (
            unify-args s fs1 fs2
          )
          (
            UErr
            "Struct field count mismatch"
          )
        )
        (
          UErr
          "Struct name mismatch"
        )
      )
    )
    (
      (
        Pair
        (
          TMap k1 v1
        )
        (
          TMap k2 v2
        )
      )
      (
        unify
        (
          unify s k1 k2
        )
        v1 v2
      )
    )
    (
      (
        Pair
        (
          TResult e1 h1
        )
        (
          TResult e2 h2
        )
      )
      (
        unify
        (
          unify s e1 e2
        )
        h1 h2
      )
    )
    (
      (
        Pair
        (
          TVar n d5
        )
        d6
      )
      (
        unify-var s n t2
      )
    )
    (
      (
        Pair d7
        (
          TVar n d8
        )
      )
      (
        unify-var s n t1
      )
    )
    (
      d1
      (
        UErr
        "Type mismatch"
      )
    )
  )
)
(
  defn unify-var
  (
    s n t
  )
  (
    match
    (
      subst-lookup s n
    )
    (
      Some tx
      (
        if
        (
          = tx t
        )
        (
          UOk s
        )
        (
          UErr
          "Variable already bound"
        )
      )
    )
    (
      None
      (
        UOk
        (
          subst-insert s n t
        )
      )
    )
  )
)
(
  defn unify-args
  (
    s args1 args2
  )
  (
    match
    (
      Pair args1 args2
    )
    (
      Pair Nil Nil
      (
        UOk s
      )
    )
    (
      Pair
      (
        (
          Pair h1 t1
        )
        (
          Pair h2 t2
        )
      )
      (
        match
        (
          unify s h1 h2
        )
        (
          UOk sx
          (
            unify-args sx t1 t2
          )
        )
        (
          UErr e
          (
            UErr e
          )
        )
      )
    )
  )
)
