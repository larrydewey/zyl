  defn ri-func-sig-exists
  (
    sigs name
  )
  (
    match sigs
    (
      Nil 0
    )
    (
      (
        Cons
        (
          FS n d38 d39
        )
        rest
      )
      (
        if
        (
          =
          (
            str-eq n name
          )
          0
        )
        1
        (
          ri-func-sig-exists rest name
        )
      )
    )
  )
)
(
  defn ri-add-struct-region
  (
    ri sr
  )
  (
    let srlist
    (
      RI.sr ri
    )
    (
      if
      (
        ri-sr-exists srlist
        (
          SR.name sr
        )
      )
      ri
      (
        RegionInferer
        (
          RI
          (
            RI.env ri
          )
          (
            Cons sr srlist
          )
          (
            RI.fs ri
          )
        )
      )
    )
  )
)
(
  defn ri-sr-exists
  (
    srs name
  )
  (
    match srs
    (
      Nil 0
    )
    (
      (
        Cons
        (
          SR n d40
        )
        rest
      )
      (
        if
        (
          =
          (
            str-eq n name
          )
          0
        )
        1
        (
          ri-sr-exists rest name
        )
      )
    )
  )
)
(
  defn ri-infer
  (
    icnf-list ri
  )
  (
    let ri2
    (
      ri-collect-defs ri icnf-list
    )
    (
      if
      (
        =
        (
          list-length icnf-list
        )
        0
      )
      ri2
      (
        ri-infer-expressions ri2 icnf-list
      )
    )
  )
)
(
  defn ri-infer-expressions
  (
    ri items
  )
  (
    match items
    (
      Nil ri
    )
    (
      (
        Cons ic rest
      )
      (
        let ri2
        (
          ri-infer-expr ri ic
        )
        (
          ri-infer-expressions ri2 rest
        )
      )
    )
  )
)
; ---------- selfhost/driver.zyl ----------
(
  defn dbg-log
  (
    msg
  )
  (
    let f
    (
      file-open
      "/tmp/dbg"
      "a"
    )
    (
      let d1
      (
        file-write f msg
      )
      (
        file-close f
      )
    )
  )
)
(
  defn emit-out
  (
    arena fns
  )
  (
    let st
    (
      cg-program
      (
        cg-new arena
      )
      fns
    )
    (
      let buf
      (
        cg-buffer st
      )
      (
        let blen
        (
          alloc-strlen buf
        )
        (
          if
          (
            > blen 66060288
          )
          (
            ffi-call
            "f_error"
            "E_CODEGEN_BUFFER_FULL: generated assembly exceeded the codegen buffer"
            1000
          )
          (
            let out
            (
              file-open
              "/tmp/zyl_boot_out.s"
              "w"
            )
            (
              let n
              (
                file-write out buf
              )
              (
                let d3
                (
                  file-close out
                )
                n
              )
            )
          )
        )
      )
    )
  )
)
(
  defn boot-run
  (
    arena fd
  )
  (
    let srcbuf
    (
      file-read fd 1048576
    )
    (
      let d2
      (
        file-close fd
      )
      (
        dbg-log
        "parse\n"
      )
      (
        let prog
        (
          zyl-parse arena srcbuf
        )
        (
          dbg-log
          "bridge\n"
        )
        (
          let exprs
          (
            convert-ast prog
          )
          (
            dbg-log
            "type-infer\n"
          )
          (
            let inferer
            (
              collect-definitions
              (
                inferer-new
              )
              exprs
            )
            (
              dbg-log
              "mono\n"
            )
            (
              let mono-ctx
              (
                mono-context-new inferer
              )
              (
                let mono-exprs
                (
                  monomorphize mono-ctx exprs
                )
                (
                  dbg-log
                  "lower\n"
                )
                (
                  let fns
                  (
                    ic-program arena mono-exprs
                  )
                  (
                    dbg-log
                    "codegen\n"
                  )
                  (
                    emit-out arena fns
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
(
  defn main
  (
  )
  (
    let arena
    (
      arena-create 1073741824
    )
    (
      let fd
      (
        file-open
        "/tmp/zyl_boot_in.zyl"
        "r"
      )
      (
        if
        (
          > fd 0
        )
        (
          boot-run arena fd
        )
        (
          begin
          (
            dbg-log
            "no input\n"
          )
          1
        )
      )
    )
  )
)