  )
)
(
  defn cg-esc-newline
  (
    arena s n i out
  )
  (
    begin
    (
      buf-append out
      (
        str-intern arena
        "\\"
      )
    )
    (
      buf-append out
      (
        str-intern arena
        "n"
      )
    )
    (
      cg-esc-loop arena s n
      (
        + i 1
      )
      out
    )
  )
)
(
  defn cg-str-entry
  (
    st lbl content
  )
  (
    let st2
    (
      cg-label-def st lbl
    )
    (
      let st4
      (
        cg-emit st2
        "    .string \""
      )
      (
        let st5
        (
          cg-emit st4
          (
            cg-escape
            (
              cg-arena-of st
            )
            content
          )
        )
        (
          cg-nl
          (
            cg-emit st5
            "\""
          )
        )
      )
    )
  )
)
(
  defn cg-label-def
  (
    st lbl
  )
  (
    cg-nl
    (
      cg-emit
      (
        cg-emit st lbl
      )
      ":"
    )
  )
)
(
  defn cg-flt-entry
  (
    st lbl text
  )
  (
    let st2
    (
      cg-label-def st lbl
    )
    (
      let st4
      (
        cg-emit st2
        "    .double "
      )
      (
        cg-nl
        (
          cg-emit st4 text
        )
      )
    )
  )
)
(
  defn cg-rodata-emit-list
  (
    st xs
  )
  (
    match xs
    (
      Nil st
    )
    (
      Cons e rest
      (
        let st2
        (
          cg-rodata-entry st e
        )
        (
          cg-rodata-emit-list st2 rest
        )
      )
    )
  )
)
(
  defn list-head-or
  (
    xs default
  )
  (
    match xs
    (
      Cons a d70 a
    )
    (
      Nil default
    )
  )
)
(
  defn ih-ic
  (
    xs
  )
  (
    list-head-or xs
    (
      IConst 0
    )
  )
)
(
  defn fh-if
  (
    xs
  )
  (
    list-head-or xs
    (
      IFn
      ""
      Nil
      (
        IConst 0
      )
    )
  )
)
(
  defn hd-ia
  (
    xs
  )
  (
    list-head-or xs
    (
      IArm
      ""
      -1 Nil
      (
        IConst 0
      )
    )
  )
)
(
  defn hd-icnf
  (
    xs
  )
  (
    match xs
    (
      Cons a d74a a
    )
    (
      Nil
      (
        IConst 0
      )
    )
  )
)
(
  defn cg-arena-of
  (
    st
  )
  (
    match st
    (
      CGS a d74 d75 d76 d77 d78 a
    )
  )
)
(
  defn tl2
  (
    xs
  )
  (
    match xs
    (
      Cons a rest rest
    )
    (
      Nil Nil
    )
  )
)
; ---------- selfhost/driver.zyl ----------
(
  defn dbg-log
  (
    msg
  )
  (
    let f
    (
      file-open
      "/tmp/dbg"
      "a"
    )
    (
      let d1
      (
        file-write f msg
      )
      (
        file-close f
      )
    )
  )
)
(
  defn emit-out
  (
    arena fns
  )
  (
    let st
    (
      cg-program
      (
        cg-new arena
      )
      fns
    )
    (
      let buf
      (
        cg-buffer st
      )
      (
        let blen
        (
          alloc-strlen buf
        )
        (
          if
          (
            > blen 66060288
          )
          (
            ffi-call
            "f_error"
            "E_CODEGEN_BUFFER_FULL: generated assembly exceeded the codegen buffer"
            1000
          )
          (
            let out
            (
              file-open
              "/tmp/zyl_boot_out.s"
              "w"
            )
            (
              let n
              (
                file-write out buf
              )
              (
                let d3
                (
                  file-close out
                )
                n
              )
            )
          )
        )
      )
    )
  )
)
(
  defn boot-run
  (
    arena fd
  )
  (
    let srcbuf
    (
      file-read fd 1048576
    )
    (
      let d2
      (
        file-close fd
      )
      (
        dbg-log
        "parse\n"
      )
      (
        let prog
        (
          zyl-parse arena srcbuf
        )
        (
          dbg-log
          "bridge\n"
        )
        (
          let exprs0
          (
            convert-ast-list prog
          )
          (
            dbg-log
            "modules\n"
          )
          (
            let exprs1
            (
              mr-resolve-program arena exprs0
            )
            (
              dbg-log
              "macros\n"
            )
            (
              let exprs
              (
                me-expand-program exprs1
              )
              (
                dbg-log
                "type-infer\n"
              )
              (
                let inferer
                (
                  collect-definitions
                  (
                    inferer-new
                  )
                  exprs
                )
                (
                  dbg-log
                  "mono\n"
                )
                (
                  let mono-ctx
                  (
                    mono-context-new inferer
                  )
                  (
                    let mono-exprs
                    (
                      monomorphize mono-ctx exprs
                    )
                    (
                      dbg-log
                      "lower\n"
                    )
                    (
                      let fns
                      (
                        ic-program arena mono-exprs
                      )
                      (
                        dbg-log
                        "codegen\n"
                      )
                      (
                        emit-out arena fns
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
(
  defn main
  (
  )
  (
    let arena
    (
      arena-create 1073741824
    )
    (
      let fd
      (
        file-open
        "/tmp/zyl_boot_in.zyl"
        "r"
      )
      (
        if
        (
          > fd 0
        )
        (
          boot-run arena fd
        )
        (
          begin
          (
            dbg-log
            "no input\n"
          )
          1
        )
      )
    )
  )
)