      str-length prefix
    )
    (
      if
      (
        <= lp
        (
          str-length s
        )
      )
      (
        =
        (
          str-substring s 0 lp
        )
        prefix
      )
      false
    )
  )
)
(
  defn str-drop
  (
    s n
  )
  (
    if
    (
      <= n
      (
        str-length s
      )
    )
    (
      str-substring s n
      (
        str-length s
      )
    )
    ""
  )
)
(
  defn str-join
  (
    lst sep
  )
  (
    match lst
    (
      Nil
      ""
    )
    (
      (
        Cons h Nil
      )
      h
    )
    (
      (
        Cons h t
      )
      (
        str-concat h
        (
          str-concat sep
          (
            str-join t sep
          )
        )
      )
    )
  )
)
(
  defn str-sort
  (
    lst
  )
  (
    match lst
    (
      Nil Nil
    )
    (
      (
        Cons h Nil
      )
      (
        Cons h Nil
      )
    )
    (
      (
        Cons h t
      )
      (
        let sorted
        (
          str-sort t
        )
        (
          str-insert h sorted
        )
      )
    )
  )
)
(
  defn str-insert
  (
    x lst
  )
  (
    match lst
    (
      Nil
      (
        Cons x Nil
      )
    )
    (
      (
        Cons h t
      )
      (
        if
        (
          <= x h
        )
        (
          Cons x
          (
            Cons h t
          )
        )
        (
          Cons h
          (
            str-insert x t
          )
        )
      )
    )
  )
)
(
  defn str-dedup
  (
    lst
  )
  (
    match lst
    (
      Nil Nil
    )
    (
      (
        Cons h t
      )
      (
        if
        (
          list-contains t h
        )
        (
          str-dedup t
        )
        (
          Cons h
          (
            str-dedup t
          )
        )
      )
    )
  )
)
(
  defn param-type-from-str
  (
    s
  )
  (
    if
    (
      = s
      "Int"
    )
    TInt
    (
      if
      (
        = s
        "Float"
      )
      TFloat
      (
        if
        (
          = s
          "Bool"
        )
        TBool
        (
          if
          (
            = s
            "String"
          )
          TString
          (
            if
            (
              = s
              "Unit"
            )
            TUnit
            (
              TVar 0
            )
          )
        )
      )
    )
  )
)
(
  defn is-uppercase-ident
  (
    name
  )
  (
    if
    (
      =
      (
        str-length name
      )
      0
    )
    false
    (
      str-contains
      "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
      (
        str-substring name 0 1
      )
    )
  )
)
(
  defn lookup-fn-sigs
  (
    ctx name
  )
  (
    kv-get
    (
      mc-known-fns ctx
    )
    name Nil
  )
)
(
  defn lookup-known-type
  (
    ctx name
  )
