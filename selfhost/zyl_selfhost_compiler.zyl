(
  defn zip-params
  (
    params types
  )
  (
    match params
    (
      Nil Nil
    )
    (
      (
        Cons p rest-p
      )
      (
        match types
        (
          Nil Nil
        )
        (
          (
            Cons t rest-t
          )
          (
            Cons
            (
              Pair p t
            )
            (
              zip-params rest-p rest-t
            )
          )
        )
      )
    )
  )
)
