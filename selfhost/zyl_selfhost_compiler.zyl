(
  defn unify-types
  (
    t1 t2
  )
  (
    cond
    (
      (
        = t1 t2
      )
      true
    )
    (
      (
        = t1
        (
          TVar 0
        )
      )
      true
    )
    (
      (
        = t2
        (
          TVar 0
        )
      )
      true
    )
    (
      (
        = t1
        (
          TCap
          (
            TVar 0
          )
        )
      )
      true
    )
    (
      (
        = t2
        (
          TCap
          (
            TVar 0
          )
        )
      )
      true
    )
    (
      (
        = t1
        (
          TPrim PInt
        )
      )
      (
        = t2
        (
          TPrim PFloat
        )
      )
    )
    (
      (
        = t1
        (
          TPrim PFloat
        )
      )
      (
        = t2
        (
          TPrim PInt
        )
      )
    )
    (
      else false
    )
  )
)
(
  defn kv-type-names
  (
    type-map keys
  )
  (
    match keys
    (
      Nil Nil
    )
    (
      Cons k rest
      (
        Cons
        (
          type-to-string
          (
            kv-get type-map k
            (
              TVar 0
            )
          )
        )
        (
          kv-type-names type-map rest
        )
      )
    )
  )
)
(
  defn canonical-name-from-type-map
  (
    base-name type-map
  )
  (
    let sorted-keys
    (
      str-sort
      (
        kv-keys type-map
      )
    )
    (
      let unique-sorted
      (
        str-sort
        (
          str-dedup
          (
            kv-type-names type-map sorted-keys
          )
        )
      )
      (
        str-concat base-name
        (
          str-concat
          "_"
          (
            str-join unique-sorted
            "_"
          )
        )
      )
    )
  )
)
(
  defn resolve-call-site-collect
  (
    ctx known args i
  )
  (
    match args
    (
      Nil Nil
    )
    (
      Cons arg rest
      (
        let tail
        (
          resolve-call-site-collect ctx known rest
          (
            + i 1
          )
        )
        (
          if
          (
            < i
            (
              list-length known
            )
          )
          (
            match
            (
              list-nth known i
            )
            (
              MK pname expected
              (
                if
                (
                  is-uppercase-ident pname
                )
                (
                  kv-set tail pname
                  (
                    infer-arg-type ctx arg
                  )
                )
                tail
              )
            )
          )
          tail
        )
      )
    )
  )
)
(
  defn resolve-call-site
  (
    ctx fname generics args
  )
  (
    if
    (
      =
      (
        list-length generics
      )
      0
    )
    None
    (
      let known
      (
        lookup-fn-sigs ctx fname
      )
      (
        let type-map
        (
          resolve-call-site-collect ctx known args 0
        )
        (
          if
          (
            =
            (
              list-length type-map
            )
            0
          )
          None
          (
            Some
            (
              canonical-name-from-type-map fname type-map
            )
          )
        )
      )
    )
  )
)
(
  defn collect-instantiations-bounds
  (
    ctx generics
  )
  (
    match generics
    (
      Nil Nil
    )
    (
      Cons g rest
      (
        let tail
        (
          collect-instantiations-bounds ctx rest
        )
        (
          match
          (
            MP.bounds g
          )
          (
            Nil tail
          )
          (
            Cons bound d18
            (
              match
              (
                find-satisfying-types ctx bound
              )
              (
                Nil tail
              )
              (
                Cons t d19
                (
                  Cons
                  (
                    Pair
                    (
                      MP.name g
                    )
                    t
                  )
                  tail
                )
              )
            )
          )
        )
      )
    )
  )
)
(
  defn pairs-to-kv
  (
    pairs
  )
  (
    match pairs
    (
      Nil Nil
    )
    (
      Cons pr rest
      (
        match pr
        (
          Pair k v
          (
            kv-set
            (
              pairs-to-kv rest
            )
            k v
          )
        )
      )
    )
  )
)
(
  defn collect-instantiations
  (
    ctx name generics
  )
  (
    let pairs
    (
      collect-instantiations-bounds ctx generics
    )
    (
      if
      (
        =
        (
          list-length pairs
        )
        0
      )
      Nil
      (
        Cons
        (
          pairs-to-kv pairs
        )
        Nil
      )
    )
  )
)
(
  defn build-instance-param
  (
    p type-map
  )
  (
    if
    (
      is-uppercase-ident
      (
        P.name p
      )
    )
    (
      if
      (
        kv-contains type-map
        (
          P.name p
        )
      )
      (
        MP
        (
          P.name p
