              )
            )
          )
        )
      )
    )
  )
)
(
  defn resolve-param-types
  (
    inferer params ret-type
  )
  (
    match
    params
    (
      Nil Nil
    )
    (
      Cons hd rest
      (
        match hd
        (
          PT name ptype
          (
            Cons
            (
              PT name
              (
                resolve-type-var inferer ptype ret-type
              )
            )
            (
              resolve-param-types inferer rest ret-type
            )
          )
        )
      )
    )
  )
)
