(
  defn mr-str-in-list
  (
    s xs
  )
  (
    match xs
    (
      Nil 0
    )
    (
      Cons h t
      (
        if
        (
          >
          (
            str-eq s h
          )
          0
        )
        1
        (
          mr-str-in-list s t
        )
      )
    )
  )
)
(
