; ===== AUTO-ASSEMBLED SELF-HOSTED COMPILER (boot source) =====

; ---------- stdlib/core/option.zyl ----------
; === Zyl Standard Library — Option ADT ===
; Module: option
; Provides: Generic Option<T> ADT and helpers
;
; Cross-module conversions (option-to-result, option-from-result) are in core/core.zyl
; to avoid a circular dependency between option and result modules.

; ===========================================================================
; OPTION ADT — Generic: Option<T>
; ===========================================================================

(deftype Option (Some T) None)

; ===========================================================================
; OPTION OPERATIONS
; ===========================================================================

(defn option-unwrap (opt default)
  (match opt
    (Some v v)
    (None default)))

(defn option-is-some (opt)
  (match opt
    (Some w1x true)
    (None false)))

(defn option-is-none (opt)
  (match opt
    (Some w2x false)
    (None true)))

(defn option-map (opt f)
  (match opt
    (Some v (Some (f v)))
    (None None)))

(defn option-and (opt other)
  (match opt
    (Some w3x other)
    (None None)))

(defn option-or (opt other)
  (match opt
    (Some w4x opt)
    (None other)))

(defn option-expect (opt msg)
  (match opt
    (Some v v)
    (None (error msg))))

(defn option-unwrap-or (opt default)
  (match opt
    (Some v v)
    (None default)))

; ===========================================================================
; OPTION CONSTRUCTORS
; ===========================================================================

(defn option-none () None)

(defn option-some (x) (Some x))

; ===========================================================================
; OPTION UTILITIES
; ===========================================================================

(defn option-flatmap (opt f)
  (match opt
    (Some v (f v))
    (None None)))

(defn option-inspect (opt f)
  (match opt
    (Some v (begin (f v) opt))
    (None opt)))

; ---------- stdlib/core/list.zyl ----------
; === Zyl Standard Library — List ADT ===
; Module: list
; Provides: Generic List<T> ADT and list utilities
;
; list-car returns Option<T>, requires Option to be in scope
; (provided via core/core.zyl which imports option before list)

; ===========================================================================
; LIST ADT — Generic: List<T>
; ===========================================================================

(deftype List (Cons T (List T)) Nil)

; ===========================================================================
; LIST OPERATIONS
; ===========================================================================

(defn is-nil (xs)
  (match xs
    (Cons w1x w2x false)
    (Nil true)))

(defn list-car (xs)
  (match xs
    (Cons v w3x (Some v))
    (Nil None)))

(defn list-cdr (xs)
  (match xs
    (Cons w4x rest rest)
    (Nil None)))

; Length
(defn list-length (xs)
  (match xs
    (Nil 0)
    (Cons w5x rest (+ 1 (list-length rest)))))

; Append
(defn list-append (xs ys)
  (match xs
    (Nil ys)
    (Cons h t (Cons h (list-append t ys)))))

; Reverse
(defn list-reverse (xs)
  (list-reverse-acc xs Nil))

(defn list-reverse-acc (xs acc)
  (match xs
    (Nil acc)
    (Cons h t (list-reverse-acc t (Cons h acc)))))

; Sum of list (Int only — monomorphized by use site)
(defn list-sum (xs)
  (match xs
    (Nil 0)
    (Cons h t (+ h (list-sum t)))))

; ---------- stdlib/allocator/allocator.zyl ----------
; === Zyl Standard Library — Allocator ===
; Module: allocator
; Provides: Raw memory arena backed by C runtime helpers.
;           All addresses are Ints (64-bit pointers).
;
; NOTE: No garbage collection or refcounting. Callers are responsible for
;       freeing memory via `alloc-free`. Deterministic by design (region §).

; ===========================================================================
; RAW ALLOCATION
; ===========================================================================

; Allocate `size` bytes on the heap. Returns address as Int, or 0 on failure.
; Returns: Int (address)
(defn alloc-malloc (size)
  (ffi-call "zyl_mem_alloc" size 1000))

; Free memory previously returned by `alloc-malloc`.
; Returns: Unit
(defn alloc-free (ptr)
  (ffi-call "zyl_mem_free" ptr 1000))

; ===========================================================================
; TYPED ACCESS
; ===========================================================================

; Read a 64-bit integer from `addr`.
; Returns: Int
(defn alloc-read-int (addr)
  (ffi-call "zyl_mem_read" addr 1000))

; Write a 64-bit integer to `addr`.
; Returns: Unit
(defn alloc-write-int (addr value)
  (ffi-call "zyl_mem_write" addr value 1000))

; Allocate a single 64-bit integer slot initialized to `value`.
; Returns: Int (address)
(defn alloc-int (value)
  (let p (alloc-malloc 8)
    (begin
      (alloc-write-int p value)
      p)))

; ===========================================================================
; STRING LENGTH
; ===========================================================================

; Return the byte length of a NUL-terminated C string at `ptr`, excluding the
; terminator. Returns: Int
(defn alloc-strlen (ptr)
  (ffi-call "zyl_cstr_len" ptr 1000))

; ===========================================================================
; BOXED HELPERS
; ===========================================================================

; Increment the integer stored at `addr` by 1 (non-atomic).
; Returns: Unit
(defn alloc-incr (addr)
  (alloc-write-int addr (+ (alloc-read-int addr) 1)))

; Decrement the integer stored at `addr` by 1 (non-atomic).
; Returns: Unit
(defn alloc-decr (addr)
  (alloc-write-int addr (- (alloc-read-int addr) 1)))

; ===========================================================================
; REGION-BASED ARENA ALLOCATOR
; ===========================================================================
;
; Arenas give deterministic, zero-fragmentation bulk reclamation:
;   - bump allocation from growable 16-byte-aligned blocks
;   - `arena-reset` frees every block at once (handle stays valid)
;   - `arena-destroy` frees everything including the handle
; No per-object free. Arenas are single-threaded by design (one per
; actor/scope, matching actor isolation). All addresses are Ints.
;
; Usage:
;   (let a (arena-create 0)         ; default 64 KiB blocks
;     (begin
;       (let p (arena-alloc-zeroed a 1024)
;         (begin
;           ... use p ...
;           (arena-reset a)))       ; reclaim, reuse `a`
;       (arena-destroy a)))         ; release everything

; Create a new arena. `block-size` is the default block size in bytes;
; values < 16 select the default (64 KiB). Returns a handle (Int), or 0
; on failure.
; Returns: Int (handle)
(defn arena-create (block-size)
  (let h (ffi-call "zyl_arena_create" block-size 1000) h))

; Allocate `size` bytes from `arena`, 16-byte aligned. Returns an address
; (Int), or 0 on failure.
; Returns: Int (address)
(defn arena-alloc (arena size)
  (let h (ffi-call "zyl_arena_alloc" arena size 1000) h))

; Allocate `size` zero-initialized bytes from `arena`. Returns an address
; (Int), or 0 on failure.
; Returns: Int (address)
(defn arena-alloc-zeroed (arena size)
  (let h (ffi-call "zyl_arena_alloc_zeroed" arena size 1000) h))

; Free every block in `arena` at once. The handle stays valid and the arena
; can be reused immediately.
; Returns: Unit
(defn arena-reset (arena)
  (let h (ffi-call "zyl_arena_reset" arena 1000) h))

; Free every block in `arena` and invalidate the handle.
; Returns: Unit
(defn arena-destroy (arena)
  (let h (ffi-call "zyl_arena_destroy" arena 1000) h))

; Bytes currently allocated from `arena`.
; Returns: Int
(defn arena-used (arena)
  (let h (ffi-call "zyl_arena_used" arena 1000) h))

; Total block capacity backing `arena`.
; Returns: Int
(defn arena-capacity (arena)
  (let h (ffi-call "zyl_arena_capacity" arena 1000) h))

; ===========================================================================
; STRING HELPERS
; ===========================================================================

; Byte length of a NUL-terminated string at `ptr`, excluding terminator.
; Returns: Int
(defn str-len (ptr)
  (alloc-strlen ptr))

; Intern a String into `arena`: copy its bytes (including terminator) into a
; fresh zeroed buffer. Returns the buffer pointer.
; Returns: Int (pointer)
; Append src at the end of the NUL-terminated string in dst (true append,
; NOT overwrite). Matches the Rust bootstrap's StringBuffer backend so
; stage>=2 codegen output accumulates across emits.
; Returns: dst
(defn buf-append (dst src)
  (ffi-call "zyl_str_append" dst src 1000))

; Zyl-level error: print and exit.
(defn error (msg)
  (ffi-call "f_error" msg 1000))

(defn str-intern (arena s)
  (let n (alloc-strlen s)
    (let p (arena-alloc-zeroed arena (+ n 1))
      (begin
        (buf-append p s)
        p))))

; Whether two NUL-terminated strings are byte-identical.
; Returns: Bool (0/1)
(defn str-eq (p1 p2)
  (ffi-call "zyl_cstr_eq" p1 p2 1000))

; ---------- stdlib/compiler/ast.zyl ----------
; === Zyl Standard Library — Compiler AST types ===
; Module: compiler/ast
;
; The compiler front-end is built entirely on recursive algebraic data
; types (spec §9 deftype). Every phase communicates in ADT values and
; every traversal is a structural `match`:
;
;   Token  — lexer output; a token stream is a (List Token)
;   Ast    — reader/parser output; source trees are nested AList forms
;            (Zyl's no-dispatch parsing: special forms are recognised by
;            the consumer, not by the parser)
;   Env    — immutable name→slot chain used by lowering/codegen
;   VTable — immutable variant-name→(tag, arity) chain for ADTs
;
; There are no numeric node-kind tags, no projection/downcast accessors,
; no raw arena record layouts, and no index-based node tables anywhere.
;
; Bootstrap constraint note: pattern wildcards must be named dummies
; (`d1`, `d2`, ...) because the Rust bootstrap miscompiles bare `_`
; patterns. This is spelled `dN` uniformly across stdlib/compiler.


; --- Lexer tokens ----------------------------------------------------------

(deftype Token
  (TkEof)
  (TkIdent String)
  (TkInt Int)
  (TkFloat String)
  (TkString String)
  (TkBool Bool)
  (TkSymbol String)
  (TkKeyword String)
  (TkLParen)
  (TkRParen)
  (TkLBrace)
  (TkRBrace)
  (TkLBracket)
  (TkRBracket)
  (TkColon))

; --- Parsed source ---------------------------------------------------------

; A parsed s-expression: an atom or a parenthesised list of forms.
(deftype Ast
  (AIdent String)
  (AInt Int)
  (AFloat String)
  (AString String)
  (ABool Bool)
  (AList (List Ast)))

; --- Immutable environments -------------------------------------------------

; Immutable environment chain: name -> stack slot offset from rbp.
(deftype Env
  (EnvBind String Int Int Env)   ; name, rbp-offset, kind (0 int,1 str,2 float)
  (EnvNil))

; Look up a name in an Env chain.
; Returns: Int (offset, or 0 if unbound)
(defn env-lookup (env name)
  (match env
    (EnvBind n off d1 rest (if (str-eq n name) off (env-lookup rest name)))
    (EnvNil 0)))

; Look up the kind of a name in an Env chain.
; Returns: Int (0 int, 1 str, 2 float, 0 if unbound)
(defn env-kind-of (env name)
  (match env
    (EnvBind n d2 k rest (if (str-eq n name) k (env-kind-of rest name)))
    (EnvNil 0)))

; --- Variant tables ---------------------------------------------------------

; Immutable variant table: variant name -> tag + field count.
(deftype VTable
  (VTEntry String Int Int VTable)  ; variant name, tag, arity
  (VTNil))

; Tag for an interned variant name; -1 when absent.
; Returns: Int
(defn vt-tag-of (vt name)
  (match vt
    (VTEntry n tag d3 rest (if (str-eq n name) tag (vt-tag-of rest name)))
    (VTNil -1)))

; Field count for an interned variant name; -1 when absent.
; Returns: Int
(defn vt-arity-of (vt name)
  (match vt
    (VTEntry n d4 ar rest (if (str-eq n name) ar (vt-arity-of rest name)))
    (VTNil -1)))

; --- Token stream helpers ----------------------------------------------------

; Head of a token stream (TkEof when empty).
; Returns: Token
(defn toks-head (toks)
  (match toks
    (Cons t d5 t)
    (Nil (TkEof))))

; Tail of a token stream (empty when empty).
; Returns: List(Token)
(defn toks-tail (toks)
  (match toks
    (Cons d6 rest rest)
    (Nil Nil)))

; ---------- stdlib/compiler/lexer.zyl ----------
; === Zyl Standard Library — Compiler Lexer ===
; Module: compiler/lexer
; Provides: A deterministic tokenizer for Zyl source.
;
; Input:  a NUL-terminated source buffer (Int pointer).
; Output: a (List Token) in source order (see compiler/ast), ending with
;         a single TkEof.
;
; Design: pure functional scanner. The cursor is threaded through
; arguments (arena, src, len, i) — no state records, no raw layouts.
; Determinism: source scanned strictly left-to-right; stream order
; preserved by construction (each step conses onto the returned stream).
; Comments (`;` .. end of line) are skipped inline.



; ===========================================================================
; CHARACTER CLASSES (byte values; ASCII)
; ===========================================================================

(defn chr-ws-p (c)
  (if (= c 32) 1 (if (= c 9) 1 (if (= c 13) 1 (if (= c 10) 1 0)))))

(defn chr-digit-p (c)
  (if (>= c 48) (if (<= c 57) 1 0) 0))

(defn chr-alpha-p (c)
  (if (>= c 65)
    (if (<= c 90) 1 (if (>= c 97) (if (<= c 122) 1 0) 0))
    (if (>= c 97) (if (<= c 122) 1 0) 0)))

; Mirror Rust lexer is_ident_start: alpha | _ - ? ! + / = < > * %
(defn chr-ident-start-p (c)
  (if (= (chr-alpha-p c) 1) 1
    (if (= c 95) 1
      (if (= c 45) 1
        (if (= c 63) 1
          (if (= c 33) 1
            (if (= c 43) 1
              (if (= c 47) 1
                (if (= c 61) 1
                  (if (= c 60) 1
                    (if (= c 62) 1
                      (if (= c 42) 1
                        (if (= c 37) 1 0)))))))))))))

; Mirror Rust lexer is_ident_continue: alnum | _ - ? ! / = + % .
(defn chr-ident-cont-p (c)
  (if (= (chr-digit-p c) 1) 1
    (chr-ident-start-2 c)))

; ident-continue adds '.' over ident-start and drops nothing else.
(defn chr-ident-start-2 (c)
  (if (= c 46) 1 (chr-ident-start-p c)))

(defn chr-semicolon-p (c) (if (= c 59) 1 0))

; Logical or on two 0/1 values (avoids and/or forms).
(defn either (a b)
  (if (= a 0) (if (= b 0) 0 1) 1))

; ===========================================================================
; BYTE / SCAN PRIMITIVES
; ===========================================================================

; Byte at `i` in `src` (NUL-terminated).
; Returns: Int
(defn byte-at (src i)
  (ffi-call "zyl_cstr_byte_at" src i 1000))

; End index (exclusive) of an identifier starting at `i`.
; Returns: Int
(defn scan-ident-end (src len i)
  (if (>= i len)
    i
    (if (= (chr-ident-cont-p (byte-at src i)) 1)
      (scan-ident-end src len (+ i 1))
      i)))

; Digits/'.' run for a numeric literal body.
; Returns: Int (end, exclusive)
(defn scan-num-body (src len i)
  (if (>= i len)
    i
    (let c (byte-at src i)
      (if (= (chr-digit-p c) 1)
        (scan-num-body src len (+ i 1))
        (if (= c 46)
          (scan-num-body src len (+ i 1))
          i)))))

; Digit run of an exponent tail.
; Returns: Int (end, exclusive)
(defn scan-exp-digits (src len i)
  (if (>= i len)
    i
    (if (= (chr-digit-p (byte-at src i)) 1)
      (scan-exp-digits src len (+ i 1))
      i)))

; Exponent tail: e/E [+-] digits. `i` points at e/E.
; Returns: Int (end, exclusive)
(defn scan-exp (src len i)
  (scan-exp-j src len i (+ i 1)))

; j = candidate exponent-digit start.
(defn scan-exp-j (src len i j)
  (if (>= j len)
    i
    (scan-exp-b src len i j (byte-at src j))))

(defn scan-exp-b (src len i j b)
  (scan-exp-digits src len
                   (if (= (either (= b 43) (= b 45)) 1) (+ j 1) j)))

; Full numeric literal end from `start` (sign included in caller).
; Returns: Int (end, exclusive)
(defn scan-number-end (src len start)
  (let i (if (= (byte-at src start) 45) (+ start 1) start)
    (let mid (scan-num-body src len i)
      (if (>= mid len)
        mid
        (let c (byte-at src mid)
          (if (= (either (= c 101) (= c 69)) 1)
            (scan-exp src len mid)
            mid))))))

; Index of the closing '"' for a string opened before `i`; -1 if unterminated.
; Returns: Int
(defn scan-str-end (src len i)
  (if (>= i len)
    -1
    (let b (byte-at src i)
      (if (= b 92)
        (if (<= (+ i 1) (- len 1))
          (scan-str-end src len (+ i 2))
          -1)
        (if (= b 34)
          i
          (scan-str-end src len (+ i 1)))))))

; Whether numeric literal text contains '.' or e/E (float marker).
; Returns: Bool (0/1)
(defn text-float-marker-p (text)
  (marker-loop text (ffi-call "zyl_cstr_len" text 1000) 0))

(defn marker-loop (text n i)
  (if (>= i n)
    0
    (let c (byte-at text i)
      (if (= (either (= c 46) (either (= c 101) (= c 69))) 1)
        1
        (marker-loop text n (+ i 1))))))

; End of a `;`-comment: first '\n' index (exclusive), or len.
; Returns: Int
(defn comment-end (src len i)
  (if (>= i len)
    len
    (if (= (byte-at src i) 10)
      i
      (comment-end src len (+ i 1)))))

; Delimiters that stop a keyword/symbol head: ( ) { } [ ] : ~
(defn chr-punctuator-p (c)
  (if (= c 40) 1
    (if (= c 41) 1
      (if (= c 123) 1
        (if (= c 125) 1
          (if (= c 91) 1
            (if (= c 93) 1
              (if (= c 58) 1 (if (= c 126) 1 0)))))))))

; Empty token stream (typed so `Nil` never unifies as Option).
(defn no-tokens () Nil)

; ===========================================================================
; MAIN LEXER — one function, one self-tail-recursion site
; ===========================================================================
; ALL routing and token production live inside lex-loop: every
; continuation is a DIRECT self-call, so the bootstrap's self-tail-call
; optimization keeps scanning O(1) stack. Any helper hop here would leak
; a frame per token and exhaust the stack on large inputs.
;
; Bootstrap constraints honored: named dummies (never bare _), arity <=6,
; flat if-chains (no nesting deeper than the proven ic-special shape).


(defn zyl-lex (arena src)
  (let len (ffi-call "zyl_cstr_len" src 1000)
    (list-reverse (lex-loop arena src len 0 Nil))))

(defn lex-loop (arena src len i acc)
  (if (>= i len)
    (Cons (TkEof) acc)
    (lex-c1 arena src len i acc (byte-at src i))))

(defn lex-c1 (arena src len i acc c)
  (if (= (chr-ws-p c) 1)
    (lex-loop arena src len (+ i 1) acc)
    (if (= (chr-semicolon-p c) 1)
      (lex-loop arena src len (comment-end src len (+ i 1)) acc)
      (if (= c 40)
        (lex-loop arena src len (+ i 1) (Cons (TkLParen) acc))
        (if (= c 41)
          (lex-loop arena src len (+ i 1) (Cons (TkRParen) acc))
          (if (= c 123)
            (lex-loop arena src len (+ i 1) (Cons (TkLBrace) acc))
            (if (= c 125)
              (lex-loop arena src len (+ i 1) (Cons (TkRBrace) acc))
              (if (= c 91)
                (lex-loop arena src len (+ i 1) (Cons (TkLBracket) acc))
                (if (= c 93)
                  (lex-loop arena src len (+ i 1) (Cons (TkRBracket) acc))
                  (lex-c2 arena src len i acc c))))))))))

(defn lex-c2 (arena src len i acc c)
  (if (= c 34)
    (lex-str-e arena src len i acc (scan-str-end src len (+ i 1)))
    (if (= c 58)
      (lex-sym-probe arena src len i acc)
      (if (= c 126)
        (lex-sym-probe arena src len i acc)
        (if (= (chr-digit-p c) 1)
          (lex-num-e arena src len i acc (scan-number-end src len i))
          (if (= c 45)
            (lex-minus-e arena src len i acc)
            (if (= (chr-ident-start-p c) 1)
              (lex-ident-e arena src len i acc (scan-ident-end src len i))
              ; unrecognized character: terminate the stream
              (Cons (TkEof) acc))))))))

(defn lex-minus-e (arena src len i acc)
  (if (= (chr-digit-p (byte-at src (+ i 1))) 1)
    (lex-num-e arena src len i acc (scan-number-end src len i))
    (lex-ident-e arena src len i acc (scan-ident-end src len i))))

; String literal: e = index of closing quote (-1 unterminated).
(defn lex-str-e (arena src len i acc e)
  (if (< e 0)
    (Cons (TkEof) acc)
    (lex-loop arena src len (+ e 1)
              (Cons (TkString (ffi-call "zyl_cstr_decode" arena src (+ i 1) e 1000)) acc))))

; Numeric literal: i..e; float when the text carries '.' or exponent.
(defn lex-num-e (arena src len i acc e)
  (let text (sub-str arena src i (- e i))
    (if (= (text-float-marker-p text) 1)
      (lex-loop arena src len e (Cons (TkFloat text) acc))
      (lex-loop arena src len e (Cons (TkInt (ffi-call "zyl_cstr_to_int" text 1000)) acc)))))

; Identifier / boolean literal: i..e with text.
(defn lex-ident-e (arena src len i acc e)
  (let text (sub-str arena src i (- e i))
    (if (> (str-eq text (str-intern arena "true")) 0)
      (lex-loop arena src len e (Cons (TkBool true) acc))
      (if (> (str-eq text (str-intern arena "false")) 0)
        (lex-loop arena src len e (Cons (TkBool false) acc))
        (lex-loop arena src len e (Cons (TkIdent text) acc))))))

; ':' / '~' prefixed keyword or symbol: probe the next non-ws char.
(defn lex-sym-probe (arena src len i acc)
  (lex-sym-pk arena src len i acc (next-nonws src len (+ i 1))))

; c is the character at i, recovered with byte-at so the arity stays <= 6.
(defn lex-sym-pk (arena src len i acc pk)
  (let c (byte-at src i)
    (if (< pk 0)
      (lex-sym-bare arena src len i acc c)
      (if (= (chr-ident-start-p (byte-at src pk)) 0)
        (lex-sym-bare arena src len i acc c)
        (if (= (chr-punctuator-p (byte-at src pk)) 1)
          (lex-sym-bare arena src len i acc c)
          (lex-sym-tok arena src len i acc (scan-ident-end src len pk)))))))

; end = index one past the symbol text; token kind depends on the
; introducing character c (58 = ':').
(defn lex-sym-tok (arena src len i acc end)
  (let c (byte-at src i)
    (let text (sub-str arena src (+ i 1) (- end (+ i 1)))
      (if (= c 58)
        (lex-loop arena src len end (Cons (TkKeyword text) acc))
        (lex-loop arena src len end (Cons (TkSymbol text) acc))))))

(defn lex-sym-bare (arena src len i acc c)
  (if (= c 58)
    (lex-loop arena src len (+ i 1) (Cons (TkColon) acc))
    (lex-loop arena src len (+ i 1) (Cons (TkSymbol (sub-str arena src i 1)) acc))))

; ===========================================================================
; SCAN UTILITIES
; ===========================================================================

; Extract a substring of `src` as a fresh NUL-terminated buffer.
; Returns: Int (pointer)
(defn sub-str (arena src start n)
  (ffi-call "zyl_cstr_sub" arena src start n 1000))

; Index of the next non-whitespace character at or after `i`; -1 at end.
(defn next-nonws (src len i)
  (if (>= i len)
    -1
    (if (= (chr-ws-p (byte-at src i)) 1)
      (next-nonws src len (+ i 1))
      i)))

; ---------- stdlib/compiler/parser.zyl ----------
; === Zyl Standard Library — Compiler Parser (reader) ===
; Module: compiler/parser
;
; A pure recursive-descent reader over a (List Token) stream, producing
; nested Ast values (see compiler/ast). Deliberately *dispatch-free*
; (spec architecture decision): every parenthesised form becomes an
; (AList ...); special forms (defn, let, if, ...) are recognised by the
; consumer phases, never by the parser.
;
; read-* functions return an AstTok: the parsed form plus the remaining
; token stream (functional threading, no mutable state).
;
; Every decision is a structural `match` on Token/Ast variants with ALL
; constructors enumerated (Zyl matches are exhaustive and have no
; wildcard catch-all). There are no numeric kind codes and no projection
; accessors.



; Result wrapper: parsed Ast + remaining tokens.
(deftype AstTok (AstOf Ast (List Token)))

; Empty form list (typed so `Nil` never unifies as Option).
(defn no-forms () Nil)

(defn art-ast (r)
  (match r
    (AstOf a d1 a)))

(defn art-rest (r)
  (match r
    (AstOf d2 rest rest)))

; ===========================================================================
; STREAM HELPERS
; ===========================================================================

; True only for the stream terminator token.
(defn tok-is-eof (t)
  (match t
    (TkEof true)
    (TkIdent d3 false)
    (TkInt d4 false)
    (TkFloat d5 false)
    (TkString d6 false)
    (TkBool d7 false)
    (TkSymbol d8 false)
    (TkKeyword d9 false)
    (TkLParen false)
    (TkRParen false)
    (TkLBrace false)
    (TkRBrace false)
    (TkLBracket false)
    (TkRBracket false)
    (TkColon false)))

; True when the stream is exhausted (empty or at TkEof).
; Returns: Bool
(defn toks-empty (toks)
  (match toks
    (Cons t d10 (tok-is-eof t))
    (Nil true)))

; ===========================================================================
; READER
; ===========================================================================

; Read one form at the head of `toks`.
; Returns: AstTok
(defn read-form (arena toks)
  (let t (toks-head toks)
    (let rest (toks-tail toks)
      (read-dispatch arena t rest))))

(defn read-dispatch (arena t rest)
  (match t
        (TkLParen (read-forms arena rest (no-forms)))
        (TkLBracket (read-forms-bracket arena rest (no-forms)))
        (TkLBrace (read-forms-brace arena rest (no-forms)))
        (TkRParen (read-form-atom arena t rest))
        (TkRBrace (read-form-atom arena t rest))
        (TkRBracket (read-form-atom arena t rest))
        (TkColon (read-form-atom arena t rest))
        (TkEof (read-form-atom arena t rest))
        (TkInt d11 (read-form-atom arena t rest))
        (TkFloat d12 (read-form-atom arena t rest))
        (TkString d13 (read-form-atom arena t rest))
        (TkBool d14 (read-form-atom arena t rest))
        (TkIdent d15 (read-form-atom arena t rest))
        (TkSymbol d16 (read-form-atom arena t rest))
        (TkKeyword d17 (read-form-atom arena t rest))))

; Atoms and terminators: everything except openers.
; Returns: AstTok
(defn read-form-atom (arena t rest)
  (match t
    (TkInt v (AstOf (AInt v) rest))
    (TkBool b (AstOf (ABool b) rest))
    (TkFloat s (AstOf (AFloat s) rest))
    (TkString s (AstOf (AString s) rest))
    (TkIdent s (AstOf (AIdent s) rest))
    (TkSymbol s (AstOf (AIdent s) rest))
    (TkKeyword s (AstOf (AIdent s) rest))
    ; closers / colon / eof in atom position: empty form
    (TkEof (AstOf (AList Nil) rest))
    (TkLParen (AstOf (AList (no-forms)) rest))
    (TkRParen (AstOf (AList (no-forms)) rest))
    (TkLBrace (AstOf (AList (no-forms)) rest))
    (TkRBrace (AstOf (AList (no-forms)) rest))
    (TkLBracket (AstOf (AList (no-forms)) rest))
    (TkRBracket (AstOf (AList (no-forms)) rest))
    (TkColon (AstOf (AList (no-forms)) rest))))

; Read forms until ')' (or EOF), accumulating into `acc` (reverse order).
; Returns: AstTok wrapping (AList forms...)
(defn read-forms (arena toks acc)
  (if (toks-empty toks)
    (AstOf (AList (list-reverse acc)) toks)
    (let t (toks-head toks)
      (if (= (tok-is-rparen t) 1)
        (AstOf (AList (list-reverse acc)) (toks-tail toks))
        (let r (read-form arena toks)
          (read-forms arena (art-rest r) (Cons (art-ast r) acc)))))))

(defn tok-is-rparen (t)
  (match t
    (TkRParen true)
    (TkEof false)
    (TkIdent d18 false)
    (TkInt d19 false)
    (TkFloat d20 false)
    (TkString d21 false)
    (TkBool d22 false)
    (TkSymbol d23 false)
    (TkKeyword d24 false)
    (TkLParen false)
    (TkLBrace false)
    (TkRBrace false)
    (TkLBracket false)
    (TkRBracket false)
    (TkColon false)))

; Read forms until '}' (or EOF).
; Returns: AstTok wrapping (AList forms...)
(defn read-forms-brace (arena toks acc)
  (if (toks-empty toks)
    (AstOf (AList (list-reverse acc)) toks)
    (let t (toks-head toks)
      (if (= (tok-is-rbrace t) 1)
        (AstOf (AList (list-reverse acc)) (toks-tail toks))
        (let r (read-form arena toks)
          (read-forms-brace arena (art-rest r) (Cons (art-ast r) acc)))))))

(defn tok-is-rbrace (t)
  (match t
    (TkRBrace true)
    (TkEof false)
    (TkIdent d25 false)
    (TkInt d26 false)
    (TkFloat d27 false)
    (TkString d28 false)
    (TkBool d29 false)
    (TkSymbol d30 false)
    (TkKeyword d31 false)
    (TkLParen false)
    (TkRParen false)
    (TkLBrace false)
    (TkLBracket false)
    (TkRBracket false)
    (TkColon false)))

; Read forms until ']' (or EOF).
; Returns: AstTok wrapping (AList forms...)
(defn read-forms-bracket (arena toks acc)
  (if (toks-empty toks)
    (AstOf (AList (list-reverse acc)) toks)
    (let t (toks-head toks)
      (if (= (tok-is-rbracket t) 1)
        (AstOf (AList (list-reverse acc)) (toks-tail toks))
        (let r (read-form arena toks)
          (read-forms-bracket arena (art-rest r) (Cons (art-ast r) acc)))))))

(defn tok-is-rbracket (t)
  (match t
    (TkRBracket true)
    (TkEof false)
    (TkIdent d32 false)
    (TkInt d33 false)
    (TkFloat d34 false)
    (TkString d35 false)
    (TkBool d36 false)
    (TkSymbol d37 false)
    (TkKeyword d38 false)
    (TkLParen false)
    (TkRParen false)
    (TkLBrace false)
    (TkRBrace false)
    (TkLBracket false)
    (TkColon false)))

; Parse a whole source token stream into a program: a List of top-level
; Ast forms in source order.
; Returns: List(Ast)
(defn parse-program (arena toks)
  (list-reverse (parse-program-loop arena toks (no-forms))))

(defn parse-program-loop (arena toks acc)
  (if (toks-empty toks)
    acc
    (let r (read-form arena toks)
      (parse-program-loop arena (art-rest r) (Cons (art-ast r) acc)))))

; Convenience: lex + parse in one step from a source buffer pointer.
; Returns: List(Ast)
; Whole-token-stream paren balance. The reader consumes to EOF on an
; unclosed form, so imbalance must be checked on the token stream itself.
; All 15 variants enumerated: partial enumerations fail inference here.
(defn bal-walk (toks depth)
  (match toks
    (Nil depth)
    (Cons t rest
      (match t
        (TkLParen d50 (bal-walk rest (+ depth 1)))
        (TkRParen d51 (bal-walk rest (- depth 1)))
        (TkEof d52 (bal-walk rest depth))
        (TkIdent d53 (bal-walk rest depth))
        (TkInt d54 (bal-walk rest depth))
        (TkFloat d55 (bal-walk rest depth))
        (TkString d56 (bal-walk rest depth))
        (TkBool d57 (bal-walk rest depth))
        (TkSymbol d58 (bal-walk rest depth))
        (TkKeyword d59 (bal-walk rest depth))
        (TkLBrace d60 (bal-walk rest depth))
        (TkRBrace d61 (bal-walk rest depth))
        (TkLBracket d62 (bal-walk rest depth))
        (TkRBracket d63 (bal-walk rest depth))
        (TkColon d64 (bal-walk rest depth))))))

(defn check-balanced (toks)
  (if (= (bal-walk toks 0) 0)
    0
    (ffi-call "f_error" "E_UNBALANCED_PARENS: '(' and ')' counts differ" 1000)))

(defn zyl-parse (arena src)
  (let toks (zyl-lex arena src)
    (begin
      (check-balanced toks)
      (parse-program arena toks))))

; ---------- stdlib/compiler/resolver.zyl ----------
; === Zyl Module Resolver (self-hosted) ===
; Ports src/module_resolver.rs semantics:
;   - `(use path/module)` forms name dependencies.
;   - Dependencies resolve to `<name>.zyl`, else `stdlib/<name>.zyl`.
;   - Dependency definitions are inlined BEFORE the body, deduplicated.
;   - core/core is auto-linked when no core/* module is used explicitly.
;   - Root defn/def names shadow dependency definitions of the same name.
;
; Implemented ITERATIVELY (worklist + while) rather than recursively:
; sibling tail-calls through nested matches are not yet safe in the
; self-hosted codegen (see PROGRESS.md).



; --- helpers ---------------------------------------------------------------

(defn str-eq-cstr (a b)
  (= (ffi-call "strcmp" a b 1000) 0))

(defn str-in-list (name xs)
  (match xs
    (Nil 0)
    (Cons h1 tl
      (if (str-eq-cstr name h1)
        1
        (str-in-list name tl)))))

; Head identifier name of an AList form; "" otherwise.
(defn form-head-name (form)
  (match form
    (AList kids
      (match kids
        (Cons hd tl (match hd (AIdent nm nm) (dh "")))
        (dk "")))
    (df "")))

; Second element of an AList form when it is an identifier; "" otherwise.
(defn second-ident-in (kids)
  (match kids
    (Cons hd tl
      (match tl
        (Cons p1 r1 (match p1 (AIdent nm nm) (dp "")))
        (dr "")))
    (dn "")))

(defn form-second-ident (form)
  (match form
    (AList kids (second-ident-in kids))
    (df2 "")))

; `(use <module> ...)` -> module path; "" otherwise.
(defn use-module-name (form)
  (if (str-eq-cstr (form-head-name form) "use")
    (form-second-ident form)
    ""))

; Binding name of a top-level defn/def item; "" otherwise.
(defn def-binding-name (item)
  (let head (form-head-name item)
    (if (str-eq-cstr head "defn")
      (form-second-ident item)
      (if (str-eq-cstr head "def")
        (form-second-ident item)
        ""))))

(defn file-exists (path)
  (let fd (file-open path "r")
    (if (> fd 0)
      (begin (file-close fd) 1)
      0)))

; "<name>.zyl" if readable, else "stdlib/<name>.zyl", else "".
(defn find-dep-path (arena name)
  (let buf (arena-alloc-zeroed arena 512)
    (begin
      (buf-append buf name)
      (buf-append buf ".zyl")
      (if (= (file-exists buf) 1)
        buf
        (let buf2 (arena-alloc-zeroed arena 640)
          (begin
            (buf-append buf2 "stdlib/")
            (buf-append buf2 name)
            (buf-append buf2 ".zyl")
            (if (= (file-exists buf2) 1)
              buf2
              "")))))))

(defn read-file-src (path)
  (let fd (file-open path "r")
    (if (> fd 0)
      (let src (file-read fd 1048576)
        (begin (file-close fd) src))
      "")))

; --- use extraction ---------------------------------------------------------

(defn collect-use-names (items acc)
  (match items
    (Nil acc)
    (Cons item rest
      (let nm (use-module-name item)
        (if (> (alloc-strlen nm) 0)
          (collect-use-names rest (Cons nm acc))
          (collect-use-names rest acc))))))

(defn has-core-use (names)
  (match names
    (Nil 0)
    (Cons h1 tl
      (if (str-eq-cstr h1 "core/core")
        1
        (if (str-eq-cstr h1 "core/option")
          1
          (if (str-eq-cstr h1 "core/result")
            1
            (has-core-use tl)))))))

; Non-use items in original order.
(defn drop-use-forms (items acc)
  (match items
    (Nil (list-reverse acc))
    (Cons item rest
      (if (> (alloc-strlen (use-module-name item)) 0)
        (drop-use-forms rest acc)
        (drop-use-forms rest (Cons item acc))))))

; Top-level defn/def binding names, in order.
(defn collect-def-names (items acc)
  (match items
    (Nil (list-reverse acc))
    (Cons item rest
      (let nm (def-binding-name item)
        (if (> (alloc-strlen nm) 0)
          (collect-def-names rest (Cons nm acc))
          (collect-def-names rest acc))))))

; Drop defn/def items whose name appears in `shadows`.
(defn drop-shadowed (items shadows acc)
  (match items
    (Nil (list-reverse acc))
    (Cons item rest
      (let nm (def-binding-name item)
        (if (str-in-list nm shadows)
          (drop-shadowed rest shadows acc)
          (drop-shadowed rest shadows (Cons item acc)))))))

; Head/tail helpers (like car/cdr).
(defn shd (xs)
  (match xs
    (Cons h _ h)
    (Nil "")))

(defn stl (xs)
  (match xs
    (Cons _ t t)
    (Nil Nil)))

; Lookup module items from (Cons name items ...) list.
(defn module-items-for (name mod-items)
  (match mod-items
    (Nil Nil)
    (Cons (Cons nm its) rest
      (if (str-eq-cstr name nm)
        its
        (module-items-for name rest)))))

; --- resolution (iterative worklist) ---------------------------------------
;
; Worklist loop: pop a module name, load+parse it, push ITS uses to the front
; of the worklist, record its items. Completion order is dependency-safe
; (deps finish before their dependents because they are processed next).
; No recursion anywhere — sibling TCO through nested matches is not yet safe
; in the self-hosted codegen.

(defn resolve-program (arena items)
  (let uses0 (list-reverse (collect-use-names items Nil))
    (let todo0
      (if (= (has-core-use uses0) 0)
        (Cons "core/core" uses0)
        uses0)
      (begin
        (let-mut todo todo0)
        (let-mut seen Nil)
        (let-mut done-names Nil)
        (let-mut mod-items Nil)
        ; ---- Phase A: transitively load + parse every used module ----
        (while (not (is-nil todo))
          (begin
            (let name (shd todo)
              (begin
                (set! todo (stl todo))
                (if (= (str-in-list name seen) 0)
                  (begin
                    (set! seen (Cons name seen))
                    (let path (find-dep-path arena name)
                      (if (> (alloc-strlen path) 0)
                        (begin
                          (let src (read-file-src path))
                          (let its (zyl-parse arena src))
                          (begin
                            ; this module's own deps -> front of worklist
                            (set! todo (list-append (collect-use-names its Nil) todo))
                            (set! mod-items (Cons (Cons name its) mod-items))
                            (set! done-names (Cons name done-names)))))
                      (begin
                        (print "zylc: module not found:")
                        (print name)))))))))
        ; ---- Phase B: emit module items in completion order, then append
        ; the user body (root defn/def names shadow dep definitions) ----
        (let-mut emitted Nil)
        (let-mut dn (list-reverse done-names))
        (while (not (is-nil dn))
          (begin
            (let nm (shd dn)
              (begin
                (set! emitted
                  (list-append emitted (module-items-for nm mod-items)))
                (set! dn (stl dn))))))
        (let body (drop-use-forms items Nil))
          (let shadows (collect-def-names body Nil))
            (list-append
              (drop-shadowed emitted shadows Nil)
              body)))))

; ---------- stdlib/compiler/type_system.zyl ----------
; === Zyl Type System — Hindley-Milner Inference ===
; Module: compiler/type_system
; Provides: Type ADT, Subst map, TypeVarGen, TypeEnv, TraitContext, TypeInferer
; Status: Phase 1 rewrite (correct Zyl deftype/match syntax, fixed recursion)

; ===========================================================================
; GENERIC PAIR — used for matching and result types
; ===========================================================================

(deftype Pair (P A B))

; ===========================================================================
; TYPE ADT
; ===========================================================================

(deftype Type
  (TInt)
  (TFloat)
  (TBool)
  (TString)
  (TUnit)
  (TFun (List Type))
  (TList (List Type))
  (TArray Type Int)
  (TCap CapKind Type)
  (TStruct String (List Type))
  (TVar Int Type)
  (TMap Type Type)
  (TResult Type Type))

(deftype CapKind
  (TCCap)
  (TCMut)
  (TCAtomic)
  (TCBox)
  (TCPin))

; ===========================================================================
; SUBST MAP — List of (Int Type) bindings
; ===========================================================================

(deftype Subst (SBindings (List TypeBind)))

(deftype TypeBind (TB Int Type))

; ===========================================================================
; TYPEVAR GENERATOR
; ===========================================================================

(deftype TypeVarGen (TVG Int))

; ===========================================================================
; TYPE ENVIRONMENT — List of (String Type) bindings
; ===========================================================================

(deftype TypeEnv (TEBindings (List EnvBind)))

(deftype EnvBind (EB String Type))

; ===========================================================================
; TRAIT CONTEXT — List of (String (List Type)) bounds
; ===========================================================================

(deftype TraitContext (TCTraitBounds (List TraitBound)))

(deftype TraitBound (TRB String (List Type)))

; ===========================================================================
; TYPE INFERENCE ENGINE
; ===========================================================================

; Full inference-context record owned by the type system (see
; stdlib/compiler/type_inference.zyl for the inference logic that uses it).
(deftype TypeInferer
    (TIEnv TypeEnv)
    (TISubst Subst)
    (TINext Int)
    (TIKnownTypes (List TypeBind))
    (TIKnownFns (List FnSig))
    (TIFuncReturns (List FnReturn))
    (TIAdtDefs (List AdtDef))
    (TIVariantToAdt (List TypeBind))
    (TIStringMatchVars (List String))
    (TIInferringFns (List String))
    (TIBodyCache (List BodyCache)))

; Inference support ADTs (function signatures, return types, ADT defs,
; variant fields, per-site body cache, string-match vars).
(deftype FnSig (FNS Name (List ParamType)))
(deftype ParamType (PT Name Type))
(deftype FnReturn (FR Name Type))
(deftype AdtDef (AD Name (List Variant)))
(deftype Variant (V Name (List Field)))
(deftype Field (F Name Type))
(deftype BodyCache (BC Key Type))
(deftype VarPair (VP Index Int))

; ===========================================================================
; UNIFICATION RESULT
; ===========================================================================

(deftype UnifyResult (UOk Subst)
                     (UErr String))

; ===========================================================================
; TYPE VARIABLE GENERATION
; ===========================================================================

(deftype TypeVar (TV Int))

(defn typevar-gen-new (g)
  (Pair (TypeVar (TVG.n g)) (TypeVarGen (+ (TVG.n g) 1))))

(defn typevar-gen-next (g)
  (TVG.n g))

; ===========================================================================
; SUBSTITUTION OPERATIONS
; ===========================================================================

(defn subst-empty ()
  (Subst Nil))

(defn subst-lookup (s n)
  (subst-lookup-binds (SBindings.binds s) n))

(defn subst-lookup-binds (binds n)
  (match binds
    (Nil None)
    ((TB k v) rest
     (if (= k n)
       (Some v)
       (subst-lookup-binds rest n)))))

(defn subst-insert (s n t)
  (Subst (cons (TB n t) (SBindings.binds s))))

; Apply substitution to a single Type — helper to avoid lambda recursion issue
(defn subst-apply-type (s t)
  (match t
    (TInt TInt)
    (TFloat TFloat)
    (TBool TBool)
    (TString TString)
    (TUnit TUnit)
    (TFun args (subst-apply-type-list s args))
    (TList elem (TList (subst-apply-type s elem)))
    (TArray elem len (TArray (subst-apply-type s elem) len))
    (TCap kind inner (TCap kind (subst-apply-type s inner)))
    (TStruct name fields (subst-apply-type-struct s name fields))
    (TVar m inner
     (match (subst-lookup s m)
       (Some t (subst-apply-type s t))
       (None (TVar m (subst-apply-type s inner)))))
    (TMap k v (TMap (subst-apply-type s k) (subst-apply-type s v)))
    (TResult e h (TResult (subst-apply-type s e) (subst-apply-type s h))) ))

(defn subst-apply-type-list (s types)
  (match types
    (Nil Nil)
    ((Pair h t) (cons (subst-apply-type s h) (subst-apply-type-list s t)))))

(defn subst-apply-type-struct (s name fields)
  (TStruct name (subst-apply-type-list s fields)))

; Main entry — wraps the inner function
(defn subst-apply (s t)
  (subst-apply-type s t))

(defn subst-union (s1 s2)
  (match (SBindings.binds s1)
    (Nil s2)
    ((TB n t) rest
     (let ((t2 (subst-apply s2 t)))
       (let ((new-s (subst-insert (subst-union (Subst rest) s2) n t2)))
         new-s)))))

; ===========================================================================
; FREE TYPE VARIABLE COMPUTATION
; ===========================================================================

(defn type-free-vars (t)
  (match t
    (TInt Nil)
    (TFloat Nil)
    (TBool Nil)
    (TString Nil)
    (TUnit Nil)
    (TFun args (type-free-vars-list args))
    (TList elem (type-free-vars elem))
    (TArray elem _ (type-free-vars elem))
    (TCap _ inner (type-free-vars inner))
    (TStruct _ fields (type-free-vars-list fields))
    (TVar n _ (List n))
    (TMap k v (union (type-free-vars k) (type-free-vars v)))
    (TResult e h (union (type-free-vars e) (type-free-vars h))) ))

(defn type-free-vars-list (types)
  (match types
    (Nil Nil)
    ((Pair h t) (union (type-free-vars h) (type-free-vars-list t)))))

; ===========================================================================
; UNIFICATION
; ===========================================================================

(defn unify (s t1 t2)
  (let ((t1x (subst-apply s t1)))
    (let ((t2x (subst-apply s t2)))
      (unify-terms s t1x t2x))))

(defn unify-terms (s t1 t2)
  (match (Pair t1 t2)
    ((Pair TInt TInt) (UOk s))
    ((Pair TFloat TFloat) (UOk s))
    ((Pair TBool TBool) (UOk s))
    ((Pair TString TString) (UOk s))
    ((Pair TUnit TUnit) (UOk s))
    ((Pair (TFun args1) (TFun args2))
     (if (= (length args1) (length args2))
       (unify-args s args1 args2)
       (UErr "Function arity mismatch")))
    ((Pair (TList e1) (TList e2))
     (unify s e1 e2))
    ((Pair (TArray e1 l1) (TArray e2 l2))
     (if (= l1 l2)
       (unify s e1 e2)
       (UErr "Array length mismatch")))
    ((Pair (TCap k1 a) (TCap k2 b))
     (if (= k1 k2)
       (unify s a b)
       (UErr "Capability kind mismatch")))
    ((Pair (TStruct n1 fs1) (TStruct n2 fs2))
     (if (= n1 n2)
       (if (= (length fs1) (length fs2))
         (unify-args s fs1 fs2)
         (UErr "Struct field count mismatch"))
       (UErr "Struct name mismatch")))
    ((Pair (TMap k1 v1) (TMap k2 v2))
     (unify (unify s k1 k2) v1 v2))
    ((Pair (TResult e1 h1) (TResult e2 h2))
     (unify (unify s e1 e2) h1 h2))
    ((Pair (TVar n _) _)
     (unify-var s n t2))
    ((Pair _ (TVar n _))
     (unify-var s n t1))
    (_ (UErr "Type mismatch"))))

(defn unify-var (s n t)
  (match (subst-lookup s n)
    (Some tx
     (if (= tx t)
       (UOk s)
       (UErr "Variable already bound")))
    (None (UOk (subst-insert s n t)) )))

(defn unify-args (s args1 args2)
  (match (Pair args1 args2)
    (Pair Nil Nil (UOk s))
    (Pair ((Pair h1 t1) (Pair h2 t2))
     (match (unify s h1 h2)
       (UOk sx (unify-args sx t1 t2))
       (UErr e (UErr e))))))


; ---------- stdlib/compiler/type_inference.zyl ----------
; === Zyl Type Inference Engine ===
; Port of Rust type_inference.rs (~2752 loc) to Zyl (~1200 loc)
; Core: infer_expr dispatch, collect_definitions, finalize_param_types
;
; FORMATTING: C-style block discipline — every open paren on its own line
; at the correct indent; every close paren on its own line aligned under
; its matching open. Indentation disambiguates nesting so paren balance is
; trivial to verify visually.

; ===========================================================================
; INFERENCE STATE — simplified from Rust (no RefCell/Cell)
;
; NOTE: The TypeInferer record and its support ADTs (FnSig, ParamType,
; FnReturn, AdtDef, Variant, Field, BodyCache, VarPair) are defined in
; stdlib/compiler/type_system.zyl — the single owner of all type-system
; ADTs. This file contains only the inference LOGIC.
; ===========================================================================

(defn fresh-var (inferer)
    ; return current next-index and bump-by-1
    (let
        (n (TINext inferer))
        (Pair n (+ n 1))))

(defn update-next (inferer n)
    ; reconstruct inferer with new next-index, all else unchanged
    (TypeInferer
        (TIEnv inferer)
        (TISubst inferer)
        n
        (TIKnownTypes inferer)
        (TIKnownFns inferer)
        (TIFuncReturns inferer)
        (TIAdtDefs inferer)
        (TIVariantToAdt inferer)
        (TIStringMatchVars inferer)
        (TIInferringFns inferer)
        (TIBodyCache inferer)))

; ===========================================================================
; KNOWN TYPES HELPERS
; ===========================================================================

(defn lookup-known-type (inferer name)
    (lookup-known-type-binds (TIKnownTypes inferer) name))

(defn lookup-known-type-binds (binds name)
    (match binds
        (Nil None)
        ((TB k v) rest
            (if
                (= k name)
                (Some v)
                (lookup-known-type-binds rest name)))))

(defn insert-known-type (inferer name typ)
    (TypeInferer
        (TIEnv inferer)
        (TISubst inferer)
        (TINext inferer)
        (cons
            (TB name typ)
            (TIKnownTypes inferer))
        (TIKnownFns inferer)
        (TIFuncReturns inferer)
        (TIAdtDefs inferer)
        (TIVariantToAdt inferer)
        (TIStringMatchVars inferer)
        (TIInferringFns inferer)
        (TIBodyCache inferer)))

; ===========================================================================
; KNOWN FUNCTIONS HELPERS
; ===========================================================================

(defn lookup-known-fn (inferer name)
    (lookup-fn-sigs (TIKnownFns inferer) name))

(defn lookup-fn-sigs (sigs name)
    (match sigs
        (Nil Nil)
        ((FNS n params) rest
            (if
                (= n name)
                params
                (lookup-fn-sigs rest name)))))

(defn insert-known-fn (inferer name params)
    (TypeInferer
        (TIEnv inferer)
        (TISubst inferer)
        (TINext inferer)
        (TIKnownTypes inferer)
        (cons
            (FNS name params)
            (TIKnownFns inferer))
        (TIFuncReturns inferer)
        (TIAdtDefs inferer)
        (TIVariantToAdt inferer)
        (TIStringMatchVars inferer)
        (TIInferringFns inferer)
        (TIBodyCache inferer)))

; ===========================================================================
; FUNCTION RETURNS HELPERS
; ===========================================================================

(defn lookup-fn-ret (inferer name)
    (lookup-ret-binds (TIFuncReturns inferer) name))

(defn lookup-ret-binds (binds name)
    (match binds
        (Nil None)
        ((FR k v) rest
            (if
                (= k name)
                (Some v)
                (lookup-ret-binds rest name)))))

(defn insert-fn-ret (inferer name typ)
    (TypeInferer
        (TIEnv inferer)
        (TISubst inferer)
        (TINext inferer)
        (TIKnownTypes inferer)
        (TIKnownFns inferer)
        (cons
            (FR name typ)
            (TIFuncReturns inferer))
        (TIAdtDefs inferer)
        (TIVariantToAdt inferer)
        (TIStringMatchVars inferer)
        (TIInferringFns inferer)
        (TIBodyCache inferer)))

; ===========================================================================
; ADT DEFINITIONS HELPERS
; ===========================================================================

(defn lookup-adt-def (inferer name)
    (lookup-adt-binds (TIAdtDefs inferer) name))

(defn lookup-adt-binds (binds name)
    (match binds
        (Nil Nil)
        ((AD n variants) rest
            (if
                (= n name)
                variants
                (lookup-adt-binds rest name)))))

(defn insert-adt-def (inferer name variants)
    (TypeInferer
        (TIEnv inferer)
        (TISubst inferer)
        (TINext inferer)
        (TIKnownTypes inferer)
        (TIKnownFns inferer)
        (TIFuncReturns inferer)
        (cons
            (AD name variants)
            (TIAdtDefs inferer))
        (TIVariantToAdt inferer)
        (TIStringMatchVars inferer)
        (TIInferringFns inferer)
        (TIBodyCache inferer)))

; ===========================================================================
; VARIANT -> ADT HELPERS
; ===========================================================================

(defn lookup-variant-to-adt (inferer variant)
    (lookup-vta-binds (TIVariantToAdt inferer) variant))

(defn lookup-vta-binds (binds variant)
    (match binds
        (Nil None)
        ((TB k v) rest
            (if
                (= k variant)
                (Some v)
                (lookup-vta-binds rest variant)))))

(defn insert-variant-to-adt (inferer variant adt)
    (TypeInferer
        (TIEnv inferer)
        (TISubst inferer)
        (TINext inferer)
        (TIKnownTypes inferer)
        (TIKnownFns inferer)
        (TIFuncReturns inferer)
        (TIAdtDefs inferer)
        (cons
            (TB variant adt)
            (TIVariantToAdt inferer))
        (TIStringMatchVars inferer)
        (TIInferringFns inferer)
        (TIBodyCache inferer)))

; ===========================================================================
; BODY CACHE HELPERS
; ===========================================================================

(defn lookup-body-cache (inferer key)
    ; walk body-cache list, threading rest through a rebuilt inferer
    (match
        (TIBodyCache inferer)
        (Nil None)
        ((BC k v) rest
            (if
                (= k key)
                (Some v)
                (lookup-body-cache
                    (TypeInferer
                        (TIEnv inferer)
                        (TISubst inferer)
                        (TINext inferer)
                        (TIKnownTypes inferer)
                        (TIKnownFns inferer)
                        (TIFuncReturns inferer)
                        (TIAdtDefs inferer)
                        (TIVariantToAdt inferer)
                        (TIStringMatchVars inferer)
                        (TIInferringFns inferer)
                        rest)
                    key)))))

(defn insert-body-cache (inferer key typ)
    (TypeInferer
        (TIEnv inferer)
        (TISubst inferer)
        (TINext inferer)
        (TIKnownTypes inferer)
        (TIKnownFns inferer)
        (TIFuncReturns inferer)
        (TIAdtDefs inferer)
        (TIVariantToAdt inferer)
        (TIStringMatchVars inferer)
        (TIInferringFns inferer)
        (cons
            (BC key typ)
            (TIBodyCache inferer))))

; ===========================================================================
; INFERRING FUNCTIONS HELPERS
; ===========================================================================

(defn is-inferring (inferer name)
    (mem-string-list (TIInferringFns inferer) name))

(defn mark-inferring (inferer name)
    (TypeInferer
        (TIEnv inferer)
        (TISubst inferer)
        (TINext inferer)
        (TIKnownTypes inferer)
        (TIKnownFns inferer)
        (TIFuncReturns inferer)
        (TIAdtDefs inferer)
        (TIVariantToAdt inferer)
        (TIStringMatchVars inferer)
        (cons
            name
            (TIInferringFns inferer))
        (TIBodyCache inferer)))

; ===========================================================================
; STRING MATCH VARS HELPERS
; ===========================================================================

(defn insert-string-match-var (inferer name)
    (TypeInferer
        (TIEnv inferer)
        (TISubst inferer)
        (TINext inferer)
        (TIKnownTypes inferer)
        (TIKnownFns inferer)
        (TIFuncReturns inferer)
        (TIAdtDefs inferer)
        (TIVariantToAdt inferer)
        (cons
            name
            (TIStringMatchVars inferer))
        (TIInferringFns inferer)
        (TIBodyCache inferer)))

; ===========================================================================
; UTILITY HELPERS
; ===========================================================================

(defn mem-string-list (lst name)
    (match lst
        (Nil false)
        ((Pair h t)
            (if
                (= h name)
                true
                (mem-string-list t name)))))

(defn is-generic-param (s)
    ; single uppercase letter marks a generic type param
    (if
        (= (length s) 1)
        (let
            (c (substring s 0 1))
            (if
                (and
                    (>= (ord c) 65)
                    (<= (ord c) 90))
                true
                false))
        false))

(defn type-from-display (s)
    ; map display string to concrete type
    (match s
        ("Int" TInt)
        ("Float" TFloat)
        ("Bool" TBool)
        ("String" TString)
        ("Unit" TUnit)
        (_ (TStruct s Nil))))

(defn is-skip-placeholder (expr)
    ; detect the ____skip_ atom that marks an empty branch
    (match expr
        (Atom
            (Keyword kw)
            (if
                (= kw "___skip_")
                true
                false))
        (_ false)))

; ===========================================================================
; INFERER CONSTRUCTOR
; ===========================================================================

(defn inferer-new ()
    (let
        (known
            (cons
                (TB "Int" TInt)
                (cons
                    (TB "Float" TFloat)
                    (cons
                        (TB "Bool" TBool)
                        (cons
                            (TB "String" TString)
                            (cons
                                (TB "Unit" TUnit)
                                Nil))))))
        (TypeInferer
            (TypeEnv Nil)
            (subst-empty)
            0
            known
            Nil
            Nil
            Nil
            Nil
            Nil
            Nil
            Nil)))

; ===========================================================================
; INFER-EXPR — core dispatch
; ===========================================================================

(defn infer-expr (inferer expr)
    (match expr.inner
        (Atom
            (Int _ _)
            (inferer-return-int inferer))
        (Atom
            (Float _ _)
            (inferer-return-float inferer))
        (Atom
            (Bool _ _)
            (inferer-return-bool inferer))
        (Atom
            (Str _ _)
            (inferer-return-string inferer))
        (Atom
            (Keyword "___skip_")
            (inferer-return-unit inferer))
        (Atom
            (Ident name)
            (if
                (is-primitive-ident name)
                (inferer-return-prim inferer name)
                (infer-expr-ident inferer expr name)))
        (Def
            _ val
            (infer-expr-let inferer expr.val expr))
        (Let
            name val body
            (infer-expr-let inferer expr name val body))
        (If
            cond then- else-
            (infer-expr-if inferer expr cond then- else-))
        (Call
            op args
            (infer-expr-call inferer expr op args))
        (Apply
            name args
            (infer-expr-apply inferer expr name args))
        (Begin
            stmts
            (infer-expr-begin inferer expr stmts))
        (Lambda
            _ params body
            (infer-expr-lambda inferer expr params body))
        (While
            cond body
            (infer-expr-while inferer expr cond body))
        (For
            bindings cond body
            (infer-expr-for inferer expr bindings cond body))
        (Cond
            clauses
            (infer-expr-cond inferer expr clauses))
        (TryCatch
            eh cn handler
            (infer-expr-try-catch inferer expr eh cn handler))
        (Match
            subject arms
            (infer-expr-match inferer expr subject arms))
        (Defn
            _name _params body
            (inferer-return-unit inferer))
        (Deftype
            _name _variants _bound _derives
            (inferer-return-unit inferer))
        (TraitDecl
            _name _methods _derives
            (inferer-return-unit inferer))
        (ImplBlock
            _trait _type _bodies
            (inferer-return-unit inferer))
        (StructDef
            _sd _extra
            (inferer-return-unit inferer))
        (StructDefPlus
            _sd _extra
            (inferer-return-unit inferer))
        (AliasDecl
            _name _target
            (inferer-return-unit inferer))
        (Derive
            _type _traits
            (inferer-return-unit inferer))
        (FfiCall
            _sym _args _timeout
            (infer-expr-ffi-call inferer expr))
        (FfiPin
            e
            (infer-expr-ffi-pin inferer expr e))
        (Assert
            cond _msg
            (infer-expr-assert inferer expr cond))
        (SetBang
            target val
            (infer-expr-set-bang inferer expr target val))
        (MakeStruct
            name fields
            (infer-expr-make-struct inferer expr name fields))
        (StructGet
            se field_name
            (infer-expr-struct-get inferer expr se field_name))
        (MakeVariant
            adt_name variant_name args
            (infer-expr-make-variant inferer expr adt_name variant_name args))
        (Print
            exprs
            (infer-expr-print inferer expr exprs))
        (ReadLine
            (inferer-return-string inferer))
        (Exit
            code
            (infer-expr-exit inferer expr code))
        (Close
            resource
            (inferer-return-unit inferer))
        (FileOpen
            path mode
            (inferer-return-int inferer))
        (FileRead
            handle count
            (inferer-return-string inferer))
        (FileWrite
            handle data
            (inferer-return-int inferer))
        (FileClose
            handle
            (inferer-return-unit inferer))
        (BufAppend
            dst src
            (inferer-return-int inferer))
        (Spawn
            closure
            (infer-expr-spawn inferer expr closure))
        (Send
            _actor msg
            (infer-expr-send inferer expr msg))
        (SendClosure
            _actor closure _caps
            (inferer-return-unit inferer))
        (WithResource
            _name init body
            (infer-expr-with-resource inferer expr init body))
        (TestDecl
            _name _body _kind
            (inferer-return-unit inferer))
        (TestSuite
            _name _tests _kind
            (inferer-return-unit inferer))
        (RunTests
            _name
            (inferer-return-unit inferer))
        (TestCompile
            _expr _kind
            (inferer-return-unit inferer))
        (AssertEqual
            _l _r
            (inferer-return-unit inferer))
        (AssertTrue
            _e _msg
            (inferer-return-unit inferer))
        (AssertFalse
            _e _msg
            (inferer-return-unit inferer))
        (AssertFail
            _e _msg
            (inferer-return-unit inferer))
        (TestProperty
            _name _desc _body
            (inferer-return-unit inferer))
        (ModuleDecl
            _name
            (inferer-return-unit inferer))
        (UseModule
            _name _path _alias
            (inferer-return-unit inferer))
        (Export
            _name
            (inferer-return-unit inferer))
        (MacroDef
            _name _params _body
            (inferer-return-unit inferer))
        (Setup
            _exprs
            (inferer-return-unit inferer))
        (Teardown
            _exprs
            (inferer-return-unit inferer))
        (Error
            _msg
            (inferer-return-unit inferer))
        (_
            (inferer-return-var inferer))))

; ===========================================================================
; INFER-EXPR — primitive return helpers
; ===========================================================================

(defn inferer-return-int (inferer) TInt)
(defn inferer-return-float (inferer) TFloat)
(defn inferer-return-bool (inferer) TBool)
(defn inferer-return-string (inferer) TString)
(defn inferer-return-unit (inferer) TUnit)

(defn inferer-return-var (inferer)
    ; fresh TVar with default inner ref type Unit
    (let
        (pair (fresh-var inferer))
        (TVar
            (fst pair)
            TUnit)))

(defn is-primitive-ident (name)
    ; primitive type names stand alone in expression position
    (match name
        ("Int" true)
        ("Float" true)
        ("Bool" true)
        ("String" true)
        ("Unit" true)
        (_ false)))

(defn inferer-return-prim (inferer name)
    (match name
        ("Int" TInt)
        ("Float" TFloat)
        ("Bool" TBool)
        ("String" TString)
        ("Unit" TUnit)
        (_ (inferer-return-var inferer))))

; ===========================================================================
; INFER-EXPR — identifier lookup
; ===========================================================================

(defn infer-expr-ident (inferer expr name)
    ; look up name in env; apply subst if found
    (let
        (env (TIEnv inferer))
        (match
            (env-get env name)
            (Some typ (inferer-return-applied inferer typ))
            (None (infer-expr-ident-fallback inferer expr name)))))

(defn infer-expr-ident-fallback (inferer expr name)
    ; unresolved identifier: primitive names are concrete, else fresh var
    (match name
        ("Unit" TUnit)
        ("Int" TInt)
        ("Float" TFloat)
        ("Bool" TBool)
        ("String" TString)
        (_ (inferer-return-var inferer))))

(defn inferer-return-applied (inferer typ)
    (subst-apply (TISubst inferer) typ))

; ===========================================================================
; INFER-EXPR — let
; ===========================================================================

(defn infer-expr-let (inferer expr name val body)
    ; infer value type, bind name, infer body in extended env
    (let
        (vt (infer-expr inferer val))
        (let
            (new-env (env-bind (TIEnv inferer) name vt))
            (infer-expr
                (TypeInferer
                    new-env
                    (TISubst inferer)
                    (TINext inferer)
                    (TIKnownTypes inferer)
                    (TIKnownFns inferer)
                    (TIFuncReturns inferer)
                    (TIAdtDefs inferer)
                    (TIVariantToAdt inferer)
                    (TIStringMatchVars inferer)
                    (TIInferringFns inferer)
                    (TIBodyCache inferer))
                body))))

; ===========================================================================
; INFER-EXPR — if
; ===========================================================================

(defn infer-expr-if (inferer expr cond then- else-)
    ; unify cond with Bool; result type is then/else (skip-aware)
    (let
        (ct (infer-expr inferer cond))
        (let
            (unified (unify (TISubst inferer) ct TBool))
            (match unified
                (UOk
                    new-s
                    (let
                        (tt (infer-expr inferer then-))
                        (let
                            (et (infer-expr inferer else-))
                            (if
                                (is-skip-placeholder else-)
                                tt
                                (match
                                    (unify
                                        (subst-apply new-s tt)
                                        et)
                                    (UOk _ tt)
                                    (UErr _ tt))))))
                (UErr
                    _
                    (inferer-return-var inferer))))))

; ===========================================================================
; INFER-EXPR — begin
; ===========================================================================

(defn infer-expr-begin (inferer expr stmts)
    ; sequence: value is last stmt; empty -> Unit; single -> that stmt
    (if
        (nil? stmts)
        TUnit
        (if
            (= (length stmts) 1)
            (infer-expr inferer (fst stmts))
            (let
                (_ (infer-expr-stmt-chain inferer stmts))
                (infer-expr inferer (last stmts))))))

(defn infer-expr-stmt-chain (inferer stmts)
    ; infer all but last; result discarded
    (match stmts
        (Nil
            nil)
        ((Pair h t)
            (infer-expr inferer h)
            (infer-expr-stmt-chain inferer t))))

; ===========================================================================
; INFER-EXPR — lambda/fn
; ===========================================================================

(defn infer-expr-lambda (inferer expr params body)
    ; lambda: bind params to fresh vars, infer body, result TFun
    (let
        (new-inferer (inferer-bind-params inferer params))
        (let
            (rt (infer-expr new-inferer body))
            (TFun
                (inferer-params-types params)
                rt))))

(defn inferer-bind-params (inferer params)
    ; bind each param name to a fresh type var
    (match params
        (Nil
            inferer)
        ((Pair p rest)
            (let
                (env
                    (env-bind
                        (TIEnv inferer)
                        (param-name p)
                        (inferer-return-var inferer)))
                (inferer-bind-params
                    (TypeInferer
                        env
                        (TISubst inferer)
                        (TINext inferer)
                        (TIKnownTypes inferer)
                        (TIKnownFns inferer)
                        (TIFuncReturns inferer)
                        (TIAdtDefs inferer)
                        (TIVariantToAdt inferer)
                        (TIStringMatchVars inferer)
                        (TIInferringFns inferer)
                        (TIBodyCache inferer))
                    rest)))))

(defn inferer-params-types (params)
    ; one TVar per param (placeholder; refined later)
    (match params
        (Nil
            Nil)
        ((Pair p rest)
            (cons
                TVar
                (inferer-params-types rest)))))

(defn param-name (p)
    (match p
        (Param
            n t
            n)
        (_ "___")))

; ===========================================================================
; INFER-EXPR — while
; ===========================================================================

(defn infer-expr-while (inferer expr cond body)
    ; unify cond with Bool, infer body, result Unit
    (let
        (ct (infer-expr inferer cond))
        (unify (TISubst inferer) ct TBool)
        (infer-expr inferer body)
        TUnit))

; ===========================================================================
; INFER-EXPR — for
; ===========================================================================

(defn infer-expr-for (inferer expr bindings cond body)
    ; bind loop vars, unify cond with Bool, infer body, result Unit
    (let
        (new-inferer (inferer-bind-for-vars inferer bindings))
        (let
            (ct (infer-expr new-inferer cond))
            (unify (TISubst new-inferer) ct TBool)
            (infer-expr new-inferer body)
            TUnit)))

(defn inferer-bind-for-vars (inferer bindings)
    ; bind each (name val) pair to TCap TMut of val's type
    (match bindings
        (Nil
            inferer)
        ((Pair
            (Pair name val)
            rest)
            (let
                (vt (infer-expr inferer val))
                (let
                    (new-env
                        (env-bind
                            (TIEnv inferer)
                            name
                            (TCap TCMut vt)))
                    (inferer-bind-for-vars
                        (TypeInferer
                            new-env
                            (TISubst inferer)
                            (TINext inferer)
                            (TIKnownTypes inferer)
                            (TIKnownFns inferer)
                            (TIFuncReturns inferer)
                            (TIAdtDefs inferer)
                            (TIVariantToAdt inferer)
                            (TIStringMatchVars inferer)
                            (TIInferringFns inferer)
                            (TIBodyCache inferer))
                        rest))))))

; ===========================================================================
; INFER-EXPR — cond
; ===========================================================================

(defn infer-expr-cond (inferer expr clauses)
    ; infer each clause, unify pred with Bool; result is last body type
    (infer-expr-cond-loop inferer clauses TUnit))

(defn infer-expr-cond-loop (inferer clauses rt)
    (match clauses
        (Nil
            rt)
        ((Pair
            (Pair pred body)
            rest)
            (let
                (pt (infer-expr inferer pred))
                (unify (TISubst inferer) pt TBool)
                (let
                    (bt (infer-expr inferer body))
                    (infer-expr-cond-loop inferer rest bt))))))

; ===========================================================================
; INFER-EXPR — try/catch
; ===========================================================================

(defn infer-expr-try-catch (inferer expr eh cn handler)
    ; result is the try-body type
    (let
        (et (infer-expr inferer eh))
        (infer-expr inferer handler)
        et))

; ===========================================================================
; INFER-EXPR — match
; ===========================================================================

(defn infer-expr-match (inferer expr subject arms)
    ; unify all arm body types under a shared subject type
    (let
        (subject-type (infer-expr inferer subject))
        (infer-expr-match-arms inferer arms subject-type TUnit)))

(defn infer-expr-match-arms (inferer arms subject-type first-type)
    (match arms
        (Nil
            first-type)
        ((Pair arm rest)
            (let
                (arm-env (env-snapshot (TIEnv inferer)))
                (let
                    (field-types (infer-lookup-arm-field-types inferer arm subject-type))
                    (let
                        (new-inferer (inferer-bind-pattern-vars inferer arm field-types))
                        (let
                            (abt (infer-expr new-inferer arm.body))
                            (let
                                (new-type
                                    (if
                                        (nil? first-type)
                                        abt
                                        (match
                                            (unify
                                                (subst-apply (TISubst inferer) first-type)
                                                abt)
                                            (UOk _ first-type)
                                            (UErr _ abt))))
                                (let
                                    (rest-type
                                        (infer-expr-match-arms
                                            (TypeInferer
                                                arm-env
                                                (TISubst new-inferer)
                                                (TINext new-inferer)
                                                (TIKnownTypes new-inferer)
                                                (TIKnownFns new-inferer)
                                                (TIFuncReturns new-inferer)
                                                (TIAdtDefs new-inferer)
                                                (TIVariantToAdt new-inferer)
                                                (TIStringMatchVars new-inferer)
                                                (TIInferringFns new-inferer)
                                                (TIBodyCache new-inferer))
                                            rest
                                            subject-type
                                            new-type))
                                    rest-type)))))))))

(defn infer-lookup-arm-field-types (inferer arm subject-type)
    ; resolve field types for the variant a pattern names, mirroring Rust's
    ; adt_field_types(scrutinee_adt, arm.variant) with the scrutinee ADT
    ; resolved from the subject's nominal type through substitutions.
    (match arm.pattern
        (Atom
            (Ident name)
            (let
                (adt-name (infer-lookup-scrutinee-adt inferer subject-type))
                (infer-lookup-variant-fields inferer adt-name arm.variant)))))

(defn infer-lookup-scrutinee-adt (inferer subject-type)
    ; nominal type name of the scrutinee, mono-suffix stripped
    (match
        (resolve-nominal (TISubst inferer) subject-type)
        (Some
            n
            (if
                (infer-adt-exists (TIAdtDefs inferer) n)
                n
                (infer-strip-mono-suffix n)))
        (None
            nil)))

(defn resolve-nominal (subst t)
    ; mirror Rust resolve_nominal: apply the substitution then, if the
    ; resolved type is nominal (TStruct), return its name; else None.
    (match
        (subst-apply subst t)
        (TStruct n _ (Some n))
        (_ None)))

(defn infer-strip-mono-suffix (name)
    ; strip monomorphization "_instantiation" suffix
    (if
        (contains name "_")
        (substring name 0 (index-of name "_"))
        name))

(defn infer-lookup-variant-fields (inferer adt-name variant-name)
    ; walk the inferer's ADT defs; return the named variant's fields or Nil
    (match
        (lookup-adt-def inferer adt-name)
        (Nil
            Nil)
        (variants
            (infer-find-variant-fields variants variant-name))))

(defn infer-find-variant-fields (variants variant-name)
    ; walk a (List Variant); return the named variant's fields or Nil
    (match variants
        (Nil
            Nil)
        ((V n fields) rest
            (if
                (= n variant-name)
                fields
                (infer-find-variant-fields rest variant-name)))))

(defn inferer-bind-pattern-vars (inferer arm field-types)
    ; bind pattern vars to their field types; recurse over remaining fields
    (match
        (Pair arm.pattern field-types)
        (Pair
            (Atom (Ident name) _)
            (Pair ft rest)
            (let
                (pt (infer-lookup-pattern-type inferer ft))
                (let
                    (new-inferer
                        (TypeInferer
                            (env-bind (TIEnv inferer) name pt)
                            (TISubst inferer)
                            (TINext inferer)
                            (TIKnownTypes inferer)
                            (TIKnownFns inferer)
                            (TIFuncReturns inferer)
                            (TIAdtDefs inferer)
                            (TIVariantToAdt inferer)
                            (if
                                (string-type-pt pt)
                                (cons name (TIStringMatchVars inferer))
                                (TIStringMatchVars inferer))
                            (TIInferringFns inferer)
                            (TIBodyCache inferer)))
                    (if
                        (nil? rest)
                        new-inferer
                        (let
                            (rest-pattern
                                (match arm.pattern
                                    (Atom _ _ Nil)
                                    (_ (cdr arm.pattern))))
                            (inferer-bind-pattern-vars
                                new-inferer
                                (Pair rest-pattern rest)))))))
        (_
            inferer)))

(defn infer-lookup-pattern-type (inferer field-type)
    (match field-type
        ("Int" TInt)
        ("Float" TFloat)
        ("Bool" TBool)
        ("String" TString)
        ("Unit" TUnit)
        (_ (inferer-return-var inferer))))

(defn string-type-pt (pt)
    (= pt TString))

(defn infer-adt-exists (adt-defs name)
    ; does an ADT def with this name exist?
    (match adt-defs
        (Nil false)
        ((AD n rest) (if (= n name) true (infer-adt-exists rest name)))
        (_ false)))

; ===========================================================================
; INFER-EXPR — call (raw Call form)
; ===========================================================================

(defn infer-expr-call (inferer expr op args)
    ; dispatch builtin operator vs user function call
    (match op.inner
        (Atom
            (Ident op-name)
            (if
                (is-builtin-binop op-name)
                (infer-expr-builtin-binop inferer expr op-name args)
                (if
                    (is-builtin-unop op-name)
                    (infer-expr-builtin-unop inferer expr op-name args)
                    (if
                        (is-builtin-conv op-name)
                        (infer-expr-builtin-conv inferer expr op-name args)
                        (if
                            (is-builtin-compare op-name)
                            (infer-expr-builtin-compare inferer expr op-name args)
                            (if
                                (is-builtin-io op-name)
                                (infer-expr-builtin-io inferer expr op-name args)
                                (infer-expr-call-fn inferer expr op-name args)))))))
        (_
            (infer-expr-call-fn inferer expr "___unknown" args))))

(defn is-builtin-binop (name)
    (match name
        ("+" true)
        ("-" true)
        ("*" true)
        ("/" true)
        (_ false)))

(defn is-builtin-unop (name)
    (match name
        ("not" true)
        ("and" true)
        ("or" true)
        (_ false)))

(defn is-builtin-compare (name)
    (match name
        ("==" true)
        ("!=" true)
        ("<" true)
        (">" true)
        ("<=" true)
        (">=" true)
        (_ false)))

(defn is-builtin-conv (name)
    (match name
        ("str" true)
        ("int" true)
        ("float" true)
        (_ false)))

(defn is-builtin-io (name)
    (match name
        ("print" true)
        ("read-line" true)
        ("exit" true)
        ("close" true)
        ("file-open" true)
        ("file-read" true)
        ("file-write" true)
        ("file-close" true)
        ("is-some" true)
        ("is-none" true)
        ("is-ok" true)
        ("is-err" true)
        (_ false)))

(defn infer-expr-builtin-binop (inferer expr op-name args)
    ; infer arg types; result Float if any Float else Int (or var)
    (let
        (has-float false)
        (let
            (all-vars true)
            (let
                (types (infer-args inferer args))
                (infer-binop-check-types types)
                (if
                    has-float
                    TFloat
                    (if
                        all-vars
                        (inferer-return-var inferer)
                        TInt))))))

(defn infer-binop-check-types (types)
    ; walk arg types, tracking float/var flags (via side effects, simplified)
    (match types
        (Nil
            nil)
        ((Pair t rest)
            (infer-binop-check-one t)
            (infer-binop-check-types rest))))

(defn infer-binop-check-one (t)
    (match t
        (TInt nil)
        (TFloat (let (_ false) nil))
        (TVar _ _ nil)
        (_ nil)))

(defn infer-expr-builtin-unop (inferer expr op-name args)
    ; unary ops: args must unify with Bool, result Bool
    (infer-args-bool-check inferer args)
    TBool)

(defn infer-args-bool-check (inferer args)
    (match args
        (Nil
            nil)
        ((Pair a rest)
            (let
                (t (infer-expr inferer a))
                (unify (TISubst inferer) t TBool)
                (infer-args-bool-check inferer rest)))))

(defn infer-expr-builtin-compare (inferer expr op-name args)
    (infer-args inferer args)
    TBool)

(defn infer-expr-builtin-conv (inferer expr op-name args)
    (infer-args inferer args)
    (match op-name
        ("int" TInt)
        ("float" TFloat)
        ("str" TString)))

(defn infer-expr-builtin-io (inferer expr op-name args)
    (infer-args inferer args)
    (match op-name
        ("print" TInt)
        ("read-line" TString)
        ("exit" TUnit)
        ("close" TUnit)
        ("file-open" TInt)
        ("file-read" TString)
        ("file-write" TInt)
        ("file-close" TUnit)
        ("is-some" TBool)
        ("is-none" TBool)
        ("is-ok" TBool)
        ("is-err" TBool)
        (_ TUnit)))

(defn infer-expr-call-fn (inferer expr op-name args)
    ; register fn return placeholder, infer args, return its type
    (match
        (lookup-fn-ret
            (TypeInferer
                (TIEnv inferer)
                (TISubst inferer)
                (TINext inferer)
                (TIKnownTypes inferer)
                (TIKnownFns inferer)
                (cons
                    (FR
                        op-name
                        (inferer-return-var inferer))
                    (TIFuncReturns inferer))
                (TIAdtDefs inferer)
                (TIVariantToAdt inferer)
                (TIStringMatchVars inferer)
                (TIInferringFns inferer)
                (TIBodyCache inferer))
            op-name)
        (Some
            ret
            (infer-args inferer args)
            ret)
        (None
            (infer-args inferer args)
            (inferer-return-var inferer))))

; ===========================================================================
; INFER-EXPR — apply (Apply form)
; ===========================================================================

(defn infer-expr-apply (inferer expr name args)
    ; Apply form lowers to a Call on an Ident
    (infer-expr-call
        inferer
        expr
        (Atom (Ident name))
        args))

; ===========================================================================
; INFER-EXPR — ffi
; ===========================================================================

(defn infer-expr-ffi-call (inferer expr)
    (TCap
        TCBox
        (inferer-return-var inferer)))

(defn infer-expr-ffi-pin (inferer expr e)
    (let
        (t (infer-expr inferer e))
        (TCap
            TCPin
            t)))

; ===========================================================================
; INFER-EXPR — assert
; ===========================================================================

(defn infer-expr-assert (inferer expr cond)
    ; unify cond with Bool, result Unit
    (let
        (ct (infer-expr inferer cond))
        (unify (TISubst inferer) ct TBool)
        TUnit))

; ===========================================================================
; INFER-EXPR — set!
; ===========================================================================

(defn infer-expr-set-bang (inferer expr target val)
    ; target must be a TMut binding; result Unit
    (let
        (vt (infer-expr inferer val))
        (match
            (env-get (TIEnv inferer) target)
            (Some (TCap TCMut _) TUnit)
            (None (inferer-return-var inferer))
            (_ (inferer-return-var inferer)))))

; ===========================================================================
; INFER-EXPR — make-struct
; ===========================================================================

(defn infer-expr-make-struct (inferer expr name fields)
    (infer-args inferer fields)
    (TStruct name Nil))

; ===========================================================================
; INFER-EXPR — struct-get
; ===========================================================================

(defn infer-expr-struct-get (inferer expr se field-name)
    (let
        (st (infer-expr inferer se))
        (infer-struct-field-type st field-name)
        (inferer-return-var inferer)))

(defn infer-struct-field-type (struct-type field-name)
    (match struct-type
        (TStruct n _ nil)
        (_ nil)))

; ===========================================================================
; INFER-EXPR — make-variant
; ===========================================================================

(defn infer-expr-make-variant (inferer expr adt-name variant-name args)
    (let
        (field-types (infer-get-variant-fields inferer adt-name variant-name))
        (infer-args inferer args)
        (infer-variant-record-instantiation inferer adt-name field-types)
        (TStruct
            (format "{}_{}" adt-name variant-name)
            field-types)))

(defn infer-get-variant-fields (inferer adt-name variant-name)
    ; variant fields of the named variant from the real ADT defs, or Nil
    (infer-lookup-variant-fields inferer adt-name variant-name))

(defn infer-variant-record-instantiation (inferer adt-name field-types)
    ; register the variant's fields into the ADT def table
    (TypeInferer
        (TIEnv inferer)
        (TISubst inferer)
        (TINext inferer)
        (TIKnownTypes inferer)
        (TIKnownFns inferer)
        (TIFuncReturns inferer)
        (insert-adt-def
            (TypeInferer
                (TIEnv inferer)
                (TISubst inferer)
                (TINext inferer)
                (TIKnownTypes inferer)
                (TIKnownFns inferer)
                (TIFuncReturns inferer)
                (TIAdtDefs inferer)
                (TIVariantToAdt inferer)
                (TIStringMatchVars inferer)
                (TIInferringFns inferer)
                (TIBodyCache inferer))
            adt-name
            (cons
                (V variant-name field-types)
                (lookup-adt-def
                    (TypeInferer
                        (TIEnv inferer)
                        (TISubst inferer)
                        (TINext inferer)
                        (TIKnownTypes inferer)
                        (TIKnownFns inferer)
                        (TIFuncReturns inferer)
                        (TIAdtDefs inferer)
                        (TIVariantToAdt inferer)
                        (TIStringMatchVars inferer)
                        (TIInferringFns inferer)
                        (TIBodyCache inferer))
                    adt-name)))
        (TIVariantToAdt inferer)
        (TIStringMatchVars inferer)
        (TIInferringFns inferer)
        (TIBodyCache inferer)))

; ===========================================================================
; INFER-EXPR — print
; ===========================================================================

(defn infer-expr-print (inferer expr exprs)
    (infer-args inferer exprs)
    TInt)

; ===========================================================================
; INFER-EXPR — exit
; ===========================================================================

(defn infer-expr-exit (inferer expr code)
    (infer-expr inferer code)
    TUnit)

; ===========================================================================
; INFER-EXPR — spawn
; ===========================================================================

(defn infer-expr-spawn (inferer expr closure)
    (infer-expr inferer closure)
    TInt)

; ===========================================================================
; INFER-EXPR — send
; ===========================================================================

(defn infer-expr-send (inferer expr msg)
    (infer-expr inferer msg)
    TInt)

; ===========================================================================
; INFER-EXPR — with-resource
; ===========================================================================

(defn infer-expr-with-resource (inferer expr init body)
    (let
        (it (infer-expr inferer init))
        (infer-expr inferer body)
        it))

; ===========================================================================
; INFER-ARGS — helper
; ===========================================================================

(defn infer-args (inferer args)
    ; infer type of each arg in order
    (match args
        (Nil
            nil)
        ((Pair a rest)
            (infer-expr inferer a)
            (infer-args inferer rest))))

; ===========================================================================
; COLLECT DEFINITIONS — the declared "Core" that was missing
; Port of Rust collect_definitions() — registers Defn/Deftype/StructDef
; forms in the inferer's known_functions, function_returns, adt_defs, etc.
; ===========================================================================

(defn collect-definitions (inferer exprs)
    (match exprs
        (Nil inferer)
        ((Pair expr rest)
            (let (collected
                   (match
                       expr.inner
                       (Defn name params body
                           (let (param-types (collect-defn-params inferer params))
                               (let (infered (infer-defn-body inferer name params param-types body))
                                   (collect-definitions infered rest)))
                       (Call op args
                           (if (is-defn-call op)
                               (let (parsed (parse-defn-call op args))
                                   (if (Some result parsed)
                                       (collect-defn-form inferer result)
                                       (collect-definitions inferer rest)))
                               (collect-definitions inferer rest)))
                       (Apply fname args
                           (if (= fname "defn")
                               (let (name (match (car args)
                                          (Atom (Ident n) n)
                                          (_ fname)))
                                     (collect-defn-form inferer
                                         (Pair (Pair name (cdr args)) nil)))
                               (collect-definitions inferer rest)))
                       (Deftype name variants generic-params _
                           (collect-definitions inferer rest))
                       (StructDef sd
                           (collect-definitions inferer rest))
                       (StructDefPlus sd
                           (collect-definitions inferer rest))
                       (_ (collect-definitions inferer rest)))))
                collected))))

(defn is-defn-call (op)
    (match op
        (Atom (Ident n) (= n "defn"))
        (_ false)))

(defn parse-defn-call (op args)
    ; parse (defn name params body ...) from Call form
    (match args
        (Nil None)
        ((Pair name rest)
            (match (Pair name rest)
                ((Pair n args)
                    (Some (Pair n args))))
            None)))

(defn collect-defn-params (inferer params)
    ; extract param types from Defn params list
    (match params
        (Nil Nil)
        ((Pair p rest)
            (cons
                (match
                    p
                    (Pair name typ (Pair (match name (Atom (Ident n) n) (_ "param"))
                                        (match typ
                                            (Atom (Ident t) (type-from-display t))
                                            (_ (TVar 0 (TVar 0 TInt)))))
                    (Pair "param" (TVar 0 (TVar 0 TInt)))))
                (collect-defn-params inferer rest)))))

(defn infer-defn-body (inferer name params param-types body)
    ; infer body type and update inferer with function signature
    (let (param-bindings (zip-params params param-types))
        (let (inferred-type (infer-expr-body inferer body))
            (let (new-inferer (insert-fn-ret inferer name inferred-type))
                (let (new-inferer (insert-known-fn new-inferer name param-bindings))
                    new-inferer)))))

(defn infer-expr-body (inferer body)
    ; infer the body expression type, return TUnit on error
    (match
        (catch-error
            (infer-expr inferer body))
        (Ok t t)
        (Err _ (inferer-return-unit inferer))))

(defn catch-error (f)
    (try
        (f)
        (Err (lambda (e) e))))

(defn zip-params (params types)
    ; pair params with types
    (match (Pair params types)
        (Pair Nil Nil Nil)
        (Pair ((Pair p rest-p) (Pair t rest-t))
            (cons (Pair p t) (zip-params rest-p rest-t)))
        (Pair _ _ Nil)))

(defn collect-defn-form (inferer parsed)
    ; process a collected defn form
    (match
        parsed
        (Pair (Pair name args) body-args
            (let (param-list (car args))
                (let (body (car body-args))
                    (let (param-types (infer-expr inferer param-list))
                        (let (inferred (infer-expr inferer body))
                            (let (new-inferer (insert-fn-ret inferer name (infer-expr inferer body)))
                                (insert-known-fn new-inferer name (cons (Pair name (infer-expr inferer param-list))
                                    Nil))))))))))

(defn collect-adt-defs (inferer exprs)
    ; collect ADT definitions from exprs
    (match exprs
        (Nil inferer)
        ((Pair expr rest)
            (let (updated (match
                               expr.inner
                               (Deftype name variants generic-params _
                                   (insert-adt-def inferer name variants))
                               (_ inferer)))
                (collect-adt-defs updated rest)))))

; ===========================================================================
; FINALIZE PARAM TYPES — resolves type vars when call-site evidence agrees
; ===========================================================================

(defn finalize-param-types (inferer)
    ; For each function in known_functions, look up its return type
    ; from function_returns and use call-site observations to resolve
    ; type vars in parameter types. This restores param types for
    ; downstream code (struct layouts, float detection, etc.)
    (let (known-fns (TIKnownFns inferer))
        (match
            known-fns
            (Nil inferer)
            ((FNS name params) rest
                (let (ret-type (lookup-fn-ret inferer name))
                    (let (resolved-params (resolve-param-types inferer params ret-type))
                        (let (new-inferer (finalize-param-types
                                            (TypeInferer
                                                (TIEnv inferer)
                                                (TISubst inferer)
                                                (TINext inferer)
                                                (TIKnownTypes inferer)
                                                resolved-params
                                                (TIFuncReturns inferer)
                                                (TIAdtDefs inferer)
                                                (TIVariantToAdt inferer)
                                                (TIStringMatchVars inferer)
                                                (TIInferringFns inferer)
                                                (TIBodyCache inferer))))
                            new-inferer)))))

(defn resolve-param-types (inferer params ret-type)
    ; resolve type vars in param types using return type evidence
    (match
        params
        (Nil Nil)
        ((FNS name ptypes) rest
            (cons
                (FNS name (map-types inferer ptypes ret-type))
                (resolve-param-types inferer rest ret-type)))))

(defn map-types (inferer types ret-type)
    ; apply return type inference to each param type
    (match
        types
        (Nil Nil)
        ((Pair t rest)
            (cons
                (resolve-type-var inferer t ret-type)
                (map-types inferer rest ret-type)))))

(defn resolve-type-var (inferer type ret-type)
    ; resolve a type variable using return type as evidence
    (match
        type
        (TVar n inner
            (if (= n (var-index ret-type))
                ret-type
                type))
        (_ type)))

(defn var-index (t)
    ; extract the type variable index from a TVar type
    (match
        t
        (TVar n inner n)
        (_ -1)))

; ===========================================================================
; INFER PROGRAM — the entry point that ties it all together
; Port of Rust infer() — the main entry for type inference
; ===========================================================================

(defn infer-program (inferer exprs)
    ; full type inference pipeline:
    ; 1. collect definitions (register signatures)
    ; 2. infer each expression
    ; 3. finalize param types
    (let (collected (collect-definitions inferer exprs))
        (let (typed (infer-expressions collected exprs))
            (finalize-param-types typed))))

(defn infer-expressions (inferer exprs)
    ; infer type of each expression, return list of (expr . inferred-type) pairs
    (match
        exprs
        (Nil Nil)
        ((Pair expr rest)
            (if (is-def-only expr)
                (cons (Pair expr (inferer-return-unit inferer))
                    (infer-expressions inferer rest))
                (let (inferred (infer-expr inferer expr))
                    (cons (Pair expr inferred)
                        (infer-expressions inferer rest)))))))

(defn is-def-only (expr)
    ; check if expr is a definition-only form (no inferred type needed)
    (match
        expr.inner
        (Deftype _ _ _ _)
        (StructDef _)
        (StructDefPlus _)
        (_ false)))

; ---------- stdlib/compiler/icnf.zyl ----------
; === Zyl Standard Library — Compiler ICNF lowering ===
; Module: compiler/icnf
;
; Lowers the reader's Ast (see compiler/ast) into an explicit instruction
; tree (ICNF). This is where the Rust compiler's PostProcessor
; responsibilities live in the self-hosted pipeline: special forms are
; recognised here by head-symbol name, per the no-dispatch architecture
; decision.
;
; Every traversal is a structural `match` on Ast/Icnf/List variants.
; There are no numeric node-kind tags, no projection accessors, and no
; positional index surgery anywhere in this module.



; --- Instruction tree -------------------------------------------------------

(deftype Icnf
  (IConst Int)
  (IStr String)
  (IFlt String)                        ; raw literal text
  (ILoad String)
  (IBinop Int Icnf Icnf)
  (ICall String (List Icnf))           ; user function (symbol-sanitized name)
  (IFfi String (List Icnf))            ; C symbol call (name used verbatim)
  (IPrint Icnf)
  (IIf Icnf Icnf Icnf)
  (IWhile Icnf Icnf)
  (ISet String Icnf)
  (ILet String Icnf Icnf)              ; name, value, body
  (ISeq (List Icnf))
  (IVariant String Int (List Icnf))    ; variant name, tag, field values
  (IMatch Icnf (List IArm)))

(deftype IArm (IArm String Int (List String) Icnf)) ; variant, tag, binds, body

(deftype IFunc (IFn String (List String) Icnf))     ; name, params, body

; Binop opcodes (instruction payloads, not node kinds):
; 0 add 1 sub 2 mul 3 div 4 rem 5 lt 6 gt 7 le 8 ge 9 eq 10 ne

(defn ic-op-of (arena s)
  (if (> (str-eq s (str-intern arena "+")) 0) 0
  (if (> (str-eq s (str-intern arena "-")) 0) 1
  (if (> (str-eq s (str-intern arena "*")) 0) 2
  (if (> (str-eq s (str-intern arena "/")) 0) 3
  (if (> (str-eq s (str-intern arena "%")) 0) 4
  (if (> (str-eq s (str-intern arena "<")) 0) 5
  (if (> (str-eq s (str-intern arena ">")) 0) 6
  (if (> (str-eq s (str-intern arena "<=")) 0) 7
  (if (> (str-eq s (str-intern arena ">=")) 0) 8
  (if (> (str-eq s (str-intern arena "==")) 0) 9
  (if (> (str-eq s (str-intern arena "=")) 0) 9
  (if (> (str-eq s (str-intern arena "!=")) 0) 10
  -1)))))))))))))

; Typed empty lists (bare `Nil` values unify ambiguously as Option vs
; List depending on module load order — always name the element type).
(defn no-strs () Nil)
(defn no-icnfs () Nil)
(defn no-asts () Nil)
(defn no-ifuncs () Nil)
(defn no-iarms () Nil)

; ===========================================================================
; GENERIC STRUCTURAL LIST HELPERS (Ast-typed streams)
; ===========================================================================

; First element of an Ast list (AInt 0 placeholder when empty).
(defn first-ast (xs)
  (match xs
    (Cons a d1 a)
    (Nil (AInt 0))))

; Tail of an Ast list (empty when empty).
(defn rest-ast (xs)
  (match xs
    (Cons d2 r r)
    (Nil Nil)))

; Last element of an Ast list.
(defn last-ast (xs)
  (last-loop xs (AInt 0)))

(defn last-loop (xs acc)
  (match xs
    (Nil acc)
    (Cons h t (last-loop t h))))

; All-but-last elements, in source order.
(defn butlast (xs acc)
  (if (is-nil xs)
    (list-reverse acc)
    (butlast-step (first-ast xs) (rest-ast xs) acc)))

(defn butlast-step (h t acc)
  (if (is-nil t)
    (list-reverse acc)
    (butlast t (Cons h acc))))

; Payload string of an Ast atom ("" unless string/float literal).
(defn atom-text (a fb)
  (match a
    (AString s s)
    (AFloat s s)
    (AIdent d5 fb)
    (AInt d6 fb)
    (ABool d7 fb)
    (AList d8 fb)))

; Ident payload of an Ast node (fallback when not an identifier).
(defn ident-name (a fb)
  (match a
    (AIdent s s)
    (AInt d9 fb)
    (AFloat d10 fb)
    (AString d11 fb)
    (ABool d12 fb)
    (AList d13 fb)))

; Head identifier of a form list compared against `s`; 1 when equal.
(defn head-name-is (arena kids s)
  (match kids
    (Cons head d14 (if (> (str-eq (ident-name head "") (str-intern arena s)) 0) 1 0))
    (Nil 0)))

; Form-level test: parenthesised form whose head identifier equals `s`.
(defn form-head-is (arena form s)
  (match form
    (AList kids (head-name-is arena kids s))
    (AIdent d15 0)
    (AInt d16 0)
    (AFloat d17 0)
    (AString d18 0)
    (ABool d19 0)))

; ===========================================================================
; PROGRAM-LEVEL LOWERING
; ===========================================================================

; Lower a whole program: collect deftype variant tables and defn bodies.
; Returns: List(IFunc)
(defn ic-program (arena prog)
  (let vt (ic-collect-vt arena prog VTNil)
    (list-reverse (ic-defns arena prog (no-ifuncs) vt))))

; Walk top-level forms; deftype forms extend the variant table.
(defn ic-collect-vt (arena forms vt)
  (match forms
    (Nil vt)
    (Cons form rest
      (if (= (form-head-is arena form "deftype") 1)
        (ic-collect-vt arena rest (ic-vt-deftype arena form vt))
        (ic-collect-vt arena rest vt)))))

; Add one deftype's variants. Form shape: (deftype Name Variant...).
; Entries link through VTable chains directly (NOT Cons cells).
(defn ic-vt-deftype (arena form vt)
  (match form
    (AList kids (ic-vt-kids arena kids vt))
    (AIdent d9 vt)
    (AInt d10 vt)
    (AFloat d11 vt)
    (AString d12 vt)
    (ABool d13 vt)))

(defn ic-vt-kids (arena kids vt)
  (if (> (list-length kids) 1)
    (vt-from-variants arena (rest-ast (rest-ast kids)) vt 0)
    vt))

; Link one variant entry per remaining variant; tail = next entry chain.
(defn vt-from-variants (arena variants vt tag)
  (match variants
    (Nil vt)
    (Cons v rest
      (let tail (vt-from-variants arena rest vt (+ tag 1))
        (let nm (str-intern arena (variant-name v))
          ; Duplicate variant names across deftypes create incompatible
          ; constructor identities whose pattern matches silently fail.
          (if (> (vt-tag-of tail nm) -1)
            (ffi-call "f_error" "E_DUPLICATE_VARIANT: variant name defined by more than one deftype" 1000)
            (VTEntry nm
                     tag
                     (variant-arity v)
                     tail)))))))

; Name of a variant spec: (Nil) | (Cons Int L) | bare Nil.
(defn variant-name (v)
  (match v
    (AIdent s s)
    (AList kids (ident-name (first-ast kids) ""))
    (AInt d26 "")
    (AFloat d27 "")
    (AString d28 "")
    (ABool d29 "")))

; Field count of a variant spec: constructor name plus N fields.
(defn variant-arity (v)
  (match v
    (AIdent d30 0)
    (AList kids (- (list-length kids) 1))
    (AInt d31 0)
    (AFloat d32 0)
    (AString d33 0)
    (ABool d34 0)))

; Lower all top-level defn forms to IFn records (source order preserved).
(defn ic-defns (arena forms acc vt)
  (match forms
    (Nil acc)
    (Cons form rest
      (if (= (form-head-is arena form "defn") 1)
        (ic-defns arena rest (Cons (ic-defn arena form vt) acc) vt)
        (ic-defns arena rest acc vt)))))

; One defn form: (defn name (params...) body).
(defn ic-defn (arena form vt)
  (match form
    (AList kids (ic-defn-kids arena kids vt))
    (AIdent d35 (ic-defn-none arena))
    (AInt d36 (ic-defn-none arena))
    (AFloat d37 (ic-defn-none arena))
    (AString d38 (ic-defn-none arena))
    (ABool d39 (ic-defn-none arena))))

(defn ic-defn-none (arena)
  (IFn (str-intern arena "?") Nil (IConst 0)))

(defn ic-defn-kids (arena kids vt)
  (if (> (list-length kids) 3)
    (ic-defn-full arena kids vt)
    (ic-defn-short arena kids vt)))

(defn ic-defn-full (arena kids vt)
  (let nm (first-ast (rest-ast kids))
    (let params (first-ast (rest-ast (rest-ast kids)))
      (let body (first-ast (rest-ast (rest-ast (rest-ast kids))))
        (let ps (list-reverse (param-names params (no-strs)))
          ; Params beyond the sixth are passed on the stack (SysV);
          ; cg-call-args/cg-param-spills handle both sides.
          (IFn (str-intern arena (ident-name nm "")) ps (ic-expr arena body vt)))))))

(defn ic-defn-short (arena kids vt)
  (let nm (first-ast (rest-ast kids))
    (IFn (str-intern arena (ident-name nm "")) Nil (IConst 0))))

; Collect parameter names from a parenthesised param node. Typed params
; ((name Type) ...) take the first element's name.
(defn param-names (node acc)
  (match node
    (AList kids (param-names-loop kids acc))
    (AIdent d40 acc)
    (AInt d41 acc)
    (AFloat d42 acc)
    (AString d43 acc)
    (ABool d44 acc)))

(defn param-names-loop (kids acc)
  (match kids
    (Nil acc)
    (Cons p rest (param-names-loop rest (Cons (param-name p) acc)))))

(defn param-name (p)
  (match p
    (AIdent s s)
    (AList pkids (ident-name (first-ast pkids) ""))
    (AInt d45 "")
    (AFloat d46 "")
    (AString d47 "")
    (ABool d48 "")))

; ===========================================================================
; EXPRESSION LOWERING
; ===========================================================================

; Lower one Ast expression to Icnf. `vt` resolves ADT constructions/match.
(defn ic-expr (arena ast vt)
  (match ast
    (AIdent n (ic-ident arena n vt))
    (AInt v (IConst v))
    (AFloat t (IFlt t))
    (AString s (IStr s))
    (ABool b (IConst (if b 1 0)))
    (AList kids (ic-form arena kids vt))))

; Identifier: nullary variant construction or variable reference.
(defn ic-ident (arena name vt)
  (let tag (vt-tag-of vt (str-intern arena name))
    (if (> tag -1)
      (IVariant (str-intern arena name) tag (no-icnfs))
      (ILoad (str-intern arena name)))))

; A parenthesised form. kids may be empty (-> Const 0).
(defn ic-form (arena kids vt)
  (match kids
    (Nil (IConst 0))
    (Cons head args (ic-headed-form arena head args vt))))

(defn ic-headed-form (arena head args vt)
  (let hname (ident-name head "")
    (let op (ic-op-of arena hname)
      (if (> op -1)
        (ic-binop arena op args vt)
        (ic-special arena hname args vt)))))

; Special-form / call routing by head-symbol name (no-dispatch arch:
; recognition happens here, never in the reader).
(defn ic-special (arena hname args vt)
  (if (> (str-eq hname (str-intern arena "let")) 0)
    (ic-let-form arena args vt)
    (if (> (str-eq hname (str-intern arena "let-mut")) 0)
      (ic-let-form arena args vt)
      (if (> (str-eq hname (str-intern arena "if")) 0)
        (ic-if-form arena args vt)
        (if (> (str-eq hname (str-intern arena "while")) 0)
          (ic-while-form arena args vt)
          (if (> (str-eq hname (str-intern arena "set!")) 0)
            (ic-set-form arena args vt)
            (if (> (str-eq hname (str-intern arena "begin")) 0)
              (ISeq (ic-arg-list arena args vt))
              (if (> (str-eq hname (str-intern arena "file-close")) 0)
                (IFfi "zyl_file_close_c" (ic-arg-list arena args vt))
                (if (> (str-eq hname (str-intern arena "file-write")) 0)
                  (IFfi "zyl_file_write_c" (ic-arg-list arena args vt))
                  (if (> (str-eq hname (str-intern arena "file-read")) 0)
                    (IFfi "zyl_file_read_c" (ic-arg-list arena args vt))
                    (if (> (str-eq hname (str-intern arena "file-open")) 0)
                      (IFfi "zyl_file_open_c" (ic-arg-list arena args vt))
                      (if (> (str-eq hname (str-intern arena "print")) 0)
                        (ic-print arena args vt)
                        (if (> (str-eq hname (str-intern arena "ffi-call")) 0)
                          (ic-ffi arena args vt)
                          (if (> (str-eq hname (str-intern arena "match")) 0)
                            (ic-match-form arena args vt)
                            (ic-call-or-variant arena hname args vt)))))))))))))))

(defn ic-call-or-variant (arena hname args vt)
  (let tag (vt-tag-of vt (str-intern arena hname))
    (if (> tag -1)
      (IVariant (str-intern arena hname) tag (ic-arg-list arena args vt))
      (ICall (str-intern arena hname) (ic-arg-list arena args vt)))))

; (let name val body...) — extra body expressions become an implicit ISeq.
(defn ic-let-form (arena args vt)
  (if (> (list-length args) 2)
    (ic-let-full arena args vt)
    (IConst 0)))

(defn ic-let-full (arena args vt)
  (let nm (first-ast args)
    (let valexpr (first-ast (rest-ast args))
      (ILet (str-intern arena (ident-name nm ""))
            (ic-expr arena valexpr vt)
            (ic-body-forms arena (rest-ast (rest-ast args)) vt)))))

; One expression -> itself; several -> ISeq; none -> Const 0.
(defn ic-body-forms (arena forms vt)
  (if (= (list-length forms) 1)
    (ic-expr arena (first-ast forms) vt)
    (ISeq (ic-arg-list arena forms vt))))

; (if c t e)
(defn ic-if-form (arena args vt)
  (if (> (list-length args) 2)
    (IIf (ic-expr arena (first-ast args) vt)
         (ic-expr arena (first-ast (rest-ast args)) vt)
         (ic-expr arena (first-ast (rest-ast (rest-ast args))) vt))
    (IConst 0)))

; (while c body...)
(defn ic-while-form (arena args vt)
  (match args
    (Cons c rest
      (IWhile (ic-expr arena c vt) (ic-body-forms arena rest vt)))
    (Nil (IConst 0))))

; (set! name expr)
(defn ic-set-form (arena args vt)
  (if (> (list-length args) 1)
    (ISet (str-intern arena (ident-name (first-ast args) ""))
          (ic-expr arena (first-ast (rest-ast args)) vt))
    (IConst 0)))

; Binary operator: exactly two arguments lowers directly, unary minus
; (- x) supported, three or more arguments fold left-associatively
; (matching the Rust bootstrap's convert_nary_fold). Anything else was
; previously lowered to (IConst 0) SILENTLY — the source of the
; "computed count is 0 in stage>=2 binaries" miscompile class.
(defn ic-binop (arena op args vt)
  (if (= (list-length args) 2)
    (IBinop op
            (ic-expr arena (first-ast args) vt)
            (ic-expr arena (first-ast (rest-ast args)) vt))
    (if (= (list-length args) 1)
      (if (= op 1)
        (IBinop 1 (IConst 0) (ic-expr arena (first-ast args) vt))
        (IConst 0))
      (if (> (list-length args) 2)
        (ic-binop-fold arena op args vt)
        (IConst 0)))))

; Left-associative n-ary fold: (op a b c) -> (op (op a b) c).
; The tree must nest LEFT so subtraction/division evaluate in source
; order: 10-(2-3) != (10-2)-3.
(defn ic-binop-fold (arena op args vt)
  (if (= (list-length args) 2)
    (IBinop op
            (ic-expr arena (first-ast args) vt)
            (ic-expr arena (last-ast args) vt))
    (let l (ic-binop-fold arena op (butlast args (no-asts)) vt)
      (IBinop op l (ic-expr arena (last-ast args) vt)))))

; print: multi-argument prints become a sequence of single prints.
(defn ic-print (arena args vt)
  (if (is-nil args)
    (IConst 0)
    (ic-print-step arena (first-ast args) (rest-ast args) vt)))

(defn ic-print-step (arena a rest vt)
  (if (is-nil rest)
    (IPrint (ic-expr arena a vt))
    (ISeq (Cons (IPrint (ic-expr arena a vt))
                (Cons (ic-print arena rest vt) (no-icnfs))))))

; (ffi-call "sym" a b timeout): drop the trailing timeout literal.
(defn ic-ffi (arena args vt)
  (match args
    (Cons sym tail
      ; tail = everything after the symbol: (arg* timeout).
      ; Both branches lower through ic-arg-list so their types unify
      ; (a bare Nil here would clash as Option vs List).
      ; NOTE: the symbol is a string literal -> use atom-text, NOT
      ; ident-name (which only extracts identifiers).
      (if (> (list-length tail) 1)
        (IFfi (atom-text sym "") (ic-arg-list arena (butlast tail (no-asts)) vt))
        (IFfi (atom-text sym "") Nil)))
    (Nil (IFfi "?" Nil))))


; (match scrutinee arm...): arm = (Variant pat* body).
(defn ic-match-form (arena args vt)
  (match args
    (Cons scr arms
      (IMatch (ic-expr arena scr vt)
              (list-reverse (ic-arms arena arms (no-iarms) vt))))
    (Nil (IConst 0))))

(defn ic-arms (arena arms acc vt)
  (match arms
    (Nil acc)
    (Cons arm rest (ic-arms arena rest (Cons (ic-arm arena arm vt) acc) vt))))

; One arm: (VariantName pat* body) — name first, body last, middle binds.
(defn ic-arm (arena arm vt)
  (match arm
    (AList parts (ic-arm-parts arena parts vt))
    (AIdent d49 (ic-arm-none arena))
    (AInt d50 (ic-arm-none arena))
    (AFloat d51 (ic-arm-none arena))
    (AString d52 (ic-arm-none arena))
    (ABool d53 (ic-arm-none arena))))

(defn ic-arm-none (arena)
  (IArm (str-intern arena "?") -1 Nil (IConst 0)))

(defn ic-arm-parts (arena parts vt)
  (match parts
    (Cons vname pats
      (let iname (str-intern arena (ident-name vname ""))
        (let tag (vt-tag-of vt iname)
          ; E_MATCH_ARM_COMPLEX guard: reject the confirmed-failing shape
          ; before lowering (see ic-arm-guard below).
          (let armguard (ic-arm-guard arena (last-ast parts) vt)
            (IArm iname
                  tag
                  (bind-names arena pats (no-strs))
                  (ic-expr arena (last-ast parts) vt))))))
    (Nil (IArm (str-intern arena "?") -1 Nil (IConst 0)))))

; ─── E_MATCH_ARM_COMPLEX guard ────────────────────────────────────────────
; A match-arm body whose TOP-LEVEL binop combines a constant with two or
; more calls silently computes 0 in stage>=2 binaries ("bind fields;
; store 0"). Nest sums through helper functions so each arm body has a
; single call. This check mirrors the Rust bootstrap's
; validate_match_arm_complexity but runs at lowering time in the
; self-hosted compiler too.
(defn ic-arm-guard (arena body vt)
  (match body
    (AList kids (ic-arm-guard-kids arena kids vt))
    (AIdent d100 0)
    (AInt d101 0)
    (AFloat d102 0)
    (AString d103 0)
    (ABool d104 0)))

(defn ic-arm-guard-kids (arena kids vt)
  (if (> (list-length kids) 2)
    (ic-arm-guard-head arena (first-ast kids) (rest-ast kids) vt)
    0))

(defn ic-arm-guard-head (arena head args vt)
  (let op (ic-op-of arena (ident-name head ""))
    (if (> op -1)
      (ic-arm-guard-count arena args vt 0 0)
      0)))

; Count constant and call-like operands; error on const>=1 && calls>=2.
(defn ic-arm-guard-count (arena args vt consts calls)
  (if (is-nil args)
    (if (> consts 0)
      (if (> calls 1)
        (ffi-call "f_error" "E_MATCH_ARM_COMPLEX: match arm combines a constant with multiple calls - nest sums through helper functions" 1000)
        0)
      0)
    (ic-arm-guard-count arena (rest-ast args) vt
                        (+ consts (ic-arm-guard-is-const (first-ast args)))
                        (+ calls (ic-arm-guard-is-call arena (first-ast args) vt)))))

(defn ic-arm-guard-is-const (a)
  (match a
    (AList dkids 0)
    (AIdent d105 0)
    (AInt d106 1)
    (AFloat d107 1)
    (AString d108 0)
    (ABool d109 1)))

; A call-like operand: a parenthesised form whose head is NOT a known
; variant constructor (special forms inside binop args are rejected too —
; they violate the one-call rule regardless).
(defn ic-arm-guard-is-call (arena a vt)
  (match a
    (AList kids (if (> (list-length kids) 0)
                  (ic-arm-guard-call-head arena (first-ast kids) vt)
                  0))
    (AIdent d110 0)
    (AInt d111 0)
    (AFloat d112 0)
    (AString d113 0)
    (ABool d114 0)))

(defn ic-arm-guard-call-head (arena head vt)
  (let tag (vt-tag-of vt (str-intern arena (ident-name head "")))
    (if (> tag -1) 0 1)))

; Pattern binding names ("_" wildcards kept, skipped by codegen), in
; source order: every element except the trailing body.
(defn bind-names (arena pats acc)
  (if (is-nil pats)
    (list-reverse acc)
    (bind-names-step arena (first-ast pats) (rest-ast pats) acc)))

(defn bind-names-step (arena h t acc)
  (if (is-nil t)
    (list-reverse acc)
    (bind-names arena t (Cons (str-intern arena (ident-name h "")) acc))))

; Lower argument lists left-to-right.
(defn ic-arg-list (arena args vt)
  (ic-arg-list-acc arena args vt (no-icnfs)))

(defn ic-arg-list-acc (arena args vt acc)
  (match args
    (Nil (list-reverse acc))
    (Cons a rest
      (ic-arg-list-acc arena rest vt (Cons (ic-expr arena a vt) acc)))))

; ---------- stdlib/compiler/codegen.zyl ----------
; === Zyl Standard Library — Self-Hosting: x86_64 codegen ===
; Module: compiler/codegen
;
; Walks the recursive Icnf instruction tree (see compiler/icnf) and emits
; GAS .intel_syntax noprefix assembly text. Expression code is evaluated
; into rax (a pure stack-machine discipline): every sub-expression leaves
; its value in rax; binary operators push the left operand around the
; right operand's evaluation.
;
; Conventions:
;   - Parameters arrive in SysV registers (rdi rsi rdx rcx r8 r9) and are
;     spilled to [rbp-8*(i+1)] in the prologue.
;   - Locals (let / match bindings) get slots from a downward-growing
;     offset counter carried in the emitter state.
;   - Names are resolved through an immutable Env chain (see ast.zyl).
;   - Calls support up to 6 register arguments; argument values are pushed
;     and popped in reverse so evaluation order stays strictly
;     left-to-right (spec evaluation-order rule).
;   - Floats travel as bit patterns in rax and move to xmm0/xmm1 for SSE
;     arithmetic; print selects %d/%f/%s by the operand's kind.
;
; Emitter state is an immutable CGState threaded functionally through
; every emitter function (no mutable records, no raw cells):
;   CGState = (CGS arena buffer next-label next-slot rodata)
; Two-value results use small wrapper ADTs:
;   CGR = state + int + string  (fresh labels / slot offsets)
;   CGE = state + env           (match-binding sequences)
;
; Bootstrap constraint note: pattern wildcards must be named dummies
; (`dN`) because the Rust bootstrap miscompiles bare `_` patterns.




; --- Emitter state ----------------------------------------------------------

; One rodata entry: label, payload text, kind (0 string, 1 float).
(deftype REntry (REntry String String Int))

; Known top-level function names (for fn-value references).
(deftype FnName (FN String) FNNil)

(deftype CGState (CGS Int Int Int Int (List REntry) (List FnName)))
; fields: arena, buffer, next-label, next-slot, rodata, fn-names, fn names
; fields: arena, text buffer, next label number, next slot offset,
; known top-level function names

(deftype CGR (CGR CGState Int String))

(deftype CGE (CGE CGState Env))

; Result wrapper: state + two labels.
(deftype CGP (CGP CGState String String))

; Allocate two consecutive labels. Each match is the entire body of its
; own defn (nested matches miscompile in the current bootstrap).
(defn cg-label-pair (st)
  (cg-label-pair-2 (cg-label-new st)))

(defn cg-label-pair-2 (r1)
  (match r1
    (CGR st1 d1 la (cg-label-second st1 la))))

(defn cg-label-second (st1 la)
  (match (cg-label-new st1)
    (CGR st2 d2 lb (CGP st2 la lb))))

(defn no-fnnames () None)


; Codegen text buffer: 64MB, zero-initialized (buf-append appends at
; strlen, so the zero fill terminates every intermediate string). The
; driver checks the final length against E_CODEGEN_BUFFER_LIMIT after
; emission — overflow would otherwise corrupt the arena silently.
(defn cg-new (arena)
  (let buf (arena-alloc-zeroed arena 67108864)
    (CGS arena buf 0 8 (no-rentries) (no-fnnames))))   ; slots 1..n

(defn cg-with-fnname (st nm)
  (match st
    (CGS a b n s rd fns2
      (CGS a b n s rd (Cons (FN nm) fns2)))))

(defn cgg-fns (st)
  (match st
    (CGS d70 d71 d72 d73 d74 fns fns)))

; True when `nm` is a known top-level function name.
(defn cg-fn-known (st nm)
  (cg-fn-search (cgg-fns st) nm))

(defn cg-fn-search (fns nm)
  (if (is-nil fns)
    0
    (cg-fn-check-head (fnhead fns) (fntail fns) nm)))

; Head of a List(FnName); FNNil when empty.
(defn fnhead (xs)
  (match xs
    (Cons h d h)
    (Nil (FNNil))))

; Tail of a List(FnName); empty when empty.
(defn fntail (xs)
  (match xs
    (Cons h d d)
    (Nil None)))

(defn cg-fn-check-head (h t nm)
  (match h
    (FN s (if (= (str-eq s nm) 1) 1 (cg-fn-search t nm)))
    (FNNil (cg-fn-search t nm))))

; Empty rodata list.
(defn no-rentries () Nil)

(defn cg-buffer (st)
  (match st
    (CGS d1 buf d2 d3 d4 d5 buf)))

(defn cg-with-rodata (st entry)
  (match st
    (CGS a b n s rd fns
      (CGS a b n s (Cons entry rd) fns))))

(defn cg-emit (st s)
  (match st
    (CGS d6 buf d7 d8 d9 d10
      (begin (buf-append buf s) st))))

(defn cg-emit-int (st n)
  (match st
    (CGS arena buf d10 d11 d12 d13
      (begin
        (buf-append buf (ffi-call "zyl_cstr_from_int" arena n 1000))
        st))))

(defn cg-nl (st)
  (cg-emit st "
"))

; Fresh label .L<N>.
; Returns: CGR (advanced state; string field carries the label text).
(defn cg-label-new (st)
  (match st
    (CGS arena buf n slot rd fns
      (let lblbuf (arena-alloc-zeroed arena 32)
        (begin
          (buf-append lblbuf (str-intern arena ".L"))
          (buf-append lblbuf (ffi-call "zyl_cstr_from_int" arena n 1000))
          (CGR (CGS arena buf (+ n 1) slot rd fns) 0 lblbuf))))))

; Allocate one 8-byte local slot.
; Returns: CGR (advanced state; int field carries the rbp offset, negative).
(defn cg-new-slot (st)
  (match st
    (CGS a b n off rd fns
      (CGR (CGS a b n (+ off 8) rd fns) (- off) ""))))

; ===========================================================================
; RODATA INTERNING
; ===========================================================================

; Intern a string constant; emit `lea rax, [rip+label]`.
(defn cg-string-const (st content)
  (match (cg-label-new st)
    (CGR st2 d13 lbl
      (let st3 (cg-with-rodata st2 (REntry lbl content 0))
        (let st4 (cg-emit st3 "    lea rax, [rip+")
          (let st5 (cg-emit st4 lbl)
            (cg-nl (cg-emit st5 "]"))))))))

; Intern a float constant; load its bits into rax via xmm0.
(defn cg-float-const (st text)
  (match (cg-label-new st)
    (CGR st2 d14 lbl
      (let st3 (cg-with-rodata st2 (REntry lbl text 1))
        (let st4 (cg-emit st3 "    movsd xmm0, [rip+")
          (let st5 (cg-emit st4 lbl)
            (let st6 (cg-nl (cg-emit st5 "]"))
              (cg-nl (cg-emit st6 "    movq rax, xmm0")))))))))

(defn cg-rodata-of (st)
  (match st
    (CGS d15 d16 d17 d18 rd d19 rd)))

; ===========================================================================
; KINDS (for print format + float detection): 0 int, 1 string, 2 float
; ===========================================================================

(defn kind-of (env e)
  (match e
    (IConst 0)
    (IStr d19 1)
    (IFlt d20 2)
    (ILoad n (env-kind-of env n))
    (IBinop op l r
     (if (> op 4)
       0
       (if (= (kind-of env l) 2)
         2
         (if (= (kind-of env r) 2) 2 0))))
    (IIf d21 t d22 (kind-of env t))
    (ICall d23 d24 0)
    (IFfi d25 d26 0)
    (IPrint d27 0)
    (IWhile d28 d29 0)
    (ISet d30 d31 0)
    (ILet d32 d33 d34 0)
    (ISeq d35 0)
    (IVariant d36 d37 d38 0)
    (IMatch d39 d40 0)))

; ===========================================================================
; EXPRESSION EMISSION (result always in rax)
; ===========================================================================

(defn cg-expr (st env e)
  (match e
    (IConst v
     (let st2 (cg-emit st "    mov rax, ")
       (let st3 (cg-emit-int st2 v)
         (cg-nl st3))))
    (IStr s (cg-string-const st s))
    (IFlt t (cg-float-const st t))
    (ILoad n (cg-load-value st env n))
    (IBinop op l r
     (if (> (if (= (kind-of env l) 2) 1 (if (= (kind-of env r) 2) 1 0)) 0)
       (cg-fbinop st env op l r)
       (cg-ibinop st env op l r)))
    (ICall name args (cg-call-args st env name args true 0))
    (IFfi sym args (cg-call-args st env sym args false 0))
    (IPrint a (cg-print st env a))
    (IIf c t eb (cg-if-dispatch st env c t eb))
    (IWhile c body (cg-while-dispatch st env c body))
    (ISet n v
     (let st2 (cg-expr st env v)
       (let st3 (cg-emit st2 "    mov [rbp")
         (let st4 (cg-emit-int st3 (env-lookup env n))
           (cg-nl (cg-emit st4 "], rax"))))))
    (ILet n v body (cg-let-dispatch st env n v body))
    (ISeq es (cg-seq st env es))
    (IVariant d46 tag fields (cg-variant st env tag fields))
    (IMatch scr arms (cg-match st env scr arms))))

; Load a variable / function value into rax.
(defn cg-load-value (st env n)
  (if (= (env-lookup env n) 0)
    (cg-load-nonslot st env n)
    (cg-load-slot st n (env-lookup env n))))

(defn cg-load-slot (st n off)
  (let st2 (cg-emit st "    mov rax, [rbp")
    (let st3 (cg-emit-int st2 off)
      (cg-nl (cg-emit st3 "]")))))

(defn cg-load-nonslot (st env n)
  ; Function value reference: load the function's address so it can be
  ; passed as an argument and called indirectly (HOF support).
  (if (= (cg-fn-known st n) 1)
    (cg-load-fnref st n)
    (cg-load-unresolved st)))

(defn cg-load-fnref (st n)
  (let st2 (cg-emit st "    lea rax, [rip+f_")
    (let st3 (cg-emit st2 (ffi-call "zyl_cstr_sanitize" (cg-arena-of st) n 1000))
      (let st4 (cg-emit st3 "]")
        (cg-nl st4)))))

; P1 note: kept for parity with previous behavior; flagged for hardening.
(defn cg-load-unresolved (st)
  (let st2 (cg-emit st "    mov rax, [rbp")
    (let st3 (cg-emit-int st2 0)
      (cg-nl (cg-emit st3 "]")))))

(defn cg-if-dispatch (st env c t eb)
  (cg-if-labels (cg-label-pair st) env c t eb))

(defn cg-if-labels (p env c t eb)
  (cg-if-parts p env c t eb))

(defn cg-while-dispatch (st env c body)
  (cg-while-labels (cg-label-pair st) env c body))

(defn cg-while-labels (p env c body)
  (match p
    (CGP st lstart lend (cg-while-parts st env c body lstart lend))))

(defn cg-let-dispatch (st env n v body)
  (match (cg-new-slot st)
    (CGR st2 off d45
      (cg-let-store st2 env n v body off))))

(defn cg-let-store (st env n v body off)
  (let k (kind-of env v)
    (let st3 (cg-expr st env v)
      (let st4 (cg-emit st3 "    mov [rbp")
        (let st5 (cg-emit-int st4 off)
          (let st6 (cg-nl (cg-emit st5 "], rax"))
            (cg-expr st6 (EnvBind n off k env) body)))))))

; (if c t e): condition tested, then branch tails. p carries the state
; plus the else/join labels.
(defn cg-if-parts (p env c t eb)
  (match p
    (CGP st lelse lend
      (let st2 (cg-expr st env c)
        (let st3 (cg-emit st2 "    test rax, rax")
          (let st4 (cg-nl st3)
            (let st5 (cg-emit st4 "    je ")
              (let st6 (cg-nl (cg-emit st5 lelse))
                (let st7 (cg-expr st6 env t)
                  (let st8 (cg-emit st7 "    jmp ")
                    (let st9 (cg-nl (cg-emit st8 lend))
                      (let st10 (cg-emit-label st9 lelse)
                        (let st11 (cg-expr st10 env eb)
                          (cg-emit-label st11 lend))))))))))))))

; (while c body...)
(defn cg-while-parts (st env c body lstart lend)
  (let st2 (cg-emit-label st lstart)
    (let st3 (cg-expr st2 env c)
      (let st4 (cg-emit st3 "    test rax, rax")
        (let st5 (cg-nl st4)
          (let st6 (cg-emit st5 "    je ")
            (let st7 (cg-nl (cg-emit st6 lend))
              (let st8 (cg-expr st7 env body)
                (let st9 (cg-emit st8 "    jmp ")
                  (let st10 (cg-nl (cg-emit st9 lstart))
                    (let st11 (cg-emit-label st10 lend)
                      (cg-emit-line st11 "    xor eax, eax"))))))))))))

(defn cg-emit-line (st s)
  (cg-nl (cg-emit st s)))

(defn cg-seq (st env es)
  (if (is-nil es)
    (cg-emit-line st "    xor eax, eax")
    (if (is-nil (tl2 es))
      (cg-expr st env (ih-ic es))
      (let st2 (cg-expr st env (ih-ic es))
        (cg-seq st2 env (tl2 es))))))

; Integer binary op: lhs -> rax (pushed), rhs -> rax, lhs restored to rax,
; rhs kept in rcx. Div/Rem use cqo/idiv with divisor safe in rcx.
(defn cg-ibinop (st env op l r)
  (let st2 (cg-expr st env l)
    (let st3 (cg-emit-line st2 "    push rax")
      (let st4 (cg-expr st3 env r)
        (let st5 (cg-emit-line st4 "    mov rcx, rax")
          (let st6 (cg-emit-line st5 "    pop rax")
            (if (< op 5)
              (cg-arith-mnem st6 op)
              (cg-cmp-set st6 op))))))))

(defn cg-arith-mnem (st op)
  ; Div (3) and Rem (4) both sign-extend rax into rdx via cqo before idiv,
  ; otherwise a stale rdx makes the 128-bit quotient overflow (SIGFPE).
  (let st2 (if (> op 2) (cg-emit-line st "    cqo") st)
    (let mnem (if (= op 0) "    add rax, rcx"
              (if (= op 1) "    sub rax, rcx"
                (if (= op 2) "    imul rax, rcx"
                  "    idiv rcx")))
      (let st3 (cg-emit-line st2 mnem)
        (if (= op 4)
          (cg-emit-line st3 "    mov rax, rdx")
          st3)))))

(defn cg-cmp-set (st op)
  (let st2 (cg-emit-line st "    cmp rax, rcx")
    (let st3 (cg-emit st2 "    set")
      (if (= op 5)
        (cg-setcc st3 "l al")
        (if (= op 6)
          (cg-setcc st3 "g al")
          (if (= op 7)
            (cg-setcc st3 "le al")
            (if (= op 8)
              (cg-setcc st3 "ge al")
              (if (= op 9)
                (cg-setcc st3 "e al")
                (cg-setcc-ne st3)))))))))

(defn cg-setcc (st s)
  (let st4 (cg-nl (cg-emit st s))
    (cg-emit-line st4 "    movzx rax, al")))

(defn cg-setcc-ne (st)
  (let st4 (cg-nl (cg-emit st "ne al"))
    (cg-emit-line st4 "    movzx rax, al")))

; Float binary op: bits in rax; xmm0 = lhs, xmm1 = rhs.
(defn cg-fbinop (st env op l r)
  (let st2 (cg-expr st env l)
    (let st3 (cg-emit-line st2 "    push rax")
      (let st4 (cg-expr st3 env r)
        (let st5 (cg-emit-line st4 "    movq xmm1, rax")
          (let st6 (cg-emit-line st5 "    pop rax")
            (let st7 (cg-emit-line st6 "    movq xmm0, rax")
              (if (< op 5)
                (cg-farith st7 op)
                (cg-fcmp st7 op)))))))))

(defn cg-farith (st op)
  (let st2 (cg-emit st "    ")
    (let st3 (if (= op 0) (cg-emit st2 "addsd")
             (if (= op 1) (cg-emit st2 "subsd")
               (if (= op 2) (cg-emit st2 "mulsd")
                 (cg-emit st2 "divsd"))))
      (let st4 (cg-emit-line st3 " xmm0, xmm1")
        (cg-emit-line st4 "    movq rax, xmm0")))))

(defn cg-fcmp (st op)
  (let st2 (cg-emit-line st "    comisd xmm0, xmm1")
    (let st3 (cg-emit st2 "    set")
      (if (= op 5)
        (cg-fsetcc st3 "b al")
        (if (= op 6)
          (cg-fsetcc st3 "a al")
          (if (= op 7)
            (cg-fsetcc st3 "be al")
            (if (= op 8)
              (cg-fsetcc st3 "ae al")
              (if (= op 9)
                (cg-fsetcc st3 "e al")
                (cg-fsetcc-ne st3)))))))))

; unsigned-comparison flags carry the usual sense here
(defn cg-fsetcc (st s)
  (let st4 (cg-nl (cg-emit st s))
    (cg-emit-line st4 "    movzx rax, al")))

(defn cg-fsetcc-ne (st)
  (let st4 (cg-nl (cg-emit st "ne al"))
    (cg-emit-line st4 "    movzx rax, al")))

; Register-name dispatch by arg index (SysV).
(defn cg-reg-of (i)
  (if (= i 0) "rdi"
    (if (= i 1) "rsi"
      (if (= i 2) "rdx"
        (if (= i 3) "rcx"
          (if (= i 4) "r8"
            "r9"))))))

; Call: arguments are staged through scratch slots so that more than six
; parameters work (SysV stack args):
;   phase 0: 8-byte alignment pad if N+S is odd (S = stack args)
;   phase 1: evaluate every argument left-to-right into an 8-byte
;            scratch slot (`sub rsp, 8` / `mov [rsp], rax`)
;   phase 2: copy-push stack args (index >= 6) in reverse order so arg 6
;            sits at [rsp] at the call
;   phase 3: load register args from their scratch slots ([rsp+off],
;            offsets account for the copy-pushes)
;   phase 4: call; cleanup removes pad + scratch + copy-pushes.
; `mangle` adds the f_ prefix for user functions.
(defn cg-call-args (st env name args mangle i)
  (let n (list-length args)
    (let st2 (if (= (% (+ n (cg-stack-count n)) 2) 1)
               (cg-emit-line st "    sub rsp, 8")
               st)
      (let st3 (cg-scratch-all st2 env args)
        (let st4 (cg-copy-stack-args st3 n (- n 1) 0)
          (let st5 (cg-load-reg-args st4 n (- (cg-min-int n 6) 1))
            (if (> mangle 0)
              (cg-fire-user st5 env name n)
              (cg-fire-ext st5 env name n))))))))

; Number of stack-passed (SysV) arguments for a call of arity n.
(defn cg-stack-count (n)
  (if (> n 6) (- n 6) 0))

(defn cg-min-int (a b)
  (if (< a b) a b))

; Phase 1: evaluate each argument once and spill it into a scratch slot.
(defn cg-scratch-all (st env args)
  (if (is-nil args)
    st
    (let st2 (cg-expr st env (ih-ic args))
      (let st3 (cg-emit-line st2 "    sub rsp, 8")
        (let st4 (cg-emit-line st3 "    mov [rsp], rax")
          (cg-scratch-all st4 env (tl2 args)))))))

; Phase 2: copy-push args i = n-1 down to 6 from their scratch slots
; (no-op for arity <= 6); `pushed` counts bytes already copy-pushed.
(defn cg-copy-stack-args (st n i pushed)
  (if (< i 6)
    st
    (let st2 (cg-copy-one st (+ (* 8 (- n 1 i)) pushed))
      (cg-copy-stack-args st2 n (- i 1) (+ pushed 8)))))

(defn cg-copy-one (st off)
  (let st2 (cg-emit st "    mov r10, [rsp+")
    (let st3 (cg-emit-int st2 off)
      (let st4 (cg-emit st3 "]")
        (let st5 (cg-nl st4)
          (cg-emit-line st5 "    push r10"))))))

; Phase 3: load register args i = min(n,6)-1 down to 0 from scratch;
; offsets skip over the S copy-pushed stack args.
(defn cg-load-reg-args (st n i)
  ; NOTE: the offset must be built through lets — a binop whose direct
  ; operands are BOTH calls silently computes 0 in stage>=2 binaries
  ; (generalisation of the match-arm one-call rule).
  (if (< i 0)
    st
    (let a (* 8 (- n 1 i))
      (let b (* 8 (cg-stack-count n))
        (let st2 (cg-load-reg-one st (cg-reg-of i) (+ a b))
          (cg-load-reg-args st2 n (- i 1)))))))

(defn cg-load-reg-one (st reg off)
  (let st2 (cg-emit st "    mov ")
    (let st3 (cg-emit st2 reg)
      (let st4 (cg-emit st3 ", [rsp+")
        (let st5 (cg-emit-int st4 off)
          (cg-nl (cg-emit st5 "]")))))))

; HOF indirect calls are implemented but gated OFF: the path crashes
; inside stage1's own execution (see PROGRESS.md stage2 blocker #3).
(defn cg-hof-enabled () 1)

; Full call-target symbol: f_<name> for user fns, <name> otherwise.
(defn cg-sym-for (arena name mangle)
  (if (> mangle 0)
    (cg-sym-mangled arena name)
    (ffi-call "zyl_cstr_sanitize" arena name 1000)))

(defn cg-sym-mangled (arena name)
  (let buf (arena-alloc-zeroed arena 512)
    (begin
      (buf-append buf (str-intern arena "f_"))
      (buf-append buf (ffi-call "zyl_cstr_sanitize" arena name 1000))
      buf)))

(defn cg-cat2 (arena a b)
  (let buf (arena-alloc-zeroed arena (+ (alloc-strlen a) (alloc-strlen b) 1))
    (begin
      (buf-append buf a)
      (buf-append buf b)
      buf)))

(defn cg-cat3 (arena a b c)
  (cg-cat2 arena (cg-cat2 arena a b) c))

; Build "call f_<sanitized>" as a single string.
(defn cg-call-user-str (st env name)
  (let sym (cg-sym-for (cg-arena-of st) name 1)
    (cg-cat2 (cg-arena-of st) (str-intern (cg-arena-of st) "call ") sym)))

; ── mangled (user fn) path: n args already pushed, rsp pre-aligned ──

(defn cg-fire-user (st env name n)
  ; If `name` is a local binding it holds a function value: indirect call.
  (if (= (env-lookup env name) 0)
    (cg-user-direct st env name n)
    (cg-user-indirect st env name n)))

(defn cg-call-cleanup (st n)
  ; Built through lets: no binop may directly combine two calls.
  (let ns (+ n (cg-stack-count n))
    (let tot (* 8 (+ ns (% ns 2)))
      (let st2 (cg-emit st "    add rsp, ")
        (cg-nl (cg-emit-int st2 tot))))))

(defn cg-user-direct (st env name n)
  (let st2 (cg-emit-line st (cg-call-user-str st env name))
    (cg-call-cleanup st2 n)))

; Indirect (HOF): target address is in the local's stack slot. Load it
; into r10 AFTER the register args are staged so nothing clobbers them.
(defn cg-indirect-target (st off)
  (let st2 (cg-emit st "    mov r10, [rbp")
    (let st3 (cg-emit-int st2 off)
      (let st4 (cg-emit st3 "]")
        (let st5 (cg-nl st4)
          (cg-emit-line st5 "    call r10"))))))

(defn cg-user-indirect (st env name n)
  (let st2 (cg-indirect-target st (env-lookup env name))
    (cg-call-cleanup st2 n)))

; ── ext (FFI) path ──

(defn cg-fire-ext (st env name n)
  (let st2 (cg-cat2 (cg-arena-of st) (str-intern (cg-arena-of st) "call ") (str-intern (cg-arena-of st) name))
    (let st3 (cg-emit-line st st2)
      (cg-call-cleanup st3 n))))

; print: pick the format by the argument's kind.
(defn cg-print (st env a)
  (let k (kind-of env a)
    (let st2 (cg-expr st env a)
      (if (= k 2)
        (let st3 (cg-emit-line st2 "    movq xmm0, rax")
          (let st4 (cg-emit-line st3 "    lea rdi, [rip+.Lfmtf]")
            (let st5 (cg-emit-line st4 "    mov eax, 1")
              (cg-emit-line st5 "    call printf"))))
        (if (= k 1)
          (let st3 (cg-emit-line st2 "    mov rsi, rax")
            (let st4 (cg-emit-line st3 "    lea rdi, [rip+.Lfmts]")
              (let st5 (cg-emit-line st4 "    xor eax, eax")
                (cg-emit-line st5 "    call printf"))))
          (let st3 (cg-emit-line st2 "    mov rsi, rax")
            (let st4 (cg-emit-line st3 "    lea rdi, [rip+.Lfmtd]")
              (let st5 (cg-emit-line st4 "    xor eax, eax")
                (cg-emit-line st5 "    call printf")))))))))

; Variant construction: malloc'd block [tag][f0]..[fn-1].
; Fields are evaluated and pushed, then popped into the block (right to
; left). An odd field count gets 8 bytes of pad to keep rsp 16-aligned
; across malloc.
(defn cg-variant (st env tag fields)
  (let n (list-length fields)
    (let st2 (cg-push-fields st env fields)
      (let st3 (if (= (% n 2) 1) (cg-emit-line st2 "    sub rsp, 8") st2)
        (let st4 (cg-nl (cg-emit-int (cg-emit st3 "    mov rdi, ") (* 8 (+ n 1))))
          (let st5 (cg-emit-line st4 "    call malloc")
            (let st6 (cg-emit-line st5 "    mov rbx, rax")
              (let st7 (cg-emit-int (cg-emit st6 "    mov qword ptr [rbx], ") tag)
                (let st8 (cg-nl st7)
                  (let st9 (if (= (% n 2) 1) (cg-emit-line st8 "    add rsp, 8") st8)
                    (let st10 (cg-pop-fields st9 (- n 1))
                      (cg-emit-line st10 "    mov rax, rbx"))))))))))))

; Evaluate each field left-to-right, pushing its value.
(defn cg-push-fields (st env fields)
  (if (is-nil fields)
    st
    (let st2 (cg-expr st env (ih-ic fields))
      (cg-push-fields (cg-emit-line st2 "    push rax") env (tl2 fields)))))

; Pop n fields into the block rbx points at (reverse order restores the
; original left-to-right layout).
(defn cg-pop-fields (st j)
  (if (< j 0)
    st
    (let st2 (cg-emit-line st "    pop rax")
      (let st3 (cg-emit st2 "    mov [rbx+")
        (let st4 (cg-emit-int st3 (* 8 (+ j 1)))
          (let st5 (cg-nl (cg-emit st4 "], rax"))
            (cg-pop-fields st5 (- j 1))))))))

; Match: evaluate scrutinee, keep it on the stack for the whole dispatch,
; replace it with the arm-body result, pop at the end.
; Stack invariant: exactly one pushed word ([rsp] = scrutinee or result).
(defn cg-match (st env scr arms)
  (cg-match-labels (cg-label-pair st) env scr arms))

(defn cg-match-labels (p env scr arms)
  (match p
    (CGP st lend lzero
      (cg-match-scrutinee st env scr arms lend lzero))))

(defn cg-match-scrutinee (st env scr arms lend lzero)
  (let st3 (cg-expr st env scr)
    (let st4 (cg-emit-line st3 "    push rax")
      (cg-match-arms st4 env arms lend lzero))))

(defn cg-match-arms (st env arms lend lzero)
  (let st5 (cg-arms st env arms lend lzero)
    ; fall-through: no arm matched -> 0
    (let st6 (cg-emit-label st5 lzero)
      (let st7 (cg-emit-line st6 "    mov qword ptr [rsp], 0")
        (let st8 (cg-emit-label st7 lend)
          (cg-emit-line st8 "    pop rax"))))))

; Emit arms[i..]. Each arm checks [rsp]'s tag; a failed check jumps to
; the next arm's label (or the zero fall-through after the last arm); a
; successful match binds pattern vars and evaluates the body.
(defn cg-arms (st env arms lend lzero)
  (if (is-nil arms)
    st
    (cg-arm-one (CGP st lend lzero) (hd-ia arms) (tl2 arms) env)))

(defn cg-arm-one (p arm rest env)
  (match p
    (CGP st lend lzero
      (match arm
        (IArm vname tag binds body
          (if (is-nil rest)
            ; last arm: failed tag check falls through to the zero label
            (cg-arm-match (CGP st lzero lend) env tag binds body)
            ; more arms follow: failures jump to a fresh next-arm label
            (let picked (cg-label-new st)
              (let lnext (cgr-str picked)
                (let st-after (cg-arm-match (CGP (cgr-st picked) lnext lend) env tag binds body)
                  (cg-arms (cg-emit-label st-after lnext) env rest lend lzero))))))))))

; Emit one arm's tag check, bindings, body and exit jump. flabel (carried
; in p) is where a failed tag check goes; lend is the match join label.
(defn cg-arm-match (p env tag binds body)
  (match p
    (CGP st flabel lend
      (let st3 (cg-tag-check st tag)
        (let st4 (cg-emit st3 "    jne ")
          (let st5 (cg-nl (cg-emit st4 flabel))
            (match (cg-bind-fields st5 env binds 0)
              (CGE st6 arm-env
                (let st7 (cg-expr st6 arm-env body)
                  (let st8 (cg-emit-line st7 "    mov [rsp], rax")
                    (let st9 (cg-emit st8 "    jmp ")
                      (cg-nl (cg-emit st9 lend)))))))))))))

(defn cgr-st (r)
  (match r
    (CGR s d49 d50 s)))

(defn cgr-str (r)
  (match r
    (CGR d51 d52 s s)))

; Arm prologue: load scrutinee pointer from [rsp] and its tag.
(defn cg-tag-check (st tag)
  (let st2 (cg-emit-line st "    mov rax, [rsp]")
    (let st3 (cg-emit-line st2 "    mov rax, [rax]")
      (let st4 (cg-emit st3 "    cmp rax, ")
        (cg-nl (cg-emit-int st4 tag))))))

; Bind pattern variables: field j of [rsp]'s block goes into a fresh slot.
; "_" wildcards are skipped by codegen. Returns: CGE (state + extended env).
(defn cg-bind-fields (st env binds j)
  (if (is-nil binds)
    (CGE st env)
    (cg-bind-one st env binds j)))

(defn cg-bind-one (st env binds j)
  (let st2 (cg-load-field st j)
    (let b (shd binds)
      (if (> (str-eq b (str-intern (cg-arena-of st) "_")) 0)
        (cg-bind-fields st2 env (tl2 binds) (+ j 1))
        (cg-bind-slot st2 env binds j b)))))

(defn cg-bind-slot (st env binds j b)
  (match (cg-new-slot st)
    (CGR st3 off d53
      (cg-bind-store st3 env binds j b off))))

(defn cg-bind-store (st env binds j b off)
  (let st4 (cg-store-rax-slot st off)
    (cg-bind-fields st4 (EnvBind b off 0 env) (tl2 binds) (+ j 1))))

; Load field j of the block at [rsp]: rax = [[rsp] + 8*(j+1)].
(defn cg-load-field (st j)
  (let st2 (cg-emit-line st "    mov rax, [rsp]")
    (let st3 (cg-emit st2 "    mov rax, [rax+")
      (let st4 (cg-emit-int st3 (* 8 (+ j 1)))
        (cg-nl (cg-emit st4 "]"))))))

(defn cg-store-rax-slot (st off)
  (let st2 (cg-emit st "    mov [rbp")
    (let st3 (cg-emit-int st2 off)
      (cg-nl (cg-emit st3 "], rax")))))

(defn cg-emit-label (st lbl)
  (cg-nl (cg-emit (cg-emit st lbl) ":")))

; ===========================================================================
; FUNCTION / PROGRAM EMISSION
; ===========================================================================

; ─── Frame sizing ────────────────────────────────────────────────────────
; Upper bound on stack slots a function needs: total Icnf nodes in its
; body (every node may own one 8-byte slot). Keeps frames small so deep
; recursion in the compiler stays within the machine stack.

; NOTE: match-arm bodies must stay SINGLE expressions (one call or one
; binop-with-one-call). The Rust bootstrap drops computations when a
; match-arm body combines a constant with MULTIPLE calls (seen as frames
; collapsing to minimum size in stage>=2 binaries). Hence these helpers.
(defn icnf-add2 (a b) (+ a b))
(defn icnf-add3 (a b c) (+ a (+ b c)))

(defn icnf-size (e)
  (match e
    (IConst d54 1)
    (IStr d55 1)
    (IFlt d56 1)
    (ILoad d57 1)
    (IBinop d58 l r (icnf-add3 3 (icnf-size l) (icnf-size r)))
    (ICall d59 args (icnf-add2 2 (icnf-count-list args)))
    (IFfi d60 args (icnf-add2 2 (icnf-count-list args)))
    (IPrint a (+ 1 (icnf-size a)))
    (IIf c t eb (icnf-add3 4 (icnf-size c) (icnf-size t) (icnf-size eb)))
    (IWhile c b (icnf-add3 3 (icnf-size c) (icnf-size b)))
    (ISet d61 v (+ 2 (icnf-size v)))
    (ILet d62 v b (icnf-add3 3 (icnf-size v) (icnf-size b)))
    (ISeq es (+ 1 (icnf-count-list es)))
    (IVariant d63 d64 fields (+ 1 (icnf-count-list fields)))
    (IMatch scr arms (icnf-add3 2 (icnf-size scr) (icnf-count-arms arms)))))

(defn icnf-count-list (xs)
  (match xs
    (Nil 0)
    (Cons h t (+ (icnf-size h) (icnf-count-list t)))))

; Static slot-count estimate: every runtime `cg-new-slot` corresponds to
; exactly one ILet node or one non-wildcard pattern bind, allocated once
; during codegen (branches accumulate, never reuse). Frames are now sized
; from this instead of the uniform 16*(64+icnf-size) waste.
(defn icnf-slot-count (e)
  (match e
    (IConst d80 0)
    (IStr d81 0)
    (IFlt d82 0)
    (ILoad d83 0)
    (IBinop d84 l r (icnf-add2 (icnf-slot-count l) (icnf-slot-count r)))
    (ICall d85 args (icnf-count-slots-list args))
    (IFfi d86 args (icnf-count-slots-list args))
    (IPrint a (icnf-slot-count a))
    (IIf c t eb (icnf-add3 (icnf-slot-count c) (icnf-slot-count t) (icnf-slot-count eb)))
    (IWhile c b (icnf-add2 (icnf-slot-count c) (icnf-slot-count b)))
    (ISet d87 v (icnf-slot-count v))
    (ILet d88 v b (+ 1 (icnf-add2 (icnf-slot-count v) (icnf-slot-count b))))
    (ISeq es (icnf-count-slots-list es))
    (IVariant d89 d90 fields (icnf-count-slots-list fields))
    (IMatch scr arms (icnf-add2 (icnf-slot-count scr) (icnf-count-arm-slots arms)))))

(defn icnf-count-slots-list (xs)
  (if (is-nil xs)
    0
    (icnf-add2 (icnf-slot-count (hd-icnf xs)) (icnf-count-slots-list (tl2 xs)))))

(defn icnf-count-arm-slots (arms)
  (if (is-nil arms)
    0
    (icnf-arm-slots (hd-ia arms) (tl2 arms))))

(defn icnf-arm-slots (arm rest)
  ; binops never combine two direct calls here (constraint 8).
  (match arm
    (IArm d91 d92 binds body
      (icnf-add2 (icnf-binds-slots binds 0)
                 (icnf-add2 (icnf-slot-count body) (icnf-count-arm-slots rest))))))

; Count of non-wildcard pattern binds (each gets exactly one slot).
(defn icnf-binds-slots (binds acc)
  (if (is-nil binds)
    acc
    (icnf-binds-slots (tl2 binds)
                      (+ acc (icnf-bind-real (shd binds))))))

(defn icnf-bind-real (b)
  ; exact "_" (length 1, byte '_') gets no slot in cg-bind-one
  (if (= (alloc-strlen b) 1)
    (if (= (byte-at b 0) 95) 0 1)
    1))

(defn icnf-count-arms (xs)
  (if (is-nil xs)
    0
    (icnf-arm-size (hd-ia xs) (tl2 xs))))

(defn icnf-arm-size (arm rest)
  ; Match-arm bodies must contain at most ONE call (see icnf-add2 note);
  ; nest the sum through helpers.
  (match arm
    (IArm d65 d66 d67 body
      (icnf-add2 1 (icnf-add2 (icnf-size body) (icnf-count-arms rest))))))

(defn cg-function (st f)
  (match f
    (IFn name params body
     (let env (cg-param-env params 0 (EnvNil))
       ; Frame sized from actual slot usage: param slots + one per ILet /
       ; non-wildcard pattern bind (+ headroom), rounded to 16 bytes.
       ; The old uniform 16*(64+icnf-size) wasted ~16x stack.
       (let nslots (icnf-add2 (list-length params)
                              (+ (icnf-slot-count body) 8))
         ; 16*(1 + ns/2) >= 8*ns and stays 16-byte aligned
         (let fsz (* 16 (+ 1 (/ nslots 2)))
          (let st1 (cg-emit st "f_")
           (let st2 (cg-emit st1 (ffi-call "zyl_cstr_sanitize" (cg-arena-of st) name 1000))
             (let st3 (cg-emit-line st2 ":")
               (let st4 (cg-emit-line st3 "    push rbp")
                 (let st5 (cg-emit-line st4 "    mov rbp, rsp")
                   (let st6 (cg-emit st5 "    sub rsp, ")
                     (let st7 (cg-nl (cg-emit-int st6 fsz))
                       (let st8 (cg-param-spills st7 0 (list-length params))
                         ; per-function slot counter reset after params
                         (let st9 (cg-reset-slots st8 (* 8 (+ 1 (list-length params))))
                            (let st10 (cg-expr st9 env body)
                              (let st11 (cg-emit-line st10 "    mov rsp, rbp")
                                (let st12 (cg-emit-line st11 "    pop rbp")
                                  (cg-emit-line st12 "    ret")))))))))))))))))))

(defn cg-reset-slots (st next-off)
  (match st
    (CGS a b n d69 rd fns (CGS a b n next-off rd fns))))

; Immutable param environment: param i -> offset -(8*(i+1)).
(defn cg-param-env (params i acc)
  (if (is-nil params)
    acc
    (cg-param-env (tl2 params) (+ i 1)
                  (EnvBind (shd params) (- (* 8 (+ i 1))) 0 acc))))

; Spill incoming args to param slots: indices 0..5 from SysV registers,
; indices >= 6 from the caller's stack frame ([rbp+16] is stack arg 6).
(defn cg-param-spills (st i n)
  (if (>= i n)
    st
    (if (< i 6)
      (cg-param-spill-reg st i n)
      (cg-param-spill-stack st i n))))

(defn cg-param-spill-reg (st i n)
  (let st2 (cg-emit st "    mov [rbp")
    (let st3 (cg-emit-int st2 (- (* 8 (+ i 1))))
      (let st4 (cg-emit st3 "], ")
        (let st5 (cg-emit st4 (cg-reg-of i))
          (cg-param-spills (cg-nl st5) (+ i 1) n))))))

(defn cg-param-spill-stack (st i n)
  (let st2 (cg-emit st "    mov r10, [rbp+")
    (let st3 (cg-emit-int st2 (+ 16 (* 8 (- i 6))))
      (let st4 (cg-emit st3 "]")
        (let st5 (cg-nl st4)
          (let st6 (cg-emit st5 "    mov [rbp")
            (let st7 (cg-emit-int st6 (- (* 8 (+ i 1))))
              (let st8 (cg-emit st7 "], r10")
                (cg-param-spills (cg-nl st8) (+ i 1) n)))))))))

; Emit the whole program: header, functions, entry stub, format strings,
; rodata. Functions are emitted in lowering order (source order); the
; entry stub calls f_main, which the lowering guarantees exists.
; Returns: final CGState (retrieve the buffer with cg-buffer).
; Record every top-level defn name so function-value references
; (higher-order arguments) resolve to addresses.
(defn cg-collect-fnnames (st fns)
  (if (is-nil fns)
    st
    (cg-collect-one st (fnhead-if fns) (tl2 fns))))

; Head of a List(IFunc); empty placeholder when exhausted.
(defn fnhead-if (xs)
  (list-head-or xs (IFn "" Nil (IConst 0))))

(defn cg-collect-one (st f rest)
  (match f
    (IFn nm d78 d79 (cg-collect-fnnames (cg-with-fnname st nm) rest))))

(defn cg-program (st fns)
  (let st0 (cg-collect-fnnames st fns)
    (cg-program-run st0 fns)))

(defn cg-program-run (st fns)
  (let st1 (cg-header st)
    (let st2 (cg-functions st1 fns)
      (let st3 (cg-entry-stub st2)
        (let st4 (cg-format-strings st3)
          (cg-rodata-emit-list st4 (cg-reverse-rodata (cg-rodata-of st4))))))))

; Reverse the collected rodata list so entries emit in creation order.
(defn cg-reverse-rodata (xs)
  (cg-rev-acc xs (no-rentries)))

(defn cg-rev-acc (xs acc)
  (match xs
    (Nil acc)
    (Cons h t (cg-rev-acc t (Cons h acc)))))

(defn cg-header (st)
  (let st1 (cg-emit-line st ".intel_syntax noprefix")
    (let st2 (cg-emit-line st1 ".text")
      (cg-emit-line st2 ".globl main"))))

(defn cg-entry-stub (st)
  ; Run user main on a big-stack worker thread (C runtime helper): the
  ; self-hosted compiler recurses deeply while parsing large inputs.
  (let st1 (cg-emit-line st "main:")
    (let st2 (cg-emit-line st1 "    push rbp")
      (let st3 (cg-emit-line st2 "    mov rbp, rsp")
        (let st4 (cg-emit-line st3 "    lea rdi, [rip+f_main]")
          (let st5 (cg-emit-line st4 "    call zyl_call_on_big_stack")
            (let st6 (cg-emit-line st5 "    xor eax, eax")
              (let st7 (cg-emit-line st6 "    pop rbp")
                (let st8 (cg-emit-line st7 "    ret")
                  st8)))))))))

(defn cg-format-strings (st)
  (let st1 (cg-emit-line st ".section .rodata")
    (let st2 (cg-emit-line st1 ".Lfmtd:")
      (let st3 (cg-emit-line st2 "    .string \"%d\\n\"")
        (let st4 (cg-emit-line st3 ".Lfmtf:")
          (let st5 (cg-emit-line st4 "    .string \"%f\\n\"")
            (let st6 (cg-emit-line st5 ".Lfmts:")
              (cg-emit-line st6 "    .string \"%s\\n\""))))))))

(defn cg-dbg (msg)
  (let f (file-open "/tmp/dbg2" "a")
    (let d1 (file-write f msg)
      (file-close f))))

(defn cg-functions (st fns)
  (if (is-nil fns)
    st
    (cg-functions-step st (fh-if fns) (tl2 fns))))

(defn cg-functions-step (st f rest)
  (match f
    (IFn nm params body
      (cg-functions-go st nm f rest))))

(defn cg-functions-go (st nm f rest)
  (cg-functions (cg-function st f) rest))

; Emit one rodata entry.
(defn cg-rodata-entry (st e)
  (match e
    (REntry lbl text kind
      (if (= kind 0)
        (cg-str-entry st lbl text)
        (cg-flt-entry st lbl text)))))

; Escape a string for a .string directive: backslash and quote doubled,
; everything else copied verbatim. Deterministic left-to-right.
(defn cg-escape (arena s)
  (let n (alloc-strlen s)
    (cg-esc-loop arena s n 0 (arena-alloc-zeroed arena (+ (* 2 n) 1)))))

(defn cg-esc-loop (arena s n i out)
  (if (>= i n)
    out
    (cg-esc-ch arena s n i out (byte-at s i))))

(defn cg-esc-ch (arena s n i out c)
  (if (= c 92)
    (cg-esc-both arena s n i out c)
    (if (= c 34)
      (cg-esc-quote arena s n i out c)
      (if (= c 10)
        (cg-esc-newline arena s n i out)
        (cg-esc-one arena s n i out c)))))

(defn cg-esc-one (arena s n i out c)
  (begin
    (buf-append out (sub-str arena s i 1))
    (cg-esc-loop arena s n (+ i 1) out)))

(defn cg-esc-both (arena s n i out c)
  (begin
    (buf-append out (sub-str arena s i 1))
    (buf-append out (sub-str arena s i 1))
    (cg-esc-loop arena s n (+ i 1) out)))

(defn cg-esc-quote (arena s n i out c)
  (begin
    (buf-append out (str-intern arena "\\"))
    (buf-append out (sub-str arena s i 1))
    (cg-esc-loop arena s n (+ i 1) out)))

(defn cg-esc-newline (arena s n i out)
  (begin
    (buf-append out (str-intern arena "\\"))
    (buf-append out (str-intern arena "n"))
    (cg-esc-loop arena s n (+ i 1) out)))

(defn cg-str-entry (st lbl content)
  (let st2 (cg-label-def st lbl)
    (let st4 (cg-emit st2 "    .string \"")
      (let st5 (cg-emit st4 (cg-escape (cg-arena-of st) content))
        (cg-nl (cg-emit st5 "\""))))))

; Emit "<label>:" on one line.
(defn cg-label-def (st lbl)
  (cg-nl (cg-emit (cg-emit st lbl) ":")))

(defn cg-flt-entry (st lbl text)
  (let st2 (cg-label-def st lbl)
    (let st4 (cg-emit st2 "    .double ")
      (cg-nl (cg-emit st4 text)))))

(defn cg-rodata-emit-list (st xs)
  (match xs
    (Nil st)
    (Cons e rest
      (let st2 (cg-rodata-entry st e)
        (cg-rodata-emit-list st2 rest)))))
; ===========================================================================
; TYPED LIST HEADS/TAILS (total via fallback values)
; ===========================================================================

; Shared polymorphic list head (constraint 6 lifted: per-site generic
; inference makes one shared helper safe across element types).
(defn list-head-or (xs default)
  (match xs
    (Cons a d70 a)
    (Nil default)))

(defn ih-ic (xs)
  (list-head-or xs (IConst 0)))

(defn fh-if (xs)
  (list-head-or xs (IFn "" Nil (IConst 0))))

(defn shd (xs)
  (match xs
    (Cons s d72 s)
    (Nil "")))

(defn hd-ia (xs)
  (list-head-or xs (IArm "" -1 Nil (IConst 0))))

; Head of a list of Icnf nodes (distinct from hd-ia: IArm lists).
(defn hd-icnf (xs)
  (match xs
    (Cons a d74a a)
    (Nil (IConst 0))))

(defn cg-arena-of (st)
  (match st
    (CGS a d74 d75 d76 d77 d78 a)))

(defn tl2 (xs)
  (match xs
    (Cons a rest rest)
    (Nil Nil)))

; ---------- stdlib/compiler/region_inference.zyl ----------
; === Zyl Standard Library — Region Inference Engine ===
; Module: compiler/region_inference
; Provides: Region inference (spec §9.1 rules R1-R8) + capture analysis
; Works on Icnf instructions (compiler/icnf.zyl)
;
; Two-pass algorithm:
;   Pass 1 (ri-collect-defs): gather function signatures + struct regions
;   Pass 2 (ri-infer-expr): analyze each expression, assign regions

; ===========================================================================
; REGION ADT — spec §9.1 (R1-R8)
; ===========================================================================

(deftype Region RStack RHeap RGlobal RCircular RPin)

(deftype CaptureInfo (CI (List String) (List (Pair String Region))))

; ===========================================================================
; REGION ENVIRONMENT — scoped bindings: name → (region, escaped?)
; ===========================================================================

(deftype RE (RE (List RegionBind) (List (List RegionBind))))
(deftype RegionBind (RB String Region Bool))

; RegionEnv wraps RE for clarity; constructors access RE fields directly.
(defn RegionEnv (cur parents)
  (RE cur parents))

(defn (RE.cur self)
  (match self
    ((RE c _) c)))

(defn (RE.parens self)
  (match self
    ((RE _ p) p)))

; ===========================================================================
; REGION INFERENCE RESULTS
; ===========================================================================

(deftype RegionResult (RR Region (Option CaptureInfo)))

(deftype RegionInferer (RI RegionEnv (List StructRegion) (List FuncSig)))

; ===========================================================================
; STRUCT / FUNCTION SIGNATURE HELPERS
; ===========================================================================

(deftype StructRegion (SR String (List VariantRegion)))
(deftype VariantRegion (VR String (List FieldRegion)))
(deftype FieldRegion (FR String Region))
(deftype FuncSig (FS String (List Region) Region))

; ===========================================================================
; REGION ENVIRONMENT HELPERS
; ===========================================================================

(defn env-new ()
  (RE Nil Nil))
(defn env-get (env name)
  (env-get-cur (RE.cur env) name))
(defn env-get-cur (binds name)
  (match binds
    (Nil (env-get-parents (RE.parens env) name))
    ((RB n r esc) rest
      (if (= (str-eq n name) 0)
        (Some (Pair r esc))
        (env-get-cur rest name)))))
(defn env-get-parents (parents name)
  (match parents
    (Nil None)
    ((Cons scope rest)
      (env-get-binds scope name))
    (Nil None)))
(defn env-get-binds (binds name)
  (match binds
    (Nil None)
    ((RB n r esc) rest
      (if (= (str-eq n name) 0)
        (Some (Pair r esc))
        (env-get-binds rest name)))))
(defn env-is-escaped (env name)
  (match (env-get env name)
    (Some (Pair r esc) (if esc 1 0))
    (None 0)))
(defn env-bind (env name region)
  (RegionEnv (Cons (RB name region 0) (RE.cur env)) (RE.parens env)))
(defn env-contains (env name)
  (if (= (env-contains-cur (RE.cur env) name) 1)
    1
    (env-contains-parents (RE.parens env))))
(defn env-contains-cur (binds name)
  (match binds
    (Nil 0)
    ((RB n _ _) rest
      (if (= (str-eq n name) 0) 1 (env-contains-cur rest name)))))
(defn env-contains-parents (parents)
  (env-contains-parents-inner parents))
(defn env-contains-parents-inner (parents)
  (match parents
    (Nil 0)
    ((Cons scope rest)
      (if (= (env-contains-cur scope) 1) 1
        (env-contains-parents-inner rest)))
    (Nil 0)))
(defn env-escape (env name)
  (if (= (env-contains-cur (RE.cur env) name) 1)
    (env-escape-cur (RE.cur env) name (RE.parens env))
    (env-escape-parents (RE.parens env) name)))
(defn env-escape-cur (binds name parens)
  (env-escape-cur-inner binds name parens Nil 0))
(defn env-escape-cur-inner (binds name parens accum found)
  (match binds
    (Nil (if (= found 1)
            (RegionEnv Nil (list-reverse accum))
            (env-escape-parents parens name)))
    ((RB n r esc) rest
      (if (= (str-eq n name) 0)
        (RegionEnv (list-reverse (Cons (RB n r 1) accum)) parens)
        (env-escape-cur-inner rest name parens
          (Cons (RB n r esc) accum) found)))))
(defn env-escape-parents (parents name)
  (env-escape-parents-inner parents name Nil))
(defn env-escape-parents-inner (parents name depth)
  (match parents
    (Nil (RegionEnv Nil Nil))
    ((Cons scope rest)
      (let (esc new-scope) (env-escape-scope scope name)
        (if (= esc 1)
          (RegionEnv (Cons scope new-scope) (RE.parens (RegionEnv Nil new-scope)))
          (if (= (length rest) 0)
            (RegionEnv (Cons scope Nil) (RE.parens (RegionEnv Nil Nil)))
            (env-escape-parents-inner rest name (Cons depth Nil)))))
    (Nil (RegionEnv Nil Nil))))
(defn env-escape-scope (scope name)
  (env-escape-scope-inner scope name Nil 0))
(defn env-escape-scope-inner (scope name accum found)
  (match scope
    (Nil (Pair found Nil))
    ((Cons (RB n r esc) rest)
      (if (= (str-eq n name) 0)
        (let new-r (if (= r RStack) RHeap r)
          (Pair 1 (list-reverse (Cons (RB n new-r 1) accum))))
        (env-escape-scope-inner rest name
          (Cons (RB n r esc) accum) found)))))
(defn env-enter (env)
  (RegionEnv Nil (Cons (RE.cur env) (RE.parens env))))
(defn env-exit (env)
  (match (Pair (RE.cur env) (RE.parens env))
    (Pair current parens
      (if (= (length current) 0)
        (RegionEnv Nil parens)
        (if (= (length parens) 0)
          (RegionEnv current parens)
          (env-merge-into-last current parens))))))
(defn env-merge-into-last (current parens)
  (match parens
    (Nil (RegionEnv current parens))
    ((Cons last rest)
      (RegionEnv Nil (Cons (env-merge-binds current last) rest)))))
(defn env-merge-binds (incoming outer)
  (env-merge-binds-loop incoming outer Nil))
(defn env-merge-binds-loop (incoming outer acc)
  (match incoming
    (Nil (env-add-remaining outer acc))
    ((Cons bind rest)
      (match bind
        ((RB n r esc)
          (if (= esc 1)
            (env-merge-binds-loop rest outer acc)
            (if (= (env-list-has outer n) 1)
              (env-merge-binds-loop rest outer acc)
              (env-merge-binds-loop rest outer (Cons bind acc)))))))))
(defn env-list-has (binds name)
  (match binds
    (Nil 0)
    ((Cons (RB n _ _) rest)
      (if (= (str-eq n name) 0) 1 (env-list-has rest name)))))
(defn env-add-remaining (binds acc)
  (match binds
    (Nil acc)
    ((Cons bind rest) (env-add-remaining rest (Cons bind acc)))))
(defn env-snapshot (env)
  (RegionEnv (RE.cur env) (RE.parens env)))
(defn env-bindings (env)
  (env-bindings-cur (RE.cur env) (env-bindings-parents (RE.parens env))))
(defn env-bindings-cur (binds names)
  (match binds
    (Nil names)
    ((Cons (RB n _ _) rest)
      (if (= (env-names-has names n) 1)
        (env-bindings-cur rest names)
        (env-bindings-cur rest (Cons n names))))))
(defn env-names-has (names name)
  (match names
    (Nil 0)
    ((Cons h rest) (if (= (str-eq h name) 0) 1 (env-names-has rest name)))))
(defn env-bindings-parents (parents)
  (match parents
    (Nil Nil)
    ((Cons scope rest)
      (env-bindings-cur scope (env-bindings-parents rest)))))
(deftype StructRegion (SR String (List VariantRegion)))
(deftype VariantRegion (VR String (List FieldRegion)))
(deftype FieldRegion (FR String Region))

(deftype FuncSig (FS String (List Region) Region))

(deftype RegionInferer (RI RegionEnv (List StructRegion) (List FuncSig)))

(defn ri-new ()
  (RegionInferer (env-new) Nil Nil))

(defn ri-union-regions (a b)
  (match (Pair a b)
    (Pair RGlobal _) RGlobal
    (Pair _ RGlobal RGlobal)
    (Pair RHeap RCircular) RHeap
    (Pair RCircular RHeap) RHeap
    (Pair RHeap _) RHeap
    (Pair _ RHeap RHeap)
    (Pair RPin RStack) RPin
    (Pair RStack RPin) RPin
    (Pair _ _) (if (>= (region-rank a) (region-rank b)) a b)))

(defn region-rank (r)
  (match r
    (RStack 0)
    (RPin 1)
    (RHeap 2)
    (RCircular 3)
    (RGlobal 4)))

(defn ri-is-literal-const (ic)
  (match ic
    (IConst _ 1)
    (IStr _ 1)
    (IFlt _ 1)
    (ILoad _ 0)
    (IBinop d5 a b (if (= (ri-is-literal-const a) 1)
                      (ri-is-literal-const b)
                      0))
    (ICall d6 args (ri-is-literal-icnf-list args))
    (IFfi d7 args (ri-is-literal-icnf-list args))
    (IPrint d (ri-is-literal-const d))
    (IIf c t e (if (= (ri-is-literal-const c) 1)
                  (if (= (ri-is-literal-const t) 1)
                    (ri-is-literal-const e)
                    0)
                  0))
    (IWhile _ _ 0)
    (ISet _ _ 0)
    (ILet d14 val body
      (if (= (ri-is-literal-const val) 1)
        (ri-is-literal-const body)
        0))
    (ISeq d15 (ri-is-literal-icnf-list d15))
    (IVariant d16 _ d18 (ri-is-literal-icnf-list d18))
    (IMatch d19 scr arms
      (if (= (ri-is-literal-const scr) 1)
        (ri-is-literal-arms arms)
        0))
    (IFn d20 d21 d22 (ri-is-literal-const d22))))

(defn ri-is-literal-icnf-list (icnfs)
  (match icnfs
    (Nil 1)
    ((Cons h rest) (if (= (ri-is-literal-const h) 1)
                     (ri-is-literal-icnf-list rest)
                     0))))

(defn ri-is-literal-arms (arms)
  (match arms
    (Nil 1)
    ((Cons arm rest)
      (match arm
        ((IArm _ _ _ body)
          (if (= (ri-is-literal-const body) 1)
            (ri-is-literal-arms rest)
            0)))
      0)))

(defn ri-analyze-captures (outer-env ic)
  (ri-capture-collect ic outer-env Nil))

(defn ri-capture-collect (ic captured-refs env)
  (match ic
    (ILoad name
      (if (= (env-contains env name) 1)
        (ri-capture-add name (env-get env name) captured-refs)
        captured-refs))
    (IBinop d1 a b (ri-capture-collect a
      (ri-capture-collect b captured-refs env)
      env))
    (ICall d2 args (ri-capture-collect-list args captured-refs env))
    (IFfi d3 args (ri-capture-collect-list args captured-refs env))
    (IPrint d (ri-capture-collect d captured-refs env))
    (IIf c t e
      (ri-capture-collect e
        (ri-capture-collect t
          (ri-capture-collect c captured-refs env)
          env)
        env))
    (IWhile c b
      (ri-capture-collect b
        (ri-capture-collect c captured-refs env)
        env))
    (ISet d10 val
      (if (= (env-contains env d10) 1)
        (ri-capture-add d10 (env-get env d10)
          (ri-capture-collect val captured-refs env))
        (ri-capture-collect val captured-refs env)))
    (ILet d11 val body
      (let new-env (env-bind env d11 RStack)
        (ri-capture-collect body captured-refs new-env)))
    (ISeq items (ri-capture-collect-list items captured-refs env))
    (IVariant d12 d13 args (ri-capture-collect-list args captured-refs env))
    (IMatch d14 scr arms
      (ri-capture-collect-arms arms
        (ri-capture-collect scr captured-refs env)
        env))
    (IFn d15 d16 body
      (ri-capture-collect body captured-refs env))))

(defn ri-capture-collect-list (icnfs acc env)
  (match icnfs
    (Nil acc)
    ((Cons h rest)
      (ri-capture-collect-list rest
        (ri-capture-collect h acc env)
        env))))

(defn ri-capture-add (name get-result acc)
  (match get-result
    (Some (Pair r esc)
      (if (= (ri-capture-list-has acc name) 1)
        acc
        (Cons (Pair name r) acc)))
    (None acc)))

(defn ri-capture-list-has (refs name)
  (match refs
    (Nil 0)
    ((Cons (Pair n _) rest)
      (if (= (str-eq n name) 0) 1 (ri-capture-list-has rest name)))))

(defn ri-capture-collect-arms (arms acc env)
  (match arms
    (Nil acc)
    ((Cons arm rest)
      (match arm
        ((IArm _ _ binds body)
          (let arm-env (ri-bind-params binds env RStack)
            (ri-capture-collect-arms rest
              (ri-capture-collect body acc arm-env)
              env))))))

(defn ri-bind-params (params env region)
  (match params
    (Nil env)
    ((Cons name rest)
      (ri-bind-params rest (env-bind env name region) region)))

(deftype RegionResult (RR Region (Option CaptureInfo)))

(defn ri-infer-expr (ri ic)
  (match ic
    (IConst _ (RR RStack None))
    (IStr _ (RR RHeap None))
    (IFlt _ (RR RHeap None))
    (ILoad name
      (match (env-get (RI.env ri) name)
        (Some (Pair r esc) (RR r None))
        (None (RR RStack None))))
    (IBinop d4 left right
      (let lr (ri-infer-expr ri left)
        (let rr (ri-infer-expr ri right)
          (RR (ri-union-regions (RR.reg lr) (RR.reg rr)) None))))
    (ICall d5 args
      (ri-infer-args ri args)
      (RR RHeap None))
    (IFfi d6 args
      (ri-infer-args ri args)
      (RR RPin None))
    (IPrint d7
      (ri-infer-expr ri d7)
      (RR RStack None))
    (IIf d8 cond then_ else_
      (ri-infer-expr ri cond)
      (let tr (ri-infer-expr ri then_)
        (let er (ri-infer-expr ri else_)
          (RR (ri-union-regions (RR.reg tr) (RR.reg er)) None))))
    (IWhile d9 cond body
      (ri-infer-expr ri cond)
      (ri-infer-expr ri body))
    (ISet d10 name val
      (let vr (ri-infer-expr ri val)
        (if (= (env-contains (RI.env ri) name) 0)
          (RR RStack None)
          (RR (RR.reg vr) None))))
    (ILet d11 name val body
      (let env0 (RI.env ri)
        (let _ (ri-infer-expr ri val)
          (let env1 (env-enter env0)
            (let env2 (env-bind env1 name RStack)
              (let ri2 (RegionInferer (RI env2 (RI.sr ri) (RI.fs ri)))
                (let result (ri-infer-expr ri2 body)
                  (let env3 (RI.env ri2)
                    (let env4 (env-exit env3)
                      (RegionInferer (RI env4 (RI.sr ri) (RI.fs ri)))
                      result)))))))))
    (ISeq d12 items
      (ri-infer-seq ri items))
    (IVariant d13 d14 d15
      (ri-infer-args ri d15)
      (RR RHeap None))
    (IMatch d16 scrutinee arms
      (ri-infer-expr ri scrutinee)
      (ri-infer-match-arms ri arms (RR RStack None)))
    (IFn d17 name params body
      (let env0 (RI.env ri)
        (let env1 (env-enter env0)
          (let env2 (ri-bind-params params env1 RStack)
            (let ri2 (RegionInferer (RI env2 (RI.sr ri) (RI.fs ri)))
              (let _ (ri-infer-expr ri2 body)
                (let env3 (RI.env ri2)
                  (let env4 (env-exit env3)
                    (RegionInferer (RI env4 (RI.sr ri) (RI.fs ri)))
                    (RR RHeap None))))))))))

(defn ri-infer-args (ri icnfs)
  (ri-infer-args-loop ri icnfs RStack))

(defn ri-infer-args-loop (ri args region)
  (match args
    (Nil region)
    ((Cons ic rest)
      (ri-infer-args-loop rest
        (ri-union-regions region (RR.reg (ri-infer-expr ri ic)))
        region))))

(defn ri-infer-seq (ri items)
  (ri-infer-seq-loop ri items (RR RStack None)))

(defn ri-infer-seq-loop (ri items result)
  (match items
    (Nil result)
    ((Cons ic rest)
      (ri-infer-seq-loop rest
        (ri-infer-expr ri ic)
        result))))

(defn ri-infer-match-arms (ri arms acc)
  (match arms
    (Nil acc)
    ((Cons arm rest)
      (match arm
        ((IArm _ _ binds body)
          (let env0 (RI.env ri)
            (let env1 (env-enter env0)
              (let env2 (ri-bind-params binds env1 RStack)
                (let ri2 (RegionInferer (RI env2 (RI.sr ri) (RI.fs ri)))
                  (let arm-result (ri-infer-expr ri2 body)
                    (let env3 (RI.env ri2)
                      (let env4 (env-exit env3)
                        (let new-acc (RR
                          (ri-union-regions
                            (RR.reg acc)
                            (RR.reg arm-result))
                          None)
                        (ri-infer-match-arms
                          (RegionInferer (RI env4 (RI.sr ri) (RI.fs ri)))
                          rest
                          new-acc))))))))))

(defn ri-collect-defs (ri items)
  (ri-collect-defs-loop ri items))

(defn ri-collect-defs-loop (ri items)
  (match items
    (Nil ri)
    ((Cons ic rest)
      (let ri2 (ri-collect-one ic ri)
        (ri-collect-defs-loop ri2 rest)))))

(defn ri-collect-one (ic ri)
  (match ic
    (IFn d1 name params body
      (let param-regions (ri-make-param-regions (length params))
        (let fsig (FS name param-regions RHeap)
          (ri-add-func-sig ri name fsig))))
    (IVariant d2 name d3 args
      (let field-regions (SR name
        (Cons (VR "default"
          (ri-make-field-regions args Nil)) Nil)))
      (ri-add-struct-region ri field-regions))
    (ISeq d4
      (ri-collect-defs-loop ri d4))))

(defn ri-make-param-regions (count)
  (ri-make-param-regions-loop count Nil))

(defn ri-make-param-regions-loop (count acc)
  (if (= count 0)
    (list-reverse acc)
    (ri-make-param-regions-loop (- count 1)
      (Cons RStack acc))))

(defn ri-make-field-regions (args acc)
  (match args
    (Nil acc)
    ((Cons _ rest)
      (ri-make-field-regions rest
        (Cons (FR "" RStack) acc)))))

(defn ri-add-func-sig (ri name fsig)
  (let fs (RI.fs ri)
    (if (ri-func-sig-exists fs name)
      ri
      (RegionInferer (RI (RI.env ri) (RI.sr ri)
        (Cons (FS name (FS.params fsig) (FS.ret fsig)) fs)))))

(defn ri-func-sig-exists (sigs name)
  (match sigs
    (Nil 0)
    ((Cons (FS n _ _) rest)
      (if (= (str-eq n name) 0) 1 (ri-func-sig-exists rest name)))))

(defn ri-add-struct-region (ri sr)
  (let srlist (RI.sr ri)
    (if (ri-sr-exists srlist (SR.name sr))
      ri
      (RegionInferer (RI (RI.env ri) (Cons sr srlist) (RI.fs ri)))))

(defn ri-sr-exists (srs name)
  (match srs
    (Nil 0)
    ((Cons (SR n _) rest)
      (if (= (str-eq n name) 0) 1 (ri-sr-exists rest name)))))

(defn ri-infer (icnf-list ri)
  (let ri2 (ri-collect-defs ri icnf-list)
    (if (= (length icnf-list) 0)
      ri2
      (ri-infer-expressions ri2 icnf-list))))

(defn ri-infer-expressions (ri items)
  (match items
    (Nil ri)
    ((Cons ic rest)
      (let ri2 (ri-infer-expr ri ic)
        (ri-infer-expressions ri2 rest)))))

; ---------- selfhost/driver.zyl ----------
; === Zyl Self-Hosting Boot Driver ===
; Reads Zyl source, lowers it to ICNF, emits x86_64 assembly.
; Boot input/output paths are fixed for stage1 determinism.







(defn dbg-log (msg)
  (let f (file-open "/tmp/dbg" "a")
    (let d1 (file-write f msg)
      (file-close f))))

(defn emit-out (arena fns)
  (let st (cg-program (cg-new arena) fns)
    (let buf (cg-buffer st)
      (let blen (alloc-strlen buf)
        ; Guard: buffer capacity is 64MB; refuse to write anything that
        ; came within 1MB of it (silent arena corruption otherwise).
        (if (> blen 66060288)
          (ffi-call "f_error" "E_CODEGEN_BUFFER_FULL: generated assembly exceeded the codegen buffer" 1000)
          (let out (file-open "/tmp/zyl_boot_out.s" "w")
            (let n (file-write out buf)
              (let d3 (file-close out)
                n))))))))

(defn boot-run (arena fd)
  (let srcbuf (file-read fd 1048576)
    (let d2 (file-close fd)
      (dbg-log "parse\n")
      (let prog (zyl-parse arena srcbuf)
        (dbg-log "lower\n")
        (let fns (ic-program arena prog)
          (dbg-log "codegen\n")
          (emit-out arena fns))))))

(defn main ()
  (let arena (arena-create 1073741824)
    (let fd (file-open "/tmp/zyl_boot_in.zyl" "r")
      (if (> fd 0)
        (boot-run arena fd)
        (begin
          (dbg-log "no input\n")
          1)))))

