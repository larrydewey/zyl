        IWhile
        (
          ic-expr arena c vt
        )
        (
          ic-expr arena body vt
        )
      )
    )
    (
      ESetBang name val
      (
        ISet
        (
          str-intern arena name
        )
        (
          ic-expr arena val vt
        )
      )
    )
    (
      EBegin exprs
      (
        ISeq
        (
          ic-expr-list arena exprs vt
        )
      )
    )
    (
      EFileOpen path mode
      (
        IFfi
        "zyl_file_open_c"
        (
          Cons
          (
            ic-expr arena path vt
          )
          (
            Cons
            (
              ic-expr arena mode vt
            )
            Nil
          )
        )
      )
    )
    (
      EFileRead h c
      (
        IFfi
        "zyl_file_read_c"
        (
          Cons
          (
            ic-expr arena h vt
          )
          (
            Cons
            (
              ic-expr arena c vt
            )
            Nil
          )
        )
      )
    )
    (
      EFileWrite h d
      (
        IFfi
        "zyl_file_write_c"
        (
          Cons
          (
            ic-expr arena h vt
          )
          (
            Cons
            (
              ic-expr arena d vt
            )
            Nil
          )
        )
      )
    )
    (
      EFileClose h
      (
        IFfi
        "zyl_file_close_c"
        (
          Cons
          (
            ic-expr arena h vt
          )
          Nil
        )
      )
    )
    (
      EPrint exprs
      (
        ic-print arena exprs vt
      )
    )
    (
      EMatch subj arms
      (
        ic-match arena subj arms vt
      )
    )
    (
      EFfiCall sym args d1
      (
        IFfi sym
        (
          ic-expr-list arena args vt
        )
      )
    )
    (
      EAssertEqual l r
      (
        IIf
        (
          IBinop 9
          (
            ic-expr arena l vt
          )
          (
            ic-expr arena r vt
          )
        )
        (
          IConst 0
        )
        (
          IFfi
          "zyl_panic"
          (
            Cons
            (
              IStr
              "assert-equal failed"
            )
            Nil
          )
        )
      )
    )
    (
      EAssertTrue e d3
      (
        IIf
        (
          ic-expr arena e vt
        )
        (
          IConst 0
        )
        (
          IFfi
          "zyl_panic"
          (
            Cons
            (
              IStr
              "assert-true failed"
            )
            Nil
          )
        )
      )
    )
    (
      EAssertFalse e d4
      (
        IIf
        (
          ic-expr arena e vt
        )
        (
          IFfi
          "zyl_panic"
          (
            Cons
            (
              IStr
              "assert-false failed"
            )
            Nil
          )
        )
        (
          IConst 0
        )
      )
    )
    (
      EStructGet se field
      (
        ic-struct-get arena se field vt
      )
    )
    (
      EFn d5 params body
      (
        ic-lambda arena params body vt
      )
    )
    (
      d2
      (
        IConst 0
      )
    )
  )
)
(
  defn ic-fresh-id
  (
    arena
  )
  (
    arena-alloc-zeroed arena 1
  )
)
(
  defn ic-digit-str
  (
    d
  )
  (
    if
    (
      = d 0
    )
    "0"
    (
      if
      (
        = d 1
      )
      "1"
      (
        if
        (
          = d 2
        )
        "2"
        (
          if
          (
            = d 3
          )
          "3"
          (
            if
            (
              = d 4
            )
            "4"
            (
              if
              (
                = d 5
              )
              "5"
              (
                if
                (
                  = d 6
                )
                "6"
                (
                  if
                  (
                    = d 7
                  )
                  "7"
                  (
                    if
                    (
                      = d 8
                    )
                    "8"
                    "9"
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
(
  defn ic-int-to-str
  (
    n
  )
  (
    if
    (
      < n 10
    )
    (
      ic-digit-str n
    )
    (
      str-concat
      (
        ic-int-to-str
        (
          / n 10
        )
      )
      (
        ic-digit-str
        (
          % n 10
        )
      )
    )
  )
)
(
  defn ic-lambda
  (
    arena params body vt
  )
  (
    let pnames
    (
      param-names params
      (
        no-strs
      )
    )
    (
      if
      (
        >
        (
          ic-safe-expr arena body pnames vt
        )
        0
      )
      (
        let lname
        (
          str-intern arena
          (
            str-concat
            "_lambda_"
            (
              ic-int-to-str
              (
                ic-fresh-id arena
              )
            )
          )
        )
        (
          IFn lname pnames
          (
            ic-expr arena body vt
          )
        )
      )
      (
        IConst 0
      )
    )
  )
)
(
  defn ic-name-in-list
  (
    name xs
  )
  (
    match xs
    (
      Nil 0
    )
    (
      Cons h t
      (
        if
        (
          >
          (
            str-eq name h
          )
          0
        )
        1
        (
          ic-name-in-list name t
        )
      )
    )
  )
)
(
  defn ic-safe-atom
  (
    atom pnames vt
  )
  (
    match atom
    (
      AIdent name
      (
        if
        (
          >
          (
            ic-name-in-list name pnames
          )
          0
        )
        1
        (
          if
          (
            >
            (
              vt-tag-of vt name
            )
            -1
          )
          1 0
        )
      )
    )
    (
      d1 1
    )
  )
)
(
  defn ic-safe-list
  (
    arena xs pnames vt
  )
  (
    match xs
    (
      Nil 1
    )
    (
      Cons h t
      (
        if
        (
          >
          (
            ic-safe-expr arena h pnames vt
          )
          0
        )
        (
          ic-safe-list arena t pnames vt
        )
        0
      )
    )
  )
)
(
  defn ic-safe-callee
  (
    arena fname pnames
  )
  (
    if
    (
      >
      (
        ic-name-in-list fname pnames
      )
      0
    )
    1
    (
      if
      (
        >
        (
          ic-op-of arena fname
        )
        -1
      )
      1 0
    )
  )
)
(
  defn ic-safe-expr
  (
    arena e pnames vt
  )
  (
    match
    (
      Expr.inner e
    )
    (
      EAtom atom
      (
        ic-safe-atom atom pnames vt
      )
    )
    (
      ECall op args
      (
        if
        (
          >
          (
            ic-safe-expr arena op pnames vt
          )
          0
        )
        (
          ic-safe-list arena args pnames vt
        )
        0
      )
    )
    (
      EApply fname args
      (
        if
        (
          >
          (
            ic-safe-callee arena fname pnames
          )
          0
        )
        (
          ic-safe-list arena args pnames vt
        )
        0
      )
    )
    (
      ELet name val body
      (
        if
        (
          >
          (
            ic-safe-expr arena val pnames vt
          )
          0
        )
        (
          ic-safe-expr arena body
          (
            Cons name pnames
          )
          vt
        )
        0
      )
    )
    (
      ELetMut name val body
      (
        if
        (
          >
          (
            ic-safe-expr arena val pnames vt
          )
          0
        )
        (
          ic-safe-expr arena body
          (
            Cons name pnames
          )
          vt
        )
        0
      )
    )
    (
      EIf c t eb
      (
        if
        (
          >
          (
            ic-safe-expr arena c pnames vt
          )
          0
        )
        (
          if
          (
            >
            (
              ic-safe-expr arena t pnames vt
            )
            0
          )
          (
            ic-safe-expr arena eb pnames vt
          )
          0
        )
        0
      )
    )
    (
      EWhile c body
      (
        if
        (
          >
          (
            ic-safe-expr arena c pnames vt
          )
          0
        )
        (
          ic-safe-expr arena body pnames vt
        )
        0
      )
    )
    (
      ESetBang name val
      (
        if
        (
          >
          (
            ic-name-in-list name pnames
          )
          0
        )
        (
          ic-safe-expr arena val pnames vt
        )
        0
      )
    )
    (
      EBegin exprs
      (
        ic-safe-list arena exprs pnames vt
      )
    )
    (
      EPrint exprs
      (
        ic-safe-list arena exprs pnames vt
      )
    )
    (
      EAssertEqual l r
      (
        if
        (
          >
          (
            ic-safe-expr arena l pnames vt
          )
          0
        )
        (
          ic-safe-expr arena r pnames vt
        )
        0
      )
    )
    (
      EAssertTrue e2 d2
      (
        ic-safe-expr arena e2 pnames vt
      )
    )
    (
      EAssertFalse e2 d3
      (
        ic-safe-expr arena e2 pnames vt
      )
    )
    (
      EStructGet se d4
      (
        ic-safe-expr arena se pnames vt
      )
    )
    (
      EFn d5 fparams fbody
      (
        ic-safe-expr arena fbody
        (
          list-append
          (
            param-names fparams
            (
              no-strs
            )
          )
          pnames
        )
        vt
      )
    )
    (
      d6 0
    )
  )
)
(
  deftype HoistAcc
  (
    HoistAcc Icnf
    (
      List Icnf
    )
  )
)
(
  deftype HoistListAcc
  (
    HoistListAcc
    (
      List Icnf
    )
    (
      List Icnf
    )
  )
)
(
  deftype HoistArmAcc
  (
    HoistArmAcc
    (
      List IArm
    )
    (
      List Icnf
    )
  )
)
(
  defn hoist-node
  (
    r
  )
  (
    match r
    (
      HoistAcc n d1 n
    )
  )
)
(
  defn hoist-fns
  (
    r
  )
  (
    match r
    (
      HoistAcc d1 f f
    )
  )
)
(
  defn hoistl-nodes
  (
    r
  )
  (
    match r
    (
      HoistListAcc n d1 n
    )
  )
)
(
  defn hoistl-fns
  (
    r
  )
  (
    match r
    (
      HoistListAcc d1 f f
    )
  )
)
(
  defn hoista-arms
  (
    r
  )
  (
    match r
    (
      HoistArmAcc a d1 a
    )
  )
)
(
  defn hoista-fns
  (
    r
  )
  (
    match r
    (
      HoistArmAcc d1 f f
    )
  )
)
(
  defn ic-hoist-list
  (
    xs
  )
  (
    match xs
    (
      Nil
      (
        HoistListAcc Nil Nil
      )
    )
    (
      Cons h t
      (
        let hh
        (
          ic-hoist h
        )
        (
          let ht
          (
            ic-hoist-list t
          )
          (
            HoistListAcc
            (
              Cons
              (
                hoist-node hh
              )
              (
                hoistl-nodes ht
              )
            )
            (
              list-append
              (
                hoist-fns hh
              )
              (
                hoistl-fns ht
              )
            )
          )
        )
      )
    )
  )
)
(
  defn ic-hoist-arms
  (
    arms
  )
  (
    match arms
    (
      Nil
      (
        HoistArmAcc Nil Nil
      )
    )
    (
      Cons a rest
      (
        match a
        (
          IArm vname tag binds body
          (
            let hb
            (
              ic-hoist body
            )
            (
              let hr
              (
                ic-hoist-arms rest
              )
              (
                HoistArmAcc
                (
                  Cons
                  (
                    IArm vname tag binds
                    (
                      hoist-node hb
                    )
                  )
                  (
                    hoista-arms hr
                  )
                )
                (
                  list-append
                  (
                    hoist-fns hb
                  )
                  (
                    hoista-fns hr
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
(
  defn ic-hoist
  (
    node
  )
  (
    match node
    (
      IConst d1
      (
        HoistAcc node Nil
      )
    )
    (
      IStr d2
      (
        HoistAcc node Nil
      )
    )
    (
      IFlt d3
      (
        HoistAcc node Nil
      )
    )
    (
      ILoad d4
      (
        HoistAcc node Nil
      )
    )
    (
      IBinop op l r
