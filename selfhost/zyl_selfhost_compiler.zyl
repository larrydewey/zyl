    )
    (
      EAtom
      (
        ABool d8 d9
      )
      (
        TPrim PBool
      )
    )
    (
      EAtom
      (
        AStr d10 d11
      )
      (
        TPrim PString
      )
    )
    (
      EAtom
      (
        AIdent name
