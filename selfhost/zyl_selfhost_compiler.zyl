              )
              (
                let
                (
                  resolved-params
                  (
                    resolve-param-types inferer params ret-type
                  )
                )
                (
                  let
                  (
                    new-inferer
                    (
                      finalize-param-types
                      (
                        TypeInferer
                        (
                          ti-env inferer
                        )
                        (
                          ti-subst inferer
                        )
                        (
                          ti-next inferer
                        )
                        (
                          ti-known-types inferer
                        )
                        resolved-params
                        (
                          ti-func-returns inferer
                        )
                        (
                          ti-adt-defs inferer
                        )
                        (
                          ti-variant-to-adt inferer
                        )
                        (
                          ti-string-match-vars inferer
                        )
                        (
                          ti-inferring-fns inferer
                        )
                        (
                          ti-body-cache inferer
                        )
                      )
                    )
                  )
                  new-inferer
