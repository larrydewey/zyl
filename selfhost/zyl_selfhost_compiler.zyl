(
  defn str-eq-cstr
  (
    a b
  )
  (
    =
    (
      ffi-call
      "strcmp"
      a b 1000
    )
    0
  )
)
(
  defn str-in-list
  (
    name xs
  )
  (
    match xs
    (
      Nil 0
    )
    (
      Cons h1 tl
      (
        if
        (
          str-eq-cstr name h1
        )
        1
        (
          str-in-list name tl
        )
      )
    )
  )
)
(
  defn form-head-name
  (
    form
  )
  (
    match form
    (
      AList kids
      (
        match kids
        (
          Cons hd tl
          (
            match hd
            (
              AIdent nm nm
            )
            (
              dh
              ""
            )
          )
        )
        (
          dk
          ""
        )
      )
    )
    (
      df
      ""
    )
  )
)
(
  defn second-ident-in
  (
    kids
  )
  (
    match kids
    (
      Cons hd tl
      (
        match tl
        (
          Cons p1 r1
          (
            match p1
            (
              AIdent nm nm
            )
            (
              dp
              ""
            )
          )
        )
        (
          dr
          ""
        )
      )
    )
    (
      dn
      ""
    )
  )
)
(
  defn form-second-ident
  (
    form
  )
  (
    match form
    (
      AList kids
      (
        second-ident-in kids
      )
    )
    (
      df2
      ""
    )
  )
)
(
  defn use-module-name
  (
    form
  )
  (
    if
    (
      str-eq-cstr
      (
        form-head-name form
      )
      "use"
    )
    (
      form-second-ident form
    )
    ""
  )
)
(
  defn def-binding-name
  (
    item
  )
  (
    let head
    (
      form-head-name item
    )
    (
      if
      (
        str-eq-cstr head
        "defn"
      )
      (
        form-second-ident item
      )
      (
        if
        (
          str-eq-cstr head
          "def"
        )
        (
          form-second-ident item
        )
        ""
      )
    )
  )
)
(
  defn file-exists
  (
    path
  )
  (
    let fd
    (
      file-open path
      "r"
    )
    (
      if
      (
        > fd 0
      )
      (
        begin
        (
          file-close fd
        )
        1
      )
      0
    )
  )
)
(
  defn find-dep-path
  (
    arena name
  )
  (
    let buf
    (
      arena-alloc-zeroed arena 512
    )
    (
      begin
      (
        buf-append buf name
      )
      (
        buf-append buf
        ".zyl"
      )
      (
        if
        (
          =
          (
            file-exists buf
          )
          1
        )
        buf
        (
          let buf2
          (
            arena-alloc-zeroed arena 640
          )
          (
            begin
            (
              buf-append buf2
              "stdlib/"
            )
            (
              buf-append buf2 name
            )
            (
              buf-append buf2
              ".zyl"
            )
            (
              if
              (
                =
                (
                  file-exists buf2
                )
                1
              )
              buf2
              ""
            )
          )
        )
      )
    )
  )
)
(
  defn read-file-src
  (
    path
  )
  (
    let fd
    (
      file-open path
      "r"
    )
    (
      if
      (
        > fd 0
      )
      (
        let src
        (
          file-read fd 1048576
        )
        (
          begin
          (
            file-close fd
          )
          src
        )
      )
      ""
    )
  )
)
(
  defn collect-use-names
  (
    items acc
  )
  (
    match items
    (
      Nil acc
    )
    (
      Cons item rest
      (
        let nm
        (
          use-module-name item
        )
        (
          if
          (
            >
            (
              alloc-strlen nm
            )
            0
          )
          (
            collect-use-names rest
            (
              Cons nm acc
            )
          )
          (
            collect-use-names rest acc
          )
        )
      )
    )
  )
)
(
  defn has-core-use
  (
    names
  )
  (
    match names
    (
      Nil 0
    )
    (
      Cons h1 tl
      (
        if
        (
          str-eq-cstr h1
          "core/core"
        )
        1
        (
          if
          (
            str-eq-cstr h1
            "core/option"
          )
          1
          (
            if
            (
              str-eq-cstr h1
              "core/result"
            )
            1
            (
              has-core-use tl
            )
          )
        )
      )
    )
  )
)
(
  defn drop-use-forms
  (
    items acc
  )
  (
    match items
    (
      Nil
      (
        list-reverse acc
      )
    )
    (
      Cons item rest
      (
        if
        (
          >
          (
            alloc-strlen
            (
              use-module-name item
            )
          )
          0
        )
        (
          drop-use-forms rest acc
        )
        (
          drop-use-forms rest
          (
            Cons item acc
          )
        )
      )
    )
  )
)
(
  defn collect-def-names
  (
    items acc
  )
  (
    match items
    (
      Nil
      (
        list-reverse acc
      )
    )
    (
      Cons item rest
      (
        let nm
        (
          def-binding-name item
        )
        (
          if
          (
            >
            (
              alloc-strlen nm
            )
            0
          )
          (
            collect-def-names rest
            (
              Cons nm acc
            )
          )
          (
            collect-def-names rest acc
          )
        )
      )
    )
  )
)
(
  defn drop-shadowed
  (
    items shadows acc
  )
  (
    match items
    (
      Nil
      (
        list-reverse acc
      )
    )
    (
      Cons item rest
      (
        let nm
        (
          def-binding-name item
        )
        (
          if
          (
            str-in-list nm shadows
          )
          (
            drop-shadowed rest shadows acc
          )
          (
            drop-shadowed rest shadows
            (
              Cons item acc
            )
          )
        )
      )
    )
  )
)
(
  defn shd
  (
    xs
  )
  (
    match xs
    (
      Cons h _ h
    )
    (
      Nil
      ""
    )
  )
)
(
  defn stl
  (
    xs
  )
  (
    match xs
    (
      Cons _ t t
    )
    (
      Nil Nil
    )
  )
)
(
  defn module-items-for
  (
    name mod-items
  )
  (
    match mod-items
    (
      Nil Nil
    )
    (
      Cons
      (
        Cons nm its
      )
      rest
      (
        if
        (
          str-eq-cstr name nm
        )
        its
        (
          module-items-for name rest
        )
      )
    )
  )
)
(
  defn resolve-program
  (
    arena items
  )
  (
    let uses0
    (
      list-reverse
      (
        collect-use-names items Nil
      )
    )
    (
      let todo0
      (
        if
        (
          =
          (
            has-core-use uses0
          )
          0
        )
        (
          Cons
          "core/core"
          uses0
        )
        uses0
      )
      (
        begin
        (
          let-mut todo todo0
        )
        (
          let-mut seen Nil
        )
        (
          let-mut done-names Nil
        )
        (
          let-mut mod-items Nil
        )
        (
          while
          (
            not
            (
              is-nil todo
            )
          )
          (
            begin
            (
              let name
              (
                shd todo
              )
              (
                begin
                (
                  set! todo
                  (
                    stl todo
                  )
                )
                (
                  if
                  (
                    =
                    (
                      str-in-list name seen
                    )
                    0
                  )
                  (
                    begin
                    (
                      set! seen
                      (
                        Cons name seen
                      )
                    )
                    (
                      let path
                      (
                        find-dep-path arena name
                      )
                      (
                        if
                        (
                          >
                          (
                            alloc-strlen path
                          )
                          0
                        )
                        (
                          begin
                          (
                            let src
                            (
                              read-file-src path
                            )
                          )
                          (
                            let its
                            (
                              zyl-parse arena src
                            )
                          )
                          (
                            begin
                            (
                              set! todo
                              (
                                list-append
                                (
                                  collect-use-names its Nil
                                )
                                todo
                              )
                            )
                            (
                              set! mod-items
                              (
                                Cons
                                (
                                  Cons name its
                                )
                                mod-items
                              )
                            )
                            (
                              set! done-names
                              (
                                Cons name done-names
                              )
                            )
                          )
                        )
                      )
                      (
                        begin
                        (
                          print
                          "zylc: module not found:"
                        )
                        (
                          print name
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
        (
          let-mut emitted Nil
        )
        (
          let-mut dn
          (
            list-reverse done-names
          )
        )
        (
          while
          (
            not
            (
              is-nil dn
            )
          )
          (
            begin
            (
              let nm
              (
                shd dn
              )
              (
                begin
                (
                  set! emitted
                  (
                    list-append emitted
                    (
                      module-items-for nm mod-items
                    )
                  )
                )
                (
                  set! dn
                  (
                    stl dn
                  )
                )
              )
            )
          )
        )
        (
          let body
          (
            drop-use-forms items Nil
          )
        )
        (
          let shadows
          (
            collect-def-names body Nil
          )
        )
        (
          list-append
          (
            drop-shadowed emitted shadows Nil
          )
          body
        )
      )
    )
  )
)
