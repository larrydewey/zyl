              )
            )
          )
        )
      )
    )
  )
)
(
  defn discover-from-ast-one
  (
    gen-fns expr
  )
  (
    match
    (
      Expr.inner expr
    )
    (
      EDefn name params body
      (
        let mp
        (
          extract-mono-params params
        )
        (
          if
          (
            >
            (
              list-length mp
            )
            0
          )
          (
            kv-set gen-fns name
            (
              list-push
              (
                kv-get gen-fns name Nil
              )
              (
                list-first mp
              )
            )
          )
          gen-fns
        )
      )
    )
    (
      EApply
      "defn"
      args
      (
        if
        (
          >
          (
            list-length args
          )
          2
        )
        (
          let n
          (
            match
            (
              ast-ident-name
              (
                list-nth args 0
              )
            )
            (
              Some v v
            )
            (
              d1 nil
            )
          )
          (
            let pexprs
            (
              ast-apply-args
              (
                list-nth args 1
              )
            )
            (
              let mp
              (
                list-map-indexed discover-mono-param pexprs
              )
              (
                if
                (
                  and n
                  (
                    >
                    (
                      list-length mp
                    )
                    0
                  )
                )
                (
                  kv-set gen-fns n
                  (
                    list-push
                    (
                      kv-get gen-fns n Nil
                    )
                    (
                      list-first mp
                    )
                  )
                )
                gen-fns
              )
            )
          )
        )
        gen-fns
      )
    )
    (
      d1 gen-fns
    )
  )
)
(
  defn discover-from-ast-loop
  (
    gen-fns exprs
  )
  (
    match exprs
    (
      Nil gen-fns
    )
    (
      Cons expr rest
      (
        discover-from-ast-loop
        (
          discover-from-ast-one gen-fns expr
        )
        rest
      )
    )
  )
)
(
  defn discover-from-ast
  (
