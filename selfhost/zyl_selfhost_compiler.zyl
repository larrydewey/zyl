(
  defn to-list
  (
    ast
  )
  (
    match ast
    (
      AList lst lst
    )
    (
      d1 Nil
    )
  )
)
(
  defn parse-defn
  (
    args
  )
  (
    match
    (
      ast-nth args 0
      (
        AstInt 0
      )
    )
    (
      AstIdent n
      (
        if
        (
          ast-has-at-least args 3
        )
        (
          Some
          (
            Expr
            (
              EDefn
              n
              (
                parse-params
                (
                  ast-nth args 1
                  (
                    AstInt 0
                  )
                )
              )
              (
                parse-body-from args 2
              )
            )
          )
        )
        None
      )
    )
    (
      d1 None
    )
  )
)
(
  defn parse-params
  (
    params
  )
  (
    match params
    (
      AList lst
      (
        match lst
        (
          Nil Nil
        )
        (
          (
            Cons p rest
          )
          (
            let hd
            (
              parse-single-param p
            )
            (
              let tl
              (
                parse-params
                (
                  AList rest
                )
              )
              (
                Cons hd tl
              )
            )
          )
        )
      )
    )
    (
      d1 Nil
    )
  )
)
(
  defn parse-single-param
  (
    p
  )
  (
    match p
    (
      AstIdent name
      (
        P name None
      )
    )
    (
      AList lst
      (
        match lst
        (
          Cons name tail
          (
            match tail
            (
              Cons typ rest
              (
                P
                (
                  a-ident-to-str name
                )
                (
                  Some
                  (
                    convert-ast typ
                  )
                )
              )
            )
            (
              d2
              (
                P
                "___"
                None
              )
            )
          )
        )
        (
          d3
          (
            P
            "___"
            None
          )
        )
      )
    )
    (
      d1
      (
        P
        "___"
        None
      )
    )
  )
)
(
  defn parse-deftype
  (
    args
  )
  (
    if
    (
      ast-has-at-least args 1
    )
    (
      match
      (
        ast-nth args 0
        (
          AstInt 0
        )
      )
      (
        AstIdent n
        (
          Some
          (
            Expr
            (
              EDeftype
              n
              (
                parse-adt-variants
                (
                  ast-list-nth-rest args 1
                )
              )
              Nil
              None
            )
          )
        )
      )
      (
        d1 None
      )
    )
    None
  )
)
(
  defn parse-defstruct
  (
    args
  )
  (
    if
    (
      ast-has-at-least args 1
    )
    (
      match
      (
        ast-nth args 0
        (
          AstInt 0
        )
      )
      (
        AstIdent n
        (
          Some
          (
            Expr
            (
              EDeftype
              n
              (
                Cons
                (
                  AV n
                  (
                    parse-struct-fields
                    (
                      ast-list-nth-rest args 1
                    )
                  )
                )
                Nil
              )
              Nil
              None
            )
          )
        )
      )
      (
        d1 None
      )
    )
    None
  )
)
(
  defn parse-struct-fields
  (
    specs
  )
  (
    match specs
    (
      Nil Nil
    )
    (
      Cons s rest
      (
        Cons
        (
          parse-struct-field-name s
        )
        (
          parse-struct-fields rest
        )
      )
    )
  )
)
(
  defn parse-struct-field-name
  (
    s
  )
  (
    match s
    (
      AstIdent n n
    )
    (
      AList lst
      (
        match lst
        (
          Cons h d1
          (
            a-ident-to-str h
          )
        )
        (
          d2
          ""
        )
      )
    )
    (
      d3
      ""
    )
  )
)
(
  defn ast-list-nth-rest
  (
    xs n
  )
  (
    if
    (
      = n 0
    )
    xs
    (
      match xs
      (
        Nil Nil
      )
      (
        Cons d1 t
        (
          ast-list-nth-rest t
          (
            - n 1
          )
        )
      )
    )
  )
)
(
  defn parse-adt-variants
  (
    variants
  )
  (
    match variants
    (
      Nil Nil
    )
    (
      (
        Cons v rest
      )
      (
        Cons
        (
          parse-adt-variant v
        )
        (
          parse-adt-variants rest
        )
      )
    )
  )
)
(
  defn parse-adt-variant
  (
    v
  )
  (
    match v
    (
      AstIdent name
      (
        AV name Nil
      )
    )
    (
      AList lst
      (
        match lst
        (
          Cons name rest
          (
            AV
            (
              a-ident-to-str name
            )
            (
              parse-field-names rest
            )
          )
        )
        (
          d2
          (
            AV
            "___"
            Nil
          )
        )
      )
    )
    (
      d1
      (
        AV
        "___"
        Nil
      )
    )
  )
)
(
  defn parse-field-names
  (
    fields
  )
  (
    match fields
    (
      Nil Nil
    )
    (
      (
        Cons f rest
      )
      (
        Cons
        (
          a-ident-to-str f
        )
        (
          parse-field-names rest
        )
      )
    )
  )
)
