    (
      Nil Nil
    )
    (
      Cons pr rest
      (
        match pr
        (
          Pair k v
          (
            kv-set
            (
              pairs-to-kv rest
            )
            k v
          )
        )
      )
    )
  )
)
(
  defn collect-instantiations
  (
    ctx name generics
  )
  (
    let pairs
    (
      collect-instantiations-bounds ctx generics
    )
    (
      if
      (
        =
        (
          list-length pairs
        )
        0
      )
      Nil
      (
        Cons
        (
          pairs-to-kv pairs
        )
        Nil
      )
    )
  )
)
(
  defn build-instance-param
  (
    p type-map
  )
  (
    if
    (
      is-uppercase-ident
      (
        P.name p
      )
    )
    (
      if
      (
        kv-contains type-map
        (
          P.name p
        )
      )
      (
        MP
        (
          P.name p
        )
        (
          Cons
          (
            type-to-string
            (
              kv-get type-map
              (
                P.name p
              )
              (
                TVar 0 TUnit
              )
            )
          )
          Nil
        )
      )
      (
        MP
        (
          P.name p
        )
        (
          match
          (
            P.type p
          )
          (
            Some v
            (
              Cons v Nil
            )
          )
          (
            d1 Nil
          )
        )
      )
    )
    (
      MP
      (
        P.name p
      )
      (
        match
        (
          P.type p
        )
        (
          Some v
          (
            Cons v Nil
          )
        )
        (
          d1 Nil
        )
      )
