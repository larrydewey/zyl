(
  defn ic-op-of
  (
    arena s
  )
  (
    if
    (
      >
      (
        str-eq s
        (
          str-intern arena
          "+"
        )
      )
      0
    )
    0
    (
      if
      (
        >
        (
          str-eq s
          (
            str-intern arena
            "-"
          )
        )
        0
      )
      1
      (
        if
        (
          >
          (
            str-eq s
            (
              str-intern arena
              "*"
            )
          )
          0
        )
        2
        (
          if
          (
            >
            (
              str-eq s
              (
                str-intern arena
                "/"
              )
            )
            0
          )
          3
          (
            if
            (
              >
              (
                str-eq s
                (
                  str-intern arena
                  "%"
                )
              )
              0
            )
            4
            (
              if
              (
                >
                (
                  str-eq s
                  (
                    str-intern arena
                    "<"
                  )
                )
                0
              )
              5
              (
                if
                (
                  >
                  (
                    str-eq s
                    (
                      str-intern arena
                      ">"
                    )
                  )
                  0
                )
                6
                (
                  if
                  (
                    >
                    (
                      str-eq s
                      (
                        str-intern arena
                        "<="
                      )
                    )
                    0
                  )
                  7
                  (
                    if
                    (
                      >
                      (
                        str-eq s
                        (
                          str-intern arena
                          ">="
                        )
                      )
                      0
                    )
                    8
                    (
                      if
                      (
                        >
                        (
                          str-eq s
                          (
                            str-intern arena
                            "=="
                          )
                        )
                        0
                      )
                      9
                      (
                        if
                        (
                          >
                          (
                            str-eq s
                            (
                              str-intern arena
                              "="
                            )
                          )
                          0
                        )
                        9
                        (
                          if
                          (
                            >
                            (
                              str-eq s
                              (
                                str-intern arena
                                "!="
                              )
                            )
                            0
                          )
                          10
                          -1
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
