    let
    (
      param-bindings
      (
        zip-params params param-types
      )
    )
    (
      let
      (
        inferred-type
        (
          infer-expr-body inferer body
        )
      )
      (
        let
        (
          new-inferer
          (
            insert-fn-ret inferer name inferred-type
          )
        )
        (
          let
          (
            new-inferer
            (
              insert-known-fn new-inferer name param-bindings
            )
          )
          new-inferer
        )
      )
    )
  )
)
(
  defn infer-expr-body
  (
    inferer body
  )
  (
