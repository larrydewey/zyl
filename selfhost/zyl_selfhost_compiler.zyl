(
  defn tlacc-push-fn
  (
    f acc
  )
  (
    match acc
    (
      TLAcc fns stmts
      (
        TLAcc
        (
          Cons f fns
        )
        stmts
      )
    )
  )
)
(
  defn tlacc-push-fns
  (
    newfns acc
  )
  (
    match newfns
    (
      Nil acc
    )
    (
      Cons f rest
      (
        tlacc-push-fns rest
        (
          tlacc-push-fn f acc
        )
      )
    )
  )
)
(
  defn tlacc-push-stmt
  (
    s acc
  )
  (
    match acc
    (
      TLAcc fns stmts
      (
        TLAcc fns
        (
          Cons s stmts
        )
      )
    )
  )
)
(
  defn ic-program
  (
    arena prog
  )
  (
    let vt
    (
      ic-collect-vt prog VTNil
    )
    (
      match
      (
        ic-toplevel arena prog vt
        (
          TLAcc
          (
            no-ifuncs
          )
          Nil
        )
      )
      (
        TLAcc fns stmts
        (
          ic-finish-program
          (
            list-reverse fns
          )
          (
            list-reverse stmts
          )
        )
      )
    )
  )
)
(
  defn ic-toplevel
  (
    arena forms vt acc
  )
  (
    match forms
    (
      Nil acc
    )
    (
      Cons e rest
      (
        match
        (
          Expr.inner e
        )
        (
          EDefn name params body
          (
            ic-toplevel arena rest vt
            (
              tlacc-push-fns
              (
                ic-defn arena name params body vt
              )
              acc
            )
          )
        )
        (
          ETestDecl name body d1
          (
            ic-toplevel arena rest vt
            (
              ic-toplevel-test arena name body vt acc
            )
          )
        )
        (
          ERunTests d2
          (
            ic-toplevel arena rest vt
            (
              tlacc-push-stmt
              (
                IFfi
                "zyl_run_tests"
                Nil
              )
              acc
            )
          )
        )
        (
          d3
          (
            ic-toplevel arena rest vt acc
          )
        )
      )
    )
  )
)
(
  defn ic-toplevel-test
  (
    arena name body vt acc
  )
  (
    let tname
    (
      str-intern arena
      (
        str-concat
        "_test_"
        name
      )
    )
    (
      let h
      (
        ic-hoist
        (
          ic-expr arena body vt
        )
      )
      (
        let tbody
        (
          ISeq
          (
            Cons
            (
              hoist-node h
            )
            (
              Cons
              (
                IConst 0
              )
              Nil
            )
          )
        )
        (
          let acc2
          (
            tlacc-push-fns
            (
              Cons
              (
                IFn tname
                (
                  no-strs
                )
                tbody
              )
              (
                hoist-fns h
              )
            )
            acc
          )
          (
            tlacc-push-stmt
            (
              IFfi
              "zyl_register_test"
              (
                Cons
                (
                  IStr name
                )
                (
                  Cons
                  (
                    ILoad tname
                  )
                  Nil
                )
              )
            )
            acc2
          )
        )
      )
    )
  )
)
(
  defn ic-finish-program
  (
    fns stmts
  )
  (
    match stmts
    (
      Nil fns
    )
    (
      Cons d1 d2
      (
        if
        (
          >
          (
            ic-has-main fns
          )
          0
        )
        (
          ffi-call
          "f_error"
          "E_TOPLEVEL_STMTS_WITH_EXPLICIT_MAIN: top-level test/run-tests forms alongside an explicit (defn main ...)"
          1000
        )
        (
          Cons
          (
            IFn
            "main"
            (
              no-strs
            )
            (
              ISeq
              (
                list-append stmts
                (
                  Cons
                  (
                    IConst 0
                  )
                  Nil
                )
              )
            )
          )
          fns
        )
      )
    )
  )
)
(
  defn ic-has-main
  (
    fns
  )
  (
    match fns
    (
      Nil 0
    )
    (
      Cons f rest
      (
        match f
        (
          IFn name d1 d2
          (
            if
            (
              >
              (
                str-eq name
                "main"
              )
              0
            )
            1
            (
              ic-has-main rest
            )
          )
        )
        (
          d3
          (
            ic-has-main rest
          )
        )
      )
    )
  )
)
(
  defn ic-collect-vt
  (
    forms vt
  )
  (
    match forms
    (
      Nil vt
    )
    (
      Cons e rest
      (
        match
        (
          Expr.inner e
        )
        (
          EDeftype name variants d1 d2
          (
            ic-collect-vt rest
            (
              ic-vt-deftype name variants vt
            )
          )
        )
        (
          d3
          (
            ic-collect-vt rest vt
          )
        )
      )
    )
  )
)
(
  defn ic-vt-deftype
  (
    name variants vt
  )
  (
    vt-from-adtvariants variants vt 0
  )
)
(
  defn vt-from-adtvariants
  (
    variants vt tag
  )
  (
    match variants
    (
      Nil vt
    )
    (
      Cons v rest
      (
        let tail
        (
          vt-from-adtvariants rest vt
          (
            + tag 1
          )
        )
        (
          let nm
          (
            AV.name v
          )
          (
            if
            (
              >
              (
                vt-tag-of tail nm
              )
              -1
            )
            (
              ffi-call
              "f_error"
              "E_DUPLICATE_VARIANT: variant name defined by more than one deftype"
              1000
            )
            (
              VTEntry nm
              tag
              (
                AV.fields v
              )
              tail
            )
          )
        )
      )
    )
  )
)
(
  defn ic-defn
  (
    arena name params body vt
  )
  (
    let h
    (
      ic-hoist
      (
        ic-expr arena body vt
      )
    )
    (
      Cons
      (
        IFn
        (
          str-intern arena name
        )
        (
          param-names params
          (
            no-strs
          )
        )
        (
          hoist-node h
        )
      )
      (
        hoist-fns h
      )
    )
  )
)
(
  defn param-names
  (
    params acc
  )
  (
    match params
    (
      Nil
      (
        list-reverse acc
      )
    )
    (
      Cons p rest
      (
        param-names rest
        (
          Cons
          (
            P.name p
          )
          acc
        )
      )
    )
  )
)
(
  defn ic-expr
  (
    arena expr vt
  )
  (
    match
    (
      Expr.inner expr
    )
    (
      EAtom atom
      (
        ic-atom arena atom vt
      )
    )
    (
      ECall op args
      (
        ic-call-expr arena op args vt
      )
    )
    (
      EApply fname args
      (
        ic-apply arena fname args vt
      )
    )
    (
      ELet name val body
      (
        ILet
        (
          str-intern arena name
        )
        (
          ic-expr arena val vt
        )
        (
          ic-expr arena body vt
        )
      )
    )
    (
      ELetMut name val body
      (
        ILet
        (
          str-intern arena name
        )
        (
          ic-expr arena val vt
        )
        (
          ic-expr arena body vt
        )
      )
    )
    (
      EIf c t eb
      (
        IIf
        (
          ic-expr arena c vt
        )
        (
          ic-expr arena t vt
        )
        (
          ic-expr arena eb vt
        )
      )
    )
    (
      EWhile c body
