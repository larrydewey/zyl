    match params
    (
      Nil Nil
    )
    (
      (
        Cons p rest
      )
      (
        Cons
        (
          match p
          (
            P name typ
            (
              match typ
              (
                Some t
                (
                  type-from-display t
                )
              )
              (
                None
                (
                  TVar 0 TUnit
                )
              )
            )
