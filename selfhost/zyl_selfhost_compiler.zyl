      )
    )
  )
)
(
  defn infer-arg-type
  (
    ctx expr
  )
  (
    match
    (
      Expr.inner expr
    )
    (
      EAtom
      (
        AInt d4 d5
      )
      (
        TPrim PInt
      )
    )
    (
      EAtom
      (
        AFloat d6 d7
      )
      (
        TPrim PFloat
