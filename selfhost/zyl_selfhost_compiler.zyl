(
  defn first-expr
  (
    xs
  )
  (
    match xs
    (
      Cons a d1 a
    )
    (
      Nil
      (
        Expr
        (
          EAtom ANil
        )
      )
    )
  )
)
(
  defn rest-expr
  (
    xs
  )
  (
    match xs
    (
      Cons d2 r r
    )
    (
      Nil Nil
    )
  )
)
(
  defn last-expr
  (
    xs
  )
  (
    last-expr-loop xs
    (
      Expr
      (
        EAtom ANil
      )
    )
  )
)
(
  defn last-expr-loop
  (
    xs acc
  )
  (
    match xs
    (
      Nil acc
    )
    (
      Cons h t
      (
        last-expr-loop t h
      )
    )
  )
)
(
  defn butlast-expr
  (
    xs acc
  )
  (
    if
    (
      is-nil xs
    )
    (
      list-reverse acc
    )
    (
      butlast-expr-step
      (
        first-expr xs
      )
      (
        rest-expr xs
      )
      acc
    )
  )
)
(
  defn butlast-expr-step
  (
    h t acc
  )
  (
    if
    (
      is-nil t
    )
    (
      list-reverse acc
    )
    (
      butlast-expr t
      (
        Cons h acc
      )
    )
  )
)
(
  defn expr-ident-name
  (
    e fb
  )
  (
    match
    (
      Expr.inner e
    )
    (
      EAtom atom
      (
        match atom
        (
          AIdent n n
        )
        (
          d1 fb
        )
      )
    )
    (
      d2 fb
    )
  )
)
(
  deftype TLAcc
  (
    TLAcc
    (
      List Icnf
    )
    (
