; ===== AUTO-ASSEMBLED SELF-HOSTED COMPILER (boot source) =====

; ---------- stdlib/core/option.zyl ----------
(
  deftype Option
  (
    Some T
  )
  None
)
(
  defn option-unwrap
  (
    opt default
  )
  (
    match opt
    (
      Some v v
    )
    (
      None default
    )
  )
)
(
  defn option-is-some
  (
    opt
  )
  (
    match opt
    (
      Some w1x true
    )
    (
      None false
    )
  )
)
(
  defn option-is-none
  (
    opt
  )
  (
    match opt
    (
      Some w2x false
    )
    (
      None true
    )
  )
)
(
  defn option-map
  (
    opt f
  )
  (
    match opt
    (
      Some v
      (
        Some
        (
          f v
        )
      )
    )
    (
      None None
    )
  )
)
(
  defn option-and
  (
    opt other
  )
  (
    match opt
    (
      Some w3x other
    )
    (
      None None
    )
  )
)
(
  defn option-or
  (
    opt other
  )
  (
    match opt
    (
      Some w4x opt
    )
    (
      None other
    )
  )
)
(
  defn option-expect
  (
    opt msg
  )
  (
    match opt
    (
      Some v v
    )
    (
      None
      (
        error msg
      )
    )
  )
)
(
  defn option-unwrap-or
  (
    opt default
  )
  (
    match opt
    (
      Some v v
    )
    (
      None default
    )
  )
)
(
  defn option-none
  (
  )
  None
)
(
  defn option-some
  (
    x
  )
  (
    Some x
  )
)
(
  defn option-flatmap
  (
    opt f
  )
  (
    match opt
    (
      Some v
      (
        f v
      )
    )
    (
      None None
    )
  )
)
(
  defn option-inspect
  (
    opt f
  )
  (
    match opt
    (
      Some v
      (
        begin
        (
          f v
        )
        opt
      )
    )
    (
      None opt
    )
  )
)
; ---------- stdlib/core/result.zyl ----------
(
  deftype Result
  (
    Ok T
  )
  (
    Err E
  )
)
(
  defn result-unwrap
  (
    res default
  )
  (
    match res
    (
      Ok v v
    )
    (
      Err w1x default
    )
  )
)
(
  defn result-is-ok
  (
    res
  )
  (
    match res
    (
      Ok w2x true
    )
    (
      Err w3x false
    )
  )
)
(
  defn result-is-err
  (
    res
  )
  (
    match res
    (
      Ok w4x false
    )
    (
      Err w5x true
    )
  )
)
(
  defn result-map
  (
    res f
  )
  (
    match res
    (
      Ok v
      (
        Ok
        (
          f v
        )
      )
    )
    (
      Err e
      (
        Err e
      )
    )
  )
)
(
  defn result-and
  (
    res other
  )
  (
    match res
    (
      Ok w6x other
    )
    (
      Err w7x res
    )
  )
)
(
  defn result-or
  (
    res other
  )
  (
    match res
    (
      Ok w8x res
    )
    (
      Err w9x other
    )
  )
)
(
  defn result-expect
  (
    res msg
  )
  (
    match res
    (
      Ok v v
    )
    (
      Err w10x
      (
        error msg
      )
    )
  )
)
(
  defn result-unwrap-or
  (
    res default
  )
  (
    match res
    (
      Ok v v
    )
    (
      Err w11x default
    )
  )
)
(
  defn result-ok
  (
    v
  )
  (
    Ok v
  )
)
(
  defn result-err
  (
    e
  )
  (
    Err e
  )
)
(
  defn result-flatmap
  (
    res f
  )
  (
    match res
    (
      Ok v
      (
        f v
      )
    )
    (
      Err e
      (
        Err e
      )
    )
  )
)
(
  defn result-inspect
  (
    res f
  )
  (
    match res
    (
      Ok v
      (
        begin
        (
          f v
        )
        res
      )
    )
    (
      Err e
      (
        begin
        (
          f e
        )
        res
      )
    )
  )
)
(
  defn result-and-then
  (
    res f
  )
  (
    result-flatmap res f
  )
)
(
  defn result-or-else
  (
    res f
  )
  (
    match res
    (
      Ok v
      (
        Ok v
      )
    )
    (
      Err e
      (
        f e
      )
    )
  )
)
; ---------- stdlib/core/list.zyl ----------
(
  deftype List
  (
    Cons T
    (
      List T
    )
  )
  Nil
)
(
  defn is-nil
  (
    xs
  )
  (
    match xs
    (
      Cons w1x w2x false
    )
    (
      Nil true
    )
  )
)
(
  defn list-car
  (
    xs
  )
  (
    match xs
    (
      Cons v w3x
      (
        Some v
      )
    )
    (
      Nil None
    )
  )
)
(
  defn list-cdr
  (
    xs
  )
  (
    match xs
    (
      Cons w4x rest rest
    )
    (
      Nil None
    )
  )
)
(
  defn list-length
  (
    xs
  )
  (
    match xs
    (
      Nil 0
    )
    (
      Cons w5x rest
      (
        + 1
        (
          list-length rest
        )
      )
    )
  )
)
(
  defn list-append
  (
    xs ys
  )
  (
    match xs
    (
      Nil ys
    )
    (
      Cons h t
      (
        Cons h
        (
          list-append t ys
        )
      )
    )
  )
)
(
  defn list-reverse
  (
    xs
  )
  (
    list-reverse-acc xs Nil
  )
)
(
  defn list-reverse-acc
  (
    xs acc
  )
  (
    match xs
    (
      Nil acc
    )
    (
      Cons h t
      (
        list-reverse-acc t
        (
          Cons h acc
        )
      )
    )
  )
)
(
  defn list-sum
  (
    xs
  )
  (
    match xs
    (
      Nil 0
    )
    (
      Cons h t
      (
        + h
        (
          list-sum t
        )
      )
    )
  )
)
; ---------- stdlib/allocator/allocator.zyl ----------
(
  defn alloc-malloc
  (
    size
  )
  (
    ffi-call
    "zyl_mem_alloc"
    size 1000
  )
)
(
  defn alloc-free
  (
    ptr
  )
  (
    ffi-call
    "zyl_mem_free"
    ptr 1000
  )
)
(
  defn alloc-read-int
  (
    addr
  )
  (
    ffi-call
    "zyl_mem_read"
    addr 1000
  )
)
(
  defn alloc-write-int
  (
    addr value
  )
  (
    ffi-call
    "zyl_mem_write"
    addr value 1000
  )
)
(
  defn alloc-int
  (
    value
  )
  (
    let p
    (
      alloc-malloc 8
    )
    (
      begin
      (
        alloc-write-int p value
      )
      p
    )
  )
)
(
  defn alloc-strlen
  (
    ptr
  )
  (
    ffi-call
    "zyl_cstr_len"
    ptr 1000
  )
)
(
  defn alloc-incr
  (
    addr
  )
  (
    alloc-write-int addr
    (
      +
      (
        alloc-read-int addr
      )
      1
    )
  )
)
(
  defn alloc-decr
  (
    addr
  )
  (
    alloc-write-int addr
    (
      -
      (
        alloc-read-int addr
      )
      1
    )
  )
)
(
  defn arena-create
  (
    block-size
  )
  (
    let h
    (
      ffi-call
      "zyl_arena_create"
      block-size 1000
    )
    h
  )
)
(
  defn arena-alloc
  (
    arena size
  )
  (
    let h
    (
      ffi-call
      "zyl_arena_alloc"
      arena size 1000
    )
    h
  )
)
(
  defn arena-alloc-zeroed
  (
    arena size
  )
  (
    let h
    (
      ffi-call
      "zyl_arena_alloc_zeroed"
      arena size 1000
    )
    h
  )
)
(
  defn arena-reset
  (
    arena
  )
  (
    let h
    (
      ffi-call
      "zyl_arena_reset"
      arena 1000
    )
    h
  )
)
(
  defn arena-destroy
  (
    arena
  )
  (
    let h
    (
      ffi-call
      "zyl_arena_destroy"
      arena 1000
    )
    h
  )
)
(
  defn arena-used
  (
    arena
  )
  (
    let h
    (
      ffi-call
      "zyl_arena_used"
      arena 1000
    )
    h
  )
)
(
  defn arena-capacity
  (
    arena
  )
  (
    let h
    (
      ffi-call
      "zyl_arena_capacity"
      arena 1000
    )
    h
  )
)
(
  defn str-len
  (
    ptr
  )
  (
    alloc-strlen ptr
  )
)
(
  defn buf-append
  (
    dst src
  )
  (
    ffi-call
    "zyl_str_append"
    dst src 1000
  )
)
(
  defn error
  (
    msg
  )
  (
    ffi-call
    "f_error"
    msg 1000
  )
)
(
  defn str-intern
  (
    arena s
  )
  (
    let n
    (
      alloc-strlen s
    )
    (
      let p
      (
        arena-alloc-zeroed arena
        (
          + n 1
        )
      )
      (
        begin
        (
          buf-append p s
        )
        p
      )
    )
  )
)
(
  defn str-eq
  (
    p1 p2
  )
  (
    ffi-call
    "zyl_cstr_eq"
    p1 p2 1000
  )
)
(
  defn str-concat
  (
    a b
  )
  (
    ffi-call
    "zyl_cstr_concat"
    a b 1000
  )
)
(
  defn str-length
  (
    s
  )
  (
    ffi-call
    "zyl_cstr_len"
    s 1000
  )
)
(
  defn str-substring
  (
    s start len
  )
  (
    ffi-call
    "zyl_cstr_substr"
    s start len 1000
  )
)
; ---------- stdlib/compiler/ast.zyl ----------
(
  deftype Token
  (
    TkEof
  )
  (
    TkIdent String
  )
  (
    TkInt Int
  )
  (
    TkFloat String
  )
  (
    TkString String
  )
  (
    TkBool Bool
  )
  (
    TkSymbol String
  )
  (
    TkKeyword String
  )
  (
    TkLParen
  )
  (
    TkRParen
  )
  (
    TkLBrace
  )
  (
    TkRBrace
  )
  (
    TkLBracket
  )
  (
    TkRBracket
  )
  (
    TkColon
  )
)
(
  deftype Ast
  (
    AstIdent String
  )
  (
    AstInt Int
  )
  (
    AstFloat String
  )
  (
    AString String
  )
  (
    AstBool Bool
  )
  (
    AList
    (
      List Ast
    )
  )
)
(
  deftype Env
  (
    EnvBind String Int Int Env
  )
  (
    EnvNil
  )
)
(
  defn env-lookup
  (
    env name
  )
  (
    match env
    (
      EnvBind n off d1 rest
      (
        if
        (
          str-eq n name
        )
        off
        (
          env-lookup rest name
        )
      )
    )
    (
      EnvNil 0
    )
  )
)
(
  defn env-kind-of
  (
    env name
  )
  (
    match env
    (
      EnvBind n d2 k rest
      (
        if
        (
          str-eq n name
        )
        k
        (
          env-kind-of rest name
        )
      )
    )
    (
      EnvNil 0
    )
  )
)
(
  deftype VTable
  (
    VTEntry String Int
    (
      List String
    )
    VTable
  )
  (
    VTNil
  )
)
(
  defn vt-tag-of
  (
    vt name
  )
  (
    match vt
    (
      VTEntry n tag d3 rest
      (
        if
        (
          str-eq n name
        )
        tag
        (
          vt-tag-of rest name
        )
      )
    )
    (
      VTNil -1
    )
  )
)
(
  defn vt-arity-of
  (
    vt name
  )
  (
    match vt
    (
      VTEntry n d4 fields rest
      (
        if
        (
          str-eq n name
        )
        (
          list-length fields
        )
        (
          vt-arity-of rest name
        )
      )
    )
    (
      VTNil -1
    )
  )
)
(
  defn toks-head
  (
    toks
  )
  (
    match toks
    (
      Cons t d5 t
    )
    (
      Nil
      (
        TkEof
      )
    )
  )
)
(
  defn toks-tail
  (
    toks
  )
  (
    match toks
    (
      Cons d6 rest rest
    )
    (
      Nil Nil
    )
  )
)
