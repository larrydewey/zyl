(
  defn kv-type-names
  (
    type-map keys
  )
  (
    match keys
    (
      Nil Nil
    )
    (
      Cons k rest
      (
        Cons
        (
          type-to-string
          (
            kv-get type-map k
            (
              TVar 0 TUnit
            )
          )
        )
        (
          kv-type-names type-map rest
        )
      )
    )
  )
)
(
  defn canonical-name-from-type-map
  (
    base-name type-map
  )
