(
  defn collect-definitions
  (
    inferer exprs
  )
  (
    match exprs
    (
      Nil inferer
    )
    (
      (
        Cons expr rest
      )
      (
        match
        (
          Expr.inner expr
        )
        (
          EDefn name params body
          (
            let
            (
              param-types
              (
                collect-defn-params inferer params
              )
            )
            (
              let
              (
                infered
                (
                  infer-defn-body inferer name params param-types body
                )
