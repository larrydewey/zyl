      )
    )
    (
      AstIdent n
      (
        if
        (
          ast-has-at-least args 2
        )
        (
          Some
          (
            Expr
            (
              EDef
              n
              (
                convert-ast
                (
                  ast-nth args 1
                  (
                    AstInt 0
                  )
                )
              )
            )
          )
        )
        None
      )
    )
    (
      d1 None
    )
  )
