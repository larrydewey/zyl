        (
          atom
          (
            AInt n
          )
        )
        (
          Expr
          (
            EAtom atom
          )
        )
      )
    )
    (
      AFloat s
      (
        let
        (
          atom
          (
            AFloat s
          )
        )
        (
          Expr
          (
            EAtom atom
          )
        )
      )
    )
    (
      AString s
      (
        let
        (
          atom
          (
            AStr s
          )
        )
        (
          Expr
          (
            EAtom atom
          )
        )
      )
    )
    (
      ABool b
