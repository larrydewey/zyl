  defn subst-insert
  (
    s n t
  )
  (
    SBindings
    (
      Cons
      (
        TB n t
      )
      (
        SBindings.binds s
      )
    )
  )
)
(
  defn subst-apply-type
  (
    s t
  )
  (
    match t
    (
      TInt TInt
    )
    (
      TFloat TFloat
    )
    (
      TBool TBool
    )
    (
      TString TString
    )
    (
      TUnit TUnit
    )
    (
      TFun args
      (
        subst-apply-type-list s args
      )
    )
    (
      TList elem
      (
        TList
        (
          subst-apply-type s elem
        )
      )
    )
    (
      TArray elem len
      (
        TArray
        (
          subst-apply-type s elem
        )
        len
      )
    )
    (
      TCap kind inner
      (
        TCap kind
        (
          subst-apply-type s inner
        )
      )
    )
    (
      TStruct name fields
      (
        subst-apply-type-struct s name fields
      )
    )
    (
      TVar m inner
      (
        match
        (
          subst-lookup s m
        )
        (
          Some t
          (
            subst-apply-type s t
          )
        )
        (
          None
          (
            TVar m
            (
              subst-apply-type s inner
            )
          )
        )
      )
    )
    (
      TMap k v
      (
        TMap
        (
          subst-apply-type s k
        )
        (
          subst-apply-type s v
        )
      )
    )
    (
      TResult e h
      (
        TResult
        (
          subst-apply-type s e
        )
        (
          subst-apply-type s h
        )
      )
    )
  )
)
(
  defn subst-apply-type-list
  (
    s types
  )
  (
    match types
    (
      Nil Nil
    )
    (
      (
        Cons h t
      )
      (
        Cons
        (
          subst-apply-type s h
        )
        (
          subst-apply-type-list s t
        )
      )
    )
  )
)
(
  defn subst-apply-type-struct
  (
    s name fields
  )
  (
    TStruct name
    (
      subst-apply-type-list s fields
    )
  )
)
(
  defn fst
  (
    p
  )
  (
    match p
    (
      Pair a d2 a
    )
    (
      d1
      (
        fst-pair p
      )
    )
  )
)
(
  defn fst-pair
  (
    p
  )
  (
    match p
    (
      Pair first d3
      (
        match first
        (
          Some a a
        )
        (
          None 0
        )
      )
    )
  )
)
(
  defn snd
  (
    p
  )
  (
    match p
    (
      Pair a b b
    )
    (
      d1
      (
        snd-pair p
      )
    )
  )
)
(
  defn snd-pair
  (
    p
  )
  (
    match p
    (
      Pair a b b
    )
    (
      d1 0
    )
  )
)
(
  defn subst-apply
  (
    s t
  )
  (
    subst-apply-type s t
  )
)
(
  defn type-free-vars
  (
    t
  )
  (
    match t
    (
      TInt Nil
    )
    (
      TFloat Nil
    )
    (
      TBool Nil
    )
    (
      TString Nil
    )
    (
      TUnit Nil
    )
    (
      TFun args
      (
        type-free-vars-list args
      )
    )
    (
      TList elem
      (
        type-free-vars elem
      )
    )
    (
      TArray elem d1
      (
        type-free-vars elem
      )
    )
    (
      TCap d2 inner
      (
        type-free-vars inner
      )
    )
    (
      TStruct d3 fields
      (
        type-free-vars-list fields
      )
    )
    (
      TVar n d4
      (
        Cons n Nil
      )
    )
    (
      TMap k v
      (
        tfv-union
        (
          type-free-vars k
        )
        (
          type-free-vars v
        )
      )
    )
    (
      TResult e h
      (
        tfv-union
        (
          type-free-vars e
        )
        (
          type-free-vars h
        )
      )
    )
  )
)
(
  defn type-free-vars-list
  (
    (
      types
      (
        List Type
      )
    )
  )
  (
    match types
    (
      Nil Nil
    )
    (
      (
        Cons h t
      )
      (
        tfv-union
        (
          type-free-vars h
        )
        (
          type-free-vars-list t
        )
      )
    )
  )
)
(
  defn tfv-union
  (
    a b
  )
  (
    match a
    (
      Nil b
    )
    (
      Cons h t
      (
        if
        (
          tfv-contains b h
        )
        (
          tfv-union t b
        )
        (
          Cons h
          (
            tfv-union t b
          )
        )
      )
    )
  )
)
(
  defn tfv-contains
  (
    lst x
  )
  (
    match lst
    (
      Nil false
    )
    (
      Cons h t
      (
        if
        (
          = h x
        )
        true
        (
          tfv-contains t x
        )
      )
    )
  )
)
(
  defn unify
  (
    s t1 t2
  )
  (
    let
    (
      t1x
      (
        subst-apply s t1
      )
    )
    (
      let
      (
        t2x
        (
          subst-apply s t2
        )
      )
      (
        unify-terms s t1x t2x
      )
    )
  )
)
(
  defn unify-terms
  (
    s t1 t2
  )
  (
    match t1
    (
      TVar n d5
      (
        unify-var s n t2
      )
    )
    (
      d10
      (
        unify-terms-not-tvar1 s t1 t2
      )
    )
  )
)
(
  defn unify-terms-not-tvar1
  (
    s t1 t2
  )
  (
    match t2
    (
      TVar n d8
      (
        unify-var s n t1
      )
    )
    (
      d11
      (
        unify-terms-concrete s t1 t2
      )
    )
  )
)
(
  defn unify-terms-concrete
  (
    s t1 t2
  )
  (
    match t1
    (
      TInt
      (
        match t2
        (
          TInt
          (
            UOk s
          )
        )
        (
          d1
          (
            UErr
            "Type mismatch"
          )
        )
      )
    )
    (
      TFloat
      (
        match t2
        (
          TFloat
          (
            UOk s
          )
        )
        (
          d1
          (
            UErr
            "Type mismatch"
          )
        )
      )
    )
    (
      TBool
      (
        match t2
        (
          TBool
          (
            UOk s
          )
        )
        (
          d1
          (
            UErr
            "Type mismatch"
          )
        )
      )
    )
    (
      TString
      (
        match t2
        (
          TString
          (
            UOk s
          )
        )
        (
          d1
          (
            UErr
            "Type mismatch"
          )
        )
      )
    )
    (
      TUnit
      (
        match t2
        (
          TUnit
          (
            UOk s
          )
        )
        (
          d1
          (
            UErr
            "Type mismatch"
          )
        )
      )
    )
    (
      TFun args1
      (
        match t2
        (
          TFun args2
          (
            if
            (
              =
              (
                list-length args1
              )
              (
                list-length args2
              )
            )
            (
              unify-args s args1 args2
            )
            (
              UErr
              "Function arity mismatch"
            )
          )
        )
        (
          d1
          (
            UErr
            "Type mismatch"
          )
        )
      )
    )
    (
      TList e1
      (
        match t2
        (
          TList e2
          (
            unify s e1 e2
          )
        )
        (
          d1
          (
            UErr
            "Type mismatch"
          )
        )
      )
    )
    (
      TArray e1 l1
      (
        match t2
        (
          TArray e2 l2
          (
            if
            (
              = l1 l2
            )
            (
              unify s e1 e2
            )
            (
              UErr
              "Array length mismatch"
            )
          )
        )
        (
          d1
          (
            UErr
            "Type mismatch"
          )
        )
      )
    )
    (
      TCap k1 a
      (
        match t2
        (
          TCap k2 b
          (
            if
            (
              = k1 k2
            )
            (
              unify s a b
            )
            (
              UErr
              "Capability kind mismatch"
            )
          )
        )
        (
          d1
          (
            UErr
            "Type mismatch"
          )
        )
      )
    )
    (
      TStruct n1 fs1
      (
        match t2
        (
          TStruct n2 fs2
          (
            if
            (
              = n1 n2
            )
            (
              if
              (
                =
                (
                  list-length fs1
                )
                (
                  list-length fs2
                )
              )
              (
                unify-args s fs1 fs2
              )
              (
                UErr
                "Struct field count mismatch"
              )
            )
            (
              UErr
              "Struct name mismatch"
            )
          )
        )
        (
          d1
          (
            UErr
            "Type mismatch"
          )
        )
      )
    )
    (
      TMap k1 v1
      (
        match t2
        (
          TMap k2 v2
          (
            match
            (
              unify s k1 k2
            )
            (
              UOk sx
              (
                unify sx v1 v2
              )
            )
            (
              UErr e
              (
                UErr e
              )
            )
          )
        )
        (
          d1
          (
            UErr
            "Type mismatch"
          )
        )
      )
    )
    (
      TResult e1 h1
      (
        match t2
        (
          TResult e2 h2
          (
            match
            (
              unify s e1 e2
            )
            (
              UOk sx
              (
                unify sx h1 h2
              )
            )
            (
              UErr e
              (
                UErr e
              )
            )
          )
        )
        (
          d1
          (
            UErr
            "Type mismatch"
          )
        )
      )
    )
    (
      d2
      (
        UErr
        "Type mismatch"
      )
    )
  )
)
(
  defn unify-var
  (
    s n t
  )
  (
    match
    (
      subst-lookup s n
    )
    (
      Some tx
      (
        if
        (
          = tx t
        )
        (
          UOk s
        )
        (
          UErr
          "Variable already bound"
        )
      )
    )
    (
      None
      (
        UOk
        (
          subst-insert s n t
        )
      )
    )
  )
)
(
  defn unify-args
  (
    s args1 args2
  )
  (
    match args1
    (
      Nil
      (
        match args2
        (
          Nil
          (
            UOk s
          )
        )
        (
          d1
          (
            UErr
            "argument count mismatch"
          )
        )
      )
    )
    (
      Cons h1 t1
      (
        match args2
        (
          Cons h2 t2
          (
            match
            (
              unify s h1 h2
            )
            (
              UOk sx
              (
                unify-args sx t1 t2
              )
            )
            (
              UErr e
              (
                UErr e
              )
            )
          )
        )
        (
          d2
          (
            UErr
            "argument count mismatch"
          )
        )
      )
    )
  )
)
