              ret
            )
          )
        )
        (
          (
            = fname
            "vec"
          )
          (
            if
            (
              >
              (
                list-length args
              )
              0
            )
            (
              infer-arg-type ctx
              (
                list-nth args 0
              )
            )
            (
              TVar 0
            )
          )
        )
        (
          (
            kv-contains
            (
              mc-known-fns ctx
            )
            fname
          )
          (
            let sigs
            (
              kv-get
              (
                mc-known-fns ctx
              )
              fname Nil
            )
            (
              if
              (
                >=
                (
                  list-length sigs
                )
                (
                  list-length args
                )
              )
              (
                infer-arg-type ctx
                (
                  list-nth args 0
                )
              )
              (
                TVar 0
              )
            )
          )
        )
        (
          else
          (
            TNominal fname
          )
        )
      )
    )
    (
      ECall op args
      (
        let op-name
        (
          match
          (
            Expr.inner op
          )
          (
            EAtom
            (
              AIdent n
            )
            n
          )
          (
            d1 nil
          )
        )
        (
          cond
          (
            (
              or
              (
                = op-name
                "+"
              )
              (
                = op-name
                "-"
              )
              (
                = op-name
                "*"
              )
              (
                = op-name
                "/"
              )
            )
            (
              if
              (
                >
                (
                  list-length args
                )
                0
              )
              (
                infer-arg-type ctx
                (
                  list-nth args 0
                )
              )
              (
                TPrim PInt
              )
            )
          )
          (
            (
              or
              (
                = op-name
                "=="
              )
              (
                = op-name
                "!="
              )
              (
                = op-name
                "<"
              )
              (
                = op-name
                ">"
              )
              (
                = op-name
                "<="
              )
              (
                = op-name
                ">="
              )
            )
            (
              TPrim PBool
            )
          )
          (
            (
              kv-contains
              (
                mc-returns ctx
              )
              op-name
            )
            (
              let ret
              (
                kv-get
                (
                  mc-returns ctx
                )
                op-name
                (
                  TVar 0
                )
              )
              (
                if
                (
                  = ret
                  (
                    TVar 0
                  )
                )
                (
                  if
                  (
                    str-starts-with op-name
                    "make-"
                  )
                  (
                    TNominal
                    (
                      str-drop op-name 5
                    )
                  )
                  ret
                )
                ret
              )
            )
          )
          (
            (
              str-starts-with op-name
              "make-"
            )
            (
              TNominal
              (
                str-drop op-name 5
              )
            )
          )
          (
            else
            (
              if
              (
                >
                (
                  list-length args
                )
                0
              )
              (
                infer-arg-type ctx
                (
                  list-nth args 0
                )
              )
              (
                TVar 0
              )
            )
          )
        )
      )
    )
    (
      EIf d12 then_ else_
      (
        let tt
        (
          infer-arg-type ctx then_
        )
        (
          if
          (
            is-skip-placeholder else_
          )
          tt
          (
            let et
            (
              infer-arg-type ctx else_
            )
            (
              if
              (
                =
                (
                  type-to-string tt
                )
                (
                  type-to-string et
                )
              )
              tt
              (
                TVar 0
              )
            )
          )
        )
      )
    )
    (
      ELet d13 val d14
      (
        infer-arg-type ctx val
      )
    )
    (
      EBegin exprs
      (
        if
        (
          >
          (
            list-length exprs
          )
          0
        )
        (
          infer-arg-type ctx
          (
            list-last exprs
          )
        )
        (
          TPrim PUnit
        )
      )
    )
    (
      EMakeStruct name d15
      (
        TNominal name
      )
    )
    (
      EMakeVariant adt_name d16 d17
      (
        TNominal adt_name
      )
    )
    (
      d1
      (
        TVar 0
      )
    )
  )
