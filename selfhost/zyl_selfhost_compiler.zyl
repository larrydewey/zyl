        let hl
        (
          ic-hoist l
        )
        (
          let hr
          (
            ic-hoist r
          )
          (
            HoistAcc
            (
              IBinop op
              (
                hoist-node hl
              )
              (
                hoist-node hr
              )
            )
            (
              list-append
              (
                hoist-fns hl
              )
              (
                hoist-fns hr
              )
            )
          )
        )
