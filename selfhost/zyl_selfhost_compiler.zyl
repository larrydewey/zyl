(
  defn me-rewrite
  (
    e senv mt
  )
  (
    match
    (
      Expr.inner e
    )
    (
      EAtom atom
      (
        me-rewrite-atom e atom senv
      )
    )
    (
      ECall op args
      (
        Expr
        (
          ECall
          (
            me-rewrite op senv mt
          )
          (
            me-rewrite-list args senv mt
          )
        )
      )
    )
    (
      EApply fname args
      (
        me-rewrite-apply fname args senv mt
      )
    )
    (
      ELet name val body
      (
        Expr
        (
          ELet name
          (
            me-rewrite val senv mt
          )
          (
            me-rewrite body senv mt
          )
        )
      )
    )
    (
      ELetMut name val body
      (
        Expr
        (
          ELetMut name
          (
            me-rewrite val senv mt
          )
          (
            me-rewrite body senv mt
          )
        )
      )
    )
    (
      EIf c t eb
      (
        Expr
        (
          EIf
          (
            me-rewrite c senv mt
          )
          (
            me-rewrite t senv mt
          )
          (
            me-rewrite eb senv mt
          )
        )
      )
    )
    (
      EWhile c body
      (
        Expr
        (
          EWhile
          (
            me-rewrite c senv mt
          )
          (
            me-rewrite body senv mt
          )
        )
      )
    )
    (
      ESetBang name val
      (
        Expr
        (
          ESetBang name
          (
            me-rewrite val senv mt
          )
        )
      )
    )
    (
      EBegin exprs
      (
        Expr
        (
          EBegin
          (
            me-rewrite-list exprs senv mt
          )
        )
      )
    )
    (
      EPrint exprs
      (
        Expr
        (
          EPrint
          (
            me-rewrite-list exprs senv mt
          )
        )
      )
    )
    (
      EAssertEqual l r
      (
        Expr
        (
          EAssertEqual
          (
            me-rewrite l senv mt
          )
          (
            me-rewrite r senv mt
          )
        )
      )
    )
    (
      EAssertTrue ex d3
      (
        Expr
        (
          EAssertTrue
          (
            me-rewrite ex senv mt
          )
          d3
        )
      )
    )
    (
      EAssertFalse ex d4
      (
        Expr
        (
          EAssertFalse
          (
            me-rewrite ex senv mt
          )
          d4
        )
      )
    )
    (
      EStructGet se field
