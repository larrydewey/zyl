      TVar n inner
      (
        if
        (
          = n
          (
            var-index ret-type
          )
        )
        ret-type
        type
      )
    )
    (
      d1 type
    )
  )
)
(
  defn var-index
  (
    t
  )
  (
    match
    t
    (
      TVar n inner n
    )
    (
      d1 -1
    )
  )
)
