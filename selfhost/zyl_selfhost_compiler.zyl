(
  defn parse-body-from
  (
    args start
  )
  (
    let rest
    (
      ast-list-nth-rest args start
    )
    (
      if
      (
        <=
        (
          list-length rest
        )
        1
      )
      (
        match rest
        (
          Nil
          (
            Expr
            (
              EAtom ANil
            )
          )
        )
        (
          Cons only d1
          (
            convert-ast only
          )
        )
      )
      (
        Expr
        (
          EBegin
          (
            convert-ast-list rest
          )
        )
      )
    )
  )
)
