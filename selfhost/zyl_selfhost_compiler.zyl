    let gen-fns
    (
      discover-from-ast-loop
      (
        mc-gen-fns ctx
      )
      exprs
    )
    (
      MC gen-fns
      (
        mc-known-fns ctx
      )
      (
        mc-returns ctx
      )
      (
        mc-ktypes ctx
      )
      (
        mc-structs ctx
      )
      (
        mc-adt-defs ctx
      )
