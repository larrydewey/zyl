    let pn
    (
      match
      (
        ast-ident-name p
      )
      (
        Some v v
      )
      (
        d1
        (
          str-concat
          "T"
          (
            mono-index-letter i
          )
        )
      )
    )
    (
      MP pn Nil
    )
  )
)
(
  defn mono-index-letter
  (
    i
  )
  (
    if
    (
      = i 0
    )
    "A"
    (
      if
      (
        = i 1
      )
      "B"
      (
        if
        (
          = i 2
        )
        "C"
        (
          if
          (
            = i 3
          )
          "D"
          (
            if
            (
              = i 4
            )
            "E"
            (
              if
              (
                = i 5
              )
              "F"
              (
                if
                (
                  = i 6
                )
                "G"
                (
                  if
                  (
                    = i 7
                  )
                  "H"
                  (
                    if
                    (
                      = i 8
                    )
                    "I"
                    "X"
                  )
