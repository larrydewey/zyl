  )
)
(
  defn parse-defn
  (
    args
  )
  (
    match args
    (
      Nil None
    )
    (
      (
        Cons name rest
      )
      (
        match name
        (
          AIdent n
          (
            match rest
            (
              Nil None
            )
            (
              (
                Cons params body-expr
              )
              (
                let
                (
                  param-args
                  (
                    convert-ast-list
                    (
                      to-list params
                    )
                  )
                )
                (
                  Some
                  (
                    Expr
                    (
                      EDefn
                      n
                      (
                        parse-params params
                      )
                      (
                        convert-ast body-expr
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
(
  defn parse-params
  (
    params
  )
  (
    match params
    (
      AList lst
      (
        match lst
        (
          Nil Nil
        )
        (
          (
            Cons p rest
          )
          (
            let hd
            (
              parse-single-param p
            )
            (
              let tl
              (
                parse-params
                (
                  AList rest
                )
              )
              (
                Cons hd tl
              )
            )
          )
        )
      )
    )
    (
      d1 Nil
    )
  )
)
(
  defn parse-single-param
  (
    p
  )
  (
    match p
    (
      AIdent name
      (
        P name None
      )
    )
    (
      AList
      (
        Cons name
        (
          Cons typ rest
        )
      )
      (
        P
        (
          a-ident-to-str name
        )
        (
          Some
          (
            convert-ast typ
          )
        )
      )
    )
    (
      d1
      (
        P
        "___"
        None
      )
    )
  )
)
(
  defn parse-deftype
  (
    args
  )
  (
    match args
    (
      Nil None
    )
    (
      (
        Cons name rest
      )
      (
        match
        (
          convert-ast name
        )
        (
          Expr
          (
            EAtom
            (
              AIdent n
            )
          )
          (
            Some
            (
              Expr
              (
                EDeftype
                n
                (
                  parse-adt-variants rest
                )
                Nil
                None
              )
            )
          )
        )
      )
    )
  )
)
(
  defn parse-adt-variants
  (
    variants
  )
  (
    match variants
    (
      Nil Nil
    )
    (
      (
        Cons v rest
      )
      (
        Cons
        (
          parse-adt-variant v
        )
        (
          parse-adt-variants rest
        )
      )
    )
  )
)
(
  defn parse-adt-variant
  (
    v
  )
  (
    match v
    (
      AIdent name
      (
        AV name Nil
      )
    )
    (
      AList
      (
        Cons name rest
      )
      (
        AV
        (
          a-ident-to-str name
        )
        (
          parse-field-names
          (
            to-list rest
          )
        )
      )
    )
    (
      d1
      (
        AV
        "___"
        Nil
      )
    )
  )
)
(
  defn parse-field-names
  (
    fields
  )
  (
    match fields
    (
      Nil Nil
    )
    (
      (
        Cons f rest
      )
      (
        Cons
        (
          a-ident-to-str f
        )
        (
          parse-field-names rest
        )
      )
    )
  )
)
(
  defn parse-def
  (
    args
  )
  (
    match args
    (
      Nil None
    )
    (
      (
        Cons name rest
      )
      (
        match name
        (
          AIdent n
          (
            match rest
            (
              Nil None
            )
            (
              (
                Cons val body-expr
              )
              (
                Some
                (
                  Expr
                  (
                    EDef
                    n
                    (
                      convert-ast-list-to-expr val
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
(
  defn convert-ast-list-to-expr
  (
    ast
  )
  (
    match ast
    (
      AIdent n
      (
        let
        (
          atom
          (
            AIdent n
          )
        )
        (
          Expr
          (
            EAtom atom
          )
        )
      )
    )
    (
