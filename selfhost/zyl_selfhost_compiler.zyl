    (
      generate-instantiations-loop name params body inst-sets
    )
  )
)
(
  defn subst-expr-list
  (
    exprs type-map var-renames var-types
  )
  (
    match exprs
    (
      Nil Nil
    )
    (
      Cons e rest
      (
        Cons
        (
          subst-expr e type-map var-renames var-types
        )
        (
          subst-expr-list rest type-map var-renames var-types
        )
      )
    )
  )
)
(
  defn subst-defn-param
  (
    p type-map
  )
  (
    if
    (
      is-uppercase-ident
      (
        P.name p
      )
    )
    (
      if
      (
        kv-contains type-map
        (
          P.name p
        )
      )
      (
        P
        (
          P.name p
        )
        (
          Some
          (
            type-to-string
            (
              kv-get type-map
              (
                P.name p
              )
              (
                TVar 0 TUnit
              )
            )
          )
        )
      )
      p
    )
    p
  )
)
(
  defn subst-defn-params
  (
    params type-map
  )
  (
    match params
    (
      Nil Nil
    )
    (
      Cons p rest
      (
        Cons
        (
          subst-defn-param p type-map
        )
        (
          subst-defn-params rest type-map
        )
      )
    )
  )
)
(
  defn subst-cond-clauses
  (
    clauses type-map var-renames var-types
  )
  (
    match clauses
    (
      Nil Nil
    )
    (
      Cons clause rest
      (
        match clause
        (
          Pair c b
          (
            Cons
            (
              Pair
              (
                subst-expr c type-map var-renames var-types
              )
              (
                subst-expr b type-map var-renames var-types
              )
            )
            (
              subst-cond-clauses rest type-map var-renames var-types
            )
          )
        )
      )
    )
  )
)
(
  defn subst-match-arms
  (
    arms type-map var-renames var-types
  )
  (
    match arms
    (
      Nil Nil
    )
    (
      Cons arm rest
      (
        Cons
        (
          MA
          (
            MA.variant arm
          )
          (
            subst-expr-list
            (
              MA.patterns arm
            )
            type-map var-renames var-types
          )
          (
            subst-expr
            (
              MA.body arm
            )
            type-map var-renames var-types
          )
        )
        (
          subst-match-arms rest type-map var-renames var-types
        )
      )
    )
  )
)
(
  defn subst-adt-field
  (
    f type-map
  )
  (
    if
    (
      is-uppercase-ident f
    )
    (
      if
      (
        kv-contains type-map f
      )
      (
        type-to-string
        (
          kv-get type-map f
          (
            TVar 0 TUnit
          )
        )
      )
      f
    )
    f
  )
)
(
  defn subst-adt-fields
  (
    fields type-map
  )
  (
    match fields
    (
      Nil Nil
    )
    (
      Cons f rest
      (
        Cons
        (
          subst-adt-field f type-map
        )
        (
          subst-adt-fields rest type-map
        )
      )
    )
  )
)
(
  defn subst-adt-variants
  (
    variants type-map
  )
  (
    match variants
    (
      Nil Nil
    )
    (
      Cons v rest
      (
        Cons
        (
          AV
          (
            AV.name v
          )
          (
            subst-adt-fields
            (
              AV.fields v
            )
            type-map
          )
        )
        (
          subst-adt-variants rest type-map
        )
      )
    )
  )
)
(
  defn subst-expr
  (
    expr type-map var-renames var-types
  )
  (
    match
    (
      Expr.inner expr
    )
    (
      EDefn name params body
      (
        let new-params
        (
          subst-defn-params params type-map
        )
        (
          let child-types
          (
            kv-set Nil name
            (
              infer-arg-type
              (
                MC Nil Nil Nil Nil Nil Nil Nil Nil
              )
              (
                subst-expr body type-map var-renames var-types
              )
            )
          )
          (
            Expr
            (
              EDefn name new-params
              (
                subst-expr body type-map var-renames child-types
              )
            )
          )
        )
      )
    )
    (
      ECall op args
      (
        Expr
        (
          ECall
          (
            subst-expr op type-map var-renames var-types
          )
          (
            subst-expr-list args type-map var-renames var-types
          )
        )
      )
    )
    (
      EApply fname args
      (
        Expr
        (
          EApply fname
          (
            subst-expr-list args type-map var-renames var-types
          )
        )
      )
    )
    (
      ELet name val body
      (
        let new-val
        (
          subst-expr val type-map var-renames var-types
        )
        (
          let child-types
          (
            kv-set Nil name
            (
              infer-arg-type
              (
                MC Nil Nil Nil Nil Nil Nil Nil Nil
              )
              new-val
            )
          )
          (
            Expr
            (
              ELet name new-val
              (
                subst-expr body type-map var-renames child-types
              )
            )
          )
        )
      )
    )
    (
      EIf cond then- else-
      (
        Expr
        (
          EIf
          (
            subst-expr cond type-map var-renames var-types
          )
          (
            subst-expr then- type-map var-renames var-types
          )
          (
            subst-expr else- type-map var-renames var-types
          )
        )
      )
    )
    (
      ELambda name params body
      (
        Expr
        (
          ELambda name params
          (
            subst-expr body type-map var-renames var-types
          )
        )
      )
    )
    (
      EFn name params body
      (
        Expr
        (
          EFn name params
          (
            subst-expr body type-map var-renames var-types
          )
        )
      )
    )
    (
      EBegin exprs
      (
        Expr
        (
          EBegin
          (
            subst-expr-list exprs type-map var-renames var-types
          )
        )
      )
    )
    (
      EPrint exprs
      (
        Expr
        (
          EPrint
          (
            subst-expr-list exprs type-map var-renames var-types
          )
        )
      )
    )
    (
      EWhile cond body
      (
        Expr
        (
          EWhile
          (
            subst-expr cond type-map var-renames var-types
          )
          (
            subst-expr body type-map var-renames var-types
          )
        )
      )
    )
    (
      EFor bindings cond body
      (
        Expr
        (
          EFor bindings
          (
            subst-expr cond type-map var-renames var-types
          )
          (
            subst-expr body type-map var-renames var-types
          )
        )
      )
    )
    (
      ECond clauses
      (
        Expr
        (
          ECond
          (
            subst-cond-clauses clauses type-map var-renames var-types
          )
        )
      )
    )
    (
      EMatch subject arms
      (
        Expr
        (
          EMatch
          (
            subst-expr subject type-map var-renames var-types
          )
          (
            subst-match-arms arms type-map var-renames var-types
          )
        )
      )
    )
    (
      EAtom atom
      (
        match atom
        (
          AIdent name
          (
            Expr
            (
              EAtom
              (
                AIdent
                (
                  if
                  (
                    kv-contains var-renames name
                  )
                  (
                    kv-get var-renames name name
                  )
                  name
                )
              )
            )
          )
        )
        (
          d1
          (
            Expr
            (
              EAtom atom
            )
          )
        )
      )
    )
    (
      EMakeVariant adt_name variant_name args
      (
        Expr
        (
          EMakeVariant adt_name variant_name
          (
            subst-expr-list args type-map var-renames var-types
          )
        )
      )
    )
    (
      EDeftype name variants d20 bound
      (
        Expr
        (
          EDeftype name
          (
            subst-adt-variants variants type-map
          )
          Nil bound
        )
      )
    )
    (
      d1 expr
    )
  )
)
(
  defn substitute-in-expr
  (
    expr
  )
  (
    subst-expr expr Nil Nil Nil
  )
)
(
  defn substitute-in-adt-field
  (
    f
  )
  (
    if
    (
      is-uppercase-ident f
    )
    ""
    f
  )
)
(
  defn substitute-in-adt-fields
  (
    fields
  )
  (
    match fields
    (
      Nil Nil
    )
    (
      Cons f rest
      (
        Cons
        (
          substitute-in-adt-field f
        )
        (
          substitute-in-adt-fields rest
        )
      )
    )
  )
)
(
  defn substitute-in-adt-variants
  (
    variants
  )
  (
    match variants
    (
      Nil Nil
    )
    (
      Cons v rest
      (
        Cons
        (
          AV
          (
            AV.name v
          )
          (
            substitute-in-adt-fields
            (
              AV.fields v
            )
          )
        )
        (
          substitute-in-adt-variants rest
        )
      )
    )
  )
)
(
  defn substitute-in-adt
  (
    expr
  )
  (
    match
    (
      Expr.inner expr
    )
    (
      EDeftype name variants d21 bound
      (
        Expr
        (
          EDeftype name
          (
            substitute-in-adt-variants variants
          )
          Nil bound
        )
      )
    )
    (
      d1
      (
        substitute-in-expr expr
      )
    )
  )
)
(
  defn annotate-first-param
  (
    params type_name
  )
  (
    match params
    (
      Nil Nil
    )
    (
      (
        Cons p rest
      )
      (
        Cons
        (
          P
          (
            P.name p
          )
          (
            Some type_name
          )
        )
        rest
      )
    )
  )
)
(
  defn monomorphize-push-instantiations
  (
    result instantiations
  )
  (
    match instantiations
    (
      Nil result
    )
    (
      Cons mono rest
      (
        monomorphize-push-instantiations
        (
          list-push result
          (
            Expr
            (
              MI.body mono
            )
          )
        )
        rest
      )
    )
  )
)
(
  defn monomorphize-push-impl-bodies
  (
    result trait_name type_name bodies
  )
  (
    match bodies
    (
      Nil result
    )
    (
      Cons body rest
      (
        let concrete-name
        (
          str-concat trait_name
          (
            str-concat
            "."
            (
              str-concat
              (
                DN.name body
              )
              (
                str-concat
                "_"
                type_name
              )
            )
          )
        )
        (
          let mut-params
          (
            annotate-first-param
            (
              DN.params body
            )
            type_name
          )
          (
            monomorphize-push-impl-bodies
            (
              list-push result
              (
                Expr
                (
                  EDefn concrete-name mut-params
                  (
                    DN.body body
                  )
                )
              )
            )
            trait_name type_name rest
          )
        )
      )
    )
  )
)
(
  defn monomorphize-one
  (
    ctx result expr
  )
  (
    match
    (
      Expr.inner expr
    )
    (
      EDefn name params body
      (
        if
        (
          kv-contains
          (
            mc-gen-fns ctx
          )
          name
        )
        (
          let generics
          (
            kv-get
            (
              mc-gen-fns ctx
            )
            name Nil
          )
          (
            let instantiations
            (
              generate-instantiations ctx name generics params body
            )
            (
              let r1
              (
                monomorphize-push-instantiations result instantiations
              )
              (
                let r2
                (
                  list-push r1 expr
                )
                (
                  list-push r2
                  (
                    substitute-in-expr expr
                  )
                )
              )
            )
          )
        )
        (
          list-push result
          (
            substitute-in-expr expr
          )
        )
      )
    )
    (
      ECall op args
      (
        let op-name
        (
          match
          (
            ast-ident-name
            (
              Expr.inner op
            )
          )
          (
            Some n n
          )
          (
            d1 nil
          )
        )
        (
          if
          (
            and op-name
            (
              kv-contains
              (
                mc-gen-fns ctx
              )
              op-name
            )
          )
          (
            let generics
            (
              kv-get
              (
                mc-gen-fns ctx
              )
              op-name Nil
            )
            (
              match
              (
                resolve-call-site ctx op-name generics args
              )
              (
                Some canonical-name
                (
                  list-push result
                  (
                    Expr
                    (
                      ECall
                      (
                        Expr
                        (
                          EAtom
                          (
                            AIdent canonical-name
                          )
                        )
                      )
                      args
                    )
                  )
                )
              )
              (
                d1
                (
                  list-push result
                  (
                    substitute-in-expr expr
                  )
                )
              )
            )
          )
          (
            list-push result
            (
              substitute-in-expr expr
            )
          )
        )
      )
    )
    (
      EApply fname args
      (
        if
        (
          kv-contains
          (
            mc-gen-fns ctx
          )
          fname
        )
        (
          match
          (
            resolve-call-site ctx fname
            (
              kv-get
              (
                mc-gen-fns ctx
              )
              fname Nil
            )
            args
          )
          (
            Some canonical-name
            (
              list-push result
              (
                Expr
                (
                  EApply canonical-name args
                )
              )
            )
          )
          (
            d1
            (
              list-push result
              (
                substitute-in-expr expr
              )
            )
          )
        )
        (
          list-push result
          (
            substitute-in-expr expr
          )
        )
      )
    )
    (
      EDeftype name variants d22 bound
      (
        let acc0 result
        (
          let subresult
          (
            substitute-in-adt expr
          )
          (
            list-push acc0 subresult
          )
        )
      )
    )
    (
      EImplBlock trait_name type_name bodies
      (
        let acc0 result
        (
          let r1
          (
            monomorphize-push-impl-bodies acc0 trait_name type_name bodies
          )
          (
            list-push r1 expr
          )
        )
      )
    )
    (
      d23
      (
        let acc0 result
        (
          let subresult
          (
            substitute-in-expr expr
          )
          (
            list-push acc0 subresult
          )
        )
      )
    )
  )
)
(
  defn monomorphize-loop
  (
    ctx result exprs
  )
  (
    match exprs
    (
      Nil result
    )
    (
      Cons expr rest
      (
        monomorphize-loop ctx
        (
          monomorphize-one ctx result expr
        )
        rest
      )
    )
  )
)
(
  defn monomorphize
  (
    ctx exprs
  )
  (
    list-reverse
    (
      monomorphize-loop ctx Nil exprs
    )
  )
)
(
  defn mono-context-new
  (
    inferer
  )
  (
    MC Nil Nil Nil Nil Nil Nil Nil Nil
  )
)
(
  defn kv-keys
  (
    binds
  )
  (
    match binds
    (
      Nil Nil
    )
    (
      Cons hd rest
      (
        match hd
        (
          MK k d24
          (
            Cons k
            (
              kv-keys rest
            )
          )
        )
      )
    )
  )
)
