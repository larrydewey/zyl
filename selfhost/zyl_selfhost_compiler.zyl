    )
    (
      Cons h d1 h
    )
  )
)
(
  defn mr-collect-uses
  (
    forms
  )
  (
    match forms
    (
      Nil Nil
    )
    (
      Cons e rest
      (
        match
        (
          Expr.inner e
        )
        (
          EUseModule parts d1 d2
          (
            Cons
            (
              mr-use-name parts
            )
            (
              mr-collect-uses rest
            )
          )
        )
        (
          d3
          (
            mr-collect-uses rest
          )
        )
      )
    )
  )
)
(
  defn mr-strip-use
  (
    forms
  )
  (
    match forms
    (
      Nil Nil
    )
    (
      Cons e rest
      (
        match
        (
          Expr.inner e
        )
        (
          EUseModule d1 d2 d3
          (
            mr-strip-use rest
          )
        )
        (
          EModuleDecl d4
          (
            mr-strip-use rest
          )
        )
        (
          EExport d5
          (
            mr-strip-use rest
          )
        )
        (
          d6
          (
            Cons e
            (
              mr-strip-use rest
            )
          )
        )
      )
    )
  )
)
(
  defn mr-parse-file
  (
    arena path
  )
  (
    let fd
    (
      file-open path
      "r"
    )
    (
      let srcbuf
      (
        file-read fd 1048576
      )
      (
        let d1
        (
          file-close fd
        )
        (
          convert-ast-list
          (
            zyl-parse arena srcbuf
          )
        )
      )
    )
  )
)
(
  defn mr-module-path
  (
    name
  )
  (
    str-concat
    "stdlib/"
    (
      str-concat name
      ".zyl"
    )
  )
)
(
  defn mr-resolve-module
  (
    arena name acc
  )
  (
    match acc
    (
      MRAcc exprs resolved
      (
        if
        (
          >
          (
            mr-str-in-list name resolved
          )
          0
        )
        acc
        (
          let file-exprs
          (
            mr-parse-file arena
            (
              mr-module-path name
            )
          )
          (
            let uses
            (
              mr-collect-uses file-exprs
            )
            (
              let acc2
              (
                mr-resolve-uses arena uses
                (
                  MRAcc exprs
                  (
                    Cons name resolved
                  )
                )
              )
              (
                match acc2
                (
                  MRAcc exprs2 resolved2
                  (
                    MRAcc
                    (
                      list-append exprs2
                      (
                        mr-strip-use file-exprs
                      )
                    )
                    resolved2
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
(
  defn mr-resolve-uses
  (
    arena names acc
  )
  (
    match names
    (
      Nil acc
    )
    (
      Cons n rest
      (
        mr-resolve-uses arena rest
        (
          mr-resolve-module arena n acc
        )
      )
    )
  )
)
(
  defn mr-core-loaded
  (
    uses
  )
  (
    match uses
    (
      Nil 0
    )
    (
      Cons u rest
      (
        if
        (
          >
          (
            str-eq u
            "core/core"
          )
          0
        )
        1
        (
          if
          (
            >
            (
              str-eq u
              "core/option"
            )
            0
          )
          1
          (
            if
            (
              >
              (
                str-eq u
                "core/result"
              )
              0
            )
            1
            (
              mr-core-loaded rest
            )
          )
        )
      )
    )
  )
)
(
  defn mr-resolve-program
  (
    arena main-exprs
  )
  (
    let uses
    (
      mr-collect-uses main-exprs
    )
    (
      let uses2
      (
        if
        (
          is-nil uses
        )
        uses
        (
          if
          (
            >
            (
              mr-core-loaded uses
            )
            0
          )
          uses
          (
            Cons
            "core/core"
            uses
          )
        )
      )
      (
        let acc
        (
          mr-resolve-uses arena uses2
          (
            MRAcc Nil Nil
          )
        )
        (
          match acc
          (
            MRAcc dep-exprs d1
            (
              list-append dep-exprs
              (
                mr-strip-use main-exprs
              )
            )
          )
        )
      )
    )
  )
)
