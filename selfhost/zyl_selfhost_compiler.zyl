(
  defn unify-types
  (
    t1 t2
  )
  (
    cond
    (
      (
        = t1 t2
      )
      true
    )
    (
      (
        = t1
        (
          TVar 0 TUnit
        )
      )
      true
    )
    (
      (
        = t2
        (
          TVar 0 TUnit
        )
      )
      true
    )
    (
      (
        = t1
        (
          TCap
          (
            TVar 0 TUnit
          )
        )
      )
      true
    )
    (
      (
        = t2
        (
          TCap
          (
            TVar 0 TUnit
          )
        )
      )
      true
    )
    (
      (
        = t1 TInt
      )
      (
        = t2 TFloat
      )
