    let sorted-keys
    (
      str-sort
      (
        kv-keys type-map
      )
    )
    (
      let unique-sorted
      (
        str-sort
        (
          str-dedup
          (
            kv-type-names type-map sorted-keys
          )
        )
      )
      (
        str-concat base-name
        (
          str-concat
          "_"
          (
            str-join unique-sorted
            "_"
          )
        )
      )
    )
