  )
  (
    TkFloat String
  )
  (
    TkString String
  )
  (
    TkBool Bool
  )
  (
    TkSymbol String
  )
  (
    TkKeyword String
  )
  (
    TkLParen
  )
  (
    TkRParen
  )
  (
    TkLBrace
  )
  (
    TkRBrace
  )
  (
    TkLBracket
  )
  (
    TkRBracket
  )
  (
    TkColon
  )
)
(
  deftype Ast
  (
    AIdent String
  )
  (
    AInt Int
  )
  (
    AFloat String
  )
  (
    AString String
  )
  (
    ABool Bool
  )
  (
    AList
    (
      List Ast
    )
  )
)
(
  deftype Env
  (
    EnvBind String Int Int Env
  )
  (
    EnvNil
  )
)
(
  defn env-lookup
  (
    env name
  )
  (
    match env
    (
      EnvBind n off d1 rest
      (
        if
        (
          str-eq n name
        )
        off
        (
          env-lookup rest name
        )
      )
    )
    (
      EnvNil 0
    )
  )
)
(
  defn env-kind-of
  (
    env name
  )
  (
    match env
    (
      EnvBind n d2 k rest
      (
        if
        (
          str-eq n name
        )
        k
        (
          env-kind-of rest name
        )
      )
    )
    (
      EnvNil 0
    )
  )
)
(
  deftype VTable
  (
    VTEntry String Int Int VTable
  )
  (
    VTNil
  )
)
(
  defn vt-tag-of
  (
    vt name
  )
  (
    match vt
    (
      VTEntry n tag d3 rest
      (
        if
        (
          str-eq n name
        )
        tag
        (
          vt-tag-of rest name
        )
      )
    )
    (
      VTNil -1
    )
  )
)
(
  defn vt-arity-of
  (
    vt name
  )
  (
    match vt
    (
      VTEntry n d4 ar rest
      (
        if
        (
          str-eq n name
        )
        ar
        (
          vt-arity-of rest name
        )
      )
    )
    (
      VTNil -1
    )
  )
)
(
  defn toks-head
  (
    toks
  )
  (
    match toks
    (
      Cons t d5 t
    )
    (
      Nil
      (
        TkEof
      )
    )
  )
)
(
  defn toks-tail
  (
    toks
  )
  (
    match toks
    (
      Cons d6 rest rest
    )
    (
      Nil Nil
    )
  )
)
