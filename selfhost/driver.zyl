; === Zyl Self-Hosting Boot Driver ===
; Reads Zyl source, lowers it to ICNF, emits x86_64 assembly.
; Boot input/output paths are fixed for stage1 determinism.

(use allocator/allocator)
(use compiler/lexer)
(use compiler/parser)
(use compiler/ast)
(use compiler/expr_inner)
(use compiler/icnf)
(use compiler/codegen)

; Boot driver with type inference + region inference in the pipeline.
; Pipeline: lexer → parser → Ast → ExprInner (bridge) → type inference
;           → region inference → monomorphization → ICNF → codegen

(defn type-region-infer (inferer exprs)
  ; Run type inference then region inference on the expr list.
  ; Returns a list of Expr (typed, region-annotated) ready for ICNF.
  (let (typed (collect-definitions (inferer-new) exprs))
    (let (regioned (inferer-new)
          _ (infer-region-infer regioned typed))
      typed)))

(defn infer-region-infer (inferer typed)
  ; Stub: full region inference will be wired in later.
  ; For now, just return the typed expression list.
  (match typed
    (Nil Nil)
    ((Pair e rest)
      (cons
        e
        (infer-region-infer inferer rest)))))

(defn dbg-log (msg)
  (let f (file-open "/tmp/dbg" "a")
    (let d1 (file-write f msg)
      (file-close f))))

(defn emit-out (arena fns)
  (let st (cg-program (cg-new arena) fns)
    (let buf (cg-buffer st)
      (let blen (alloc-strlen buf)
        ; Guard: buffer capacity is 64MB; refuse to write anything that
        ; came within 1MB of it (silent arena corruption otherwise).
        (if (> blen 66060288)
          (ffi-call "f_error" "E_CODEGEN_BUFFER_FULL: generated assembly exceeded the codegen buffer" 1000)
          (let out (file-open "/tmp/zyl_boot_out.s" "w")
            (let n (file-write out buf)
              (let d3 (file-close out)
                n))))))))

(defn boot-run (arena fd)
  (let srcbuf (file-read fd 1048576)
    (let d2 (file-close fd)
      (dbg-log "parse\n")
      (let prog (zyl-parse arena srcbuf)
        (dbg-log "bridge\n")
        (let exprs (convert-ast prog)
          (dbg-log "type-infer\n")
          (let typed (collect-definitions (inferer-new) (to-expr-list exprs))
            (dbg-log "lower\n")
            (let fns (ic-program arena typed)
              (dbg-log "codegen\n")
              (emit-out arena fns))))))))

(defn main ()
  (let arena (arena-create 1073741824)
    (let fd (file-open "/tmp/zyl_boot_in.zyl" "r")
      (if (> fd 0)
        (boot-run arena fd)
        (begin
          (dbg-log "no input\n")
          1)))))

