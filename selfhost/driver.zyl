; === Zyl Self-Hosting Boot Driver ===
; Reads Zyl source, lowers it to ICNF, emits x86_64 assembly.
; Boot input/output paths are fixed for stage1 determinism.

(use allocator/allocator)
(use compiler/lexer)
(use compiler/parser)
(use compiler/ast)
(use compiler/expr_inner)
(use compiler/module_resolver)
(use compiler/macro_expand)
(use compiler/monomorphization)
(use compiler/contract_injection)
(use compiler/region_inference)
(use compiler/icnf)
(use compiler/trait_dispatch)
(use compiler/closure_inline)
(use compiler/assert_lowering)
(use compiler/optimization)
(use compiler/codegen)

(def __zyl_boot_bundle 1)

; Pipeline: lexer → parser → Ast → ExprInner → type inference
;           → monomorphization → ICNF → codegen

(defn dbg-log (msg)
  (let f (file-open "/tmp/dbg" "a")
    (let d1 (file-write f msg)
      (file-close f))))

(defn emit-out (arena fns)
  (let st (cg-program (cg-new arena) fns)
    (let buf (cg-buffer st)
      (let blen (alloc-strlen buf)
        (if (> blen 66060288)
          (ffi-call "zyl_f_error" "E_CODEGEN_BUFFER_FULL: generated assembly exceeded the codegen buffer" 1000)
          (let out (file-open "/tmp/zyl_boot_out.s" "w")
            (let n (file-write out buf)
              (let d3 (file-close out)
                n))))))))

(defn boot-run (arena fd)
  (let srcbuf (file-read fd 1048576)
    (let d2 (file-close fd)
      (dbg-log "parse\n")
      (let prog (zyl-parse arena srcbuf)
        (dbg-log "bridge\n")
        (let exprs0 (convert-ast-list prog)
          (dbg-log "modules\n")
          (let exprs1 (mr-resolve-program arena exprs0)
          (dbg-log "macros\n")
          (let exprs (me-expand-program exprs1)
(dbg-log "type-infer\n")
        (let inferer (collect-definitions (inferer-new) exprs)
          (dbg-log "contract-injection\n")
          ; Real contract injection (stdlib/compiler/contract_injection.zyl)
          ; is NOT wired in here: that module's accessors/constructors
          ; (d-name, t-name, TestNode, ...) don't match the actual
          ; DefnNode/TestDecl/TestSuiteNode shapes in expr_inner.zyl, so it
          ; doesn't compile as part of the bundle. It was silently omitted
          ; from assemble.py's file list, and this call used to read
          ; "ci-expand-program" (1 arg) -- which, once the bundle was
          ; assembled, actually resolved to closure_inline.zyl's SAME-NAMED
          ; but different-arity `ci-expand-program(arena, prog)` function
          ; instead (a genuine duplicate-symbol collision), silently
          ; passing garbage through the mismatched second argument
          ; register. That corrupted state downstream and crashed the
          ; self-hosted binary (ic-collect-vt-run) even on trivial input.
          ; Pass exprs through unchanged until contract injection is
          ; properly rewritten to match the real deftypes.
          (let ci-exprs exprs
            (dbg-log "mono\n")
            (let mono-ctx (mono-context-populate-adt-order (mono-context-new inferer) inferer)
              (let mono-exprs (monomorphize mono-ctx ci-exprs)
                (dbg-log "trait-dispatch\n")
                (let td-exprs (td-expand-program mono-exprs)
                (dbg-log "closure-inline\n")
                (let ci-exprs (ci-expand-program arena td-exprs)
                (dbg-log "assert-lowering\n")
                (let al-exprs (al-expand-program ci-exprs)
                (dbg-log "lower\n")
                (let fns (ic-program arena al-exprs)
                    (dbg-log "optimize
")
                    (let opt-fns (opt-optimize fns)
                      (dbg-log "region-infer
")
                      (let ri (ri-new)
                        (let ri2 (ri-infer opt-fns ri)
                          (dbg-log "codegen
")
                          (emit-out arena opt-fns)))))))))))))))))))

(defn main ()
  (let arena (arena-create 1073741824)
    (let fd (file-open "/tmp/zyl_boot_in.zyl" "r")
      (if (> fd 0)
        (boot-run arena fd)
        (begin
          (dbg-log "no input\n")
          1)))))
