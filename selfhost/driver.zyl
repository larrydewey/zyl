; === Zyl Self-Hosting Boot Driver ===
; Reads Zyl source, lowers it to ICNF, emits x86_64 assembly.
; Boot input/output paths are fixed for stage1 determinism.

(use allocator/allocator)
(use compiler/lexer)
(use compiler/parser)
(use compiler/ast)
(use compiler/expr_inner)
(use compiler/monomorphization)
(use compiler/icnf)
(use compiler/codegen)

; Pipeline: lexer → parser → Ast → ExprInner → type inference
;           → monomorphization → ICNF → codegen

(defn dbg-log (msg)
  (let f (file-open "/tmp/dbg" "a")
    (let d1 (file-write f msg)
      (file-close f))))

(defn emit-out (arena fns)
  (let st (cg-program (cg-new arena) fns)
    (let buf (cg-buffer st)
      (let blen (alloc-strlen buf)
        (if (> blen 66060288)
          (ffi-call "f_error" "E_CODEGEN_BUFFER_FULL: generated assembly exceeded the codegen buffer" 1000)
          (let out (file-open "/tmp/zyl_boot_out.s" "w")
            (let n (file-write out buf)
              (let d3 (file-close out)
                n))))))))

(defn boot-run (arena fd)
  (let srcbuf (file-read fd 1048576)
    (let d2 (file-close fd)
      (dbg-log "parse\n")
      (let prog (zyl-parse arena srcbuf)
        (dbg-log "bridge\n")
        (let exprs (convert-ast-list prog)
          (dbg-log "type-infer\n")
          (let inferer (collect-definitions (inferer-new) exprs)
            (dbg-log "mono\n")
            (let mono-ctx (mono-context-new inferer)
              (let mono-exprs (monomorphize mono-ctx exprs)
                (dbg-log "lower\n")
                (let fns (ic-program arena mono-exprs)
                  (dbg-log "codegen\n")
                  (emit-out arena fns))))))))))

(defn main ()
  (let arena (arena-create 1073741824)
    (let fd (file-open "/tmp/zyl_boot_in.zyl" "r")
      (if (> fd 0)
        (boot-run arena fd)
        (begin
          (dbg-log "no input\n")
          1)))))
