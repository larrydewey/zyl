; === Zyl Self-Hosting Boot Driver ===
; Reads Zyl source, lowers it to ICNF, emits x86_64 assembly.
;
; Two entry protocols:
;   1. Real CLI (argv, via zyl_save_args in the entry stub): `zyl <src.zyl>
;      [-o out] [--emit-asm]`. Chdirs to argv[0]'s directory first so
;      `(use module/name)` resolves `stdlib/module/name.zyl` relative to
;      the compiler binary's own bundle dir, not the caller's cwd.
;   2. Legacy fixed-path protocol (`argc < 2`): reads
;      /tmp/zyl_boot_in.zyl, writes /tmp/zyl_boot_out.s; a dependency-free smoke path.

(numeric checked)
(use compiler/node_tables)
(use compiler/rt_mode)
(use allocator/allocator)
(use compiler/lexer)
(use compiler/parser)
(use compiler/ast)
(use compiler/expr_inner)
(use compiler/module_resolver)
(use compiler/capability_check)
(use compiler/cli)
(use compiler/index)
(use compiler/lock)
(use compiler/mvs)
(use compiler/package)
(use compiler/store)
(use compiler/workspace)
(use compiler/macro_expand)
(use compiler/mutability_check)
(use compiler/arity_check)
(use compiler/duplicate_check)
(use compiler/exhaustiveness_check)
(use compiler/unused_check)
(use compiler/secret_check)
(use compiler/lift_impls)
(use compiler/region_inference)
(use compiler/icnf)
(use compiler/closure_inline)
(use compiler/optimization)
(use compiler/codegen)
(use compiler/pipeline)
(use compiler/explain)
(use text/format)
(use compiler/icnf_print)
(use compiler/doc)
(use repl/repl)
(use repl/interp)
(use compiler/sexp_balance)
(use compiler/error_codes)
(use compiler/error_report)
(use compiler/elf_link)
(use compiler/provenance)

(def __zyl_boot_bundle 1)

; Pipeline (compiler/pipeline): balance check → lexer/parser → module
;           resolution → macro expansion → checks → derive → impl lifting
;           → closure lifting → type checking → ICNF → optimization
;           → region inference → reuse → codegen

; The pipeline itself (parse, resolve, check, lower, codegen) lives in
; compiler/pipeline now, so the REPL can run the same phases and stop at
; ICNF instead of assembly. This file is the CLI around it: argument
; handling, path resolution, the package subcommands and linking.

; ===========================================================================
; LEGACY FIXED-PATH PROTOCOL (argc < 2)
; ===========================================================================

(defn boot-run (arena fd)
  (let srcbuf (sb-read-all fd "")
    (let _ (file-close fd)
      (let buf (compile-to-asm arena srcbuf "/tmp/zyl_boot_in.zyl")
        (let out (file-open "/tmp/zyl_boot_out.s" "w")
          (let n (file-write out buf)
            (let _ (file-close out)
              n)))))))

(defn boot-run-legacy (arena)
  (let fd (file-open "/tmp/zyl_boot_in.zyl" "r")
    (if (> fd 0)
      (boot-run arena fd)
      (begin
        (dbg-log "no input\n")
        1))))

; ===========================================================================
; REAL CLI (argc >= 2): `zyl <src.zyl> [-o out] [--emit-asm]`
; ===========================================================================

(defn cli-write-file (path content)
  (let out (file-open path "w")
    (let _ (file-write out content)
      (file-close out))))

(defn cli-is-absolute (path)
  (= (ffi-call "zyl_cstr_byte_at" path 0 1000) 47))

; Resolve `path` against `cwd` unless it's already absolute.
(defn cli-resolve-path (cwd path)
  (if (cli-is-absolute path)
    path
    (str-concat cwd (str-concat "/" path))))

; The last `k` characters of `s`, as a string.
(defn cli-tail-of (s k) (str-substring s (- (str-len s) k) (str-len s)))

(defn cli-in-list (x xs)
  (match xs
    (Nil false)
    (Cons h t (if (= x h) true (cli-in-list x t)))))

; The compiler, the LSP, the REPL and the compiler's own tests are the only
; entries that hold a long-lived Arena: the parse tree and the REPL scratch
; outlive any single frame, so they cannot use a call's frame region.
; A user program is not in this list, so it cannot obtain an Arena.
(def cli-internal-entries
  (Cons "selfhost/driver.zyl"
  (Cons "selfhost/lsp_main.zyl"
  (Cons "tools/repl.zyl"
  (Cons "regression/compiler.zyl"
  (Cons "regression/balance-agreement.zyl"
  (Cons "regression/runtime-blake3.zyl"
  (Cons "regression/runtime-crypto.zyl"
  (Cons "regression/runtime-tables.zyl"
  (Cons "regression/package-system.zyl"
  (Cons "regression/collections.zyl"
  (Cons "integration/parser-verify.zyl"
  (Cons "integration/pv_min.zyl"
  (Cons "integration/selfhost-codegen.zyl"
  (Cons "integration/math-protocol.zyl"
  (Cons "unit_test.zyl" Nil))))))))))))))))


(defn cli-ends-with-zyl (s)
  (let n (str-len s)
    (if (< n 4)
      false
      (str-eq (str-substring s (- n 4) 4) ".zyl"))))

; Default output path when no `-o`/positional out is given: strip a
; trailing ".zyl" from the source path, else append ".out".
(defn cli-default-out (src)
  (if (cli-ends-with-zyl src)
    (str-substring src 0 (- (str-len src) 4))
    (str-concat src ".out")))

(deftype CliOpts (CliOpts String Int)) ; out-path ("" = unset), emit-asm-flag

; Scan argv[i..argc) for `-o <path>` / `--emit-asm` / a bare positional
; (treated as the out path). Unrecognized bare tokens simply become the
; out path too (last one wins) — kept deliberately simple.
(defn cli-parse-opts (i argc acc)
  (if (>= i argc)
    acc
    (let a (ffi-call "zyl_arg_str" i 1000)
      (if (str-eq a "--emit-asm")
        (match acc (CliOpts out _ (cli-parse-opts (+ i 1) argc (CliOpts out 1))))
      (if (str-eq a "--runtime-module")
        (match acc (CliOpts out _ (cli-parse-opts (+ i 1) argc (CliOpts out 2))))
      (if (or (str-eq a "--error-format=json") (drv-contracts-flag-p a))
        (cli-parse-opts (+ i 1) argc acc)
        (if (str-eq a "-o")
          (let nxt (ffi-call "zyl_arg_str" (+ i 1) 1000)
            (match acc (CliOpts _ flag (cli-parse-opts (+ i 2) argc (CliOpts nxt flag)))))
          (match acc (CliOpts _ flag (cli-parse-opts (+ i 1) argc (CliOpts a flag)))))))))))

; Link `asmpath` into a binary at `outpath` via the system `cc`, expecting
; rt.o next to it (cwd is the bundle dir at this point).
(defn cli-link (asmpath outpath)
  (cli-link-with asmpath outpath ""))

; `extra` carries a package's native objects and libraries (SS31.10),
; already quoted by compiler/cli; an ordinary single-file compile passes
; the empty string and the command is what it always was.
; Freestanding links go through the Zyl assembler + ELF linker (no cc/as/ld) over the cached runtime rt.zo; ZYL_EXTERNAL_LD=1 uses cc.
(defn cli-freestanding-p (extra)
  (and (= (str-length extra) 0)
    (and (not (rt-foreign-p))
      (= (str-length (ffi-call "zyl_getenv_str" "ZYL_EXTERNAL_LD" 1000)) 0))))

(defn cli-link-with (asmpath outpath extra)
  (if (cli-freestanding-p extra)
    (el-link asmpath "rt.s" "start.s" "rt.zo" outpath)
    (ffi-call "zyl_exec_cmd" (cli-link-command asmpath outpath extra) 1000)))

; Same command, run as a CHILD: a package build has work left to do after
; linking (zyl.buildinfo, and `zyl test` runs the binary), and
; zyl_exec_cmd's execl would end the process here.
(defn cli-link-child (asmpath outpath extra)
  (if (cli-freestanding-p extra)
    (el-link asmpath "rt.s" "start.s" "rt.zo" outpath)
    (ffi-call "zyl_system_cmd" (cli-link-command asmpath outpath extra) 1000)))

; Freestanding (start.o + rt.o, static, no libc) unless the program calls foreign code or links native objects.
(defn cli-link-command (asmpath outpath extra)
  (if (and (= (str-length extra) 0) (not (rt-foreign-p)))
    (str-concat "cc -nostdlib -static -no-pie " (str-concat asmpath (str-concat " start.o rt.o -o " outpath)))
    (cli-link-hosted asmpath outpath extra)))

; Links rt.o over libc's crt.
(defn cli-link-hosted (asmpath outpath extra)
  (str-concat "cc "
    (str-concat "-no-pie "
      (str-concat asmpath
        (str-concat " rt.o -o "
          (str-concat outpath (str-concat " -lpthread" extra)))))))

; Where to find `rt.o` and `stdlib/` at runtime. Prefers a
; real, packaged install (checked via a ZYL_HOME override, else
; $HOME/.zyl) over "next to argv0" -- the latter only works for this
; repo's own dev/build workflow (build/boot/ carries its own stdlib +
; rt.o copies alongside the binary), and breaks the moment
; this is ever packaged for a real Linux distro: package managers
; install executables into /usr/bin/ alongside a hundred unrelated
; packages' binaries and never let a package drop support files right
; next to them there. $HOME/.zyl matches the well-established per-user
; toolchain convention (~/.cargo, ~/.rustup, ~/.pyenv, ...), sidesteps
; that packaging problem entirely, and needs no compile-time-baked
; install prefix to work correctly the first time it's actually
; packaged. Falls back to the argv0-relative bundledir whenever
; $HOME/.zyl (or ZYL_HOME) isn't a real, populated install -- so this
; repo's own build/boot/zyl-self keeps working unchanged for anyone who
; hasn't installed anything.
(defn cli-zyl-home-candidate ()
  (let zh (ffi-call "zyl_getenv_str" "ZYL_HOME" 1000)
    (if (> (str-length zh) 0)
      zh
      (let home (ffi-call "zyl_getenv_str" "HOME" 1000)
        (if (> (str-length home) 0) (str-concat home "/.zyl") "")))))

(defn cli-resolve-bundledir (argv0dir)
  (let candidate (cli-zyl-home-candidate)
    (if (> (str-length candidate) 0)
      (if (ffi-call "zyl_path_exists" (str-concat candidate "/stdlib") 1000)
        candidate
        argv0dir)
      argv0dir)))

(defn cli-run (arena)
  (let cwd (ffi-call "zyl_getcwd" 1000)
    (let argv0 (ffi-call "zyl_arg_str" 0 1000)
      (let bundledir (cli-resolve-bundledir (ffi-call "zyl_dirname_cstr" argv0 1000))
        (let srcraw (ffi-call "zyl_arg_str" 1 1000)
          (let src (cli-resolve-path cwd srcraw)
            (let argc (ffi-call "zyl_argc" 1000)
              (let opts (cli-parse-opts 2 argc (CliOpts "" 0))
                (match opts
                  (CliOpts outraw emitflag
                    (let outbase
                      (if (> (str-len outraw) 0)
                        (cli-resolve-path cwd outraw)
                        (cli-default-out src))
                      (let _ (if (= emitflag 2) (cli-runtime-module src bundledir) unit)
                      (let _ (cli-internal-mode src) unit)
                      (let _ (ffi-call "zyl_chdir" bundledir 1000)
                        (let fd (file-open src "r")
                          (if (> fd 0)
                            (let srcbuf (sb-read-all fd "")
                              (let _ (file-close fd)
                                (let buf (compile-to-asm arena srcbuf src)
                                  (if (> emitflag 0)
                                    (cli-write-file outbase buf)
                                    (let asmpath (str-concat outbase ".s")
                                      (let _ (cli-write-file asmpath buf)
                                        (cli-link asmpath outbase)))))))
                            (begin
                              (print "zyl: error: cannot open source file")
                              1))))))))))))))))

;; Internal mode is keyed on the entry source, not a flag, so a seed that
; predates it still compiles the driver: the driver is what sets it.
; Whether some suffix of `src` is a listed internal entry. Probing every
; length avoids any path arithmetic: str-substring on a length is exact,
; and the longest listed name is 32 characters.
(defn cli-internal-entry-p (src)
  (cli-suffix-in src 32))

(defn cli-suffix-in (src k)
  (if (< k 1)
    false
    (if (cli-in-list (cli-tail-of src k) cli-internal-entries)
      true
      (cli-suffix-in src (- k 1)))))

(defn cli-internal-mode (src)
  (if (cli-internal-entry-p src)
    (internal-mode-set)
    unit))

; `--runtime-module` (boot.sh only): the entry must be the bundle's runtime/rt/rt.zyl.
(defn cli-runtime-module (src bundledir)
  (if (str-eq src (str-concat bundledir "/runtime/rt/rt.zyl"))
    (rt-mode-set)
    (ffi-call "zyl_panic" "E_FFI_RESTRICTED: --runtime-module compiles only the bundled runtime/rt/rt.zyl" 1000)))

; ===========================================================================
; `zyl eval <file.zyl>` — run a program without building one
; ===========================================================================
;
; The same phases as a compile, stopping at ICNF, with the result
; evaluated in this process (stdlib/repl/interp) instead of turned into
; assembly. No binary is produced and no linker runs, which makes it the
; quick way to run a script -- and the way the regression suite checks
; that the interpreter and the code generator agree, by running the same
; program both ways and diffing the output.
(defn drv-eval (arena cwd)
  (let src (cli-resolve-path cwd (drv-arg 2))
    (let fd (file-open src "r")
      (let _ (if (> fd 0) (cli-internal-mode src) unit)
      (if (< fd 1)
        (begin
          (print "zyl: error: cannot open source file")
          1)
        (let srcbuf (sb-read-all fd "")
          (begin
            (file-close fd)
            (drv-eval-src arena srcbuf src))))))))

(defn drv-eval-src (arena srcbuf src)
  (let fns (compile-to-fns arena srcbuf src)
    (in-run-main fns)))

; ===========================================================================
; PACKAGE SUBCOMMANDS (spec v5.0 SS31.11)
; ===========================================================================
; `zyl new | add | fetch | build | test | update | vendor | audit`
; `zyl publish | key`
;
; A first argument that names a file (or an option) still means "compile
; this", which is how every existing script and this repo's own boot
; invoke the compiler. Anything else is a subcommand.

(defn drv-is-subcommand (a)
  (if (cli-ends-with-zyl a)
    false
    (if (= (ffi-call "zyl_cstr_byte_at" a 0 1000) 45)
      false
      true)))

(defn drv-arg (i)
  (let argc (ffi-call "zyl_argc" 1000)
    (if (< i argc) (ffi-call "zyl_arg_str" i 1000) "")))

(defn drv-has-flag (i flag)
  (if (>= i (ffi-call "zyl_argc" 1000))
    false
    (if (str-eq (drv-arg i) flag) true (drv-has-flag (+ i 1) flag))))

; `--sign-with path` anywhere in the arguments, or "" when absent.
;
; A path and not a seed, so the key is never on a command line where it lands in
; a shell history and in `ps`. The file holds 64 hex characters and nothing
; else, the same file `zyl key` writes.
(defn drv-flag-value (i flag)
  (if (>= i (ffi-call "zyl_argc" 1000))
    ""
    (if (str-eq (drv-arg i) flag) (drv-arg (+ i 1)) (drv-flag-value (+ i 1) flag))))

; The Ed25519 seed in a key file, or "" when the file is not there.
;
; Trimmed, because a file written by `zyl key` and one edited by hand differ by
; a newline and a seed with one is 64 characters that do not decode. An empty
; result means the caller asked for a key that is not present, which is an
; error rather than an unsigned build: someone who asked to sign and silently
; got an unsigned binary has been given the opposite of what they asked for.
(defn drv-read-seed-file (path)
  (let fd (file-open path "r")
    (if (< fd 1)
      ""
      (let s (file-read fd 4096)
        (let _ (file-close fd)
          (drv-trim s))))))

(defn drv-trim (s)
  (let n (str-length s)
    (if (or (= n 0) (not (= (str-substring s (- n 1) 1) "\n")))
      s
      (str-substring s 0 (- n 1)))))

; Fail the build rather than produce an unsigned binary.
(defn drv-sign-requires-key (path)
  (ffi-call "zyl_panic"
    (str-concat "E_PROV_ATTACH: --sign-with " (str-concat path
      ": no key file, and a build that cannot sign must not pass for one that did")) 1000))

; The package root for a subcommand: the nearest directory at or above
; the working directory that carries a zyl.pkg. A tool that guessed
; differently from the compiler would resolve a different graph than the
; one it built.
(defn drv-package-dir (cwd depth)
  (if (ffi-call "zyl_path_exists" (str-concat cwd "/zyl.pkg") 1000)
    cwd
    (if (< depth 1)
      (ffi-call "zyl_panic"
        (str-concat "E_MANIFEST_NOT_FOUND: package: no zyl.pkg at or above " cwd) 1000)
      (drv-package-dir (ffi-call "zyl_dirname_cstr" cwd 1000) (- depth 1)))))

; The module a package builds: the one named by the last segment of the
; package name, which is also what `(use <pkg>)` reaches (SS31.4).
(defn drv-entry-module (arena dir)
  (let m (pk-read-manifest arena (str-concat dir "/zyl.pkg"))
    (str-concat dir (str-concat "/" (str-concat (pk-last-segment (mf-name m)) ".zyl")))))

(defn drv-output-path (arena dir)
  (let m (pk-read-manifest arena (str-concat dir "/zyl.pkg"))
    (str-concat dir (str-concat "/" (pk-last-segment (mf-name m))))))

; --locked: the lock must already describe exactly the graph the
; manifests imply, and the capability closure may not have grown
; (SS31.6, SS31.9).
(defn drv-check-locked (arena dir m nodes)
  (match (cli-read-lock arena dir)
    (Some l
      (let _ (drv-check-lock-entries arena l nodes)
        (cc-check-growth (lk-closure l)
                         (pk-caps-union (mf-capabilities m) (mvs-closure arena nodes Nil)))))
    (None (ffi-call "zyl_panic"
            "E_PKG_LOCK_STALE: package: --locked was given but there is no zyl.lock" 1000))))

(defn drv-check-lock-entries (arena l nodes)
  (match nodes
    (Nil 1)
    (Cons n t
      (match (lk-find l (mn-name n))
        (Some lp (drv-check-lock-version arena l lp n t))
        (None (ffi-call "zyl_panic"
                (str-concat "E_PKG_LOCK_STALE: package: " (str-concat (mn-name n)
                  " is required but absent from zyl.lock")) 1000))))))

(defn drv-check-lock-version (arena l lp n rest)
  (if (= (pv-cmp (lp-version lp) (mn-version n)) 0)
    (drv-check-lock-entries arena l rest)
    (ffi-call "zyl_panic"
      (str-concat "E_PKG_LOCK_STALE: package: " (str-concat (mn-name n)
        (str-concat " resolves to " (str-concat (pv-str arena (mn-version n))
          (str-concat " but zyl.lock records " (pv-str arena (lp-version lp))))))) 1000)))

; `zyl build`: resolve offline (SS31.7 -- a build never networks), check
; the graph against the lock when asked, compile the entry module and
; record what went into the binary (SS31.12).
(defn drv-build (arena dir locked)
  (let _ (drv-check-workspace arena dir)
    (drv-build-package arena dir locked)))

; §31.11: a member may depend on another member by path, but must still
; name the version that member's manifest declares — otherwise the member
; could not be published as it stands.
(defn drv-check-workspace (arena dir)
  (let root (ws-find-root dir 16)
    (if (= (str-length root) 0)
      true
      (ws-check-member-deps arena (ws-read arena root)))))

(defn drv-build-package (arena dir locked)
  (let m (pk-read-manifest arena (str-concat dir "/zyl.pkg"))
    (let nodes (mvs-resolve arena (cli-ctx-offline arena dir m) m dir)
      (let _ (if locked (drv-check-locked arena dir m nodes) 1)
        (let src (drv-entry-module arena dir)
          (let out (drv-output-path arena dir)
            (drv-compile-file arena src out dir nodes)))))))

;; Build cache (spec 31.4): a build whose inputs hash to a key already in
;; ~/.zyl/cache is copied from there. The key covers the compiler, the
;; contract profile, the lock, and every .zyl/.c/.h/zyl.pkg file of the
;; package, of each package in the graph and of the stdlib; compilation is
;; deterministic (spec 27), so equal keys mean equal binaries.
;; ZYL_NO_BUILD_CACHE=1 skips it.
;;
;; A SIGNED BUILD DOES NOT USE THE CACHE, in either direction. The cache is
;; keyed on the sources, and the trailer is not a function of the sources -- it
;; carries a signature, so the same package built with two keys gives two
;; different binaries and neither is the other's cache entry. Keying the cache
;; on the key would fix the read and leave the write wrong, because an unsigned
;; build would then populate an entry a signed one cannot use. So: no read, no
;; write, and the cache is not consulted at all when a key was supplied. Signing
;; is rare enough that this costs nothing that matters.
(defn drv-compile-file (arena src out dir nodes)
  (if (> (str-length (drv-get-seed)) 0)
    (drv-compile-uncached arena src out dir)
  (if (> (str-length (ffi-call "zyl_getenv_str" "ZYL_NO_BUILD_CACHE" 1000)) 0)
    (drv-compile-uncached arena src out dir)
    (let cdir (str-concat (store-home) (str-concat "/cache/" (drv-cache-key arena dir nodes)))
      (if (ffi-call "zyl_path_exists" (str-concat cdir "/bin") 1000)
        (drv-cache-copy (str-concat cdir "/bin") out (str-concat cdir "/buildinfo") (str-concat out ".buildinfo"))
        (let rc (drv-compile-uncached arena src out dir)
          (begin
            (if (= rc 0)
              (begin
                (store-mkdir cdir)
                (drv-cache-copy out (str-concat cdir "/bin") (str-concat out ".buildinfo") (str-concat cdir "/buildinfo")))
              0)
            rc)))))))

(defn drv-cache-copy (bin-from bin-to info-from info-to)
  (if (= (store-run (str-concat "cp -p '" (str-concat bin-from (str-concat "' '" (str-concat bin-to
        (str-concat "' && cp '" (str-concat info-from (str-concat "' '" (str-concat info-to "'"))))))))) 0)
    0
    1))

(defn drv-cache-key (arena dir nodes)
  (let prof (ffi-call "zyl_smap_get_or" contract-profiles "profile" "" 1000)
    (let text (str-concat (lk-compiler-self-hash arena)
                (str-concat "\n" (str-concat (if (= (str-length prof) 0) "strict" prof)
                  (str-concat "\n" (str-concat (drv-graph-hash arena dir)
                    (str-concat "\n" (str-concat (drv-tree-hash arena dir)
                      (str-concat "\n" (str-concat (drv-tree-hash arena "stdlib")
                        (drv-node-hashes arena nodes))))))))))
      (ffi-call "zyl_blake3_hex" arena text -1 32 1000))))

(defn drv-node-hashes (arena nodes)
  (match nodes
    (Nil "")
    (Cons n rest (str-concat "\n" (str-concat (mn-name n) (str-concat " " (str-concat (drv-tree-hash arena (mn-root n)) (drv-node-hashes arena rest))))))))

; BLAKE3 over `path:hash` for each source file under `root`, sorted.
(defn drv-tree-hash (arena root)
  (let list (ffi-call "zyl_list_files" root ".zyl .c .h .pkg" 1000)
    (ffi-call "zyl_blake3_hex" arena (drv-tree-lines arena root list 0) -1 32 1000)))

(defn drv-tree-lines (arena root list i)
  (let j (doc-line-end list i)
    (if (>= i j)
      ""
      (let rel (str-substring list i (- j i))
        (str-concat rel (str-concat ":" (str-concat (ffi-call "zyl_blake3_file_hex" arena (str-concat root (str-concat "/" rel)) 32 1000)
          (str-concat "\n" (drv-tree-lines arena root list (+ j 1))))))))))

(defn drv-compile-uncached (arena src out dir)
  (let fd (file-open src "r")
    (if (< fd 1)
      (begin
        (print (str-concat "zyl: error: cannot open " src))
        1)
      (let srcbuf (sb-read-all fd "")
        (let _ (file-close fd)
          (let m (pk-read-manifest arena (str-concat dir "/zyl.pkg"))
            (let objs (cli-native-objs arena dir m)
              (let fns (compile-to-fns arena srcbuf src)
                (let bi (drv-build-hashes arena dir objs fns)
                  (let buf (codegen-fns arena fns src)
                  (let asmpath (str-concat out ".s")
                    (let _ (cli-write-file asmpath (str-concat buf (drv-hash-section (bh-final bi))))
                      (let rc (cli-link-child asmpath out (cli-native-args m objs))
                        (let _ (drv-write-buildinfo arena dir out bi buf)
                          (let _ (drv-attach-provenance arena out bi buf)
                            rc)))))))))))))))

; ---------------------------------------------------------------------------
; Attaching provenance
; ---------------------------------------------------------------------------
;
; A REF, not a parameter. The seed would otherwise be threaded through five
; functions and every one of them would grow a parameter it does not otherwise
; care about, in a compiler whose output is a committed seed: every such change
; is a reseed, and a reseed for a signature that is off by default is a poor
; trade. A ref is read at exactly one place, and the build path for an unsigned
; build is unchanged -- which is the property that matters here, since an
; unsigned build has to stay byte-identical or the fixed point and every
; determinism test in the tree change with it.
; The initial value is "" and not 0 because zyl_ref_new is polymorphic and the
; literal fixes what it holds: a ref that started as an Int would make every
; later String assignment a type error, which is the compiler's own inference
; working correctly and a bad place to argue with it.
(def drv-seed (ffi-call "zyl_ref_new" "" 1000))

(defn drv-set-seed (s) (ffi-call "zyl_ref_set" drv-seed s 1000) unit)

(defn drv-get-seed () (ffi-call "zyl_ref_get" drv-seed 1000))

; Read `--sign-with` into the ref, or leave it empty.
;
; Empty is the normal case and the only one that is not an error: `zyl build`
; without the flag is an unsigned build, which is what it has always been. The
; error is the other direction -- a key file named but not readable produces a
; build failure rather than an unsigned binary, because a caller who asked for
; a signature and did not get one has been handed something that looks the same
; and means something weaker.
(defn drv-sign-from-args ()
  (let path (drv-flag-value 2 "--sign-with")
    (if (= (str-length path) 0)
      unit
      (let s (drv-read-seed-file path)
        (if (= (str-length s) 0)
          (drv-sign-requires-key path)
          (drv-set-seed s))))))

; Attach a signed trailer to the binary at `out`, when a key was supplied.
;
; Nothing happens without a key, and that is not a default to be sorry about: a
; build is unsigned unless someone asked for it to be signed, and the trailer's
; presence is what says which happened. There is no "unsigned trailer", because
; a record nobody vouched for is a claim (design doc, "why the evidence is the
; valuable half").
;
; The image's hash is taken here, over the file as linked and BEFORE the trailer
; exists, which is the whole hashing rule. The four SS31.12 inputs and the asm
; hash come from `bi` and `buf`, the same values `zyl.buildinfo` records, so the
; two files cannot disagree about what was built.
;
; THE NATIVE-OBJECT INPUT IS HASHED HERE. The other three inputs are already
; `blake3:` hashes; the fourth is the TEXT `drv-object-hashes` wrote --
; `("lib.c" "blake3:...")` per object, or nothing -- and the record's field is
; 32 bytes. Handing it the text had prov-bytes strip to the first colon and
; hex-decode a path and a quote mark: a well-formed 32-byte field that was a
; hash of nothing, and `zyl verify` could not have caught it because no reader
; existed. Now the field is BLAKE3 of that text, which `zyl verify` recomputes
; from the `(native-objects ...)` form in the buildinfo beside the binary.
(defn drv-attach-provenance (arena out bi buf)
  (let seed (drv-get-seed)
    (if (= (str-length seed) 0)
      unit
      (let ih (prov-hash-file out (- 1))
        (begin
          (prov-attach out
            (match bi (BH ch gh nh ih2 fh ch))
            (match bi (BH ch gh nh ih2 fh gh))
            (str-concat "blake3:" (ffi-call "zyl_blake3_hex" arena (match bi (BH ch gh nh ih2 fh nh)) -1 32 1000))
            (match bi (BH ch gh nh ih2 fh ih2))
            (str-concat "blake3:" (ffi-call "zyl_blake3_hex" arena buf -1 32 1000))
            (match bi (BH ch gh nh ih2 fh fh))
            ih
            seed)
          (print (str-concat "zyl: signed " (str-concat out " (trailer attached)"))))))))

; zyl.buildinfo (SS31.12): the compiler's own hash, the graph hash from the
; lock, the native object hashes and the ICNF hash, in that order, so a
; third party can verify a binary came from a claimed set of inputs.
;
; The ICNF hash is over the ICNF's canonical text (icnf_print.zyl's
; icnf-text, region annotations included); the assembly hash is recorded
; beside it.
;; Step 11: the four inputs of spec 31.12 in canonical order -- compiler,
;; lock graph, native objects, ICNF (its canonical text, icnf_print.zyl) --
;; and their final hash, which the binary carries as `zyl_build_hash`
;; (section .zyl_build).
(deftype BuildHashes (BH String String String String String))
(defn bh-final (b) (match b (BH _ _ _ _ f f)))

(defn drv-build-hashes (arena dir objs fns)
  (let ch (lk-compiler-self-hash arena)
    (let gh (drv-graph-hash arena dir)
      (let nh (drv-object-hashes arena dir objs)
        (let ih (str-concat "blake3:" (ffi-call "zyl_blake3_hex" arena (icnf-text arena fns) -1 32 1000))
          (let all (str-concat ch (str-concat "\n" (str-concat gh (str-concat "\n" (str-concat nh (str-concat "\n" ih))))))
            (BH ch gh nh ih (str-concat "blake3:" (ffi-call "zyl_blake3_hex" arena all -1 32 1000)))))))))

; The resolved graph from the lock (lk-graph-text), or none without a lock.
(defn drv-graph-text (arena dir)
  (match (cli-read-lock arena dir)
    (Some l (lk-graph-text arena l))
    (None "")))

; `("path" "blake3:...")` per native object, in manifest order; the path is
; package-relative, so the hash does not depend on where the package sits.
(defn drv-object-hashes (arena dir objs)
  (match objs
    (Nil "")
    (Cons o rest
      (let h (str-concat " (\"" (str-concat (drv-rel dir o) (str-concat "\" \"blake3:" (str-concat (ffi-call "zyl_blake3_file_hex" arena o 32 1000) "\")"))))
        (str-concat h (drv-object-hashes arena dir rest))))))

(defn drv-rel (dir p)
  (let n (+ (str-length dir) 1)
    (if (and (> (str-length p) n) (ffi-call "zyl_cstr_eq" (str-substring p 0 n) (str-concat dir "/") 1000))
      (str-substring p n (- (str-length p) n))
      p)))

(defn drv-hash-section (final)
  (str-concat "\n    .section .zyl_build,\"a\"\n    .globl zyl_build_hash\nzyl_build_hash:\n    .asciz \""
    (str-concat final "\"\n    .text\n")))


(defn drv-write-buildinfo (arena dir out bi asm)
  (let path (str-concat out ".buildinfo")
    (let f (file-open path "w")
      (let _ (file-write f (drv-buildinfo-text bi (drv-graph-text arena dir)
                             (str-concat "blake3:" (ffi-call "zyl_blake3_hex" arena asm -1 32 1000))))
        (file-close f)))))

(defn drv-buildinfo-text (bi graph ah)
  (match bi
    (BH ch gh nh ih fh
      (str-concat "(buildinfo\n  (compiler-hash \""
        (str-concat ch
          (str-concat "\")\n  (graph-hash \""
            (str-concat gh
              (str-concat "\")\n  (graph" (str-concat graph
              (str-concat ")\n  (native-objects"
                (str-concat nh
                  (str-concat ")\n  (icnf-hash \""
                    (str-concat ih
                      (str-concat "\")\n  (asm-hash \"" (str-concat ah
                      (str-concat "\")\n  (final-hash \"" (str-concat fh "\"))\n")))))))))))))))))

(defn drv-graph-hash (arena dir)
  (match (cli-read-lock arena dir)
    (Some l (lk-graph-hash l))
    (None "")))

; A test build resolves dev-deps as well; a plain build must not, since
; dev-deps never enter a dependent's graph (§31.3).
(defn drv-test (arena dir)
  (let _ (drv-check-workspace arena dir)
    (let m (pk-read-manifest arena (str-concat dir "/zyl.pkg"))
      ; Resolved for the check, not for a value: a dev-dependency that
      ; cannot be resolved is an error before anything is compiled.
      (let nodes (mvs-resolve-with-dev arena (cli-ctx-offline arena dir m) m dir)
        (let rc (drv-compile-file arena (drv-entry-module arena dir)
                                  (drv-output-path arena dir) dir nodes)
          (if (= rc 0)
            (ffi-call "zyl_run_bin" (drv-output-path arena dir) 1000)
            rc))))))

(defn drv-usage ()
  (begin
    (print "zyl <file.zyl> [-o out] [--emit-asm]   compile one file")
    (print "  --error-format=json                    report diagnostics as JSON lines")
    (print "  --contracts=strict|debug|warn|off|production   contract profile (default strict)")
    (print "zyl new <name>                         create a package")
    (print "zyl add <name> [version]               add a dependency")
    (print "zyl fetch                              resolve, verify and populate the store")
    (print "zyl build [--locked] [--sign-with key]  compile this package")
    (print "  --sign-with <key>                      append a signed provenance trailer")
    (print "zyl test                               compile and run this package")
    (print "zyl verify <binary> [--key k] [--package p] [--anchored]  check a signed trailer")
    (print "  --key <hex|file>                       an Ed25519 public key supplied out of band (ATTESTED)")
    (print "  --package <name>                       the key pinned for that package (VERIFIED)")
    (print "  --anchored                             fail unless a pinned key was used")
    (print "zyl update                             re-resolve and rewrite zyl.lock")
    (print "zyl vendor                             copy the graph into ./vendor")
    (print "zyl audit                              report capabilities per package")
    (print "zyl publish                            archive, hash and sign this package")
    (print "zyl key                                show or create the publisher key")
    (print "zyl repl                               start an interactive session")
    (print "zyl eval <file.zyl>                    run a program without building one")
    (print "zyl doc [file.zyl | dir] [-o out.md]   Markdown from doc comments")
    (print "zyl check [file.zyl | dir ...]          type-check without building; the fast edit loop")
    (print "zyl fmt [file.zyl ...] [--check]      reindent to paren depth (--check: report only)")
    (print "zyl explain [CODE]                     what a diagnostic means and where it is raised")
    (print "zyl balance [file.zyl | dir ...]       check brackets, strings and top-level structure")
    0))

(defn drv-subcommand (arena cmd cwd)
  (if (str-eq cmd "new")
    (cli-new arena cwd (drv-arg 2))
  (if (str-eq cmd "add")
    (cli-add arena (drv-package-dir cwd 16) (drv-arg 2) (drv-arg 3))
  (if (str-eq cmd "fetch")
    (cli-fetch arena (drv-package-dir cwd 16))
  (if (str-eq cmd "update")
    (cli-update arena (drv-package-dir cwd 16))
  (if (str-eq cmd "vendor")
    (cli-vendor arena (drv-package-dir cwd 16))
  (if (str-eq cmd "audit")
    (cli-audit arena (drv-package-dir cwd 16))
  (if (str-eq cmd "publish")
    (cli-publish arena (drv-package-dir cwd 16))
  (if (str-eq cmd "key")
    (cli-key arena)
  (if (str-eq cmd "build")
    (let _ (drv-sign-from-args)
      (drv-build arena (drv-package-dir cwd 16) (drv-has-flag 2 "--locked")))
  (if (str-eq cmd "test")
    (drv-test arena (drv-package-dir cwd 16))
  (if (str-eq cmd "verify")
    (drv-verify cwd)
  ; The REPL compiles code, so it runs from the bundle directory the
  ; same way a compile does -- drv-run-subcommand has already chdir'd
  ; there by the time this is reached.
  (if (str-eq cmd "repl")
    ; `cwd` is the user's directory, captured before the chdir to the
    ; bundle: a saved session belongs to the project, not the compiler.
    (repl-run-in arena cwd)
  (if (str-eq cmd "eval")
    (drv-eval arena cwd)
  (if (str-eq cmd "doc")
    (drv-doc arena cwd)
  (if (str-eq cmd "rt-cache")
    (el-rt-cache "rt.s" "start.s" "rt.zo")
  (if (str-eq cmd "check")
    (drv-check arena cwd)
  (if (str-eq cmd "fmt")
    (drv-fmt cwd)
  (if (str-eq cmd "explain")
    (drv-explain cwd)
  (if (str-eq cmd "balance")
    (drv-balance cwd)
    (drv-usage)))))))))))))))))))))

; `zyl verify <binary> [--key k] [--package p] [--anchored]`.
;
; The driver chooses the TRUST MODE, because the keys live where the driver
; keeps them, and compiler/provenance does the checking and the report
; (prov-verify). Three sources, strongest first, and the report names the one
; used:
;
;   --package <name>  the key pinned for that package on first fetch (§31.8,
;                     ~/.zyl/keys): the package's own publisher signed this
;                     binary, and nothing else was assumed.         VERIFIED
;   --key <hex|file>  a public key the caller got some other way: whoever
;                     holds it signed this, and nothing binds that key to
;                     this binary.                                   ATTESTED
;   neither           the record's own kid: the trailer is consistent with
;                     itself, which anyone holding the binary could have
;                     arranged.                                 SELF-ASSERTED
;
; `--anchored` turns anything but the first into a failure, for a script that
; must not accept a weaker verdict by accident. A `--package` whose key is not
; pinned is an error and not a fall-through to a weaker mode: the caller asked
; for the strong check and must be told it could not run.
(defn drv-verify (cwd)
  (let target (drv-arg 2)
    (if (= (str-length target) 0)
      (begin (print "zyl verify: a binary to verify is required") 1)
      (let path (cli-resolve-path cwd target)
        (let pkg (drv-flag-value 3 "--package")
          (let key (drv-flag-value 3 "--key")
            (let anchored (drv-has-flag 3 "--anchored")
              (if (> (str-length pkg) 0)
                (drv-verify-pinned path pkg anchored)
                (if (> (str-length key) 0)
                  (prov-verify path prov-mode-supplied (drv-verify-key cwd key)
                    "a key supplied with --key; nothing binds it to this binary" anchored)
                  (prov-verify path prov-mode-self ""
                    "the record's own kid; consistent with itself and vouched for by nobody" anchored))))))))))

(defn drv-verify-pinned (path pkg anchored)
  (let pinned (idx-pinned-key pkg)
    (if (= (str-length pinned) 0)
      (begin
        (print (str-concat "zyl verify: no key is pinned for package " (str-concat pkg
          (str-concat " (looked in " (str-concat (store-key-path pkg) "); fetch it once, or verify with --key")))))
        1)
      (prov-verify path prov-mode-anchored pinned
        (str-concat "the key pinned for package " (str-concat pkg (str-concat " at " (store-key-path pkg)))) anchored))))

; `--key` takes 64 hex characters, with or without `ed25519:`, or a file
; holding them: the file `zyl key` prints the public key of, or one a
; publisher handed out.
(defn drv-verify-key (cwd key)
  (let p (cli-resolve-path cwd key)
    (if (ffi-call "zyl_path_exists" p 1000)
      (drv-read-seed-file p)
      key)))

; `zyl doc <file.zyl | dir> [-o out.md]`: Markdown from doc comments
; (compiler/doc.zyl); only `pub` items when a zyl.pkg sits beside them.
(defn drv-doc (arena cwd)
  (let target (cli-resolve-path cwd (if (= (str-length (drv-arg 2)) 0) "." (drv-arg 2)))
    (let md (if (cli-ends-with-zyl target)
              (doc-file arena target (drv-doc-modname target) (drv-has-pkg (ffi-call "zyl_dirname_cstr" target 1000)))
              (doc-dir arena target (drv-has-pkg target)))
      (let out (drv-doc-out 3)
        (if (= (str-length out) 0)
          (begin (print md) 0)
          (begin (cli-write-file (cli-resolve-path cwd out) md) 0))))))

; `zyl check [file.zyl | dir ...]`: parse, expand and type-check, then stop.
;
; No code generation, no linking, no binary. Everything a program author can
; fix has been reported by the time this returns, because the front end ends at
; type inference and the phases after it either succeed or are compiler bugs.
; `compile-front-end` is the shared body of this and a build, so a clean check
; means the program builds; there is no second front end to keep honest.
;
; The reason this is a command rather than a flag on `zyl build` is the edit
; loop. A full build takes long enough that the natural rhythm becomes: make
; several edits, start a build, read four problems at once. Reading one
; problem, fixing it, reading the next only works if the answer comes back
; fast.
;
; The mode setup below is not a convenience. `cli-run` does exactly this before
; every compile, and a check that skipped it disagreed with the build on any
; path in `cli-internal-entries` -- which is listed by suffix and includes
; several tests that legitimately need raw memory, such as
; regression/balance-agreement.zyl, which fuzzes the lexer through a real
; arena. `zyl check` reported E_FFI_RESTRICTED for a program the build
; compiles every day, while a copy of the same file under another name failed
; in BOTH paths, which is what made it look like a compiler bug instead of a
; missing line. A check that runs a different sequence of steps than the build
; is not a check.
(defn drv-check-file (arena src path)
  (let _ (cli-internal-mode path)
    (begin
      (compile-check arena src path)
      0)))

; A standard-library file is a MODULE, not a program, and compiling it as the
; entry makes it both at once: its definitions arrive as root definitions and
; again through its own `use` lines, and the checks that consult the package
; answer wrongly. Checking one the way a build reaches it -- as a dependency --
; is the faithful thing and is not implemented yet, so this says so rather than
; reporting a verdict a build would not.
(defn drv-stdlib-module (path)
  (let n (str-length path)
    (if (= n 0)
      ""
      (let i (drv-slash-at path 0 n)
        (if (< i 0)
          ""
          (if (= i 6)
            (if (str-eq (str-substring path 0 6) "stdlib") (drv-stdlib-tail path (+ i 1) n) "")
            (drv-stdlib-module-from path (+ i 1) n)))))))

(defn drv-stdlib-module-from ((path String) (i Int) (n Int))
  (if (>= i n)
    ""
    (let j (drv-slash-at path i n)
      (if (= j (+ i 6))
        (if (str-eq (str-substring path i 6) "stdlib") (drv-stdlib-tail path (+ j 1) n) "")
        (if (< j 0) "" (drv-stdlib-module-from path (+ j 1) n))))))

(defn drv-stdlib-tail ((path String) (i Int) (n Int))
  (if (>= i n)
    ""
    (let len (if (and (> n 4) (= (str-substring path (- n 4) 4) ".zyl")) (- n 4) n)
      (if (>= i len) "" (str-substring path i (- len i))))))

(defn drv-slash-at ((path String) (i Int) (n Int))
  (if (>= i n)
    -1
    (if (= (ffi-call "zyl_view_byte" path 0 n i 1000) 47) i (drv-slash-at path (+ i 1) n))))

; Is any component of this path `want`? The component is compared whole; an
; earlier version compared only when the component's length happened to equal
; want's, so "compile-fail" was never found and every sweep of tests/ stopped
; on the first file that was meant to fail.
(defn drv-has-component ((path String) (want String) (i Int) (n Int))
  (if (>= i n)
    false
    (let j (drv-slash-at path i n)
      (let end (if (< j 0) n j)
        (if (str-eq (str-substring path i (- end i)) want)
          true
          (if (< j 0) false (drv-has-component path want (+ j 1) n)))))))

; The compile-fail corpus holds programs that MUST NOT compile, so sweeping it
; reports every one as a failure. Skipping them is reported rather than done
; quietly: a sweep that silently checked less than it was asked to is its own
; kind of wrong answer.
(defn drv-compile-fail-p (path)
  (drv-has-component path "compile-fail" 0 (str-length path)))

(defn drv-check (arena cwd)
  (let n (ffi-call "zyl_argc" 1000)
    (let paths (drv-balance-args 2 n cwd)
      (let files (drv-balance-files (match paths (Nil (Cons cwd Nil)) (_ paths)))
        (let bad (drv-check-each arena files 0)
          (let total (list-length files)
            (let skipped (drv-check-skipped files)
              (begin
                (print (str-concat "check: " (str-concat (ffi-call "zyl_int_text" total 1000)
                  (if (= bad 0) (if (= total 1) " file, ok" " files, all ok")
                    (str-concat " files, " (str-concat (ffi-call "zyl_int_text" bad 1000) " failed"))))))
                (if (> skipped 0)
                  (print (str-concat "check: " (str-concat (ffi-call "zyl_int_text" skipped 1000)
                    " file(s) under compile-fail/ skipped: they are meant to fail")))
                  unit)
                (if (= bad 0) 0 1)))))))))

(defn drv-check-skipped (files)
  (match files
    (Nil 0)
    (Cons f rest
      (if (drv-compile-fail-p f) (+ 1 (drv-check-skipped rest)) (drv-check-skipped rest)))))

; How many files fail, each reported as it is checked. The diagnostics come
; from the front end, so this loop only counts.
(defn drv-check-each (arena files (bad Int))
  (match files
    (Nil bad)
    (Cons f rest
      (if (drv-compile-fail-p f)
        (drv-check-each arena rest bad)
        (match (sb-read-file f)
          (None
            (let _ (ffi-call "zyl_warn_emit" (str-concat "error: cannot read " f) 1000)
              (drv-check-each arena rest (+ bad 1))))
          (Some src
            (if (> (drv-check-file arena src f) 0)
              (drv-check-each arena rest (+ bad 1))
              (drv-check-each arena rest bad))))))))

(defn drv-fmt (cwd)
  (let n (ffi-call "zyl_argc" 1000)
    (let paths (drv-balance-args 2 n cwd)
      (let files (drv-balance-files (match paths (Nil (Cons cwd Nil)) (_ paths)))
        (let check (drv-has-flag 2 "--check")
          (let bad (drv-fmt-each files check 0)
            (let total (list-length files)
              (let msg (if (= bad 0)
                          " already formatted"
                          (if check " would be reformatted" " reformatted"))
                (print (str-concat "fmt: " (str-concat (ffi-call "zyl_int_text" total 1000) msg)))
                (if check bad 0)))))))))

(defn drv-fmt-each (files check (bad Int))
  (match files
    (Nil bad)
    (Cons f rest
      (match (sb-read-file f)
        (None
          (begin
            (ffi-call "zyl_warn_emit" (str-concat "error: cannot read " f) 1000)
            (drv-fmt-each rest check (+ bad 1))))
        (Some src
          (let out (format-document src)
            (if (not (str-eq out src))
              (begin
                (if check
                  (print (str-concat "  would reformat " f))
                  ; cli-write-file hands back file-close's status, an Int, so it
                  ; cannot be a branch opposite print's Unit.
                  (let _ (cli-write-file f out) unit))
                (drv-fmt-each rest check (+ bad 1)))
              (drv-fmt-each rest check bad))))))))

; `zyl explain [CODE]`: what a diagnostic means and where it is raised.
;
; There are 135 codes and each is raised from up to a dozen places, so the
; useful part of a code is the sentence that says what to do about it. That
; sentence already exists, once per raise site, as the `help` argument passed
; alongside the message -- and it was only ever printed at the moment of
; failure, for the one site that fired.
;
; With no argument it lists every code, so the catalog is discoverable without
; reading the source. With one it prints the phase, the severity, the
; catalog's own meaning, and the raise sites found by scanning the tree, with
; the source line at each.
;
; The scan reads the tree as text rather than parsing it, so it works on source
; that does not compile and on a half-written file -- which is when you most
; want to look a code up.
(defn drv-explain (cwd)
  (let code (drv-arg 2)
    (if (= (str-length code) 0)
      (explain-list)
      (explain-code code cwd (ffi-call "zyl_list_zyl_files" cwd 1000)))))

; `zyl balance [path ...]`: the strict delimiter check (compiler/sexp_balance)
; on every file named, or every .zyl file under a directory (default: the
; current one). Each fault is reported located, in the text or JSON format;
; the status is 1 when any file is unbalanced or unreadable.
(defn drv-balance (cwd)
  (let n (ffi-call "zyl_argc" 1000)
    (let paths (drv-balance-args 2 n cwd)
      (let files (drv-balance-files (match paths (Nil (Cons cwd Nil)) (_ paths)))
        (let bad (drv-balance-each files 0)
          (let total (list-length files)
            (begin
              (print (str-concat "balance: " (str-concat (ffi-call "zyl_int_text" total 1000)
                (if (= bad 0) (if (= total 1) " file, balanced" " files, all balanced")
                  (str-concat " files, " (str-concat (ffi-call "zyl_int_text" bad 1000) " unbalanced"))))))
              (if (= bad 0) 0 1))))))))

; The non-flag arguments from i, resolved against the user's directory.
(defn drv-balance-args ((i Int) (n Int) cwd)
  (if (>= i n) Nil
    (let a (drv-arg i)
      (if (str-eq (str-substring a 0 2) "--") (drv-balance-args (+ i 1) n cwd)
        (Cons (cli-resolve-path cwd a) (drv-balance-args (+ i 1) n cwd))))))

; Each path as itself when it names a .zyl file, else the .zyl files under it, in order.
(defn drv-balance-files (paths)
  (match paths
    (Nil Nil)
    (Cons p rest
      (list-append
        (if (cli-ends-with-zyl p) (Cons p Nil) (drv-balance-dir p (ffi-call "zyl_list_zyl_files" p 1000) 0))
        (drv-balance-files rest)))))

(defn drv-balance-dir (dir list (i Int))
  (let j (doc-line-end list i)
    (if (>= i j) Nil
      (Cons (str-concat dir (str-concat "/" (str-substring list i (- j i)))) (drv-balance-dir dir list (+ j 1))))))

; How many files fail, each reported as it is checked.
(defn drv-balance-each (files (bad Int))
  (match files
    (Nil bad)
    (Cons f rest
      (match (sb-read-file f)
        (None (let _ (ffi-call "zyl_warn_emit" (str-concat "error: cannot read " f) 1000) (drv-balance-each rest (+ bad 1))))
        (Some src
          (let r (sb-check-string src)
            (if (>= (sb-nul-offset f src) 0)
              (let _ (ffi-call "zyl_warn_emit" (nul-diagnostic f src (sb-nul-offset f src)) 1000) (drv-balance-each rest (+ bad 1)))
            (if (sb-result-balanced r) (drv-balance-each rest bad)
              (let _ (ffi-call "zyl_warn_emit" (balance-diagnostic r (ffi-call "zyl_source_register" f src 1000)) 1000)
                (drv-balance-each rest (+ bad 1)))))))))))

(defn drv-has-pkg (dir) (ffi-call "zyl_path_exists" (str-concat dir "/zyl.pkg") 1000))

; `-o path` after the target, or "".
(defn drv-doc-out (i)
  (if (>= i (ffi-call "zyl_argc" 1000))
    ""
    (if (str-eq (drv-arg i) "-o") (drv-arg (+ i 1)) (drv-doc-out (+ i 1)))))

; `dir/name.zyl` -> `name`.
(defn drv-doc-modname (p)
  (let base (drv-doc-base p (- (str-length p) 1))
    (str-substring base 0 (- (str-length base) 4))))

(defn drv-doc-base (p i)
  (if (< i 0) p (if (= (ffi-call "zyl_cstr_byte_at" p i 1000) 47) (str-substring p (+ i 1) (- (str-length p) (+ i 1))) (drv-doc-base p (- i 1)))))

(defn main ()
  (let arena (arena-create 1073741824)
    (let argc (ffi-call "zyl_argc" 1000)
      (if (< argc 2)
        (boot-run-legacy arena)
        (begin
          (drv-scan-error-format 1 argc)
          (drv-main-arg arena))))))

; `--error-format=json` anywhere on the line switches every diagnostic to JSON.
(defn drv-scan-error-format (i argc)
  (if (>= i argc)
    0
    (let a (ffi-call "zyl_arg_str" i 1000)
      (begin
        (if (str-eq a "--error-format=json") (ffi-call "zyl_diag_json_set" true 1000) unit)
        (if (drv-contracts-flag-p a)
          (ffi-call "zyl_smap_put" contract-profiles "profile" (str-substring a 12 (- (str-length a) 12)) 1000)
          unit)
        (drv-scan-error-format (+ i 1) argc)))))

; `--contracts=P`: the build's contract profile (strict, debug, warn, off, production).
(defn drv-contracts-flag-p (a)
  (and (> (str-length a) 12) (ffi-call "zyl_cstr_eq" (str-substring a 0 12) "--contracts=" 1000)))

; The bundle dir holds stdlib/ and rt.o; the compiler chdirs
; there so module resolution and linking find them. A subcommand needs
; the user's own directory too, since that is where the package is, so
; both are resolved before anything moves.
(defn drv-main-arg (arena)
  (let a (ffi-call "zyl_arg_str" 1 1000)
    (if (drv-is-subcommand a)
      (drv-run-subcommand arena a)
      (cli-run arena))))

(defn drv-run-subcommand (arena a)
  (let cwd (ffi-call "zyl_getcwd" 1000)
    (let argv0 (ffi-call "zyl_arg_str" 0 1000)
      (let bundledir (cli-resolve-bundledir (ffi-call "zyl_dirname_cstr" argv0 1000))
        (let _ (ffi-call "zyl_chdir" bundledir 1000)
          (drv-subcommand arena a cwd))))))