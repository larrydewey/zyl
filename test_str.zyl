(use allocator/allocator)
(use compiler/ir)

(defn main ()
  (let arena (arena-create 0)
    (let pool (pool-create arena 6)
      (let a (pool-append pool))
      (begin
        (node-set-str pool a (str-intern arena "alpha"))
        (print (pool-kind pool a))
        (str-print (pool-str pool a))
        (print (pool-str pool a))))))