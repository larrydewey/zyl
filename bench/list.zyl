(use core/list)
(defn build ((n Int) (acc (List Int))) (if (= n 0) acc (build (- n 1) (Cons n acc))))
(defn sum ((xs (List Int)) (acc Int)) (match xs (Nil acc) (Cons h t (sum t (+ acc h)))))
(defn rounds ((k Int) (tot Int)) (if (= k 0) tot (rounds (- k 1) (+ tot (sum (build 1000000 Nil) 0)))))
(defn main () (begin (print (rounds 30 0)) 0))
