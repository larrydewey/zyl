; === Zyl Standard Library — FFI Operations ===
; Module: ffi
; Provides: FFI pinning helpers and safe wrappers.
;
; ffi-pin copies an 8-byte value to a stable heap location and returns its
; address (as Int). The value stays valid until ffi-unpin frees it.

; ===========================================================================
; FFI PIN / UNPIN
; ===========================================================================

; Pin a value for FFI access. Returns a stable address (Int).
; Returns: Int (address)
(defn ffi-pin-value (value)
  (ffi-pin value))

; Unpin a pinned value, releasing its storage.
; Returns: Unit
(defn ffi-unpin-value (pointer)
  (ffi-unpin pointer))

; ===========================================================================
; SAFE CALL WRAPPER
; ===========================================================================

; Wrap a foreign call result in a Result, converting runtime errors to Err.
; Returns: Result<T, Int>
(defn ffi-safe-call (result)
  (try
    (Ok result)
    (catch e
      (Err e))))

; Pin, call, and unpin in one step.
; NOTE: The call itself must be written at the call site; this helper wraps
; the result value in a Result.
; Returns: Result<T, Int>
(defn ffi-pin-call-unpin (result)
  (try
    (Ok result)
    (catch e
      (Err e))))
