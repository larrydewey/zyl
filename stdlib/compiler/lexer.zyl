; === Zyl Standard Library — Compiler Lexer ===
; Module: compiler/lexer
; Provides: A deterministic tokenizer for Zyl source.
;
; Input:  a NUL-terminated source buffer (Int pointer).
; Output: a (List Token) in source order (see compiler/ast), ending with
;         a single TkEof.
;
; Design: pure functional scanner. The cursor is threaded through
; arguments (arena, src, len, i) — no state records, no raw layouts.
; Determinism: source scanned strictly left-to-right; stream order
; preserved by construction (each step conses onto the returned stream).
; Comments (`;` .. end of line) are skipped inline.

(use allocator/allocator)
(use compiler/ast)

; ===========================================================================
; CHARACTER CLASSES (byte values; ASCII)
; ===========================================================================

(defn chr-ws-p (c)
  (if (= c 32) true (if (= c 9) true (if (= c 13) true (if (= c 10) true false)))))

(defn chr-digit-p (c)
  (if (>= c 48) (if (<= c 57) true false) false))

; Hex digit: 0-9 a-f A-F (byte values; ASCII).
(defn chr-hexdigit-p (c)
  (if (chr-digit-p c) true
    (if (>= c 97) (if (<= c 102) true (if (>= c 65) (if (<= c 70) true false) false))
    (if (>= c 65) (if (<= c 70) true false) false))))

; Octal digit: 0-7.
(defn chr-octdigit-p (c)
  (if (>= c 48) (if (<= c 55) true false) false))

; Binary digit: 0-1.
(defn chr-bindigit-p (c)
  (if (>= c 48) (if (<= c 49) true false) false))

(defn chr-alpha-p (c)
  (if (>= c 65)
    (if (<= c 90) true (if (>= c 97) (if (<= c 122) true false) false))
    (if (>= c 97) (if (<= c 122) true false) false)))

; Mirror Rust lexer is_ident_start: alpha | _ - ? ! + / = < > * %
(defn chr-ident-start-p (c)
  (if (chr-alpha-p c) true
    (if (= c 95) true
      (if (= c 45) true
        (if (= c 63) true
          (if (= c 33) true
            (if (= c 43) true
              (if (= c 47) true
                (if (= c 61) true
                  (if (= c 60) true
                    (if (= c 62) true
                      (if (= c 42) true
                        (if (= c 37) true false)))))))))))))

; Mirror Rust lexer is_ident_continue: alnum | _ - ? ! / = + % .
(defn chr-ident-cont-p (c)
  (if (chr-digit-p c) true
    (chr-ident-start-2 c)))

; ident-continue adds '.' over ident-start and drops nothing else.
(defn chr-ident-start-2 (c)
  (if (= c 46) true (chr-ident-start-p c)))

(defn chr-semicolon-p (c) (if (= c 59) true false))

; Logical or on two 0/1 values (avoids and/or forms).
(defn either (a b)
  (if (= a 0) (if (= b 0) false true) true))

; ===========================================================================
; BYTE / SCAN PRIMITIVES
; ===========================================================================

; Byte at `i` in `src` (NUL-terminated).
; Returns: Int
(defn byte-at (src i)
  (ffi-call "zyl_cstr_byte_at" src i 1000))

; End index (exclusive) of an identifier starting at `i`.
; Returns: Int
(defn scan-ident-end (src len i)
  (if (>= i len)
    i
    (if (chr-ident-cont-p (byte-at src i))
      (scan-ident-end src len (+ i 1))
      i)))

; Digits/'.' run for a numeric literal body.
; Returns: Int (end, exclusive)
(defn scan-num-body (src len i)
  (if (>= i len)
    i
    (let c (byte-at src i)
      (if (chr-digit-p c)
        (scan-num-body src len (+ i 1))
        (if (= c 46)
          (scan-num-body src len (+ i 1))
          i)))))

; Digit run of an exponent tail.
; Returns: Int (end, exclusive)
(defn scan-exp-digits (src len i)
  (if (>= i len)
    i
    (if (chr-digit-p (byte-at src i))
      (scan-exp-digits src len (+ i 1))
      i)))

; Exponent tail: e/E [+-] digits. `i` points at e/E.
; Returns: Int (end, exclusive)
(defn scan-exp (src len i)
  (scan-exp-j src len i (+ i 1)))

; j = candidate exponent-digit start.
(defn scan-exp-j (src len i j)
  (if (>= j len)
    i
    (scan-exp-b src len i j (byte-at src j))))

(defn scan-exp-b (src len _i j b)
  (scan-exp-digits src len
                   (if (either (= b 43) (= b 45)) (+ j 1) j)))

; Full numeric literal end from `start` (sign included in caller).
; Handles decimal/float literals AND radix-prefixed integers (0x.., 0o..,
; 0b..). Returns: Int (end, exclusive)
(defn scan-number-end (src len start)
  (let i (if (= (byte-at src start) 45) (+ start 1) start)
    (let radix (scan-radix-end src len i)
      (if (>= radix 0)
        radix
        (let mid (scan-num-body src len i)
          (if (>= mid len)
            mid
            (let c (byte-at src mid)
              (if (either (= c 101) (= c 69))
                (scan-exp src len mid)
                mid))))))))

; When the numeric body starts with "0x"/"0o"/"0b", scan the full radix
; digit run and return its end (exclusive); otherwise return -1.
; Returns: Int
(defn scan-radix-end (src len i)
  (if (>= (+ i 1) len)
    -1
    (let c0 (byte-at src i)
      (if (= c0 48)
        (radix-probe src len i (byte-at src (+ i 1)))
        -1))))

; Probe the radix-marker char after '0'.
(defn radix-probe (src len i c)
  (if (either (= c 120) (= c 88))
    (radix-body src len i 16)
  (if (either (= c 111) (= c 79))
    (radix-body src len i 8)
  (if (either (= c 98) (= c 66))
    (radix-body src len i 2)
    -1))))

; Consume digits valid in `base` starting one past the radix marker.
(defn radix-body (src len i base)
  (radix-body-j src len i base (+ i 2)))

(defn radix-body-j (src len i base j)
  (if (>= j len)
    j
    (radix-body-c src len i base j (byte-at src j))))

(defn radix-body-c (src len i base j c)
  (if (radix-digit-p c base)
    (radix-body-j src len i base (+ j 1))
    j))

; Whether `c` is a digit in the given radix.
(defn radix-digit-p (c base)
  (if (= base 16) (chr-hexdigit-p c)
  (if (= base 8) (chr-octdigit-p c)
  (if (= base 2) (chr-bindigit-p c) false))))

; Index of the closing '"' for a string opened before `i`; -1 if unterminated.
; Returns: Int
(defn scan-str-end (src len i)
  (if (>= i len)
    -1
    (let b (byte-at src i)
      (if (= b 92)
        (if (<= (+ i 1) (- len 1))
          (scan-str-end src len (+ i 2))
          -1)
        (if (= b 34)
          i
          (scan-str-end src len (+ i 1)))))))

; Whether numeric literal text contains '.' or e/E (float marker).
; Radix-prefixed integers (0x/0o/0b) are exempt: hex digits a-f include
; 'e', which must not force float classification. Returns: Bool (0/1)
(defn text-float-marker-p (text)
  (let n (ffi-call "zyl_cstr_len" text 1000)
    (if (radix-prefix-len text n)
      0
      (marker-loop text n 0))))

; 1 if `text` starts with any radix prefix at offset 0; else 0.
(defn radix-prefix-len (text n)
  (if (>= n 2)
    (let c0 (ffi-call "zyl_cstr_byte_at" text 0 1000)
      (if (= c0 48)
        (let c1 (ffi-call "zyl_cstr_byte_at" text 1 1000)
          (if (either (= c1 120) (= c1 88)) true
          (if (either (= c1 111) (= c1 79)) true
          (if (either (= c1 98) (= c1 66)) true false))))
        false))
    false))

(defn marker-loop (text n i)
  (if (>= i n)
    0
    (let c (byte-at text i)
      (if (either (= c 46) (either (= c 101) (= c 69)))
        1
        (marker-loop text n (+ i 1))))))

; End of a `;`-comment: first '\n' index (exclusive), or len.
; Returns: Int
(defn comment-end (src len i)
  (if (>= i len)
    len
    (if (= (byte-at src i) 10)
      i
      (comment-end src len (+ i 1)))))

; Delimiters that stop a keyword/symbol head: ( ) { } [ ] : ~
(defn chr-punctuator-p (c)
  (if (= c 40) true
    (if (= c 41) true
      (if (= c 123) true
        (if (= c 125) true
          (if (= c 91) true
            (if (= c 93) true
              (if (= c 58) true (if (= c 126) true false)))))))))

; Empty token stream (typed so `Nil` never unifies as Option).
(defn no-tokens () Nil)

; ===========================================================================
; MAIN LEXER — one function, one self-tail-recursion site
; ===========================================================================
; ALL routing and token production live inside lex-loop: every
; continuation is a DIRECT tail call, which codegen turns into a jump,
; so lexing runs in constant stack.
;
; Bootstrap constraints honored: arity <=6, flat if-chains (no nesting
; deeper than the proven ic-special shape).


(defn zyl-lex (arena src)
  (let len (ffi-call "zyl_cstr_len" src 1000)
    (list-reverse (lex-loop arena src len 0 Nil))))

(defn lex-loop (arena src len i acc)
  (if (>= i len)
    (Cons (TkEof i) acc)
    (lex-c1 arena src len i acc (byte-at src i))))

(defn lex-c1 (arena src len i acc c)
  (if (chr-ws-p c)
    (lex-loop arena src len (+ i 1) acc)
    (if (chr-semicolon-p c)
      (lex-loop arena src len (comment-end src len (+ i 1)) acc)
      (if (= c 40)
        (lex-loop arena src len (+ i 1) (Cons (TkLParen i) acc))
        (if (= c 41)
          (lex-loop arena src len (+ i 1) (Cons (TkRParen i) acc))
          (if (= c 123)
            (lex-loop arena src len (+ i 1) (Cons (TkLBrace i) acc))
            (if (= c 125)
              (lex-loop arena src len (+ i 1) (Cons (TkRBrace i) acc))
              (if (= c 91)
                (lex-loop arena src len (+ i 1) (Cons (TkLBracket i) acc))
                (if (= c 93)
                  (lex-loop arena src len (+ i 1) (Cons (TkRBracket i) acc))
                  (lex-c2 arena src len i acc c))))))))))

(defn lex-c2 (arena src len i acc c)
  (if (= c 34)
    (lex-str-e arena src len i acc (scan-str-end src len (+ i 1)))
    (if (= c 58)
      (lex-sym-probe arena src len i acc)
      (if (= c 126)
        (lex-sym-probe arena src len i acc)
        (if (chr-digit-p c)
          (lex-num-e arena src len i acc (scan-number-end src len i))
          (if (= c 45)
            (lex-minus-e arena src len i acc)
            (if (chr-ident-start-p c)
              (lex-ident-e arena src len i acc (scan-ident-end src len i))
              ; `.name`: the method part of ((expr).name args)
              (if (lex-dot-name-p src c i)
                (lex-ident-e arena src len i acc (scan-ident-end src len i))
                ; unrecognized character: terminate the stream
                (Cons (TkEof i) acc)))))))))

(defn lex-dot-name-p (src c i)
  (if (= c 46) (chr-alpha-p (byte-at src (+ i 1))) false))

(defn lex-minus-e (arena src len i acc)
  (if (chr-digit-p (byte-at src (+ i 1)))
    (lex-num-e arena src len i acc (scan-number-end src len i))
    (lex-ident-e arena src len i acc (scan-ident-end src len i))))

; String literal: e = index of closing quote (-1 unterminated).
; An invalid escape (zyl_cstr_decode gives 0) also stops here, at the
; opening quote; check-lexed-to-end (parser.zyl) tells the two apart.
(defn lex-str-e (arena src len i acc e)
  (if (< e 0)
    (Cons (TkEof i) acc)
    (let s (ffi-call "zyl_cstr_decode" arena src (+ i 1) e 1000)
      (if (= s 0)
        (Cons (TkEof i) acc)
        (lex-loop arena src len (+ e 1) (Cons (TkString s i) acc))))))

; Numeric literal: i..e; float when the text carries '.' or exponent,
; integer otherwise. Radix-prefixed literals (0x/0o/0b) are always
; integers -- their text carries neither '.' nor 'e', so they take the
; TkInt path, and zyl_cstr_to_int_base decodes the prefix.
(defn lex-num-e (arena src len i acc e)
  (let text (sub-str arena src i (- e i))
    (if (= (text-float-marker-p text) 1)
      (lex-loop arena src len e (Cons (TkFloat text i) acc))
      (lex-loop arena src len e (Cons (TkInt (ffi-call "zyl_cstr_to_int_base" text 1000) i) acc)))))

; Identifier / boolean literal: i..e with text.
(defn lex-ident-e (arena src len i acc e)
  (let text (sub-str arena src i (- e i))
    (if (str-eq text (str-intern arena "true"))
      (lex-loop arena src len e (Cons (TkBool true i) acc))
      (if (str-eq text (str-intern arena "false"))
        (lex-loop arena src len e (Cons (TkBool false i) acc))
        (lex-loop arena src len e (Cons (TkIdent text i) acc))))))

; ':' / '~' prefixed keyword or symbol: probe the next non-ws char.
(defn lex-sym-probe (arena src len i acc)
  (lex-sym-pk arena src len i acc (next-nonws src len (+ i 1))))

; c is the character at i, recovered with byte-at so the arity stays <= 6.
(defn lex-sym-pk (arena src len i acc pk)
  (let c (byte-at src i)
    (if (< pk 0)
      (lex-sym-bare arena src len i acc c)
      (if (not (chr-ident-start-p (byte-at src pk)))
        (lex-sym-bare arena src len i acc c)
        (if (chr-punctuator-p (byte-at src pk))
          (lex-sym-bare arena src len i acc c)
          (lex-sym-tok arena src len i acc (scan-ident-end src len pk)))))))

; end = index one past the symbol text; token kind depends on the
; introducing character c (58 = ':').
(defn lex-sym-tok (arena src len i acc end)
  (let c (byte-at src i)
    (let text (sub-str arena src (+ i 1) (- end (+ i 1)))
      (if (= c 58)
        (lex-loop arena src len end (Cons (TkKeyword text i) acc))
        (lex-loop arena src len end (Cons (TkSymbol text i) acc))))))

(defn lex-sym-bare (arena src len i acc c)
  (if (= c 58)
    (lex-loop arena src len (+ i 1) (Cons (TkColon i) acc))
    (lex-loop arena src len (+ i 1) (Cons (TkSymbol (sub-str arena src i 1) i) acc))))

; ===========================================================================
; SCAN UTILITIES
; ===========================================================================

; Extract a substring of `src` as a fresh NUL-terminated buffer.
; Returns: Int (pointer)
(defn sub-str (arena src start n)
  (ffi-call "zyl_cstr_sub" arena src start n 1000))

; Index of the next non-whitespace character at or after `i`; -1 at end.
(defn next-nonws (src len i)
  (if (>= i len)
    -1
    (if (chr-ws-p (byte-at src i))
      (next-nonws src len (+ i 1))
      i)))
