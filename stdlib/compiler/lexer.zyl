; === Zyl Standard Library — Compiler Lexer ===
; Module: compiler/lexer
; Provides: A deterministic tokenizer for Zyl source.
;
; Input:  a NUL-terminated source buffer (Int pointer).
; Output: a (List Token) in source order (see compiler/ast), ending with
;         a single TkEof.
;
; Design: pure functional scanner. The cursor is threaded through
; arguments (arena, src, len, i) — no state records, no raw layouts.
; Determinism: source scanned strictly left-to-right; stream order
; preserved by construction (each step conses onto the returned stream).
; Comments (`;` .. end of line) are skipped inline.

(use allocator/allocator)
(use compiler/ast)

; ===========================================================================
; CHARACTER CLASSES (byte values; ASCII)
; ===========================================================================

(defn chr-ws-p (c)
  (if (= c 32) 1 (if (= c 9) 1 (if (= c 13) 1 (if (= c 10) 1 0)))))

(defn chr-digit-p (c)
  (if (>= c 48) (if (<= c 57) 1 0) 0))

(defn chr-alpha-p (c)
  (if (>= c 65)
    (if (<= c 90) 1 (if (>= c 97) (if (<= c 122) 1 0) 0))
    (if (>= c 97) (if (<= c 122) 1 0) 0)))

; Mirror Rust lexer is_ident_start: alpha | _ - ? ! + / = < > * %
(defn chr-ident-start-p (c)
  (if (= (chr-alpha-p c) 1) 1
    (if (= c 95) 1
      (if (= c 45) 1
        (if (= c 63) 1
          (if (= c 33) 1
            (if (= c 43) 1
              (if (= c 47) 1
                (if (= c 61) 1
                  (if (= c 60) 1
                    (if (= c 62) 1
                      (if (= c 42) 1
                        (if (= c 37) 1 0)))))))))))))

; Mirror Rust lexer is_ident_continue: alnum | _ - ? ! / = + % .
(defn chr-ident-cont-p (c)
  (if (= (chr-digit-p c) 1) 1
    (chr-ident-start-2 c)))

; ident-continue adds '.' over ident-start and drops nothing else.
(defn chr-ident-start-2 (c)
  (if (= c 46) 1 (chr-ident-start-p c)))

(defn chr-semicolon-p (c) (if (= c 59) 1 0))

; Logical or on two 0/1 values (avoids and/or forms).
(defn either (a b)
  (if (= a 0) (if (= b 0) 0 1) 1))

; ===========================================================================
; BYTE / SCAN PRIMITIVES
; ===========================================================================

; Byte at `i` in `src` (NUL-terminated).
; Returns: Int
(defn byte-at (src i)
  (ffi-call "zyl_cstr_byte_at" src i 1000))

; End index (exclusive) of an identifier starting at `i`.
; Returns: Int
(defn scan-ident-end (src len i)
  (if (>= i len)
    i
    (if (= (chr-ident-cont-p (byte-at src i)) 1)
      (scan-ident-end src len (+ i 1))
      i)))

; Digits/'.' run for a numeric literal body.
; Returns: Int (end, exclusive)
(defn scan-num-body (src len i)
  (if (>= i len)
    i
    (let c (byte-at src i)
      (if (= (chr-digit-p c) 1)
        (scan-num-body src len (+ i 1))
        (if (= c 46)
          (scan-num-body src len (+ i 1))
          i)))))

; Digit run of an exponent tail.
; Returns: Int (end, exclusive)
(defn scan-exp-digits (src len i)
  (if (>= i len)
    i
    (if (= (chr-digit-p (byte-at src i)) 1)
      (scan-exp-digits src len (+ i 1))
      i)))

; Exponent tail: e/E [+-] digits. `i` points at e/E.
; Returns: Int (end, exclusive)
(defn scan-exp (src len i)
  (let j (+ i 1)
    (if (>= j len)
      j
      (let b (byte-at src j)
        (let j2 (if (= (either (= b 43) (= b 45)) 1) (+ j 1) j))
        (scan-exp-digits src len j2)))))

; Full numeric literal end from `start` (sign included in caller).
; Returns: Int (end, exclusive)
(defn scan-number-end (src len start)
  (let i (if (= (byte-at src start) 45) (+ start 1) start)
    (let mid (scan-num-body src len i)
      (if (>= mid len)
        mid
        (let c (byte-at src mid)
          (if (= (either (= c 101) (= c 69)) 1)
            (scan-exp src len mid)
            mid))))))

; Index of the closing '"' for a string opened before `i`; -1 if unterminated.
; Returns: Int
(defn scan-str-end (src len i)
  (if (>= i len)
    -1
    (let b (byte-at src i)
      (if (= b 92)
        (if (<= (+ i 1) (- len 1))
          (scan-str-end src len (+ i 2))
          -1)
        (if (= b 34)
          i
          (scan-str-end src len (+ i 1)))))))

; Whether numeric literal text contains '.' or e/E (float marker).
; Returns: Bool (0/1)
(defn text-float-marker-p (text)
  (marker-loop text (ffi-call "zyl_cstr_len" text 1000) 0))

(defn marker-loop (text n i)
  (if (>= i n)
    0
    (let c (byte-at text i)
      (if (= (either (= c 46) (either (= c 101) (= c 69))) 1)
        1
        (marker-loop text n (+ i 1))))))

; End of a `;`-comment: first '\n' index (exclusive), or len.
; Returns: Int
(defn comment-end (src len i)
  (if (>= i len)
    len
    (if (= (byte-at src i) 10)
      i
      (comment-end src len (+ i 1)))))

; Delimiters that stop a keyword/symbol head: ( ) { } [ ] : ~
(defn chr-punctuator-p (c)
  (if (= c 40) 1
    (if (= c 41) 1
      (if (= c 123) 1
        (if (= c 125) 1
          (if (= c 91) 1
            (if (= c 93) 1
              (if (= c 58) 1 (if (= c 126) 1 0)))))))))

; Empty token stream (typed so `None` never unifies as Option).
(defn no-tokens () None)

; ===========================================================================
; MAIN LEXER — cursor threaded functionally
; ===========================================================================

; Lex `src` (NUL-terminated) into a (List Token) in source order,
; terminated by a single TkEof.
; Returns: List(Token)
(defn zyl-lex (arena src)
  (let len (ffi-call "zyl_cstr_len" src 1000)
    (list-reverse (lex-loop arena src len 0 (no-tokens)))))

; Scanner loop: skip whitespace/comments, then produce one token per step.
; `acc` accumulates tokens in reverse source order.
; Returns: List(Token) (reverse order, TkEof at head when done)
(defn lex-loop (arena src len i acc)
  (if (>= i len)
    (Cons (TkEof) acc)
    (let c (byte-at src i)
      (if (= (chr-ws-p c) 1)
        (lex-loop arena src len (+ i 1) acc)
        (if (= (chr-semicolon-p c) 1)
          (lex-loop arena src len (comment-end src len (+ i 1)) acc)
          (lex-token arena src len i acc c))))))

; Produce one token starting at `i`, then continue scanning.
; Returns: List(Token) (reverse order)
(defn lex-token (arena src len i acc c)
  (if (= c 40)
    (lex-continue arena src len (+ i 1) (Cons (TkLParen) acc))
    (if (= c 41)
      (lex-continue arena src len (+ i 1) (Cons (TkRParen) acc))
      (if (= c 123)
        (lex-continue arena src len (+ i 1) (Cons (TkLBrace) acc))
        (if (= c 125)
          (lex-continue arena src len (+ i 1) (Cons (TkRBrace) acc))
          (if (= c 91)
            (lex-continue arena src len (+ i 1) (Cons (TkLBracket) acc))
            (if (= c 93)
              (lex-continue arena src len (+ i 1) (Cons (TkRBracket) acc))
              (lex-wordy arena src len i acc c))))))))

; Continue scanning after a produced token.
; Returns: List(Token) (reverse order)
(defn lex-continue (arena src len i acc)
  (lex-loop arena src len i acc))

; ':' / '~' followed by an identifier char -> keyword/symbol; bare otherwise.
; Returns: List(Token) (reverse order)
(defn lex-colonish (arena src len i acc c)
  (let probe (+ i 1)
    (let pk (next-nonws src len probe)
      (if (< pk 0)
        (lex-bare-colon arena src len i acc c)
        (if (= (chr-ident-start-p (byte-at src pk)) 0)
          (lex-bare-colon arena src len i acc c)
          (if (= (chr-punctuator-p (byte-at src pk)) 1)
            (lex-bare-colon arena src len i acc c)
            (lex-keyword-symbol arena src len i acc c pk)))))))

(defn next-nonws (src len i)
  (if (>= i len)
    -1
    (if (= (chr-ws-p (byte-at src i)) 1)
      (next-nonws src len (+ i 1))
      i)))

(defn lex-bare-colon (arena src len i acc c)
  (if (= c 58)
    (lex-continue arena src len (+ i 1) (Cons (TkColon) acc))
    (lex-continue arena src len (+ i 1) (Cons (TkSymbol (sub-str arena src i 1)) acc))))

(defn lex-keyword-symbol (arena src len i acc c pk)
  (let end (scan-ident-end src len pk)
    (let text (sub-str arena src pk (- end pk))
      (let tok (if (= c 58) (TkKeyword text) (TkSymbol text))
        (lex-continue arena src len end (Cons tok acc))))))

; Extract a substring of `src` as a fresh NUL-terminated buffer.
; Returns: Int (pointer)
(defn sub-str (arena src start n)
  (ffi-call "zyl_cstr_sub" arena src start n 1000))

; String literal at the cursor.
; Returns: List(Token) (reverse order)
(defn lex-string-lit (arena src len i acc)
  (let e (scan-str-end src len (+ i 1))
    (if (< e 0)
      (Cons (TkEof) acc)   ; unterminated -> EOF
      ; zyl_cstr_decode takes (arena, src, start, end)
      (let text (ffi-call "zyl_cstr_decode" arena src (+ i 1) e 1000)
        (lex-continue arena src len (+ e 1) (Cons (TkString text) acc))))))

; Numeric literal at the cursor. TkInt carries the value; TkFloat the text.
; Returns: List(Token) (reverse order)
(defn lex-number-lit (arena src len i acc)
  (let e (scan-number-end src len i)
    (let text (sub-str arena src i (- e i))
      (if (= (text-float-marker-p text) 1)
        (lex-continue arena src len e (Cons (TkFloat text) acc))
        (lex-continue arena src len e
                      (Cons (TkInt (ffi-call "zyl_cstr_to_int" text 1000)) acc))))))

; Identifier or boolean literal at the cursor.
; Returns: List(Token) (reverse order)
(defn lex-ident-lit (arena src len i acc)
  (let e (scan-ident-end src len i)
    (let text (sub-str arena src i (- e i))
      (lex-ident-done arena src len e acc text))))

(defn lex-ident-done (arena src len i acc text)
  (let is-true (str-eq text (str-intern arena "true")))
  (if (> is-true 0)
    (lex-continue arena src len i (Cons (TkBool true) acc))
    (let is-false (str-eq text (str-intern arena "false"))
      (if (> is-false 0)
        (lex-continue arena src len i (Cons (TkBool false) acc))
        (lex-continue arena src len i (Cons (TkIdent text) acc))))))

; Route the non-punctuator cases by leading character.
; Returns: List(Token) (reverse order)
(defn lex-wordy (arena src len i acc c)
  (if (= c 34)
    (lex-string-lit arena src len i acc)
    (if (= c 58)
      (lex-colonish arena src len i acc c)
      (if (= c 126)
        (lex-colonish arena src len i acc c)
        (if (= (chr-digit-p c) 1)
          (lex-number-lit arena src len i acc)
          (if (= c 45)
            (lex-minus arena src len i acc)
            (if (= (chr-ident-start-p c) 1)
              (lex-ident-lit arena src len i acc)
              (Cons (TkEof) acc))))))))   ; unrecognized char -> terminate

; '-' starts a negative number only when a digit follows; else it is an
; identifier character (handled here since '-' is not ident-start alone
; in this routing path... it IS ident-start, so this branch only fires
; via the digit-check ordering above; kept total for safety).
(defn lex-minus (arena src len i acc)
  (if (= (chr-digit-p (byte-at src (+ i 1))) 1)
    (lex-number-lit arena src len i acc)
    (lex-ident-lit arena src len i acc)))
