; === Zyl Standard Library — S-Expression Balance Validator ===
; Module: compiler/sexp_balance
; Provides: the delimiter check every compile runs before lexing, with
; the location of the first fault; `zyl balance` runs it on its own.
;
; One pass over the bytes, with the lexer's own rules (lexer.zyl): a `;`
; comment runs to the end of its line, a string runs to its unescaped
; `"` (a backslash takes the next byte, a newline included), and brackets
; occur nowhere else inside a token. Every opener is pushed with its
; position; a closer must match the innermost one.
;
; Strict mode (every compile, `zyl balance`, the language server) adds the
; structural rule that makes a misplaced paren visible even when the
; file's count nets to zero: a top-level form starts in column 1, so an
; opener in column 1 while a form is still open means a closer is missing
; in that form. It also remembers the first line, in the open top-level
; form, whose first token sits at or left of the innermost open bracket's
; column: where the indentation first contradicts the nesting, which is
; where the missing closer usually belongs. The REPL checks net balance
; only (sb-check-nets), since a pasted entry may put a body in column 1.

(use allocator/allocator)

; ===========================================================================
; RESULT
; ===========================================================================

; Lines and columns are 1-based; a column counts bytes.
(deftype BalanceResult
  (Balanced)
  ; the opening quote of a string that never closes
  (UnbalancedOpenString Int Int)
  ; expected closer, the opener's line and column, the line of the
  ; top-level form that starts inside it (0: end of input), the first
  ; indentation contradiction in its top-level form (0: none)
  (UnclosedOpen String Int Int Int Int)
  ; the closer, its line and column
  (UnbalancedClose String Int Int)
  ; expected closer, the closer found, its line and column, the opener's
  ; line and column
  (MismatchedPair String String Int Int Int Int))

; An open bracket: the byte of its closer, its line and column.
(deftype SBFrame (SBFrame Int Int Int))

; ===========================================================================
; ENTRY POINTS
; ===========================================================================

; Strict: net balance plus the column-1 rule.
(defn sb-check-string ((src String)) (sb-check src true))

; Net balance only (the REPL's completeness test).
(defn sb-check-nets ((src String)) (sb-check src false))

(defn sb-check ((src String) (strict Bool))
  (sb-scan src (str-length src) 0 1 0 true Nil 0 strict))

; A whole file, read in 1 MiB steps (a single read would cap its size), or None.
(defn sb-read-file ((path String))
  (let fd (file-open path "r")
    (if (< fd 1) None
      (let text (sb-read-all fd "")
        (let _ (file-close fd) (Some text))))))

; Where a NUL byte ends `text`, read from `path`, before the file does; -1 when
; none does. The lexer stops at the first NUL, so the rest would be ignored.
; The file's size is enough: nothing is read, so nothing is kept.
(defn sb-nul-offset ((path String) (text String))
  (if (> (ffi-call "zyl_file_size" path 1000) (str-length text)) (str-length text) -1))

(defn sb-read-all ((fd Int) (acc String))
  (let chunk (file-read fd 1048576)
    (let n (str-length chunk)
      (if (= n 0) acc
        (let acc2 (str-concat acc chunk)
          (if (< n 1048576) acc2 (sb-read-all fd acc2)))))))

; ===========================================================================
; THE SCAN
; ===========================================================================

(defn sb-byte ((src String) (len Int) (i Int)) (ffi-call "zyl_view_byte" src 0 len i 1000))

(defn sb-opener-p ((c Int)) (or (= c 40) (or (= c 91) (= c 123))))
(defn sb-closer-p ((c Int)) (or (= c 41) (or (= c 93) (= c 125))))

; The closer of an opener byte.
(defn sb-closer-of ((c Int)) (if (= c 40) 41 (if (= c 91) 93 125)))

(defn sb-text ((c Int)) (if (= c 41) ")" (if (= c 93) "]" (if (= c 125) "}" (if (= c 40) "(" (if (= c 91) "[" "{"))))))

; i: byte index; line: its line; ls: index where that line starts; fresh:
; no token seen yet on this line; stack: open frames, innermost first;
; anom: the first indentation contradiction in the open top-level form.
(defn sb-scan ((src String) (len Int) (i Int) (line Int) (ls Int) (fresh Bool) stack (anom Int) (strict Bool))
  (if (>= i len) (sb-eof stack anom)
    (let c (sb-byte src len i)
      (if (= c 10) (sb-scan src len (+ i 1) (+ line 1) (+ i 1) true stack anom strict)
        (if (or (= c 32) (or (= c 9) (= c 13))) (sb-scan src len (+ i 1) line ls fresh stack anom strict)
          (if (= c 59) (sb-scan src len (sb-line-end src len i) line ls fresh stack anom strict)
            (sb-token src len i line ls fresh stack anom strict c (+ (- i ls) 1))))))))

; The first byte of a token at column col.
(defn sb-token ((src String) (len Int) (i Int) (line Int) (ls Int) (fresh Bool) stack (anom Int) (strict Bool) (c Int) (col Int))
  (if (and strict (and fresh (and (= col 1) (and (sb-opener-p c) (not (sb-empty stack))))))
    (sb-outermost stack line anom)
    (let a (if (and fresh (= anom 0)) (sb-contradiction stack c col line) anom)
      (if (= c 34) (sb-string src len (+ i 1) line ls stack a strict line col)
        (if (sb-opener-p c)
          (sb-scan src len (+ i 1) line ls false (Cons (SBFrame (sb-closer-of c) line col) stack) a strict)
          (if (sb-closer-p c) (sb-close src len i line ls stack a strict c col)
            (sb-scan src len (+ i 1) line ls false stack a strict)))))))

; `line` when its first token, at col and not a closer, sits at or left of
; the innermost open bracket; else 0.
(defn sb-contradiction (stack (c Int) (col Int) (line Int))
  (match stack
    (Nil 0)
    (Cons f _ (match f (SBFrame _ _ oc (if (and (not (sb-closer-p c)) (<= col oc)) line 0))))))

(defn sb-close ((src String) (len Int) (i Int) (line Int) (ls Int) stack (anom Int) (strict Bool) (c Int) (col Int))
  (match stack
    (Nil (UnbalancedClose (sb-text c) line col))
    (Cons f rest
      (match f
        (SBFrame want ol oc
          (if (= want c)
            (sb-scan src len (+ i 1) line ls false rest (if (sb-empty rest) 0 anom) strict)
            (MismatchedPair (sb-text want) (sb-text c) line col ol oc)))))))

; Inside a string opened at sl:sc; i is just past its quote.
(defn sb-string ((src String) (len Int) (i Int) (line Int) (ls Int) stack (anom Int) (strict Bool) (sl Int) (sc Int))
  (let e (sb-string-end src len i)
    (if (< e 0) (UnbalancedOpenString sl sc)
      (let nl (sb-nl-last src len i e)
        (sb-scan src len e (+ line (sb-nl-count src len i e 0)) (if (< nl 0) ls (+ nl 1)) false stack anom strict)))))

; ===========================================================================
; THE LEXICAL RULES -- the one implementation every scanner uses
; ===========================================================================
;
; The balancer above, `zyl balance --fix` (text/parens), `zyl fmt`
; (text/format) and the language server's scanners all skip strings and
; comments through these, so none of them can disagree with another about
; what is code. regression/balance-agreement holds them to the lexer.

; Just past the `"` that ends the string whose contents start at i, or -1
; when the text ends first. A backslash takes the next byte, a newline
; included.
(defn sb-string-end ((src String) (len Int) (i Int))
  (if (>= i len) -1
    (let c (sb-byte src len i)
      (if (= c 92) (sb-string-end src len (+ i 2))
        (if (= c 34) (+ i 1) (sb-string-end src len (+ i 1)))))))

; Index of the newline ending the line at i (a `;` comment's end), or len.
(defn sb-line-end ((src String) (len Int) (i Int))
  (if (>= i len) len (if (= (sb-byte src len i) 10) i (sb-line-end src len (+ i 1)))))

; Newlines in [i, j), and the index of the last one (-1: none).
(defn sb-nl-count ((src String) (len Int) (i Int) (j Int) (acc Int))
  (if (>= i j) acc (sb-nl-count src len (+ i 1) j (if (= (sb-byte src len i) 10) (+ acc 1) acc))))

(defn sb-nl-last ((src String) (len Int) (i Int) (j Int))
  (if (<= j i) -1 (if (= (sb-byte src len (- j 1)) 10) (- j 1) (sb-nl-last src len i (- j 1)))))

(defn sb-ws-p ((c Int)) (or (= c 32) (or (= c 9) (= c 13))))

; One line of text, read with those rules, given whether it starts inside a
; string: its brackets outside strings and comments, each as
; offset * 256 + byte, in order; where its comment starts (or its length);
; whether it ends inside a string; and its first non-blank byte (its length
; when blank, -1 when it starts inside a string).
(deftype SbLine (SbL (List Int) Int Bool Int))

(defn SbLine.brackets (l) (match l (SbL b _ _ _ b)))
(defn SbLine.comment (l) (match l (SbL _ c _ _ c)))
(defn SbLine.instr (l) (match l (SbL _ _ s _ s)))
(defn SbLine.first (l) (match l (SbL _ _ _ f f)))

(defn sb-line-info ((l String) (instr Bool))
  (let len (str-length l)
    (if instr
      (let e (sb-string-end l len 0)
        (if (< e 0) (SbL Nil len true -1) (sb-line-from l len e Nil -1)))
      (sb-line-from l len 0 Nil (sb-first-code l len 0)))))

(defn sb-first-code ((l String) (len Int) (i Int))
  (if (and (< i len) (sb-ws-p (sb-byte l len i))) (sb-first-code l len (+ i 1)) i))

(defn sb-line-from ((l String) (len Int) (i Int) acc (first Int))
  (if (>= i len) (SbL (list-reverse acc) len false first)
    (let c (sb-byte l len i)
      (if (= c 59) (SbL (list-reverse acc) i false first)
        (if (= c 34)
          (let e (sb-string-end l len (+ i 1))
            (if (< e 0) (SbL (list-reverse acc) len true first) (sb-line-from l len e acc first)))
          (if (or (sb-opener-p c) (sb-closer-p c))
            (sb-line-from l len (+ i 1) (Cons (+ (* i 256) c) acc) first)
            (sb-line-from l len (+ i 1) acc first)))))))

; The position just past a skipped string or comment that started at
; line:col and covers [i, j): newlines in it advance the line and reset the
; column.
(defn sb-line-after ((src String) (len Int) (i Int) (j Int) (line Int))
  (+ line (sb-nl-count src len i j 0)))

(defn sb-col-after ((src String) (len Int) (i Int) (j Int) (col Int))
  (let nl (sb-nl-last src len i j)
    (if (< nl 0) (+ col (- j i)) (- j (+ nl 1)))))

(defn sb-empty (stack) (match stack (Nil true) (Cons _ _ false)))

; End of input: the innermost open bracket, if any.
(defn sb-eof (stack (anom Int))
  (match stack
    (Nil Balanced)
    (Cons f _ (match f (SBFrame want ol oc (UnclosedOpen (sb-text want) ol oc 0 anom))))))

; A top-level form starts at `line` while the outermost frame is open.
(defn sb-outermost (stack (line Int) (anom Int))
  (match stack
    (Nil Balanced)
    (Cons f rest
      (match rest
        (Nil (match f (SBFrame want ol oc (UnclosedOpen (sb-text want) ol oc line anom))))
        (Cons _ _ (sb-outermost rest line anom))))))

; ===========================================================================
; BYTE CLASSES (shared with the language server's scanner, lsp/source_index.zyl)
; ===========================================================================

; The first byte of a one-character string.
(defn sb-str-code ((s String)) (ffi-call "zyl_cstr_byte_at" s 0 1000))

(defn sb-is-paren-open ((c Int)) (= c 40))
(defn sb-is-paren-close ((c Int)) (= c 41))
(defn sb-is-bracket-open ((c Int)) (= c 91))
(defn sb-is-bracket-close ((c Int)) (= c 93))
(defn sb-is-brace-open ((c Int)) (= c 123))
(defn sb-is-brace-close ((c Int)) (= c 125))
(defn sb-is-quote ((c Int)) (= c 34))
(defn sb-is-semicolon ((c Int)) (= c 59))
(defn sb-is-backslash ((c Int)) (= c 92))
(defn sb-is-newline ((c Int)) (= c 10))

; ===========================================================================
; RESULT QUERIES AND TEXT
; ===========================================================================

(defn sb-result-balanced (r)
  (match r
    (Balanced true)
    (_ false)))

(defn sb-result-error (r) (not (sb-result-balanced r)))

; The diagnostic code of a result ("" when balanced).
(defn sb-code (r)
  (match r
    (Balanced "")
    (UnbalancedOpenString _ _ "E_UNTERMINATED_STRING")
    (UnclosedOpen _ _ _ _ _ "E_UNBALANCED_UNCLOSED")
    (UnbalancedClose _ _ _ "E_UNBALANCED_UNEXPECTED_CLOSE")
    (MismatchedPair _ _ _ _ _ _ "E_UNBALANCED_MISMATCHED_BRACKET")))

; The headline of a result ("" when balanced).
(defn sb-message (r)
  (match r
    (Balanced "")
    (UnbalancedOpenString _ _ "unterminated string literal: this quote is never closed")
    (UnclosedOpen closer _ _ top _
      (if (> top 0)
        (str-concat "this form is still open where a new top-level form starts at line " (sb-int top))
        (str-concat "unclosed opener: its '" (str-concat closer "' never comes"))))
    (UnbalancedClose closer _ _ (str-concat "unexpected '" (str-concat closer "': no opener is open here")))
    (MismatchedPair want found _ _ _ _
      (str-concat "'" (str-concat found (str-concat "' closes a bracket that expects '" (str-concat want "'")))))))

; Where the result points: (line, column).
(defn sb-line (r)
  (match r
    (Balanced 0)
    (UnbalancedOpenString l _ l)
    (UnclosedOpen _ l _ _ _ l)
    (UnbalancedClose _ l _ l)
    (MismatchedPair _ _ l _ _ _ l)))

(defn sb-col (r)
  (match r
    (Balanced 0)
    (UnbalancedOpenString _ c c)
    (UnclosedOpen _ _ c _ _ c)
    (UnbalancedClose _ _ c c)
    (MismatchedPair _ _ _ c _ _ c)))

; The fix-it: the one source of remediation text for the compiler, the
; language server's quick fix and `zyl balance`.
(defn sb-hint (r)
  (match r
    (Balanced "")
    (UnbalancedOpenString _ _ "close the string literal with a matching '\"'")
    (UnclosedOpen closer _ _ top anom
      (let insert (str-concat "insert '" (str-concat closer "'"))
        (if (> anom 0)
          (str-concat insert (str-concat " before line " (str-concat (sb-int anom) ", where the indentation first contradicts the nesting")))
          (if (> top 0)
            (str-concat insert (str-concat " to close this form before line " (sb-int top)))
            (str-concat insert " to close the opener")))))
    (UnbalancedClose closer _ _ (str-concat "remove this '" (str-concat closer "', or add the opener it was meant to close")))
    (MismatchedPair want found _ _ ol oc
      (str-concat "replace '" (str-concat found (str-concat "' with '" (str-concat want
        (str-concat "' (the opener at " (str-concat (sb-int ol) (str-concat ":" (str-concat (sb-int oc) "), or fix that opener")))))))))))

(defn sb-int ((n Int)) (ffi-call "zyl_int_text" n 1000))
