; === Zyl Compiler — Linearity ===
; Module: compiler/linearity
;
; Spec G2 names three things: no use-after-free, no double free, no
; invalid aliasing. Regions make the first two *defined* even when a
; program asks for them — a released buffer is E_USE_AFTER_FREE and a
; second release is a no-op — but neither stops the program from writing
; the mistake. This pass does.
;
; The rule is affine. A value that owns a resource is consumed by the
; operation that releases it or takes it over, and any use after that is
; E_MOVE_VALUE.
;
; The hole this closes is not hypothetical. A file handle is an `Int`, and
; an `Int` is a copyable scalar with no ownership, so this compiled clean
; under the previous compiler:
;
;   (let fd (file-open "a.txt" "w")
;     (file-close fd)
;     (let other (file-open "secret.txt" "w")   ; the OS hands `fd` back
;       (file-write fd "leaked")))              ; writes into secret.txt
;
; and it did write into secret.txt, because the number was recycled. A
; stale handle silently aliases an unrelated file. Static release
; tracking rejects the program at compile time instead.
;
; What is linear, narrowly:
;
;   - a file descriptor: `file-open` binds one, `file-close` and
;     `with-resource` release one. The parser gives these dedicated forms
;     (EFileOpen / EFileClose), so the rule does not depend on a name and
;     cannot be dodged by qualification.
;   - a StringBuffer: `make-string-buffer` binds one, `Drop.drop` (which
;     is what `with-resource` desugars to, compiler/desugar.zyl) releases
;     it. Every user `Drop` impl goes through `Drop.drop` too, so a type
;     that declares one gets this for free.
;
; What is deliberately NOT linear, and why:
;
;   - `Vec`, `IntMap`, `Set`. These are persistent: an update returns a
;     new value and the old one stays valid, which is the design
;     (docs/sound-types-design.md). Making them linear would forbid
;     reading a vector after deriving one from it, and every caller in
;     the tree does exactly that. Their safety comes from regions plus
;     bounds checks, not from linearity.
;   - Scalars and Strings. Copying a word cannot cause a double free.
;
; So the pass is small on purpose. It covers the values whose whole point
; is that they are released exactly once, and leaves the rest to the
; region system. That is a real improvement over no check; it is not a
; claim of full linearity, and PROGRESS.md records what is left.

(use compiler/expr_inner)
(use compiler/error_report)

; name -> the node that consumed it, so a diagnostic can point at the
; later use and the pass can be re-run.
(def lin-moved-store (ffi-call "zyl_smap_new" 1000))

; Roots of alias classes that name a MUTABLE LOCATION, and so carry the
; spec 06 aliasing invariant: a location has exactly one TMut reference.
;
; A bytebuf is the language's mutable location -- you write through it with
; store-u8 and the atomic ops -- so a second live name for one is "more
; than one TMut reference to a location", which is E_MUT_CONFLICT. This
; was reachable and compiled clean:
;
;   (let b (bytebuf Stack 16)
;     (let second b
;       (begin (store-u8 :le second 0 65)
;              (store-u8 :le b 0 66))))        ; the second write wins
;
; Note the contrast with a RESOURCE alias above, which is legal and
; required: two names for one descriptor are fine because the descriptor
; is a value, but two names for one mutable location are not. That
; distinction is the whole rule.
(def lin-locs (ffi-call "zyl_ref_new" Nil 1000))

(defn lin-loc-p (name)
  (lin-any-suffix (lin-find-root name) (ffi-call "zyl_ref_get" lin-locs 1000)))

(defn lin-mark-loc (name)
  (let r (lin-find-root name)
    (if (lin-any-suffix r (ffi-call "zyl_ref_get" lin-locs 1000))
      unit
      (ffi-call "zyl_ref_set" lin-locs (Cons r (ffi-call "zyl_ref_get" lin-locs 1000)) 1000))))

; The spec 06 invariant is about references, and a name only becomes a TMut
; reference by being WRITTEN through. So the rule is: within one alias
; class, at most one name may be written. Two writers is two TMut
; references to one location; a writer plus a reader is one TMut and any
; number of TCap, which the invariant explicitly allows.
;
; That is why `(let second b)` on its own is NOT rejected -- naming a
; location twice is harmless while only one name writes -- and why
; `(let v (byteslice b 0 4))` followed by a store through each of `b` and
; `v` is.
(def lin-writers (ffi-call "zyl_ref_new" Nil 1000))

; A class root already written through, and by which name. Split in two
; with the pair destructured by a separate function: nesting a match
; inside the Cons arm made the unifier's occurs check reject the
; recursion as an infinite type.
(defn lin-writer-of (root)
  (lin-writer-go root (ffi-call "zyl_ref_get" lin-writers 1000)))

(defn lin-writer-go (root xs)
  (match xs
    (Nil "")
    (Cons p t (lin-writer-step root p t))))

(defn lin-writer-step (root p t)
  (match p
    (Pair r n (if (= r root) n (lin-writer-go root t)))
    (_ "")))

(defn lin-note-write (name node)
  (if (= name "")
    unit
    (let root (lin-find-root name)
      (let prev (lin-writer-of root)
        (if (= prev "")
          (ffi-call "zyl_ref_set" lin-writers
            (Cons (Pair root name) (ffi-call "zyl_ref_get" lin-writers 1000)) 1000)
          (if (= prev name)
            unit
            (lin-report-conflict node prev)))))))

; Is this expression a fresh mutable location, or a handle into one?
(defn lin-location-value-p (e)
  (match (Expr.inner e)
    (EByteBuf region size true)
    (EByteSlice base off len true)
    (_ false)))

; Each fresh allocation gets its OWN class root, not its name.
;
; Keying classes by name looked fine and was wrong: two sibling
; `let b (bytebuf ...)` in different tests are two different locations
; that share a name, so the writer recorded for the first was still in
; force for the second and a legitimate store through a slice was
; rejected (tests/regression/byte-primitives.zyl:92). Distinct roots make
; distinct locations distinct, which is what the invariant is about.
(def lin-root-seq (ffi-call "zyl_ref_new" 0 1000))

(defn lin-unique-root (name)
  (let n (ffi-call "zyl_ref_get" lin-root-seq 1000)
    (begin
      (ffi-call "zyl_ref_set" lin-root-seq (+ n 1) 1000)
      (str-concat (str-concat name "#") (ffi-call "zyl_int_text" n 1000)))))

; The name a value's location comes from, so a derived handle joins the
; same alias class rather than starting a new one.
;
; A slice is the case that matters: `(byteslice b 0 4)` is a window onto
; `b`'s memory, not a separate buffer. Giving it its own class let
; `(let v (byteslice b 0 4))` followed by a store through each of `b` and
; `v` look like two locations, when they are one -- so the aliasing
; invariant did not fire. A bare `bytebuf` allocation has no source and
; correctly starts a class of its own.
(defn lin-source-of (e)
  (match (Expr.inner e)
    (EByteSlice base off len (lin-ident-of base))
    (_ (lin-ident-of e))))

; Alias classes. `with-resource` binds the resource to a fresh name and an
; ordinary `(let copy fd)` is how a resource gets passed around, so several
; names can stand for one resource. A release has to reach all of them:
; tracking only the name it was called on lets `(with-resource (r fd) ...)`
; followed by a use of `fd` compile clean, which is the same bug as before
; with an extra binding in the way. name -> root, "" meaning "is its own
; root".
(def lin-root-store (ffi-call "zyl_smap_new" 1000))

; Type names that have a `Drop` impl, and the constructor names that build
; them. Filled from the program's own `impl Drop` and `deftype` forms, so a
; user resource is covered without this pass knowing anything about it.
; Lists rather than maps, matched by suffix. A name is spelled one way at
; its `deftype` and another at the construction site -- the former may
; carry the defining module and the latter not -- so an exact-match table
; silently misses. Matching the way lin-ends-with does is what makes a user
; `impl Drop` visible to a call site at all.
(def lin-drop-types (ffi-call "zyl_ref_new" Nil 1000))
(def lin-drop-ctors (ffi-call "zyl_ref_new" Nil 1000))

; Nonzero while walking an exception handler.
;
; A release in a handler is conditional: it runs only if the body raised,
; so the resource may still be live afterwards and must not be treated as
; consumed. This is not a workaround, it is the rule that makes the
; with-resource desugar sound -- that rewrite (compiler/desugar.zyl) puts
; one `Drop.drop` in the catch and one after the try, and the two are
; exclusive, so at most one runs per execution. Treating the handler's as
; a consumption would report the tail's release as a use of a released
; value, which is why the compiler's own source did not compile until
; this was right. The same shape written by hand --
;
;   (try body (catch e (file-close fd)))
;   (file-close fd)
;
; is correct for the same reason, and is accepted for the same reason.
(def lin-suppress (ffi-call "zyl_ref_new" 0 1000))

(defn lin-suppressed-p () (> (ffi-call "zyl_ref_get" lin-suppress 1000) 0))

(defn lin-reset ()
  (begin
    (ffi-call "zyl_smap_clear" lin-moved-store 1000)
    (ffi-call "zyl_smap_clear" lin-root-store 1000)
    (ffi-call "zyl_ref_set" lin-locs Nil 1000)
    (ffi-call "zyl_ref_set" lin-writers Nil 1000)
    (ffi-call "zyl_ref_set" lin-root-seq 0 1000)
    (ffi-call "zyl_ref_set" lin-drop-types Nil 1000)
    (ffi-call "zyl_ref_set" lin-drop-ctors Nil 1000)))

; Constructors whose result owns a resource. `file-open` is not here: it
; has its own AST form. Matched on the tail of a canonical key, so
; `zyl/std@N::io/io::make-string-buffer` matches as well.
(def lin-ctors (Cons "make-string-buffer" Nil))

; Calls that release a resource handed to them, consuming that argument.
; `Drop.drop` is the one every `Drop` impl is reached through, including
; the release with-resource generates.
(def lin-consuming
  (Cons "Drop.drop" (Cons "string-buffer-destroy" Nil)))

(defn lin-in (x xs)
  (match xs
    (Nil false)
    (Cons h t (if (= x h) true (lin-in x t)))))

; Does `key` name `suffix`, either outright or as the tail of a qualified
; key?
;
; Matching on a suffix rather than splitting on a separator is deliberate.
; A resolved stdlib name carries a package key (`zyl/std@N::...`) and the
; module path, and hard-coding the separator meant silently matching
; nothing the moment qualification spelled it differently -- which is
; exactly what happened: the rule looked right and fired on nothing. The
; character before the suffix must not be an identifier character, so
; `Drop.drop` matches `...::core/resource::Drop.drop` but not
; `myDrop.drop`.
(defn lin-ends-with (key suffix)
  (let n (str-length key)
    (let m (str-length suffix)
      (if (< n m)
        false
        (let i (- n m)
          ; str-substring's second argument is a LENGTH, not an end index.
          (if (str-eq (str-substring key i m) suffix)
            (if (= i 0) true (str-eq (str-substring key (- i 1) 1) ":"))
            false))))))

; Qualification separates with a colon (`zyl/std@N::io/io::name`), so a
; match is either the whole key or a run preceded by one. Testing that one
; character is enough and needs no character classification.


(defn lin-tail (key) key)

(defn lin-ctor-p (name)
  (if (lin-any-suffix name lin-ctors)
    true
    (lin-marked-p lin-drop-ctors (lin-tail name))))

(defn lin-consuming-p (name) (lin-any-suffix name lin-consuming))

(defn lin-any-suffix (name names)
  (match names
    (Nil false)
    (Cons h t (if (lin-ends-with name h) true (lin-any-suffix name t)))))

; --- discovering the program's own resources -----------------------------
;
; Two steps over the top level, in this order: collect every type with a
; `Drop` impl, then collect the constructors of those types. An `impl` may
; precede or follow its `deftype`, and the constructor is what a call site
; actually names.

(defn lin-mark (ref name)
  (ffi-call "zyl_ref_set" ref (Cons name (ffi-call "zyl_ref_get" ref 1000)) 1000))

(defn lin-marked-p (ref name)
  (lin-any-suffix name (ffi-call "zyl_ref_get" ref 1000)))

; A `deftype` builds its variants directly, so the constructors are one
; level down; a struct is built by a call named after the struct itself.
(defn lin-collect-ctors (forms)
  (match forms
    (Nil unit)
    (Cons e rest
      (begin
        (match (Expr.inner e)
          (EDeftype name variants _ _
            (if (lin-marked-p lin-drop-types name)
              (lin-mark-variants variants)
              unit))
          (_ unit))
        (lin-collect-ctors rest)))))

(defn lin-mark-variants (variants)
  (match variants
    (Nil unit)
    (Cons v rest (begin (lin-mark lin-drop-ctors (AV.name v)) (lin-mark-variants rest)))))

(defn lin-collect-drops (forms)
  (match forms
    (Nil unit)
    (Cons e rest
      (begin
        (match (Expr.inner e)
          (EImplBlock trait self _
            (if (lin-eq-tail trait "Drop") (lin-mark lin-drop-types self) unit))
          (_ unit))
        (lin-collect-drops rest)))))

; `Drop` may be written bare or qualified by the module it came from, so
; this has to be a suffix test and not `=`. Comparing the whole key against
; "Drop" is why the first version of this pass found no user impls at all
; while looking entirely correct.
(defn lin-eq-tail (a b) (lin-ends-with a b))

; --- the moved set -------------------------------------------------------

; `node` is where the release happened, kept in the signature so the
; consuming walkers can pass the call site even though the diagnostic uses
; the later use. Marked unused rather than dropped to keep the shape even.
; The name at the head of this alias class. A chain always terminates: an
; entry equal to the name itself means "root", and "" means no entry.
(defn lin-find-root (name)
  (let r (ffi-call "zyl_smap_get_or" lin-root-store name "" 1000)
    (if (str-eq r "")
      name
      (if (str-eq r name) name (lin-find-root r)))))

; Record that `alias` names the same resource as `src`.
(defn lin-alias (alias src)
  (let r (lin-find-root src)
    (ffi-call "zyl_smap_put" lin-root-store alias r 1000)))

(defn lin-consume (name _node)
  (ffi-call "zyl_smap_put" lin-moved-store (lin-find-root name) 1 1000))

(defn lin-consumed-p (name)
  (= (ffi-call "zyl_smap_get_or" lin-moved-store (lin-find-root name) 0 1000) 1))

; A rebind produces a fresh resource, so the name is live again and any
; alias it had is dropped.
(defn lin-clear (name)
  (begin
    (ffi-call "zyl_smap_put" lin-moved-store (lin-find-root name) 0 1000)
    (ffi-call "zyl_smap_put" lin-root-store name name 1000)))

(defn lin-report (node name)
  (let fid (ffi-call "zyl_span_file" node 1000)
    (let off (ffi-call "zyl_span_off" node 1000)
      (let m1 (str-concat "the binding " name)
        (let msg (str-concat m1 " was released by an earlier call, so it cannot be used again")
          (ffi-call "zyl_panic"
            (err-at "E_MOVE_VALUE" msg fid off
              "a resource is released exactly once; if you need it again, open a second handle rather than reusing a released one")
            1000))))))

; --- environment ---------------------------------------------------------
;
; A chain of names that own a resource, innermost first. Every other name
; is absent from it, which is what keeps the check from firing on ordinary
; values.

(defn lin-local-p (name env)
  (match env
    (Nil false)
    (Cons n t (if (= n name) true (lin-local-p name t)))))

; The name an expression refers to, or "" if it is not a bare reference.
(defn lin-ident-of (e)
  (match (Expr.inner e)
    (EAtom a (match a (AIdent n n) (_ "")))
    (_ "")))


; --- the walker ----------------------------------------------------------
;
; One recursive pass. `env` is threaded through in evaluation order, so a
; release earlier in a body is visible to a later use in it — which is
; precisely where the mistake gets written.

; Every variant of ExprInner that carries an Expr has an arm here.
;
; That completeness is load-bearing, not tidiness. A catch-all that skips
; a subtree does not merely miss a check, it HIDES one: `print` is its own
; form (EPrint), not a call, so `(print fd)` after a release compiled clean
; while `(file-write fd ...)` was correctly rejected. A missing arm is a
; silent hole in the rule, so the variants with no Expr children
; (EError, EByteLit, EModuleDecl, ...) fall through instead, and anything
; added to ExprInner later shows up as one of those rather than quietly
; disabling the check on a new syntax.
;
; Arms that only forward sub-expressions exist so no form can hide a use.
(defn lin-walk (e env)
  (match (Expr.inner e)
    ; --- atoms and binding ---
    (EAtom a (lin-walk-atom a e env))
    (EBegin es (lin-walk-seq es env))
    (ELet name val body (lin-walk-let name val body env))
    (ELetMut name val body (begin (lin-walk val env) (lin-walk body env)))
    (EDef name val (lin-walk val env))
    (EDefn name params body (lin-walk-fn body env))
    (ELambda name params body (lin-walk-fn body env))
    (EFn name params body (lin-walk-fn body env))
    ; --- calls ---
    (ECall op args (lin-walk-call op args env))
    (EApply name args (lin-walk-apply name args env))
    (EMakeStruct name args (lin-walk-list args env))
    (EMakeVariant tyname variant args (lin-walk-list args env))
    (EMacroDef name args body (begin (lin-walk-list args env) (lin-walk body env)))
    (EUnknown name args (lin-walk-list args env))
    ; --- control ---
    (EIf c t f (begin (lin-walk c env) (lin-walk t env) (lin-walk f env)))
    (EWhile c body (begin (lin-walk c env) (lin-walk body env)))
    (ETryCatch body name handler (lin-walk-try body handler env))
    (EMatch scrut arms (lin-walk-match scrut arms env))
    (ECond clauses (lin-walk-cond clauses env))
    (EFor bindings init body (begin (lin-walk init env) (lin-walk body env)))
    (ESpawn e2 (lin-walk e2 env))
    (ESend ch msg (begin (lin-walk ch env) (lin-walk msg env)))
    (ESendClosure ch msg captures (begin (lin-walk ch env) (lin-walk msg env)))
    ; --- files: the dedicated forms the fd rule keys on ---
    (EFileOpen path mode (begin (lin-walk path env) (lin-walk mode env)))
    (EFileClose h (lin-walk-file-close h env))
    (EFileWrite h data (begin (lin-walk h env) (lin-walk data env)))
    (EFileRead h n (begin (lin-walk h env) (lin-walk n env)))
    (EExit e2 (lin-walk e2 env))
    (EClose e2 (lin-walk e2 env))
    ; --- assertions and tests ---
    (EPrint args (lin-walk-list args env))
    (EAssert e2 msg (lin-walk e2 env))
    (EAssertEqual a b (begin (lin-walk a env) (lin-walk b env)))
    (EAssertTrue e2 msg (lin-walk e2 env))
    (EAssertFalse e2 msg (lin-walk e2 env))
    (EUnwrap e2 (lin-walk e2 env))
    (ETestDecl name body flag opts (lin-walk body env))
    (ETestCompile e2 flag (lin-walk e2 env))
    (EAliasDecl name target (lin-walk target env))
    ; --- data access ---
    (EStructGet e2 field (lin-walk e2 env))
    (ETupleGet e2 index (lin-walk e2 env))
    (ETuple items (lin-walk-list items env))
    (ESetBang name e2 (lin-walk e2 env))
    (EBufAppend e2 x (begin (lin-walk e2 env) (lin-walk x env)))
    ; --- ffi ---
    (EFfiCall sym args timeout (lin-walk-list args env))
    (EFfiPin e2 (lin-walk e2 env))
    (EFfiUnpin e2 (lin-walk e2 env))
    ; --- bytes, buffers and atomics ---
    (EByteSlice base off len (begin (lin-walk base env) (lin-walk off env) (lin-walk len env)))
    (EByteSliceSub base off len (begin (lin-walk base env) (lin-walk off env) (lin-walk len env)))
    (EByteBufAppend buf x (begin (lin-walk buf env) (lin-walk x env) (lin-note-write (lin-ident-of buf) e)))
    (EByteBufLen e2 (lin-walk e2 env))
    (EByteBufCap e2 (lin-walk e2 env))
    (EByteBufPtr e2 (lin-walk e2 env))
    (EAlignCheck e2 align (lin-walk e2 env))
    (ELoadByte endian base off (begin (lin-walk base env) (lin-walk off env)))
    (ELoadByteSigned endian base off (begin (lin-walk base env) (lin-walk off env)))
    (EStoreByte endian base off v (begin (lin-walk base env) (lin-walk off env) (lin-walk v env) (lin-note-write (lin-ident-of base) e)))
    (EStoreByteSigned endian base off v (begin (lin-walk base env) (lin-walk off env) (lin-walk v env) (lin-note-write (lin-ident-of base) e)))
    (EAtomicLoad p (lin-walk p env))
    (EAtomicStore p v (begin (lin-walk p env) (lin-walk v env) (lin-note-write (lin-ident-of p) e)))
    (EAtomicAdd p a b (begin (lin-walk3 p a b env) (lin-note-write (lin-ident-of p) e)))
    (EAtomicSub p a b (begin (lin-walk3 p a b env) (lin-note-write (lin-ident-of p) e)))
    (EAtomicCAS p expected desired (begin (lin-walk3 p expected desired env) (lin-note-write (lin-ident-of p) e)))
    (EAtomicFetchAdd p a (begin (lin-walk2 p a env) (lin-note-write (lin-ident-of p) e)))
    (EAtomicMax p a (begin (lin-walk2 p a env) (lin-note-write (lin-ident-of p) e)))
    (EAtomicMin p a (begin (lin-walk2 p a env) (lin-note-write (lin-ident-of p) e)))
    ; --- no sub-expressions, but listed rather than caught by a wildcard:
    ; the match is exhaustive by design, so a variant added to ExprInner
    ; later has to be dealt with here instead of quietly un-walked ---
    (EError msg unit)
    (EReadLine unit)
    (ERunTests name unit)
    (EModuleDecl name unit)
    (EExport name unit)
    (EUseModule names alias flags unit)
    (EDerive name traits unit)
    (EByteLit v unit)
    (EByteBuf region size unit)
    (EDeftype name variants params parent unit)
    (ETraitDecl name methods parent unit)
    (EImplBlock trait self bodies unit)
    (EStructDef sd parent unit)
    (EStructDefPlus sd parent unit)))

(defn lin-walk2 (a b env)
  (begin (lin-walk a env) (lin-walk b env)))

(defn lin-walk3 (a b c env) (lin-walk2 a b env) (lin-walk c env))

(defn lin-walk-atom (a e env)
  (match a
    (AIdent name tag
      (if (if (lin-local-p name env) (lin-consumed-p name) false)
        (lin-report e name)
        unit))
    (_ unit)))

; A sequence evaluates left to right (spec: strict evaluation order), so a
; release earlier in the body is visible to a use later in it.
(defn lin-walk-seq (es env)
  (match es
    (Nil unit)
    (Cons h t (begin (lin-walk h env) (if (is-nil t) unit (lin-walk-seq t env))))))

; Rebinding a name that owned a resource produces a fresh one, so the old
; moved mark must not carry over to it.
(defn lin-walk-let (name val body env)
  (let src (lin-source-of val)
    (begin
      (lin-walk-let-rest name val body env src))))

(defn lin-report-conflict (node other)
  (let fid (ffi-call "zyl_span_file" node 1000)
    (let off (ffi-call "zyl_span_off" node 1000)
      (let m1 (str-concat "one mutable location is written through both " other)
        (let msg (str-concat m1 " and the name used here; a location may have exactly one TMut reference, so only one name may write to it")
          (ffi-call "zyl_panic"
            (err-at "E_MUT_CONFLICT" msg fid off
              "write through a single name, or read the bytes you need and copy them into a buffer of your own")
            1000))))))

(defn lin-walk-let-rest (name val body env src)
  ; An alias of a live resource is itself one; anything else has to
  ; construct a fresh resource to be linear at all.
  (let linear (if (str-eq src "") (lin-val-is-resource val env) (lin-local-p src env))
    (let env2 (if linear (Cons name env) env)
      (begin
        (lin-clear name)
        (if (if linear (str-eq src "") false) unit (lin-alias name src))
        ; A fresh allocation is a new location: give it a class of its own
        ; so it cannot inherit a writer recorded under the same name. A
        ; slice already joined its base's class above, via lin-source-of.
        (if (lin-fresh-location-p val)
          (lin-set-root name (lin-unique-root name))
          unit)
        (lin-walk val env)
        (lin-walk body env2)))))

(defn lin-fresh-location-p (e)
  (match (Expr.inner e)
    (EByteBuf region size true)
    (_ false)))

(defn lin-set-root (name root)
  (ffi-call "zyl_smap_put" lin-root-store name root 1000))

; Does this value own a resource?
;
;   - the dedicated form for `file-open`
;   - a construction of a type the program gave a `Drop` impl
;   - a call to a resource constructor
;   - a reference to another linear binding in scope
;
; The last case is what makes the rest work. `with-resource` desugars to
; `(let r c ... (Drop.drop r))`, binding the resource to a fresh name, and
; an ordinary `(let copy fd)` is how a program passes one around. Both are
; aliases of the same resource, so both are consumed by the release and
; both are dead afterwards; tracking only the original would let the alias
; be used after the fact, which is the whole bug.
(defn lin-val-is-resource (e env)
  (match (Expr.inner e)
    (EFileOpen _ _ true)
    (EMakeStruct name args (lin-marked-p lin-drop-types name))
    (EMakeVariant tyname variant args (lin-marked-p lin-drop-types tyname))
    (EAtom a (match a
      (AIdent name tag (lin-local-p name env))
      (_ false)))
    (_ (lin-ctor-p (lin-callee-of e)))))

; The name of a reference, or the callee of a call: "" if neither. The
; EAtom arm matters on its own -- a callee IS a bare reference, so without
; it every call reads as unnamed and no release is ever recognised.
(defn lin-callee-of (e)
  (match (Expr.inner e)
    (EApply name args name)
    (ECall op args (lin-ident-of op))
    (EAtom a (lin-ident-of e))
    (_ "")))

; A call whose arguments are walked in order; a call to a release function
; consumes the resource arguments it is handed.
(defn lin-walk-call (op args env)
  (let name (lin-callee-of op)
    (begin
      (lin-walk op env)
      (lin-walk-list args env)
      (if (lin-consuming-p name) (lin-consume-args args env) unit))))

(defn lin-walk-apply (name args env)
  (begin
    (lin-walk-list args env)
    (if (lin-consuming-p name) (lin-consume-args args env) unit)))

; Release every live resource argument. A release call takes the resource
; by value, so two distinct handles are two distinct resources and each is
; marked on its own.
(defn lin-consume-args (args env)
  (match args
    (Nil unit)
    (Cons h t
      (let n (lin-ident-of h)
        (begin
          (if (if (lin-local-p n env) (not (lin-suppressed-p)) false) (lin-consume n h) unit)
          (lin-consume-args t env))))))

; `(file-close fd)` has its own form, so the fd rule does not depend on a
; name that qualification could rewrite.
(defn lin-walk-file-close (h env)
  (let n (lin-ident-of h)
    (begin
      (lin-walk h env)
      (if (if (lin-local-p n env) (not (lin-suppressed-p)) false) (lin-consume n h) unit))))

(defn lin-walk-list (es env)
  (match es
    (Nil unit)
    (Cons h t (begin (lin-walk h env) (lin-walk-list t env)))))

; The body runs normally; the handler with consumption suppressed.
(defn lin-walk-try (body handler env)
  (begin
    (lin-walk body env)
    (ffi-call "zyl_ref_set" lin-suppress 1 1000)
    (lin-walk handler env)
    (ffi-call "zyl_ref_set" lin-suppress 0 1000)))

(defn lin-walk-cond (clauses env)
  (match clauses
    (Nil unit)
    (Cons h t
      (begin
        (match h
          (Pair c body (begin (lin-walk c env) (lin-walk body env)))
          (_ unit))
        (lin-walk-cond t env)))))

(defn lin-walk-match (scrut arms env)
  (begin
    (lin-walk scrut env)
    (lin-walk-arms arms env)))

; Each arm body starts from the environment at the match, since an arm
; binds its own pattern variables.
(defn lin-walk-arms (arms env)
  (match arms
    (Nil unit)
    (Cons h t (begin (lin-walk-arm h env) (lin-walk-arms t env)))))

(defn lin-walk-arm (arm env)
  (match arm
    (MA variant patterns body tag (lin-walk body env))))

; A closure body sees the bindings in scope where it is written. A release
; inside it still consumes for uses after the closure is built, but the
; closure's own later uses are checked against the same environment, which
; is what stops `(let f (fn ... (file-close fd) ...) ) (file-close fd)`.
(defn lin-walk-fn (body env) (lin-walk body env))

; --- entry point ---------------------------------------------------------

(defn lin-check-program (exprs)
  (begin
    (lin-reset)
    (lin-collect-drops exprs)
    (lin-collect-ctors exprs)
    (lin-top exprs)
    0))

(defn lin-top (forms)
  (match forms
    (Nil 0)
    (Cons e rest
      (begin
        (match (Expr.inner e)
          (EDefn name params body (lin-walk-fn body Nil))
          (ETestDecl name body flag opts (lin-walk-fn body Nil))
          (_ unit))
        (lin-top rest)))))


