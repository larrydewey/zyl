; === Zyl Standard Library — Compiler secret / constant-time check ===
; Module: compiler/secret_check
;
; Phase 0 of MATH_CRYPTO_IMPLEMENTATION_PLAN.md, in the form this
; compiler can actually enforce: the TCSecret capability's OBLIGATIONS,
; checked syntactically over the pre-lowering Expr tree, at the same
; stage as mutability_check.zyl / unused_check.zyl.
;
; A parameter annotated `Secret` -- either bare (`(k Secret)`) or
; applied (`(k (Secret Int))`, which the reader lowers to an EApply
; head, see expr_inner.zyl's dispatch-special default arm) -- seeds a
; taint that this pass propagates through lets, calls, arithmetic and
; constructors. Five things a tainted value may then NOT do:
;
;   - steer control flow: `if`/`while`/`for`/`cond` condition, `match`
;     subject                                      -> E_CT_VIOLATION
;   - address memory: the index argument of w-get/w-set/list-nth/
;     alloc-read-int/..., or a load/store byte offset
;                                                  -> E_CT_VIOLATION
;   - go through a variable-latency divider: `/` or `mod`
;                                                  -> E_CT_VIOLATION
;   - reach a debug sink: `print`                  -> E_SECRET_DEBUG
;   - leave the process or the actor: `spawn`, `send`, `file-write`
;                                                  -> E_SECRET_ESCAPE
;
; and one it must do at the FFI boundary: cross it through `ffi-pin`
; (Pin region) rather than raw                     -> E_FFI_PIN_REQUIRED.
;
; Why syntactic and not a type-level effect: param type annotations in
; this pipeline are Exprs that type_inference only ever consults
; loosely (see collect-defn-params), and the unifier has no capability
; polarity -- a real CT EFFECT in the type system would need a
; constraint solver this inferer does not have. The taint walk below
; sees exactly the same program the type checker does, at a stage where
; names are still intact, and its failure direction matches the rest of
; this compiler's checkers: an unwalked shape misses a diagnostic, it
; never rejects a valid program.
;
; DECLASSIFICATION is explicit and named: `declassify`, and the two
; library functions whose entire purpose is to reduce a secret to one
; public accept/reject bit (`ct-eq-bool`, `ct-eq-words-bool`, see
; math/secret/secret.zyl). A call to any of them returns untainted.
; Without that hatch no AEAD could ever act on its own tag check.
;
; INTERPROCEDURAL part: a function whose body is tainted under its own
; Secret parameters is itself secret-returning, so its callers taint
; too. That set is computed by a fixpoint (sc-fix) before any checking
; happens, capped at a fixed number of rounds so the pass is linear and
; terminating regardless of call-graph shape.
;
; Programs with no `Secret` annotation anywhere are entirely unaffected:
; the seed set is empty, the fixpoint terminates in one round, and every
; taint query returns 0.

(use compiler/ast)
(use compiler/expr_inner)

; --- entry point ------------------------------------------------------------

(defn sc-check-program (prog)
  (let fns (sc-fix prog Nil 8)
    (sc-check-top prog fns)))

; The checking half carries an SCtx rather than the bare
; secret-returning-function list: every diagnostic names the function it
; was raised in, and there is no source location anywhere in this
; pipeline's Expr tree to name instead (nothing downstream of the parser
; keeps one -- see error_report.zyl). Threading one extra parameter
; through every walk function would have been the alternative; bundling
; it with the list that was already threaded costs nothing at the call
; sites.
(deftype SCtx (SCtx (List String) String))
(defn sc-ctx-fns (c) (match c (SCtx f _ f)))
(defn sc-ctx-name (c) (match c (SCtx _ n n)))

(defn sc-check-top (forms fns)
  (match forms
    (Nil 0)
    (Cons e rest
      (begin
        (match (Expr.inner e)
          (EDefn name params body
            (let secrets (sc-secret-params params)
              (begin
                (sc-expr body secrets (SCtx fns name))
                (sc-check-zeroize name secrets body (sc-in name fns)))))
          (ETestDecl tname body _ (sc-expr body Nil (SCtx fns tname)))
          (_ 0))
        (sc-check-top rest fns)))))

; --- small list/string helpers ---------------------------------------------

(defn sc-in (name xs)
  (match xs
    (Nil 0)
    (Cons h t (if (> (str-eq h name) 0) 1 (sc-in name t)))))

(defn sc-len (xs)
  (match xs
    (Nil 0)
    (Cons _ t (+ 1 (sc-len t)))))

(defn sc-fail (msg)
  (ffi-call "zyl_panic" msg 1000))

; Warnings go through the runtime sink, like unused_check.zyl's uc-warn-line.
(defn sc-warn (msg)
  (ffi-call "zyl_warn_emit" msg 1000))

; Bind `name` into the tainted scope only when its initializer was
; tainted; an untainted rebinding SHADOWS an outer secret of the same
; name, so it must also be able to remove one.
(defn sc-bind (name tainted scope)
  (if (> tainted 0)
    (Cons name scope)
    (sc-remove name scope)))

(defn sc-remove (name xs)
  (match xs
    (Nil Nil)
    (Cons h t
      (if (> (str-eq h name) 0)
        (sc-remove name t)
        (Cons h (sc-remove name t))))))

; --- Secret parameter annotations -------------------------------------------

(defn sc-secret-params (params)
  (match params
    (Nil Nil)
    (Cons p rest
      (if (> (sc-param-is-secret p) 0)
        (Cons (P.name p) (sc-secret-params rest))
        (sc-secret-params rest)))))

(defn sc-param-is-secret (p)
  (match (P.type p)
    (Some t (sc-type-is-secret t))
    (None 0)))

; `Secret` -> EAtom AIdent; `(Secret Int)` -> EApply "Secret"; a reader
; that produced a generic ECall instead is handled by looking at its
; operator.
(defn sc-type-is-secret (t)
  (match (Expr.inner t)
    (EAtom a
      (match a
        (AIdent n (if (> (str-eq (sc-plain n) "Secret") 0) 1 0))
        (_ 0)))
    (EApply n _ (if (> (str-eq (sc-plain n) "Secret") 0) 1 0))
    (ECall op _ (sc-type-is-secret op))
    (_ 0)))

; Names arrive qualified by the module resolver (spec v5.0 SS31.2:
; `pkg@major::module::symbol`), and every rule below recognises a symbol
; by its SOURCE spelling — `declassify` is the declassifier whichever
; package defines it. Reducing a canonical key to its final segment keeps
; those rules working without teaching each one about packages. A name
; with no "::" is returned unchanged, so unqualified input behaves
; exactly as before.
(defn sc-plain (n)
  (let i (sc-last-colons n (- (sc-nlen n) 2))
    (if (< i 0) n (str-substring n (+ i 2) (- (sc-nlen n) (+ i 2))))))

(defn sc-nlen (n)
  (ffi-call "zyl_cstr_len" n 1000))

(defn sc-last-colons (n i)
  (if (< i 0)
    -1
    (if (= (ffi-call "zyl_cstr_byte_at" n i 1000) 58)
      (if (= (ffi-call "zyl_cstr_byte_at" n (+ i 1) 1000) 58) i (sc-last-colons n (- i 1)))
      (sc-last-colons n (- i 1)))))

; --- secret-returning-function fixpoint --------------------------------------

(defn sc-fix (prog fns budget)
  (if (< budget 1)
    fns
    (let next (sc-round prog fns)
      (if (= (sc-len next) (sc-len fns))
        next
        (sc-fix prog next (- budget 1))))))

(defn sc-round (prog fns)
  (match prog
    (Nil fns)
    (Cons e rest (sc-round rest (sc-round-defn e fns)))))

(defn sc-round-defn (e fns)
  (match (Expr.inner e)
    (EDefn name params body
      (if (> (sc-in name fns) 0)
        fns
        (if (> (sc-taint body (sc-secret-params params) fns) 0)
          (Cons name fns)
          fns)))
    (_ fns)))

; --- declassification and sensitive builtins --------------------------------

(defn sc-is-declassify (name0)
  (let name (sc-plain name0)
  (if (> (str-eq name "declassify") 0)
    1
    (if (> (str-eq name "ct-declassify") 0)
      1
      (if (> (str-eq name "ct-eq-bool") 0)
        1
        (if (> (str-eq name "ct-eq-words-bool") 0) 1 0))))))

; Argument position that ADDRESSES memory, or -1 when the call is not a
; memory access at all. A secret in that position picks a cache line by
; key material, which is the load half of what E_CT_VIOLATION covers.
(defn sc-index-pos (name0)
  (let name (sc-plain name0)
  (if (> (str-eq name "w-get") 0)
    1
    (if (> (str-eq name "w-set") 0)
      1
      (if (> (str-eq name "list-nth") 0)
        1
        (if (> (str-eq name "vec-get") 0)
          1
          (if (> (str-eq name "vec-set") 0)
            1
            (if (> (str-eq name "str-nth") 0)
              1
              (if (> (str-eq name "str-char-at") 0)
                1
                (if (> (str-eq name "alloc-read-int") 0)
                  0
                  (if (> (str-eq name "alloc-write-int") 0) 0 (- 0 1))))))))))))

; Variable-latency arithmetic: x86 idiv's cycle count depends on its
; operands, so a secret dividend or divisor is a timing channel exactly
; like a branch is.
(defn sc-is-divide (name0)
  (let name (sc-plain name0)
  (if (> (str-eq name "/") 0)
    1
    (if (> (str-eq name "mod") 0) 1 (if (> (str-eq name "%") 0) 1 0)))))

(defn sc-nth-arg (args n)
  (match args
    (Nil None)
    (Cons h t (if (< n 1) (Some h) (sc-nth-arg t (- n 1))))))

(defn sc-butlast (xs)
  (match xs
    (Nil Nil)
    (Cons h t (if (nil? t) Nil (Cons h (sc-butlast t))))))

; --- taint propagation -------------------------------------------------------

(defn sc-taint-list (xs scope fns)
  (match xs
    (Nil 0)
    (Cons h t (if (> (sc-taint h scope fns) 0) 1 (sc-taint-list t scope fns)))))

(defn sc-taint-arms (arms scope fns)
  (match arms
    (Nil 0)
    (Cons a rest
      (match a
        (MA _ _ body
          (if (> (sc-taint body scope fns) 0) 1 (sc-taint-arms rest scope fns)))))))

(defn sc-taint-clauses (clauses scope fns)
  (match clauses
    (Nil 0)
    (Cons pr rest
      (match pr
        (Pair _ body
          (if (> (sc-taint body scope fns) 0) 1 (sc-taint-clauses rest scope fns)))))))

(defn sc-taint-last (xs scope fns)
  (match xs
    (Nil 0)
    (Cons h t (if (nil? t) (sc-taint h scope fns) (sc-taint-last t scope fns)))))

(defn sc-call-head (op)
  (match (Expr.inner op)
    (EAtom a
      (match a
        (AIdent n n)
        (_ "")))
    (_ "")))

(defn sc-taint-call (name args scope fns)
  (if (> (sc-is-declassify name) 0)
    0
    (if (> (sc-in name fns) 0)
      1
      (sc-taint-list args scope fns))))

(defn sc-taint (e scope fns)
  (match (Expr.inner e)
    (EAtom a
      (match a
        (AIdent n (sc-in n scope))
        (_ 0)))
    (ECall op args (sc-taint-call (sc-call-head op) args scope fns))
    (EApply n args (sc-taint-call n args scope fns))
    (ELet name val body
      (sc-taint body (sc-bind name (sc-taint val scope fns) scope) fns))
    (ELetMut name val body
      (sc-taint body (sc-bind name (sc-taint val scope fns) scope) fns))
    (EBegin xs (sc-taint-last xs scope fns))
    ; A branch whose condition is public still yields a secret when
    ; either side does -- that is ct-select's own shape.
    (EIf _ t eb (if (> (sc-taint t scope fns) 0) 1 (sc-taint eb scope fns)))
    (ECond clauses (sc-taint-clauses clauses scope fns))
    ; Matching on a secret is rejected outright by sc-expr; the taint
    ; answer here still accounts for it, so a violation upstream does
    ; not silently launder the value.
    (EMatch subj arms
      (if (> (sc-taint subj scope fns) 0) 1 (sc-taint-arms arms scope fns)))
    (EMakeVariant _ _ args (sc-taint-list args scope fns))
    (EMakeStruct _ fields (sc-taint-list fields scope fns))
    (EStructGet se _ (sc-taint se scope fns))
    (EUnwrap e2 (sc-taint e2 scope fns))
    (EFfiPin e2 (sc-taint e2 scope fns))
    (EFfiUnpin e2 (sc-taint e2 scope fns))
    (EFfiCall _ args _ (sc-taint-list args scope fns))
    ; Reading out of a secret buffer produces secret bytes.
    (ELoadByte _ base off
      (if (> (sc-taint base scope fns) 0) 1 (sc-taint off scope fns)))
    (ELoadByteSigned _ base off
      (if (> (sc-taint base scope fns) 0) 1 (sc-taint off scope fns)))
    (ETryCatch tbody _ handler
      (if (> (sc-taint tbody scope fns) 0) 1 (sc-taint handler scope fns)))
    (_ 0)))

; --- the actual check ---------------------------------------------------------

; "<code>: ... in `<function>`" is the whole location this pipeline can
; offer: the Expr tree downstream of the parser carries no source spans,
; so the enclosing function name is what a reader has to go on.
(defn sc-where (fns msg)
  (str-concat "in `" (str-concat (sc-ctx-name fns) (str-concat "`: " msg))))

(defn sc-list (xs scope fns)
  (match xs
    (Nil 0)
    (Cons h t (begin (sc-expr h scope fns) (sc-list t scope fns)))))

(defn sc-arms (arms scope fns)
  (match arms
    (Nil 0)
    (Cons a rest
      (match a
        (MA _ _ body (begin (sc-expr body scope fns) (sc-arms rest scope fns)))))))

(defn sc-cond-clauses (clauses scope fns)
  (match clauses
    (Nil 0)
    (Cons pr rest
      (match pr
        (Pair c b
          (begin
            (sc-branch-guard c scope fns "cond clause condition")
            (sc-expr c scope fns)
            (sc-expr b scope fns)
            (sc-cond-clauses rest scope fns)))))))

(defn sc-for-inits (bindings scope fns)
  (match bindings
    (Nil 0)
    (Cons pr rest
      (match pr
        (Pair _ opt
          (begin
            (match opt
              (Some e2 (sc-expr e2 scope fns))
              (None 0))
            (sc-for-inits rest scope fns)))))))

; A `for` binding initialized from a secret makes the loop variable
; secret, which is then checked like any other tainted name.
(defn sc-for-scope (bindings scope fns)
  (match bindings
    (Nil scope)
    (Cons pr rest
      (match pr
        (Pair name opt
          (sc-for-scope rest (sc-for-bind name opt scope fns) fns))))))

(defn sc-for-bind (name opt scope fns)
  (match opt
    (Some e2 (sc-bind name (sc-taint e2 scope (sc-ctx-fns fns)) scope))
    (None (sc-remove name scope))))

(defn sc-branch-guard (c scope fns what)
  (if (> (sc-taint c scope (sc-ctx-fns fns)) 0)
    (sc-fail
      (str-concat
        (sc-where fns "E_CT_VIOLATION: secret-dependent branch -- ")
        (str-concat
          what
          " is derived from a Secret value; a conditional jump on key material leaks it through timing. Use the branchless primitives in math/secret/secret (ct-select, ct-eq, ct-mask), or declassify the single accept/reject bit first")))
    0))

(defn sc-index-guard (name args scope fns)
  (let pos (sc-index-pos name)
    (if (< pos 0)
      0
      (match (sc-nth-arg args pos)
        (Some idx
          (if (> (sc-taint idx scope (sc-ctx-fns fns)) 0)
            (sc-fail
              (str-concat
                (sc-where fns "E_CT_VIOLATION: secret-dependent memory access -- the index argument of `")
                (str-concat
                  name
                  "` is derived from a Secret value; the cache line touched then depends on key material (the exact channel that killed AES T-tables). Index with a public loop counter and select with ct-select instead")))
            0))
        (None 0)))))

(defn sc-divide-guard (name args scope fns)
  (if (> (sc-is-divide name) 0)
    (if (> (sc-taint-list args scope (sc-ctx-fns fns)) 0)
      (sc-fail
        (str-concat
          (sc-where fns "E_CT_VIOLATION: secret-dependent division -- an operand of `")
          (str-concat
            name
            "` is derived from a Secret value; the divider's latency depends on its operands. Reduce with the constant-time Montgomery/Barrett paths in math/bignum instead")))
      0)
    0))

; The FFI boundary: a Secret may cross it, but only as a pinned (Pin
; region, mlock'd by zyl_pin_alloc) handover -- not as a raw value the
; runtime copies wherever it likes. `zyl_zeroize` is exempt: its whole
; job is to erase the secret it is handed, and requiring a pin around
; the erasure call would mean allocating more of the thing being erased.
(defn sc-ffi-guard (sym args scope fns)
  (if (> (str-eq sym "zyl_zeroize") 0)
    0
    (sc-ffi-args sym args scope fns)))

(defn sc-ffi-args (sym args scope fns)
  (match args
    (Nil 0)
    (Cons a rest
      (begin
        (if (> (sc-ffi-arg-raw-secret a scope fns) 0)
          (sc-fail
            (str-concat
              (sc-where fns "E_FFI_PIN_REQUIRED: Secret argument to ffi-call `")
              (str-concat
                sym
                "` is passed raw; a secret crossing the FFI boundary must be handed over through (ffi-pin ...) so it lives in pinned, non-pageable memory for the call")))
          0)
        (sc-ffi-args sym rest scope fns)))))

; Tainted AND not already wrapped in ffi-pin.
(defn sc-ffi-arg-raw-secret (a scope fns)
  (match (Expr.inner a)
    (EFfiPin _ 0)
    (_ (sc-taint a scope (sc-ctx-fns fns)))))

(defn sc-escape-guard (e scope fns what)
  (if (> (sc-taint e scope (sc-ctx-fns fns)) 0)
    (sc-fail
      (str-concat
        (sc-where fns "E_SECRET_ESCAPE: Secret value escapes through ")
        (str-concat
          what
          " -- a secret is not Send and must not leave the process; declassify it explicitly if that is genuinely intended")))
    0))

(defn sc-debug-guard (xs scope fns)
  (if (> (sc-taint-list xs scope (sc-ctx-fns fns)) 0)
    (sc-fail
      (sc-where fns "E_SECRET_DEBUG: Secret value reaches `print` -- key material must never be written to a debug sink. Print a derived public value (a tag verdict, a length) instead"))
    0))

; A function that takes key material, reduces it to something public,
; and never erases it leaves the original in the arena (and, once the
; frame is reused, in whatever reads that memory next).
;
; Only the TERMINAL consumer is warned about: a function that is itself
; secret-returning (`returns-secret` non-zero -- it appeared in the
; fixpoint set) has handed the secret onward and the erasure is its
; caller's to do, so warning there would fire on every branchless
; primitive in math/secret/secret and make the annotation unusable.
; And it stays a WARNING even for the terminal case, because erasure
; can legitimately live one frame up. Severity 2 in error_codes.zyl.
;
; The declassifiers themselves (`declassify`, `ct-eq-bool`,
; ct-eq-words-bool) are exempt by name: turning a secret into one public
; bit is their entire job, and the buffer behind it belongs to whoever
; allocated it.
(defn sc-check-zeroize (name secrets body returns-secret)
  (if (nil? secrets)
    0
    (if (> (sc-is-declassify name) 0)
      0
    (if (> returns-secret 0)
      0
    (if (> (sc-mentions-zeroize body) 0)
      0
      (sc-warn
        (str-concat
          "E_ZEROIZE_MISSING: warning: `"
          (str-concat
            name
            "` consumes a Secret parameter into a public result but never calls zeroize/zeroize-bytes on it"))))))))

(defn sc-mentions-zeroize-list (xs)
  (match xs
    (Nil 0)
    (Cons h t (if (> (sc-mentions-zeroize h) 0) 1 (sc-mentions-zeroize-list t)))))

(defn sc-mentions-zeroize-arms (arms)
  (match arms
    (Nil 0)
    (Cons a rest
      (match a
        (MA _ _ body
          (if (> (sc-mentions-zeroize body) 0) 1 (sc-mentions-zeroize-arms rest)))))))

(defn sc-is-zeroize-name (n0)
  (let n (sc-plain n0)
  (if (> (str-eq n "zeroize") 0)
    1
    (if (> (str-eq n "zeroize-bytes") 0)
      1
      (if (> (str-eq n "zyl_zeroize") 0) 1 0)))))

(defn sc-mentions-zeroize (e)
  (match (Expr.inner e)
    (EAtom a
      (match a
        (AIdent n (sc-is-zeroize-name n))
        (AStr s (sc-is-zeroize-name s))
        (_ 0)))
    (ECall op args
      (if (> (sc-is-zeroize-name (sc-call-head op)) 0)
        1
        (if (> (sc-mentions-zeroize op) 0) 1 (sc-mentions-zeroize-list args))))
    (EApply n args
      (if (> (sc-is-zeroize-name n) 0) 1 (sc-mentions-zeroize-list args)))
    (EFfiCall sym args _
      (if (> (sc-is-zeroize-name sym) 0) 1 (sc-mentions-zeroize-list args)))
    (ELet _ val body
      (if (> (sc-mentions-zeroize val) 0) 1 (sc-mentions-zeroize body)))
    (ELetMut _ val body
      (if (> (sc-mentions-zeroize val) 0) 1 (sc-mentions-zeroize body)))
    (EIf c t eb
      (if (> (sc-mentions-zeroize c) 0)
        1
        (if (> (sc-mentions-zeroize t) 0) 1 (sc-mentions-zeroize eb))))
    (EWhile c body
      (if (> (sc-mentions-zeroize c) 0) 1 (sc-mentions-zeroize body)))
    (EFor _ cond body
      (if (> (sc-mentions-zeroize cond) 0) 1 (sc-mentions-zeroize body)))
    (EBegin xs (sc-mentions-zeroize-list xs))
    (EMatch subj arms
      (if (> (sc-mentions-zeroize subj) 0) 1 (sc-mentions-zeroize-arms arms)))
    (ELambda _ _ body (sc-mentions-zeroize body))
    (EFn _ _ body (sc-mentions-zeroize body))
    (EWithResource _ init body
      (if (> (sc-mentions-zeroize init) 0) 1 (sc-mentions-zeroize body)))
    (_ 0)))

(defn sc-call-guards (name args scope fns)
  (begin
    (sc-index-guard name args scope fns)
    (sc-divide-guard name args scope fns)))

(defn sc-expr (e scope fns)
  (match (Expr.inner e)
    (ELet name val body
      (begin
        (sc-expr val scope fns)
        (sc-expr body (sc-bind name (sc-taint val scope (sc-ctx-fns fns)) scope) fns)))
    (ELetMut name val body
      (begin
        (sc-expr val scope fns)
        (sc-expr body (sc-bind name (sc-taint val scope (sc-ctx-fns fns)) scope) fns)))
    (EDef _ val (sc-expr val scope fns))
    (EIf c t eb
      (begin
        (sc-branch-guard c scope fns "an `if` condition")
        (sc-expr c scope fns)
        (sc-expr t scope fns)
        (sc-expr eb scope fns)))
    (EWhile c body
      (begin
        (sc-branch-guard c scope fns "a `while` condition")
        (sc-expr c scope fns)
        (sc-expr body scope fns)))
    (EFor bindings cond body
      (let inner (sc-for-scope bindings scope fns)
        (begin
          (sc-for-inits bindings scope fns)
          (sc-branch-guard cond inner fns "a `for` loop condition")
          (sc-expr cond inner fns)
          (sc-expr body inner fns))))
    (ECond clauses (sc-cond-clauses clauses scope fns))
    (EBegin exprs (sc-list exprs scope fns))
    (ELambda _ _ body (sc-expr body scope fns))
    (EFn _ _ body (sc-expr body scope fns))
    (ETryCatch tbody _ handler
      (begin (sc-expr tbody scope fns) (sc-expr handler scope fns)))
    (EMatch subj arms
      (begin
        (sc-branch-guard subj scope fns "a `match` subject")
        (sc-expr subj scope fns)
        (sc-arms arms scope fns)))
    (ECall op args
      (begin
        (sc-call-guards (sc-call-head op) args scope fns)
        (sc-expr op scope fns)
        (sc-list args scope fns)))
    ; `(ffi-call "sym" a b timeout)` arrives as EApply, not EFfiCall --
    ; see mutability_check.zyl's note on the same fact. The trailing
    ; timeout is dropped before the Pin check, as icnf.zyl's lowering
    ; does.
    (EApply fname args
      (begin
        (if (> (str-eq fname "ffi-call") 0)
          (sc-ffi-guard (sc-ffi-symbol args) (sc-ffi-real-args args) scope fns)
          (sc-call-guards fname args scope fns))
        (sc-list args scope fns)))
    (EFfiCall sym args _
      (begin
        (sc-ffi-guard sym args scope fns)
        (sc-list args scope fns)))
    (EFfiPin e2 (sc-expr e2 scope fns))
    (EFfiUnpin e2 (sc-expr e2 scope fns))
    (EAssert c _ (sc-expr c scope fns))
    (EUnwrap e2 (sc-expr e2 scope fns))
    (ESetBang _ val (sc-expr val scope fns))
    (EStructGet se _ (sc-expr se scope fns))
    (EMakeStruct _ fields (sc-list fields scope fns))
    (EMakeVariant _ _ args (sc-list args scope fns))
    (EPrint exprs
      (begin
        (sc-debug-guard exprs scope fns)
        (sc-list exprs scope fns)))
    (EExit c (sc-expr c scope fns))
    (EClose e2 (sc-expr e2 scope fns))
    (EFileOpen a b (begin (sc-expr a scope fns) (sc-expr b scope fns)))
    (EFileRead a b (begin (sc-expr a scope fns) (sc-expr b scope fns)))
    (EFileWrite a b
      (begin
        (sc-escape-guard b scope fns "`file-write`")
        (sc-expr a scope fns)
        (sc-expr b scope fns)))
    (EFileClose e2 (sc-expr e2 scope fns))
    (EBufAppend a b (begin (sc-expr a scope fns) (sc-expr b scope fns)))
    (EWithResource _ init body
      (begin (sc-expr init scope fns) (sc-expr body scope fns)))
    (ESpawn closure
      (begin
        (sc-escape-guard closure scope fns "a spawned closure's captures")
        (sc-expr closure scope fns)))
    (ESend actor msg
      (begin
        (sc-expr actor scope fns)
        (sc-escape-guard msg scope fns "an actor message")
        (sc-expr msg scope fns)))
    (ESendClosure actor closure _
      (begin
        (sc-expr actor scope fns)
        (sc-escape-guard closure scope fns "a sent closure's captures")
        (sc-expr closure scope fns)))
    (ELoadByte _ base off
      (begin
        (sc-offset-guard off scope fns "load")
        (sc-expr base scope fns)
        (sc-expr off scope fns)))
    (ELoadByteSigned _ base off
      (begin
        (sc-offset-guard off scope fns "load")
        (sc-expr base scope fns)
        (sc-expr off scope fns)))
    (EStoreByte _ base off val
      (begin
        (sc-offset-guard off scope fns "store")
        (sc-expr base scope fns)
        (sc-expr off scope fns)
        (sc-expr val scope fns)))
    (EStoreByteSigned _ base off val
      (begin
        (sc-offset-guard off scope fns "store")
        (sc-expr base scope fns)
        (sc-expr off scope fns)
        (sc-expr val scope fns)))
    (ETestDecl _ body _ (sc-expr body scope fns))
    (EAssertEqual l r (begin (sc-expr l scope fns) (sc-expr r scope fns)))
    (EAssertFail e2 _ (sc-expr e2 scope fns))
    (EAssertTrue e2 _ (sc-expr e2 scope fns))
    (EAssertFalse e2 _ (sc-expr e2 scope fns))
    (ETestProperty _ _ body (sc-expr body scope fns))
    (ESetup exprs (sc-list exprs scope fns))
    (ETeardown exprs (sc-list exprs scope fns))
    (ETestCompile e2 _ (sc-expr e2 scope fns))
    (EDefn _ params body (sc-expr body (sc-secret-params params) fns))
    (_ 0)))

(defn sc-offset-guard (off scope fns what)
  (if (> (sc-taint off scope (sc-ctx-fns fns)) 0)
    (sc-fail
      (str-concat
        (sc-where fns "E_CT_VIOLATION: secret-dependent memory access -- a byte ")
        (str-concat
          what
          " offset is derived from a Secret value; the address touched must depend only on public data")))
    0))

; The symbol name of an `(ffi-call "sym" ...)` -- first argument, a
; string literal. Empty when it is not a literal (nothing to name in
; the diagnostic; the Pin check still runs).
(defn sc-ffi-symbol (args)
  (match args
    (Nil "")
    (Cons h _
      (match (Expr.inner h)
        (EAtom a
          (match a
            (AStr s s)
            (_ "")))
        (_ "")))))

; Real FFI arguments: everything between the symbol and the trailing
; timeout.
(defn sc-ffi-real-args (args)
  (match args
    (Nil Nil)
    (Cons _ rest (sc-butlast rest))))
