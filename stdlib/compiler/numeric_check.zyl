; === Zyl Standard Library — Numeric Policy and Partial Operation Check ===
; Module: compiler/numeric_check
;
; Spec §20.1 and §20.3. A runtime failure may only happen where the
; source explicitly asked for it, so two things are decided here, after
; type inference and before lowering:
;
;   1. Int `+ - *` overflow is checked unless the package opts out with
;      (numeric wrapping) or (numeric saturating), in the file or in
;      zyl.pkg (module_resolver.zyl registers the policies; "" is checked).
;
;   2. Int `/` and `%` are total only with a nonzero literal divisor.
;      Any other divisor is E_PARTIAL_OPERATION, and the author picks:
;      `div!`/`rem!` stop the program on zero (E_DIVISION_BY_ZERO),
;      `div?`/`rem?` give None. No guard is recognised: an `if` around the
;      division does not make `/` total, `div!` is what says so.
;
; The policy itself is applied in ICNF lowering (icnf.zyl's ic-binop),
; which reads the same table. Both are keyed by the package half of the
; definition's canonical key (§31.2); `main`, tests and anything else
; unqualified belong to the root.

(use compiler/node_tables)
(use compiler/ast)
(use compiler/expr_inner)
(use compiler/qualify)
(use compiler/type_annotate)
(use compiler/error_report)
(use core/list)
(use core/option)

; The policy of the package `pkg` ("" is the root), or "" (checked) when it declared none.
(defn nc-policy-of (pkg)
  (ffi-call "zyl_smap_get_or" numeric-policies pkg "" 1000))

; The package a definition belongs to: the key's package half, else the root.
(defn nc-package-of (name)
  (let p (ck-package-of name)
    (if (str-eq p "<main>") "" p)))

; The policy as lowering uses it: 0 checked, 1 wrapping, 2 saturating; "" is checked.
(defn nc-policy-code (pkg)
  (let p (nc-policy-of pkg)
    (if (str-eq p "wrapping") 1 (if (str-eq p "saturating") 2 0))))

; The partial-operation rule (§20.3) is in force; it landed behind this
; switch while the standard library and the runtime moved to div!/rem!.
(defn nc-partial-enforced () true)

; ===========================================================================
; THE PASS
; ===========================================================================

(defn nc-check-program (exprs)
  (match exprs
    (Nil unit)
    (Cons e rest
      (let _ (nc-check-form e)
        (nc-check-program rest)))))

(defn nc-check-form (e)
  (match (Expr.inner e)
    (EDefn name _ body (nc-walk body (nc-policy-of (nc-package-of name))))
    (EDef name value (nc-walk value (nc-policy-of (nc-package-of name))))
    (ETestDecl _ body _ _ (nc-walk body (nc-policy-of "")))
    (_ unit)))

(defn nc-div-p (n) (or (str-eq n "/") (str-eq n "%")))

; An Int result: the kind table says neither String nor Float.
(defn nc-int-p (e) (= (ta-kind e) 0))

(defn nc-nonzero-literal (e)
  (match (Expr.inner e)
    (EAtom a (match a (AInt n (not (= n 0))) (_ false)))
    (_ false)))

(defn nc-walk (e pol) (nc-walk-in e pol Nil))

; env: (Pair name capacity) for each enclosing `let` of a `(bytebuf R N)`, innermost first.
(defn nc-walk-in (e pol env)
  (let _ (nc-check-op e pol env)
    (nc-children e pol env)))

(defn nc-check-op (e _pol env)
  (match (Expr.inner e)
    (EApply n args
      (if (and (nc-div-p n) (and (nc-int-p e) (nc-partial-enforced)))
        (match args
          (Cons _ divisors (nc-check-divisors n divisors))
          (Nil unit))
        (nc-check-abuf-call e n args env)))
    (ECall f args (match (Expr.inner f) (EAtom a (match a (AIdent n (nc-check-abuf-call e n args env)) (_ unit))) (_ unit)))
    (EAtom a (match a (AIdent n (if (nc-abuf-plain-p n) (nc-fail-abuf-value e n) unit)) (_ unit)))
    (ELoadByte en b o (nc-check-byte e "load-u" en b o env))
    (ELoadByteSigned en b o (nc-check-byte e "load-i" en b o env))
    (EStoreByte en b o _ (nc-check-byte e "store-u" en b o env))
    (EStoreByteSigned en b o _ (nc-check-byte e "store-i" en b o env))
    (_ unit)))

; Every operand after the first divides; each must be a nonzero literal.
(defn nc-check-divisors (n ds)
  (match ds
    (Nil unit)
    (Cons d t
      (if (nc-nonzero-literal d)
        (nc-check-divisors n t)
        (nc-fail-partial d n)))))

; Spec 20.3a: a plain byte access needs a let-bound (bytebuf R N), a literal k and k + width <= N; `!`/query modes need no proof.
(defn nc-bytes-enforced () true)

(defn nc-check-byte (e what en b o env)
  (let code (endian-to-int en)
    (if (or (not (nc-bytes-enforced)) (> (bit-and code 6) 0)) unit
      (if (nc-byte-proven b o (endian-width en) env) unit
        (nc-fail-byte e what (endian-width en))))))

(defn nc-byte-proven (b o w env)
  (match (Expr.inner b)
    (EAtom a
      (match a
        (AIdent n
          (match (Expr.inner o)
            (EAtom k (match k (AInt off (and (>= off 0) (<= (+ off w) (nc-cap-of n env)))) (_ false)))
            (_ false)))
        (_ false)))
    (_ false)))

; --- AtomicBuf (atomic/atomic): a plain update or constructor must be proven in range ---

; The stdlib's atomic/atomic::sym; the first probe allocates nothing, so a miss is cheap.
(defn nc-abuf-key-p (n sym)
  (and (ffi-call "zyl_cstr_key_matches" n sym 1000)
    (and (ffi-call "zyl_cstr_key_matches" n (str-concat "atomic/atomic::" sym) 1000)
      (and (> (str-length n) 8) (str-eq (str-substring n 0 8) "zyl/std@")))))

(defn nc-abuf-update-p (n)
  (or (nc-abuf-key-p n "atomicbuf-add") (or (nc-abuf-key-p n "atomicbuf-max") (or (nc-abuf-key-p n "atomicbuf-min")
    (or (nc-abuf-key-p n "atomicbuf-and") (or (nc-abuf-key-p n "atomicbuf-or") (nc-abuf-key-p n "atomicbuf-xor")))))))

(defn nc-abuf-plain-p (n) (or (nc-abuf-key-p n "atomicbuf-new") (nc-abuf-update-p n)))

; A literal slot count a constructor proves, or -1.
(defn nc-abuf-count (n args)
  (if (or (nc-abuf-key-p n "atomicbuf-new") (nc-abuf-key-p n "atomicbuf-new!"))
    (match args
      (Cons a _ (match (Expr.inner a) (EAtom k (match k (AInt c (if (and (>= c 0) (<= c 16777216)) c -1)) (_ -1))) (_ -1)))
      (Nil -1))
    -1))

(defn nc-check-abuf-call (e n args env)
  (if (nc-abuf-key-p n "atomicbuf-new")
    (if (>= (nc-abuf-count n args) 0) unit (nc-fail-abuf e "atomicbuf-new" "the slot count may be negative or too large"))
    (if (nc-abuf-update-p n)
      (if (nc-abuf-proven args env) unit (nc-fail-abuf e (err-name n) "the slot may fall outside the buffer"))
      unit)))

; A let-bound (atomicbuf-new N) and a literal slot below N.
(defn nc-abuf-proven (args env)
  (match args
    (Cons b rest
      (match rest
        (Cons i _
          (match (Expr.inner b)
            (EAtom a
              (match a
                (AIdent bn
                  (match (Expr.inner i)
                    (EAtom k (match k (AInt slot (and (>= slot 0) (< slot (- -2 (nc-cap-of bn env))))) (_ false)))
                    (_ false)))
                (_ false)))
            (_ false)))
        (Nil false)))
    (Nil false)))

; The literal capacity bound to `n`, or -1.
(defn nc-cap-of (n env)
  (match env
    (Nil -1)
    (Cons p t (match p (Pair m c (if (str-eq m n) c (nc-cap-of n t)))))))

(defn nc-unbind (n env)
  (match env
    (Nil Nil)
    (Cons p t (match p (Pair m _ (if (str-eq m n) (nc-unbind n t) (Cons p (nc-unbind n t))))))))

; What `(let n v ...)` makes of env: n names a known capacity, or nothing any more.
; An AtomicBuf's slot count N is kept as -(N+2), so no byte access can use it.
(defn nc-let-env (n v env)
  (match (Expr.inner v)
    (EByteBuf _ cap (Cons (Pair n cap) (nc-unbind n env)))
    (EApply f args
      (let c (nc-abuf-count f args)
        (if (>= c 0) (Cons (Pair n (- -2 c)) (nc-unbind n env)) (nc-unbind n env))))
    (_ (nc-unbind n env))))

(defn nc-ident-p (e) (match (Expr.inner e) (EAtom a (match a (AIdent _ true) (_ false))) (_ false)))

(defn nc-unbind-all (ps env)
  (match ps
    (Nil env)
    (Cons p t (nc-unbind-all t (nc-unbind (P.name p) env)))))

; ===========================================================================
; DIAGNOSTICS
; ===========================================================================

(defn nc-fail-partial (d n)
  (nc-fail d "E_PARTIAL_OPERATION"
    (str-concat "`" (str-concat n "` has a divisor that may be zero"))
    (str-concat "write `(" (str-concat (if (str-eq n "/") "div!" "rem!")
      (str-concat " a b)` to stop the program on a zero divisor, `(" (str-concat (if (str-eq n "/") "div?" "rem?")
        " a b)` to get None, or divide by a nonzero literal"))))))

(defn nc-fail-byte (e what w)
  (let name (str-concat what (ffi-call "zyl_int_text" (* w 8) 1000))
    (nc-fail e "E_PARTIAL_OPERATION"
      (str-concat "`" (str-concat name "` may fall outside its buffer, and a plain byte access must be proven in range"))
      (str-concat "write `" (str-concat name (str-concat "!` to stop the program when it is outside (E_INDEX_OUT_OF_BOUNDS), `" (str-concat name
        "?` to get None, or use a literal offset into a buffer a `let` bound to `(bytebuf R N)`, where the compiler can see it fits")))))))

(defn nc-fail-abuf (e name why)
  (nc-fail e "E_PARTIAL_OPERATION"
    (str-concat "plain `" (str-concat name (str-concat "` must be proven in range, and here " why)))
    (str-concat "write `" (str-concat name (str-concat "!` to stop the program when it is outside (E_INDEX_OUT_OF_BOUNDS), `" (str-concat name
      "?` to get None, or use a literal slot into a buffer a `let` bound to `(atomicbuf-new N)` with a literal N"))))))

(defn nc-fail-abuf-value (e n)
  (let name (err-name n)
    (nc-fail e "E_PARTIAL_OPERATION"
      (str-concat "plain `" (str-concat name "` is used as a value, where the compiler cannot prove its slot in range"))
      (str-concat "pass `" (str-concat name (str-concat "!` or `" (str-concat name "?` instead")))))))

(defn nc-fail (site code msg help)
  (ffi-call "zyl_panic"
    (err-at code msg (ffi-call "zyl_span_file" site 1000) (ffi-call "zyl_span_off" site 1000) help)
    1000))

; ===========================================================================
; STRUCTURAL RECURSION
; ===========================================================================

(defn nc-list (xs pol env)
  (match xs
    (Nil unit)
    (Cons h t (let _ (nc-walk-in h pol env) (nc-list t pol env)))))

(defn nc-two (a b pol env) (let _ (nc-walk-in a pol env) (nc-walk-in b pol env)))

(defn nc-three (a b c pol env) (let _ (nc-two a b pol env) (nc-walk-in c pol env)))

(defn nc-opt (o pol env) (match o (Some x (nc-walk-in x pol env)) (None unit)))

; A form that binds names (a match arm, a lambda, for, catch) drops what env knows: it may shadow.
(defn nc-children (e pol env)
  (match (Expr.inner e)
    (ECall f args (let _ (if (nc-ident-p f) unit (nc-walk-in f pol env)) (nc-list args pol env)))
    (EApply _ args (nc-list args pol env))
    (ELet n v b (let _ (nc-walk-in v pol env) (nc-walk-in b pol (nc-let-env n v env))))
    (ELetMut n v b (let _ (nc-walk-in v pol env) (nc-walk-in b pol (nc-unbind n env))))
    (EIf c t f (nc-three c t f pol env))
    (EBegin xs (nc-list xs pol env))
    (EPrint xs (nc-list xs pol env))
    (EWhile c b (nc-two c b pol env))
    (ESpawn b (nc-walk-in b pol env))
    (ESend a b (nc-two a b pol env))
    (EFfiCall _ args _ (nc-list args pol env))
    (EFfiPin b (nc-walk-in b pol env))
    (EFfiUnpin b (nc-walk-in b pol env))
    (EAssert b m (let _ (nc-walk-in b pol env) (nc-opt m pol env)))
    (EUnwrap b (nc-walk-in b pol env))
    (EExit b (nc-walk-in b pol env))
    (EStructGet b _ (nc-walk-in b pol env))
    (EMakeStruct _ args (nc-list args pol env))
    (ETuple xs (nc-list xs pol env))
    (EMakeVariant _ _ args (nc-list args pol env))
    (ESetBang n v (nc-walk-in v pol (nc-unbind n env)))
    (EAssertEqual a b (nc-two a b pol env))
    (ELoadByte _ a b (nc-two a b pol env))
    (ELoadByteSigned _ a b (nc-two a b pol env))
    (EStoreByte _ a b c (nc-three a b c pol env))
    (EStoreByteSigned _ a b c (nc-three a b c pol env))
    (EFn _ ps b (nc-walk-in b pol (nc-unbind-all ps env)))
    (ELambda _ ps b (nc-walk-in b pol (nc-unbind-all ps env)))
    (_ (nc-list (expr-children e) pol Nil))))
