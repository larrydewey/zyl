; === Zyl Compiler — Call-Site Arity Check ===
; Module: compiler/arity_check
;
; This compiler has no general call-site arity validation anywhere in
; its pipeline: ICNF lowering and codegen both assume a call's argument
; count already matches the callee's parameter count, and just emit the
; call -- if it doesn't, every argument past the mismatch point binds to
; the wrong stack slot, silently, with no diagnostic (confirmed: this is
; exactly how a 9-argument call to an 8-parameter function corrupted an
; accumulator into a non-list value and segfaulted deep inside
; list-reverse, nowhere near the actual mistake -- and separately, this
; check's first real run over this compiler's OWN source caught a
; genuine pre-existing bug: icnf.zyl's icnf-size called icnf-add3, a
; 3-argument function, with 4 arguments for the IIf case, silently
; dropping the else-branch's size from a stack-frame-sizing heuristic).
; The handful of `E_ARITY_MISMATCH` checks elsewhere (expr_inner.zyl)
; are hand-written, one-off checks for specific byte-primitive special
; forms (byte/load-byte/bytebuf/...) -- not a general check for
; ordinary `defn` functions.
;
; Same undershoot-not-overshoot posture as mutability_check.zyl: this
; only flags a DIRECT call to a name that is unambiguously a known
; top-level function (`(foo a b c)`, resolved by name -- see the
; ECall/EApply comment below) called with the wrong literal argument
; count, AND not shadowed by any local binding in scope at the call
; site. `shadowed` is threaded through every recursive call the same
; way mutability_check.zyl threads `mutscope`, growing on ELet/
; ELetMut/lambda params/for-bindings/match-arm bindings; a call to a
; name currently in `shadowed` is skipped outright, since this pass has
; no way to know what that local binding's own arity is (it might not
; even be a function). Confirmed necessary by direct testing: without
; it, `(defn add (a b) ...) (let add (fn (x) (* x 2)) (add 5))` false-
; positived against the OUTER add's arity even though the call clearly
; resolves to the shadowing lambda.

(use core/list)
(use core/option)
(use compiler/ast)
(use compiler/type_system)
(use compiler/expr_inner)
(use compiler/error_report)
(use compiler/ffi_sigs)
(use compiler/rt_mode)

; Top-level function arities by name, stored plus one (0 = unknown). A
; later definition of a name replaces an earlier one, as the list this
; replaced did by being searched newest first.
(defn ac-collect (exprs)
  (let m (ffi-call "zyl_smap_new" 1000)
    (let _ (ac-collect-into exprs m)
      m)))

(defn ac-collect-into (exprs m)
  (match exprs
    (Nil unit)
    (Cons e rest
      (match (Expr.inner e)
        (EDefn name params _
          (let _ (ffi-call "zyl_smap_put" m name (+ (list-length params) 1) 1000)
            (ac-collect-into rest m)))
        (_ (ac-collect-into rest m))))))

(defn ac-lookup (arities name)
  (- (ffi-call "zyl_smap_get" arities name 1000) 1))

; `shadowed` is (List (Pair String Int)): a local binding's name paired
; with its arity if known -- -1 if the local is something whose arity
; can't be determined here (a plain `let`/`let-mut` value, a lambda/for/
; match-arm-bound parameter, ...), or the real parameter count if the
; local is a `let`-bound name whose value is DIRECTLY a `fn`/`lambda`
; literal at the binding site (see ac-let-arity-of below). A plain `let`
; is immutable (TCap -- see mutability_check.zyl's own header comment),
; so a `let`-bound fn/lambda value can never be reassigned later in its
; scope; `let-mut` is excluded from this and always recorded as -1,
; since a `set!` could rebind it to something of a different arity that
; this pass has no way to see. -2 (returned by ac-lookup-local when the
; name isn't in `shadowed` at all) means "not locally shadowed" --
; different from -1 ("shadowed, but arity unknown") so the two cases
; aren't confused: an unshadowed name still falls through to the
; top-level `arities` table; a shadowed-but-unknown-arity name is
; skipped outright, same as before this widening.
(defn ac-lookup-local (name shadowed)
  (match shadowed
    (Nil -2)
    (Cons pr rest
      (match pr
        (Pair n arity (if (str-eq n name) arity (ac-lookup-local name rest)))))))

(defn ac-wrap-unknown (names)
  (match names
    (Nil Nil)
    (Cons n rest (Cons (Pair n -1) (ac-wrap-unknown rest)))))

(defn ac-callee-name (op)
  (match (Expr.inner op)
    (EAtom atom
      (match atom
        (AIdent name name)
        (_ "")))
    (_ "")))

; `site` is the call's own Expr node, carried only so the diagnostic can
; name the line it is on.
(defn ac-check-call-by-name (name args arities shadowed site)
  (ac-check-arena-wrapper name site)
  (if (> (str-length name) 0)
    (let local (ac-lookup-local name shadowed)
      (if (= local -2)
        (let expected (ac-lookup arities name)
          (if (>= expected 0)
            (let got (list-length args)
              (if (= got expected) 0 (ac-fail name expected got site)))
            0))
        (if (= local -1)
          0
          (let got (list-length args)
            (if (= got local) 0 (ac-fail name local got site))))))
    0))

; A `let`-bound value that's DIRECTLY a `fn`/`lambda` literal has a
; statically known arity at the binding site; anything else (a call
; result, a conditional, another variable, ...) doesn't, and stays -1.
(defn ac-let-arity-of (val)
  (match (Expr.inner val)
    (EFn _ params _ (list-length params))
    (ELambda _ params _ (list-length params))
    (_ -1)))

(defn ac-fail (name expected got site)
  (let m1 (str-concat "`" (str-concat (err-name name) (str-concat "` takes " (ac-count expected))))
    (ac-panic-at (str-concat m1 (str-concat ", but this call gives it " (int-to-str got))) got expected site)))

; "1 argument", "2 arguments"
(defn ac-count (n)
  (str-concat (int-to-str n) (if (= n 1) " argument" " arguments")))

(defn ac-panic-at (msg got expected site)
  (let hint (if (> got expected)
              (str-concat "remove " (if (= (- got expected) 1) "the extra argument" (str-concat (int-to-str (- got expected)) " extra arguments")))
              (str-concat "add " (if (= (- expected got) 1) "the missing argument" (str-concat (int-to-str (- expected got)) " missing arguments"))))
    (let off (ffi-call "zyl_span_off" site 1000)
      (let fid (ffi-call "zyl_span_file" site 1000)
        (let text (err-at "E_ARITY_MISMATCH" msg fid off hint)
          (ffi-call "zyl_panic" text 1000))))))

;; `(ffi-call "sym" arg... timeout)`: the symbol must be a string literal
;; and the last argument a positive integer literal, the timeout in
;; milliseconds. The literal requirement is what makes a forgotten
;; timeout an error instead of silently dropping the real last argument.
;; ICNF lowering (ic-ffi) runs this too, for calls this pass never walks.
(defn ffi-max-args () 16)

(defn ffi-literal-str (e)
  (match (Expr.inner e)
    (EAtom a (match a (AStr s s) (_ "")))
    (_ "")))

(defn ffi-literal-int (e)
  (match (Expr.inner e)
    (EAtom a (match a (AInt n n) (_ -1)))
    (_ -1)))

(defn ffi-last-expr (xs)
  (match xs
    (Cons h t (if (is-nil t) h (ffi-last-expr t)))
    (Nil (Expr (EAtom (ANil))))))

(defn ffi-fail (code msg help site)
  (let off (ffi-call "zyl_span_off" site 1000)
    (let fid (ffi-call "zyl_span_file" site 1000)
      (ffi-call "zyl_panic" (err-at code msg fid off help) 1000))))

; Names the two places a timeout can be written: the call, or its extern.
(defn ffi-timeout-help (sym)
  (str-concat "add the timeout here: (ffi-call \"" (str-concat sym
    (str-concat "\" args 1000), or once on the extern: (extern \"" (str-concat sym "\" (...) R :timeout 1000)")))))

(defn ffi-check-call (args site)
  (match args
    (Nil (ffi-fail "E_FFI_SYMBOL_REQUIRED" "ffi-call has no symbol"
                   "write (ffi-call \"symbol\" arg ... timeout-ms)" site))
    (Cons sym tail
      (if (= (str-length (ffi-literal-str sym)) 0)
        (ffi-fail "E_FFI_SYMBOL_REQUIRED" "ffi-call needs its C symbol as a string literal"
                  "write the symbol name in double quotes" site)
        (if (is-nil tail)
          (ffi-fail "E_FFI_TIMEOUT_REQUIRED" (str-concat "the call to `" (str-concat (ffi-literal-str sym) "` has no timeout"))
                    (ffi-timeout-help (ffi-literal-str sym)) site)
          (if (< (ffi-literal-int (ffi-last-expr tail)) 1)
            (ffi-fail "E_FFI_TIMEOUT_REQUIRED" (str-concat "the call to `" (str-concat (ffi-literal-str sym) "` has no timeout: its last argument is not a positive integer literal"))
                      (ffi-timeout-help (ffi-literal-str sym)) site)
            (if (and (not (rt-mode-p)) (> (list-length tail) (+ (ffi-max-args) 1)))
              (ffi-fail "E_ARITY_MISMATCH" "ffi-call passes more than 16 arguments"
                        "pass a pointer to a struct or buffer instead" site)
              (ffi-check-arity (ffi-literal-str sym) tail site))))))))

; How many arguments a declared signature takes: the tokens before "->".
;
; `zyl_wvec_new` is declared "-> (WVec v)", so it takes ONE argument, which is
; the timeout. Calling it as (ffi-call "zyl_wvec_new" 0 1000) therefore passes
; two, and nothing noticed: the extra 0 became a silent second argument and
; the call returned a value derived from the wrong stack slot. The signature
; table already held the answer; no check read it.
(defn ffi-declared-arity (sig)
  (let arrow (ffi-arrow-at sig 0 (str-length sig))
    (if (< arrow 0) -1 (ffi-arg-count sig 0 arrow))))

(defn ffi-arrow-at ((sig String) (i Int) (n Int))
  (if (>= i n)
    -1
    (if (= (ffi-byte sig i) 45)
      (if (>= (+ i 1) n) -1 (if (= (ffi-byte sig (+ i 1)) 62) i -1))
      (ffi-arrow-at sig (+ i 1) n))))

(defn ffi-byte ((s String) (i Int)) (ffi-call "zyl_view_byte" s 0 1099511627776 i 1000))

(defn ffi-space-p (c) (or (= c 32) (= c 9)))

; How many arguments the domain of a declared signature lists.
;
; Spaces do not all separate arguments. The type language writes `(Attr k v)`
; and `(WVec v)` as ONE argument, so parenthesis depth decides: a space at
; depth 0 ends an argument and the next character starts a new one, while a
; space inside parentheses is part of a type. "Int Int" is two, "(Attr k v)" is
; one, "String" is one, "" is zero.
;
; Two earlier versions of this counted characters and then every space, and
; each rejected correct code in the tree before this check had compiled
; anything -- "(Attr k v) -> Unit" read first as eight arguments and then as
; three, so every correct zyl_attrh_clear in the compiler was an error.
;
; `prev` starts true so the first argument counts, and an opening parenthesis
; always begins one: it cannot be inside a type that is itself an argument.
; Count an argument only when the parenthesis opens one, not one nested in a
; type that is already the argument.
(defn ffi-bump (n depth) (if (= depth 0) (+ n 1) n))

(defn ffi-arg-count ((sig String) (i Int) (end Int))
  (ffi-arg-count-go sig i end 0 0 1))

(defn ffi-arg-count-go ((sig String) (i Int) (end Int) (n Int) (depth Int) (prev Int))
  (if (>= i end)
    n
    (let c (ffi-byte sig i)
      (if (= c 40)
        ; An opening parenthesis starts an argument only at depth 0. Inside a
        ; type it is part of that type: (WVec (Ref a)) is one argument, and
        ; counting the inner paren made it two.
        (ffi-arg-count-go sig (+ i 1) end (ffi-bump n depth) (+ depth 1) 0)
        (if (= c 41)
          (ffi-arg-count-go sig (+ i 1) end n (- depth 1) 1)
          (if (> depth 0)
            (ffi-arg-count-go sig (+ i 1) end n depth 0)
            (if (ffi-space-p c)
              (ffi-arg-count-go sig (+ i 1) end n 0 1)
              (if (> prev 0)
                (ffi-arg-count-go sig (+ i 1) end (+ n 1) 0 0)
                (ffi-arg-count-go sig (+ i 1) end n 0 0))))))))); Only for a symbol the table declares. An undeclared one -- a `%` intrinsic,
; or a runtime entry added without a signature -- is left alone rather than
; guessed at, because a wrong guess here would reject correct code.
(defn ffi-check-arity (sym args site)
  (let sig (ffi-sig-lookup sym ffi-sig-tab)
    (if (= (str-length sig) 0)
      0
      (let want (ffi-declared-arity sig)
        (if (< want 0)
          0
          ; One of `args` is the timeout, so the declared arity counts the
          ; call's own arguments and the timeout is not among them.
          (let got (- (list-length args) 1)
            (if (= got want)
              0
              (ffi-fail "E_ARITY_MISMATCH"
                (str-concat "`" (str-concat sym (str-concat "` is declared as `"
                  (str-concat sig (str-concat "` and takes "
                    (str-concat (ffi-call "zyl_int_text" want 1000)
                      (str-concat " argument(s) before the timeout, but this call passes "
                        (ffi-call "zyl_int_text" got 1000))))))))
                "match the call to the declared signature" site))))))))

; The raw-memory entries of allocator/allocator: the arena wrappers and the
; heap allocator. Both hand out a bare address that no type tracks.
;
; The arena wrappers additionally take a handle that is copyable, so a
; program that could name one could destroy memory another part of it still
; holds -- spec G2 forbids that. alloc-malloc has no handle at all: its
; result is an untyped Int, and nothing in the type system ties it to the
; free that must follow, so a program could hold an address with no
; lifetime and read it after the region that backed it was reclaimed.
; Restricting it costs a program nothing, because a program that wants a
; buffer already has `(bytebuf R N)`, which is region-tracked, and
; `bytebuf-ptr` for the address. Only the standard library and the
; compiler's own entry points (--internal-module) may call these; every
; caller left in the tree is one of those, so a user program cannot obtain
; untracked raw memory by either route.
(defn ac-arena-wrapper-p (key)
  (or (ac-key-is key "arena-create")
  (or (ac-key-is key "arena-destroy")
  (or (ac-key-is key "arena-reset")
  (or (ac-key-is key "arena-alloc")
  (or (ac-key-is key "arena-alloc-zeroed")
  (or (ac-key-is key "arena-used")
  (or (ac-key-is key "arena-capacity")
  (or (ac-key-is key "buf-new")
  (or (ac-key-is key "alloc-malloc")
      (ac-key-is key "alloc-free")))))))))))

; Whether a canonical key ends in `::name` (or is exactly it).
(defn ac-key-is (key name)
  (let n (str-len name) (let m (str-len key)
    (if (< m n) false
      (if (= (ffi-call "zyl_cstr_substr" key (- m n) n 1000) name)
        (or (= m n) (= (ffi-call "zyl_cstr_byte_at" key (- m n 1) 1000) 58))
        false)))))

(defn ac-arena-msg (name)
  (str-concat "`" (str-concat (err-name name) "` is a raw-memory entry: it is for the compiler, not for programs")))

; alloc-malloc's replacement is concrete enough to name, and a program that
; hits this diagnostic is almost certainly allocating a buffer for
; something; the arena wrappers get the general advice instead.
(defn ac-malloc-p (name)
  (or (ac-key-is name "alloc-malloc") (ac-key-is name "alloc-free")))

(defn ac-arena-help (name)
  (if (ac-malloc-p name)
    "allocate (bytebuf Heap N) instead and take its address with bytebuf-ptr: that buffer is region-tracked, and this one is a bare word no type follows"
    "use the typed standard-library collection it backs, which allocates in a region"))

(defn ac-check-arena-wrapper (name site)
  (if (ac-arena-wrapper-p name)
    (if (ac-may-raw)
      unit
      (ffi-fail "E_FFI_RESTRICTED" (ac-arena-msg name) (ac-arena-help name) site))))

; Run from the arity pass only, where ac-cur-fn names the definition.
(defn ffi-check-raw (args site)
  (match args
    (Nil unit)
    (Cons sym _
      (if (rt-mode-p) unit
      (if (or (rt-prim-p (ffi-literal-str sym)) (rt-only-p (ffi-literal-str sym)))
        (ffi-fail "E_FFI_RESTRICTED"
                  (str-concat "`" (str-concat (ffi-literal-str sym) "` is a runtime internal; only the runtime itself may use it"))
                  "use the typed standard-library function built on it" site)
      (if (and (ffi-raw-p (ffi-literal-str sym)) (not (ac-may-raw)))
        (ffi-fail "E_FFI_RESTRICTED"
                  (str-concat "`" (str-concat (ffi-literal-str sym) "` is a raw runtime entry (it reads memory or reinterprets a machine word) and only the standard library may call it"))
                  "use the typed standard-library function built on it" site)
        unit))))))

; Standard-library definitions carry the package key `zyl/std@N::`.
(defn ac-in-stdlib ()
  (let n (ffi-call "zyl_ref_get" ac-cur-fn 1000)
    (and (>= (str-length n) 8) (str-eq (str-substring n 0 8) "zyl/std@"))))

; Who may name a raw runtime entry: the standard library, and the compiler
; itself (--internal-module, set for driver.zyl, lsp_main.zyl and the
; REPL). The arena entries are raw because they hand out and reclaim raw
; addresses; the compiler keeps one for the parse tree, which outlives any
; frame, and a user program has no way to reach this.
(defn ac-may-raw ()
  (or (ac-in-stdlib) (internal-mode-p)))

(defn ac-check-program (exprs)
  ; The compiler compiles the standard library in this same process, and
  ; ac-cur-fn is a global: left holding the last stdlib definition it
  ; compiled, it says every later name is the standard library's, which
  ; is the one answer that grants raw-memory entries. Start from no
  ; owner, so nothing is the standard library's until a definition here
  ; says so.
  (let _ (ffi-call "zyl_ref_set" ac-cur-fn "" 1000)
    (let arities (ac-collect exprs)
      (ac-check-top exprs arities))))

; The top-level definition being checked, for E_FFI_RESTRICTED.
(def ac-cur-fn (ffi-call "zyl_ref_new" "" 1000))

(defn ac-check-top (exprs arities)
  (match exprs
    (Nil 0)
    (Cons e rest
      (begin
        (match (Expr.inner e)
          (EDefn name params body
            (let _ (ffi-call "zyl_ref_set" ac-cur-fn name 1000)
              (ac-expr body arities (ac-wrap-unknown (ac-param-names params)))))
          (ETestDecl _ body _ _ (let _ (ffi-call "zyl_ref_set" ac-cur-fn "" 1000) (ac-expr body arities Nil)))
          (EUnknown _ _ (ac-expr e arities Nil))
          (_ 0))
        (ac-check-top rest arities)))))

(defn ac-param-names (params)
  (match params
    (Nil Nil)
    (Cons p rest (Cons (P.name p) (ac-param-names rest)))))

; Same exhaustive-dispatch shape as mutability_check.zyl's mc-expr
; (proven structure for a whole-tree Expr walk in this pipeline); every
; arm just recurses (threading `shadowed` unchanged) except the
; scope-introducing forms and ECall/EApply, where the actual check
; happens.
(defn ac-expr (e arities shadowed)
  (match (Expr.inner e)
    (ESetBang _ val (ac-expr val arities shadowed))
    (ELet name val body
      (begin (ac-expr val arities shadowed) (ac-expr body arities (Cons (Pair name (ac-let-arity-of val)) shadowed))))
    (ELetMut name val body
      (begin (ac-expr val arities shadowed) (ac-expr body arities (Cons (Pair name -1) shadowed))))
    (EDef _ val (ac-expr val arities shadowed))
    (EIf c t eb (begin (ac-expr c arities shadowed) (ac-expr t arities shadowed) (ac-expr eb arities shadowed)))
    (EWhile c body (begin (ac-expr c arities shadowed) (ac-expr body arities shadowed)))
    (EFor bindings cond body
      (let names (ac-wrap-unknown (ac-for-names bindings))
        (begin
          (ac-for-inits bindings arities shadowed)
          (ac-expr cond arities (list-append names shadowed))
          (ac-expr body arities (list-append names shadowed)))))
    (ECond clauses (ac-cond-clauses clauses arities shadowed))
    (EBegin exprs (ac-list exprs arities shadowed))
    (ELambda _ params body (ac-expr body arities (list-append (ac-wrap-unknown (ac-param-names params)) shadowed)))
    (EFn _ params body (ac-expr body arities (list-append (ac-wrap-unknown (ac-param-names params)) shadowed)))
    (ETryCatch tbody _ handler (begin (ac-expr tbody arities shadowed) (ac-expr handler arities shadowed)))
    (EMatch subj arms (begin (ac-expr subj arities shadowed) (ac-arms arms arities shadowed)))
    ; Ordinary named calls, e.g. `(add 1 2 3)`, parse as EApply with the
    ; callee already a plain String (see expr_inner.zyl's
    ; convert-list-to-exprinner / dispatch-special fallthrough) -- NOT
    ; as ECall, which this compiler only ever produces for a computed
    ; call target (`((make-fn) 1 2)`, the head itself not a bare
    ; identifier). EApply is the case that matters for arity checking.
    (ECall op args
      (begin
        (ac-check-call-by-name (ac-callee-name op) args arities shadowed e)
        (ac-expr op arities shadowed)
        (ac-list args arities shadowed)))
    (EApply fname args
      (begin
        (if (ac-unquote-name fname)
          (ffi-fail "E_MALFORMED_FORM"
                    (str-concat "`" (str-concat (if (str-eq fname "unquote") "," ",@") "` outside a quasiquote or a macro template"))
                    "a macro template substitutes its parameters directly; `,@rest` splices a rest parameter" e)
          unit)
        (if (str-eq fname "ffi-call") (let _ (ffi-check-call args e) (ffi-check-raw args e)) unit)
        (ac-check-call-by-name fname args arities shadowed e)
        (ac-list args arities shadowed)))
    (EFfiCall _ args _ (ac-list args arities shadowed))
    (EFfiPin e2 (ac-expr e2 arities shadowed))
    (EFfiUnpin e2 (ac-expr e2 arities shadowed))
    (EAssert c _ (ac-expr c arities shadowed))
    (EUnwrap e2 (ac-expr e2 arities shadowed))
    (EStructGet se _ (ac-expr se arities shadowed))
    (EMakeStruct _ fields (ac-list fields arities shadowed))
    (ETuple elems (ac-list elems arities shadowed))
    (ETupleGet tg _ (ac-expr tg arities shadowed))
    (EMakeVariant _ _ args (ac-list args arities shadowed))
    (EPrint exprs (ac-list exprs arities shadowed))
    (EExit c (ac-expr c arities shadowed))
    (EClose e2 (ac-expr e2 arities shadowed))
    (EFileOpen a b (begin (ac-expr a arities shadowed) (ac-expr b arities shadowed)))
    (EFileRead a b (begin (ac-expr a arities shadowed) (ac-expr b arities shadowed)))
    (EFileWrite a b (begin (ac-expr a arities shadowed) (ac-expr b arities shadowed)))
    (EFileClose e2 (ac-expr e2 arities shadowed))
    (EBufAppend a b (begin (ac-expr a arities shadowed) (ac-expr b arities shadowed)))
    (ESpawn closure (ac-expr closure arities shadowed))
    (ESend actor msg (begin (ac-expr actor arities shadowed) (ac-expr msg arities shadowed)))
    (ESendClosure actor closure _ (begin (ac-expr actor arities shadowed) (ac-expr closure arities shadowed)))
    (ETestDecl _ body _ _ (ac-expr body arities shadowed))
    (EAssertEqual l r (begin (ac-expr l arities shadowed) (ac-expr r arities shadowed)))
    (EAssertTrue e2 _ (ac-expr e2 arities shadowed))
    (EAssertFalse e2 _ (ac-expr e2 arities shadowed))
    (ETestCompile _ _
      (ffi-fail "E_MALFORMED_FORM" "`test-compile` is a top-level form" "move it out to the top level of the file" e))
    ; A nested top-level-style `defn` is its own function scope (no
    ; closure capture for plain `defn`, only `fn`/`lambda` are
    ; closures -- see codegen.zyl), so it does NOT inherit the
    ; enclosing `shadowed` set, only its own params: same reset-to-Nil
    ; posture as mutability_check.zyl's mc-expr for this exact case.
    (EDefn _ params body (ac-expr body arities (ac-wrap-unknown (ac-param-names params))))
    ; A special form whose shape its parser rejected (expr_inner.zyl
    ; builds EUnknown for it). It used to lower to the constant 0.
    (EUnknown name _
      (ffi-fail "E_MALFORMED_FORM"
                (str-concat "malformed `" (str-concat name "` form: its arguments do not have the shape the form requires"))
                "see the form's syntax in the specification" e))
    (_ 0)))

(defn ac-unquote-name (n) (or (str-eq n "unquote") (str-eq n "unquote-splicing")))

(defn ac-list (xs arities shadowed)
  (match xs
    (Nil 0)
    (Cons h t (begin (ac-expr h arities shadowed) (ac-list t arities shadowed)))))

(defn ac-for-names (bindings)
  (match bindings
    (Nil Nil)
    (Cons pr rest
      (match pr
        (Pair name _ (Cons name (ac-for-names rest)))))))

(defn ac-for-inits (bindings arities shadowed)
  (match bindings
    (Nil 0)
    (Cons pr rest
      (match pr
        (Pair _ valOpt
          (begin
            (match valOpt (Some v (ac-expr v arities shadowed)) (None 0))
            (ac-for-inits rest arities shadowed)))))))

(defn ac-cond-clauses (clauses arities shadowed)
  (match clauses
    (Nil 0)
    (Cons pr rest
      (match pr
        (Pair c body (begin (ac-expr c arities shadowed) (ac-expr body arities shadowed) (ac-cond-clauses rest arities shadowed)))))))

; A match arm's pattern-fields are (List Expr) (see MatchArm's deftype):
; a plain bound name is `(EAtom (AIdent n))`; anything else (a nested
; constructor pattern, a literal) is left alone -- undershoot, not a
; false positive, same posture as everywhere else in this pass.
(defn ac-arms (arms arities shadowed)
  (match arms
    (Nil 0)
    (Cons a rest
      (match a
        (MA _ patterns body
          (begin
            (ac-expr body arities (list-append (ac-wrap-unknown (ac-pattern-names patterns)) shadowed))
            (ac-arms rest arities shadowed)))))))

(defn ac-pattern-names (fields)
  (match fields
    (Nil Nil)
    (Cons f rest
      (match (Expr.inner f)
        (EAtom atom
          (match atom
            (AIdent n (Cons n (ac-pattern-names rest)))
            (_ (ac-pattern-names rest))))
        (_ (ac-pattern-names rest))))))
