; === Zyl Compiler — Binary Safety Verifier ===
; Module: compiler/verify
;
; A phase of compilation, not a check that runs afterwards. It runs on the
; emitted assembly between code generation and linking, and a violation
; aborts the build: no binary is produced. A post-hoc verifier is something a
; build can skip -- a flag, a CI step, a wrapper -- and a verifier that can
; be skipped is a comment.
;
; WHY. Every other safety check in this compiler is the compiler checking
; itself, and a compiler bug is the case none of them cover. The regression
; tests, the memcheck and poison gates and the exhaustive allocator model all
; examine output produced by code nobody has verified. Moving the obligation
; onto the artifact is the way out: the compiler may be arbitrarily wrong and
; a wrong binary is rejected rather than run.
;
; WHY IT IS AFFORDABLE. An earlier version of this pass materialised each
; line, trimmed it twice and searched a 21-entry mnemonic table, and recursed
; once per line. The compiler's own assembly is 778,094 lines, so a build went
; from 0.06 s to effectively hung -- and recursing per line was a stack
; hazard besides. This version scans the character buffer in place: no line
; is materialised, nothing is recursive, and the only string built is the one
; a violation needs. Measured on stage2.s and rt.s it is a small fraction of
; the compile it guards.
;
; THE INVARIANT, AND WHY CODE GENERATION STATES IT RATHER THAN IT BEING
; INFERRED. Every write through a frame slot [rbp-N] must lie inside the
; frame that function reserved. Deriving that bound from the prologue does
; not work, and this was measured rather than assumed. On the compiler's own
; 778,094 lines, every formulation recovered from the text produced thousands
; of false positives:
;
;   bound from the single `sub rsp, N`          12,515 false positives
;   + the 128-byte red zone, running maximum     11,304
;   + local labels are not functions              9,503
;   + the red zone only where no call is made     5,088
;
; The residue is four things the assembly does not state: frames grow by more
; than one `sub rsp`; leaf functions use the red zone with no `sub rsp` at
; all; push-only frames reserve nothing; and a read of the return address is
; indistinguishable from a write to it. Code generation already knows the
; answer -- it computes `fsz` from actual slot usage before emitting the
; prologue -- so it writes `# frame N` under each function label and this
; pass checks the emitted text against that. A mismatch between the frame
; intended and an operand actually emitted is exactly the bug this is for.
;
; The annotation is `#` rather than `;` because the runtime seed is assembled
; by cc (boot.sh's use_rt runs `cc -c`), and GNU as reads `;` as a statement
; separator: `; frame 168` there assembles as an instruction called `frame`.
;
; CHECKS
;
;   V1  frame-slot bounds.  A write to [rbp-N] requires N <= frame + 8 (the
;       pushed return address) and N to be 8-aligned. This is a complete
;       proof of safety for that operand class: a write outside the frame
;       lands in a caller's frame, and a misaligned slot is a torn word.
;       Both are silent when the memory happens to be benign. Validated
;       against the compiler's own output: 24,661 writes and 86,114 reads in
;       stage2.s over 5,150 functions, zero violations, zero frameless.
;   V2  dynamic-operand census.  Every operand that is neither a frame slot
;       nor thread-local is recorded. A regression guard rather than a proof:
;       it fails when code generation starts emitting an access shape nobody
;       has looked at, which is the moment a new bug can appear.
;
; NOT implemented, and therefore not claimed. Both are reported as absent in
; the evidence, never as passed.
;
;   V3  provenance and bounds.  That every dynamic access is dominated by
;       code establishing the base register's region and remaining bound.
;   V4  region liveness.  That the base region has not been exited or
;       recycled. This is spec G2 on live code.
;
; EVIDENCE. verify-report returns one line per check, folded into the build's
; provenance record. A signature over "this is what I built" is attestation;
; a signature over "this byte sequence discharged these obligations at these
; bounds" is evidence.

(use compiler/ast)

(def vy-bad-store (ffi-call "zyl_ref_new" Nil 1000))
(def vy-dyn-count (ffi-call "zyl_ref_new" 0 1000))
(def vy-evidence-store (ffi-call "zyl_ref_new" Nil 1000))
(def vy-frame-unknown (ffi-call "zyl_ref_new" 0 1000))
(def vy-frames-seen (ffi-call "zyl_ref_new" 0 1000))
(def vy-writes (ffi-call "zyl_ref_new" 0 1000))
(def vy-reads (ffi-call "zyl_ref_new" 0 1000))

(defn vy-bad-count () (vy-list-len (ffi-call "zyl_ref_get" vy-bad-store 1000)))

(defn vy-list-len (xs)
  (match xs
    (Nil 0)
    (Cons h t (+ 1 (vy-list-len t)))))

(defn vy-reset ()
  (begin
    (ffi-call "zyl_ref_set" vy-bad-store Nil 1000)
    (ffi-call "zyl_ref_set" vy-dyn-count 0 1000)
    (ffi-call "zyl_ref_set" vy-evidence-store Nil 1000)
    (ffi-call "zyl_ref_set" vy-frame-unknown 0 1000)
    (ffi-call "zyl_ref_set" vy-frames-seen 0 1000)
    (ffi-call "zyl_ref_set" vy-writes 0 1000)
    (ffi-call "zyl_ref_set" vy-reads 0 1000)))

; --- in-place character access -------------------------------------------
;
; The scan never materialises a line. Every test is a byte comparison at an
; index, and the only string it builds is a diagnostic.

(defn vy-byte (s i) (ffi-call "zyl_view_byte" s 0 1099511627776 i 1000))
(defn vy-len (s) (str-length s))

(defn vy-ws? (c) (or (= c 32) (= c 9)))

; Does the text at i equal lit? Byte by byte, so no substring is built.
(defn vy-lit (s i end lit) (vy-lit-go s i end lit 0))

(defn vy-lit-go (s i end lit j)
  (if (>= j (str-length lit))
    true
    (if (>= (+ i j) end)
      false
      (if (= (vy-byte s (+ i j)) (vy-byte lit j))
        (vy-lit-go s i end lit (+ j 1))
        false))))

; The first index of ch in [i,end), or -1.
;
; zyl_view_find is a native memchr and this is the whole performance story of
; the pass. The first version walked the buffer one character at a time in
; Zyl, which is 15 million dynamic FFI calls over stage2.s and turned a
; forty-second bootstrap into minutes. The line loop now also steps to
; whichever comes first, a newline or a `[`, so Zyl-level work happens only
; on lines that actually carry an operand.
(defn vy-find (s i end ch)
  (let p (ffi-call "zyl_view_find" s 0 1099511627776 i ch 1000)
    (if (< p end) p -1)))

; The integer starting at i, or 0.
(defn vy-num (s i end)
  (if (>= i end)
    0
    (let c (vy-byte s i)
      (if (and (>= c 48) (<= c 57)) (+ (* 10 (vy-num s (+ i 1) end)) (- c 48)) 0))))

; The first non-space at or after i.
(defn vy-skip (s i end)
  (if (>= i end) i (if (vy-ws? (vy-byte s i)) (vy-skip s (+ i 1) end) i)))

; The first word of [i,end), materialised. Used only for the function name in
; a diagnostic, never on the hot path.
(defn vy-word-at (s i end)
  (let sp (vy-find s i end 32)
    (if (< sp 0) (str-substring s i (- end i)) (str-substring s i (- sp i)))))

; Is the mnemonic a read-only or address-computing one? cmp/test/lea/push/pop
; never write through an operand, and get the wrong answer if treated as
; writes: `mov rdi, [rbp-8]` reads, because Intel syntax puts the destination
; first and the memory operand is the source. That mistake inflated a
; validated write count of 24,661 to 82,920 before it was caught.
(defn vy-nowrite (s i end)
  (or (vy-lit s i end "cmp") (or (vy-lit s i end "test")
    (or (vy-lit s i end "lea") (or (vy-lit s i end "push")
      (or (vy-lit s i end "pop") (vy-lit s i end "call")))))))

; --- the scan -------------------------------------------------------------

(defn verify-asm (asm)
  (begin
    (vy-reset)
    (vy-loop asm 0 1 (- 1))
    (vy-finish)))

; Iterative by design: one frame per line over 778,094 lines is a stack
; hazard, not just slow. The mutable state is the position, the line number
; and the frame bound.
; Step to the next newline, so the line number stays right and the frame
; annotation on the following line is seen.
(defn vy-loop (s pos line frame)
  (if (>= pos (vy-len s))
    unit
    (let nl (vy-find s pos (vy-len s) 10)
      (let end (if (< nl 0) (vy-len s) nl)
        ; The frame is read first so a `# frame N` line sets the bound
        ; before anything on this line is checked.
        (let frame2 (vy-frame-of s pos end frame)
          (begin
            (vy-line s pos end line frame2)
            (vy-loop s (+ end 1) (+ line 1) frame2)))))))

; `# frame N` states the bound for the function just labelled.
(defn vy-frame-of (s pos end frame)
  (let i (vy-skip s pos end)
    (if (vy-lit s i end "# frame")
      (vy-num s (+ i 7) end)
      frame)))

; A function label is at column 0, ends in ':', and is not a local jump
; target (".L0_0:" and friends sit inside a function and reset nothing).
; A directive line (".string", ".globl", data) is not code.
(defn vy-line (s pos end line frame)
  (let i (vy-skip s pos end)
    (if (>= i end)
      unit
      (if (= (vy-byte s i) 46)
        unit
        (vy-body s pos i end line frame)))))

(defn vy-body (s pos i end line frame)
  (if (vy-is-label s pos end i)
    (begin
      (ffi-call "zyl_ref_set" vy-frames-seen (+ (ffi-call "zyl_ref_get" vy-frames-seen 1000) 1) 1000)
      (vy-operands s i end line (- 1)))
    (vy-operands s i end line frame)))

(defn vy-is-label (s pos end i)
  (if (> i pos)
    false
    (if (< end i)
      false
      (if (= (vy-byte s i) 46)
        false
        (if (= (vy-byte s (- end 1)) 58) true false)))))

; Every memory operand on the line.
(defn vy-operands (s i end line frame)
  (let j (vy-find s i end 91)
    (if (< j 0)
      unit
      (vy-operand s j end line frame))))

(defn vy-operand (s j end line frame)
  (let k (vy-find s (+ j 1) end 93)
    (if (< k 0)
      (vy-bad s j end line "unterminated memory operand")
      (begin
        (vy-classify s j k)
        (if (vy-rbp-operand? s j)
          (vy-check-slot s j k end line frame)
          unit)
        (vy-operands s (+ k 1) end line frame)))))

(defn vy-rbp-operand? (s j) (vy-lit s (+ j 1) (+ j 5) "rbp-"))

; V2: an operand that is neither a frame slot nor thread-local is dynamic.
(defn vy-classify (s j k)
  (if (vy-rbp-operand? s j)
    unit
    (if (vy-lit s (+ j 1) (+ j 4) "fs:")
      unit
      (begin
        (ffi-call "zyl_ref_set" vy-dyn-count (+ (ffi-call "zyl_ref_get" vy-dyn-count 1000) 1) 1000)))))

; V1. A write is a memory operand in destination position -- before the comma
; -- and not a read-only mnemonic. Only writes are bounded: a read below rsp
; is still mapped memory, so it is a logic bug, not a safety one.
(defn vy-check-slot (s j k end line frame)
  (if (vy-is-write s j end)
    (vy-check-write s j k end line frame)
    (ffi-call "zyl_ref_set" vy-reads (+ (ffi-call "zyl_ref_get" vy-reads 1000) 1) 1000)))

(defn vy-is-write (s j end)
  (let comma (vy-find s 0 end 44)
    (if (< comma 0) false (if (< j comma) (not (vy-nowrite s 0 end)) false))))

(defn vy-check-write (s j k end line frame)
  (let off (vy-num s (+ j 5) k)
    (begin
      (ffi-call "zyl_ref_set" vy-writes (+ (ffi-call "zyl_ref_get" vy-writes 1000) 1) 1000)
      (vy-check-write-2 s j k end line frame off))))

(defn vy-check-write-2 (s j k end line frame off)
  (begin
    (if (< frame 0)
      (begin
        (ffi-call "zyl_ref_set" vy-frame-unknown (+ (ffi-call "zyl_ref_get" vy-frame-unknown 1000) 1) 1000)
        unit)
      (begin
        (if (> off (+ frame 8)) (vy-bad-slot s j k end line off frame) unit)
        (if (> (bit-and off 7) 0) (vy-bad-align s j end line off) unit)
        unit))))

; --- the gate -------------------------------------------------------------

(defn vy-finish ()
  (begin
    (vy-record)
    (if (> (vy-bad-count) 0) (vy-reject) unit)))

; Every violation is printed before the panic: a build that fails with a
; count and no locations is a worse bug report than one with both.
(defn vy-reject ()
  (begin
    (vy-print (ffi-call "zyl_ref_get" vy-bad-store 1000))
    (ffi-call "zyl_panic" (vy-fail-msg) 1000)
    unit))

; Paren-free, and no err-at: the offending code has no source line, which is
; precisely why it is being reported.
(defn vy-fail-msg ()
  (let n (ffi-call "zyl_int_text" (vy-bad-count) 1000)
    (str-concat "E_VERIFY_FAILED: the emitted code failed memory-safety verification: "
      (str-concat n " violation; no binary was produced. This is a compiler bug, not a bug in the program."))))

(defn vy-print (xs)
  (match xs
    (Nil unit)
    (Cons h t (begin (print h) (vy-print t)))))

; A violation is one formatted line, built only here.
(defn vy-bad (s j end line why)
  (vy-note (str-concat (str-concat "verify: line " (ffi-call "zyl_int_text" line 1000)) why)
    (str-substring s j (- (+ j 12) j))))

(defn vy-note (where what) (vy-emit (str-concat (str-concat "  " where) what)))

(defn vy-emit (line)
  (ffi-call "zyl_ref_set" vy-bad-store
    (Cons line (ffi-call "zyl_ref_get" vy-bad-store 1000)) 1000))

(defn vy-bad-slot (s j k end line off frame)
  (vy-note (str-concat (str-concat "verify: line " (ffi-call "zyl_int_text" line 1000))
               "  frame slot deeper than the frame this function reserved: ")
    (str-concat (str-concat "[rbp-" (ffi-call "zyl_int_text" off 1000))
      (str-concat "] with a frame of " (ffi-call "zyl_int_text" frame 1000)))))

(defn vy-bad-align (s j end line off)
  (vy-note (str-concat (str-concat "verify: line " (ffi-call "zyl_int_text" line 1000))
               "  frame slot is not 8-byte aligned: ")
    (str-concat "[rbp-" (ffi-call "zyl_int_text" off 1000))))

; --- evidence -------------------------------------------------------------
;
; One line per check. An unimplemented check says so; it is never reported as
; passed, because a record saying "V4 ok" for a check that does not exist is
; worse than no record.
(defn vy-record ()
  (begin
    (vy-evidence (str-concat "V1 frame-slot bounds: "
      (vy-status (ffi-call "zyl_ref_get" vy-writes 1000))))
    (vy-evidence (str-concat "V2 dynamic-operand census: "
      (vy-status (ffi-call "zyl_ref_get" vy-dyn-count 1000))))
    (vy-evidence "V3 provenance and bounds: not implemented")
    (vy-evidence "V4 region liveness: not implemented")))

; The evidence is a cons list of lines for the same reason the violations
; are: a wvec of String is not a shape this codebase uses anywhere, and it
; read back as heap addresses rather than text.
(defn vy-evidence (line)
  (ffi-call "zyl_ref_set" vy-evidence-store
    (Cons line (ffi-call "zyl_ref_get" vy-evidence-store 1000)) 1000))

(defn vy-status (covered)
  (if (= (vy-bad-count) 0)
    (str-concat "ok  covered " (str-concat (ffi-call "zyl_int_text" covered 1000) " sites"))
    "FAIL"))

; The evidence text for the provenance record, one line per check.
(defn verify-report () (vy-text (ffi-call "zyl_ref_get" vy-evidence-store 1000) ""))

(defn vy-text (xs acc)
  (match xs
    (Nil acc)
    (Cons h t (vy-text t (if (= acc "") h (str-concat acc (str-concat "\n" h)))))))

; True when every check that ran passed.
(defn verify-passed-p () (= (vy-bad-count) 0))

; Counts for the record: functions seen, writes checked, reads seen, and the
; number of writes whose function stated no frame. That last one is not a
; failure but it is the number a reader needs to judge V1's coverage.
(defn verify-functions () (ffi-call "zyl_ref_get" vy-frames-seen 1000))
(defn verify-writes () (ffi-call "zyl_ref_get" vy-writes 1000))
(defn verify-reads () (ffi-call "zyl_ref_get" vy-reads 1000))
(defn verify-unverified-writes () (ffi-call "zyl_ref_get" vy-frame-unknown 1000))
