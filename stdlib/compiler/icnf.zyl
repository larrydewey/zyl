; === Zyl Standard Library — Compiler ICNF lowering ===
; Module: compiler/icnf
;
; Lowers the reader's Ast (see compiler/ast) into an explicit instruction
; tree (ICNF). This is where the Rust compiler's PostProcessor
; responsibilities live in the self-hosted pipeline: special forms are
; recognised here by head-symbol name, per the no-dispatch architecture
; decision.
;
; Everything is a recursive algebraic data type — no pools, no indices.

(use allocator/allocator)
(use compiler/ast)

; --- Instruction tree -----------------------------------------------------

(deftype Icnf
  (IConst Int)
  (IStr String)
  (IFlt String)                        ; raw literal text
  (ILoad String)
  (IBinop Int Icnf Icnf)
  (ICall String (List Icnf))           ; user function (symbol-sanitized name)
  (IFfi String (List Icnf))            ; C symbol call (name used verbatim)
  (IPrint Icnf)
  (IIf Icnf Icnf Icnf)
  (IWhile Icnf Icnf)
  (ISet String Icnf)
  (ILet String Icnf Icnf)              ; name, value, body
  (ISeq (List Icnf))
  (IVariant String Int (List Icnf))    ; variant name, tag, field values
  (IMatch Icnf (List IArm)))

(deftype IArm (IArm String Int (List String) Icnf)) ; variant, tag, binds, body

(deftype IFunc (IFn String (List String) Icnf))     ; name, params, body

; Binop opcodes: 0 add 1 sub 2 mul 3 div 4 rem 5 lt 6 gt 7 le 8 ge 9 eq 10 ne

(defn ic-op-of (arena s)
  (if (str-eq s (str-intern arena "+")) 0
  (if (str-eq s (str-intern arena "-")) 1
  (if (str-eq s (str-intern arena "*")) 2
  (if (str-eq s (str-intern arena "/")) 3
  (if (str-eq s (str-intern arena "%")) 4
  (if (str-eq s (str-intern arena "<")) 5
  (if (str-eq s (str-intern arena ">")) 6
  (if (str-eq s (str-intern arena "<=")) 7
  (if (str-eq s (str-intern arena ">=")) 8
  (if (str-eq s (str-intern arena "==")) 9
  (if (str-eq s (str-intern arena "=")) 9
  (if (str-eq s (str-intern arena "!=")) 10
  -1)))))))))))))

; ===========================================================================
; PROGRAM-LEVEL LOWERING
; ===========================================================================

; Lower a whole program: collect deftype variant tables and defn bodies.
; Returns: List(IFunc)
(defn ic-program (arena prog)
  (let vt (ic-collect-vt arena prog None)
    (list-reverse (ic-defns arena prog None vt))))

; Walk top-level forms; deftype forms extend the variant table.
(defn ic-collect-vt (arena forms vt)
  (if (is-nil forms)
    vt
    (let form (hd forms)
      (let rest (list-cdr forms)
        (if (= (ast-code form) 5)
          (let kids (ast-kids form)
            (if (> (list-length kids) 0)
              (if (str-eq (ast-name (hd kids)) (str-intern arena "deftype"))
                (ic-collect-vt arena rest (ic-vt-deftype arena kids vt 0))
                (ic-collect-vt arena rest vt))
              (ic-collect-vt arena rest vt)))
          (ic-collect-vt arena rest vt))))))

; Add one deftype's variants (kids = (deftype Name Variant...)).
(defn ic-vt-deftype (arena kids vt tag)
  (let rem (list-drop kids 2)
    (if (is-nil rem)
      vt
      (let v (hd rem)
        (let vname
          (if (= (ast-code v) 5)
            (ast-name (hd (ast-kids v)))
            (ast-name v))
          (let arity (- (list-length (ast-kids v)) 1)
            (ic-vt-deftype arena (list-cdr rem)
                           (Cons (VTEntry (str-intern arena vname) tag arity vt) vt)
                           (+ tag 1))))))))

; Lower all top-level defn forms to IFn records (source order preserved).
(defn ic-defns (arena forms acc vt)
  (if (is-nil forms)
    acc
    (let form (hd forms)
      (let rest (list-cdr forms)
        (if (= (ast-code form) 5)
          (let kids (ast-kids form)
            (if (> (list-length kids) 1)
              (if (str-eq (ast-name (hd kids)) (str-intern arena "defn"))
                (ic-defns arena rest (Cons (ic-defn arena kids vt) acc) vt)
                (ic-defns arena rest acc vt))
              (ic-defns arena rest acc vt)))
          (ic-defns arena rest acc vt))))))

; kids = (defn name (params...) body)
(defn ic-defn (arena kids vt)
  (let name (ast-name (hd (list-cdr kids)))
    (let params-node (hd (list-drop kids 2))
      (let body (hd (list-drop kids 3))
        (IFn (str-intern arena name)
             (list-reverse (ic-param-names params-node None))
             (ic-expr arena body None vt))))))

; Collect parameter names from a parenthesised param node. Typed params
; (name Type) take the first element.
(defn ic-param-names (node acc)
  (if (not (= (ast-code node) 5))
    acc
    (ic-param-names-kids (ast-kids node) acc)))

; Walk one parameter per list element. Typed pairs ((name Type) ...) take
; the first child's name.
(defn ic-param-names-kids (kids acc)
  (if (is-nil kids)
    acc
    (let p (hd kids)
      (let pname
        (if (= (ast-code p) 5)
          (ast-name (hd (ast-kids p)))
          (ast-name p))
        (ic-param-names-kids (list-cdr kids) (Cons pname acc))))))

; Drop the first n elements of a list.
; Head of a list of Ast forms (empty AList when nil).
(defn hd (xs)
  (match xs
    (Cons a rest a)
    (None (AList None))))

(defn list-drop (xs n)
  (if (is-nil xs)
    xs
    (if (<= n 0)
      xs
      (list-drop (list-cdr xs) (- n 1)))))

; ===========================================================================
; EXPRESSION LOWERING
; ===========================================================================

; Lower one Ast expression to Icnf. `vt` resolves ADT constructions/match.
(defn ic-expr (arena ast env vt)
  (let k (ast-code ast)
    (if (= k 0)
      (ic-ident arena (ast-name ast) env vt)
      (if (= k 1)
        (IConst (ast-int ast))
        (if (= k 2)
          (IFlt (ast-text ast))
          (if (= k 3)
            (IStr (ast-text ast))
            (if (= k 4)
              (IConst (if (ast-bool ast) 1 0))
              (ic-form arena (ast-kids ast) env vt))))))))

; Identifier: nullary variant construction or variable reference.
(defn ic-ident (arena name env vt)
  (let tag (vt-tag-of vt (str-intern arena name))
    (if (> tag -1)
      (IVariant (str-intern arena name) tag None)
      (ILoad (str-intern arena name)))))

; A parenthesised form. kids is non-empty (empty -> Const 0).
(defn ic-form (arena kids env vt)
  (if (is-nil kids)
    (IConst 0)
    (let head (hd kids)
      (let args (list-cdr kids)
        (let hname (ast-name head)
          (let op (ic-op-of arena hname)
            (if (> op -1)
              (ic-binop arena op args env vt)
                                          (if (str-eq hname (str-intern arena "let"))
                              (ic-let arena args env vt false)
                              (if (str-eq hname (str-intern arena "let-mut"))
                                (ic-let arena args env vt true)
                            (if (str-eq hname (str-intern arena "if")) (IIf (ic-expr arena (hd args) env vt) (ic-expr arena (hd (list-cdr args)) env vt) (ic-expr arena (hd (list-drop args 2)) env vt)) (if (str-eq hname (str-intern arena "while")) (IWhile (ic-expr arena (hd args) env vt) (ic-expr arena (hd (list-cdr args)) env vt)) (if (str-eq hname (str-intern arena "set!")) (ISet (str-intern arena (ast-name (hd args))) (ic-expr arena (hd (list-cdr args)) env vt)) (if (str-eq hname (str-intern arena "begin")) (ISeq (ic-arg-list arena args env vt)) (if (str-eq hname (str-intern arena "file-close")) (IFfi "zyl_file_close_c" (ic-arg-list arena args env vt)) (if (str-eq hname (str-intern arena "file-write")) (IFfi "zyl_file_write_c" (ic-arg-list arena args env vt)) (if (str-eq hname (str-intern arena "file-read")) (IFfi "zyl_file_read_c" (ic-arg-list arena args env vt)) (if (str-eq hname (str-intern arena "file-open")) (IFfi "zyl_file_open_c" (ic-arg-list arena args env vt)) (if (str-eq hname (str-intern arena "print")) (ic-print arena args env vt) (ICall (str-intern arena hname) (ic-arg-list arena args env vt))))))))))))))))))))

; (let name val body...) — extra body expressions become an implicit ISeq.
(defn ic-let (arena args env vt mutable)
  (let name (ast-name (hd args))
    (let val (ic-expr arena (hd (list-cdr args)) env vt)
      (let rest (list-drop args 2)
        (let body
          (if (= (list-length rest) 1)
            (ic-expr arena (hd rest) env vt)
            (ISeq (ic-arg-list arena rest env vt))))
          (ILet (str-intern arena name) val body)))))

; Binary operator with exactly two arguments; unary minus (- x) supported.
(defn ic-binop (arena op args env vt)
  (if (= (list-length args) 2)
    (IBinop op
            (ic-expr arena (hd args) env vt)
            (ic-expr arena (hd (list-cdr args)) env vt))
    (if (= (list-length args) 1)
      (if (= op 1)
        (IBinop 1 (IConst 0) (ic-expr arena (hd args) env vt))
        (IConst 0))
      (IConst 0))))

; print: multi-argument prints become a sequence of single prints.
(defn ic-print (arena args env vt)
  (if (is-nil args)
    (IConst 0)
    (if (is-nil (list-cdr args))
      (IPrint (ic-expr arena (hd args) env vt))
      (ISeq (Cons (IPrint (ic-expr arena (hd args)) env vt)
                  (Cons (ic-print arena (list-cdr args) env vt) None))))))

; (ffi-call "sym" a b timeout): drop the trailing timeout literal.
(defn ic-ffi (arena args env vt)
  (let sym (ast-text (hd args))
    (let real-args (list-cdr args)
      (let call-args (if (<= (list-length real-args) 1)
                        None
                        (ic-arg-list arena (list-drop-last real-args) env vt)))
      (IFfi (str-intern arena sym) call-args))))

(defn list-drop-last (xs)
  (if (is-nil xs)
    None
    (if (is-nil (list-cdr xs))
      None
      (Cons (hd xs) (list-drop-last (tl xs))))))

; (match scrutinee arm...): arm = ((Variant binds...) body) or (Variant body).
(defn ic-match (arena args env vt)
  (let scrut (ic-expr arena (hd args) env vt)
    (let arms (list-cdr args)
      (IMatch scrut (ic-arms arena arms None env vt)))))

(defn ic-arms (arena arms acc env vt)
  (if (is-nil arms)
    acc
    (let arm (hd arms)
      (let parts (ast-kids arm)
        (let np (list-length parts)
          (if (< np 2)
            (ic-arms arena (list-cdr arms) acc env vt)
            (let vname (ast-name (hd parts))
              (let tag (vt-tag-of vt (str-intern arena vname))
                (let body (ic-expr arena (hd (list-drop parts (- np 1))) env vt)
                  (let binds (ic-arm-binds arena (list-drop (list-drop parts 1) 1) None)

                    (ic-arms arena (list-cdr arms)
                             (Cons (IArm (str-intern arena vname) tag binds body) acc))))))))))))

; Pattern binding names ("_" wildcards kept, skipped by codegen).
(defn ic-arm-binds (arena pats acc)
  (if (is-nil pats)
    (list-reverse acc)
    (ic-arm-binds arena (list-cdr pats) (Cons (str-intern arena (ast-name (hd pats))) acc))))

; Variant construction with fields: (V a b ...).
(defn ic-variant (arena vname args env vt)
  (let tag (vt-tag-of vt (str-intern arena vname))
    (IVariant (str-intern arena vname) tag (ic-arg-list arena args env vt))))

; Lower argument lists left-to-right.
(defn ic-arg-list (arena args env vt)
  (ic-arg-list-acc arena args env vt None))

(defn ic-arg-list-acc (arena args env vt acc)
  (if (is-nil args)
    (list-reverse acc)
    (ic-arg-list-acc arena (list-cdr args) env vt
                     (Cons (ic-expr arena (hd args) env vt) acc))))

; Tail of a list of Ast forms.
(defn tl (xs)
  (match xs
    (Cons a rest rest)
    (None None)))
