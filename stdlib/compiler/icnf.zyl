; === Zyl Standard Library — Self-Hosting Phase 3a: ICNF generation ===
; Module: compiler/icnf
; Converts the post-processed pool-AST into a flat instruction IR for a
; core subset: int literals, ident refs, + - * / % < > <= >= == = !=,
; let / let-mut, if, begin, defn, calls (<=6 args), print.
;
; ICNF opcodes (pool kind field):
;   51 IC_CONST   val=value
;   52 IC_LOAD    str=name
;   53 IC_ASSIGN  str=name, a=src-id
;   54 IC_BINOP   a=lhs, b=rhs, val=op
;   56 IC_CALL    str=name, kids=args
;   57 IC_IF      a=cond-id, kids=then-list, c=else-list
;   62 IC_PRINT   kids=[arg]
; BINOP ops (val): 0 add 1 sub 2 mul 3 div 4 rem 5 lt 6 gt 7 le 8 ge 9 eq 10 ne

(use allocator/allocator)
(use compiler/parser)
(use compiler/ast-helpers)

; Operator name -> BINOP opcode (-1 if not an operator).
(defn icnf-op-of (arena s)
  (if (str-eq s (str-intern arena "+")) 0
  (if (str-eq s (str-intern arena "-")) 1
  (if (str-eq s (str-intern arena "*")) 2
  (if (str-eq s (str-intern arena "/")) 3
  (if (str-eq s (str-intern arena "%")) 4
  (if (str-eq s (str-intern arena "<")) 5
  (if (str-eq s (str-intern arena ">")) 6
  (if (str-eq s (str-intern arena "<=")) 7
  (if (str-eq s (str-intern arena ">=")) 8
  (if (str-eq s (str-intern arena "==")) 9
  (if (str-eq s (str-intern arena "=")) 9
  (if (str-eq s (str-intern arena "!=")) 10
  -1)))))))))))))

(defn icnf-state-new (arena ast-pool code-pool vt)
  (let st (arena-alloc-zeroed arena 48)
    (begin
      (alloc-write-int st arena)
      (alloc-write-int (+ st 8) ast-pool)
      (alloc-write-int (+ st 16) 0)
      (alloc-write-int (+ st 24) 0)
      (alloc-write-int (+ st 32) code-pool)
      (alloc-write-int (+ st 40) vt)
      st)))

(defn icnf-add (st kind)
  (let cpool (alloc-read-int (+ st 32))
    (let blk (alloc-read-int (+ st 16))
      (let arena (alloc-read-int st)
        (let id (pool-append cpool)
          (begin
            (node-set-kind cpool id kind)
            (kids-push arena blk id)
            id))))))

(defn icnf-temp (st)
  (let arena (alloc-read-int st)
    (let n (alloc-read-int (+ st 24))
      (let num (ffi-call "zyl_cstr_from_int" arena n 1000)
        (let buf (arena-alloc-zeroed arena 64)
          (begin
            (alloc-write-int (+ st 24) (+ n 1))
            (buf-append buf (str-intern arena "___t"))
            (buf-append buf num)
            buf))))))

(defn icnf-assign-to (st name src)
  (let cpool (alloc-read-int (+ st 32))
    (let id (icnf-add st 53)
      (begin
        (node-set-str cpool id name)
        (node-set-a cpool id src)
        id))))

(defn icnf-expr (st node)
  (let apool (alloc-read-int (+ st 8))
    (let cpool (alloc-read-int (+ st 32))
      (let k (pool-kind apool node)
        (if (= k 2)
          (let id (icnf-add st 51)
            (begin
              (node-set-val cpool id (pool-val apool node))
              id))
          (if (= k 1)
            (if (> (variant-tag (alloc-read-int (+ st 40)) (pool-str apool node) 0) -1)
              (let id (icnf-add st 59)
                (begin
                  (node-set-str cpool id (pool-str apool node))
                  (node-set-val cpool id (variant-tag (alloc-read-int (+ st 40)) (pool-str apool node) 0))
                  id))
              (let id (icnf-add st 52)
                (begin
                  (node-set-str cpool id (pool-str apool node))
                  id)))
            (if (= k 11)
              (icnf-let st node)
              (if (= k 12)
                (icnf-let st node)
                (if (= k 13)
                  (icnf-if-compile st node)
                    (if (= k 14)
                      (icnf-begin-compile st node)
                      (if (= k 18)
                        (icnf-print-expr st node)
                        (if (= k 8)
                          (icnf-call-expr st node)
                          (if (= k 26)
                            (icnf-while st node)
                            (if (= k 25)
                              (icnf-setbang st node)
                              (if (= k 27)
                                (icnf-for st node)
                                (if (= k 29)
                                  (icnf-cond st node)
                                  (if (= k 19)
                                    (icnf-match st node
                                    0))))))))))))))))))

; While core: compile cond/body AST exprs into an ICNF kind-58 loop insn.
; Returns: Int (the while insn id)
(defn icnf-while-core (st cond-ast body-ast)
  (let cpool (alloc-read-int (+ st 32))
    (let arena (alloc-read-int st)
      (let saved (alloc-read-int (+ st 16))
        (let cond-blk (kids-new arena 8)
          (begin
            (alloc-write-int (+ st 16) cond-blk)
            (let cond-id (icnf-expr st cond-ast)
              (let body-blk (kids-new arena 8)
                (begin
                  (alloc-write-int (+ st 16) body-blk)
                  (let bv (icnf-expr st body-ast)
                    (begin
                      (alloc-write-int (+ st 16) saved)
                      (let w (icnf-add st 58)
                        (begin
                          (node-set-a cpool w cond-id)
                          (node-set-kids cpool w cond-blk)
                          (node-set-c cpool w body-blk)
                          w)))))))))))))

; While loop: AST kind 26 (a=cond, b=body) -> ICNF kind 58.
; Cond and body compile into their own blocks; the loop's value is 0.
(defn icnf-while (st node)
  (let apool (alloc-read-int (+ st 8))
    (icnf-while-core st (pool-a apool node) (pool-b apool node))))

; For loop: AST kind 27 (a=cond, b=body, kids=AST_FOR_BINDING nodes with
; str=name, a=init-or-0). Lowers to sequential init assigns + a while.
; Zyl for-loops have no implicit step; the body updates the variable.
; Returns: Int (the while insn id, or 0 on failure)
(defn icnf-for (st node)
  (let apool (alloc-read-int (+ st 8))
    (let bindings (pool-kids apool node)
      (icnf-for-binds st bindings 0 (kids-len bindings)
                      (pool-a apool node) (pool-b apool node)))))

(defn icnf-for-binds (st bindings i n cond-ast body-ast)
  (if (>= i n)
    (icnf-while-core st cond-ast body-ast)
    (let apool (alloc-read-int (+ st 8))
      (let b (kids-get bindings i)
        (let init (pool-a apool b)
          (if (= init 0)
            (icnf-for-binds st bindings (+ i 1) n cond-ast body-ast)
            (let v (icnf-expr st init)
              (if (= v 0)
                0
                (begin
                  (icnf-assign-to st (pool-str apool b) v)
                  (icnf-for-binds st bindings (+ i 1) n cond-ast body-ast))))))))))


; SetBang: AST kind 25 (str=name, a=value) -> ICNF Assign.
; Returns: Int (assign insn id, or 0 on failure)
(defn icnf-setbang (st node)
  (let apool (alloc-read-int (+ st 8))
    (let v (icnf-expr st (pool-a apool node))
      (if (= v 0)
        0
        (icnf-assign-to st (pool-str apool node) v)))))


(defn icnf-let (st node)
  (let apool (alloc-read-int (+ st 8))
    (let cpool (alloc-read-int (+ st 32))
      (let v (icnf-expr st (pool-a apool node))
        (if (= v 0)
          0
          (let asg (icnf-add st 53)
            (begin
              (node-set-str cpool asg (pool-str apool node))
              (node-set-a cpool asg v)
              (icnf-expr st (pool-b apool node)))))))))

(defn icnf-begin-compile (st node)
  (let apool (alloc-read-int (+ st 8))
    (let kids (pool-kids apool node)
      (icnf-stmts st kids 0 (kids-len kids)))))

(defn icnf-stmts (st kids i n)
  (if (= i (- n 1))
    (icnf-expr st (kids-get kids i))
    (begin
      (icnf-expr st (kids-get kids i))
      (icnf-stmts st kids (+ i 1) n))))

(defn icnf-print-expr (st node)
  (let apool (alloc-read-int (+ st 8))
    (let cpool (alloc-read-int (+ st 32))
      (let arena (alloc-read-int st)
        (let args-src (pool-kids apool node)
          (let n (kids-len args-src)
            (if (> n 6)
              0
              ; compile args first so they precede the print in the block
              (let dst (kids-new arena 8)
                (let ok (icnf-copy-args st arena apool args-src dst 0 n))
                  (if (= ok 0)
                    0
                    (let id (icnf-add st 62)
                      (begin
                        (node-set-str cpool id (str-intern arena "print"))
                        (node-set-kids cpool id dst)
                        id)))))))))))

(defn icnf-call-expr (st node)
  (let apool (alloc-read-int (+ st 8))
    (let head (pool-a apool node)
      (if (= (pool-kind apool head) 1)
        (let op (icnf-op-of (alloc-read-int st) (pool-str apool head))
          (if (> op -1)
            (icnf-binop st node op)
            (if (> (variant-tag (alloc-read-int (+ st 40)) (pool-str apool head) 0) -1)
              (icnf-make-variant st node)
              (icnf-generic-call st node))))
        0))))

(defn icnf-binop (st node op)
  (let apool (alloc-read-int (+ st 8))
    (let cpool (alloc-read-int (+ st 32))
      (let args (pool-kids apool node)
        (if (= (kids-len args) 2)
          (let lhs (icnf-expr st (kids-get args 0))
            (if (= lhs 0)
              0
              (let rhs (icnf-expr st (kids-get args 1))
                (if (= rhs 0)
                  0
                  (let id (icnf-add st 54)
                    (begin
                      (node-set-a cpool id lhs)
                      (node-set-b cpool id rhs)
                      (node-set-val cpool id op)
                      id))))))
          0)))))

(defn icnf-generic-call (st node)
  (let apool (alloc-read-int (+ st 8))
    (let cpool (alloc-read-int (+ st 32))
      (let arena (alloc-read-int st)
        (let name (pool-str apool (pool-a apool node))
          (let args-src (pool-kids apool node)
            (let n (kids-len args-src)
              (if (> n 6)
                0
                ; compile args first so they precede the call
                (let dst (kids-new arena 8)
                  (let ok (icnf-copy-args st arena apool args-src dst 0 n))
                    (if (= ok 0)
                      0
                      (let id (icnf-add st 56)
                        (begin
                          (node-set-str cpool id name)
                          (node-set-kids cpool id dst)
                          id))))))))))))

(defn icnf-copy-args (st arena apool src dst i n)
  (if (= i n)
    1
    (let a (icnf-expr st (kids-get src i))
      (if (= a 0)
        0
        (begin
          (kids-push arena dst a)
          (icnf-copy-args st arena apool src dst (+ i 1) n))))))

(defn icnf-if-compile (st node)
  (let apool (alloc-read-int (+ st 8))
    (icnf-if-gen st (pool-a apool node) (pool-b apool node) (pool-c apool node))))

; Generalized if: compile pred/then/else AST exprs into an If insn whose
; branches each end with an assignment of their value to a shared temp.
; Returns: Int (Load insn id of the temp, or 0 on failure)
(defn icnf-if-gen (st pred-ast then-ast else-ast)
  (let cpool (alloc-read-int (+ st 32))
    (let cond-id (icnf-expr st pred-ast)
      (if (= cond-id 0)
        0
        (let tmp (icnf-temp st)
          (let saved (alloc-read-int (+ st 16))
            (let arena (alloc-read-int st)
              (let then-blk (kids-new arena 8)
                (begin
                  (alloc-write-int (+ st 16) then-blk)
                  (let tv (icnf-expr st then-ast)
                    (begin
                      ; branch-local phi assign so cg-if leaves the value in rax
                      (if (= tv 0) 0 (icnf-assign-to st tmp tv))
                      (let else-blk (kids-new arena 8)
                        (begin
                          (alloc-write-int (+ st 16) else-blk)
                          (let ev (icnf-expr st else-ast)
                            (begin
                              (if (= ev 0) 0 (icnf-assign-to st tmp ev))
                              (alloc-write-int (+ st 16) saved)
                              (let iff (icnf-add st 57)
                                (begin
                                  (node-set-a cpool iff cond-id)
                                  (node-set-kids cpool iff then-blk)
                                  (node-set-c cpool iff else-blk)
                                  (let ld (icnf-add st 52)
                                    (begin
                                      (node-set-str cpool ld tmp)
                                      ld)))))))))))))))))))

; Cond: AST kind 29, kids = clause nodes (kind 30: a=pred, b=body).
; Lowers to nested Ifs; falling off the end yields Const 0.
; Returns: Int (value insn id, or 0 on failure)
(defn icnf-cond (st node)
  (let apool (alloc-read-int (+ st 8))
    (icnf-cond-from st (pool-kids apool node) 0 (kids-len (pool-kids apool node)))))

(defn icnf-cond-from (st clauses i n)
  (if (>= i n)
    (let id (icnf-add st 51)
      (begin
        (node-set-val (alloc-read-int (+ st 32)) id 0)
        id))
    (let cid (kids-get clauses i)
      (let cpool (alloc-read-int (+ st 32))
        (let cond-id (icnf-expr st (pool-a (alloc-read-int (+ st 8)) cid))
          (if (= cond-id 0)
            0
            (let tmp (icnf-temp st)
              (let saved (alloc-read-int (+ st 16))
                (let arena (alloc-read-int st)
                  (let then-blk (kids-new arena 8)
                    (begin
                      (alloc-write-int (+ st 16) then-blk)
                      (let tv (icnf-expr st (pool-b (alloc-read-int (+ st 8)) cid))
                        (begin
                          (if (= tv 0) 0 (icnf-assign-to st tmp tv))
                          (let else-blk (kids-new arena 8)
                            (begin
                              (alloc-write-int (+ st 16) else-blk)
                              (let ev (icnf-cond-from st clauses (+ i 1) n)
                                (begin
                                  (if (= ev 0) 0 (icnf-assign-to st tmp ev))
                                  (alloc-write-int (+ st 16) saved)
                                  (let iff (icnf-add st 57)
                                    (begin
                                      (node-set-a cpool iff cond-id)
                                      (node-set-kids cpool iff then-blk)
                                      (node-set-c cpool iff else-blk)
                                      (let ld (icnf-add st 52)
                                        (begin
                                          (node-set-str cpool ld tmp)
                                          ld)))))))))))))))))))))



; --- Variant table -------------------------------------------------------
; kids list of triples: name(str), tag(Int), arity(Int). Built from the
; top-level deftype nodes so construction and match can resolve variants.

(defn variant-table-build (arena ast-pool vt top i n)
  (if (< i n)
    (begin
      (if (= (pool-kind ast-pool (kids-get top i)) 32)
        (variant-table-deftype arena ast-pool vt (kids-get top i) 0)
        0)
      (variant-table-build arena ast-pool vt top (+ i 1) n))
    0))

(defn variant-table-deftype (arena ast-pool vt dt tag)
  (let vs (pool-kids ast-pool dt)
    (if (< tag (kids-len vs))
      (let v (kids-get vs tag)
        (begin
          (kids-push arena vt (pool-str ast-pool v))
          (kids-push arena vt tag)
          (let fk (pool-kids ast-pool v)
            (kids-push arena vt (if (= fk 0) 0 (kids-len fk))))
          (variant-table-deftype arena ast-pool vt dt (+ tag 1))))
      0)))

(defn variant-tag (vt name i)
  (let n (kids-len vt)
    (if (>= i n)
      -1
      (if (str-eq (kids-get vt i) name)
        (kids-get vt (+ i 1))
        (variant-tag vt name (+ i 3))))))

(defn variant-arity (vt name i)
  (let n (kids-len vt)
    (if (>= i n)
      -1
      (if (str-eq (kids-get vt i) name)
        (kids-get vt (+ i 2))
        (variant-arity vt name (+ i 3))))))



; Variant construction: (V a b ...) -> MakeVariant insn kind 59.
; str=variant name, val=tag, kids=compiled field insns.
(defn icnf-make-variant (st node)
  (let apool (alloc-read-int (+ st 8))
    (let cpool (alloc-read-int (+ st 32))
      (let arena (alloc-read-int st)
        (let name (pool-str apool (pool-a apool node))
          (let args-src (pool-kids apool node)
            (let n (kids-len args-src)
              (let dst (kids-new arena 8)
                (let ok (icnf-copy-args st arena apool args-src dst 0 n))
                  (if (= ok 0)
                    0
                    (let id (icnf-add st 59)
                      (begin
                        (node-set-str cpool id name)
                        (node-set-val cpool id (variant-tag (alloc-read-int (+ st 40)) name 0))
                        (node-set-kids cpool id dst)
                        id)))))))))))


; Match: AST kind 19 (a=scrutinee, kids=arms kind 24: str=variant,
; a=body, kids=pattern idents). Lowers to nested Ifs on the variant tag
; with field bindings; falling through all arms yields Const 0.
(defn icnf-match (st node)
  (let apool (alloc-read-int (+ st 8))
    (let cpool (alloc-read-int (+ st 32))
      (let scrut-id (icnf-expr st (pool-a apool node))
        (if (= scrut-id 0)
          0
          (let tmp (icnf-temp st)
            (let saved (alloc-read-int (+ st 16))
              (let arena (alloc-read-int st)
                (let else-blk (kids-new arena 8)
                  (begin
                    (alloc-write-int (+ st 16) else-blk)
                    (let ev (icnf-match-arms st (pool-kids apool node) 0 (kids-len (pool-kids apool node)) scrut-id tmp)
                      (begin
                        (if (= ev 0) 0 (icnf-assign-to st tmp ev))
                        (alloc-write-int (+ st 16) saved)
                        (let ld (icnf-add st 52)
                          (begin
                            (node-set-str cpool ld tmp)
                            ld))))))))))))))

(defn icnf-match-arms (st arms i n scrut-id tmp)
  (if (>= i n)
    (let id (icnf-add st 51)
      (begin
        (node-set-val (alloc-read-int (+ st 32)) id 0)
        id))
    (let apool (alloc-read-int (+ st 8))
      (let cpool (alloc-read-int (+ st 32))
        (let arm (kids-get arms i)
          (let tag (variant-tag (alloc-read-int (+ st 40)) (pool-str apool arm) 0)
            (if (< tag 0)
              (icnf-match-arms st arms (+ i 1) n scrut-id tmp)
              (let tg (icnf-add st 60)
                (begin
                  (node-set-a cpool tg scrut-id)
                  (let kc (icnf-add st 51)
                    (begin
                      (node-set-val cpool kc tag)
                      (let eq (icnf-add st 54)
                        (begin
                          (node-set-a cpool eq tg)
                          (node-set-b cpool eq kc)
                          (node-set-val cpool eq 9)
                          (let saved2 (alloc-read-int (+ st 16))
                            (let then-blk (kids-new (alloc-read-int st) 8)
                              (begin
                                (alloc-write-int (+ st 16) then-blk)
                                (let tv (icnf-match-bind-body st arm scrut-id tmp)
                                  (let else-blk (kids-new (alloc-read-int st) 8)
                                    (begin
                                      (alloc-write-int (+ st 16) else-blk)
                                      (let ev (icnf-match-arms st arms (+ i 1) n scrut-id tmp)
                                        (begin
                                          (if (= ev 0) 0 (icnf-assign-to st tmp ev))
                                          (alloc-write-int (+ st 16) saved2)
                                          (let iff (icnf-add st 57)
                                            (begin
                                              (node-set-a cpool iff eq)
                                              (node-set-kids cpool iff then-blk)
                                              (node-set-c cpool iff else-blk)
                                              (let ld (icnf-add st 52)
                                                (begin
                                                  (node-set-str cpool ld tmp)
                                                  ld)))))))))))))))))))))))))

(defn icnf-match-bind-body (st arm scrut-id tmp)
  (let apool (alloc-read-int (+ st 8))
    (let pats (pool-kids apool arm)
      (let m (if (= pats 0) 0 (kids-len pats))
        (let bound (icnf-match-binds st pats m scrut-id 0)
          (let body-ast (pool-a apool arm)
            (if (= body-ast 0)
              0
              (let tv (icnf-expr st body-ast)
                (if (= tv 0) 0 (icnf-assign-to st tmp tv))))))))))

(defn icnf-match-binds (st pats m scrut-id j)
  (if (< j m)
    (let apool (alloc-read-int (+ st 8))
      (let cpool (alloc-read-int (+ st 32))
        (let fg (icnf-add st 63)
          (begin
            (node-set-a cpool fg scrut-id)
            (node-set-val cpool fg j)
            (icnf-assign-to st (pool-str apool (kids-get pats j)) fg)
            (icnf-match-binds st pats m scrut-id (+ j 1))))))
    1))


(defn icnf-program (arena ast-pool prog-id)
  (let out (pool-create arena 1024)
    (let top (pool-kids ast-pool prog-id)
      (let vt (kids-new arena 16)
        (begin
          (variant-table-build arena ast-pool vt top 0 (kids-len top))
          (icnf-program-stmts arena ast-pool out vt top 0 (kids-len top)))))))

(defn icnf-program-stmts (arena ast-pool out vt kids i n)
  (if (>= i n)
    out
    (if (= (pool-kind ast-pool (kids-get kids i)) 10)
      (begin
        (icnf-defn arena ast-pool out vt (kids-get kids i))
        (icnf-program-stmts arena ast-pool out vt kids (+ i 1) n))
      (icnf-program-stmts arena ast-pool out vt kids (+ i 1) n))))

(defn icnf-defn (arena ast-pool code-pool vt defn-node)
  (let st (icnf-state-new arena ast-pool code-pool vt)
    (let blk (kids-new arena 64)
      (let fn-id (pool-append code-pool)
        (begin
          (node-set-str code-pool fn-id (defn-name ast-pool defn-node))
          (node-set-kids code-pool fn-id (pool-kids ast-pool defn-node))
          (alloc-write-int (+ st 16) blk)
          (let last (icnf-expr st (defn-body ast-pool defn-node))
            (begin
              (node-set-c code-pool fn-id blk)
              (node-set-val code-pool fn-id last)
              fn-id)))))))
