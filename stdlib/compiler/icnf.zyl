; === Zyl Standard Library — Compiler ICNF lowering ===
; Module: compiler/icnf
;
; Lowers ExprInner (see compiler/expr_inner) into an explicit instruction
; tree (ICNF). This is where the self-hosted pipeline used to lower raw
; Ast directly; special-form recognition (let/if/while/match/...) now
; happens once, upstream, in expr_inner.zyl's ExprInner bridge — this
; module just walks the already-typed Expr/ExprInner tree.
;
; Every traversal is a structural `match` on Expr/Icnf/List variants.
; There are no numeric node-kind tags, no projection accessors, and no
; positional index surgery anywhere in this module.

(use allocator/allocator)
(use compiler/ast)
(use compiler/expr_inner)
; Needed for str-drop (ic-make-struct) — previously missing here
; entirely. Harmless for the assemble.py bundle (use lines are stripped
; there regardless), but a standalone program that `use`s compiler/icnf
; directly as a library (e.g. integration/selfhost-codegen.zyl) needs
; every real dependency actually declared for the module resolver to
; pull it in - this was an undefined `f_str_drop` reference at link
; time otherwise.
(use compiler/monomorphization)
(use compiler/type_annotate)

; --- Instruction tree -------------------------------------------------------

(deftype Icnf
  (IConst Int)
  (IStr String)
  (IFlt String)                        ; raw literal text
  (ILoad String)
  (IBinop Int Icnf Icnf)
  (ICall String (List Icnf))           ; user function (symbol-sanitized name)
  (IFfi String (List Icnf))            ; C symbol call (name used verbatim)
  (IPrint Icnf)
  (IIf Icnf Icnf Icnf)
  (IWhile Icnf Icnf)
  (ISet String Icnf)
  (ILet String Icnf Icnf)              ; name, value, body
  (ISeq (List Icnf))
  (IVariant String Int (List Icnf))    ; variant name, tag, field values
  (IMatch Icnf (List IArm))
  ; Top-level function def: name, params, body, param kinds.
  ; The kind list is appended AFTER the body rather than beside the
  ; param names so that every existing three-binder `(IFn name params
  ; body ...)` pattern keeps binding the same three fields. Kinds are
  ; codegen's representation tags (0 int/pointer, 1 String, 2 Float);
  ; without them a String or Float parameter was indistinguishable from
  ; an Int at emission time, which printed strings as pointers, compared
  ; them by address and ran float arithmetic through the integer unit.
  ; Shorter than the param list (or empty, as for a lambda, whose
  ; parameters carry no annotation) means "0 for the rest".
  (IFn String (List String) Icnf (List Int))
  ; Call through a LOCAL holding a function value. No longer produced by
  ; lowering (every ICall on a local already goes through codegen's
  ; cg-call-indirect, which handles closures); codegen treats it
  ; exactly like ICall. See ic-lambda.
  (ICallClosure String (List Icnf))
  ; try-body, catch-var name, catch-body. See cg-trycatch: uses the
  ; runtime's existing zyl_try_push/zyl_try_pop/zyl_panic frame-stack
  ; machinery (added for the test harness, never wired to anything else
  ; until now) via an inline `call setjmp` in generated code.
  (ITryCatch Icnf String Icnf)
  ; Same shape and runtime layout as IVariant (variant name, tag, field
  ; values) but allocated directly in the current function's own stack
  ; frame instead of via zyl_heap_alloc -- region_inference.zyl rewrites
  ; an IVariant into this when its let-binding provably never escapes
  ; the function (see ri-transform-expr/ri-name-safe-in). See
  ; cg-stack-variant: no runtime call at all, just fixed rbp-relative
  ; stores, reserved up front by icnf-slot-count like any other local.
  (IStackVariant String Int (List Icnf)))

(deftype IArm (IArm String Int (List String) Icnf)) ; variant, tag, binds, body

; Binop opcodes (instruction payloads, not node kinds):
; 0 add 1 sub 2 mul 3 div 4 rem 5 lt 6 gt 7 le 8 ge 9 eq 10 ne
; 11 bit-and 12 bit-or 13 bit-xor 14 shl 15 shr (logical) 16 ashr
;
; The bitwise family (11-16) is what makes hash/cipher/bignum code
; expressible at all -- every one of them was previously an ordinary
; unknown-function call that failed to link. Semantics are DEFINED for
; every shift count, not left to x86's mod-64 masking: a count outside
; 0..63 shifts a logical shl/shr to 0 and saturates ashr to the sign
; bit (see cg-bit-mnem). Constant folding deliberately does NOT cover
; them (optimization.zyl) -- folding a bit-and inside the compiler
; would require the compiler's OWN source to use bit-and, which the
; previous-generation seed binary cannot compile.

(defn ic-op-of (arena s)
  (if (> (str-eq s (str-intern arena "+")) 0) 0
  (if (> (str-eq s (str-intern arena "-")) 0) 1
  (if (> (str-eq s (str-intern arena "*")) 0) 2
  (if (> (str-eq s (str-intern arena "/")) 0) 3
  (if (> (str-eq s (str-intern arena "%")) 0) 4
  (if (> (str-eq s (str-intern arena "<")) 0) 5
  (if (> (str-eq s (str-intern arena ">")) 0) 6
  (if (> (str-eq s (str-intern arena "<=")) 0) 7
  (if (> (str-eq s (str-intern arena ">=")) 0) 8
  (if (> (str-eq s (str-intern arena "==")) 0) 9
  (if (> (str-eq s (str-intern arena "=")) 0) 9
  (if (> (str-eq s (str-intern arena "!=")) 0) 10
  (if (> (str-eq s (str-intern arena "bit-and")) 0) 11
  (if (> (str-eq s (str-intern arena "bit-or")) 0) 12
  (if (> (str-eq s (str-intern arena "bit-xor")) 0) 13
  (if (> (str-eq s (str-intern arena "shl")) 0) 14
  (if (> (str-eq s (str-intern arena "shr")) 0) 15
  (if (> (str-eq s (str-intern arena "ashr")) 0) 16
  (if (> (str-eq s (str-intern arena "bit-not")) 0) 17
  -1))))))))))))))))))))

; Typed empty lists (bare `Nil` values unify ambiguously as Option vs
; List depending on module load order — always name the element type).
(defn no-strs () Nil)
(defn no-icnfs () Nil)
(defn no-ifuncs () Nil)
(defn no-iarms () Nil)

; ===========================================================================
; GENERIC STRUCTURAL LIST HELPERS (Expr-typed streams)
; ===========================================================================

(defn first-expr (xs)
  (match xs
    (Cons a _ a)
    (Nil (Expr (EAtom ANil)))))

(defn rest-expr (xs)
  (match xs
    (Cons _ r r)
    (Nil Nil)))

(defn last-expr (xs)
  (last-expr-loop xs (Expr (EAtom ANil))))

(defn last-expr-loop (xs acc)
  (match xs
    (Nil acc)
    (Cons h t (last-expr-loop t h))))

; All-but-last elements, in source order.
(defn butlast-expr (xs acc)
  (if (is-nil xs)
    (list-reverse acc)
    (butlast-expr-step (first-expr xs) (rest-expr xs) acc)))

(defn butlast-expr-step (h t acc)
  (if (is-nil t)
    (list-reverse acc)
    (butlast-expr t (Cons h acc))))

; Identifier payload of an Expr wrapping a bare EAtom(AIdent); fallback
; otherwise (e.g. the callee of an ECall that isn't a plain name).
(defn expr-ident-name (e fb)
  (match (Expr.inner e)
    (EAtom atom (match atom (AIdent n n) (_ fb)))
    (_ fb)))

; ===========================================================================
; PROGRAM-LEVEL LOWERING
; ===========================================================================

; Accumulator threaded through the top-level walk: functions collected so
; far (defns + synthesized `_test_*` bodies) and leftover top-level
; statements (test registrations, run-tests) that have no enclosing defn
; and must land in an implicit `main`.
(deftype TLAcc (TLAcc (List Icnf) (List Icnf)))

(defn tlacc-push-fn (f acc)
  (match acc (TLAcc fns stmts (TLAcc (Cons f fns) stmts))))

(defn tlacc-push-fns (newfns acc)
  (match newfns
    (Nil acc)
    (Cons f rest (tlacc-push-fns rest (tlacc-push-fn f acc)))))

(defn tlacc-push-stmt (s acc)
  (match acc (TLAcc fns stmts (TLAcc fns (Cons s stmts)))))

; Lower a whole program: collect deftype variant tables and defn bodies.
; `prog` is the post-monomorphization (List Expr). Returns: List(IFunc)
;
; Top-level (test ...) / (run-tests) forms have no enclosing defn, so a
; plain "collect EDefn only" walk (the original behavior) silently drops
; them — leaving no `main` and an `undefined reference to f_main` at link
; time for every test file. Each (test "name" body) synthesizes a
; "_test_<name>" function plus a `zyl_register_test` call left in the
; statement stream; (run-tests) becomes a `zyl_run_tests` call. Leftover
; statements become an implicit `main` (skipped if the source already
; defines one explicitly).
(defn ic-program (arena prog)
  (let vt (ic-collect-vt prog VTNil)
    (match (ic-toplevel arena prog vt (TLAcc (no-ifuncs) Nil))
      (TLAcc fns stmts (ic-finish-program (list-reverse fns) (list-reverse stmts))))))

(defn ic-toplevel (arena forms vt acc)
  (match forms
    (Nil acc)
    (Cons e rest
      (match (Expr.inner e)
        (EDefn name params body
          (ic-toplevel arena rest vt (tlacc-push-fns (ic-defn arena name params body vt) acc)))
        (ETestDecl name body _
          (ic-toplevel arena rest vt (ic-toplevel-test arena name body vt acc)))
        (ERunTests _
          (ic-toplevel arena rest vt (tlacc-push-stmt (IFfi "zyl_run_tests" Nil) acc)))
        (_ (ic-toplevel arena rest vt acc))))))

; One (test "name" body) form: synthesize a "_test_<name>" 0-arg function
; (always returns 0 — assertion failures panic via zyl_panic, matching the
; Rust bootstrap), and leave a zyl_register_test(name, fnptr) call for the
; implicit main. The function reference is a plain ILoad of the synthesized
; name — cg-load-nonslot already resolves any name present in the
; function table to a `lea rax, [rip+f_<name>]` (used elsewhere for
; higher-order function values), so no separate function-pointer node kind
; is needed.
(defn ic-toplevel-test (arena name body vt acc)
  (let tname (str-intern arena (str-concat "_test_" name))
    (let h (ic-hoist (ic-expr arena body vt))
      (let tbody (ISeq (Cons (hoist-node h) (Cons (IConst 0) Nil)))
        (let acc2 (tlacc-push-fns (Cons (IFn tname (no-strs) tbody (no-ints)) (hoist-fns h)) acc)
          (tlacc-push-stmt (IFfi "zyl_register_test" (Cons (IStr name) (Cons (ILoad tname) Nil))) acc2))))))

; If there are leftover top-level statements, wrap them in an implicit
; `main` (the entry stub always calls f_main) unless the source already
; defines one explicitly — that combination doesn't occur in this
; codebase, so it's left unsupported rather than guessed at.
(defn ic-finish-program (fns stmts)
  (if (> (ic-has-fn fns "zyl-init-globals") 0)
    (ic-init-in-main (ic-finish-main fns stmts))
    (ic-finish-main fns stmts)))

(defn ic-has-fn (fns nm)
  (match fns
    (Nil 0)
    (Cons f rest
      (match f
        (IFn name _ _ (if (> (str-eq name nm) 0) 1 (ic-has-fn rest nm)))
        (_ (ic-has-fn rest nm))))))

; Top-level defs are initialized, in source order, before main's body.
(defn ic-init-in-main (fns)
  (match fns
    (Nil Nil)
    (Cons f rest
      (match f
        (IFn name ps body ks
          (if (> (str-eq name "main") 0)
            (Cons (IFn name ps (ISeq (Cons (ICall "zyl-init-globals" Nil) (Cons body Nil))) ks) rest)
            (Cons f (ic-init-in-main rest))))
        (_ (Cons f (ic-init-in-main rest)))))))

(defn ic-finish-main (fns stmts)
  (match stmts
    (Nil fns)
    (Cons _ _
      (if (> (ic-has-main fns) 0)
        (ffi-call "zyl_panic" "E_TOPLEVEL_STMTS_WITH_EXPLICIT_MAIN: top-level test/run-tests forms alongside an explicit (defn main ...)" 1000)
        (Cons (IFn "main" (no-strs) (ISeq (list-append stmts (Cons (IConst 0) Nil))) (no-ints)) fns)))))

(defn ic-has-main (fns)
  (match fns
    (Nil 0)
    (Cons f rest
      (match f
        (IFn name _ _ (if (> (str-eq name "main") 0) 1 (ic-has-main rest)))
        (_ (ic-has-main rest))))))

; Walk top-level exprs; EDeftype forms extend the variant table.
;
; Structs (parse-defstruct's EDeftype, 4th field `Some "struct"`) get a
; tag from a dedicated, globally-increasing counter (starting well above
; any realistic regular-ADT variant count) instead of the usual per-
; deftype-starts-at-0 numbering. Two unrelated struct types sharing a
; field name at different positions (e.g. Color's "b" at index 2 vs
; Flag's/Quad's "b" at index 1) used to collide on tag 0 — every struct
; is its own single-variant deftype — and struct-get's dynamic dispatch
; (ic-struct-arms, which has no static type to resolve which struct a
; value actually is) picked whichever colliding arm came first in vt,
; silently reading through the wrong layout — invisible when the field
; happened to sit at the same position in both (Point/Vec3's "x"/"y"), a
; wrong VALUE once it didn't. A first attempt used a fresh arena address
; as the tag (globally unique with no counter to thread) — arena
; addresses routinely exceed 32 bits, and `cmp reg, <tag>`/`mov` need an
; imm32, so the assembler rejected every struct match arm. A second
; attempt renumbered ALL deftypes globally (regular ADTs included),
; which broke self-hosting outright. This counter only ever advances for
; structs — regular deftypes keep their existing per-deftype-from-0
; numbering, completely unaffected — and stays small enough for imm32.
(defn ic-collect-vt (forms vt)
  (match (ic-collect-vt-run forms vt 100000)
    (VTAcc v _ v)))

(deftype VTAcc (VTAcc VTable Int))

(defn ic-collect-vt-run (forms vt stag)
  (match forms
    (Nil (VTAcc vt stag))
    (Cons e rest (ic-collect-vt-inner rest (Expr.inner e) vt stag))))

; Split out of ic-collect-vt-run's Cons arm: a 3-level-deep nested match
; (forms -> Expr.inner -> structmark) miscompiled under the Rust bootstrap
; (a deeply nested match arm silently returned a bogus/unrelated sentinel
; value instead of recursing). Flattening into its own top-level function
; dodges that codegen bug.
(defn ic-collect-vt-inner (rest inner vt stag)
  (match inner
    (EDeftype name variants _ structmark
      (ic-collect-vt-deftype rest name variants structmark vt stag))
    ; Registered so ic-lambda-free (a lambda's capture analysis) can
    ; tell a genuine top-level function, reachable by name from the
    ; lifted body, from a name that must be captured.
    (EDefn name _ body
      (ic-collect-vt-run rest (VTFn name vt) stag))
    (_ (ic-collect-vt-run rest vt stag))))

(defn ic-collect-vt-deftype (rest name variants structmark vt stag)
  (match structmark
    (Some _
      (ic-collect-vt-run rest
                          (vt-from-adtvariants variants vt stag stag)
                          (+ stag (list-length variants))))
    (None (ic-collect-vt-run rest (ic-vt-deftype name variants vt stag) (+ stag 1)))))

; Add one deftype's variants. `variants` is already a (List ADTVariant) —
; ExprInner parsed field structure once, upstream.
(defn ic-vt-deftype (_name variants vt gid)
  (vt-from-adtvariants variants vt 0 gid))

; True within-one-deftype duplicate check: does `nm` appear again among
; this SAME deftype's own remaining variants? (Not the accumulated vt
; from earlier deftypes -- see vt-from-adtvariants below.)
(defn av-list-has-name (variants nm)
  (match variants
    (Nil 0)
    (Cons v rest
      (if (> (str-eq (AV.name v) nm) 0) 1 (av-list-has-name rest nm)))))

; Link one variant entry per variant; tail = next entry chain. Tags
; assigned in declaration order (first variant gets the lowest tag).
;
; A variant name repeated within THIS deftype's own variant list is
; always a genuine bug (two constructors that could never be told
; apart) and still errors. A name reused by a DIFFERENT, earlier-
; declared deftype no longer does: since each deftype's variants are
; prepended ahead of whatever vt already held (see the Cons arm below),
; and deftypes are processed in source order, a later declaration's
; entries always end up earlier in the list than -- and so shadow --
; anything an earlier declaration registered under the same name. That
; lets, e.g., a test file's own Option-like ADT reuse "Some"/"None"
; without colliding with the stdlib prelude's real Option, the same
; way later bindings already shadow earlier ones elsewhere in this
; language. It's also exactly the fallback the Rust bootstrap's own
; find_adt_for_variant uses absent a type hint ("returns the first ADT
; found by iteration order") -- this compiler has no scrutinee-type-
; aware hint mechanism to do better, so consistent shadowing is the
; right behavior until one exists, not a hard error blocking otherwise
; valid programs from compiling at all.
(defn vt-from-adtvariants (variants vt tag gid)
  (match variants
    (Nil vt)
    (Cons v rest
      (let tail (vt-from-adtvariants rest vt (+ tag 1) gid)
        (let nm (AV.name v)
          (if (> (av-list-has-name rest nm) 0)
            (ffi-call "zyl_panic" "E_DUPLICATE_VARIANT: variant name defined more than once in the same deftype" 1000)
            (VTEntry nm
                     tag
                     (AV.fields v)
                     gid
                     tail)))))))

; One top-level function: name, (List Param), body. Returns (List Icnf)
; of IFns — the function itself plus any lambda helpers hoisted out of
; its body (see ic-hoist) — rather than a single IFn, since a `(fn ...)`
; anywhere inside the body lowers to an embedded IFn node that must land
; in the top-level function list, not stay nested inside an expression.
(defn ic-defn (arena name params body vt)
  (let h (ic-hoist (ic-expr arena body vt))
    (Cons (IFn (str-intern arena name) (param-names params (no-strs)) (hoist-node h) (param-kinds params (no-ints))) (hoist-fns h))))

(defn param-names (params acc)
  (match params
    (Nil (list-reverse acc))
    (Cons p rest (param-names rest (Cons (P.name p) acc)))))

; Empty param-kind list.
(defn no-ints () Nil)

; A parameter's codegen representation kind, read straight off its
; declared type. Only String and Float have a representation that
; differs from a plain machine word; everything else (Int, Bool, an ADT,
; a generic parameter, an unannotated parameter) is 0.
(defn param-kind-of (p)
  (match (P.type p)
    (Some t (type-name-kind t))
    (None 0)))

; A declared type annotation is an Expr, not a String, despite Param's
; declaration -- `(P name (Some (convert-ast typ)))` in expr_inner.zyl.
; Only a bare identifier can name String or Float; an applied type such
; as `(Vec Float)` is a pointer, so kind 0 is right for it.
(defn type-name-kind (t)
  (match (Expr.inner t)
    (EAtom a
      (match a
        (AIdent n
          (if (> (str-eq n "String") 0)
            1
            (if (> (str-eq n "Float") 0) 2 0)))
        (_ 0)))
    (_ 0)))

(defn param-kinds (params acc)
  (match params
    (Nil (list-reverse acc))
    (Cons p rest (param-kinds rest (Cons (param-kind-of p) acc)))))

; ===========================================================================
; EXPRESSION LOWERING
; ===========================================================================

; Lower one ExprInner expression to Icnf. `vt` resolves ADT
; constructions/match. Forms this backend doesn't support (declared-but-
; unused ExprInner variants like EFor/ELambda/EDeftype-in-expression-
; position/EUnknown/...) lower to a harmless (IConst 0), matching this
; lowering's long-standing behavior for any malformed/unsupported shape.
; Lowering rebuilds the tree, so the Icnf node inherits the Expr's position
; -- that is what lets codegen's unbound-identifier error point at the
; identifier instead of at nothing. See qf-form for the same note.
(defn ic-expr (arena expr vt)
  (let out (ic-expr-node arena expr vt)
    (let _ (ffi-call "zyl_span_copy" out expr 1000)
      (ic-mark-kind out (ta-kind expr)))))

; Codegen kind from type annotation (attr table 1); 0 is left unrecorded.
(defn ic-mark-kind (out k)
  (if (> k 0)
    (let _ (ffi-call "zyl_attr_set" 1 out k 1000)
      out)
    out))

; A rebuilt node keeps its original's kind unless it already has one.
(defn ic-keep-kind (out from)
  (if (> (ffi-call "zyl_attr_get" 1 out 1000) 0)
    out
    (let _ (ffi-call "zyl_attr_copy" 1 out from 1000)
      out)))

; A pass that rebuilds a call node hands its position on with this, so
; codegen's undefined-function error (cg-call-user) stays located.
(defn ic-keep-span (out from)
  (let _ (ffi-call "zyl_span_copy" out from 1000)
    out))

(defn ic-expr-node (arena expr vt)
  (match (Expr.inner expr)
    (EAtom atom (ic-atom arena atom vt))
    (ECall op args (ic-call-renamed arena expr op args vt))
    (EApply fname args (ic-apply-renamed arena expr fname args vt))
    (ELet name val body (ic-lower-let arena name val body vt))
    (ELetMut name val body (ic-lower-let arena name val body vt))
    ; (with-resource (name init) body): regression/with-resource.zyl's
    ; own tests only exercise lexical-scoping and value semantics
    ; (bind, evaluate body, return body's value, proper shadowing) --
    ; identical to plain `let`, no separate cleanup/destructor behavior
    ; tested or implied anywhere. EWithResource had no case here at all
    ; (confirmed by grep before this fix), so every use fell through to
    ; the universal (IConst 0) fallback below, silently discarding both
    ; the binding and the body.
    (EWithResource name val body
      (ILet (str-intern arena name) (ic-expr arena val vt) (ic-expr arena body vt)))
    (EIf c t eb
      (IIf (ic-expr arena c vt) (ic-expr arena t vt) (ic-expr arena eb vt)))
    (EWhile c body
      (IWhile (ic-expr arena c vt) (ic-expr arena body vt)))
    (ESetBang name val
      (ISet (str-intern arena name) (ic-expr arena val vt)))
    (EBegin exprs (ISeq (ic-expr-list arena exprs vt)))
    ; zyl_file_open_c reads mode as a C string pointer ("r"/"a"/else ->
    ; write) — a non-string mode (e.g. regression/io.zyl's raw integer
    ; 577, a leftover POSIX-flags-style value) isn't a valid pointer at
    ; all and crashes dereferencing it. The Rust bootstrap sidesteps this
    ; entirely: its file-open codegen inspects the mode arg for a STRING
    ; literal at compile time and, for anything else (integer included),
    ; silently defaults to write mode without ever using the value — so
    ; passing 577 "worked" there only because it isn't a recognized read
    ; mode, not because 577 meant anything. Same fallback here: a
    ; non-string-literal mode becomes a hardcoded "w".
    (EFileOpen path mode
      (IFfi "zyl_file_open_c" (Cons (ic-expr arena path vt) (Cons (ic-file-mode arena mode vt) Nil))))
    (EFileRead h c
      (IFfi "zyl_file_read_c" (Cons (ic-expr arena h vt) (Cons (ic-expr arena c vt) Nil))))
    (EFileWrite h d
      (IFfi "zyl_file_write_c" (Cons (ic-expr arena h vt) (Cons (ic-expr arena d vt) Nil))))
    (EFileClose h
      (IFfi "zyl_file_close_c" (Cons (ic-expr arena h vt) Nil)))
    (EPrint exprs (ic-print arena exprs vt))
    (EMatch subj arms (ic-match arena subj arms vt))
    (EFfiCall sym args _ (IFfi sym (ic-expr-list arena args vt)))
    ; assert-equal/-true/-false: same `=`-opcode/panic shape as the Rust
    ; bootstrap's icnf.rs — a bare identifier match here (no dedicated
    ; Icnf node) means these previously fell through to the (IConst 0)
    ; wildcard below and silently no-op'd; every "passing" regression test
    ; that used them was actually asserting nothing.
    ; Float equality is approximate: an assert-equal literal like 0.166667
    ; is written to 6-decimal precision and essentially never matches a
    ; computed double bit-for-bit (e.g. (/ 1.0 2.0 3.0) is really
    ; 0.16666666666666666) — exact `=` (IBinop 9) failed every such
    ; assertion. Mirrors the Rust bootstrap's codegen.rs, which special-
    ; cases a float-operand Assert{Eq} into |a-b| <= 1e-5. icnf.zyl has
    ; no "kind" (env-derived, codegen-only) to check here, so it's a
    ; structural guess on the RAW expression tree instead (ic-looks-
    ; float: does `l` or `r` contain a float literal anywhere) — enough
    ; for the common case of comparing a computed expression to a float
    ; literal, though a bare variable holding a float with no literal in
    ; sight still falls through to exact `=` unrecognized.
    (EAssertEqual l r
     (if (> (ic-assert-is-float l r) 0)
       (ic-assert-float-eq arena l r vt)
       (IIf (IBinop 9 (ic-expr arena l vt) (ic-expr arena r vt))
            (IConst 0)
            (IFfi "zyl_panic" (Cons (IStr "assert-equal failed") Nil)))))
    (EAssertTrue e m
     (IIf (ic-expr arena e vt)
          (IConst 0)
          (IFfi "zyl_panic" (Cons (IStr (match m (Some t t) (None "assert-true failed"))) Nil))))
    (EAssertFalse e _
     (IIf (ic-expr arena e vt)
          (IFfi "zyl_panic" (Cons (IStr "assert-false failed") Nil))
          (IConst 0)))
    ; assert-fail: "assert that this would fail" — the Rust bootstrap
    ; just evaluates the expr and discards it too (a real check needs
    ; the same setjmp/longjmp panic-catching this backend doesn't have,
    ; per ETryCatch above). Not dispatched at parse time at all until
    ; now — testing/testing.zyl's assert-fail-expr called a plain
    ; "assert-fail" function that was never defined anywhere, an
    ; undefined-reference link error rather than a silent no-op.
    (EAssertFail e _ (ISeq (Cons (ic-expr arena e vt) (Cons (IConst 0) Nil))))
    ; assert: (assert e) lowers to if e then 0 else panic (item 22).
    (EAssert e m (IIf (ic-expr arena e vt) (IConst 0) (IFfi "zyl_panic" (Cons (IStr (ic-assert-msg m)) Nil))))
    ; unwrap: (unwrap e) lowers to match on Some tag 0 (item 23).
    (EUnwrap e (ic-unwrap arena e vt))
    (EStructGet se field (ic-struct-get arena se field vt))
    ; (for (name init)... cond body): no separate step clause — the
    ; corpus's own `for` bodies always `set!` the loop var themselves.
    ; Lowers to nested lets binding each (name, init) around a plain
    ; while(cond) body — ILet already backs both ELet and ELetMut
    ; identically (no real mutability distinction below source level),
    ; so the loop var is freely `set!`-able inside the while exactly like
    ; any let-mut local. Previously unhandled entirely (EFor wasn't in
    ; this match at all), silently lowering the whole loop to IConst 0 —
    ; every `for` in the corpus ran zero iterations.
    (EFor bindings cond body (ic-for arena bindings cond body vt))
    (EFfiPin e (IFfi "ffi_pin" (Cons (ic-expr arena e vt) Nil)))
    (EFfiUnpin e (IFfi "ffi_unpin" (Cons (ic-expr arena e vt) Nil)))
    ; (spawn (fn () body)): had NO icnf.zyl lowering at all (unlike
    ; EFfiPin/EFor before their own fixes, ESpawn wasn't even mentioned
    ; as a known gap) — silently fell to the universal (IConst 0)
    ; fallback, so `spawn` always returned 0 instead of a real actor id;
    ; every actor test that "passed" was operating on actor slot 0 by
    ; coincidence, not a genuinely spawned actor. zyl_actor_spawn wants a
    ; plain `void(*)(void*)` entry point plus a state pointer (used for
    ; captures) — every spawn body in this corpus is non-capturing, so
    ; state is always a hardcoded 0/null; (ic-expr body) for an EFn
    ; already goes through ic-lambda/ic-hoist exactly like a plain `fn`
    ; value would (see EFn below), no separate spawn-specific closure-
    ; conversion needed. A CAPTURING spawn body is not supported:
    ; ic-lambda lowers it to a closure value (function plus captured
    ; environment, via ic-lambda-closure), not a bare function pointer,
    ; and zyl_actor_spawn calls whatever it is handed as code -- such a
    ; program segfaults at run time.
    (ESpawn body (IFfi "zyl_actor_spawn" (Cons (ic-expr arena body vt) (Cons (IConst 0) Nil))))
    ; (send actor msg): same gap, no lowering at all. Mirrors the archived
    ; Rust bootstrap — msg is passed straight through as an opaque
    ; value, never boxed/heap-allocated, since none of this corpus's
    ; send calls need to survive being freed on an error path.
    (ESend actor msg (IFfi "zyl_actor_send" (Cons (ic-expr arena actor vt) (Cons (ic-expr arena msg vt) Nil))))
    ; (try body (catch e handler)): lowers to ITryCatch, which codegen's
    ; cg-trycatch turns into the runtime's setjmp/longjmp panic-frame
    ; mechanism (zyl_try_push/zyl_try_pop, used by zyl_panic to unwind to
    ; the nearest try instead of killing the process; first added for the
    ; test harness's own panic recovery). `error` (allocator.zyl) calls
    ; zyl_panic instead of the always-exits zyl_f_error, so it unwinds to
    ; the nearest try when one is active.
    (ETryCatch tbody cvar cbody
      (ITryCatch (ic-expr arena tbody vt) (str-intern arena cvar) (ic-expr arena cbody vt)))
    ; (fn (params...) body): lowers to an embedded IFn value — legal
    ; here only because ic-hoist (called by every top-level-function
    ; lowering site: ic-defn, ic-toplevel-test) walks the finished Icnf
    ; tree afterward, lifts every embedded IFn out to the real top-level
    ; function list, and replaces its occurrence with (ILoad name) — the
    ; same "load a known function's address" path cg-load-fnref already
    ; uses for passing a plain named function as a value, which is what
    ; makes calling through it via a local variable work at all (see
    ; cg-fire-user's indirect-call branch). A `fn` that references names
    ; bound in an ENCLOSING scope captures them: ic-lambda collects its
    ; free variables and ic-lambda-closure builds a closure value holding
    ; the lifted function plus an environment of those values.
    (EFn _ params body (ic-lambda arena params body vt))
    (ELambda _ params body (ic-lambda arena params body vt))
    (EByteLit n (IConst n))
    ; endian is a bare `Endian` ADT value (ELe/EBe), not an Expr -- same
    ; type-confusion hazard as EByteBuf's region above: goes through
    ; endian-to-int + IConst directly, never ic-expr.
    ;
    ; ARGUMENT ORDER: the Expr fields are (endian, buf, offset), matching
    ; the source form `(load-u8 :le buf off)`, while the runtime entry
    ; points are declared `(endian, offset, buf)`. These two arms used to
    ; bind the fields as `endian offset buf` -- reading the second field
    ; as the offset and the third as the buffer -- and then emit them in
    ; that same order, which handed the runtime the buffer handle as its
    ; offset and the offset as its handle. `zyl_bytes_view` then resolved
    ; a small integer as a handle, found no magic, and every load
    ; returned 0 while every store silently did nothing. Bind in field
    ; order, emit in runtime order.
    (ELoadByte endian buf offset (ic-byte-access arena "zyl_load_byte" "zyl_load_n" endian (Cons (ic-expr arena offset vt) (Cons (ic-expr arena buf vt) Nil))))
    (ELoadByteSigned endian buf offset (ic-byte-access arena "zyl_load_byte_signed" "zyl_load_n_signed" endian (Cons (ic-expr arena offset vt) (Cons (ic-expr arena buf vt) Nil))))
    (EStoreByte endian buf offset val (ic-byte-access arena "zyl_store_byte" "zyl_store_n" endian (Cons (ic-expr arena offset vt) (Cons (ic-expr arena buf vt) (Cons (ic-expr arena val vt) Nil)))))
    (EStoreByteSigned endian buf offset val (ic-byte-access arena "zyl_store_byte_signed" "zyl_store_n" endian (Cons (ic-expr arena offset vt) (Cons (ic-expr arena buf vt) (Cons (ic-expr arena val vt) Nil)))))
    (EByteSlice buf start len (IFfi "zyl_byte_slice" (Cons (ic-expr arena buf vt) (Cons (ic-expr arena start vt) (Cons (ic-expr arena len vt) Nil)))))
    (EByteSliceSub buf start len (IFfi "zyl_byte_slice_sub" (Cons (ic-expr arena buf vt) (Cons (ic-expr arena start vt) (Cons (ic-expr arena len vt) Nil)))))
    ; region is a bare `Region` ADT value (not an Expr -- see ExprInner's
    ; (EByteBuf Region Int)), and cap is a bare compile-time Int literal
    ; (parse-bytebuf only accepts an AstInt for it) -- both go through
    ; IConst directly, never ic-expr (which expects an Expr and would
    ; mis-lower either one, silently falling through to its own IConst-0
    ; catch-all on a shape it doesn't recognize).
    (EByteBuf region cap (IFfi "zyl_bytebuf_new" (Cons (IConst (region-to-int region)) (Cons (IConst cap) Nil))))
    (EByteBufAppend buf val (IFfi "zyl_bytebuf_append" (Cons (ic-expr arena buf vt) (Cons (ic-expr arena val vt) Nil))))
    (EByteBufLen buf (IFfi "zyl_bytebuf_len" (Cons (ic-expr arena buf vt) Nil)))
    (EByteBufCap buf (IFfi "zyl_bytebuf_cap" (Cons (ic-expr arena buf vt) Nil)))
    (EByteBufPtr buf (IFfi "zyl_bytebuf_ptr" (Cons (ic-expr arena buf vt) Nil)))
    ; align is likewise a bare Int literal (parse-align-check requires an
    ; AstInt), not an Expr.
    (EAlignCheck checked align (IFfi "zyl_align_check" (Cons (ic-expr arena checked vt) (Cons (IConst align) Nil))))
    (EAtomicLoad buf offset (IFfi "zyl_bytebuf_atomic_load" (Cons (ic-expr arena buf vt) (Cons (ic-expr arena offset vt) Nil))))
    (EAtomicStore buf offset val (IFfi "zyl_bytebuf_atomic_store" (Cons (ic-expr arena buf vt) (Cons (ic-expr arena offset vt) (Cons (ic-expr arena val vt) Nil)))))
    (EAtomicAdd buf offset val (IFfi "zyl_bytebuf_atomic_add" (Cons (ic-expr arena buf vt) (Cons (ic-expr arena offset vt) (Cons (ic-expr arena val vt) Nil)))))
    (EAtomicSub buf offset val (IFfi "zyl_bytebuf_atomic_sub" (Cons (ic-expr arena buf vt) (Cons (ic-expr arena offset vt) (Cons (ic-expr arena val vt) Nil)))))
    (EAtomicCAS buf offset expected newval (IFfi "zyl_bytebuf_atomic_cas" (Cons (ic-expr arena buf vt) (Cons (ic-expr arena offset vt) (Cons (ic-expr arena expected vt) (Cons (ic-expr arena newval vt) Nil))))))
    (EAtomicFetchAdd buf offset val (IFfi "zyl_bytebuf_atomic_fetch_add" (Cons (ic-expr arena buf vt) (Cons (ic-expr arena offset vt) (Cons (ic-expr arena val vt) Nil)))))
    (EAtomicMax buf offset val (IFfi "zyl_bytebuf_atomic_max" (Cons (ic-expr arena buf vt) (Cons (ic-expr arena offset vt) (Cons (ic-expr arena val vt) Nil)))))
    (EAtomicMin buf offset val (IFfi "zyl_bytebuf_atomic_min" (Cons (ic-expr arena buf vt) (Cons (ic-expr arena offset vt) (Cons (ic-expr arena val vt) Nil)))))
    (_ (IConst 0))))

; Fresh, guaranteed-unique numeric id for naming a lifted lambda: the
; arena's own bump-allocation pointer (any tiny allocation) is already a
; monotonically increasing Int distinct from every earlier call, with no
; separate counter to thread through ic-expr's signature.
(defn ic-fresh-id (arena)
  ; Must be deterministic and monotonically increasing across runs (it
  ; names the lifted match-arm and lambda helper functions), so that
  ; stageN and stage(N+1) emit byte-identical assembly -- the
  ; self-hosting fixed point.
  ;
  ; This was `arena-used` after a one-byte allocation: also
  ; deterministic, but it restarts whenever the arena does. The REPL
  ; compiles one program per entry and reclaims each entry's arena, so
  ; two entries would name two unrelated lambdas `_lambda_1234`, and a
  ; closure stored by the first would find the second. zyl_fresh_id is a
  ; process-lifetime counter: still a fixed sequence for a fresh process
  ; compiling a fixed source, and never repeating within a session.
  ; `arena` is no longer needed; the parameter stays so that every call
  ; site reads the same.
  (let _ arena
    (ffi-call "zyl_fresh_id" 0)))

(defn ic-digit-str (d)
  (if (= d 0) "0"
  (if (= d 1) "1"
  (if (= d 2) "2"
  (if (= d 3) "3"
  (if (= d 4) "4"
  (if (= d 5) "5"
  (if (= d 6) "6"
  (if (= d 7) "7"
  (if (= d 8) "8"
  "9"))))))))))

(defn ic-int-to-str (n)
  (if (< n 10)
    (ic-digit-str n)
    (str-concat (ic-int-to-str (/ n 10)) (ic-digit-str (% n 10)))))

; Structural guess, on the raw pre-lowering Expr tree, at whether an
; expression is float-valued: does it contain a float literal anywhere
; (as itself, or as an argument to some nested call/operator)? Used only
; to pick assert-equal's comparison strategy (see EAssertEqual above) —
; not a real type check, so a bare variable/parameter holding a float
; with no literal in the expression at all won't be recognized.
(defn ic-looks-float (e)
  (match (Expr.inner e)
    (EAtom atom (match atom (AFloat _ 1) (_ 0)))
    (EApply fname args (ic-looks-float-any args))
    (ECall op args (ic-looks-float-any args))
    (_ 0)))

; Inferred kinds decide; the literal guess applies only when neither side is a String.
(defn ic-assert-is-float (l r)
  (let kl (ta-kind l)
    (let kr (ta-kind r)
      (if (or (= kl 2) (= kr 2))
        1
        (if (or (= kl 1) (= kr 1))
          0
          (if (> (ic-looks-float l) 0) 1 (ic-looks-float r)))))))

(defn ic-looks-float-any (args)
  (match args
    (Nil 0)
    (Cons a rest (if (> (ic-looks-float a) 0) 1 (ic-looks-float-any rest)))))

; See EFileOpen above: a literal string mode lowers normally; anything
; else becomes a hardcoded "w".
(defn ic-file-mode (arena mode vt)
  (match (Expr.inner mode)
    (EAtom atom (match atom (AStr _ (ic-expr arena mode vt)) (_ (IStr "w"))))
    (_ (IStr "w"))))

; |a - b| <= 1e-5, matching the Rust bootstrap's epsilon exactly. Binds
; the difference to a slot rather than embedding the (ic-expr l)/(ic-expr
; r) subtrees directly in all three of ic-fabs's branches — codegen has
; no common-subexpression elimination, so a bare shared sub-tree would
; re-evaluate l and r (and any side effect in either) up to 3 times.
(defn ic-assert-float-eq (arena l r vt)
  (ILet "_af_d" (IBinop 1 (ic-expr arena l vt) (ic-expr arena r vt))
    (IIf (IBinop 7 (ic-fabs (ILoad "_af_d")) (IFlt "0.00001"))
         (IConst 0)
         (IFfi "zyl_panic" (Cons (IStr "assert-equal failed") Nil)))))

(defn ic-fabs (d)
  (IIf (IBinop 5 d (IFlt "0.0")) (IBinop 1 (IFlt "0.0") d) d))

; --- `fn`: hoisting and closure conversion ---------------------------------
;
; A `fn` lowers to a function lifted to the top level (ic-hoist does the
; lifting). Its body is lowered FIRST, and its free names are read off
; the lowered Icnf tree (ic-lambda-free): every ILoad / call head that
; is not one of the lambda's own params, not bound inside the body (let,
; match-arm binds, catch var), and not a top-level function. The Icnf
; tree has a dozen shapes, all walked, so every Expr form -- match, try,
; for, nested fn, whatever ic-expr lowers -- captures correctly without
; a second, Expr-level walker that has to be kept in step with ic-expr.
; (Two such walkers, ic-safe-expr and ic-free-vars, used to gate this:
; any shape they did not list, match among them, made the whole lambda
; silently lower to IConst 0, and a call head that was not a param or a
; top-level fn -- a captured closure, a constructor like `Some` -- did
; the same.)
;
; No free names: a plain IFn, whose value is its code address.
; Free names: a closure, a heap [tag, code, env] triple (IVariant, built
; by cg-variant) whose tag is ic-closure-magic, whose code field is the
; lifted IFn (lifted by ic-hoist's IVariant walk) and whose env field is
; a second IVariant holding the captured values, evaluated in the
; enclosing scope -- capture by value (spec 7). The lifted function takes
; the env as one extra trailing parameter ("_clos_env") and rebinds each
; captured name from it with a let.
;
; Every call through a function VALUE (a local, not a top-level defn)
; goes through codegen's cg-call-indirect, which tells the two apart at
; run time by the tag word and always passes one extra trailing
; argument: the env for a closure, 0 for a plain function (which ignores
; it -- in the SysV convention the caller owns every argument slot). So
; a closure may be passed as an argument, stored, returned or captured
; and still be called correctly, and the arity of the lambda does not
; matter (a 7th+ argument is an ordinary stack argument).
(defn ic-closure-magic () 2051230803)

(defn ic-lambda (arena params body vt)
  (let pnames (param-names params (no-strs))
    (let lname (str-intern arena (str-concat "_lambda_" (ic-int-to-str (ic-fresh-id arena))))
      (let kinds (param-kinds params (no-ints))
        (let lowered (ic-expr arena body vt)
          (let fvs (ic-lambda-free lowered pnames vt Nil)
            (if (is-nil fvs)
              (IFn lname pnames lowered kinds)
              (ic-lambda-closure arena lname pnames kinds lowered fvs))))))))

; The lifted closure body takes one extra trailing parameter, the
; captured environment, which is a plain pointer -- kind 0.
(defn ic-lambda-closure (arena lname pnames pkinds lowered fvs)
  (let envname (str-intern arena "_clos_env")
    (let wrapped (ic-wrap-env-binds envname fvs 0 lowered)
      (let allparams (list-append pnames (Cons envname Nil))
        (let allkinds (ic-pad-kinds pkinds (list-length pnames))
          (IVariant lname (ic-closure-magic)
            (Cons (IFn lname allparams wrapped (list-append allkinds (Cons 0 Nil)))
              (Cons (IVariant lname 0 (ic-build-env-fields fvs)) Nil))))))))

; A lambda's kind list may be shorter than its params ("0 for the
; rest"); pad it so the env's kind lands on the env parameter.
(defn ic-pad-kinds (kinds n)
  (if (<= n 0)
    Nil
    (match kinds
      (Nil (Cons 0 (ic-pad-kinds Nil (- n 1))))
      (Cons k rest (Cons k (ic-pad-kinds rest (- n 1)))))))

(defn ic-wrap-env-binds (envname fvs idx body)
  (match fvs
    (Nil body)
    (Cons fv rest
      (ILet fv (IFfi "zyl_variant_field" (Cons (ILoad envname) (Cons (IConst idx) Nil)))
        (ic-wrap-env-binds envname rest (+ idx 1) body)))))

(defn ic-build-env-fields (fvs)
  (match fvs
    (Nil Nil)
    (Cons fv rest (Cons (ILoad fv) (ic-build-env-fields rest)))))

; Free names of a lowered lambda body, in first-occurrence order (the
; env layout, so it must be deterministic). `bound` holds the params and
; every name bound on the way down. An embedded IFn is a nested lambda:
; its own captures were already evaluated as ILoads in THIS body (its
; env fields), so its body is not entered. `nil` is the placeholder
; name codegen resolves to 0 (cg-load-nonslot); a top-level function is
; reachable by name from the lifted body, so neither is a capture.
(defn ic-lambda-add (name bound vt acc)
  (if (> (ic-name-in-list name bound) 0)
    acc
    (if (> (ic-name-in-list name acc) 0)
      acc
      (if (> (vt-is-fn vt name) 0)
        acc
        (if (> (str-eq name "nil") 0)
          acc
          (list-append acc (Cons name Nil)))))))

(defn ic-lambda-free-list (xs bound vt acc)
  (match xs
    (Nil acc)
    (Cons h t (ic-lambda-free-list t bound vt (ic-lambda-free h bound vt acc)))))

(defn ic-lambda-free-arms (arms bound vt acc)
  (match arms
    (Nil acc)
    (Cons a rest
      (match a
        (IArm _ _ binds body
          (ic-lambda-free-arms rest bound vt
            (ic-lambda-free body (list-append binds bound) vt acc)))))))

(defn ic-lambda-free (e bound vt acc)
  (match e
    (IConst _ acc)
    (IStr _ acc)
    (IFlt _ acc)
    (ILoad n (ic-lambda-add n bound vt acc))
    (IBinop _ l r (ic-lambda-free r bound vt (ic-lambda-free l bound vt acc)))
    (ICall n args (ic-lambda-free-list args bound vt (ic-lambda-add n bound vt acc)))
    (ICallClosure n args (ic-lambda-free-list args bound vt (ic-lambda-add n bound vt acc)))
    (IFfi _ args (ic-lambda-free-list args bound vt acc))
    (IPrint a (ic-lambda-free a bound vt acc))
    (IIf c t eb
      (ic-lambda-free eb bound vt (ic-lambda-free t bound vt (ic-lambda-free c bound vt acc))))
    (IWhile c body (ic-lambda-free body bound vt (ic-lambda-free c bound vt acc)))
    (ISet n v (ic-lambda-free v bound vt (ic-lambda-add n bound vt acc)))
    (ILet n v body (ic-lambda-free body (Cons n bound) vt (ic-lambda-free v bound vt acc)))
    (ISeq es (ic-lambda-free-list es bound vt acc))
    (IVariant _ _ fs (ic-lambda-free-list fs bound vt acc))
    (IStackVariant _ _ fs (ic-lambda-free-list fs bound vt acc))
    (IMatch s arms (ic-lambda-free-arms arms bound vt (ic-lambda-free s bound vt acc)))
    (IFn _ _ _ acc)
    (ITryCatch tb cv cb (ic-lambda-free cb (Cons cv bound) vt (ic-lambda-free tb bound vt acc)))))

; ic-expr's ELet/ELetMut both funnel through here.
(defn ic-lower-let (arena name val body vt)
  (ILet (str-intern arena name) (ic-expr arena val vt) (ic-expr arena body vt)))

(defn ic-name-in-list (name xs)
  (match xs
    (Nil 0)
    (Cons h t (if (> (str-eq name h) 0) 1 (ic-name-in-list name t)))))


; --- hoist embedded IFn nodes (from `fn`) out to the top level -------------
;
; A structural walk of the WHOLE Icnf tree, not the Expr tree: cheaper
; than threading a lambda accumulator through every one of ic-expr's ~40
; call sites, and additive (it runs strictly after ic-expr, touching
; none of that already-working traversal).

(deftype HoistAcc (HoistAcc Icnf (List Icnf)))
(deftype HoistListAcc (HoistListAcc (List Icnf) (List Icnf)))
(deftype HoistArmAcc (HoistArmAcc (List IArm) (List Icnf)))

(defn hoist-node (r) (match r (HoistAcc n _ n)))
(defn hoist-fns (r) (match r (HoistAcc _ f f)))
(defn hoistl-nodes (r) (match r (HoistListAcc n _ n)))
(defn hoistl-fns (r) (match r (HoistListAcc _ f f)))
(defn hoista-arms (r) (match r (HoistArmAcc a _ a)))
(defn hoista-fns (r) (match r (HoistArmAcc _ f f)))

(defn ic-hoist-list (xs)
  (match xs
    (Nil (HoistListAcc Nil Nil))
    (Cons h t
      (let hh (ic-hoist h)
        (let ht (ic-hoist-list t)
          (HoistListAcc (Cons (hoist-node hh) (hoistl-nodes ht))
                        (list-append (hoist-fns hh) (hoistl-fns ht))))))))

(defn ic-hoist-arms (arms)
  (match arms
    (Nil (HoistArmAcc Nil Nil))
    (Cons a rest
      (match a
        (IArm vname tag binds body
          (let hb (ic-hoist body)
            (let hr (ic-hoist-arms rest)
              (HoistArmAcc (Cons (IArm vname tag binds (hoist-node hb)) (hoista-arms hr))
                           (list-append (hoist-fns hb) (hoista-fns hr))))))))))

(defn ic-hoist (node)
  (match (ic-hoist-node node)
    (HoistAcc n fs (HoistAcc (ic-keep-kind n node) fs))))

(defn ic-hoist-node (node)
  (match node
    (IConst _ (HoistAcc node Nil))
    (IStr _ (HoistAcc node Nil))
    (IFlt _ (HoistAcc node Nil))
    (ILoad _ (HoistAcc node Nil))
    (IBinop op l r
      (let hl (ic-hoist l)
        (let hr (ic-hoist r)
          (HoistAcc (IBinop op (hoist-node hl) (hoist-node hr))
                    (list-append (hoist-fns hl) (hoist-fns hr))))))
    (ICall name args
      (let ha (ic-hoist-list args)
        (HoistAcc (ic-keep-span (ICall name (hoistl-nodes ha)) node) (hoistl-fns ha))))
    (ICallClosure name args
      (let ha (ic-hoist-list args)
        (HoistAcc (ic-keep-span (ICallClosure name (hoistl-nodes ha)) node) (hoistl-fns ha))))
    (ITryCatch tbody cvar cbody
      (let ht (ic-hoist tbody)
        (let hc (ic-hoist cbody)
          (HoistAcc (ITryCatch (hoist-node ht) cvar (hoist-node hc))
                    (list-append (hoist-fns ht) (hoist-fns hc))))))
    (IFfi name args
      (let ha (ic-hoist-list args)
        (HoistAcc (IFfi name (hoistl-nodes ha)) (hoistl-fns ha))))
    (IPrint a
      (let ha (ic-hoist a)
        (HoistAcc (IPrint (hoist-node ha)) (hoist-fns ha))))
    (IIf c t eb
      (let hc (ic-hoist c)
        (let ht (ic-hoist t)
          (let he (ic-hoist eb)
            (HoistAcc (IIf (hoist-node hc) (hoist-node ht) (hoist-node he))
                      (list-append (hoist-fns hc) (list-append (hoist-fns ht) (hoist-fns he))))))))
    (IWhile c body
      (let hc (ic-hoist c)
        (let hb (ic-hoist body)
          (HoistAcc (IWhile (hoist-node hc) (hoist-node hb)) (list-append (hoist-fns hc) (hoist-fns hb))))))
    (ISet name v
      (let hv (ic-hoist v)
        (HoistAcc (ISet name (hoist-node hv)) (hoist-fns hv))))
    (ILet name v body
      (let hv (ic-hoist v)
        (let hb (ic-hoist body)
          (HoistAcc (ILet name (hoist-node hv) (hoist-node hb)) (list-append (hoist-fns hv) (hoist-fns hb))))))
    (ISeq es
      (let ha (ic-hoist-list es)
        (HoistAcc (ISeq (hoistl-nodes ha)) (hoistl-fns ha))))
    (IVariant nm tag fields
      (let ha (ic-hoist-list fields)
        (HoistAcc (IVariant nm tag (hoistl-nodes ha)) (hoistl-fns ha))))
    (IStackVariant nm tag fields
      (let ha (ic-hoist-list fields)
        (HoistAcc (IStackVariant nm tag (hoistl-nodes ha)) (hoistl-fns ha))))
    (IMatch scr arms
      (let hs (ic-hoist scr)
        (let ha (ic-hoist-arms arms)
          (HoistAcc (IMatch (hoist-node hs) (hoista-arms ha)) (list-append (hoist-fns hs) (hoista-fns ha))))))
    (IFn nm params body kinds
      (let hb (ic-hoist body)
        (HoistAcc (ILoad nm) (Cons (IFn nm params (hoist-node hb) kinds) (hoist-fns hb)))))))

; (struct-get obj "field"): self-host has no static type info flowing
; into ICNF lowering, so which concrete struct `obj` is can't be known
; here — build one match arm per struct type (in vt) that declares a
; field with this name, each binding all of that struct's fields and
; returning the one at the requested position, and let the runtime tag
; already carried by `obj` (same tag every IVariant construction embeds)
; pick the right arm, exactly like any other ADT match. No struct having
; the field at all falls back to the (IConst 0) every unsupported shape
; in this file already uses.
(defn ic-for (arena bindings cond body vt)
  (match bindings
    (Nil (IWhile (ic-expr arena cond vt) (ic-expr arena body vt)))
    (Cons b rest
      (match b
        (Pair name initOpt
          (ILet (str-intern arena name)
                (ic-for-init arena initOpt vt)
                (ic-for arena rest cond body vt)))))))

(defn ic-for-init (arena initOpt vt)
  (match initOpt
    (Some e (ic-expr arena e vt))
    (None (IConst 0))))

(defn ic-struct-get (arena se field vt)
  (let arms (ic-struct-arms arena vt field)
    (if (is-nil arms)
      (IConst 0)
      (IMatch (ic-expr arena se vt) arms))))

(defn ic-struct-arms (arena vt field)
  (match vt
    (VTNil Nil)
    (VTFn _ rest (ic-struct-arms arena rest field))
    (VTClosureFn _ rest (ic-struct-arms arena rest field))
    (VTClosureReturn _ rest (ic-struct-arms arena rest field))
    (VTEntry name tag fields _ rest
      (let arms-rest (ic-struct-arms arena rest field)
        (let idx (ic-field-index fields field 0)
          (if (>= idx 0)
            (Cons (ic-struct-arm arena name tag fields idx) arms-rest)
            arms-rest))))))

(defn ic-struct-arm (arena name tag fields idx)
  (let binders (ic-struct-binders (list-length fields) 0)
    (IArm (str-intern arena name) tag binders (ILoad (ic-nth-str binders idx)))))

(defn ic-field-index (fields field i)
  (match fields
    (Nil -1)
    (Cons h t (if (> (str-eq h field) 0) i (ic-field-index t field (+ i 1))))))

(defn ic-nth-str (xs i)
  (match xs
    (Nil "")
    (Cons h t (if (= i 0) h (ic-nth-str t (- i 1))))))

(defn ic-struct-binders (n i)
  (if (>= i n) Nil (Cons (ic-struct-binder-name i) (ic-struct-binders n (+ i 1)))))

; Built from a repeated-underscore suffix rather than formatting the
; index as a decimal string: no int-to-string helper exists in this
; bootstrap, and this only needs to be distinct per position, not
; readable — struct-stress tests declare structs with 25-30 fields, so a
; small fixed name pool isn't enough.
(defn ic-struct-binder-name (i)
  (str-concat "_sg" (ic-underscores (+ i 1))))

(defn ic-underscores (n)
  (if (<= n 0) "" (str-concat "_" (ic-underscores (- n 1)))))

; Atom: nullary variant construction, variable reference, or literal.
(defn ic-atom (arena atom vt)
  (match atom
    (AIdent name (ic-ident arena name vt))
    (AInt v (IConst v))
    (AFloat t (IFlt t))
    (ABool b (IConst (if b 1 0)))
    (AStr s (IStr s))
    (ASymbol s (ic-ident arena s vt))
    (AKeyword s (IStr s))
    (ANil (IConst 0))))

; Identifier: nullary variant construction or variable reference.
(defn ic-ident (arena name vt)
  (let tag (vt-tag-of vt (str-intern arena name))
    (if (> tag -1)
      (IVariant (str-intern arena name) tag (no-icnfs))
      (ILoad (str-intern arena name)))))

; ECall: a plain-identifier callee routes by name like EApply. Any other
; callee is an expression computing a function value -- `((mk 10) 5)`:
; it is evaluated first (spec: the function, then the arguments, left to
; right) into a fresh local, and the call goes through that local, which
; codegen emits as an indirect call (cg-call-indirect). (This used to be
; a call to the empty name, an undefined `_ZYL_` at link time.)
(defn ic-call-expr (arena op args vt)
  (let nm (expr-ident-name op "")
    (if (> (str-length nm) 0)
      (ic-apply arena nm args vt)
      (ic-call-computed arena op args vt))))

(defn ic-call-computed (arena op args vt)
  (let tmp (str-intern arena (str-concat "_callee_" (ic-int-to-str (ic-fresh-id arena))))
    (ILet tmp (ic-expr arena op vt) (ic-keep-span (ICall tmp (ic-expr-list arena args vt)) op))))

; A call the type pass resolved (trait impl, specialized instance, or an
; ADT's equality function for `==`/`=`/`!=`, negated for `!=`).
(defn ic-call-renamed (arena expr op args vt)
  (let nm (ta-renamed expr)
    (if (= nm 0) (ic-call-expr arena op args vt) (ic-renamed-call arena nm (expr-ident-name op "") args vt))))

(defn ic-apply-renamed (arena expr fname args vt)
  (let nm (ta-renamed expr)
    (if (> (str-eq fname "zyl-method") 0)
      (ic-method-call arena nm args vt)
      (if (= nm 0) (ic-apply arena fname args vt) (ic-renamed-call arena nm fname args vt)))))

; (zyl-method "m" recv args...): the type pass named the trait method or its impl.
(defn ic-method-call (arena nm args vt)
  (match args
    (Cons _ rest (if (= nm 0) (IConst 0) (ic-apply arena nm rest vt)))
    (Nil (IConst 0))))

(defn ic-renamed-call (arena nm fname args vt)
  (let c (ICall (str-intern arena nm) (ic-expr-list arena args vt))
    (if (> (ffi-call "zyl_cstr_eq" fname "!=" 1000) 0) (IBinop 9 c (IConst 0)) c)))

; Apply: operator, ffi-call, or call/variant routing by head-symbol name
; (no-dispatch arch: recognition happens here, never in the reader).
(defn ic-apply (arena fname args vt)
  (if (> (str-eq fname (str-intern arena "ffi-call")) 0)
    (ic-ffi arena args vt)
    (let strb (ic-str-builtin-sym arena fname)
      (if (> (str-length strb) 0)
        (IFfi strb (ic-expr-list arena args vt))
        (if (> (ic-starts-with-make fname) 0)
          (ic-make-struct arena fname args vt)
          (let op (ic-op-of arena fname)
            (if (> op -1)
              (ic-binop arena op args vt)
              (ic-call-or-variant arena fname args vt))))))))

; Whether `s` starts with "make-". Deliberately NOT reusing
; monomorphization.zyl's str-starts-with (str-substring + `=`): codegen's
; cg-param-env hardcodes every function PARAMETER's kind-of to 0 (int),
; regardless of how it's used, so `=`/`!=` between two STRING parameters
; silently does raw pointer comparison instead of routing through
; zyl_cstr_eq — str-starts-with's own `s`/`prefix` are exactly that
; shape, so it always returns false when self-hosted codegen (not the
; Rust bootstrap) compiles a call to it. Comparing through zyl_cstr_eq
; directly via ffi-call, as done here, sidesteps kind-of entirely.
; (assert c "msg") panics with msg; any other message form keeps the fixed text.
(defn ic-assert-msg (m)
  (match m
    (Some x (match (Expr.inner x) (EAtom a (match a (AStr t t) (_ "assert failed"))) (_ "assert failed")))
    (None "assert failed")))

; A byte access: one byte through `sym1`, a 16/32/64-bit one through `symn` with its width first.
(defn ic-byte-access (arena sym1 symn endian args)
  (let e (IConst (endian-to-int endian))
    (if (= (endian-width endian) 1)
      (IFfi sym1 (Cons e args))
      (IFfi symn (Cons (IConst (endian-width endian)) (Cons e args))))))

(defn ic-starts-with-make (s)
  (if (>= (str-length s) 5)
    (ffi-call "zyl_cstr_eq" (str-substring s 0 5) "make-" 1000)
    0))

; (make-<Name> field-vals...): struct constructor call. Structs are
; single-variant deftypes named after the struct (see expr_inner.zyl's
; parse-defstruct), so stripping the "make-" prefix and looking that name
; up in vt is enough to build the same IVariant a direct `(Name ...)` ADT
; constructor call would. Falls back to a plain call/variant lookup on
; the untouched name when "make-<rest>" isn't a known struct — so a
; user-defined function that happens to be named "make-something-else"
; still works normally.
(defn ic-make-struct (arena fname args vt)
  (let sname (str-drop fname 5)
    (let tag (vt-tag-of vt (str-intern arena sname))
      (if (> tag -1)
        (IVariant (str-intern arena sname) tag (ic-expr-list arena args vt))
        (ic-call-or-variant arena fname args vt)))))

; str-concat/str-length/str-substring/str-equal are recognized by name
; and inlined straight to the runtime C symbol, matching the Rust
; bootstrap's codegen.rs (which inlines these at every call site rather
; than requiring a real callable definition) — without this, any program
; that calls them without also defining its own same-named wrapper
; function links with an undefined `f_str_*` reference.
(defn ic-str-builtin-sym (arena fname)
  (if (> (str-eq fname (str-intern arena "str-concat")) 0) "zyl_cstr_concat"
  (if (> (str-eq fname (str-intern arena "str-length")) 0) "zyl_cstr_len"
  (if (> (str-eq fname (str-intern arena "str-substring")) 0) "zyl_cstr_substr"
  (if (> (str-eq fname (str-intern arena "str-equal")) 0) "zyl_cstr_eq"
  "")))))

(defn ic-call-or-variant (arena fname args vt)
  (let gsym (ic-global-sym fname)
    (if (> (str-length gsym) 0)
      (IFfi gsym (ic-expr-list arena args vt))
      (ic-call-or-variant-go arena fname args vt))))

; Runtime cell ops that def getters (expr_inner.zyl's def-getter) call.
(defn ic-global-sym (n)
  (if (> (str-eq n "zyl-global-ready") 0) "zyl_global_ready"
    (if (> (str-eq n "zyl-global-get") 0) "zyl_global_get"
      (if (> (str-eq n "zyl-global-put") 0) "zyl_global_put" ""))))

(defn ic-call-or-variant-go (arena fname args vt)
  (let tag (vt-tag-of vt (str-intern arena fname))
    (if (> tag -1)
      (IVariant (str-intern arena fname) tag (ic-expr-list arena args vt))
      (let impls (ffi-call "zyl_smap_get" (ffi-call "zyl_smap_global" 1 1000) fname 1000)
        (if (= impls 0)
          (ic-plain-call arena fname args vt)
          (ic-trait-dispatch arena impls args vt))))))

; A trait call the type pass could not resolve: match the receiver's tag,
; one arm per impl type (a non-variant type name acts as a catch-all).
(defn ic-trait-dispatch (arena impls args vt)
  (match args
    (Nil (IConst 0))
    (Cons recv rest
      (ILet "_td_recv" (ic-expr arena recv vt)
        (IMatch (ILoad "_td_recv") (ic-trait-arms arena impls rest vt))))))

(defn ic-trait-arms (arena impls rest vt)
  (match impls
    (Nil Nil)
    (Cons pr more
      (match pr
        (Pair type mangled
          (Cons (IArm (str-intern arena type) (vt-tag-of vt (str-intern arena type)) Nil
                      (ICall (str-intern arena mangled) (Cons (ILoad "_td_recv") (ic-expr-list arena rest vt))))
                (ic-trait-arms arena more rest vt)))))))

; A call through a local holding a function value is still an ICall:
; codegen sees the name bound to a slot and emits cg-call-indirect.
(defn ic-plain-call (arena fname args vt)
  (ICall (str-intern arena fname) (ic-expr-list arena args vt)))

; Binary operator: exactly two arguments lowers directly, unary minus
; (- x) supported, three or more arguments fold left-associatively
; (matching the Rust bootstrap's convert_nary_fold). Anything else was
; previously lowered to (IConst 0) SILENTLY — the source of the
; "computed count is 0 in stage>=2 binaries" miscompile class.
(defn ic-binop (arena op args vt)
  (if (= op 17)
    (ic-bit-not arena args vt)
  (if (= (list-length args) 2)
    (IBinop op
            (ic-expr arena (first-expr args) vt)
            (ic-expr arena (last-expr args) vt))
    (if (= (list-length args) 1)
      (if (= op 1)
        (IBinop 1 (IConst 0) (ic-expr arena (first-expr args) vt))
        (IConst 0))
      (if (> (list-length args) 2)
        (ic-binop-fold arena op args vt)
        (IConst 0))))))

; bit-not is the one bitwise op with no two-operand machine form here:
; `(bit-not x)` lowers to `x XOR -1`, which is exactly one's complement
; on a 64-bit two's-complement Int and needs no new codegen path.
; Arity is checked rather than silently folded to 0 -- a silently-zero
; lowering is the exact miscompile class ic-binop's own comment above
; describes.
(defn ic-bit-not (arena args vt)
  (if (= (list-length args) 1)
    (IBinop 13 (ic-expr arena (first-expr args) vt) (IConst -1))
    (ffi-call "zyl_panic" "E_ARITY_MISMATCH: bit-not takes exactly one argument" 1000)))

; Left-associative n-ary fold: (op a b c) -> (op (op a b) c).
; The tree must nest LEFT so subtraction/division evaluate in source
; order: 10-(2-3) != (10-2)-3.
(defn ic-binop-fold (arena op args vt)
  (if (= (list-length args) 2)
    (IBinop op
            (ic-expr arena (first-expr args) vt)
            (ic-expr arena (last-expr args) vt))
    (let l (ic-binop-fold arena op (butlast-expr args Nil) vt)
      (IBinop op l (ic-expr arena (last-expr args) vt)))))

; print: multi-argument prints become a sequence of single prints.
(defn ic-print (arena args vt)
  (if (is-nil args)
    (IConst 0)
    (ic-print-step arena (first-expr args) (rest-expr args) vt)))

(defn ic-print-step (arena a rest vt)
  (if (is-nil rest)
    (IPrint (ic-print-arg arena a vt))
    (ISeq (Cons (IPrint (ic-print-arg arena a vt))
                (Cons (ic-print arena rest vt) (no-icnfs))))))

; A value whose type has a Show impl prints as its `show` text.
(defn ic-print-arg (arena a vt)
  (let sh (ta-print-show a)
    (if (= sh 0)
      (ic-expr arena a vt)
      (ic-mark-kind (ICall (str-intern arena sh) (Cons (ic-expr arena a vt) Nil)) 1))))

; (ffi-call "sym" a b timeout): arrives here as EApply("ffi-call", args)
; since expr_inner.zyl's dispatch has no dedicated ffi-call parser — drop
; the trailing timeout literal, same as this lowering always has.
(defn ic-ffi (arena args vt)
  (match args
    (Cons sym tail
      ; tail = everything after the symbol: (arg* timeout).
      (if (> (list-length tail) 1)
        (IFfi (ic-ffi-sym sym) (ic-expr-list arena (butlast-expr tail Nil) vt))
        (IFfi (ic-ffi-sym sym) Nil)))
    (Nil (IFfi "?" Nil))))

; The ffi symbol is a string literal — extract via its Atom, NOT
; expr-ident-name (which only extracts identifiers).
(defn ic-ffi-sym (sym)
  (match (Expr.inner sym)
    (EAtom atom (match atom (AStr s s) (_ "")))
    (_ "")))

; Collect all variant names from VT that are actual ADT constructors
; (not function names). VTEntry tags >= 0 are variants; VTFn have
; negative tags? Actually VTFn uses its own constructor.
; We'll check if a variant name exists in VT at all (vt-tag-of >= 0).
(defn ic-vt-has-variant (vt name)
  (>= (vt-tag-of vt name) 0))

; Check if any arm is a catch-all (wildcard) — variant not in VT.
(defn ic-arm-is-catchall (vt arm)
  (let iname (MA.variant arm)
    (= (ic-vt-has-variant vt iname) 0)))

; Check if any arm is catch-all
(defn ic-has-catchall (arms vt)
  (match arms
    (Nil 0)
    (Cons arm rest
      (let ca (ic-arm-is-catchall vt arm)
        (if (> ca 0) 1 (ic-has-catchall rest vt))))))

; Check all arms' variants exist in VT (no typos)
(defn ic-check-variants-exist (arms vt)
  (match arms
    (Nil 0)
    (Cons arm rest
      (let iname (MA.variant arm)
        (if (= (vt-tag-of vt iname) -1)
          (let msg (str-concat "E_MATCH_NONEXHAUSTIVE: unknown variant `" (str-concat iname "` in match arm"))
            (ffi-call "zyl_panic" msg 1000))
          (ic-check-variants-exist rest vt))))))

; Real exhaustiveness, using VTEntry's gid (see ast.zyl): every variant
; is grouped with its declaration siblings regardless of tag (tag alone
; restarts at 0 per deftype and can't disambiguate). Take the first arm's
; own gid, collect every sibling name sharing it, and check each is
; covered by some arm. Doesn't need real scrutinee-type tracking (item #1's
; still-missing gap) since a match's arms are always drawn from one ADT in
; valid programs, so the first arm's gid already IS the scrutinee's group.
;
; Guarded by ic-arms-all-gid: parse-match-arm's "wrapped" arm surface form
; `((Variant field*) body)` records the NESTED pattern's own constructor as
; MA.variant -- correct for a real wrapped arm, but the exact same AST shape
; is (mis)produced today for a 3-part `((Inner f*) tail-name body)` arm
; that's actually destructuring a Cons's head inline (seen in
; region_inference.zyl's `((RB n r esc) rest ...)`, a currently-dead code
; path since region inference's result isn't wired into codegen output —
; not something to fix as a side effect of this check). MA.variant there
; reports the INNER type's constructor (e.g. "RB" from RegionBind), which
; has nothing to do with the outer List's own Cons/Nil siblings. Rather
; than guess which shape produced a given arm, require every arm in the
; match to share the SAME gid as the first one before trusting the group at
; all; a mix of gids means at least one arm's reported name doesn't mean
; what this check assumes, so it backs off to "no error" (the pre-existing
; behavior) instead of risking a false positive on a case it can't
; distinguish from a real bug.
(defn ic-arm-covers-name (arms n)
  (match arms
    (Nil 0)
    (Cons arm rest
      (if (> (str-eq (MA.variant arm) n) 0) 1 (ic-arm-covers-name rest n)))))

(defn ic-names-uncovered (names arms)
  (match names
    (Nil 0)
    (Cons n rest
      (if (> (ic-arm-covers-name arms n) 0)
        (ic-names-uncovered rest arms)
        1))))

(defn ic-arms-all-gid (arms vt gid)
  (match arms
    (Nil 1)
    (Cons arm rest
      (if (= (vt-gid-of vt (MA.variant arm)) gid)
        (ic-arms-all-gid rest vt gid)
        0))))

(defn ic-check-exhaustive-gid (arms vt)
  (match arms
    (Nil 0)
    (Cons arm _
      (let gid (vt-gid-of vt (MA.variant arm))
        (if (< gid 0)
          0
          (if (= (ic-arms-all-gid arms vt gid) 0)
            0
            (if (> (ic-names-uncovered (vt-names-with-gid vt gid) arms) 0)
              (ffi-call "zyl_panic" "E_MATCH_NONEXHAUSTIVE: match does not cover every variant" 1000)
              0)))))))

; Exhaustiveness check: if no catch-all arm, verify each arm's variant is
; a known VT variant (typo detection), then that every sibling variant of
; the arms' own deftype is actually covered.
(defn ic-check-exhaustive (arms vt)
  (if (> (ic-has-catchall arms vt) 0)
    0
    (let _ (ic-check-variants-exist arms vt)
      (ic-check-exhaustive-gid arms vt))))

; unwrap-on-Some lowers to a match binding the fresh name; unwrap on any
; other variant panics (item 23).
(defn ic-unwrap (arena e vt) (let tag 0 (let vn (str-intern arena (str-concat "_uv" (ic-int-to-str (ic-fresh-id arena)))) (IMatch (ic-expr arena e vt) (Cons (IArm (str-intern arena "Some") tag (Cons vn (no-strs)) (ILoad vn)) (Cons (IArm (str-intern arena "_unwrap_none") -1 (no-strs) (IFfi "zyl_panic" (Cons (IStr "unwrap on None") Nil))) (no-iarms)))))))

; (match scrutinee arm...)
(defn ic-match (arena subj arms vt)
  (let _ (ic-check-exhaustive arms vt)
    (IMatch (ic-expr arena subj vt)
            (list-reverse (ic-arms arena arms (no-iarms) vt)))))

(defn ic-arms (arena arms acc vt)
  (match arms
    (Nil acc)
    (Cons arm rest (ic-arms arena rest (Cons (ic-arm arena arm vt) acc) vt))))

; One arm: variant name, pattern-bound field names, body — already
; separated by expr_inner.zyl's MatchArm (MA variant patterns body).
;
; A NESTED constructor pattern in field position, like the `(A-Int n)`
; in `(A-Ident (A-Int n) n)`, isn't a bare identifier — bind-names/
; ic-arm-binds gives it a fresh synthetic field name instead of its own
; (nonexistent) name, and ic-wrap-nested-all wraps the arm body in an
; inner IMatch on that fresh name for the sub-pattern, recursively. A
; previous attempt at this same approach made self-hosting flaky
; (different runs of the same rebuild crashed at different pipeline
; stages, no code difference between runs) and was reverted; that
; flakiness is now understood to be an unrelated ASLR/stack-collision
; bug in the self-hosted worker thread's stack allocation (originally
; worked around with boot.sh's `setarch -R`, since fixed for real in
; zyl_call_on_big_stack -- see runtime/actor_runtime.c), not a defect
; in this lowering — retried now that the real cause is fixed.
(defn ic-arm (arena arm vt)
  (let iname (str-intern arena (MA.variant arm))
    (let tag (vt-tag-of vt iname)
      ; E_MATCH_ARM_COMPLEX guard: reject the confirmed-failing shape
      ; before lowering (see ic-arm-guard below).
      (let _ (ic-arm-guard arena (MA.body arm) vt)
        (let pats (MA.patterns arm)
          (let binds (ic-arm-binds arena pats)
            (let nested (ic-arm-nested pats binds)
              (IArm iname
                    tag
                    binds
                    (ic-wrap-nested-all arena nested (ic-expr arena (MA.body arm) vt) vt)))))))))

; Field-binding names in source order: a bare identifier/wildcard keeps
; its own name; a nested constructor pattern (not a plain EAtom AIdent)
; gets a fresh synthetic name instead, since it has no name of its own
; to bind — ic-arm-nested below pairs that synthetic name back up with
; its pattern for ic-wrap-nested-all to destructure.
(defn ic-arm-binds (arena pats)
  (match pats
    (Nil Nil)
    (Cons p rest (Cons (ic-arm-bind-one arena p) (ic-arm-binds arena rest)))))

(defn ic-arm-bind-one (arena p)
  (if (> (ic-pat-is-nested p) 0)
    (str-intern arena (str-concat "_np" (ic-int-to-str (ic-fresh-id arena))))
    (str-intern arena (expr-ident-name p ""))))

; True when `p` is a constructor-application pattern (needs further
; destructuring) rather than a bare identifier/wildcard binder.
(defn ic-pat-is-nested (p)
  (match (Expr.inner p)
    (ECall _ _ 1)
    (EApply _ _ 1)
    (_ 0)))

(defn ic-pat-ctor-name (p)
  (match (Expr.inner p)
    (ECall op _ (expr-ident-name op ""))
    (EApply fname _ fname)
    (_ "")))

(defn ic-pat-args (p)
  (match (Expr.inner p)
    (ECall _ args args)
    (EApply _ args args)
    (_ Nil)))

; Pairs each nested pattern (see ic-pat-is-nested) with the synthetic
; field name ic-arm-binds already assigned it, in the same order —
; `pats`/`binds` are always the same length (ic-arm-binds produces
; exactly one name per pattern), so they're walked in lockstep.
(deftype NPEntry (NPEntry String Expr))

(defn ic-arm-nested (pats binds)
  (match pats
    (Nil Nil)
    (Cons p prest
      (match binds
        (Nil Nil)
        (Cons b brest
          (if (> (ic-pat-is-nested p) 0)
            (Cons (NPEntry b p) (ic-arm-nested prest brest))
            (ic-arm-nested prest brest)))))))

; Wrap `body` in one inner IMatch per nested-pattern entry (innermost
; entry wraps closest to `body`, matching left-to-right field order —
; only matters when an arm has more than one nested field, since they
; don't interact). Each wrap wholly replaces its own sub-pattern's
; fields/body recursion via a fresh ic-arm-binds/ic-arm-nested pass, so
; arbitrarily deep nesting (`(A (B (C n)))`) destructures correctly.
(defn ic-wrap-nested-all (arena nested body vt)
  (match nested
    (Nil body)
    (Cons entry rest (ic-wrap-one arena entry (ic-wrap-nested-all arena rest body vt) vt))))

; Used to outline the inner match into its own top-level helper IFn,
; called with only the field value to match on, out of a belief that
; codegen.zyl's cg-label-pair comment ("each match is the entire body
; of its own defn") meant nested matches miscompile in the same
; function. That belief was wrong for what actually matters here:
; sequential/chained matches (a match nested in an *arm body*, as
; opposed to a constructor pattern nested in *field position*) compile
; and run correctly at three levels deep and more -- confirmed by
; tracing sb-close-bracket's own compiled output, which chains exactly
; that shape. The outlined helper, meanwhile, was a genuine bug: `body`
; (the arm's continuation) freely references outer-scope names (other
; sibling field bindings, the enclosing function's own parameters, its
; own outer match's bindings) that were never among the helper's
; parameters. Since this compiler has no free-variable/closure capture
; anywhere else either, every such reference resolved via env-lookup's
; unbound-name fallback (offset 0, i.e. the helper's own saved rbp) --
; not a heap value at all, silently. It read back as a plausible-looking
; but wrong pointer, correct by pure chance often enough (small inputs,
; shallow recursion) to look like a rare, unrelated, deep crash instead
; of what it was: every reference to an enclosing-scope name inside a
; nested-pattern arm being systematically wrong. Emitting a plain
; inline IMatch instead keeps the whole thing in the same function's
; scope, where every one of those names is already visible normally.
(defn ic-wrap-one (arena entry body vt)
  (match entry
    (NPEntry bindname pat
      (let subname (ic-pat-ctor-name pat)
        (let subtag (vt-tag-of vt (str-intern arena subname))
          (let subpats (ic-pat-args pat)
            (let subbinds (ic-arm-binds arena subpats)
              (let subnested (ic-arm-nested subpats subbinds)
                (IMatch (ILoad bindname)
                        (Cons (IArm (str-intern arena subname) subtag subbinds
                                    (ic-wrap-nested-all arena subnested body vt))
                              Nil))))))))))

; ─── E_MATCH_ARM_COMPLEX guard ────────────────────────────────────────────
; A match-arm body whose TOP-LEVEL binop combines a constant with two or
; more calls silently computes 0 in stage>=2 binaries ("bind fields;
; store 0"). Nest sums through helper functions so each arm body has a
; single call. This check mirrors the Rust bootstrap's
; validate_match_arm_complexity but runs at lowering time in the
; self-hosted compiler too.
(defn ic-arm-guard (arena body vt)
  (match (Expr.inner body)
    (EApply fname args
      (let op (ic-op-of arena fname)
        (if (> op -1)
          (ic-arm-guard-count arena args vt 0 0)
          0)))
    (_ 0)))

; Count constant and call-like operands; error on const>=1 && calls>=2.
(defn ic-arm-guard-count (arena args vt consts calls)
  (if (is-nil args)
    (if (> consts 0)
      (if (> calls 1)
        (ffi-call "zyl_panic" "E_MATCH_ARM_COMPLEX: match arm combines a constant with multiple calls - nest sums through helper functions" 1000)
        0)
      0)
    (ic-arm-guard-count arena (rest-expr args) vt
                        (+ consts (ic-arm-guard-is-const (first-expr args)))
                        (+ calls (ic-arm-guard-is-call arena (first-expr args) vt)))))

(defn ic-arm-guard-is-const (a)
  (match (Expr.inner a)
    (EAtom atom
      (match atom
        (AInt _ 1)
        (AFloat _ 1)
        (ABool _ 1)
        (_ 0)))
    (_ 0)))

; A call-like operand: an Apply/Call whose head is NOT a known variant
; constructor (special forms inside binop args are rejected too — they
; violate the one-call rule regardless).
(defn ic-arm-guard-is-call (arena a vt)
  (match (Expr.inner a)
    (EApply fname _ (ic-arm-guard-call-head arena fname vt))
    (ECall op _ (ic-arm-guard-call-head arena (expr-ident-name op "") vt))
    (_ 0)))

(defn ic-arm-guard-call-head (arena fname vt)
  (let tag (vt-tag-of vt (str-intern arena fname))
    (if (> tag -1) 0 1)))

; Lower argument lists left-to-right.
(defn ic-expr-list (arena args vt)
  (ic-expr-list-acc arena args vt (no-icnfs)))

(defn ic-expr-list-acc (arena args vt acc)
  (match args
    (Nil (list-reverse acc))
    (Cons a rest
      (ic-expr-list-acc arena rest vt (Cons (ic-expr arena a vt) acc)))))
