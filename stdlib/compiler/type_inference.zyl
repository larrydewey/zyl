; === Zyl Type Inference Engine ===
; Port of Rust type_inference.rs (~2752 loc) to Zyl (~1200 loc)
; Core: infer_expr dispatch, collect_definitions, finalize_param_types
;
; FORMATTING: C-style block discipline — every open paren on its own line
; at the correct indent; every close paren on its own line aligned under
; its matching open. Indentation disambiguates nesting so paren balance is
; trivial to verify visually.

; ===========================================================================
; INFERENCE STATE — simplified from Rust (no RefCell/Cell)
;
; NOTE: The TypeInferer record and its support ADTs (FnSig, ParamType,
; FnReturn, AdtDef, Variant, Field, BodyCache, VarPair) are defined in
; stdlib/compiler/type_system.zyl — the single owner of all type-system
; ADTs. This file contains only the inference LOGIC.
; ===========================================================================

(defn fresh-var (inferer)
    ; return current next-index and bump-by-1
    (let
        (n (ti-next inferer))
        (Pair n (+ n 1))))

(defn update-next (inferer n)
    ; reconstruct inferer with new next-index, all else unchanged
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        n
        (ti-known-types inferer)
        (ti-known-fns inferer)
        (ti-func-returns inferer)
        (ti-adt-defs inferer)
        (ti-variant-to-adt inferer)
        (ti-string-match-vars inferer)
        (ti-inferring-fns inferer)
        (ti-body-cache inferer)))

; ===========================================================================
; KNOWN TYPES HELPERS
; ===========================================================================

(defn lookup-known-type (inferer name)
    (lookup-known-type-binds (ti-known-types inferer) name))

(defn lookup-known-type-binds (binds name)
    ; was `((TB k v) rest body)` — the Cons-cell nested-head-plus-tail-
    ; binding sugar the self-hosted parser drops the tail binding for
    ; (only its simpler 2-element sibling form works); sequential
    ; matches sidestep it (same fix as type_system.zyl's *-binds helpers).
    (match binds
        (Nil None)
        (Cons hd rest
            (match hd
                (TB k v
                    (if
                        (= k name)
                        (Some v)
                        (lookup-known-type-binds rest name)))))))

(defn insert-known-type (inferer name typ)
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        (ti-next inferer)
        (Cons
            (TB name typ)
            (ti-known-types inferer))
        (ti-known-fns inferer)
        (ti-func-returns inferer)
        (ti-adt-defs inferer)
        (ti-variant-to-adt inferer)
        (ti-string-match-vars inferer)
        (ti-inferring-fns inferer)
        (ti-body-cache inferer)))

; ===========================================================================
; KNOWN FUNCTIONS HELPERS
; ===========================================================================

(defn lookup-known-fn (inferer name)
    (lookup-fn-sigs-binds (ti-known-fns inferer) name))

(defn lookup-fn-sigs-binds (sigs name)
    ; same Cons-cell nested-head-plus-tail-binding bug as above.
    (match sigs
        (Nil Nil)
        (Cons hd rest
            (match hd
                (FNS n params
                    (if
                        (= n name)
                        params
                        (lookup-fn-sigs-binds rest name)))))))

(defn insert-known-fn (inferer name params)
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        (ti-next inferer)
        (ti-known-types inferer)
        (Cons
            (FNS name params)
            (ti-known-fns inferer))
        (ti-func-returns inferer)
        (ti-adt-defs inferer)
        (ti-variant-to-adt inferer)
        (ti-string-match-vars inferer)
        (ti-inferring-fns inferer)
        (ti-body-cache inferer)))

; ===========================================================================
; FUNCTION RETURNS HELPERS
; ===========================================================================

(defn lookup-fn-ret (inferer name)
    (lookup-ret-binds (ti-func-returns inferer) name))

(defn lookup-ret-binds (binds name)
    ; same Cons-cell nested-head-plus-tail-binding bug as above.
    (match binds
        (Nil None)
        (Cons hd rest
            (match hd
                (FR k v
                    (if
                        (= k name)
                        (Some v)
                        (lookup-ret-binds rest name)))))))

(defn insert-fn-ret (inferer name typ)
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        (ti-next inferer)
        (ti-known-types inferer)
        (ti-known-fns inferer)
        (Cons
            (FR name typ)
            (ti-func-returns inferer))
        (ti-adt-defs inferer)
        (ti-variant-to-adt inferer)
        (ti-string-match-vars inferer)
        (ti-inferring-fns inferer)
        (ti-body-cache inferer)))

; ===========================================================================
; ADT DEFINITIONS HELPERS
; ===========================================================================

(defn lookup-adt-def (inferer name)
    (lookup-adt-binds (ti-adt-defs inferer) name))

(defn lookup-adt-binds (binds name)
    ; same Cons-cell nested-head-plus-tail-binding bug as above.
    (match binds
        (Nil Nil)
        (Cons hd rest
            (match hd
                (AD n variants
                    (if
                        (= n name)
                        variants
                        (lookup-adt-binds rest name)))))))

(defn insert-adt-def (inferer name variants)
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        (ti-next inferer)
        (ti-known-types inferer)
        (ti-known-fns inferer)
        (ti-func-returns inferer)
        (Cons
            (AD name variants)
            (ti-adt-defs inferer))
        (ti-variant-to-adt inferer)
        (ti-string-match-vars inferer)
        (ti-inferring-fns inferer)
        (ti-body-cache inferer)))

; ===========================================================================
; VARIANT -> ADT HELPERS
; ===========================================================================

(defn lookup-variant-to-adt (inferer variant)
    (lookup-vta-binds (ti-variant-to-adt inferer) variant))

(defn lookup-vta-binds (binds variant)
    ; same Cons-cell nested-head-plus-tail-binding bug as above.
    (match binds
        (Nil None)
        (Cons hd rest
            (match hd
                (TB k v
                    (if
                        (= k variant)
                        (Some v)
                        (lookup-vta-binds rest variant)))))))

(defn insert-variant-to-adt (inferer variant adt)
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        (ti-next inferer)
        (ti-known-types inferer)
        (ti-known-fns inferer)
        (ti-func-returns inferer)
        (ti-adt-defs inferer)
        (Cons
            (TB variant adt)
            (ti-variant-to-adt inferer))
        (ti-string-match-vars inferer)
        (ti-inferring-fns inferer)
        (ti-body-cache inferer)))

; ===========================================================================
; BODY CACHE HELPERS
; ===========================================================================

(defn lookup-body-cache (inferer key)
    ; walk body-cache list, threading rest through a rebuilt inferer.
    ; Was `((BC k v) rest body)` — same Cons-cell nested-head-plus-tail-
    ; binding bug fixed throughout this file/type_system.zyl.
    (match
        (ti-body-cache inferer)
        (Nil None)
        (Cons hd rest
            (match hd
                (BC k v
                    (if
                        (= k key)
                        (Some v)
                        (lookup-body-cache
                            (TypeInferer
                                (ti-env inferer)
                                (ti-subst inferer)
                                (ti-next inferer)
                                (ti-known-types inferer)
                                (ti-known-fns inferer)
                                (ti-func-returns inferer)
                                (ti-adt-defs inferer)
                                (ti-variant-to-adt inferer)
                                (ti-string-match-vars inferer)
                                (ti-inferring-fns inferer)
                                rest)
                            key)))))))

(defn insert-body-cache (inferer key typ)
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        (ti-next inferer)
        (ti-known-types inferer)
        (ti-known-fns inferer)
        (ti-func-returns inferer)
        (ti-adt-defs inferer)
        (ti-variant-to-adt inferer)
        (ti-string-match-vars inferer)
        (ti-inferring-fns inferer)
        (Cons
            (BC key typ)
            (ti-body-cache inferer))))

; ===========================================================================
; INFERRING FUNCTIONS HELPERS
; ===========================================================================

(defn is-inferring (inferer name)
    (mem-string-list (ti-inferring-fns inferer) name))

(defn mark-inferring (inferer name)
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        (ti-next inferer)
        (ti-known-types inferer)
        (ti-known-fns inferer)
        (ti-func-returns inferer)
        (ti-adt-defs inferer)
        (ti-variant-to-adt inferer)
        (ti-string-match-vars inferer)
        (Cons
            name
            (ti-inferring-fns inferer))
        (ti-body-cache inferer)))

; ===========================================================================
; STRING MATCH VARS HELPERS
; ===========================================================================

(defn insert-string-match-var (inferer name)
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        (ti-next inferer)
        (ti-known-types inferer)
        (ti-known-fns inferer)
        (ti-func-returns inferer)
        (ti-adt-defs inferer)
        (ti-variant-to-adt inferer)
        (Cons
            name
            (ti-string-match-vars inferer))
        (ti-inferring-fns inferer)
        (ti-body-cache inferer)))

; ===========================================================================
; UTILITY HELPERS
; ===========================================================================

(defn mem-string-list (lst name)
    (match lst
        (Nil false)
        ((Cons h t)
            (if
                (= h name)
                true
                (mem-string-list t name)))))

(defn is-generic-param (s)
    ; single uppercase letter marks a generic type param
    (if
        (= (str-length s) 1)
        (str-contains "ABCDEFGHIJKLMNOPQRSTUVWXYZ" s)
        false))

(defn is-primitive-type-name (s)
    (or (= s "Int") (or (= s "Float") (or (= s "Bool") (or (= s "String") (= s "Unit"))))))

(defn prim-type-from-name (s)
    (if (= s "Int") TInt
        (if (= s "Float") TFloat
            (if (= s "Bool") TBool
                (if (= s "String") TString
                    (if (= s "Unit") TUnit
                        (TVar 0 TUnit)))))))

(defn type-from-display (s)
    ; map display string to concrete type
    (if (is-primitive-type-name s) (prim-type-from-name s) (TStruct s Nil)))

(defn is-skip-placeholder (expr)
    ; detect the ____skip_ atom that marks an empty branch
    (match (Expr.inner expr)
        (EAtom atom
            (match atom
                (AKeyword kw (= kw "___skip_"))
                (d2 false)))
        (d1 false)))

; ===========================================================================
; INFERER CONSTRUCTOR
; ===========================================================================

(defn inferer-new ()
    (let
        (known
            (Cons
                (TB "Int" TInt)
                (Cons
                    (TB "Float" TFloat)
                    (Cons
                        (TB "Bool" TBool)
                        (Cons
                            (TB "String" TString)
                            (Cons
                                (TB "Unit" TUnit)
                                Nil))))))
        (TypeInferer
            ; TypeEnv's real constructor is TEBindings (see type_system.zyl)
            ; — "TypeEnv" is only the type name. This resolved to some
            ; unrelated 0-arity variant elsewhere in the program (tag 4),
            ; silently discarding the Nil argument and leaving ti-env holding
            ; garbage from field0 onward — the initial inferer was corrupt
            ; before a single expression was ever processed.
            (TEBindings Nil)
            (subst-empty)
            0
            known
            Nil
            Nil
            Nil
            Nil
            Nil
            Nil
            Nil)))

; ===========================================================================
; INFER-EXPR — core dispatch
; ===========================================================================

; infer-expr's outer dispatch used to name every arm WITHOUT the "E" prefix
; that ExprInner's real variants all carry (EAtom/EDef/ELet/EIf/... — see
; expr_inner.zyl). None of those bare names ("Atom", "Def", "Let", "If", ...)
; match any declared variant anywhere, so every one of them resolved to the
; wildcard sentinel discriminant — and since duplicate-wildcard arms only
; let the FIRST one fire, infer-expr silently returned TInt for literally
; every expression in the program, regardless of what it actually was. The
; nested "(Atom (Int d1 d2) ...)" sub-patterns were doubly broken: besides
; naming a non-existent outer variant, they also gave 1-field Atom variants
; (AInt/AFloat/ABool/AStr/AIdent all have exactly one field) two pattern
; names instead of one.
(defn infer-expr (inferer expr)
    (match (Expr.inner expr)
        (EAtom atom
            (match atom
                (AInt d1 (inferer-return-int inferer))
                (AFloat d3 (inferer-return-float inferer))
                (ABool d5 (inferer-return-bool inferer))
                (AStr d7 (inferer-return-string inferer))
                (AKeyword kw
                    (if (= kw "___skip_")
                        (inferer-return-unit inferer)
                        (inferer-return-var inferer)))
                (AIdent name
                    (if
                        (is-primitive-ident name)
                        (inferer-return-prim inferer name)
                        (infer-expr-ident inferer expr name)))
                (d100 (inferer-return-var inferer))))
        (EDef
            d9 val
            ; `expr.val` was a bare, never-bound identifier (EDef's `val`
            ; is already destructured right above) calling infer-expr-let
            ; with only 3 of its 5 required args — EDef has no body (unlike
            ; ELet), so there's nothing for that machinery to bind into;
            ; just infer the value's type directly.
            (infer-expr inferer val))
        (ELet
            name val body
            (infer-expr-let inferer expr name val body))
        (EIf
            cond then- else-
            (infer-expr-if inferer expr cond then- else-))
        (ECall
            op args
            (infer-expr-call inferer expr op args))
        (EApply
            name args
            (infer-expr-apply inferer expr name args))
        (EBegin
            stmts
            (infer-expr-begin inferer expr stmts))
        (ELambda
            d10 params body
            (infer-expr-lambda inferer expr params body))
        (EFn
            d10b params body
            (infer-expr-lambda inferer expr params body))
        (EWhile
            cond body
            (infer-expr-while inferer expr cond body))
        (EFor
            bindings cond body
            (infer-expr-for inferer expr bindings cond body))
        (ECond
            clauses
            (infer-expr-cond inferer expr clauses))
        (ETryCatch
            eh cn handler
            (infer-expr-try-catch inferer expr eh cn handler))
        (EMatch
            subject arms
            (infer-expr-match inferer expr subject arms))
        (EDefn
            _name _params body
            (inferer-return-unit inferer))
        (EDeftype
            _name _variants _bound _derives
            (inferer-return-unit inferer))
        (ETraitDecl
            _name _methods _derives
            (inferer-return-unit inferer))
        (EImplBlock
            _trait _type _bodies
            (inferer-return-unit inferer))
        (EStructDef
            _sd _extra
            (inferer-return-unit inferer))
        (EStructDefPlus
            _sd _extra
            (inferer-return-unit inferer))
        (EAliasDecl
            _name _target
            (inferer-return-unit inferer))
        (EDerive
            _type _traits
            (inferer-return-unit inferer))
        (EFfiCall
            _sym _args _timeout
            (infer-expr-ffi-call inferer expr))
        (EFfiPin
            e
            (infer-expr-ffi-pin inferer expr e))
        (EAssert
            cond _msg
            (infer-expr-assert inferer expr cond))
        (ESetBang
            target val
            (infer-expr-set-bang inferer expr target val))
        (EMakeStruct
            name fields
            (infer-expr-make-struct inferer expr name fields))
        (EStructGet
            se field_name
            (infer-expr-struct-get inferer expr se field_name))
        (EMakeVariant
            adt_name variant_name args
            (infer-expr-make-variant inferer expr adt_name variant_name args))
        (EPrint
            exprs
            (infer-expr-print inferer expr exprs))
        (EReadLine
            (inferer-return-string inferer))
        (EExit
            code
            (infer-expr-exit inferer expr code))
        (EClose
            resource
            (inferer-return-unit inferer))
        (EFileOpen
            path mode
            (inferer-return-int inferer))
        (EFileRead
            handle count
            (inferer-return-string inferer))
        (EFileWrite
            handle data
            (inferer-return-int inferer))
        (EFileClose
            handle
            (inferer-return-unit inferer))
        (EBufAppend
            dst src
            (inferer-return-int inferer))
        (ESpawn
            closure
            (infer-expr-spawn inferer expr closure))
        (ESend
            _actor msg
            (infer-expr-send inferer expr msg))
        (ESendClosure
            _actor closure _caps
            (inferer-return-unit inferer))
        (EWithResource
            _name init body
            (infer-expr-with-resource inferer expr init body))
        (ETestDecl
            _name _body _kind
            (inferer-return-unit inferer))
        (ETestSuite
            _name _tests _kind
            (inferer-return-unit inferer))
        (ERunTests
            _name
            (inferer-return-unit inferer))
        (ETestCompile
            _expr _kind
            (inferer-return-unit inferer))
        (EAssertEqual
            _l _r
            (inferer-return-unit inferer))
        (EAssertTrue
            _e _msg
            (inferer-return-unit inferer))
        (EAssertFalse
            _e _msg
            (inferer-return-unit inferer))
        (EAssertFail
            _e _msg
            (inferer-return-unit inferer))
        (ETestProperty
            _name _desc _body
            (inferer-return-unit inferer))
        (EModuleDecl
            _name
            (inferer-return-unit inferer))
        (EUseModule
            _name _path _alias
            (inferer-return-unit inferer))
        (EExport
            _name
            (inferer-return-unit inferer))
        (EMacroDef
            _name _params _body
            (inferer-return-unit inferer))
        (ESetup
            _exprs
            (inferer-return-unit inferer))
        (ETeardown
            _exprs
            (inferer-return-unit inferer))
        (EError
            _msg
            (inferer-return-unit inferer))
        (d11
            (inferer-return-var inferer))))

; ===========================================================================
; INFER-EXPR — primitive return helpers
; ===========================================================================

(defn inferer-return-int (inferer) TInt)
(defn inferer-return-float (inferer) TFloat)
(defn inferer-return-bool (inferer) TBool)
(defn inferer-return-string (inferer) TString)
(defn inferer-return-unit (inferer) TUnit)

(defn inferer-return-var (inferer)
    ; fresh TVar with default inner ref type Unit
    (let
        (pair (fresh-var inferer))
        (TVar
            (fst pair)
            TUnit)))

(defn is-primitive-ident (name)
    ; primitive type names stand alone in expression position
    (is-primitive-type-name name))

(defn inferer-return-prim (inferer name)
    (if (is-primitive-type-name name) (prim-type-from-name name) (inferer-return-var inferer)))

; ===========================================================================
; INFER-EXPR — identifier lookup
; ===========================================================================

(defn infer-expr-ident (inferer expr name)
    ; look up name in env; apply subst if found
    (let
        (env (ti-env inferer))
        (match
            (env-get env name)
            (Some typ (inferer-return-applied inferer typ))
            (None (infer-expr-ident-fallback inferer expr name)))))

(defn infer-expr-ident-fallback (inferer expr name)
    ; unresolved identifier: primitive names are concrete, else fresh var
    (if (is-primitive-type-name name) (prim-type-from-name name) (inferer-return-var inferer)))

(defn inferer-return-applied (inferer typ)
    (subst-apply (ti-subst inferer) typ))

; ===========================================================================
; INFER-EXPR — let
; ===========================================================================

(defn infer-expr-let (inferer expr name val body)
    ; infer value type, bind name, infer body in extended env
    (let
        (vt (infer-expr inferer val))
        (let
            (new-env (env-bind (ti-env inferer) name vt))
            (infer-expr
                (TypeInferer
                    new-env
                    (ti-subst inferer)
                    (ti-next inferer)
                    (ti-known-types inferer)
                    (ti-known-fns inferer)
                    (ti-func-returns inferer)
                    (ti-adt-defs inferer)
                    (ti-variant-to-adt inferer)
                    (ti-string-match-vars inferer)
                    (ti-inferring-fns inferer)
                    (ti-body-cache inferer))
                body))))

; ===========================================================================
; INFER-EXPR — if
; ===========================================================================

(defn infer-expr-if (inferer expr cond then- else-)
    ; unify cond with Bool; result type is then/else (skip-aware)
    (let
        (ct (infer-expr inferer cond))
        (let
            (unified (unify (ti-subst inferer) ct TBool))
            (match unified
                (UOk
                    new-s
                    (let
                        (tt (infer-expr inferer then-))
                        (let
                            (et (infer-expr inferer else-))
                            (if
                                (is-skip-placeholder else-)
                                tt
                                (match
                                    (unify
                                        new-s
                                        (subst-apply new-s tt)
                                        et)
                                    (UOk d12 tt)
                                    (UErr d13 tt))))))
                (UErr
                    d14
                    (inferer-return-var inferer))))))

; ===========================================================================
; INFER-EXPR — begin
; ===========================================================================

(defn infer-expr-begin (inferer expr stmts)
    ; sequence: value is last stmt; empty -> Unit; single -> that stmt
    (if
        (nil? stmts)
        TUnit
        (if
            (= (list-length stmts) 1)
            (infer-expr inferer (fst stmts))
            (let
                (d1 (infer-expr-stmt-chain inferer stmts))
                (infer-expr inferer (list-last stmts))))))

(defn infer-expr-stmt-chain (inferer stmts)
    ; infer all but last; result discarded
    ;
    ; The two body statements below MUST stay wrapped in one `begin`: an
    ; arm shaped `((Cons h t) stmt1 stmt2)` (nested-pattern head followed by
    ; TWO bare trailing forms) matches the parser's "((RB n r esc) rest
    ; body)" Cons-sugar heuristic (decompose_match_arm, ast.rs) whenever
    ; there are 2+ trailing forms — it reinterprets stmt1 as a second
    ; pattern-binding and stmt2 as the real body, silently losing stmt1 and
    ; corrupting the arm (confirmed: `t` came out as a null pointer at
    ; runtime, "unreachable case"-free but plain SIGSEGV). One `begin` form
    ; keeps the trailing-forms count at 1 and avoids the ambiguity.
    (match stmts
        (Nil
            nil)
        ((Cons h t)
            (begin
                (infer-expr inferer h)
                (infer-expr-stmt-chain inferer t)))))

; ===========================================================================
; INFER-EXPR — lambda/fn
; ===========================================================================

(defn infer-expr-lambda (inferer expr params body)
    ; lambda: bind params to fresh vars, infer body, result TFun
    (let
        (new-inferer (inferer-bind-params inferer params))
        (let
            (rt (infer-expr new-inferer body))
            (TFun
                (inferer-params-types params)
                rt))))

(defn inferer-bind-params (inferer params)
    ; bind each param name to a fresh type var
    (match params
        (Nil
            inferer)
        ((Cons p rest)
            (let
                (env
                    (env-bind
                        (ti-env inferer)
                        (typed-param-name p)
                        (inferer-return-var inferer)))
                (inferer-bind-params
                    (TypeInferer
                        env
                        (ti-subst inferer)
                        (ti-next inferer)
                        (ti-known-types inferer)
                        (ti-known-fns inferer)
                        (ti-func-returns inferer)
                        (ti-adt-defs inferer)
                        (ti-variant-to-adt inferer)
                        (ti-string-match-vars inferer)
                        (ti-inferring-fns inferer)
                        (ti-body-cache inferer))
                    rest)))))

(defn inferer-params-types (params)
    ; one TVar per param (placeholder; refined later). TVar is a 2-field
    ; constructor (Int Type) — a bare `TVar` with no args isn't a value at
    ; all; it fell through to whatever garbage happened to occupy the
    ; hash-fallback stack slot for an unrecognized identifier.
    (match params
        (Nil
            Nil)
        ((Cons p rest)
            (Cons
                (TVar 0 TUnit)
                (inferer-params-types rest)))))

(defn typed-param-name (p)
    ; Param's real constructor is `P` (declared in expr_inner.zyl) — "Param"
    ; is only the TYPE name, never a variant, so this never matched.
    (match p
        (P
            n t
            n)
        (d1 "___")))

; ===========================================================================
; INFER-EXPR — while
; ===========================================================================

(defn infer-expr-while (inferer expr cond body)
    ; unify cond with Bool, infer body, result Unit
    ;
    ; Wrapped-form `let` — `(let (name val) body)` — takes exactly ONE
    ; body expression (matches Rust bootstrap's parser.rs p_let: the
    ; wrapped-binding-list branch always uses `args[1]` alone, with no
    ; implicit multi-statement sequencing). Every extra trailing form
    ; after the first was silently DISCARDED — never parsed, never
    ; executed — so this used to return unify's UOk/UErr result instead
    ; of TUnit, and never actually type-checked `body` at all. Wrapping
    ; the real multi-statement sequence in `begin` makes it one body
    ; expression again.
    (let
        (ct (infer-expr inferer cond))
        (begin
            (unify (ti-subst inferer) ct TBool)
            (infer-expr inferer body)
            TUnit)))

; ===========================================================================
; INFER-EXPR — for
; ===========================================================================

(defn infer-expr-for (inferer expr bindings cond body)
    ; bind loop vars, unify cond with Bool, infer body, result Unit
    ; (see infer-expr-while: wrapped-let takes exactly one body expr)
    (let
        (new-inferer (inferer-bind-for-vars inferer bindings))
        (let
            (ct (infer-expr new-inferer cond))
            (begin
                (unify (ti-subst new-inferer) ct TBool)
                (infer-expr new-inferer body)
                TUnit))))

; `val` is `(Option Expr)`, not `Expr` — a for-binding's init is optional
; (`(for (i) cond body)` with no init is valid surface syntax even
; though nothing in this corpus omits one). Calling infer-expr directly
; on the Option itself — its unfixed original form — fed infer-expr a
; value whose runtime shape doesn't match what it pattern-matches on
; (Expr.inner), and self-hosted codegen's miscompilation of that
; mismatch crashed unpredictably depending on unrelated surrounding
; code (observed: identical `for` loop crashed or not purely based on
; whether the enclosing binding used `let` vs `let-mut`, though both
; lower to the same ILet — the difference must be upstream, in
; whichever type-inference path each one exercises for a sibling `for`).
(defn infer-for-binding-type (inferer val-opt)
    (match val-opt
        (Some e (infer-expr inferer e))
        (None TInt)))

(defn inferer-bind-for-vars (inferer (bindings List))
    ; bind each (name val) pair to TCap TMut of val's type
    (match bindings
        (Nil
            inferer)
        (Cons pair rest
            (match pair
                (Pair name val
                    (let
                        (vt (infer-for-binding-type inferer val))
                        (let
                            (new-env
                                (env-bind
                                    (ti-env inferer)
                                    name
                                    (TCap TCMut vt)))
                            (inferer-bind-for-vars
                                (TypeInferer
                                    new-env
                                    (ti-subst inferer)
                                    (ti-next inferer)
                                    (ti-known-types inferer)
                                    (ti-known-fns inferer)
                                    (ti-func-returns inferer)
                                    (ti-adt-defs inferer)
                                    (ti-variant-to-adt inferer)
                                    (ti-string-match-vars inferer)
                                    (ti-inferring-fns inferer)
                                    (ti-body-cache inferer))
                                rest))))))))

; ===========================================================================
; INFER-EXPR — cond
; ===========================================================================

(defn infer-expr-cond (inferer expr clauses)
    ; infer each clause, unify pred with Bool; result is last body type
    (infer-expr-cond-loop inferer clauses TUnit))

(defn infer-expr-cond-loop (inferer clauses rt)
    (match clauses
        (Nil
            rt)
        (Cons clause rest
            (match clause
                (Pair pred body
                    (let
                        (pt (infer-expr inferer pred))
                        (begin
                        (unify (ti-subst inferer) pt TBool)
                        (let
                            (bt (infer-expr inferer body))
                            (infer-expr-cond-loop inferer rest bt)))))))))

; ===========================================================================
; INFER-EXPR — try/catch
; ===========================================================================

(defn infer-expr-try-catch (inferer expr eh cn handler)
    ; result is the try-body type
    (let
        (et (infer-expr inferer eh))
        (begin
            (infer-expr inferer handler)
            et)))

; ===========================================================================
; INFER-EXPR — match
; ===========================================================================

(defn infer-expr-match (inferer expr subject arms)
    ; unify all arm body types under a shared subject type
    (let
        (subject-type (infer-expr inferer subject))
        (infer-expr-match-arms inferer arms subject-type TUnit)))

(defn infer-expr-match-arms (inferer arms subject-type first-type)
    (match arms
        (Nil
            first-type)
        ((Cons arm rest)
            (let
                ; TypeEnv is immutable (env-bind always returns a new chain
                ; without touching the original), so "snapshotting" it to
                ; restore before the next arm is just the value itself.
                ; `env-snapshot` here used to resolve — by cross-module name
                ; collision — to region_inference.zyl's OWN env-snapshot,
                ; built for the unrelated RegionEnv type; calling it on a
                ; TypeEnv value fed the wrong shape into RegionEnv's own
                ; RE.cur/RE.parens accessors.
                (arm-env (ti-env inferer))
                (let
                    (field-types (infer-lookup-arm-field-types inferer arm subject-type))
                    (let
                        (new-inferer (inferer-bind-pattern-vars inferer arm field-types))
                        (let
                            (abt (infer-expr new-inferer (MA.body arm)))
                            (let
                                (new-type
                                    (if
                                        (nil? first-type)
                                        abt
                                        (match
                                            (unify
                                                (ti-subst inferer)
                                                (subst-apply (ti-subst inferer) first-type)
                                                abt)
                                            (UOk d15 first-type)
                                            (UErr d16 abt))))
                                (let
                                    (rest-type
                                        (infer-expr-match-arms
                                            (TypeInferer
                                                arm-env
                                                (ti-subst new-inferer)
                                                (ti-next new-inferer)
                                                (ti-known-types new-inferer)
                                                (ti-known-fns new-inferer)
                                                (ti-func-returns new-inferer)
                                                (ti-adt-defs new-inferer)
                                                (ti-variant-to-adt new-inferer)
                                                (ti-string-match-vars new-inferer)
                                                (ti-inferring-fns new-inferer)
                                                (ti-body-cache new-inferer))
                                            rest
                                            subject-type
                                            new-type))
                                    rest-type)))))))))

(defn infer-lookup-arm-field-types (inferer arm subject-type)
    ; resolve field types for the variant a pattern names, mirroring Rust's
    ; adt_field_types(scrutinee_adt, arm.variant) with the scrutinee ADT
    ; resolved from the subject's nominal type through substitutions.
    (let
        (adt-name (infer-lookup-scrutinee-adt inferer subject-type))
        (infer-lookup-variant-fields inferer adt-name (MA.variant arm))))

(defn infer-lookup-scrutinee-adt (inferer subject-type)
    ; nominal type name of the scrutinee, mono-suffix stripped
    (match
        (resolve-nominal (ti-subst inferer) subject-type)
        (Some
            n
            (if
                (infer-adt-exists (ti-adt-defs inferer) n)
                n
                (infer-strip-mono-suffix n)))
        (None
            "")))

(defn resolve-nominal (subst t)
    ; mirror Rust resolve_nominal: apply the substitution then, if the
    ; resolved type is nominal (TStruct), return its name; else None.
    (match
        (subst-apply subst t)
        (TStruct n d17 (Some n))
        (d1 None)))

(defn str-index-of-char (s c i)
    (if
        (>= i (str-length s))
        -1
        (if
            (= (str-substring s i 1) c)
            i
            (str-index-of-char s c (+ i 1)))))

(defn infer-strip-mono-suffix (name)
    ; strip monomorphization "_instantiation" suffix
    (let
        (idx (str-index-of-char name "_" 0))
        (if
            (>= idx 0)
            (str-substring name 0 idx)
            name)))

(defn infer-lookup-variant-fields (inferer adt-name variant-name)
    ; walk the inferer's ADT defs; return the named variant's fields or Nil
    (match
        (lookup-adt-def inferer adt-name)
        (Nil
            Nil)
        (variants
            (infer-find-variant-fields variants variant-name))))

(defn infer-find-variant-fields (variants variant-name)
    ; walk a (List Variant); return the named variant's fields or Nil.
    ; Same Cons-cell nested-head-plus-tail-binding bug fixed elsewhere.
    (match variants
        (Nil
            Nil)
        (Cons hd rest
            (match hd
                (V n fields
                    (if
                        (= n variant-name)
                        fields
                        (infer-find-variant-fields rest variant-name)))))))

(defn inferer-bind-pattern-vars (inferer arm field-types)
    ; bind pattern vars to their field types; recurse over remaining fields
    (inferer-bind-pattern-vars-loop inferer (MA.patterns arm) field-types))

(defn inferer-bind-pattern-vars-loop (inferer patterns field-types)
    ; walk patterns/field-types in lockstep without wrapping both lists in
    ; one Pair match — a Pair nested-matching two DIFFERENT monomorphized
    ; List element types (List Expr, List FieldType) in the same match
    ; corrupted codegen (only one side's Cons/Nil dispatch worked); plain
    ; sequential matches on each list sidestep the collision entirely.
    (match patterns
        (Nil inferer)
        ((Cons pat prest)
            (match field-types
                (Nil inferer)
                ((Cons ft frest)
                    (inferer-bind-pattern-vars-step inferer pat ft prest frest))))))

(defn inferer-bind-pattern-vars-step (inferer pat ft prest frest)
    ; split out of inferer-bind-pattern-vars-loop as its own function.
    ; Uses the EXPLICIT two-level match (bind `atom` first, then match on
    ; it) instead of the nested-pattern sugar `(EAtom (AIdent name) ...)` —
    ; that sugar is desugared by the Rust bootstrap into a synthetic-var
    ; wrapper match, and THAT path lost `name`'s stack slot entirely
    ; (MakeVariant field load of `name` had no local slot) even though the
    ; explicit two-level style — the same shape infer-expr already uses
    ; successfully — binds it fine.
    (match (Expr.inner pat)
        (EAtom atom
            (inferer-bind-pattern-vars-atom inferer atom ft prest frest))
        (d1 (inferer-bind-pattern-vars-loop inferer prest frest))))

(defn inferer-bind-pattern-vars-atom (inferer atom ft prest frest)
    (match atom
        (AIdent name
            (let
                (pt (infer-lookup-pattern-type inferer ft))
                (let
                    (new-inferer
                        (TypeInferer
                            (env-bind (ti-env inferer) name pt)
                            (ti-subst inferer)
                            (ti-next inferer)
                            (ti-known-types inferer)
                            (ti-known-fns inferer)
                            (ti-func-returns inferer)
                            (ti-adt-defs inferer)
                            (ti-variant-to-adt inferer)
                            (if
                                (string-type-pt pt)
                                (Cons name (ti-string-match-vars inferer))
                                (ti-string-match-vars inferer))
                            (ti-inferring-fns inferer)
                            (ti-body-cache inferer)))
                    (inferer-bind-pattern-vars-loop new-inferer prest frest))))
        (d2 (inferer-bind-pattern-vars-loop inferer prest frest))))

(defn infer-lookup-pattern-type (inferer field-type)
    (if (is-primitive-type-name field-type) (prim-type-from-name field-type) (inferer-return-var inferer)))

(defn string-type-pt (pt)
    (= pt TString))

(defn infer-adt-exists (adt-defs name)
    ; does an ADT def with this name exist?
    (match adt-defs
        (Nil false)
        (Cons def rest
            (match def
                (AD n d19
                    (if (= n name) true (infer-adt-exists rest name)))))))

; ===========================================================================
; INFER-EXPR — call (raw Call form)
; ===========================================================================

(defn infer-expr-call (inferer expr op args)
    ; dispatch builtin operator vs user function call
    (match (Expr.inner op)
        (EAtom atom
            (match atom
                (AIdent op-name
                    (if
                        (is-builtin-binop op-name)
                        (infer-expr-builtin-binop inferer expr op-name args)
                        (if
                            (is-builtin-unop op-name)
                            (infer-expr-builtin-unop inferer expr op-name args)
                            (if
                                (is-builtin-conv op-name)
                                (infer-expr-builtin-conv inferer expr op-name args)
                                (if
                                    (is-builtin-compare op-name)
                                    (infer-expr-builtin-compare inferer expr op-name args)
                                    (if
                                        (is-builtin-io op-name)
                                        (infer-expr-builtin-io inferer expr op-name args)
                                        (infer-expr-call-fn inferer expr op-name args)))))))
                (d21 (infer-expr-call-fn inferer expr "___unknown" args))))
        (d20
            (infer-expr-call-fn inferer expr "___unknown" args))))

(defn is-builtin-binop (name)
    (or (= name "+") (or (= name "-") (or (= name "*") (= name "/")))))

(defn is-builtin-unop (name)
    (or (= name "not") (or (= name "and") (= name "or"))))

(defn is-builtin-compare (name)
    (or (= name "==") (or (= name "!=") (or (= name "<") (or (= name ">") (or (= name "<=") (= name ">=")))))))

(defn is-builtin-conv (name)
    (or (= name "str") (or (= name "int") (= name "float"))))

(defn is-builtin-io (name)
    (or (= name "print")
      (or (= name "read-line")
        (or (= name "exit")
          (or (= name "close")
            (or (= name "file-open")
              (or (= name "file-read")
                (or (= name "file-write")
                  (or (= name "file-close")
                    (or (= name "is-some")
                      (or (= name "is-none")
                        (or (= name "is-ok") (= name "is-err")))))))))))))

(defn infer-expr-builtin-binop (inferer expr op-name args)
    ; infer arg types; result Float if any Float else Int (or var)
    (let
        (has-float false)
        (let
            (all-vars true)
            (let
                (types (infer-args inferer args))
                (begin
                    (infer-binop-check-types types)
                    (if
                        has-float
                        TFloat
                        (if
                            all-vars
                            (inferer-return-var inferer)
                            TInt)))))))

(defn infer-binop-check-types (types)
    ; walk arg types, tracking float/var flags (via side effects, simplified)
    (match types
        (Nil
            nil)
        ((Cons t rest)
            (begin
                (infer-binop-check-one t)
                (infer-binop-check-types rest)))))

(defn infer-binop-check-one (t)
    (match t
        (TInt nil)
        (TFloat (let (d1 false) nil))
        (TVar d21 d22 nil)
        (d1 nil)))

(defn infer-expr-builtin-unop (inferer expr op-name args)
    ; unary ops: args must unify with Bool, result Bool
    (infer-args-bool-check inferer args)
    TBool)

(defn infer-args-bool-check (inferer args)
    (match args
        (Nil
            nil)
        ((Cons a rest)
            (let
                (t (infer-expr inferer a))
                (begin
                    (unify (ti-subst inferer) t TBool)
                    (infer-args-bool-check inferer rest))))))

(defn infer-expr-builtin-compare (inferer expr op-name args)
    (infer-args inferer args)
    TBool)

(defn infer-expr-builtin-conv (inferer expr op-name args)
    (infer-args inferer args)
    (if (= op-name "int") TInt
        (if (= op-name "float") TFloat
            (if (= op-name "str") TString
                (TVar 0 TUnit)))))

(defn infer-expr-builtin-io (inferer expr op-name args)
    (infer-args inferer args)
    (if (= op-name "print") TInt
        (if (= op-name "read-line") TString
            (if (= op-name "exit") TUnit
                (if (= op-name "close") TUnit
                    (if (= op-name "file-open") TInt
                        (if (= op-name "file-read") TString
                            (if (= op-name "file-write") TInt
                                (if (= op-name "file-close") TUnit
                                    (if (= op-name "is-some") TBool
                                        (if (= op-name "is-none") TBool
                                            (if (= op-name "is-ok") TBool
                                                (if (= op-name "is-err") TBool
                                                    TUnit)))))))))))))

(defn infer-expr-call-fn (inferer expr op-name args)
    ; register fn return placeholder, infer args, return its type
    (match
        (lookup-fn-ret
            (TypeInferer
                (ti-env inferer)
                (ti-subst inferer)
                (ti-next inferer)
                (ti-known-types inferer)
                (ti-known-fns inferer)
                (Cons
                    (FR
                        op-name
                        (inferer-return-var inferer))
                    (ti-func-returns inferer))
                (ti-adt-defs inferer)
                (ti-variant-to-adt inferer)
                (ti-string-match-vars inferer)
                (ti-inferring-fns inferer)
                (ti-body-cache inferer))
            op-name)
        ; parse-match-arm has no arity info at parse time, so anything
        ; after a variant's declared fields is taken as MORE pattern
        ; fields, not further body statements — a bare
        ; "(Some ret (infer-args inferer args) ret)" arm here silently
        ; misparsed "(infer-args inferer args)" as a second, bogus
        ; pattern field on a 1-field variant (and similarly for None's
        ; 0 fields), which old bind-names quietly bound to "" and
        ; ic-arm's nested-pattern support (see icnf.zyl) now tries to
        ; genuinely destructure as a constructor pattern, crashing —
        ; either way the infer-args call never actually ran. Wrap
        ; explicitly in begin so each arm has exactly its real field
        ; count and one body expression, matching every other
        ; multi-statement fix in this session (let/while/defn bodies).
        (Some
            ret
            (begin (infer-args inferer args) ret))
        (None
            (begin (infer-args inferer args) (inferer-return-var inferer)))))

; ===========================================================================
; INFER-EXPR — apply (Apply form)
; ===========================================================================

(defn infer-expr-apply (inferer expr name args)
    ; Apply form lowers to a Call on an Ident
    (infer-expr-call
        inferer
        expr
        (Expr (EAtom (AIdent name)))
        args))

; ===========================================================================
; INFER-EXPR — ffi
; ===========================================================================

(defn infer-expr-ffi-call (inferer expr)
    (TCap
        TCBox
        (inferer-return-var inferer)))

(defn infer-expr-ffi-pin (inferer expr e)
    (let
        (t (infer-expr inferer e))
        (TCap
            TCPin
            t)))

; ===========================================================================
; INFER-EXPR — assert
; ===========================================================================

(defn infer-expr-assert (inferer expr cond)
    ; unify cond with Bool, result Unit
    (let
        (ct (infer-expr inferer cond))
        (begin
            (unify (ti-subst inferer) ct TBool)
            TUnit)))

; ===========================================================================
; INFER-EXPR — set!
; ===========================================================================

(defn infer-expr-set-bang (inferer expr target val)
    ; target must be a TMut binding; result Unit. Was
    ; `(Some (TCap TCMut d23) TUnit)` — nested field position (same
    ; missing-desugaring issue fixed elsewhere this session).
    (let
        (vt (infer-expr inferer val))
        (match
            (env-get (ti-env inferer) target)
            (Some tv (infer-expr-set-bang-check inferer tv))
            (None (inferer-return-var inferer))
            (d1 (inferer-return-var inferer)))))

(defn infer-expr-set-bang-check (inferer tv)
    (match tv
        (TCap kind d23
            (match kind
                (TCMut TUnit)
                (d24 (inferer-return-var inferer))))
        (d25 (inferer-return-var inferer))))

; ===========================================================================
; INFER-EXPR — make-struct
; ===========================================================================

(defn infer-expr-make-struct (inferer expr name fields)
    (infer-args inferer fields)
    (TStruct name Nil))

; ===========================================================================
; INFER-EXPR — struct-get
; ===========================================================================

(defn infer-expr-struct-get (inferer expr se field-name)
    (let
        (st (infer-expr inferer se))
        (begin
            (infer-struct-field-type st field-name)
            (inferer-return-var inferer))))

(defn infer-struct-field-type (struct-type field-name)
    (match struct-type
        (TStruct n d24 nil)
        (d1 nil)))

; ===========================================================================
; INFER-EXPR — make-variant
; ===========================================================================

(defn infer-expr-make-variant (inferer expr adt-name variant-name args)
    (let
        (field-types (infer-get-variant-fields inferer adt-name variant-name))
        (begin
            (infer-args inferer args)
            (infer-variant-record-instantiation inferer adt-name field-types)
            (TStruct
                (str-concat adt-name (str-concat "_" variant-name))
                field-types))))

(defn infer-get-variant-fields (inferer adt-name variant-name)
    ; variant fields of the named variant from the real ADT defs, or Nil
    (infer-lookup-variant-fields inferer adt-name variant-name))

; Was meant to "register the variant's fields into the ADT def table", but:
; (a) it referenced `variant-name`, which isn't one of this function's
;     parameters (an undefined identifier — silently compiles to 0);
; (b) it spliced the WHOLE TypeInferer that insert-adt-def returns into the
;     ti-adt-defs FIELD SLOT of another TypeInferer, instead of using it as
;     the return value — a type confusion that corrupts every other field
;     read through that fake "ti-adt-defs" list later (this crashed the
;     self-hosted compiler chasing what looked like a list but was really
;     another TypeInferer's fields).
; ADT definitions are already collected up front by collect-definitions
; before expression-level inference ever runs, and this function's result
; was discarded by its only caller (infer-expr-make-variant) regardless, so
; there is nothing left for it to usefully do here.
(defn infer-variant-record-instantiation (inferer adt-name field-types)
    inferer)

; ===========================================================================
; INFER-EXPR — print
; ===========================================================================

(defn infer-expr-print (inferer expr exprs)
    (infer-args inferer exprs)
    TInt)

; ===========================================================================
; INFER-EXPR — exit
; ===========================================================================

(defn infer-expr-exit (inferer expr code)
    (infer-expr inferer code)
    TUnit)

; ===========================================================================
; INFER-EXPR — spawn
; ===========================================================================

(defn infer-expr-spawn (inferer expr closure)
    (infer-expr inferer closure)
    TInt)

; ===========================================================================
; INFER-EXPR — send
; ===========================================================================

(defn infer-expr-send (inferer expr msg)
    (infer-expr inferer msg)
    TInt)

; ===========================================================================
; INFER-EXPR — with-resource
; ===========================================================================

(defn infer-expr-with-resource (inferer expr init body)
    (let
        (it (infer-expr inferer init))
        (begin
            (infer-expr inferer body)
            it)))

; ===========================================================================
; INFER-ARGS — helper
; ===========================================================================

(defn infer-args (inferer args)
    ; infer type of each arg in order, collecting the results into a list.
    ; A match arm body with 2+ bare trailing forms (no `begin`/`let`
    ; wrapper) is misparsed as the parser's Cons-nested-pattern sugar (see
    ; infer-expr-stmt-chain's comment above) — the old body here had
    ; exactly that shape (two bare statements) and also never actually
    ; collected a types list despite callers like infer-expr-builtin-binop
    ; expecting one back.
    (match args
        (Nil
            Nil)
        ((Cons a rest)
            (Cons (infer-expr inferer a) (infer-args inferer rest)))))

; ===========================================================================
; COLLECT DEFINITIONS — the declared "Core" that was missing
; Port of Rust collect_definitions() — registers Defn/Deftype/StructDef
; forms in the inferer's known_functions, function_returns, adt_defs, etc.
; ===========================================================================

; Despite its own comment ("registers Defn/Deftype/StructDef forms"), this
; used to only match EDefn — EDeftype was never handled here at all, so
; ti-adt-defs stayed empty for the entire compile. A separate, correct
; `collect-adt-defs` function existed below to do exactly this, but nothing
; ever called it (driver.zyl only calls collect-definitions) — merged its
; EDeftype handling in directly instead of leaving it as unreachable code.
(defn collect-definitions (inferer exprs)
    (match exprs
        (Nil inferer)
        ((Cons expr rest)
            (match (Expr.inner expr)
                (EDefn name params body
                    (let (param-types (collect-defn-params inferer params))
                        (let (infered (infer-defn-body inferer name params param-types body))
                            (collect-definitions infered rest))))
                (EDeftype name variants generic-params d28
                    (collect-definitions (insert-adt-def inferer name variants) rest))
                (d1 (collect-definitions inferer rest))))))

(defn collect-defn-params (inferer params)
    ; extract param types from Defn params list
    (match params
        (Nil Nil)
        ((Cons p rest)
            (Cons
                (match p
                    (P name typ
                        (match typ
                            (Some t (type-from-display t))
                            (None (TVar 0 TUnit)))))
                (collect-defn-params inferer rest)))))

(defn infer-defn-body (inferer name params param-types body)
    ; infer body type and update inferer with function signature
    (let (param-bindings (zip-params params param-types))
        (let (inferred-type (infer-expr-body inferer body))
            (let (new-inferer (insert-fn-ret inferer name inferred-type))
                (let (new-inferer (insert-known-fn new-inferer name param-bindings))
                    new-inferer)))))

; ETryCatch (`try`/`catch`) has no lowering anywhere past parsing in this
; self-hosted pipeline — monomorphization.zyl's subst-expr, icnf.zyl's
; ic-expr, and codegen.zyl all silently discard it via their generic
; wildcard defaults (icnf.zyl's ic-expr comment: unsupported shapes lower
; to a harmless (IConst 0)). Wrapping infer-expr in a try/catch here
; (catch-error) made catch-error itself compile down to a bare "return 0"
; instead of ever running its body — the null was then dereferenced by
; the very next line, segfaulting. Type inference in this compiler is
; already best-effort (a genuine type error elsewhere already degrades to
; TUnit rather than aborting), so call infer-expr directly instead of
; through a try/catch this pipeline can't actually support.
(defn infer-expr-body (inferer body)
    (infer-expr inferer body))

(defn zip-params (params types)
    ; pair params with types — sequential matches, not a Pair-wrapped nested
    ; match (params/types are different monomorphized List element types,
    ; which corrupts codegen when nested inside one match; see
    ; inferer-bind-pattern-vars-loop)
    (match params
        (Nil Nil)
        ((Cons p rest-p)
            (match types
                (Nil Nil)
                ((Cons t rest-t)
                    (Cons (Pair p t) (zip-params rest-p rest-t)))))))


(defn collect-adt-defs (inferer exprs)
    ; collect ADT definitions from exprs
    (match exprs
        (Nil inferer)
        ((Cons expr rest)
            (let (updated (match
                               (Expr.inner expr)
                               (EDeftype name variants generic-params d28
                                   (insert-adt-def inferer name variants))
                               (d1 inferer)))
                (collect-adt-defs updated rest)))))

; ===========================================================================
; FINALIZE PARAM TYPES — resolves type vars when call-site evidence agrees
; ===========================================================================

(defn finalize-param-types (inferer)
    ; For each function in known_functions, look up its return type
    ; from function_returns and use call-site observations to resolve
    ; type vars in parameter types. This restores param types for
    ; downstream code (struct layouts, float detection, etc.)
    (let (known-fns (ti-known-fns inferer))
        (match
            known-fns
            (Nil inferer)
            (Cons hd rest
                (match hd
                    (FNS name params
                        (let (ret-type (lookup-fn-ret inferer name))
                            (let (resolved-params (resolve-param-types inferer params ret-type))
                                (let (new-inferer (finalize-param-types
                                                    (TypeInferer
                                                        (ti-env inferer)
                                                        (ti-subst inferer)
                                                        (ti-next inferer)
                                                        (ti-known-types inferer)
                                                        resolved-params
                                                        (ti-func-returns inferer)
                                                        (ti-adt-defs inferer)
                                                        (ti-variant-to-adt inferer)
                                                        (ti-string-match-vars inferer)
                                                        (ti-inferring-fns inferer)
                                                        (ti-body-cache inferer))))
                                    new-inferer)))))))))

(defn resolve-param-types (inferer params ret-type)
    ; resolve type vars in param types using return type evidence.
    ; `params` is a (List ParamType) — ParamType's real constructor is `PT`
    ; (String Type), not `FNS` (that's FnSig's own constructor, for a
    ; totally different list). Both happen to be single-variant types with
    ; 2 fields, so the wrong nested pattern still "matched" by coincidence,
    ; but bound "ptypes" to a lone Type value and then fed it to map-types
    ; as if it were a (List Type).
    (match
        params
        (Nil Nil)
        (Cons hd rest
            (match hd
                (PT name ptype
                    (Cons
                        (PT name (resolve-type-var inferer ptype ret-type))
                        (resolve-param-types inferer rest ret-type)))))))

(defn map-types (inferer types ret-type)
    ; apply return type inference to each param type
    (match
        types
        (Nil Nil)
        ((Cons t rest)
            (Cons
                (resolve-type-var inferer t ret-type)
                (map-types inferer rest ret-type)))))

(defn resolve-type-var (inferer type ret-type)
    ; resolve a type variable using return type as evidence
    (match
        type
        (TVar n inner
            (if (= n (var-index ret-type))
                ret-type
                type))
        (d1 type)))

(defn var-index (t)
    ; extract the type variable index from a TVar type
    (match
        t
        (TVar n inner n)
        (d1 -1)))

; ===========================================================================
; INFER PROGRAM — the entry point that ties it all together
; Port of Rust infer() — the main entry for type inference
; ===========================================================================

(defn infer-program (inferer exprs)
    ; full type inference pipeline:
    ; 1. collect definitions (register signatures)
    ; 2. infer each expression
    ; 3. finalize param types
    (let (collected (collect-definitions inferer exprs))
        (let (typed (infer-expressions collected exprs))
            (finalize-param-types typed))))

(defn infer-expressions (inferer exprs)
    ; infer type of each expression, return list of (expr . inferred-type) pairs
    (match
        exprs
        (Nil Nil)
        ((Cons expr rest)
            (if (is-def-only expr)
                (Cons (Pair expr (inferer-return-unit inferer))
                    (infer-expressions inferer rest))
                (let (inferred (infer-expr inferer expr))
                    (Cons (Pair expr inferred)
                        (infer-expressions inferer rest)))))))

(defn is-def-only (expr)
    ; check if expr is a definition-only form (no inferred type needed)
    (match
        (Expr.inner expr)
        (EDeftype d29 d30 d31 d32 true)
        (EStructDef d33 d33b true)
        (EStructDefPlus d34 d34b true)
        (d1 false)))
