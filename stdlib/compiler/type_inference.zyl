; === Zyl Type Inference Engine ===
; Port of Rust type_inference.rs (~2752 loc) to Zyl (~1200 loc)
; Core: infer_expr dispatch, collect_definitions, finalize_param_types
;
; FORMATTING: C-style block discipline — every open paren on its own line
; at the correct indent; every close paren on its own line aligned under
; its matching open. Indentation disambiguates nesting so paren balance is
; trivial to verify visually.

; ===========================================================================
; INFERENCE STATE — simplified from Rust (no RefCell/Cell)
;
; NOTE: The TypeInferer record and its support ADTs (FnSig, ParamType,
; FnReturn, AdtDef, Variant, Field, BodyCache, VarPair) are defined in
; stdlib/compiler/type_system.zyl — the single owner of all type-system
; ADTs. This file contains only the inference LOGIC.
; ===========================================================================

(defn fresh-var (inferer)
    ; return current next-index and bump-by-1
    (let
        (n (ti-next inferer))
        (Pair n (+ n 1))))

(defn update-next (inferer n)
    ; reconstruct inferer with new next-index, all else unchanged
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        n
        (ti-known-types inferer)
        (ti-known-fns inferer)
        (ti-func-returns inferer)
        (ti-adt-defs inferer)
        (ti-variant-to-adt inferer)
        (ti-string-match-vars inferer)
        (ti-inferring-fns inferer)
        (ti-body-cache inferer)
            Nil
            Nil
            Nil
            Nil
            Nil
            (tc-new)
            Nil
            Nil
            Nil)))

; ===========================================================================
; KNOWN TYPES HELPERS
; ===========================================================================

(defn lookup-known-type (inferer name)
    (lookup-known-type-binds (ti-known-types inferer) name))

(defn lookup-known-type-binds (binds name)
    ; was `((TB k v) rest body)` — the Cons-cell nested-head-plus-tail-
    ; binding sugar the self-hosted parser drops the tail binding for
    ; (only its simpler 2-element sibling form works); sequential
    ; matches sidestep it (same fix as type_system.zyl's *-binds helpers).
    (match binds
        (Nil None)
        (Cons hd rest
            (match hd
                (TB k v
                    (if
                        (= k name)
                        (Some v)
                        (lookup-known-type-binds rest name)))))))

(defn insert-known-type (inferer name typ)
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        (ti-next inferer)
        (Cons
            (TB name typ)
            (ti-known-types inferer))
        (ti-known-fns inferer)
        (ti-func-returns inferer)
        (ti-adt-defs inferer)
        (ti-variant-to-adt inferer)
        (ti-string-match-vars inferer)
        (ti-inferring-fns inferer)
        (ti-body-cache inferer)
            Nil
            Nil
            Nil
            Nil
            Nil
            (tc-new)
            Nil
            Nil
            Nil)))

; ===========================================================================
; KNOWN FUNCTIONS HELPERS
; ===========================================================================

(defn lookup-known-fn (inferer name)
    (lookup-fn-sigs-binds (ti-known-fns inferer) name))

(defn lookup-fn-sigs-binds (sigs name)
    ; same Cons-cell nested-head-plus-tail-binding bug as above.
    (match sigs
        (Nil Nil)
        (Cons hd rest
            (match hd
                (FNS n params
                    (if
                        (= n name)
                        params
                        (lookup-fn-sigs-binds rest name)))))))

(defn insert-known-fn (inferer name params)
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        (ti-next inferer)
        (ti-known-types inferer)
        (Cons
            (FNS name params)
            (ti-known-fns inferer))
        (ti-func-returns inferer)
        (ti-adt-defs inferer)
        (ti-variant-to-adt inferer)
        (ti-string-match-vars inferer)
        (ti-inferring-fns inferer)
        (ti-body-cache inferer)
            Nil
            Nil
            Nil
            Nil
            Nil
            (tc-new)
            Nil
            Nil
            Nil)))

; ===========================================================================
; FUNCTION RETURNS HELPERS
; ===========================================================================

(defn lookup-fn-ret (inferer name)
    (lookup-ret-binds (ti-func-returns inferer) name))

(defn lookup-ret-binds (binds name)
    ; same Cons-cell nested-head-plus-tail-binding bug as above.
    (match binds
        (Nil None)
        (Cons hd rest
            (match hd
                (FR k v
                    (if
                        (= k name)
                        (Some v)
                        (lookup-ret-binds rest name)))))))

(defn insert-fn-ret (inferer name typ)
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        (ti-next inferer)
        (ti-known-types inferer)
        (ti-known-fns inferer)
        (Cons
            (FR name typ)
            (ti-func-returns inferer))
        (ti-adt-defs inferer)
        (ti-variant-to-adt inferer)
        (ti-string-match-vars inferer)
        (ti-inferring-fns inferer)
        (ti-body-cache inferer)
            Nil
            Nil
            Nil
            Nil
            Nil
            (tc-new)
            Nil
            Nil
            Nil)))

; ===========================================================================
; ADT DEFINITIONS HELPERS
; ===========================================================================

(defn lookup-adt-def (inferer name)
    (lookup-adt-binds (ti-adt-defs inferer) name))

(defn lookup-adt-binds (binds name)
    ; same Cons-cell nested-head-plus-tail-binding bug as above.
    (match binds
        (Nil Nil)
        (Cons hd rest
            (match hd
                (AD n variants
                    (if
                        (= n name)
                        variants
                        (lookup-adt-binds rest name)))))))

(defn insert-adt-def (inferer name variants)
    ; Extract generic parameter names from variant fields in declaration order
    ; (first appearance across variants).
    (let (param-order (extract-generic-params variants))
        (let (with-adt (TypeInferer
            (ti-env inferer)
            (ti-subst inferer)
            (ti-next inferer)
            (ti-known-types inferer)
            (ti-known-fns inferer)
            (ti-func-returns inferer)
            (Cons
                (AD name variants)
                (ti-adt-defs inferer))
            (ti-variant-to-adt inferer)
            (ti-string-match-vars inferer)
            (ti-inferring-fns inferer)
            (ti-body-cache inferer)
            (ti-adt-param-order inferer)
            (ti-adt-instantiations inferer)
            (ti-arg-type-observations inferer)
            (ti-function-bodies inferer)
            (ti-skip-generic-def-names inferer)
            (tc-new)
            Nil
            Nil
            Nil)))
        (let (with-order (insert-adt-param-order with-adt name param-order))
            (populate-variant-to-adt with-order name variants)))))

(defn extract-generic-params (variants)
    ; Walk variants, collect generic param names (uppercase identifiers)
    ; in first-appearance order.
    (extract-generic-params-loop variants Nil))

(defn extract-generic-params-loop (variants acc)
    (match variants
        (Nil (list-reverse acc))
        (Cons v rest
            (match v
                (V name fields
                    (let (new-acc (extract-generic-fields fields acc))
                        (extract-generic-params-loop rest new-acc)))
                (d1 (extract-generic-params-loop rest acc))))))

(defn extract-generic-fields (fields acc)
    (match fields
        (Nil acc)
        (Cons f rest
            (match f
                (F fname ftype
                    (if (is-generic-param ftype)
                        (if (mem-string-list acc fname)
                            (extract-generic-fields rest acc)
                            (extract-generic-fields rest (Cons fname acc)))
                        (extract-generic-fields rest acc)))
                (d1 (extract-generic-fields rest acc))))))

(defn insert-adt-param-order (inferer name param-order)
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        (ti-next inferer)
        (ti-known-types inferer)
        (ti-known-fns inferer)
        (ti-func-returns inferer)
        (ti-adt-defs inferer)
        (ti-variant-to-adt inferer)
        (ti-string-match-vars inferer)
        (ti-inferring-fns inferer)
        (ti-body-cache inferer)
        (Cons
            (Pair name param-order)
            (ti-adt-param-order inferer))
        (ti-adt-instantiations inferer)
        (ti-arg-type-observations inferer)
        (ti-function-bodies inferer)
        (ti-skip-generic-def-names inferer)
        (tc-new)
        Nil
        Nil
        Nil)))

; ===========================================================================
; TRAIT / STRUCT / ALIAS HELPERS
; ===========================================================================

(defn insert-trait-decl (inferer trait_name methods derives)
    ; Register trait in trait context
    (let (trait_info (TI trait_name
        (method-params-from-methods methods)
        (method-rets-from-methods methods)))
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        (ti-next inferer)
        (ti-known-types inferer)
        (ti-known-fns inferer)
        (ti-func-returns inferer)
        (ti-adt-defs inferer)
        (ti-variant-to-adt inferer)
        (ti-string-match-vars inferer)
        (ti-inferring-fns inferer)
        (ti-body-cache inferer)
        (ti-adt-param-order inferer)
        (ti-adt-instantiations inferer)
        (ti-arg-type-observations inferer)
        (ti-function-bodies inferer)
        (ti-skip-generic-def-names inferer)
        (tc-register-trait (ti-trait-ctx inferer) trait_info)
        (ti-struct-defs inferer)
        (ti-generics-in-scope inferer)
        (ti-var-type-map inferer))))

(defn method-params-from-methods (methods)
    (match methods
        (Nil Nil)
        (Cons m rest
            (Cons
                (Pair (M.name m) (M.params m))
                (method-params-from-methods rest)))))

(defn method-rets-from-methods (methods)
    (match methods
        (Nil Nil)
        (Cons m rest
            (Cons
                (Pair (M.name m) (M.return_type m))
                (method-rets-from-methods rest)))))

(defn insert-impl-block (inferer trait_name type_name bodies)
    ; Register impl in trait context
    (let (impl_info (II trait_name (TNominal type_name) Nil))
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        (ti-next inferer)
        (ti-known-types inferer)
        (ti-known-fns inferer)
        (ti-func-returns inferer)
        (ti-adt-defs inferer)
        (ti-variant-to-adt inferer)
        (ti-string-match-vars inferer)
        (ti-inferring-fns inferer)
        (ti-body-cache inferer)
        (ti-adt-param-order inferer)
        (ti-adt-instantiations inferer)
        (ti-arg-type-observations inferer)
        (ti-function-bodies inferer)
        (ti-skip-generic-def-names inferer)
        (tc-register-impl (ti-trait-ctx inferer) impl_info)
        (ti-struct-defs inferer)
        (ti-generics-in-scope inferer)
        (ti-var-type-map inferer))))

(defn insert-struct-def (inferer sd)
    ; Register struct definition
    (let (typed_fields (struct-fields-to-typed sd))
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        (ti-next inferer)
        (ti-known-types inferer)
        (ti-known-fns inferer)
        (ti-func-returns inferer)
        (ti-adt-defs inferer)
        (ti-variant-to-adt inferer)
        (ti-string-match-vars inferer)
        (ti-inferring-fns inferer)
        (ti-body-cache inferer)
        (ti-adt-param-order inferer)
        (ti-adt-instantiations inferer)
        (ti-arg-type-observations inferer)
        (ti-function-bodies inferer)
        (ti-skip-generic-def-names inferer)
        (ti-trait-ctx inferer)
        (Cons (SD (SD.name sd) typed_fields) (ti-struct-defs inferer))
        (ti-generics-in-scope inferer)
        (ti-var-type-map inferer))))

(defn struct-fields-to-typed (sd)
    (match (SD.fields sd)
        (Nil Nil)
        (Cons f rest
            (Cons
                (Pair (SF.name f) (SF.type f))
                (struct-fields-to-typed rest)))))

(defn insert-alias-decl (inferer name target)
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        (ti-next inferer)
        (ti-known-types inferer)
        (ti-known-fns inferer)
        (ti-func-returns inferer)
        (ti-adt-defs inferer)
        (ti-variant-to-adt inferer)
        (ti-string-match-vars inferer)
        (ti-inferring-fns inferer)
        (ti-body-cache inferer)
        (ti-adt-param-order inferer)
        (ti-adt-instantiations inferer)
        (ti-arg-type-observations inferer)
        (ti-function-bodies inferer)
        (ti-skip-generic-def-names inferer)
        (ti-trait-ctx inferer)
        (ti-struct-defs inferer)
        (ti-generics-in-scope inferer)
        (ti-var-type-map inferer)))

(defn insert-derive (inferer type_name traits)
    ; For now just return inferer unchanged - derive is handled later
    inferer)

(defn lookup-adt-param-order (inferer name)
    (lookup-param-order-binds (ti-adt-param-order inferer) name))

(defn lookup-param-order-binds (binds name)
    (match binds
        (Nil Nil)
        (Cons hd rest
            (match hd
                (Pair k v
                    (if (= k name)
                        v
                        (lookup-param-order-binds rest name)))))))

(defn populate-variant-to-adt (inferer name variants)
    (match variants
        (Nil inferer)
        (Cons v rest
            (match v
                (V vname fields
                    (populate-variant-to-adt
                        (insert-variant-to-adt inferer vname name)
                        name
                        rest))
                (d1 (populate-variant-to-adt inferer name rest))))))

; ===========================================================================
; VARIANT -> ADT HELPERS
; ===========================================================================

(defn lookup-variant-to-adt (inferer variant)
    (lookup-vta-binds (ti-variant-to-adt inferer) variant))

(defn lookup-vta-binds (binds variant)
    ; same Cons-cell nested-head-plus-tail-binding bug as above.
    (match binds
        (Nil None)
        (Cons hd rest
            (match hd
                (TB k v
                    (if
                        (= k variant)
                        (Some v)
                        (lookup-vta-binds rest variant)))))))

(defn insert-variant-to-adt (inferer variant adt)
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        (ti-next inferer)
        (ti-known-types inferer)
        (ti-known-fns inferer)
        (ti-func-returns inferer)
        (ti-adt-defs inferer)
        (Cons
            (TB variant adt)
            (ti-variant-to-adt inferer))
        (ti-string-match-vars inferer)
        (ti-inferring-fns inferer)
        (ti-body-cache inferer)
        Nil
        Nil
        Nil
        Nil
        Nil
        (tc-new)
        Nil
        Nil
        Nil)))

; ===========================================================================
; BODY CACHE HELPERS
; ===========================================================================

(defn lookup-body-cache (inferer key)
    ; walk body-cache list, threading rest through a rebuilt inferer.
    ; Was `((BC k v) rest body)` — same Cons-cell nested-head-plus-tail-
    ; binding bug fixed throughout this file/type_system.zyl.
    (match
        (ti-body-cache inferer)
        (Nil None)
        (Cons hd rest
            (match hd
                (BC k v
                    (if
                        (= k key)
                        (Some v)
                        (lookup-body-cache
                            (TypeInferer
                                (ti-env inferer)
                                (ti-subst inferer)
                                (ti-next inferer)
                                (ti-known-types inferer)
                                (ti-known-fns inferer)
                                (ti-func-returns inferer)
                                (ti-adt-defs inferer)
                                (ti-variant-to-adt inferer)
                                (ti-string-match-vars inferer)
                                (ti-inferring-fns inferer)
                                rest)
                            key)))))))

(defn insert-body-cache (inferer key typ)
    (TypeInferer
        (ti-env inferer)
        (ti-subst inferer)
        (ti-next inferer)
        (ti-known-types inferer)
        (ti-known-fns inferer)
        (ti-func-returns inferer)
        (ti-adt-defs inferer)
        (ti-variant-to-adt inferer)
        (ti-string-match-vars inferer)
        (ti-inferring-fns inferer)
        (Cons
            (BC key typ)
            (ti-body-cache inferer))
        Nil
        Nil
        Nil
        Nil
        Nil
        (tc-new)
        Nil
        Nil
        Nil)))

