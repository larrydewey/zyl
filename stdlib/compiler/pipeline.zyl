; === Zyl Standard Library — Compiler pipeline ===
; Module: compiler/pipeline
;
; The one implementation of "source text in, lowered program out", used
; by every front end: the `zyl` CLI, the REPL, and anything else that
; needs the compiler's own phase order rather than an approximation of
; it. It lived inside selfhost/driver.zyl until the REPL needed the same
; pipeline stopped one phase earlier (at ICNF, for the interpreter)
; rather than run through to assembly.
;
; The split is exactly that: `compile-to-fns` runs every phase from the
; balance check through region inference and hands back the lowered
; functions; `compile-to-asm` is that plus code generation. No phase may
; depend on a later one, so there is nothing else to parameterize.
;
; Errors are reported the way the rest of the compiler reports them --
; `zyl_panic` with a located `error[CODE]` message -- which a caller
; that must survive them (the REPL) catches with `try`.

(use allocator/allocator)
(use compiler/ast)
(use compiler/expr_inner)
(use compiler/lexer)
(use compiler/parser)
(use compiler/module_resolver)
(use compiler/capability_check)
(use compiler/macro_expand)
(use compiler/mutability_check)
(use compiler/arity_check)
(use compiler/duplicate_check)
(use compiler/exhaustiveness_check)
(use compiler/unused_check)
(use compiler/secret_check)
(use compiler/lift_impls)
(use compiler/icnf)
(use compiler/closure_inline)
(use compiler/type_annotate)
(use compiler/derive)
(use compiler/region_inference)
(use compiler/optimization)
(use compiler/reuse)
(use compiler/codegen)
(use compiler/sexp_balance)
(use compiler/error_codes)
(use compiler/error_report)

; Stage tracing, off unless ZYL_DEBUG_STAGES is set. This used to append to
; /tmp/dbg unconditionally: a fixed path in a shared directory (on a
; multi-user machine the file belongs to whoever compiled first and every
; open after that fails), about twenty open/write/close cycles per compile,
; and a write nobody asked for. zyl_getenv returns 0 when the variable is
; unset.
(defn dbg-log (msg)
  (if (= (str-length (ffi-call "zyl_getenv_str" "ZYL_DEBUG_STAGES" 1000)) 0)
    0
    (dbg-write msg)))

(defn dbg-write (msg)
  (let f (file-open "/tmp/dbg" "a")
    (let _ (file-write f msg)
      (file-close f))))

; ===========================================================================
; FRONT END — source text to ExprInner, with every check run
; ===========================================================================

; Parse, resolve modules, expand macros, then run the checks that must
; precede type inference. Returns the checked ExprInner program.
(defn compile-to-exprs (arena srcbuf srcpath)
  (begin
    ; Field types recorded by the parse (type_annotate); none survive a compile.
    (field-types-clear)
    (dbg-log "balance-check\n")
    (compile-check-balance srcbuf srcpath)
    (dbg-log "parse\n")
    (let prog (zyl-parse-file arena srcbuf srcpath)
      (dbg-log "modules\n")
      ; Module resolution works on the RAW parse tree: it qualifies
      ; every identifier to a canonical key (spec v5.0 §31.2) before
      ; anything is converted to ExprInner, and it needs the source
      ; path to find the package this file belongs to (§31.3).
      (let resolved (mr-resolve-program-full arena prog srcpath)
        (dbg-log "macros\n")
        (let exprs (tc-resolve arena (me-expand-program (mrr-exprs resolved)) resolved)
          (begin
            (compile-run-checks exprs resolved)
            exprs))))))

;; --- test-compile (spec 20.5.6) ----------------------------------------------
; Each top-level (test-compile e) is decided before the checks: a probe, the
; program with e as (defn zyl-test-compile-probe () e) and no other
; test-compile, runs the checks and the type checker with its diagnostics
; captured. The form becomes a test that passes when e compiled or failed
; as expected; a failing one reports the reason. A nested one is
; E_MALFORMED_FORM (arity_check.zyl).
(defn tc-resolve (arena exprs resolved)
  (if (tc-any exprs) (tc-map arena exprs exprs resolved 0) exprs))

(defn tc-any (xs)
  (match xs (Nil false) (Cons e t (match (Expr.inner e) (ETestCompile _ _ true) (_ (tc-any t))))))

(defn tc-map (arena all xs resolved (i Int))
  (match xs
    (Nil Nil)
    (Cons e t
      (Cons (match (Expr.inner e) (ETestCompile x b (tc-decide arena all i x b e resolved)) (_ e))
            (tc-map arena all t resolved (+ i 1))))))

(defn tc-probe (xs (i Int) (j Int) x)
  (match xs
    (Nil Nil)
    (Cons e t
      (if (= j i) (Cons (Expr (EDefn "zyl-test-compile-probe" Nil x)) (tc-probe t i (+ j 1) x))
        (match (Expr.inner e)
          (ETestCompile _ _ (tc-probe t i (+ j 1) x))
          (_ (Cons e (tc-probe t i (+ j 1) x))))))))

; "" when the probe compiles, else its first error line.
(defn tc-run (arena probe resolved)
  (let _ (ffi-call "zyl_warn_capture" true 1000)
    (let r (try (begin (compile-run-checks probe resolved)
                       (let _ (ta-annotate (ci-expand-program arena (lift-impls (dv-expand-program probe)))) ""))
                (catch err err))
      (let w (ffi-call "zyl_warn_take" 1000)
        (let _ (ffi-call "zyl_warn_capture" false 1000)
          (if (= (str-length r) 0) ""
            (let fw (tc-error-line w 0 (str-length w))
              (if (> (str-length fw) 0) fw (tc-error-line r 0 (str-length r))))))))))

; The first line of s holding "error[", from that point, else "".
(defn tc-error-line ((s String) (i Int) (n Int))
  (if (> (+ i 6) n) ""
    (if (str-eq (str-substring s i 6) "error[") (str-substring s i (- (tc-line-end s i n) i))
      (tc-error-line s (+ i 1) n))))

(defn tc-line-end ((s String) (i Int) (n Int))
  (if (>= i n) n (if (str-eq (str-substring s i 1) "\n") i (tc-line-end s (+ i 1) n))))

(defn tc-decide (arena all (i Int) x (expect Bool) e resolved)
  (let err (tc-run arena (tc-probe all i 0 x) resolved)
    (let compiled (= (str-length err) 0)
      (let base (str-concat "test-compile line " (ffi-call "zyl_int_text"
                  (ffi-call "zyl_span_line" (ffi-call "zyl_span_file" e 1000) (ffi-call "zyl_span_off" e 1000) 1000) 1000))
        (if (= compiled (not expect))
          (Expr (ETestDecl base (Expr (EAtom ANil)) false None))
          (Expr (ETestDecl base
                           (Expr (EAssertTrue (Expr (EAtom (ABool false)))
                                               (Some (if compiled "compiled, but an error was expected"
                                                        (str-concat "did not compile: " err)))))
                           false
                           None)))))))

; A file whose delimiters do not balance is reported here rather than
; left for the parser: the balance checker knows which opener was never
; closed and where, and the parser only knows that it ran out of input.
(defn compile-check-balance (srcbuf srcpath)
  (let _ (check-no-nul srcpath srcbuf)
  (let balance (sb-check-string srcbuf)
    (if (not (sb-result-balanced balance))
      ; Register the path first so report-unbalanced can name the file and
      ; print the offending line. zyl_source_register dedupes by path, so
      ; this is the same id zyl-parse-file goes on to use.
      (report-unbalanced balance (ffi-call "zyl_source_register" srcpath srcbuf 1000))
      0))))

; §31.9: capability enforcement runs after module resolution and before
; type inference. It sits after macro expansion so that a construct a
; macro introduces is checked like one written by hand.
(defn compile-run-checks (exprs resolved)
  (begin
    (dbg-log "capability-check\n")
    (cc-check-program exprs (mrr-grants resolved) (mrr-denied resolved))
    (dbg-log "duplicate-check\n")
    (dc-check-program exprs)
    (dbg-log "arity-check\n")
    (ac-check-program exprs)
    (dbg-log "mutability-check\n")
    (mc-check-program exprs)
    (dbg-log "exhaustiveness-check\n")
    (ec-check-program exprs)
    (dbg-log "unused-check\n")
    (uc-check-program exprs)
    (dbg-log "secret-check\n")
    (sc-check-program exprs)
    0))

; ===========================================================================
; MIDDLE — ExprInner to lowered, optimized, region-annotated functions
; ===========================================================================

; Type inference through region inference. Contracts were already lowered
; to checks by the parse (expr_inner.zyl's contract-defn-body).
; Returns: List(Icnf) — one IFn per function
(defn lower-exprs (arena exprs0)
  (let exprs (dv-expand-program exprs0)
  (begin
    ; Derived impls are expanded, then impl bodies are lifted into
    ; Trait.method_Type functions; types come from type_annotate, which
    ; runs in lower-after-mono just before ICNF lowering.
    (let _ (dbg-log "lift-impls\n")
      (lower-after-mono arena (lift-impls exprs))))))

(defn lower-after-mono (arena td-exprs)
  (begin
    (dbg-log "closure-inline\n")
    (let ci-exprs (ci-expand-program arena td-exprs)
      (begin
        (begin
            (dbg-log "lower\n")
            (let fns (ic-program arena (ta-annotate ci-exprs))
              (begin
                ; Real constant folding + dead-branch elimination:
                ; optimization.zyl was rewritten against this pipeline's
                ; actual tree-shaped Icnf (see its own header comment for
                ; why the old SSA-shaped version never did anything --
                ; every function silently fell through its pattern match
                ; and opt-optimize always returned Nil).
                (dbg-log "optimize\n")
                (let opt-fns (opt-optimize-fns (opt-inline-fns fns))
                  (begin
                    ; Real escape analysis: region_inference.zyl rewrites
                    ; a provably-non-escaping IVariant let-binding to
                    ; IStackVariant (stack-allocated, see
                    ; cg-stack-variant) in place, then rg-regions places
                    ; every allocation and call site in a region
                    ; (docs/regions-design.md).
                    (dbg-log "region-infer\n")
                    (let reg-fns (rg-regions (ri-transform-fns opt-fns))
                      (begin
                        (dbg-log "reuse\n")
                        (ru-reuse reg-fns))))))))))))

; Source text to lowered functions: everything except code generation.
; Returns: List(Icnf)
(defn compile-to-fns (arena srcbuf srcpath)
  (lower-exprs arena (compile-to-exprs arena srcbuf srcpath)))

; ===========================================================================
; BACK END — lowered functions to x86_64 assembly text
; ===========================================================================

; Source text to assembly. Does NOT write anywhere; callers decide the
; sink.
; Returns: String (assembly)
(defn compile-to-asm (arena srcbuf srcpath)
  (codegen-fns arena (compile-to-fns arena srcbuf srcpath) srcpath))

(defn codegen-fns (arena region-fns srcpath)
  (begin
    (dbg-log "codegen\n")
    (let st (cg-program-file (cg-new arena) region-fns srcpath)
      (let buf (cg-buffer st)
        (let blen (alloc-strlen buf)
          (if (> blen 66060288)
            (ffi-call "zyl_panic" "E_CODEGEN_BUFFER_FULL: generated assembly exceeded the codegen buffer" 1000)
            buf))))))
