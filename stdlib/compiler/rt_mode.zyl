; compiler/rt_mode: runtime-module mode, set only for the bundle's runtime/rt/rt.zyl (docs/runtime-in-zyl-design.md).

; 1 while compiling the runtime module, else 0.
(def rt-mode-cell (ffi-call "zyl_ref_new" 0 1000))

(defn rt-mode-p () (= (ffi-call "zyl_ref_get" rt-mode-cell 1000) 1))

(defn rt-mode-set () (ffi-call "zyl_ref_set" rt-mode-cell 1 1000))

; Runtime entries only the runtime module may call.
(defn rt-only-p (s) (str-eq s "zyl_ralloc"))

; A raw primitive symbol: "%load64" and friends.
(defn rt-prim-p (s)
  (and (> (str-length s) 1) (= (ffi-call "zyl_cstr_byte_at" s 0 1000) 37)))

; The bare export label of a runtime definition: the part after the last "::" when it starts "zyl_", else "".
(defn rt-export-label (name)
  (let tail (rt-after-colons name 0 0 (str-length name))
    (if (and (>= (str-length tail) 4) (str-eq (str-substring tail 0 4) "zyl_")) tail "")))

(defn rt-after-colons (s i start n)
  (if (>= (+ i 1) n)
    (str-substring s start (- n start))
    (if (and (= (ffi-call "zyl_cstr_byte_at" s i 1000) 58) (= (ffi-call "zyl_cstr_byte_at" s (+ i 1) 1000) 58))
      (rt-after-colons s (+ i 2) (+ i 2) n)
      (rt-after-colons s (+ i 1) start n))))

; %global blocks of the runtime module, in first-use order.
(deftype RtGlobal (RtGlobal String Int))

(def rt-globals-cell (ffi-call "zyl_ref_new" Nil 1000))

(defn rt-globals () (list-reverse-rt (ffi-call "zyl_ref_get" rt-globals-cell 1000) Nil))

(defn list-reverse-rt (xs acc) (match xs (Nil acc) (Cons h t (list-reverse-rt t (Cons h acc)))))

; Registers the block once and returns its label.
(defn rt-global-add (label size)
  (if (rt-global-known (ffi-call "zyl_ref_get" rt-globals-cell 1000) label)
    label
    (let _ (ffi-call "zyl_ref_set" rt-globals-cell (Cons (RtGlobal label size) (ffi-call "zyl_ref_get" rt-globals-cell 1000)) 1000)
      label)))

(defn rt-global-known (gs label)
  (match gs (Nil false) (Cons g t (match g (RtGlobal n _ (if (str-eq n label) true (rt-global-known t label)))))))

(defn rt-global-label-p (s)
  (and (> (str-length s) 8) (str-eq (str-substring s 0 8) "zyl_rtg_")))

(defn rt-tls-label-p (s)
  (and (> (str-length s) 8) (str-eq (str-substring s 0 8) "zyl_rtt_")))

; Syscall numbers %syscallK used, in first-use order (one stub each).
(def rt-syscalls-cell (ffi-call "zyl_ref_new" Nil 1000))

(defn rt-syscalls () (list-reverse-rt (ffi-call "zyl_ref_get" rt-syscalls-cell 1000) Nil))

(defn rt-syscall-add (n)
  (if (rt-int-member n (ffi-call "zyl_ref_get" rt-syscalls-cell 1000)) n
    (let _ (ffi-call "zyl_ref_set" rt-syscalls-cell (Cons n (ffi-call "zyl_ref_get" rt-syscalls-cell 1000)) 1000) n)))

(defn rt-int-member (n xs) (match xs (Nil false) (Cons h t (if (= h n) true (rt-int-member n t)))))

(defn rt-syscall-p (s) (and (> (str-length s) 8) (str-eq (str-substring s 0 8) "%syscall")))

(defn rt-export-name-p (s) (and (> (str-length s) 4) (str-eq (str-substring s 0 4) "zyl_")))

; Exported thread-locals (a zyl_* %tls), in first-use order.
(def rt-tls-exports-cell (ffi-call "zyl_ref_new" Nil 1000))

(defn rt-tls-exports () (list-reverse-rt (ffi-call "zyl_ref_get" rt-tls-exports-cell 1000) Nil))

(defn rt-tls-export-add (name size)
  (if (rt-global-known (ffi-call "zyl_ref_get" rt-tls-exports-cell 1000) name) name
    (let _ (ffi-call "zyl_ref_set" rt-tls-exports-cell (Cons (RtGlobal name size) (ffi-call "zyl_ref_get" rt-tls-exports-cell 1000)) 1000) name)))

(defn rt-tls-export-p (s) (rt-global-known (ffi-call "zyl_ref_get" rt-tls-exports-cell 1000) s))

(defn rt-call-p (s) (and (> (str-length s) 5) (str-eq (str-substring s 0 5) "%call")))

; Symbols named by %fn-weak (0 when absent from the link), in first-use order.
(def rt-weaks-cell (ffi-call "zyl_ref_new" Nil 1000))

(defn rt-weaks () (list-reverse-rt (ffi-call "zyl_ref_get" rt-weaks-cell 1000) Nil))

(defn rt-weak-add (name)
  (if (rt-str-member name (ffi-call "zyl_ref_get" rt-weaks-cell 1000)) name
    (let _ (ffi-call "zyl_ref_set" rt-weaks-cell (Cons name (ffi-call "zyl_ref_get" rt-weaks-cell 1000)) 1000) name)))

(defn rt-str-member (s xs) (match xs (Nil false) (Cons h t (if (str-eq h s) true (rt-str-member s t)))))

; Set when a program lowers a foreign ffi-call: it then links hosted (libc's crt), else freestanding.
(def rt-foreign-cell (ffi-call "zyl_ref_new" 0 1000))

(defn rt-foreign-mark () (ffi-call "zyl_ref_set" rt-foreign-cell 1 1000))

(defn rt-foreign-p () (= (ffi-call "zyl_ref_get" rt-foreign-cell 1000) 1))
