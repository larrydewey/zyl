; === Zyl Compiler — ExprInner AST Bridge ===
; Port of Rust ast.rs ExprInner enum to Zyl deftype/match form.
;
; The Zyl parser produces raw Ast (AstIdent/AstInt/AList).
; type_inference.zyl expects ExprInner (Atom/Call/Defn/.../Apply).
; This module bridges that gap.

; Needed for Pair (parse-for-binding/parse-cond-clause construct one) —
; previously missing here entirely. Harmless for the assemble.py bundle
; (use lines are stripped there regardless), but a standalone program
; that `use`s a compiler/* module directly instead of importing the
; whole bundle (e.g. integration/selfhost-codegen.zyl, using icnf.zyl as
; a library to compile a nested program at runtime) needs every real
; dependency actually declared for the module resolver to pull it in -
; this was an undefined `f_Pair` reference at link time otherwise.
(use compiler/type_system)
(use compiler/error_report)
;
; Structure:
;   1. ExprInner ADT mirrors Rust ExprInner (lines 53-115 ast.rs)
;   2. Supporting ADTs (Param, MatchArm, ADTVariant, etc.)
;   3. Ast → ExprInner converter (convert-ast function)
;   4. Expr wrapper (Expr + ExprInner pattern expected by inference)

; ===========================================================================
; EXPR INNER — mirrors Rust ast.rs ExprInner
; ===========================================================================

(deftype ExprInner
  (EAtom Atom)
  (ECall Expr (List Expr))
  (EDef String Expr)
  (EDefn String (List Param) Expr)
  (ELet String Expr Expr)
  (ELetMut String Expr Expr)
  (EIf Expr Expr Expr)
  (ETryCatch Expr String Expr)
  (EMatch Expr (List MatchArm))
  (ESpawn Expr)
  (ESend Expr Expr)
  (ESendClosure Expr Expr (List CaptureInfo))
  (EFfiCall String (List Expr) Int)
  (EFfiPin Expr)
  (EFfiUnpin Expr)
  (EAssert Expr (Option Expr))
  (EError String)
  (EUnwrap Expr)
  (EWhile Expr Expr)
  (EFor (List (Pair String (Option Expr))) Expr Expr)
  (ECond (List (Pair Expr Expr)))
  (EBegin (List Expr))
  (ELambda String (List Param) Expr)
  (EFn String (List Param) Expr)
  (EStructGet Expr String)
  (EMakeStruct String (List Expr))
  (EMakeVariant String String (List Expr))
  (ESetBang String Expr)
  (EModuleDecl String)
  (EUseModule (List String) (Option (List String)) Bool)
  (EExport String)
  (EPrint (List Expr))
  (EReadLine)
  (EExit Expr)
  (EClose Expr)
  (EFileOpen Expr Expr)
  (EFileRead Expr Expr)
  (EFileWrite Expr Expr)
  (EFileClose Expr)
  (EBufAppend Expr Expr)
  (EWithResource String Expr Expr)
  (EDeftype String (List ADTVariant) (List String) (Option String))
  (ETraitDecl String (List TraitMethod) (Option (Pair String String)))
  (EImplBlock String String (List ImplBody))
  (EStructDef StructDef (Option StructDef))
  (EStructDefPlus StructDef (Option StructDef))
  (EAliasDecl String Expr)
  (EDerive String (List String))
  (ETestSuite String (List TestOrSuite) (Option (Pair String Atom)))
  (ETestDecl String Expr (Option (Pair String Atom)))
  (EAssertEqual Expr Expr)
  (EAssertFail Expr (Option String))
  (EAssertTrue Expr (Option String))
  (EAssertFalse Expr (Option String))
  (ETestProperty String Generator Expr)
  (ESetup (List Expr))
  (ETeardown (List Expr))
  (ERunTests (Option (Pair String Atom)))
  (ETestCompile Expr (Option Bool))
  (EApply String (List Expr))
  (EMacroDef String (List Expr) Expr)
  (EUnknown String (List Expr))
  ; --- Byte-level primitives (BYTE_PRIMITIVES_IMPLEMENTATION_PLAN.md §2) --
  ; Endianness is carried per-op (plan lowers ELe=0 / EBe=1); the picking
  ; region for a bytebuf is a construction-time constant in the form's own
  ; Region payload (declared syntax: `(bytebuf Heap 100)`).
  (EByteLit Int)
  (ELoadByte Endian Expr Expr)
  (ELoadByteSigned Endian Expr Expr)
  (EStoreByte Endian Expr Expr Expr)
  (EStoreByteSigned Endian Expr Expr Expr)
  (EByteSlice Expr Expr Expr)
  (EByteSliceSub Expr Expr Expr)
  (EByteBuf Region Int)
  (EByteBufAppend Expr Expr)
  (EByteBufLen Expr)
  (EByteBufCap Expr)
  (EByteBufPtr Expr)
  (EAlignCheck Expr Int)
  (EAtomicLoad Expr Expr)
  (EAtomicStore Expr Expr Expr)
  (EAtomicAdd Expr Expr Expr)
  (EAtomicSub Expr Expr Expr)
  (EAtomicCAS Expr Expr Expr Expr)
  (EAtomicFetchAdd Expr Expr Expr)
  (EAtomicMax Expr Expr Expr)
  (EAtomicMin Expr Expr Expr))

; Endianness selector for the load/store/atomic byte ops. Parsed from the
; `:le` / `:be` keyword in first argument position
; (e.g. `(load-u8 :le buf off)`). EWide carries a 16/32/64-bit access:
; the endian code (0 le, 1 be) and the width in bytes.
(deftype Endian (ELe) (EBe) (EWide Int Int))

(defn endian-to-int (e)
  (match e
    (ELe 0)
    (EBe 1)
    (EWide c _ c)))

(defn endian-width (e)
  (match e
    (ELe 1)
    (EBe 1)
    (EWide _ w w)))

; --- Supporting ADTs -------------------------------------------------------

(deftype Atom (AInt Int) (AFloat String) (ABool Bool) (AStr String) (AIdent String) (ASymbol String) (AKeyword String) (ANil))

(deftype Param (P String (Option Expr)))

(defn P.name (p) (match p (P n _ n)))
(defn P.type (p) (match p (P _ t t)))

(deftype MatchArm (MA String (List Expr) Expr))

(defn MA.variant (arm) (match arm (MA v _ _ v)))
(defn MA.patterns (arm) (match arm (MA _ p _ p)))
(defn MA.body (arm) (match arm (MA _ _ b b)))

(deftype CaptureInfo (CI String Int))

(deftype ADTVariant (AV String (List String)))

(defn AV.name (v) (match v (AV n _ n)))
(defn AV.fields (v) (match v (AV _ f f)))

; name, params, return name, return type expression
(deftype TraitMethod (TM String (List Param) String (Option Expr)))

(deftype ImplBody (IB DefnNode))

(deftype DefnNode (DN String (List Param) Expr))

(defn DN.name (d) (match d (DN n _ _ n)))
(defn DN.params (d) (match d (DN _ p _ p)))
(defn DN.body (d) (match d (DN _ _ b b)))

(deftype StructDef (SD String (List (Pair String (Option String)))))

(deftype Generator (GenInt) (GenBool) (GenStr) (GenFloat))

(deftype TestDecl (TD String Expr (Option (Pair String Atom))))

(deftype TestSuiteNode (TSN String (List TestOrSuite) (Option (Pair String Atom))))

(deftype TestOrSuite (Test TestDecl) (Suite TestSuiteNode))

; --- Expr wrapper — matches type_inference.zyl expectation of .inner ----------

(deftype Expr (Expr ExprInner))

(defn Expr.inner (e) (match e (Expr i i)))

; ===========================================================================
; AST-LIST HELPERS (raw ast.zyl `Ast` streams)
; ===========================================================================
; A match arm of shape `(Cons a b)` matched DIRECTLY against a `(List Ast)`
; scrutinee binds `a` to the single head element (safe) but `b` to the
; REMAINING TAIL — itself a `(List Ast)`, not a single `Ast` — since that's
; genuinely `Cons`'s second field type. Every parser below used to bind a
; second (or later) pattern name and then pass it straight to `convert-ast`
; (which expects a single `Ast`), silently feeding it a list instead — the
; list's own Cons/Nil discriminant (0/1) would alias against unrelated `Ast`
; variants (AstIdent/AstInt) with completely wrong field data. These helpers
; walk lists explicitly by index instead, so no parser below ever binds a
; "final" argument name straight off a multi-field Cons pattern.

(defn ast-nth (xs n fb)
  (match xs
    (Nil fb)
    (Cons h t (if (= n 0) h (ast-nth t (- n 1) fb)))))

(defn ast-list-last (xs fb)
  (match xs
    (Nil fb)
    (Cons h t (if (nil? t) h (ast-list-last t fb)))))

(defn ast-list-butlast (xs)
  (ast-list-butlast-acc xs Nil))

(defn ast-list-butlast-acc (xs acc)
  (match xs
    (Nil (list-reverse acc))
    (Cons h t (if (nil? t) (list-reverse acc) (ast-list-butlast-acc t (Cons h acc))))))

(defn ast-has-at-least (xs n)
  (if (= n 0)
    true
    (match xs
      (Nil false)
      (Cons _ t (ast-has-at-least t (- n 1))))))

; Unwrap an Option, or lower to `fb` when it's None — replaces the
; `(if (Some x y) x fb)` idiom used throughout this module, which does NOT
; pattern-match: this compiler's `if` has no if-let sugar, so that idiom's
; condition is a 2-argument call to the 1-field `Some` constructor and
; ALWAYS evaluates false, meaning every special form below silently
; degraded to `EUnknown` (or `None`) regardless of whether parsing actually
; succeeded.
(defn unwrap-or-expr (opt fb)
  (match opt
    (Some e e)
    (None fb)))

; ===========================================================================
; AST → EXPRINNER CONVERTER
; ===========================================================================
; Converts raw ast.zyl Ast (AstIdent/AstInt/AList) to ExprInner.
; Head-symbol recognition happens here (no-dispatch architecture).
; ===========================================================================

; Every Expr built straight from source keeps the span of the Ast it came
; from, so a check that runs after parsing (arity, exhaustiveness, ...) can
; still point at the user's own text. A node a later phase synthesises has
; no entry, and renders without a location rather than a wrong one.
(defn convert-ast (ast)
  (let e (convert-ast-node ast)
    (let _ (ffi-call "zyl_span_copy" e ast 1000)
      e)))

(defn convert-ast-node (ast)
  (match ast
    (AstIdent s
      (let (atom (AIdent s))
        (Expr (EAtom atom))))
    (AstInt n
      (let (atom (AInt n))
        (Expr (EAtom atom))))
    (AstFloat s
      (let (atom (AFloat s))
        (Expr (EAtom atom))))
    (AString s
      (let (atom (AStr s))
        (Expr (EAtom atom))))
    (AstBool b
      (let (atom (ABool b))
        (Expr (EAtom atom))))
    (AList lst
      (if (nil? lst)
        (Expr (EAtom ANil))
        (convert-list-to-exprinner lst)))))

; Helper: convert-ast returns a list of Expr (for Begin sequences)
; The head symbol determines which ExprInner variant to produce.

(defn convert-ast-list (ast-list)
  (match ast-list
    (Nil Nil)
    ((Cons a rest)
      (Cons
        (convert-ast a)
        (convert-ast-list rest)))))

(defn convert-list-to-exprinner (ast-list)
  (match ast-list
    (Nil (Expr (EAtom ANil)))
    (Cons head rest
      (match head
        (AstIdent n (dispatch-special n rest))
        (_ (Expr (ECall (convert-ast head) (convert-ast-list rest))))))))

; Special-form recognition by head-symbol NAME (no-dispatch architecture:
; recognition happens here, never in the reader). Every branch that used to
; be a `(AstIdent "name" ...)` match arm is a `str-eq` check instead — match
; arms only bind IDENTIFIER patterns; a literal string in pattern position
; is never compared at all, so every one of those arms fired unconditionally
; on the FIRST arm's variant (AstIdent), making every special form after the
; first permanently unreachable.
;; Contracts (spec 23): recognized here like every other form.
;; requires/invariant become checks, ensures wraps the defn body, recover is try/catch.

; Contract clause source text, for violation messages.
(defn ast-text (a)
  (match a
    (AstIdent n n)
    (AstInt n (ffi-call "zyl_int_text" n 1000))
    (AstFloat t t)
    (AString t (str-concat "\"" (str-concat t "\"")))
    (AstBool b (if b "true" "false"))
    (AList xs (str-concat "(" (str-concat (ast-text-list xs) ")")))))

(defn ast-text-list (xs)
  (match xs
    (Nil "")
    (Cons h t
      (let ht (ast-text h)
        (if (nil? t) ht (str-concat ht (str-concat " " (ast-text-list t))))))))

(defn ast-call2 (hd a b) (AList (Cons (AstIdent hd) (Cons a (Cons b Nil)))))

; (assert-true C "E_CONTRACT_VIOLATION: <what> failed: C"), spanned at the clause.
(defn contract-check (what clause c)
  (let msg (str-concat "E_CONTRACT_VIOLATION: " (str-concat what (str-concat " failed: " (ast-text c))))
    (let chk (AList (Cons (AstIdent "assert-true") (Cons c (Cons (AString msg) Nil))))
      (let _ (ffi-call "zyl_span_copy" chk clause 1000)
        chk))))

; Head name of a list form, or "".
(defn ast-head (a)
  (match a
    (AList xs (match xs (Cons h _ (match h (AstIdent n n) (_ ""))) (Nil "")))
    (_ "")))

(defn ast-arg1 (a)
  (match a
    (AList xs (ast-nth xs 1 (AstInt 0)))
    (_ (AstInt 0))))

(defn contract-head-p (n)
  (or (> (str-eq n "requires") 0) (or (> (str-eq n "ensures") 0) (> (str-eq n "invariant") 0))))

; What a nested clause checks; `fname` is "" outside a defn body.
(defn contract-what (kind fname)
  (let base (if (> (str-eq kind "requires") 0) "precondition"
              (if (> (str-eq kind "ensures") 0) "postcondition" "invariant"))
    (if (= (str-length fname) 0) base (str-concat base (str-concat " of " (contract-short-name fname (str-length fname)))))))

; Symbol part of a canonical key (after the last ':').
(defn contract-short-name (n i)
  (if (= i 0)
    n
    (if (= (ffi-call "zyl_cstr_byte_at" n (- i 1) 1000) 58)
      (str-substring n i (- (str-length n) i))
      (contract-short-name n (- i 1)))))

(defn parse-contract-clause (kind args clause)
  (convert-ast (contract-check (contract-what kind "") clause (ast-nth args 0 (AstInt 0)))))

; (contracts off FORM): FORM with every contract clause removed.
(defn parse-contracts-off (args)
  (match (ast-nth args 0 (AstInt 0))
    (AstIdent mode
      (if (> (str-eq mode "off") 0)
        (convert-ast (contract-strip (ast-nth args 1 (AstInt 0))))
        (Expr (EUnknown "contracts" (convert-ast-list args)))))
    (_ (Expr (EUnknown "contracts" (convert-ast-list args))))))

(defn contract-strip (a)
  (match a
    (AList xs
      (let r (AList (contract-strip-list xs))
        (let _ (ffi-call "zyl_span_copy" r a 1000) r)))
    (_ a)))

(defn contract-strip-list (xs)
  (match xs
    (Nil Nil)
    (Cons h t
      (if (contract-head-p (ast-head h))
        (contract-strip-list t)
        (Cons (contract-strip h) (contract-strip-list t))))))

;; Dot syntax, rewritten before qualification: `p.x.y` reads fields,
;; `(p.m args)` calls trait method m on p (resolved by type, type_annotate.zyl).
(defn dot-rewrite-forms (forms)
  (match forms
    (Nil Nil)
    (Cons f rest (Cons (dot-rewrite f) (dot-rewrite-forms rest)))))

(defn dot-rewrite (a)
  (match a
    (AstIdent s (if (dot-name-p s) (dot-chain a (dot-split s 0 0)) a))
    (AList xs
      (match xs
        (Cons h t
          (match h
            (AstIdent s
              (if (dot-name-p s)
                (dot-spanned (AList (Cons (AstIdent "zyl-method") (dot-method-args h (dot-split s 0 0) t))) a)
                (dot-spanned (AList (Cons h (dot-rewrite-rest s t))) a)))
            (AList _ (dot-rewrite-call a h t))
            (_ (dot-spanned (AList (dot-rewrite-list xs)) a))))
        (Nil a)))
    (_ a)))

; ((expr).m args...): a method on an expression receiver.
(defn dot-rewrite-call (a h t)
  (match t
    (Cons m more
      (match m
        (AstIdent s
          (if (= (ffi-call "zyl_cstr_byte_at" s 0 1000) 46)
            (let segs (dot-split (str-substring s 1 (- (str-length s) 1)) 0 0)
              (dot-spanned (AList (Cons (AstIdent "zyl-method") (Cons (AString (dot-last segs))
                (Cons (dot-chain-from a (dot-rewrite h) (dot-butlast segs)) (dot-rewrite-list more))))) a))
            (dot-spanned (AList (dot-rewrite-list (Cons h t))) a)))
        (_ (dot-spanned (AList (dot-rewrite-list (Cons h t))) a))))
    (Nil (dot-spanned (AList (Cons (dot-rewrite h) Nil)) a))))

(defn dot-spanned (r a) (let _ (ffi-call "zyl_span_copy" r a 1000) r))

; A definition's name slot is never rewritten.
(defn dot-rewrite-rest (head t)
  (if (dot-binder-head-p head)
    (match t (Cons n more (Cons n (dot-rewrite-list more))) (Nil Nil))
    (dot-rewrite-list t)))

(defn dot-binder-head-p (h)
  (or (> (str-eq h "defn") 0) (or (> (str-eq h "def") 0) (or (> (str-eq h "defmacro") 0)
    (or (> (str-eq h "deftype") 0) (> (str-eq h "defstruct") 0))))))

; An element followed by a `.f.g` token reads fields of that element: `(make-P 1).x`.
(defn dot-rewrite-list (xs)
  (match xs
    (Nil Nil)
    (Cons h t
      (match t
        (Cons nx more
          (if (dot-suffix-p nx)
            (dot-rewrite-list (Cons (dot-chain-from nx (dot-rewrite h) (dot-split (dot-suffix-text nx) 0 0)) more))
            (Cons (dot-rewrite h) (dot-rewrite-list t))))
        (Nil (Cons (dot-rewrite h) Nil))))))

(defn dot-suffix-p (a)
  (match a
    (AstIdent s (and (> (str-length s) 1) (= (ffi-call "zyl_cstr_byte_at" s 0 1000) 46)))
    (_ false)))

(defn dot-suffix-text (a)
  (match a
    (AstIdent s (str-substring s 1 (- (str-length s) 1)))
    (_ "")))

; A local-looking name with dots: lowercase first (after any `_`), no '@' or ':', no empty segment.
(defn dot-name-p (s)
  (let n (str-length s)
    (if (< n 3) false
      (if (dot-lower-p (ffi-call "zyl_cstr_byte_at" s (dot-skip-under s 0) 1000))
        (dot-name-scan s 1 n false 0)
        false))))

(defn dot-skip-under (s i)
  (if (= (ffi-call "zyl_cstr_byte_at" s i 1000) 95) (dot-skip-under s (+ i 1)) i))

(defn dot-lower-p (c) (and (>= c 97) (<= c 122)))

(defn dot-name-scan (s i n seen prev)
  (if (>= i n)
    (and seen (!= prev 46))
    (let c (ffi-call "zyl_cstr_byte_at" s i 1000)
      (if (or (= c 64) (= c 58)) false
        (if (= c 46)
          (if (= prev 46) false (dot-name-scan s (+ i 1) n true c))
          (dot-name-scan s (+ i 1) n seen c))))))

; Segments of `s` from byte `start`, scanning at `i`.
(defn dot-split (s start i)
  (if (>= i (str-length s))
    (Cons (str-substring s start (- i start)) Nil)
    (if (= (ffi-call "zyl_cstr_byte_at" s i 1000) 46)
      (Cons (str-substring s start (- i start)) (dot-split s (+ i 1) (+ i 1)))
      (dot-split s start (+ i 1)))))

; p.a.b = (struct-get (struct-get p "a") "b")
(defn dot-chain (site segs)
  (match segs
    (Cons h t (dot-chain-from site (dot-spanned (AstIdent h) site) t))
    (Nil site)))

(defn dot-chain-from (site acc segs)
  (match segs
    (Nil acc)
    (Cons h t (dot-chain-from site (dot-spanned (ast-call2 "struct-get" acc (AString h)) site) t))))

; ("m" recv args...) for (recv.m args...): the last segment is the method.
(defn dot-method-args (site segs t)
  (Cons (AString (dot-last segs)) (Cons (dot-chain site (dot-butlast segs)) (dot-rewrite-list t))))

(defn dot-last (xs)
  (match xs (Cons h t (if (nil? t) h (dot-last t))) (Nil "")))

(defn dot-butlast (xs)
  (match xs (Cons h t (if (nil? t) Nil (Cons h (dot-butlast t)))) (Nil Nil)))

;; Top-level defs (spec R7: immutable, eager): each becomes a getter that
;; caches its value by canonical key; uses become calls; main runs them first.
(defn def-table () (ffi-call "zyl_smap_global" 2 1000))

(defn def-key-p (n) (> (ffi-call "zyl_smap_get" (def-table) n 1000) 0))

(defn convert-program (forms)
  (let _ (ffi-call "zyl_smap_clear" (def-table) 1000)
    (convert-program-defs forms)))

(defn convert-program-defs (forms)
  (if (= (def-collect forms 0) 0)
    (convert-top-forms forms)
    (list-append (convert-top-forms (def-rewrite-top forms))
                 (Cons (convert-ast (def-init-fn forms)) Nil))))

(defn def-name-of (f)
  (if (> (str-eq (ast-head f) "def") 0)
    (match (ast-arg1 f) (AstIdent k k) (_ ""))
    ""))

(defn def-collect (forms n)
  (match forms
    (Nil n)
    (Cons f rest
      (let k (def-name-of f)
        (if (= (str-length k) 0)
          (def-collect rest n)
          (begin
            (ffi-call "zyl_smap_put" (def-table) k 1 1000)
            (def-collect rest (+ n 1))))))))

(defn def-rewrite-top (forms)
  (match forms
    (Nil Nil)
    (Cons f rest
      (let k (def-name-of f)
        (Cons (if (= (str-length k) 0) (def-rewrite f) (def-getter f k)) (def-rewrite-top rest))))))

; A use of a def key becomes a call; a set! target is left for the mutability check.
(defn def-rewrite (a)
  (match a
    (AstIdent n
      (if (def-key-p n)
        (let r (AList (Cons a Nil)) (let _ (ffi-call "zyl_span_copy" r a 1000) r))
        a))
    (AList xs
      (let r (AList (if (> (str-eq (ast-head a) "set!") 0) (def-rewrite-set xs) (def-rewrite-list xs)))
        (let _ (ffi-call "zyl_span_copy" r a 1000) r)))
    (_ a)))

(defn def-rewrite-set (xs)
  (match xs
    (Cons h t (match t (Cons target vs (Cons h (Cons target (def-rewrite-list vs)))) (Nil xs)))
    (Nil Nil)))

(defn def-rewrite-list (xs)
  (match xs
    (Nil Nil)
    (Cons h t (Cons (def-rewrite h) (def-rewrite-list t)))))

(defn ast-call1 (hd a) (AList (Cons (AstIdent hd) (Cons a Nil))))

; (defn k () (if (ready "k") (get "k") (let _zyl_def v (begin (put "k" _zyl_def) _zyl_def))))
(defn def-getter (f k)
  (let key (AString k)
    (let v (def-rewrite (match f (AList xs (ast-nth xs 2 (AstInt 0))) (_ (AstInt 0))))
      (let store (AList (Cons (AstIdent "let") (Cons (AstIdent "_zyl_def") (Cons v
                   (Cons (AList (Cons (AstIdent "begin")
                     (Cons (ast-call2 "zyl-global-put" key (AstIdent "_zyl_def")) (Cons (AstIdent "_zyl_def") Nil)))) Nil)))))
        (let body (AList (Cons (AstIdent "if") (Cons (ast-call1 "zyl-global-ready" key)
                    (Cons (ast-call1 "zyl-global-get" key) (Cons store Nil)))))
          (let g (AList (Cons (AstIdent "defn") (Cons (AstIdent k) (Cons (AList Nil) (Cons body Nil)))))
            (let _ (ffi-call "zyl_span_copy" g f 1000) g)))))))

; Runs every getter in source order; ICNF lowering calls it first thing in main.
(defn def-init-fn (forms)
  (AList (Cons (AstIdent "defn") (Cons (AstIdent "zyl-init-globals") (Cons (AList Nil)
    (Cons (AList (Cons (AstIdent "begin") (list-append (def-init-calls forms) (Cons (AstInt 0) Nil)))) Nil))))))

(defn def-init-calls (forms)
  (match forms
    (Nil Nil)
    (Cons f rest
      (let k (def-name-of f)
        (if (= (str-length k) 0)
          (def-init-calls rest)
          (Cons (AList (Cons (AstIdent k) Nil)) (def-init-calls rest)))))))

; Top-level forms; a bare (contracts off) strips contracts from the next form.
(defn convert-top-forms (forms)
  (match forms
    (Nil Nil)
    (Cons f rest
      (if (contract-off-directive-p f)
        (match rest
          (Nil Nil)
          (Cons g more (Cons (convert-ast (contract-strip g)) (convert-top-forms more))))
        (Cons (convert-ast f) (convert-top-forms rest))))))

(defn contract-off-directive-p (f)
  (match f
    (AList xs
      (if (= (list-length xs) 2)
        (if (> (str-eq (ast-head f) "contracts") 0)
          (match (ast-nth xs 1 (AstInt 0)) (AstIdent m (> (str-eq m "off") 0)) (_ false))
          false)
        false))
    (_ false)))

;; Defn body: named checks for requires/invariant; ensures run on `result` after the body.
(defn contract-defn-body (fname forms)
  (match forms
    (Cons only rest
      (if (and (nil? rest) (> (str-eq (ast-head only) "begin") 0))
        (match only
          (AList xs (match xs (Cons _ kids (contract-wrap fname kids only true)) (Nil (parse-body-list forms))))
          (_ (parse-body-list forms)))
        (contract-wrap fname forms only false)))
    (Nil (parse-body-list forms))))

(defn contract-any (forms)
  (match forms
    (Nil false)
    (Cons h t (if (contract-head-p (ast-head h)) true (contract-any t)))))

(defn contract-wrap (fname forms site in-begin)
  (if (contract-any forms)
    (let pre (contract-pre fname forms)
      (let body (if in-begin (convert-ast (AList (Cons (AstIdent "begin") pre))) (parse-body-list pre))
        (let posts (contract-posts fname forms)
          (if (nil? posts)
            body
            (let r (Expr (ELet "result" body
                     (Expr (EBegin (convert-ast-list (list-append posts (Cons (AstIdent "result") Nil)))))))
              (let _ (ffi-call "zyl_span_copy" r site 1000) r))))))
    (if in-begin (convert-ast site) (parse-body-list forms))))

; Body with requires/invariant turned into named checks and ensures removed.
(defn contract-pre (fname forms)
  (match forms
    (Nil Nil)
    (Cons h t
      (let k (ast-head h)
        (if (> (str-eq k "ensures") 0)
          (contract-pre fname t)
          (if (contract-head-p k)
            (Cons (contract-check (contract-what k fname) h (ast-arg1 h)) (contract-pre fname t))
            (Cons h (contract-pre fname t))))))))

(defn contract-posts (fname forms)
  (match forms
    (Nil Nil)
    (Cons h t
      (if (> (str-eq (ast-head h) "ensures") 0)
        (Cons (contract-check (contract-what "ensures" fname) h (ast-arg1 h)) (contract-posts fname t))
        (contract-posts fname t)))))

; checkpoint: no rollback yet, the body's value.
(defn parse-checkpoint (args)
  (convert-ast (ast-nth args 0 (AstInt 0))))

; (recover BODY ((Type) fallback) ...): try BODY, first arm's fallback on error.
(defn parse-recover (args)
  (match args
    (Cons body arms
      (match arms
        (Cons arm _
          (convert-ast (AList (Cons (AstIdent "try") (Cons body
            (Cons (AList (Cons (AstIdent "catch") (Cons (AstIdent "_contract_err")
              (Cons (ast-list-last (match arm (AList xs xs) (_ Nil)) (AstInt 0)) Nil)))) Nil))))))
        (Nil (convert-ast body))))
    (Nil (Expr (EAtom ANil)))))

(defn dispatch-special (n rest)
  (if (> (str-eq n "contracts") 0)
    (parse-contracts-off rest)
  (if (contract-head-p n)
    (parse-contract-clause n rest (AList (Cons (AstIdent n) rest)))
  (if (> (str-eq n "checkpoint") 0)
    (parse-checkpoint rest)
  (if (> (str-eq n "recover") 0)
    (parse-recover rest)
  (if (> (str-eq n "defn") 0)
    (match (parse-defn rest)
      (Some expr expr)
      (None (Expr (EUnknown "defn" (convert-ast-list rest)))))
  (if (> (str-eq n "deftype") 0)
    (match (parse-deftype rest)
      (Some expr expr)
      (None (Expr (EUnknown "deftype" (convert-ast-list rest)))))
  (if (> (str-eq n "defstruct") 0)
    (match (parse-defstruct rest)
      (Some expr expr)
      (None (Expr (EUnknown "defstruct" (convert-ast-list rest)))))
  (if (> (str-eq n "defstruct+") 0)
    (match (parse-defstruct rest)
      (Some expr expr)
      (None (Expr (EUnknown "defstruct+" (convert-ast-list rest)))))
  (if (> (ds-impl-or-trait n) 0)
    (ds-impl-or-trait-form n rest)
  (if (> (str-eq n "def") 0)
    (match (parse-def rest)
      (Some expr expr)
      (None (Expr (EUnknown "def" (convert-ast-list rest)))))
  (if (> (str-eq n "let") 0)
    (match (parse-let rest)
      (Some expr expr)
      (None (Expr (EUnknown "let" (convert-ast-list rest)))))
  (if (> (str-eq n "let-mut") 0)
    (match (parse-let-mut rest)
      (Some expr expr)
      (None (Expr (EUnknown "let-mut" (convert-ast-list rest)))))
  (if (> (str-eq n "if") 0)
    (match (parse-if rest)
      (Some expr expr)
      (None (Expr (EUnknown "if" (convert-ast-list rest)))))
  (if (> (str-eq n "while") 0)
    (match (parse-while rest)
      (Some expr expr)
      (None (Expr (EUnknown "while" (convert-ast-list rest)))))
  (if (> (str-eq n "for") 0)
    (match (parse-for rest)
      (Some expr expr)
      (None (Expr (EUnknown "for" (convert-ast-list rest)))))
  (if (> (str-eq n "cond") 0)
    (match (parse-cond rest)
      (Some expr expr)
      (None (Expr (EUnknown "cond" (convert-ast-list rest)))))
  (if (> (str-eq n "or") 0)
    (match (parse-or rest)
      (Some expr expr)
      (None (Expr (EUnknown "or" (convert-ast-list rest)))))
  (if (> (str-eq n "and") 0)
    (match (parse-and rest)
      (Some expr expr)
      (None (Expr (EUnknown "and" (convert-ast-list rest)))))
  (if (> (str-eq n "not") 0)
    (match (parse-not rest)
      (Some expr expr)
      (None (Expr (EUnknown "not" (convert-ast-list rest)))))
  (if (> (str-eq n "match") 0)
    (match (parse-match rest)
      (Some expr expr)
      (None (Expr (EUnknown "match" (convert-ast-list rest)))))
  (if (> (str-eq n "try") 0)
    (match (parse-try rest)
      (Some expr expr)
      (None (Expr (EUnknown "try" (convert-ast-list rest)))))
  (if (> (str-eq n "begin") 0)
    (match (parse-begin rest)
      (Some expr expr)
      (None (Expr (EUnknown "begin" (convert-ast-list rest)))))
  (if (> (str-eq n "lambda") 0)
    (match (parse-lambda rest)
      (Some expr expr)
      (None (Expr (EUnknown "lambda" (convert-ast-list rest)))))
  (if (> (str-eq n "fn") 0)
    (match (parse-fn rest)
      (Some expr expr)
      (None (Expr (EUnknown "fn" (convert-ast-list rest)))))
  (if (> (str-eq n "print") 0)
    (match (parse-print rest)
      (Some expr expr)
      (None (Expr (EUnknown "print" (convert-ast-list rest)))))
  (if (> (str-eq n "assert-equal") 0)
    (match (parse-assert-equal rest)
      (Some expr expr)
      (None (Expr (EUnknown "assert-equal" (convert-ast-list rest)))))
  (if (> (str-eq n "assert") 0)
    (match (parse-assert rest)
      (Some expr expr)
      (None (Expr (EUnknown "assert" (convert-ast-list rest)))))
  (if (> (str-eq n "assert-true") 0)
    (match (parse-assert-true rest)
      (Some expr expr)
      (None (Expr (EUnknown "assert-true" (convert-ast-list rest)))))
  (if (> (str-eq n "assert-false") 0)
    (match (parse-assert-false rest)
      (Some expr expr)
      (None (Expr (EUnknown "assert-false" (convert-ast-list rest)))))
  (if (> (str-eq n "assert-fail") 0)
    (match (parse-assert-fail rest)
      (Some expr expr)
      (None (Expr (EUnknown "assert-fail" (convert-ast-list rest)))))
  (if (> (str-eq n "spawn") 0)
    (match (parse-spawn rest)
      (Some expr expr)
      (None (Expr (EUnknown "spawn" (convert-ast-list rest)))))
  (if (> (str-eq n "send") 0)
    (match (parse-send rest)
      (Some expr expr)
      (None (Expr (EUnknown "send" (convert-ast-list rest)))))
  (if (> (str-eq n "ffi-pin") 0)
    (match (parse-ffi-pin rest)
      (Some expr expr)
      (None (Expr (EUnknown "ffi-pin" (convert-ast-list rest)))))
  (if (> (str-eq n "ffi-unpin") 0)
    (match (parse-ffi-unpin rest)
      (Some expr expr)
      (None (Expr (EUnknown "ffi-unpin" (convert-ast-list rest)))))
  (if (> (str-eq n "exit") 0)
    (match (parse-exit rest)
      (Some expr expr)
      (None (Expr (EUnknown "exit" (convert-ast-list rest)))))
  (if (> (str-eq n "close") 0)
    (match (parse-close rest)
      (Some expr expr)
      (None (Expr (EUnknown "close" (convert-ast-list rest)))))
  (if (> (str-eq n "file-open") 0)
    (match (parse-file-open rest)
      (Some expr expr)
      (None (Expr (EUnknown "file-open" (convert-ast-list rest)))))
  (if (> (str-eq n "file-read") 0)
    (match (parse-file-read rest)
      (Some expr expr)
      (None (Expr (EUnknown "file-read" (convert-ast-list rest)))))
  (if (> (str-eq n "file-write") 0)
    (match (parse-file-write rest)
      (Some expr expr)
      (None (Expr (EUnknown "file-write" (convert-ast-list rest)))))
  (if (> (str-eq n "file-close") 0)
    (match (parse-file-close rest)
      (Some expr expr)
      (None (Expr (EUnknown "file-close" (convert-ast-list rest)))))
  (if (> (str-eq n "set!") 0)
    (match (parse-set-bang rest)
      (Some expr expr)
      (None (Expr (EUnknown "set!" (convert-ast-list rest)))))
  (if (> (str-eq n "module") 0)
    (match (parse-module rest)
      (Some expr expr)
      (None (Expr (EUnknown "module" (convert-ast-list rest)))))
  (if (> (str-eq n "use") 0)
    (match (parse-use rest)
      (Some expr expr)
      (None (Expr (EUnknown "use" (convert-ast-list rest)))))
  ; (pub defn f ...) — visibility is recorded by the module resolver,
  ; which strips the wrapper; anything converting a form directly (the
  ; LSP, a nested compile) just sees the definition it wraps (§24.3).
  (if (> (str-eq n "pub") 0)
    (convert-ast (AList rest))
  ; (feature-gate f <definition>): the module resolver decides whether a
  ; gated definition is part of this build (SS31.10) and unwraps it. Anything
  ; converting a form directly sees the definition it guards.
  (if (> (str-eq n "feature-gate") 0)
    (convert-ast (ast-nth rest 1 (AstInt 0)))
  (if (> (str-eq n "export") 0)
    (match (parse-export rest)
      (Some expr expr)
      (None (Expr (EUnknown "export" (convert-ast-list rest)))))
  (if (> (str-eq n "derive") 0)
    (match (parse-derive rest)
      (Some expr expr)
      (None (Expr (EUnknown "derive" (convert-ast-list rest)))))
  (if (> (str-eq n "macro") 0)
    (match (parse-macro rest)
      (Some expr expr)
      (None (Expr (EUnknown "macro" (convert-ast-list rest)))))
  (if (> (str-eq n "defmacro") 0)
    (match (parse-macro rest)
      (Some expr expr)
      (None (Expr (EUnknown "defmacro" (convert-ast-list rest)))))
  (if (> (str-eq n "test") 0)
    (match (parse-test rest)
      (Some expr expr)
      (None (Expr (EUnknown "test" (convert-ast-list rest)))))
  (if (> (str-eq n "test-suite") 0)
    (match (parse-test-suite rest)
      (Some expr expr)
      (None (Expr (EUnknown "test-suite" (convert-ast-list rest)))))
  (if (> (str-eq n "run-tests") 0)
    (Expr (ERunTests None))
  (if (> (str-eq n "setup") 0)
    (match (parse-setup rest)
      (Some expr expr)
      (None (Expr (EUnknown "setup" (convert-ast-list rest)))))
  (if (> (str-eq n "teardown") 0)
    (match (parse-teardown rest)
      (Some expr expr)
      (None (Expr (EUnknown "teardown" (convert-ast-list rest)))))
  (if (> (str-eq n "with-resource") 0)
    (match (parse-with-resource rest)
      (Some expr expr)
      (None (Expr (EUnknown "with-resource" (convert-ast-list rest)))))
  (if (> (str-eq n "read-line") 0)
    (Expr (EReadLine))
  (if (> (str-eq n "make-struct") 0)
    (match (parse-make-struct rest)
      (Some expr expr)
      (None (Expr (EUnknown "make-struct" (convert-ast-list rest)))))
  (if (> (str-eq n "struct-get") 0)
    (match (parse-struct-get rest)
      (Some expr expr)
      (None (Expr (EUnknown "struct-get" (convert-ast-list rest)))))
  (if (> (str-eq n "make-variant") 0)
    (match (parse-make-variant rest)
      (Some expr expr)
      (None (Expr (EUnknown "make-variant" (convert-ast-list rest)))))
  (if (> (str-eq n "unwrap") 0)
    (match (parse-unwrap rest)
      (Some expr expr)
      (None (Expr (EUnknown "unwrap" (convert-ast-list rest)))))
  ; "buf-append" is deliberately NOT special-cased here (unlike the Rust
  ; bootstrap's parser.rs/ast.rs, which intercept it as EBufAppend) —
  ; EBufAppend has no icnf.zyl/codegen.zyl lowering anywhere in this
  ; self-hosted pipeline, so intercepting it silently discarded every
  ; `(buf-append dst src)` call to a bare (IConst 0) via ic-expr's
  ; wildcard default, dropping the append with NO emitted code at all —
  ; while allocator.zyl's own `buf-append` (a real function wrapping
  ; ffi-call) sat right there, completely shadowed by the special form
  ; and never reachable. Falling through to an ordinary EApply call lets
  ; that real function run instead.
  (if (> (str-eq n "test-property") 0)
    (match (parse-test-property rest)
      (Some expr expr)
      (None (Expr (EUnknown "test-property" (convert-ast-list rest)))))
  (if (> (str-eq n "test-compile") 0)
    (match (parse-test-compile rest)
      (Some expr expr)
      (None (Expr (EUnknown "test-compile" (convert-ast-list rest)))))
    (byte-form-dispatch n rest)
  )))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))

; --- Byte-level primitives (BYTE_PRIMITIVES_IMPLEMENTATION_PLAN.md §2) ------
; Recognition happens here, not in the reader (no-dispatch arch). The 21
; byte-form names below carry real ExprInner variants; the wider-width
; load/store names (u16/u32/u64, i16/i32/i64) are RESERVED by the plan but
; have no variants -- they are rejected loudly with E_RESERVED_KEYWORD
; instead of silently lowering to a call that can never resolve.
;
; Endian/region selectors arrive as AstIdent: the parser maps TkKeyword
; (`:le`/`:be`) and plain identifiers alike to AstIdent (parser.zyl's
; read-form-atom). So both `:le` and `le` parse as AstIdent "le" — that's
; fine: only the spelling below matters, which is what the plan specifies.

(defn parse-endian-selector (ast)
  (match ast
    (AstIdent s0
      (let s (strip-leading-colon s0)
        (if (> (str-eq s "le") 0) (Some ELe)
        (if (> (str-eq s "be") 0) (Some EBe)
        (if (> (str-eq s "le/2") 0) (Some (EWide 0 2))
        (if (> (str-eq s "be/2") 0) (Some (EWide 1 2))
        (if (> (str-eq s "le/4") 0) (Some (EWide 0 4))
        (if (> (str-eq s "be/4") 0) (Some (EWide 1 4))
        (if (> (str-eq s "le/8") 0) (Some (EWide 0 8))
        (if (> (str-eq s "be/8") 0) (Some (EWide 1 8)) None))))))))))
    (_ None)))

; The reader keeps a keyword's ':' (parser.zyl's read-form-atom) so the
; module system can tell `pkg:mod` from `pkg mod`; every other consumer
; of a keyword wants the bare name.
(defn strip-leading-colon (s)
  (if (= (str-length s) 0)
    s
    (if (= (ffi-call "zyl_cstr_byte_at" s 0 1000) 58)
      (str-substring s 1 (- (str-length s) 1))
      s)))

(defn parse-region-selector (ast)
  (match ast
    (AstIdent s
      (if (> (str-eq s "Stack") 0) (Some RStack)
      (if (> (str-eq s "Heap") 0) (Some RHeap)
      (if (> (str-eq s "Global") 0) (Some RGlobal)
      (if (> (str-eq s "Circular") 0) (Some RCircular)
      (if (> (str-eq s "Pin") 0) (Some RPin) None))))))
    (_ None)))

(defn parse-byte (args)
  (if (ast-has-at-least args 1)
    (match (ast-nth args 0 (AstInt 256))
      (AstInt n
        (if (byte-value-ok n)
          (Some (Expr (EByteLit n)))
          (ffi-call "zyl_panic" "E_BYTE_VALUE_OOB: byte literal out of range 0-255" 1000)))
      (_ (ffi-call "zyl_panic" "E_BYTE_VALUE_OOB: byte literal must be an integer" 1000)))
    (ffi-call "zyl_panic" "E_ARITY_MISMATCH: byte requires a literal argument" 1000)))

(defn byte-value-ok (n)
  (if (>= n 0) (if (<= n 255) 1 0) 0))

(defn parse-load-byte (args signed)
  (if (ast-has-at-least args 3)
    (match (parse-endian-selector (ast-nth args 0 (AstInt 0)))
      (Some e
        (if (= signed 0)
          (Some (Expr (ELoadByte e (convert-ast (ast-nth args 1 (AstInt 0))) (convert-ast (ast-nth args 2 (AstInt 0))))))
          (Some (Expr (ELoadByteSigned e (convert-ast (ast-nth args 1 (AstInt 0))) (convert-ast (ast-nth args 2 (AstInt 0))))))))
      (None (ffi-call "zyl_panic" "E_UNEXPECTED_TOKEN_IN_EXPR: load-byte endian must be :le or :be" 1000)))
    (ffi-call "zyl_panic" "E_ARITY_MISMATCH: load-byte requires :le buf off" 1000)))

(defn parse-store-byte (args signed)
  (if (ast-has-at-least args 4)
    (match (parse-endian-selector (ast-nth args 0 (AstInt 0)))
      (Some e
        (if (= signed 0)
          (Some (Expr (EStoreByte e
            (convert-ast (ast-nth args 1 (AstInt 0)))
            (convert-ast (ast-nth args 2 (AstInt 0)))
            (convert-ast (ast-nth args 3 (AstInt 0))))))
          (Some (Expr (EStoreByteSigned e
            (convert-ast (ast-nth args 1 (AstInt 0)))
            (convert-ast (ast-nth args 2 (AstInt 0)))
            (convert-ast (ast-nth args 3 (AstInt 0))))))))
      (None (ffi-call "zyl_panic" "E_UNEXPECTED_TOKEN_IN_EXPR: store-byte endian must be :le or :be" 1000)))
    (ffi-call "zyl_panic" "E_ARITY_MISMATCH: store-byte requires :le buf off val" 1000)))

(defn parse-byteslice (args)
  (if (ast-has-at-least args 3)
    (Some
      (Expr
        (EByteSlice
          (convert-ast (ast-nth args 0 (AstInt 0)))
          (convert-ast (ast-nth args 1 (AstInt 0)))
          (convert-ast (ast-nth args 2 (AstInt 0))))))
    (ffi-call "zyl_panic" "E_ARITY_MISMATCH: byteslice requires buf off len" 1000)))

(defn parse-byteslice-sub (args)
  (if (ast-has-at-least args 3)
    (Some
      (Expr
        (EByteSliceSub
          (convert-ast (ast-nth args 0 (AstInt 0)))
          (convert-ast (ast-nth args 1 (AstInt 0)))
          (convert-ast (ast-nth args 2 (AstInt 0))))))
    (ffi-call "zyl_panic" "E_ARITY_MISMATCH: byteslice-sub requires slice off len" 1000)))

(defn parse-bytebuf (args)
  (if (ast-has-at-least args 2)
    (match (parse-region-selector (ast-nth args 0 (AstInt 0)))
      (Some r
        (match (ast-nth args 1 (AstInt 0))
          (AstInt cap (Some (Expr (EByteBuf r cap))))
          (_ (ffi-call "zyl_panic" "E_UNEXPECTED_TOKEN_IN_EXPR: bytebuf capacity must be an integer literal" 1000))))
      (None (ffi-call "zyl_panic" "E_UNEXPECTED_TOKEN_IN_EXPR: bytebuf region must be Stack Heap Global Circular or Pin" 1000)))
    (ffi-call "zyl_panic" "E_ARITY_MISMATCH: bytebuf requires region and capacity" 1000)))

(defn parse-bytebuf-append (args)
  (if (ast-has-at-least args 2)
    (Some
      (Expr
        (EByteBufAppend
          (convert-ast (ast-nth args 0 (AstInt 0)))
          (convert-ast (ast-nth args 1 (AstInt 0))))))
    (ffi-call "zyl_panic" "E_ARITY_MISMATCH: bytebuf-append requires buf slice" 1000)))

(defn parse-bytebuf-unary (args variant)
  (if (ast-has-at-least args 1)
    (let v (convert-ast (ast-nth args 0 (AstInt 0)))
      (if (= variant 0) (Some (Expr (EByteBufLen v)))
      (if (= variant 1) (Some (Expr (EByteBufCap v)))
      (Some (Expr (EByteBufPtr v))))))
    (ffi-call "zyl_panic" "E_ARITY_MISMATCH: bytebuf-len/cap/ptr requires buf" 1000)))

(defn parse-align-check (args)
  (if (ast-has-at-least args 2)
    (match (ast-nth args 1 (AstInt 0))
      (AstInt align (Some (Expr (EAlignCheck (convert-ast (ast-nth args 0 (AstInt 0))) align))))
      (_ (ffi-call "zyl_panic" "E_UNEXPECTED_TOKEN_IN_EXPR: align-check alignment must be a power-of-two literal" 1000)))
    (ffi-call "zyl_panic" "E_ARITY_MISMATCH: align-check requires ptr align" 1000)))

(defn parse-atomic-load (args)
  (if (ast-has-at-least args 2)
    (Some
      (Expr
        (EAtomicLoad
          (convert-ast (ast-nth args 0 (AstInt 0)))
          (convert-ast (ast-nth args 1 (AstInt 0))))))
    (ffi-call "zyl_panic" "E_ARITY_MISMATCH: bytebuf-atomic-load requires buf off" 1000)))

(defn parse-atomic-store (args)
  (if (ast-has-at-least args 3)
    (Some
      (Expr
        (EAtomicStore
          (convert-ast (ast-nth args 0 (AstInt 0)))
          (convert-ast (ast-nth args 1 (AstInt 0)))
          (convert-ast (ast-nth args 2 (AstInt 0))))))
    (ffi-call "zyl_panic" "E_ARITY_MISMATCH: bytebuf-atomic-store requires buf off val" 1000)))

(defn parse-atomic-op3 (args variant)
  (if (ast-has-at-least args 3)
    (let a (convert-ast (ast-nth args 0 (AstInt 0)))
      (let b (convert-ast (ast-nth args 1 (AstInt 0)))
        (let c (convert-ast (ast-nth args 2 (AstInt 0)))
          (if (= variant 0) (Some (Expr (EAtomicAdd a b c)))
          (if (= variant 1) (Some (Expr (EAtomicSub a b c)))
          (if (= variant 2) (Some (Expr (EAtomicFetchAdd a b c)))
          (if (= variant 3) (Some (Expr (EAtomicMax a b c)))
          (Some (Expr (EAtomicMin a b c))))))))))
    (ffi-call "zyl_panic" "E_ARITY_MISMATCH: bytebuf-atomic-op requires buf off val" 1000)))

(defn parse-atomic-cas (args)
  (if (ast-has-at-least args 4)
    (Some
      (Expr
        (EAtomicCAS
          (convert-ast (ast-nth args 0 (AstInt 0)))
          (convert-ast (ast-nth args 1 (AstInt 0)))
          (convert-ast (ast-nth args 2 (AstInt 0)))
          (convert-ast (ast-nth args 3 (AstInt 0))))))
    (ffi-call "zyl_panic" "E_ARITY_MISMATCH: bytebuf-atomic-cas requires buf off exp new" 1000)))

; Wide loads and stores: `load-u16`..`load-u64`, `load-i16`..`load-i64` and
; the matching `store-*`; width in bytes, 0 for any other name.
(defn wide-byte-width (n)
  (if (or (> (str-eq n "load-u16") 0) (or (> (str-eq n "load-i16") 0) (or (> (str-eq n "store-u16") 0) (> (str-eq n "store-i16") 0)))) 2
    (if (or (> (str-eq n "load-u32") 0) (or (> (str-eq n "load-i32") 0) (or (> (str-eq n "store-u32") 0) (> (str-eq n "store-i32") 0)))) 4
      (if (or (> (str-eq n "load-u64") 0) (or (> (str-eq n "load-i64") 0) (or (> (str-eq n "store-u64") 0) (> (str-eq n "store-i64") 0)))) 8 0))))

; The byte-width forms with an EWide endian: same shapes, same arity errors.
(defn parse-wide-byte (n rest)
  (let w (wide-byte-width n)
    (let signed (if (= (ffi-call "zyl_cstr_byte_at" n (if (> (str-length n) 5) (if (= (ffi-call "zyl_cstr_byte_at" n 0 1000) 108) 5 6) 0) 1000) 105) 1 0)
      (let wide (wide-args w rest)
        (if (= (ffi-call "zyl_cstr_byte_at" n 0 1000) 108)
          (match (parse-load-byte wide signed) (Some x x) (None (Expr (EUnknown n (convert-ast-list rest)))))
          (match (parse-store-byte wide signed) (Some x x) (None (Expr (EUnknown n (convert-ast-list rest))))))))))

; Replace the :le/:be selector with an EWide marker the byte parsers accept.
(defn wide-args (w rest)
  (match rest
    (Cons sel more
      (match (parse-endian-selector sel)
        (Some e (Cons (AstIdent (str-concat (if (= (endian-to-int e) 0) "le" "be") (str-concat "/" (ffi-call "zyl_int_text" w 1000)))) more))
        (None rest)))
    (Nil rest)))

; Dispatch a head-symbol to the byte-form parse helpers, preserving the
; outer no-dispatch fallback for non-byte names.
(defn byte-form-dispatch (n rest)
  (if (> (str-eq n "byte") 0)
    (match (parse-byte rest)
      (Some expr expr)
      (None (Expr (EUnknown "byte" (convert-ast-list rest)))))
  (if (> (str-eq n "load-u8") 0)
    (match (parse-load-byte rest 0)
      (Some expr expr)
      (None (Expr (EUnknown "load-u8" (convert-ast-list rest)))))
  (if (> (str-eq n "load-i8") 0)
    (match (parse-load-byte rest 1)
      (Some expr expr)
      (None (Expr (EUnknown "load-i8" (convert-ast-list rest)))))
  (if (> (str-eq n "store-u8") 0)
    (match (parse-store-byte rest 0)
      (Some expr expr)
      (None (Expr (EUnknown "store-u8" (convert-ast-list rest)))))
  (if (> (str-eq n "store-i8") 0)
    (match (parse-store-byte rest 1)
      (Some expr expr)
      (None (Expr (EUnknown "store-i8" (convert-ast-list rest)))))
  (if (> (str-eq n "byteslice") 0)
    (match (parse-byteslice rest)
      (Some expr expr)
      (None (Expr (EUnknown "byteslice" (convert-ast-list rest)))))
  (if (> (str-eq n "byteslice-sub") 0)
    (match (parse-byteslice-sub rest)
      (Some expr expr)
      (None (Expr (EUnknown "byteslice-sub" (convert-ast-list rest)))))
  (if (> (str-eq n "bytebuf") 0)
    (match (parse-bytebuf rest)
      (Some expr expr)
      (None (Expr (EUnknown "bytebuf" (convert-ast-list rest)))))
  (if (> (str-eq n "bytebuf-append") 0)
    (match (parse-bytebuf-append rest)
      (Some expr expr)
      (None (Expr (EUnknown "bytebuf-append" (convert-ast-list rest)))))
  (if (> (str-eq n "bytebuf-len") 0)
    (match (parse-bytebuf-unary rest 0)
      (Some expr expr)
      (None (Expr (EUnknown "bytebuf-len" (convert-ast-list rest)))))
  (if (> (str-eq n "bytebuf-cap") 0)
    (match (parse-bytebuf-unary rest 1)
      (Some expr expr)
      (None (Expr (EUnknown "bytebuf-cap" (convert-ast-list rest)))))
  (if (> (str-eq n "bytebuf-ptr") 0)
    (match (parse-bytebuf-unary rest 2)
      (Some expr expr)
      (None (Expr (EUnknown "bytebuf-ptr" (convert-ast-list rest)))))
  (if (> (str-eq n "align-check") 0)
    (match (parse-align-check rest)
      (Some expr expr)
      (None (Expr (EUnknown "align-check" (convert-ast-list rest)))))
  (if (> (str-eq n "bytebuf-atomic-load") 0)
    (match (parse-atomic-load rest)
      (Some expr expr)
      (None (Expr (EUnknown "bytebuf-atomic-load" (convert-ast-list rest)))))
  (if (> (str-eq n "bytebuf-atomic-store") 0)
    (match (parse-atomic-store rest)
      (Some expr expr)
      (None (Expr (EUnknown "bytebuf-atomic-store" (convert-ast-list rest)))))
  (if (> (str-eq n "bytebuf-atomic-add") 0)
    (match (parse-atomic-op3 rest 0)
      (Some expr expr)
      (None (Expr (EUnknown "bytebuf-atomic-add" (convert-ast-list rest)))))
  (if (> (str-eq n "bytebuf-atomic-sub") 0)
    (match (parse-atomic-op3 rest 1)
      (Some expr expr)
      (None (Expr (EUnknown "bytebuf-atomic-sub" (convert-ast-list rest)))))
  (if (> (str-eq n "bytebuf-atomic-fetch-add") 0)
    (match (parse-atomic-op3 rest 2)
      (Some expr expr)
      (None (Expr (EUnknown "bytebuf-atomic-fetch-add" (convert-ast-list rest)))))
  (if (> (str-eq n "bytebuf-atomic-max") 0)
    (match (parse-atomic-op3 rest 3)
      (Some expr expr)
      (None (Expr (EUnknown "bytebuf-atomic-max" (convert-ast-list rest)))))
  (if (> (str-eq n "bytebuf-atomic-min") 0)
    (match (parse-atomic-op3 rest 4)
      (Some expr expr)
      (None (Expr (EUnknown "bytebuf-atomic-min" (convert-ast-list rest)))))
  (if (> (str-eq n "bytebuf-atomic-cas") 0)
    (match (parse-atomic-cas rest)
      (Some expr expr)
      (None (Expr (EUnknown "bytebuf-atomic-cas" (convert-ast-list rest)))))
  (if (> (wide-byte-width n) 0)
    (parse-wide-byte n rest)
    (Expr (EApply n (convert-ast-list rest)))
  )))))))))))))))))))))))

; --- Special form parsers — extract typed structure from raw AList ----------

(defn to-list (ast)
  (match ast
    (AList lst lst)
    (_ Nil)))

(defn parse-defn (args)
  (match (ast-nth args 0 (AstInt 0))
    (AstIdent n
      (if (ast-has-at-least args 3)
        (Some
          (Expr
            (EDefn
              n
              (parse-params (ast-nth args 1 (AstInt 0)))
              (contract-defn-body n (ast-list-nth-rest args 2)))))
        None))
    (_ None)))

(defn parse-params (params)
  (match params
    (AList lst
      (match lst
        (Nil Nil)
        ((Cons p rest)
          (let hd (parse-single-param p)
            (let tl (parse-params (AList rest))
              (Cons hd tl))))))
    (_ Nil))

)
; A parameter is a bare name or `(name Type)` — nothing else.
;
; This used to accept any list at all, taking its head as the parameter's
; NAME and its second element as the parameter's TYPE, and to fall back to
; a parameter literally called "___" for every other shape. That is the
; shape one dropped `)` produces: `(defn f (p (+ p 1))` parses as a two-
; parameter list `p` and `(+ p 1)`, so `f` silently acquired a parameter
; named `+` of type `p`, and every following top-level form became part of
; f's body. The result was a well-formed program that means nothing anyone
; wrote, and on a real file it drove type inference into an allocation
; runaway. Reject the shape here, at the only point where it is still
; obviously a typo.
;
; was `(AList (Cons name (Cons typ rest)) body)` — a pattern nested TWO
; levels deep. The self-hosted parser's parse-match-arm only expands one
; level of wrapped-form nesting (see its own comment); a second nested
; Cons position isn't a plain identifier binding, so it got fed to
; convert-ast as if it were CODE to evaluate, not a pattern to
; destructure — corrupting field binding entirely ("rbp0"/undefined
; symbol at link time). Sequential matches sidestep the nesting.
(defn parse-single-param (p)
  (let r (parse-single-param-node p)
    (let _ (ffi-call "zyl_span_copy" r p 1000)
      r)))

(defn parse-single-param-node (p)
  (match p
    (AstIdent name (P name None))
    (AList lst (parse-param-list p lst))
    (_ (fail-malformed-param p))))

(defn parse-param-list (p lst)
  (match lst
    (Cons name tail
      (match tail
        (Cons typ rest
          (match rest
            (Nil (parse-param-typed p name typ))
            (_ (fail-malformed-param p))))
        (_ (fail-malformed-param p))))
    (_ (fail-malformed-param p))))

(defn parse-param-typed (p name typ)
  (match name
    (AstIdent n (P n (Some (convert-ast typ))))
    (_ (fail-malformed-param p))))

; Renders only the offending entry's own head, not the whole form: the
; point is to name what was written where a parameter belongs.
(defn param-form-text (p)
  (match p
    (AstIdent s s)
    (AstInt _ "an integer literal")
    (AstFloat _ "a float literal")
    (AString _ "a string literal")
    (AstBool _ "a boolean literal")
    (AList lst (param-list-text lst))))

(defn param-list-text (lst)
  (match lst
    (Nil "()")
    (Cons h _
      (let head (param-form-text h)
        (let open (str-concat "(" head)
          (str-concat open " ...)"))))))

(defn fail-malformed-param (p)
  (let what (param-form-text p)
    (let off (ffi-call "zyl_span_off" p 1000)
      (let fid (ffi-call "zyl_span_file" p 1000)
        (let m1 (str-concat "`" what)
          (let msg (str-concat m1 "` is not a parameter - write a name, or (name Type)")
            (let hint "a missing `)` earlier on the line puts the body inside the parameter list"
              (let text (err-at "E_MALFORMED_PARAMETER" msg fid off hint)
                (begin
                  (ffi-call "zyl_panic" text 1000)
                  (P "___" None))))))))))

(defn parse-deftype (args)
  (if (ast-has-at-least args 1)
    (match (ast-nth args 0 (AstInt 0))
      (AstIdent n
        (Some
          (Expr
            (EDeftype
              n
              (parse-adt-variants (ast-list-nth-rest args 1))
              Nil
              None))))
      (_ None))
    None))

; (defstruct Name (field [Type])*): a struct is lowered as sugar for a
; single-variant deftype whose variant name equals the type name — this
; lets icnf.zyl/codegen.zyl's existing ADT machinery (tag assignment,
; IVariant construction, IMatch field binding) build and read struct
; values with no separate field-offset system. Field type annotations
; are dropped, same as regular deftype variant fields.
(defn parse-defstruct (args)
  (if (ast-has-at-least args 1)
    (match (ast-nth args 0 (AstInt 0))
      (AstIdent n
        (Some
          (Expr
            (EDeftype
              n
              (Cons (record-field-types (AV n (parse-struct-fields (ast-list-nth-rest args 1))) (parse-struct-field-types (ast-list-nth-rest args 1))) Nil)
              Nil
              ; Marks this EDeftype as struct-sugar, not a real ADT — see
              ; icnf.zyl's ic-collect-vt, which gives ONLY structs a
              ; globally-unique tag (regular deftypes keep their existing
              ; per-deftype-from-0 numbering, unchanged, since renumbering
              ; those broke self-hosting outright).
              (Some "struct")))))
      (_ None))
    None))

; (impl Trait Type (defn method (params...) body)*): parsed but never
; constructed anywhere in this pipeline until now -- `dispatch-special`
; had no "impl" entry at all, so `(impl OutputStream Stdout ...)` fell
; through to a bare EApply "impl" (silently discarded by ic-toplevel,
; since it isn't EDefn/ETestDecl/ERunTests), and every method body
; inside it was lost with no error at all. Each (defn method ...) body
; is kept as-is (matching the Rust bootstrap's p_impl_block); a non-defn
; body inside an impl block doesn't occur anywhere in this corpus and is
; just skipped rather than guessed at.
(defn parse-impl (args)
  (if (ast-has-at-least args 3)
    (Some
      (Expr
        (EImplBlock
          (match (ast-nth args 0 (AstInt 0)) (AstIdent n n) (_ "___"))
          (match (ast-nth args 1 (AstInt 0)) (AstIdent n n) (_ "___"))
          (parse-impl-bodies (ast-list-nth-rest args 2)))))
    None))

(defn ds-impl-or-trait (n)
  (if (> (str-eq n "impl") 0) 1 (str-eq n "trait")))

(defn ds-impl-or-trait-form (n rest)
  (if (> (str-eq n "impl") 0)
    (match (parse-impl rest)
      (Some expr expr)
      (None (Expr (EUnknown "impl" (convert-ast-list rest)))))
    (match (parse-trait rest)
      (Some expr expr)
      (None (Expr (EUnknown "trait" (convert-ast-list rest)))))))

; (trait Name (method (params...) RetType)*)
(defn parse-trait (args)
  (match args
    (Cons nm methods
      (match nm
        (AstIdent n (Some (Expr (ETraitDecl n (parse-trait-methods methods) None))))
        (_ None)))
    (Nil None)))

(defn parse-trait-methods (ms)
  (match ms
    (Nil Nil)
    (Cons m rest
      (match m
        (AList parts (Cons (parse-trait-method parts) (parse-trait-methods rest)))
        (_ (parse-trait-methods rest))))))

; (name (params) [(p Type)...] Ret): forms between the list and Ret are extra params.
(defn parse-trait-method (parts)
  (let ret (if (ast-has-at-least parts 3) (ast-list-last parts (AstInt 0)) (AstInt 0))
    (TM (a-ident-to-str (ast-nth parts 0 (AstInt 0)))
        (list-append (parse-params (ast-nth parts 1 (AstInt 0))) (parse-trait-extra (ast-list-nth-rest parts 2)))
        (a-ident-to-str ret)
        (if (ast-has-at-least parts 3) (Some (convert-ast ret)) None))))

(defn parse-trait-extra (xs)
  (match xs
    (Nil Nil)
    (Cons h t (if (nil? t) Nil (Cons (parse-single-param h) (parse-trait-extra t))))))

(defn parse-impl-bodies (forms)
  (match forms
    (Nil Nil)
    (Cons f rest
      (match (Expr.inner (convert-ast f))
        (EDefn name params body (Cons (IB (DN name params body)) (parse-impl-bodies rest)))
        (_ (parse-impl-bodies rest))))))

(defn parse-struct-fields (specs)
  (match specs
    (Nil Nil)
    (Cons s rest (Cons (parse-struct-field-name s) (parse-struct-fields rest)))))

; Field type Exprs keyed by variant name, for compiler/type_annotate.
(defn record-field-types (av types)
  (let _ (ffi-call "zyl_smap_put" (ffi-call "zyl_smap_global" 0 1000) (AV.name av) types 1000)
    av))

; An untyped struct field records `_` (unknown type).
(defn parse-struct-field-types (specs)
  (match specs
    (Nil Nil)
    (Cons s rest (Cons (parse-struct-field-type s) (parse-struct-field-types rest)))))

(defn parse-struct-field-type (s)
  (match s
    (AList lst
      (match lst
        (Cons _ tl (match tl (Cons ty _ (convert-ast ty)) (Nil (Expr (EAtom (AIdent "_"))))))
        (Nil (Expr (EAtom (AIdent "_"))))))
    (_ (Expr (EAtom (AIdent "_"))))))

; A field spec is either a bare ident (untyped field) or `(name Type)`.
(defn parse-struct-field-name (s)
  (match s
    (AstIdent n n)
    (AList lst (match lst (Cons h _ (a-ident-to-str h)) (_ "")))
    (_ "")))

; All elements after the type name are variant specs (no trailing "body").
(defn ast-list-nth-rest (xs n)
  (if (= n 0)
    xs
    (match xs
      (Nil Nil)
      (Cons _ t (ast-list-nth-rest t (- n 1))))))

(defn parse-adt-variants (variants)
  (match variants
    (Nil Nil)
    ((Cons v rest)
      (Cons
        (parse-adt-variant v)
        (parse-adt-variants rest))))

)
(defn parse-adt-variant (v)
  ; was `(AList (Cons name rest) body)` — a FLAT-form arm whose sole field
  ; position is itself a nested list-pattern (AList has ONE field, a
  ; `List Ast`; that field's own Cons/Nil shape was being destructured
  ; INLINE in the same arm). The self-hosted parser has no equivalent of
  ; the Rust bootstrap's desugar_arm_raw (nested-pattern → fresh-var +
  ; inner-match desugaring) for either arm surface form, so the nested
  ; `(Cons name rest)` position got fed to convert-ast as CODE to
  ; evaluate ("Cons" called with args name/rest) instead of a pattern —
  ; "name"/"rest" never got bound at all ("rbp0"/undefined symbol at
  ; link time). Binding AList's field to one plain name, then
  ; destructuring THAT in a separate inner match, sidesteps the nesting
  ; entirely (same fix already applied to parse-single-param above).
  (match v
    (AstIdent name
      (AV name Nil))
    (AList lst
      (match lst
        (Cons name rest
          (record-field-types
            (AV
              (a-ident-to-str name)
              (parse-field-names rest))
            (convert-ast-list rest)))
        (_ (AV "___" Nil))))
    (_ (AV "___" Nil))))

(defn parse-field-names (fields)
  (match fields
    (Nil Nil)
    ((Cons f rest)
      (Cons
        (a-ident-to-str f)
        (parse-field-names rest)))))

(defn parse-def (args)
  (match (ast-nth args 0 (AstInt 0))
    (AstIdent n
      (if (ast-has-at-least args 2)
        (Some
          (Expr
            (EDef
              n
              (convert-ast (ast-nth args 1 (AstInt 0))))))
        None))
    (_ None)))

; Rust bootstrap's p_let (src/parser.rs) supports THREE surface forms:
;   1. (let name val body...)  -- flat, name a bare ident, >=3 args
;   2. (let name val)          -- flat, 2 args, implicit Unit body
;   3. (let (name val) body)   -- wrapped single-binding list
; This parser used to support ONLY form 1. Form 3 — used pervasively
; throughout type_system.zyl/type_inference.zyl/monomorphization.zyl —
; silently fell through to `None`, which the caller turns into an
; EUnknown node; EUnknown lowers to a harmless-looking (IConst 0) in
; icnf.zyl. Every function whose ENTIRE body was a form-3 `let`
; (inferer-new, infer-defn-body, ...) therefore compiled down to a bare
; "return 0", discarding all of its real work — the true cause behind a
; whole class of "silently returns garbage/null" bugs chased this
; session (e.g. ti-env dereferencing the null inferer-new result).
; Trailing "body" args (everything from `start` on) as ONE Expr: the lone
; expr directly when there's exactly one, an implicit EBegin sequence
; when there's more. A bare `(ast-list-last ...)` picks only the FINAL
; trailing arg — a 3-statement let/let-mut/defn body silently ran only
; its last statement, with every earlier one (including side-effecting
; `set!`s) discarded before it ever reached codegen.
; Sequence two already-converted body expressions. `EBegin` nesting is
; harmless regardless of what `b` itself already is (a bare expr,
; another EBegin, or an ELet/ELetMut whose own body already absorbed
; further statements below) -- evaluation order and the final value
; are the same either way.
(defn sequence-two (a b)
  (Expr (EBegin (Cons a (Cons b Nil)))))

; Combine a list of already-converted body expressions into one,
; letting a let/let-mut at a non-final position absorb everything
; after it as its own nested body, instead of the flat-sequence
; default of leaving it as a sibling statement. Matters because a
; let/let-mut used as a mid-sequence statement (not the sequence's
; sole/final expression) is meant to introduce a binding for the REST
; of the enclosing body -- e.g. `(let-mut i 0 (let-mut acc 0 BODY)
; (assert-equal acc N))`, where the outer let-mut's second body
; statement still reads `acc`, bound by the inner let-mut's OWN third
; argument-turned-sibling. Left as flat siblings (the previous
; behavior), the inner let-mut's own body is exactly its own third
; argument, its scope for `acc` ends there, and the following sibling
; statement reads `acc` as an unbound name -- silently wrong (falls
; back through env-lookup's unbound-name path, same failure shape as
; every other "reads as unbound" bug found this session) rather than
; erroring, since nothing here signals a scope violation. Built
; right-to-left: each element's "rest" is already the fully-built tail,
; so a let's new body is its own original body followed by that tail.
(defn build-sequenced-body (exprs)
  (match exprs
    (Nil (Expr (EAtom ANil)))
    (Cons only rest
      (match rest
        (Nil only)
        (Cons _ _
          (let restbody (build-sequenced-body rest)
            (match (Expr.inner only)
              (ELet name val body (Expr (ELet name val (sequence-two body restbody))))
              (ELetMut name val body (Expr (ELetMut name val (sequence-two body restbody))))
              (_ (sequence-two only restbody)))))))))

(defn parse-body-from (args start)
  (parse-body-list (ast-list-nth-rest args start)))

(defn parse-body-list (rest)
  (begin
    (if (<= (list-length rest) 1)
      (match rest
        (Nil (Expr (EAtom ANil)))
        (Cons only _ (convert-ast only)))
      (build-sequenced-body (convert-ast-list rest)))))

(defn parse-let (args)
  (match (ast-nth args 0 (AstInt 0))
    (AstIdent n
      (if (ast-has-at-least args 3)
        (Some
          (Expr
            (ELet
              n
              (convert-ast (ast-nth args 1 (AstInt 0)))
              (parse-body-from args 2))))
        (if (ast-has-at-least args 2)
          (Some
            (Expr
              (ELet
                n
                (convert-ast (ast-nth args 1 (AstInt 0)))
                (Expr (EAtom (AIdent "Unit"))))))
          None)))
    (AList blist
      (match blist
        (Cons bname _
          (match bname
            (AstIdent bn
              (if (ast-has-at-least args 2)
                (Some
                  (Expr
                    (ELet
                      bn
                      (convert-ast (ast-nth blist 1 (AstInt 0)))
                      (convert-ast (ast-nth args 1 (AstInt 0))))))
                None))
            (_ None)))
        (_ None)))
    (_ None)))

(defn parse-let-mut (args)
  (match (ast-nth args 0 (AstInt 0))
    (AstIdent n
      (if (ast-has-at-least args 3)
        (Some
          (Expr
            (ELetMut
              n
              (convert-ast (ast-nth args 1 (AstInt 0)))
              (parse-body-from args 2))))
        (if (ast-has-at-least args 2)
          (Some
            (Expr
              (ELetMut
                n
                (convert-ast (ast-nth args 1 (AstInt 0)))
                (Expr (EAtom (AIdent "Unit"))))))
          None)))
    (AList blist
      (match blist
        (Cons bname _
          (match bname
            (AstIdent bn
              (if (ast-has-at-least args 2)
                (Some
                  (Expr
                    (ELetMut
                      bn
                      (convert-ast (ast-nth blist 1 (AstInt 0)))
                      (convert-ast (ast-nth args 1 (AstInt 0))))))
                None))
            (_ None)))
        (_ None)))
    (_ None)))

; A 2-arg `(if cond then)` (no else) is common inside macro-expanded
; unless/when-style bodies (e.g. `(if (not cond) body)`) — it used to
; require exactly 3 args and fall through to a meaningless EUnknown
; otherwise, which icnf.zyl's catch-all silently lowers to a constant 0
; regardless of the condition. Default the missing else to nil/unit.
(defn parse-if (args)
  (if (ast-has-at-least args 3)
    (Some
      (Expr
        (EIf
          (convert-ast (ast-nth args 0 (AstInt 0)))
          (convert-ast (ast-nth args 1 (AstInt 0)))
          (convert-ast (ast-nth args 2 (AstInt 0))))))
    (if (ast-has-at-least args 2)
      (Some
        (Expr
          (EIf
            (convert-ast (ast-nth args 0 (AstInt 0)))
            (convert-ast (ast-nth args 1 (AstInt 0)))
            (Expr (EAtom ANil)))))
      None)))

(defn parse-while (args)
  (if (ast-has-at-least args 2)
    (Some
      (Expr
        (EWhile
          (convert-ast (ast-nth args 0 (AstInt 0)))
          (parse-body-from args 1))))
    None))

(defn parse-for (args)
  (if (ast-has-at-least args 3)
    (Some
      (Expr
        (EFor
          (parse-for-bindings (ast-nth args 0 (AstInt 0)))
          (convert-ast (ast-nth args 1 (AstInt 0)))
          (parse-body-from args 2))))
    None))

; The binding section of a `for` accepts two shapes:
;
;   (for ((i 0) (j 1)) cond body)   a LIST of bindings
;   (for (i 0) cond body)           ONE binding, unwrapped
;
; The second is what every `for` in this corpus actually writes, and it
; used to be mis-parsed: the list was walked element by element, so
; `(i 16)` became the two bindings `i` (no initializer) and `16`
; (unnamed) -- and a binding with no initializer starts at 0. A loop
; written `(for (i 16) ...)` therefore silently started at 0, which is
; invisible for the overwhelmingly common `(for (i 0) ...)` and a
; miscompile for anything else.
;
; The two shapes are told apart by the first element: an identifier
; means the shorthand, a nested list means a real binding list.
(defn parse-for-bindings (bindings)
  (match bindings
    (AList lst
      (match lst
        (Nil Nil)
        ((Cons binding rest)
          (if (> (parse-for-is-ident binding) 0)
            (Cons (parse-for-binding (AList lst)) Nil)
            (let hd (parse-for-binding binding)
              (let tl (parse-for-bindings (AList rest))
                (Cons hd tl)))))))
    (_ Nil))

)

; 1 when the Ast node is a bare identifier.
(defn parse-for-is-ident (node)
  (match node
    (AstIdent _ 1)
    (_ 0)))
(defn parse-for-binding (binding)
  ; same nested-field-position bug as parse-adt-variant above.
  (match binding
    (AstIdent name
      (Pair name None))
    (AList lst
      (match lst
        (Cons name rest
          (Pair
            (a-ident-to-str name)
            (if (nil? rest)
              None
              (Some (convert-ast (ast-list-last rest (AstInt 0)))))))
        (_ (Pair "___" None))))
    (_ (Pair "___" None))))

; `ECond` (the node parse-cond used to build directly) has no icnf.zyl/
; codegen.zyl lowering anywhere — monomorphization.zyl/type_inference.zyl
; recurse into it, but ic-expr's wildcard default silently drops any
; unhandled ExprInner shape to a bare (IConst 0). Every `cond` in the
; entire self-hosted compiler's own source (infer-arg-type-atom's AIdent
; arm among them) therefore compiled down to a literal "0", discarding
; the whole clause chain. Desugar to nested `if` here instead, at the
; source level (same fix already applied to `or`/`and` above) — so every
; downstream phase only ever sees plain EIf nodes.
(defn parse-cond (args)
  (if (nil? args)
    None
    (Some (cond-fold (parse-cond-clauses (AList args))))))

(defn cond-fold (clauses)
  (match clauses
    (Nil (Expr (EAtom ANil)))
    (Cons c rest
      (match c
        (Pair test body
          (Expr (EIf test body (cond-fold rest))))))))

; `or`/`and` aren't recognized as builtins anywhere in codegen (Rust or
; self-hosted) — desugar to nested `if` here instead, at the SOURCE
; level, so every downstream phase only ever sees plain EIf nodes (this
; language has no short-circuit evaluation anyway — every argument is
; always eagerly evaluated — so desugaring loses nothing).
(defn parse-or (args)
  (if (nil? args)
    (Some (Expr (EAtom (ABool false))))
    (Some (or-fold (convert-ast-list args)))))

(defn or-fold (exprs)
  (match exprs
    (Nil (Expr (EAtom (ABool false))))
    (Cons e rest
      (match rest
        (Nil e)
        (_ (Expr (EIf e (Expr (EAtom (ABool true))) (or-fold rest))))))))

(defn parse-and (args)
  (if (nil? args)
    (Some (Expr (EAtom (ABool true))))
    (Some (and-fold (convert-ast-list args)))))

(defn and-fold (exprs)
  (match exprs
    (Nil (Expr (EAtom (ABool true))))
    (Cons e rest
      (match rest
        (Nil e)
        (_ (Expr (EIf e (and-fold rest) (Expr (EAtom (ABool false))))))))))

; `not` isn't a codegen builtin either — desugar to `(if x false true)`.
(defn parse-not (args)
  (match args
    (Cons a _
      (Some (Expr (EIf (convert-ast a) (Expr (EAtom (ABool false))) (Expr (EAtom (ABool true)))))))
    (_ None)))

(defn parse-cond-clauses (ast)
  (match ast
    (AList lst
      (match lst
        (Nil Nil)
        ((Cons clause rest)
          (let hd (parse-cond-clause clause)
            (let tl (parse-cond-clauses (AList rest))
              (Cons hd tl))))))
    (_ Nil))

)
(defn parse-cond-clause (clause)
  ; `else` as a cond-test is never specially recognized anywhere in this
  ; toolchain (grepped the whole stdlib/compiler + Rust src: zero matches
  ; for the literal "else") — it's just parsed as an ordinary identifier,
  ; which is unresolved and silently compiles to 0/false. That meant every
  ; `(else BODY)` fallback clause in every `cond` in the entire codebase
  ; NEVER fired. Special-case it here to the literal `true`, matching
  ; standard Lisp/Scheme `cond` semantics.
  (match clause
    (AList kids
      (Pair
        (convert-ast (cond-test-ast (ast-nth kids 0 (AstInt 0))))
        (convert-ast (ast-list-last kids (AstInt 0)))))
    (_ (Pair (Expr (EAtom ANil)) (Expr (EAtom ANil))))))

(defn cond-test-ast (test)
  (match test
    (AstIdent name (if (= name "else") (AstBool true) test))
    (_ test)))

; --- Literal-pattern match: desugars to a nested if/else chain ------------
;
; `match`'s real arm grammar (parse-match-arm, below) dispatches on ADT
; variant tags (icnf.zyl's vt-tag-of / codegen.zyl's cg-tag-check, which
; dereferences the scrutinee as a heap pointer to read a tag word) --
; there was never a path for a bare literal pattern like `0` or `"x"`,
; which isn't a registered variant name. vt-tag-of returned its "not
; found" sentinel (-1) for any such pattern, which codegen treats
; identically to a wildcard `_` (skip the comparison, always match) --
; so the FIRST literal/unrecognized arm silently won unconditionally,
; and the arm's own body (parsed by parse-match-arm's own catch-all)
; collapsed to `(EAtom ANil)`, losing the literal's actual value
; entirely. See docs/rust-eviction-plan.md for the full writeup.
;
; Fixed by recognizing this shape at parse time and desugaring it
; entirely separately from ordinary ADT matches, rather than bending
; vt-tag-of/cg-tag-check's pointer-based dispatch to also understand
; raw values: `(match a (0 body0) (1 body1) ... (_ bodyN))` becomes
; `(let __match_scrutinee__ a (if (= __match_scrutinee__ 0) body0 (if
; (= __match_scrutinee__ 1) body1 ... bodyN)))`, binding the scrutinee
; once (so a side-effecting scrutinee expression isn't re-evaluated per
; arm) and reusing the `=` operator's own existing per-kind dispatch
; (cg-strbinop for strings, plain cmp for int/bool, SSE ucomisd for
; float -- all already correct, unrelated to this change). A trailing
; `_` is REQUIRED and enforced as a hard compile error, not silently
; allowed to fall through to some default the way ADT-match's own
; unrecognized-pattern catch-all silently did before this fix.
;
; Deliberately does NOT support mixing a literal pattern and an ADT
; constructor pattern in the SAME match: the two dispatch mechanisms
; are fundamentally different (raw-value comparison vs. pointer-tag
; dereference), and unifying them into one decision procedure the way
; Rust's match compiler does is a much larger redesign, out of scope
; here. A match is treated as "literal-pattern" the moment ANY one of
; its arms has a literal head; every other non-wildcard arm is then
; expected to also have a literal head.
; A range pattern is written `(range lo hi)` -- a plain nested list, no
; new lexer syntax needed (this language has no infix `1..10` token at
; all; inventing one would mean touching the lexer, a much bigger and
; more foundational change than this fix warrants). Inclusive both
; ends, matching Rust's `lo..=hi`.
(defn ast-is-range-pattern (h)
  (match h
    (AList kids
      (match kids
        (Cons head _
          (match head
            (AstIdent n (str-eq n "range"))
            (_ 0)))
        (Nil 0)))
    (_ 0)))

(defn ast-range-lo (h)
  (match h
    (AList kids (ast-nth kids 1 (AstInt 0)))
    (_ (AstInt 0))))

(defn ast-range-hi (h)
  (match h
    (AList kids (ast-nth kids 2 (AstInt 0)))
    (_ (AstInt 0))))

; A guard is written `(when cond)` as the LAST element before an arm's
; body, e.g. `(0 (when debug-mode) body)` -- Rust's `pattern if cond =>
; body`, just s-expression-shaped instead of infix, for the same reason
; ranges are (no new lexer syntax). Narrower than Rust's guards: a
; literal pattern binds no names, so a guard here can only reference
; outer-scope variables, never anything extracted from the pattern
; itself (there's nothing to extract) -- flagged as a real limitation
; when this was scoped, not a hidden one. NOT supported on the trailing
; wildcard arm: a failed guard there has nowhere left to fall through
; to (Rust makes this a runtime panic; replicating that is more
; machinery than this fix's scope), so a `(when ...)` on `_` is
; silently ignored rather than enforced -- an accepted, narrow gap.
(defn ast-is-guard-marker (h)
  (match h
    (AList kids
      (match kids
        (Cons head _
          (match head
            (AstIdent n (str-eq n "when"))
            (_ 0)))
        (Nil 0)))
    (_ 0)))

(defn ast-guard-cond (h)
  (match h
    (AList kids (ast-nth kids 1 (AstBool true)))
    (_ (AstBool true))))

; An arm's "middles": everything in the arm's list before the body,
; e.g. `(1 2 3 body)` -> [1, 2, 3], possibly ending in a `(when ...)`
; guard marker.
(defn ast-arm-middles (arm)
  (match arm
    (AList kids (ast-list-butlast kids))
    (_ (Cons (AstIdent "_") Nil))))

; Pattern alternatives only (guard marker, if any, stripped): more than
; one is an OR-pattern (matches the scrutinee against ANY of them),
; same idea as Rust's `1 | 2 | 3 => ...`. Each alternative is either a
; plain literal or a `(range lo hi)` form.
(defn ast-pattern-alts (arm)
  (let middles (ast-arm-middles arm)
    (if (nil? middles)
      middles
      (let last1 (ast-list-last middles (AstIdent "_"))
        (if (> (ast-is-guard-marker last1) 0)
          (ast-list-butlast middles)
          middles)))))

(defn ast-arm-guard-of (arm)
  (let middles (ast-arm-middles arm)
    (if (nil? middles)
      None
      (let last1 (ast-list-last middles (AstIdent "_"))
        (if (> (ast-is-guard-marker last1) 0)
          (Some (ast-guard-cond last1))
          None)))))

(defn ast-is-literal-head (h)
  (if (> (ast-is-range-pattern h) 0)
    1
    (match h
      (AstInt _ 1)
      (AstFloat _ 1)
      (AString _ 1)
      (AstBool _ 1)
      (_ 0))))

(defn ast-first-alt (alts)
  (match alts
    (Nil (AstIdent "_"))
    (Cons h _ h)))

(defn match-has-literal-head (raw-arms)
  (match raw-arms
    (Nil 0)
    (Cons arm rest
      (if (> (ast-is-literal-head (ast-first-alt (ast-pattern-alts arm))) 0)
        1
        (match-has-literal-head rest)))))

; Any bare identifier counts as the trailing wildcard, not just `_`
; specifically -- matches this codebase's own pervasive ADT-match
; convention (an unresolved name isn't a registered variant, so
; vt-tag-of/cg-tag-check already treat it as a universal catchall;
; `d1`/`d2`/... throwaway names are used this way hundreds of times
; already, e.g. type_system.zyl's binop-kind-from-int). Requiring
; literally `_` here would be a second, inconsistent wildcard
; convention alongside the one ADT matches already have.
(defn ast-pattern-is-wildcard (h)
  (match h
    (AstIdent n 1)
    (_ 0)))

; A wildcard arm is exactly one alternative, `_` -- `(_ x body)` (a
; wildcard alongside something else) isn't treated as one, since that
; would be ambiguous about which case actually applies.
(defn ast-pattern-is-wildcard-alts (alts)
  (match alts
    (Nil 0)
    (Cons h t (if (nil? t) (ast-pattern-is-wildcard h) 0))))

(defn ast-list-is-last-wildcard (raw-arms)
  (match raw-arms
    (Nil 0)
    (Cons arm t
      (if (nil? t)
        (ast-pattern-is-wildcard-alts (ast-pattern-alts arm))
        (ast-list-is-last-wildcard t)))))

(defn literal-arm-body (arm)
  (match arm
    (AList kids (convert-ast (ast-list-last kids (AstInt 0))))
    (_ (Expr (EAtom ANil)))))

(defn literal-cmp-test (scrutinee-name op-name bound)
  (Expr
    (ECall
      (Expr (EAtom (AIdent op-name)))
      (Cons (Expr (EAtom (AIdent scrutinee-name)))
            (Cons (convert-ast bound) Nil)))))

(defn literal-eq-test (scrutinee-name alt)
  (literal-cmp-test scrutinee-name "=" alt))

; `lo <= scrutinee <= hi`, same short-circuiting EIf shape `and` itself
; already uses (and-fold, above).
(defn literal-range-test (scrutinee-name h)
  (Expr
    (EIf
      (literal-cmp-test scrutinee-name ">=" (ast-range-lo h))
      (literal-cmp-test scrutinee-name "<=" (ast-range-hi h))
      (Expr (EAtom (ABool false))))))

(defn literal-one-test (scrutinee-name alt)
  (if (> (ast-is-range-pattern alt) 0)
    (literal-range-test scrutinee-name alt)
    (literal-eq-test scrutinee-name alt)))

; OR-chain across one arm's alternatives: matches when the scrutinee
; equals (or falls within the range of) ANY of them. Same
; short-circuiting EIf desugaring `or` itself already uses (or-fold,
; above) -- just built from value/range tests instead of arbitrary
; sub-expressions.
(defn literal-alts-test (scrutinee-name alts)
  (match alts
    (Nil (Expr (EAtom (ABool false))))
    (Cons a rest
      (match rest
        (Nil (literal-one-test scrutinee-name a))
        (_ (Expr
              (EIf
                (literal-one-test scrutinee-name a)
                (Expr (EAtom (ABool true)))
                (literal-alts-test scrutinee-name rest))))))))

; One arm's full test: its alternatives, ANDed with its guard condition
; if it has one.
(defn literal-arm-test (scrutinee-name arm alts)
  (let atest (literal-alts-test scrutinee-name alts)
    (match (ast-arm-guard-of arm)
      (Some cond (Expr (EIf atest (convert-ast cond) (Expr (EAtom (ABool false))))))
      (None atest))))

; Build nested EIf comparing the bound scrutinee against each arm's
; alternatives (and guard, if any) in turn. The last arm (already
; checked to be `_` by the caller) supplies the base case body
; directly, with no comparison -- see ast-is-guard-marker's own comment
; for why a guard on the wildcard arm itself is silently ignored.
(defn build-literal-chain (scrutinee-name raw-arms)
  (match raw-arms
    (Nil (Expr (EAtom ANil)))
    (Cons arm rest
      (let alts (ast-pattern-alts arm)
        (if (> (ast-pattern-is-wildcard-alts alts) 0)
          (literal-arm-body arm)
          (Expr
            (EIf
              (literal-arm-test scrutinee-name arm alts)
              (literal-arm-body arm)
              (build-literal-chain scrutinee-name rest))))))))

(defn parse-literal-match (scrutinee-ast raw-arms)
  (if (> (ast-list-is-last-wildcard raw-arms) 0)
    (Expr
      (ELet "__match_scrutinee__"
            (convert-ast scrutinee-ast)
            (build-literal-chain "__match_scrutinee__" raw-arms)))
    (begin
      (ffi-call "zyl_panic" "E_MATCH_NONEXHAUSTIVE: a literal-pattern match must end with a `_` arm" 1000)
      (Expr (EAtom ANil)))))

; Match arms are every element AFTER the subject: `(match subject arm1 arm2
; ...)` — NOT one single list-wrapped argument, so `parse-match-arms` takes
; a plain `List Ast` of arm-forms directly (args[1..]), one recursive step
; at a time, same as the old Ast-based icnf.zyl's `ic-arms` did.
(defn parse-match (args)
  (if (ast-has-at-least args 2)
    (let scrutinee-ast (ast-nth args 0 (AstInt 0))
      (let raw-arms (ast-list-nth-rest args 1)
        (if (> (match-has-literal-head raw-arms) 0)
          (Some (parse-literal-match scrutinee-ast raw-arms))
          (Some
            (Expr
              (EMatch
                (convert-ast scrutinee-ast)
                (parse-match-arms raw-arms)))))))
    None))

(defn parse-match-arms (arms)
  (match arms
    (Nil Nil)
    (Cons arm rest
      (Cons (parse-match-arm arm) (parse-match-arms rest)))))
; Two accepted arm surface forms (matching the Rust bootstrap's
; decompose_match_arm — see ast.rs):
;   flat:    (VariantName pat* body)   — kids[0] is a bare identifier
;   wrapped: ((VariantName pat*) body) — kids[0] is itself a nested list
; This used to handle ONLY the flat form: `(match pattern (AstIdent n n)
; (d1 "___"))` silently fell to the wildcard "___" placeholder whenever
; kids[0] was a list (the wrapped form), so every `((Variant a b) body)`
; arm anywhere in the self-hosted compiler's OWN source resolved to a
; nonexistent "___" variant — an unresolved name that lowers to the
; sentinel wildcard discriminant, permanently unreachable at runtime and
; miscompiling the field bindings into codegen's unresolved-variable
; fallback path ("[rbp0]"/undefined `rbp0` symbol at link time).
(defn parse-match-arm (arm)
  (match arm
    (AList kids
      (match kids
        (Nil (MA "___" Nil (Expr (EAtom ANil))))
        (Cons pattern rest
          (match pattern
            (AstIdent n
              (MA
                n
                (convert-ast-list (ast-list-butlast rest))
                (convert-ast (ast-list-last rest (AstInt 0)))))
            (AList pkids
              (match pkids
                (Cons vname vfields
                  (MA
                    (match vname (AstIdent n2 n2) (_ "___"))
                    (convert-ast-list vfields)
                    (convert-ast (ast-list-last rest (AstInt 0)))))
                (_ (MA "___" Nil (Expr (EAtom ANil))))))
            (_ (MA "___" Nil (Expr (EAtom ANil))))))))
    (_ (MA "___" Nil (Expr (EAtom ANil))))))

; (try body (catch name handler)) — exactly 2 top-level args, the
; second being a NESTED `(catch name handler)` list, matching the Rust
; bootstrap's p_try. This used to expect a flat 3-arg
; `(try body name handler)` shape that nothing in the actual language
; (or this corpus) ever writes — `ast-has-at-least args 3` was false for
; every real `try`, so parse-try always returned None and every `try`
; in the codebase fell through as an unrecognized EUnknown form.
(defn parse-try (args)
  (if (ast-has-at-least args 2)
    (match (ast-nth args 1 (AstInt 0))
      (AList catch-kids
        (match catch-kids
          (Cons catch-kw catch-rest
            (match catch-rest
              (Cons name-ast handler-rest
                (Some
                  (Expr
                    (ETryCatch
                      (convert-ast (ast-nth args 0 (AstInt 0)))
                      (match name-ast (AstIdent n n) (_ "___"))
                      (convert-ast (ast-list-last handler-rest (AstInt 0)))))))
              (_ None)))
          (_ None)))
      (_ None))
    None))

(defn parse-begin (args)
  (match args
    (Nil (Some (Expr (EBegin Nil))))
    (_ (Some (Expr (EBegin (convert-ast-list args))))))

)
; `lambda` and `fn` are fully equivalent anonymous-function syntax --
; everywhere both ELambda and EFn are handled (type_inference.zyl's
; infer-expr-lambda, monomorphization.zyl's subst-expr) they do exactly
; the same thing. But icnf.zyl (the final Icnf lowering), closure_inline
; .zyl, trait_dispatch.zyl, macro_expand.zyl, and module_resolver.zyl
; never learned about ELambda, only EFn -- so a `lambda` silently fell
; through icnf.zyl's "unsupported shape" catchall to a bare (IConst 0),
; and calling it jumped to address 0. Rather than teach every one of
; those passes about a second, functionally-identical closure node
; type, parse-lambda now builds an EFn directly: `lambda` was always
; meant to be indistinguishable from `fn`, so make it actually be the
; same node from the moment it's parsed.
(defn parse-lambda (args)
  (if (ast-has-at-least args 2)
    (Some
      (Expr
        (EFn
          "___"
          (parse-params (ast-nth args 0 (AstInt 0)))
          (convert-ast (ast-list-last args (AstInt 0))))))
    None))

(defn parse-fn (args)
  (if (ast-has-at-least args 2)
    (Some
      (Expr
        (EFn
          "___"
          (parse-params (ast-nth args 0 (AstInt 0)))
          (convert-ast (ast-list-last args (AstInt 0))))))
    None))

(defn parse-print (args)
  (Some (Expr (EPrint (convert-ast-list args)))))

(defn parse-assert-equal (args)
  (if (ast-has-at-least args 2)
    (Some
      (Expr
        (EAssertEqual
          (convert-ast (ast-nth args 0 (AstInt 0)))
          (convert-ast (ast-nth args 1 (AstInt 0))))))
    None))

(defn parse-assert (args)
  (if (ast-has-at-least args 2)
    (Some
      (Expr
        (EAssert
          (convert-ast (ast-nth args 0 (AstInt 0)))
          (Some (convert-ast (ast-list-last args (AstInt 0)))))))
    (if (ast-has-at-least args 1)
      (Some
        (Expr
          (EAssert
            (convert-ast (ast-nth args 0 (AstInt 0)))
            None)))
      None)))

(defn parse-assert-true (args)
  (if (ast-has-at-least args 1)
    (Some
      (Expr
        (EAssertTrue
          (convert-ast (ast-nth args 0 (AstInt 0)))
          (ast-string-opt (ast-nth args 1 (AstInt 0))))))
    None))

(defn ast-string-opt (a)
  (match a
    (AString t (Some t))
    (_ None)))

(defn parse-assert-false (args)
  (if (ast-has-at-least args 1)
    (Some
      (Expr
        (EAssertFalse
          (convert-ast (ast-nth args 0 (AstInt 0)))
          None)))
    None))

(defn parse-assert-fail (args)
  (if (ast-has-at-least args 1)
    (Some
      (Expr
        (EAssertFail
          (convert-ast (ast-nth args 0 (AstInt 0)))
          None)))
    None))

(defn parse-spawn (args)
  (if (nil? args)
    None
    (Some (Expr (ESpawn (convert-ast (ast-nth args 0 (AstInt 0))))))))

(defn parse-send (args)
  (if (ast-has-at-least args 2)
    (Some
      (Expr
        (ESend
          (convert-ast (ast-nth args 0 (AstInt 0)))
          (convert-ast (ast-nth args 1 (AstInt 0))))))
    None))

(defn parse-ffi-pin (args)
  (if (nil? args)
    None
    (Some (Expr (EFfiPin (convert-ast (ast-nth args 0 (AstInt 0))))))))

(defn parse-ffi-unpin (args)
  (if (nil? args)
    None
    (Some (Expr (EFfiUnpin (convert-ast (ast-nth args 0 (AstInt 0))))))))

(defn parse-exit (args)
  (if (nil? args)
    None
    (Some (Expr (EExit (convert-ast (ast-nth args 0 (AstInt 0))))))))

(defn parse-close (args)
  (if (nil? args)
    None
    (Some (Expr (EClose (convert-ast (ast-nth args 0 (AstInt 0))))))))

(defn parse-file-open (args)
  (if (ast-has-at-least args 2)
    (Some
      (Expr
        (EFileOpen
          (convert-ast (ast-nth args 0 (AstInt 0)))
          (convert-ast (ast-nth args 1 (AstInt 0))))))
    None))

(defn parse-file-read (args)
  (if (ast-has-at-least args 2)
    (Some
      (Expr
        (EFileRead
          (convert-ast (ast-nth args 0 (AstInt 0)))
          (convert-ast (ast-nth args 1 (AstInt 0))))))
    None))

(defn parse-file-write (args)
  (if (ast-has-at-least args 2)
    (Some
      (Expr
        (EFileWrite
          (convert-ast (ast-nth args 0 (AstInt 0)))
          (convert-ast (ast-nth args 1 (AstInt 0))))))
    None))

(defn parse-file-close (args)
  (if (nil? args)
    None
    (Some (Expr (EFileClose (convert-ast (ast-nth args 0 (AstInt 0))))))))

; `set!`'s target must be a bare identifier bound via let-mut (spec/07
; S10: "Direct field mutation (set! (struct-get p x) 5) is FORBIDDEN" --
; the whole struct must be rebound instead). Previously, any non-
; identifier first argument (exactly that forbidden shape) silently
; fell through to a placeholder name ("___") instead of being rejected,
; so `(set! (struct-get p x) 5)` compiled into an ESetBang against a
; nonexistent variable -- surfacing later as a baffling linker error
; ("undefined reference") instead of a clear diagnostic at the point of
; the actual mistake.
(defn parse-set-bang (args)
  (if (ast-has-at-least args 2)
    (match (ast-nth args 0 (AstInt 0))
      (AstIdent n
        (Some (Expr (ESetBang n (convert-ast (ast-nth args 1 (AstInt 0)))))))
      (_ (ffi-call "zyl_panic" "E_MUT_CONFLICT: set! target must be a plain variable name bound via let-mut -- direct field/expression mutation is forbidden, rebind the whole variable instead" 1000)))
    None))

(defn parse-module (args)
  (if (nil? args)
    None
    (Some
      (Expr
        (EModuleDecl
          (match (ast-nth args 0 (AstInt 0))
            (AstIdent n n)
            (_ "___")))))))

(defn parse-use (args)
  (Some (Expr (EUseModule (parse-idents args) None false))))

(defn parse-idents (xs)
  (match xs
    (Nil Nil)
    (Cons h t (Cons (a-ident-to-str h) (parse-idents t)))))

(defn parse-export (args)
  (if (nil? args)
    None
    (Some
      (Expr
        (EExport
          (match (ast-nth args 0 (AstInt 0))
            (AstIdent n n)
            (_ "___")))))))

(defn parse-derive (args)
  (if (ast-has-at-least args 1)
    (Some
      (Expr
        (EDerive
          (match (ast-nth args 0 (AstInt 0)) (AstIdent n n) (_ "___"))
          (parse-derive-traits (ast-list-nth-rest args 1)))))
    None))

; `(derive T Show Eq)` or `(derive T [Show Eq])`.
(defn parse-derive-traits (xs)
  (match xs
    (Nil Nil)
    (Cons t rest
      (match t
        (AList inner (list-append (parse-derive-traits inner) (parse-derive-traits rest)))
        (_ (let hd (match t (AstIdent n n) (_ "___"))
             (Cons hd (parse-derive-traits rest))))))))

(defn parse-macro (args)
  (match (ast-nth args 0 (AstInt 0))
    (AstIdent n
      (if (ast-has-at-least args 3)
        (Some
          (Expr
            (EMacroDef
              n
              (convert-ast-list (to-list (ast-nth args 1 (AstInt 0))))
              (convert-ast (ast-list-last args (AstInt 0))))))
        None))
    (_ None)))

(defn parse-test (args)
  (if (ast-has-at-least args 2)
    (Some
      (Expr
        (ETestDecl
          (match (ast-nth args 0 (AstInt 0))
            (AstIdent n n)
            (AString n n)
            (_ "___"))
          (convert-ast (ast-list-last args (AstInt 0)))
          None)))
    None))

(defn parse-test-suite (_args)
  (Some (Expr (ETestSuite "___" Nil None))))

(defn parse-setup (args)
  (Some (Expr (ESetup (convert-ast-list args)))))

(defn parse-teardown (args)
  (Some (Expr (ETeardown (convert-ast-list args)))))

; (with-resource (name init) body): the binding is a single parenthesized
; (name init) pair -- both this file's own header comment and every
; regression/with-resource.zyl call site use exactly that shape, same
; convention as parse-let's `(let (name value) body)` form. The
; previous version expected three flat top-level args (name, init,
; body) with no such call site anywhere, so `(ast-has-at-least args 3)`
; was false for the real (2-arg: binding-pair, body) syntax, parsing
; always fell through to `(Expr (EUnknown "with-resource" ...))`, and
; EUnknown -- like every other unhandled/malformed shape -- lowers to a
; harmless (IConst 0) in icnf.zyl's ic-expr, silently discarding both
; the binding and the body instead of erroring.
(defn parse-with-resource (args)
  (match (ast-nth args 0 (AstInt 0))
    (AList blist
      (match blist
        (Cons bname _
          (match bname
            (AstIdent bn
              (if (ast-has-at-least args 2)
                (Some
                  (Expr
                    (EWithResource
                      bn
                      (convert-ast (ast-nth blist 1 (AstInt 0)))
                      (convert-ast (ast-nth args 1 (AstInt 0))))))
                None))
            (_ None)))
        (_ None)))
    (_ None)))

(defn parse-make-struct (args)
  (if (ast-has-at-least args 1)
    (Some
      (Expr
        (EMakeStruct
          (match (ast-nth args 0 (AstInt 0)) (AstIdent n n) (_ "___"))
          (convert-ast-list (ast-list-nth-rest args 1)))))
    None))

(defn parse-struct-get (args)
  (if (ast-has-at-least args 2)
    (Some
      (Expr
        (EStructGet
          (convert-ast (ast-nth args 0 (AstInt 0)))
          (match (ast-nth args 1 (AstInt 0))
            (AstIdent n n)
            (AString n n)
            (_ "")))))
    None))

(defn parse-make-variant (args)
  (if (ast-has-at-least args 2)
    (match (ast-nth args 0 (AstInt 0))
      (AList adt-kids
        (Some
          (Expr
            (EMakeVariant
              (match (ast-nth adt-kids 0 (AstInt 0)) (AstIdent n n) (_ "___"))
              (match (ast-nth args 1 (AstInt 0)) (AstIdent n n) (_ "___"))
              (convert-ast-list (ast-list-nth-rest args 2))))))
      (_ None))
    None))

(defn parse-unwrap (args)
  (if (nil? args)
    None
    (Some (Expr (EUnwrap (convert-ast (ast-nth args 0 (AstInt 0))))))))

(defn parse-test-property (_args)
  (Some (Expr (ETestProperty "___" (GenInt) (Expr (EAtom ANil))))))

(defn parse-test-compile (_args)
  (Some (Expr (ETestCompile (Expr (EAtom ANil)) None))))

; ===========================================================================
; UTILITY HELPERS
; ===========================================================================

(defn a-ident-to-str (ast)
  (match ast
    (AstIdent s s)
    (_ "")))

(defn nil? (xs)
  (match xs
    (Nil true)
    (_ false)))

(defn to-expr-list (ast)
  (match ast
    (AList lst (convert-ast-list lst))
    (_ Nil)))
