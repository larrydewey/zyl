; === Zyl Compiler — ExprInner AST Bridge ===
; Port of Rust ast.rs ExprInner enum to Zyl deftype/match form.
;
; The Zyl parser produces raw Ast (AIdent/AInt/AList).
; type_inference.zyl expects ExprInner (Atom/Call/Defn/.../Apply).
; This module bridges that gap.
;
; Structure:
;   1. ExprInner ADT mirrors Rust ExprInner (lines 53-115 ast.rs)
;   2. Supporting ADTs (Param, MatchArm, ADTVariant, etc.)
;   3. Ast → ExprInner converter (convert-ast function)
;   4. Expr wrapper (Expr + ExprInner pattern expected by inference)

; ===========================================================================
; EXPR INNER — mirrors Rust ast.rs ExprInner
; ===========================================================================

(deftype ExprInner
  (EAtom Atom)
  (ECall Expr (List Expr))
  (EDef String Expr)
  (EDefn String (List Param) Expr)
  (ELet String Expr Expr)
  (ELetMut String Expr Expr)
  (EIf Expr Expr Expr)
  (ETryCatch Expr String Expr)
  (EMatch Expr (List MatchArm))
  (ESpawn Expr)
  (ESend Expr Expr)
  (ESendClosure Expr Expr (List CaptureInfo))
  (EFfiCall String (List Expr) Int)
  (EFfiPin Expr)
  (EFfiUnpin Expr)
  (EAssert Expr (Option String))
  (EError String)
  (EUnwrap Expr)
  (EWhile Expr Expr)
  (EFor (List (Pair String (Option Expr))) Expr Expr)
  (ECond (List (Pair Expr Expr)))
  (EBegin (List Expr))
  (ELambda String (List Param) Expr)
  (EFn String (List Param) Expr)
  (EStructGet Expr String)
  (EMakeStruct String (List Expr))
  (EMakeVariant String String (List Expr))
  (ESetBang String Expr)
  (EModuleDecl String)
  (EUseModule (List String) (Option (List String)) Bool)
  (EExport String)
  (EPrint (List Expr))
  (EReadLine)
  (EExit Expr)
  (EClose Expr)
  (EFileOpen Expr Expr)
  (EFileRead Expr Expr)
  (EFileWrite Expr Expr)
  (EFileClose Expr)
  (EBufAppend Expr Expr)
  (EWithResource String Expr Expr)
  (EDeftype String (List ADTVariant) (List String) (Option String))
  (ETraitDecl String (List TraitMethod) (Option (Pair String String)))
  (EImplBlock String String (List ImplBody))
  (EStructDef StructDef (Option StructDef))
  (EStructDefPlus StructDef (Option StructDef))
  (EAliasDecl String Expr)
  (EDerive String (List String))
  (ETestSuite String (List TestOrSuite) (Option (Pair String Atom)))
  (ETestDecl String Expr (Option (Pair String Atom)))
  (EAssertEqual Expr Expr)
  (EAssertFail Expr (Option String))
  (EAssertTrue Expr (Option String))
  (EAssertFalse Expr (Option String))
  (ETestProperty String Generator Expr)
  (ESetup (List Expr))
  (ETeardown (List Expr))
  (ERunTests (Option (Pair String Atom)))
  (ETestCompile Expr (Option Bool))
  (EApply String (List Expr))
  (EMacroDef String (List Expr) Expr)
  (EUnknown String (List Expr)))

; --- Supporting ADTs -------------------------------------------------------

(deftype Atom (AInt Int) (AFloat String) (ABool Bool) (AStr String) (AIdent String) (ASymbol String) (AKeyword String) (ANil))

(deftype Param (P String (Option String)))

(defn P.name (p) (match p (P n d1 n)))
(defn P.type (p) (match p (P d1 t t)))

(deftype MatchArm (MA String (List Expr) Expr))

(defn MA.variant (arm) (match arm (MA v d1 d2 v)))
(defn MA.patterns (arm) (match arm (MA d1 p d2 p)))
(defn MA.body (arm) (match arm (MA d1 d2 b b)))

(deftype CaptureInfo (CI String Int))

(deftype ADTVariant (AV String (List String)))

(defn AV.name (v) (match v (AV n d1 n)))
(defn AV.fields (v) (match v (AV d1 f f)))

(deftype TraitMethod (TM String (List Param) String))

(deftype ImplBody (IB DefnNode))

(deftype DefnNode (DN String (List Param) Expr))

(defn DN.name (d) (match d (DN n d1 d2 n)))
(defn DN.params (d) (match d (DN d1 p d2 p)))
(defn DN.body (d) (match d (DN d1 d2 b b)))

(deftype StructDef (SD String (List (Pair String (Option String)))))

(deftype Generator (GenInt) (GenBool) (GenStr) (GenFloat))

(deftype TestDecl (TD String Expr (Option (Pair String Atom))))

(deftype TestSuiteNode (TSN String (List TestOrSuite) (Option (Pair String Atom))))

(deftype TestOrSuite (Test TestDecl) (Suite TestSuiteNode))

; --- Expr wrapper — matches type_inference.zyl expectation of .inner ----------

(deftype Expr (Expr ExprInner))

; ===========================================================================
; AST → EXPRINNER CONVERTER
; ===========================================================================
; Converts raw ast.zyl Ast (AIdent/AInt/AList) to ExprInner.
; Head-symbol recognition happens here (no-dispatch architecture).
; ===========================================================================

(defn convert-ast (ast)
  (match ast
    (AIdent s
      (let (atom (AIdent s))
        (Expr (EAtom atom))))
    (AInt n
      (let (atom (AInt n))
        (Expr (EAtom atom))))
    (AFloat s
      (let (atom (AFloat s))
        (Expr (EAtom atom))))
    (AString s
      (let (atom (AStr s))
        (Expr (EAtom atom))))
    (ABool b
      (let (atom (ABool b))
        (Expr (EAtom atom))))
    (AList lst
      (if (nil? lst)
        (Expr (EAtom ANil))
        (convert-list-to-exprinner (to-list lst))))))

; Helper: convert-ast returns a list of Expr (for Begin sequences)
; The head symbol determines which ExprInner variant to produce.

(defn convert-ast-list (ast-list)
  (match ast-list
    (Nil Nil)
    ((Cons a rest)
      (Cons
        (convert-ast a)
        (convert-ast-list rest)))))

(defn convert-list-to-exprinner (ast-list)
  (match ast-list
    (Nil (Expr (EAtom ANil)))
    ((Cons head rest)
      (match head
        (AIdent "defn"
          (let (parsed (parse-defn rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "defn" (convert-ast-list rest))))))
        (AIdent "deftype"
          (let (parsed (parse-deftype rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "deftype" (convert-ast-list rest))))))
        (AIdent "def"
          (let (parsed (parse-def rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "def" (convert-ast-list rest))))))
        (AIdent "let"
          (let (parsed (parse-let rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "let" (convert-ast-list rest))))))
        (AIdent "if"
          (let (parsed (parse-if rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "if" (convert-ast-list rest))))))
        (AIdent "while"
          (let (parsed (parse-while rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "while" (convert-ast-list rest))))))
        (AIdent "for"
          (let (parsed (parse-for rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "for" (convert-ast-list rest))))))
        (AIdent "cond"
          (let (parsed (parse-cond rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "cond" (convert-ast-list rest))))))
        (AIdent "match"
          (let (parsed (parse-match rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "match" (convert-ast-list rest))))))
        (AIdent "try"
          (let (parsed (parse-try rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "try" (convert-ast-list rest))))))
        (AIdent "begin"
          (let (parsed (parse-begin rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "begin" (convert-ast-list rest))))))
        (AIdent "lambda"
          (let (parsed (parse-lambda rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "lambda" (convert-ast-list rest))))))
        (AIdent "fn"
          (let (parsed (parse-fn rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "fn" (convert-ast-list rest))))))
        (AIdent "print"
          (let (parsed (parse-print rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "print" (convert-ast-list rest))))))
        (AIdent "assert-equal"
          (let (parsed (parse-assert-equal rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "assert-equal" (convert-ast-list rest))))))
        (AIdent "assert"
          (let (parsed (parse-assert rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "assert" (convert-ast-list rest))))))
        (AIdent "spawn"
          (let (parsed (parse-spawn rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "spawn" (convert-ast-list rest))))))
        (AIdent "send"
          (let (parsed (parse-send rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "send" (convert-ast-list rest))))))
        (AIdent "ffi-pin"
          (let (parsed (parse-ffi-pin rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "ffi-pin" (convert-ast-list rest))))))
        (AIdent "ffi-unpin"
          (let (parsed (parse-ffi-unpin rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "ffi-unpin" (convert-ast-list rest))))))
        (AIdent "exit"
          (let (parsed (parse-exit rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "exit" (convert-ast-list rest))))))
        (AIdent "close"
          (let (parsed (parse-close rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "close" (convert-ast-list rest))))))
        (AIdent "file-open"
          (let (parsed (parse-file-open rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "file-open" (convert-ast-list rest))))))
        (AIdent "file-read"
          (let (parsed (parse-file-read rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "file-read" (convert-ast-list rest))))))
        (AIdent "file-write"
          (let (parsed (parse-file-write rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "file-write" (convert-ast-list rest))))))
        (AIdent "file-close"
          (let (parsed (parse-file-close rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "file-close" (convert-ast-list rest))))))
        (AIdent "set!"
          (let (parsed (parse-set-bang rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "set!" (convert-ast-list rest))))))
        (AIdent "module"
          (let (parsed (parse-module rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "module" (convert-ast-list rest))))))
        (AIdent "use"
          (let (parsed (parse-use rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "use" (convert-ast-list rest))))))
        (AIdent "export"
          (let (parsed (parse-export rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "export" (convert-ast-list rest))))))
        (AIdent "derive"
          (let (parsed (parse-derive rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "derive" (convert-ast-list rest))))))
        (AIdent "macro"
          (let (parsed (parse-macro rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "macro" (convert-ast-list rest))))))
        (AIdent "test"
          (let (parsed (parse-test rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "test" (convert-ast-list rest))))))
        (AIdent "test-suite"
          (let (parsed (parse-test-suite rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "test-suite" (convert-ast-list rest))))))
        (AIdent "setup"
          (let (parsed (parse-setup rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "setup" (convert-ast-list rest))))))
        (AIdent "teardown"
          (let (parsed (parse-teardown rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "teardown" (convert-ast-list rest))))))
        (AIdent "with-resource"
          (let (parsed (parse-with-resource rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "with-resource" (convert-ast-list rest))))))
        (AIdent "read-line"
          (let (d1 nil)
            (Expr (EReadLine))))
        (AIdent "make-struct"
          (let (parsed (parse-make-struct rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "make-struct" (convert-ast-list rest))))))
        (AIdent "struct-get"
          (let (parsed (parse-struct-get rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "struct-get" (convert-ast-list rest))))))
        (AIdent "make-variant"
          (let (parsed (parse-make-variant rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "make-variant" (convert-ast-list rest))))))
        (AIdent "unwrap"
          (let (parsed (parse-unwrap rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "unwrap" (convert-ast-list rest))))))
        (AIdent "buf-append"
          (let (parsed (parse-buf-append rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "buf-append" (convert-ast-list rest))))))
        (AIdent "test-property"
          (let (parsed (parse-test-property rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "test-property" (convert-ast-list rest))))))
        (AIdent "test-compile"
          (let (parsed (parse-test-compile rest))
            (if (Some expr parsed)
              expr
              (Expr (EUnknown "test-compile" (convert-ast-list rest))))))
        (AIdent d1
          (Expr (EApply (a-ident-to-str head) (convert-ast-list rest))))
        (d2
          (let (first (convert-ast head))
            (Expr (ECall first (convert-ast-list rest)))))))))

; --- Special form parsers — extract typed structure from raw AList ----------

(defn to-list (ast)
  (match ast
    (AList lst lst)
    (d1 nil)))

(defn parse-defn (args)
  (match args
    (Nil None)
    ((Cons name rest)
      (match name
        (AIdent n
          (match rest
            (Nil None)
            ((Cons params body-expr)
              (let (param-args (convert-ast-list (to-list params)))
                (Some
                  (Expr
                    (EDefn
                      n
                      (parse-params params)
                      (convert-ast body-expr))))))))))))

(defn parse-params (params)
  (match params
    (AList lst
      (match lst
        (Nil Nil)
        ((Cons p rest)
          (let hd (parse-single-param p)
            (let tl (parse-params (AList rest))
              (Cons hd tl))))))
    (d1 Nil))

)
(defn parse-single-param (p)
  (match p
    (AIdent name (P name None))
    (AList (Cons name (Cons typ rest))
      (P (a-ident-to-str name) (Some (convert-ast typ))))
    (d1 (P "___" None))))

(defn parse-deftype (args)
  (match args
    (Nil None)
    ((Cons name rest)
      (match (convert-ast name)
        (Expr (EAtom (AIdent n))
          (Some
            (Expr
              (EDeftype
                n
                (parse-adt-variants rest)
                Nil
                None)))))))

)
(defn parse-adt-variants (variants)
  (match variants
    (Nil Nil)
    ((Cons v rest)
      (Cons
        (parse-adt-variant v)
        (parse-adt-variants rest))))

)
(defn parse-adt-variant (v)
  (match v
    (AIdent name
      (AV name Nil))
    (AList (Cons name rest)
      (AV
        (a-ident-to-str name)
        (parse-field-names (to-list rest))))
    (d1 (AV "___" Nil))))

(defn parse-field-names (fields)
  (match fields
    (Nil Nil)
    ((Cons f rest)
      (Cons
        (a-ident-to-str f)
        (parse-field-names rest)))))

(defn parse-def (args)
  (match args
    (Nil None)
    ((Cons name rest)
      (match name
        (AIdent n
          (match rest
            (Nil None)
            ((Cons val body-expr)
              (Some
                (Expr
                  (EDef
                    n
                    (convert-ast-list-to-expr val))))))))))

; convert-ast-list-to-expr: handle let-style binding where value can be multiple forms
; (let name val body) where val might be (value body) as a list
)
(defn convert-ast-list-to-expr (ast)
  (match ast
    (AIdent n
      (let (atom (AIdent n))
        (Expr (EAtom atom))))
    (AInt n
      (let (atom (AInt n))
        (Expr (EAtom atom))))
    (AFloat s
      (let (atom (AFloat s))
        (Expr (EAtom atom))))
    (AString s
      (let (atom (AStr s))
        (Expr (EAtom atom))))
    (ABool b
      (let (atom (ABool b))
        (Expr (EAtom atom))))
    (AList lst
      (if (nil? lst)
        (Expr (EAtom ANil))
        (convert-list-to-exprinner (to-list lst))))))

(defn parse-let (args)
  (match args
    (Nil None)
    ((Cons name rest)
      (match name
        (AIdent n
          (match rest
            (Nil None)
            ((Cons val body-expr)
              (Some
                (Expr
                  (ELet
                    n
                    (convert-ast-list-to-expr val)
                    (convert-ast body-expr))))))))))

)
(defn parse-if (args)
  (match args
    (Nil None)
    ((Cons cond rest)
      (match rest
        ((Cons then- else-)
          (Some
            (Expr
              (EIf
                (convert-ast cond)
                (convert-ast then-)
                (convert-ast else-)))))
        (d1 None))))

)
(defn parse-while (args)
  (match args
    (Nil None)
    ((Cons cond rest)
      (match rest
        (Cons body-expr d1
          (Some
            (Expr
              (EWhile
                (convert-ast cond)
                (convert-ast body-expr)))))
        (d1 None))))

)
(defn parse-for (args)
  (match args
    (Nil None)
    ((Cons bindings cond rest)
      (match rest
        (Cons body-expr d1
          (Some
            (Expr
              (EFor
                (parse-for-bindings bindings)
                (convert-ast cond)
                (convert-ast body-expr)))))
        (d1 None))))

)
(defn parse-for-bindings (bindings)
  (match bindings
    (AList lst
      (match lst
        (Nil Nil)
        ((Cons binding rest)
          (let hd (parse-for-binding binding)
            (let tl (parse-for-bindings (AList rest))
              (Cons hd tl))))))
    (d1 nil))

)
(defn parse-for-binding (binding)
  (match binding
    (AIdent name
      (Pair name None))
    (AList (Cons name rest)
      (Pair
        (a-ident-to-str name)
        (if (nil? rest)
          None
          (Some (convert-ast-list-to-expr (AList rest))))))
    (d1 (Pair "___" None))))

(defn parse-cond (args)
  (match args
    (Nil None)
    (Cons d1 d2
      (Some
        (Expr
          (ECond
            (parse-cond-clauses (AList args))))))))

(defn parse-cond-clauses (ast)
  (match ast
    (AList lst
      (match lst
        (Nil Nil)
        ((Cons clause rest)
          (let hd (parse-cond-clause clause)
            (let tl (parse-cond-clauses (AList rest))
              (Cons hd tl))))))
    (d1 nil))

)
(defn parse-cond-clause (clause)
  (match clause
    (AList (Cons pred body)
      (Pair
        (convert-ast pred)
        (convert-ast body)))
    (d1 (Pair (Expr (EAtom ANil)) (Expr (EAtom ANil))))))

(defn parse-match (args)
  (match args
    (Nil None)
    ((Cons subject rest)
      (match rest
        (Cons arms-expr d1
          (Some
            (Expr
              (EMatch
                (convert-ast subject)
                (parse-match-arms arms-expr)))))
        (d1 None))))

)
(defn parse-match-arms (arms)
  (match arms
    (AList lst
      (match lst
        (Nil Nil)
        ((Cons arm rest)
          (let hd (parse-match-arm arm)
            (let tl (parse-match-arms (AList rest))
              (Cons hd tl))))))
    (d1 nil))

)
(defn parse-match-arm (arm)
  (match arm
    (AList (Cons pattern rest)
      (match rest
        (Cons body d1
          (MA
            (match pattern
              (AIdent n n)
              (d1 "___"))
            Nil
            (convert-ast body)))
        (d1 (MA "___" Nil (Expr (EAtom ANil))))))
    (d1 (MA "___" Nil (Expr (EAtom ANil))))))

(defn parse-try (args)
  (match args
    (Nil None)
    ((Cons eh rest)
      (match rest
        ((Cons cn body-expr)
          (Some
            (Expr
              (ETryCatch
                (convert-ast eh)
                (match cn
                  (AIdent n n)
                  (d1 "___"))
                (convert-ast body-expr)))))
        (d1 None))))

)
(defn parse-begin (args)
  (match args
    (Nil (Some (Expr (EBegin Nil))))
    (d1 (Some (Expr (EBegin (convert-ast-list args))))))

)
(defn parse-lambda (args)
  (match args
    (Nil None)
    ((Cons params rest)
      (match rest
        (Cons body-expr d1
          (Some
            (Expr
              (ELambda
                "___"
                (parse-params params)
                (convert-ast body-expr)))))
        (d1 None))))

)
(defn parse-fn (args)
  (match args
    (Nil None)
    ((Cons params rest)
      (match rest
        (Cons body-expr d1
          (Some
            (Expr
              (EFn
                "___"
                (parse-params params)
                (convert-ast body-expr)))))
        (d1 None))))

)
(defn parse-print (args)
  (Some (Expr (EPrint (convert-ast-list args)))))

(defn parse-assert-equal (args)
  (match args
    (Nil None)
    ((Cons l r)
      (Some
        (Expr
          (EAssertEqual
            (convert-ast-list-to-expr l)
            (convert-ast-list-to-expr r)))))
    (d1 None)))

(defn parse-assert (args)
  (match args
    (Nil None)
    ((Cons cond rest)
      (match rest
        (Cons msg d1
          (Some
            (Expr
              (EAssert
                (convert-ast cond)
                (Some (convert-ast-list-to-expr msg))))))
        (d3
          (Some
            (Expr
              (EAssert
                (convert-ast cond)
                None)))))))

)
(defn parse-spawn (args)
  (if (nil? args)
    None
    (Some (Expr (ESpawn (convert-ast args))))))

(defn parse-send (args)
  (match args
    (Nil None)
    ((Cons actor msg)
      (Some
        (Expr
          (ESend
            (convert-ast actor)
            (convert-ast msg)))))
    (d1 None)))

(defn parse-ffi-pin (args)
  (if (nil? args)
    None
    (Some (Expr (EFfiPin (convert-ast args))))))

(defn parse-ffi-unpin (args)
  (if (nil? args)
    None
    (Some (Expr (EFfiUnpin (convert-ast args))))))

(defn parse-exit (args)
  (if (nil? args)
    None
    (Some (Expr (EExit (convert-ast args))))))

(defn parse-close (args)
  (if (nil? args)
    None
    (Some (Expr (EClose (convert-ast args))))))

(defn parse-file-open (args)
  (match args
    (Nil None)
    ((Cons path mode)
      (Some
        (Expr
          (EFileOpen
            (convert-ast path)
            (convert-ast mode)))))
    (d1 None)))

(defn parse-file-read (args)
  (match args
    (Nil None)
    ((Cons handle count)
      (Some
        (Expr
          (EFileRead
            (convert-ast handle)
            (convert-ast count)))))
    (d1 None)))

(defn parse-file-write (args)
  (match args
    (Nil None)
    ((Cons handle data)
      (Some
        (Expr
          (EFileWrite
            (convert-ast handle)
            (convert-ast data)))))
    (d1 None)))

(defn parse-file-close (args)
  (if (nil? args)
    None
    (Some (Expr (EFileClose (convert-ast args))))))

(defn parse-set-bang (args)
  (match args
    (Nil None)
    ((Cons target val)
      (Some
        (Expr
          (ESetBang
            (match target
              (AIdent n n)
              (d1 "___"))
            (convert-ast val)))))
    (d1 None)))

(defn parse-module (args)
  (if (nil? args)
    None
    (Some
      (Expr
        (EModuleDecl
          (match args
            (AIdent n n)
            (d1 "___")))))))

(defn parse-use (args)
  (Some (Expr (EUseModule (to-list args) None false))))

(defn parse-export (args)
  (if (nil? args)
    None
    (Some
      (Expr
        (EExport
          (match args
            (AIdent n n)
            (d1 "___")))))))

(defn parse-derive (args)
  (match args
    (Nil None)
    ((Cons type-expr rest)
      (Some
        (Expr
          (EDerive
            (match type-expr
              (AIdent n n)
              (d1 "___"))
            (parse-derive-traits rest))))))

)
(defn parse-derive-traits (ast)
  (match ast
    (AList lst
      (match lst
        (Nil Nil)
        ((Cons t rest)
          (let hd (match t
                    (AIdent n n)
                    (d1 "___"))
            (let tl (parse-derive-traits (AList rest))
              (Cons hd tl))))))
    (d1 nil))

)
(defn parse-macro (args)
  (match args
    (Nil None)
    ((Cons name rest)
      (match name
        (AIdent n
          (match rest
            (Nil None)
            ((Cons params body)
              (Some
                (Expr
                  (EMacroDef
                    n
                    (convert-ast-list params)
                    (convert-ast body)))))))))
    (d1 None)))

(defn parse-test (args)
  (match args
    (Nil None)
    ((Cons name body)
      (Some
        (Expr
          (ETestDecl
            (match name
              (AIdent n n)
              (d1 "___"))
            (convert-ast body)
            None))))
    (d1 None)))

(defn parse-test-suite (args)
  (Some (Expr (ETestSuite "___" Nil None))))

(defn parse-setup (args)
  (Some (Expr (ESetup (convert-ast-list args)))))

(defn parse-teardown (args)
  (Some (Expr (ETeardown (convert-ast-list args)))))

(defn parse-with-resource (args)
  (match args
    (Nil None)
    ((Cons name rest)
      (match rest
        ((Cons init body)
          (Some
            (Expr
              (EWithResource
                (match name
                  (AIdent n n)
                  (d1 "___"))
                (convert-ast init)
                (convert-ast body)))))
        (d1 None)))
    (d1 None)))


(defn parse-make-struct (args)
  (match args
    (Nil None)
    ((Cons name rest)
      (Some
        (Expr
          (EMakeStruct
            (match name
              (AIdent n n)
              (d1 "___"))
            (convert-ast-list rest)))))
    (d1 None)))

(defn parse-struct-get (args)
  (match args
    (Nil None)
    ((Cons se rest)
      (match rest
        (Cons field d1
          (Some
            (Expr
              (EStructGet
                (convert-ast se)
                (match field
                  (AIdent n n)
                  (d1 ""))))))
        (d1 None)))
    (d1 None)))

(defn parse-make-variant (args)
  (match args
    (Nil None)
    ((Cons adt rest)
      (match adt
        (AList (Cons adt-name rest2)
          (match rest2
            (Nil None)
            ((Cons variant fields-expr)
              (Some
                (Expr
                  (EMakeVariant
                    (match adt-name
                      (AIdent n n)
                      (d1 "___"))
                    (match variant
                      (AIdent n n)
                      (d1 "___"))
                    (convert-ast-list fields-expr)))))))
        (d1 None)))
    (d1 None)))


(defn parse-unwrap (args)
  (if (nil? args)
    None
    (Some (Expr (EUnwrap (convert-ast args))))))

(defn parse-buf-append (args)
  (match args
    (Nil None)
    ((Cons dst src)
      (Some
        (Expr
          (EBufAppend
            (convert-ast dst)
            (convert-ast src)))))
    (d1 None)))

(defn parse-test-property (args)
  (Some (Expr (ETestProperty "___" (GenInt) (Expr (EAtom ANil))))))

(defn parse-test-compile (args)
  (Some (Expr (ETestCompile (Expr (EAtom ANil)) None))))

; ===========================================================================
; UTILITY HELPERS
; ===========================================================================

(defn a-ident-to-str (ast)
  (match ast
    (AIdent s s)
    (d1 "")))

(defn nil? (xs)
  (match xs
    (Nil true)
    (d1 false)))

(defn to-expr-list (ast)
  (match ast
    (AList lst (convert-ast-list lst))
    (d1 nil)))
