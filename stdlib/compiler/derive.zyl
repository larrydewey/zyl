; === Zyl Compiler — Derive ===
; Module: compiler/derive
;
; Expands `(derive Type Show ...)` into an impl block (spec §5.6). Runs
; before monomorphization, which lifts the impl's method to a function.
; Other derivable traits are accepted and generate nothing yet.

(use core/list)
(use compiler/expr_inner)

(defn dv-expand-program (exprs)
  (list-append exprs (list-append (dv-collect exprs exprs) (dv-secret-shows exprs exprs))))

;; Redaction: Secret fields and types implementing the Secret trait show as
;; `<secret>` (shapes recorded by secret_check.zyl in global map 4).
(defn dv-shape (tag n) (ffi-call "zyl_smap_get" (ffi-call "zyl_smap_global" 4 1000) (str-concat tag (dv-short n)) 1000))
(defn dv-secret-type (n) (> (dv-shape "t|" n) 0))

(defn dv-ctor-mask (n)
  (let c (dv-shape "c|" n)
    (if (= c 0) 0 (- c 1))))

; Fields protected by (impl-not Show X) show as `<hidden>` (label "Show|").
(defn dv-hidden-mask (n)
  (let c (dv-shape "c|Show|" n)
    (if (= c 0) 0 (- c 1))))

(defn dv-hidden-type (n)
  (> (ffi-call "zyl_smap_get" (ffi-call "zyl_smap_global" 5 1000) (str-concat "p|Show|" (dv-short n)) 1000) 0))

; Secret types show as `<secret>` and other (impl-not Show X) types as
; `<hidden>`: the only Show they have is this compiler-made one.
(defn dv-secret-shows (all forms)
  (match forms
    (Nil Nil)
    (Cons e rest
      (match (Expr.inner e)
        (EDeftype ty _ _ _
          (if (and (or (dv-secret-type ty) (dv-hidden-type ty)) (not (dv-has-show all ty)))
            (Cons (dv-fixed-impl (dv-show-trait all) ty (if (dv-secret-type ty) "<secret>" "<hidden>")) (dv-secret-shows all rest))
            (dv-secret-shows all rest)))
        (_ (dv-secret-shows all rest))))))

(defn dv-has-show (forms ty)
  (match forms
    (Nil false)
    (Cons e rest
      (match (Expr.inner e)
        (EImplBlock tr t _ (if (and (> (ffi-call "zyl_cstr_key_matches" tr "Show" 1000) 0) (> (str-eq t ty) 0)) true (dv-has-show rest ty)))
        (EDerive t traits (if (and (> (str-eq t ty) 0) (dv-lists-show traits)) true (dv-has-show rest ty)))
        (_ (dv-has-show rest ty))))))

(defn dv-lists-show (traits)
  (match traits
    (Nil false)
    (Cons t rest (if (> (ffi-call "zyl_cstr_key_matches" t "Show" 1000) 0) true (dv-lists-show rest)))))

; The Show trait's canonical name, as the prelude declared it.
(defn dv-show-trait (forms)
  (match forms
    (Nil "Show")
    (Cons e rest
      (match (Expr.inner e)
        (ETraitDecl n _ _ (if (> (ffi-call "zyl_cstr_key_matches" n "Show" 1000) 0) n (dv-show-trait rest)))
        (_ (dv-show-trait rest))))))

(defn dv-redacted-impl (trait tname) (dv-fixed-impl trait tname "<secret>"))

(defn dv-fixed-impl (trait tname text)
  (Expr (EImplBlock trait tname (Cons (IB (DN "show" (Cons (P "_self" None) Nil) (dv-str text))) Nil))))

(defn dv-collect (all forms)
  (match forms
    (Nil Nil)
    (Cons e rest
      (match (Expr.inner e)
        (EDerive tname traits (list-append (dv-derive all tname traits) (dv-collect all rest)))
        (_ (dv-collect all rest))))))

(defn dv-derive (all tname traits)
  (match traits
    (Nil Nil)
    (Cons t rest
      (if (> (ffi-call "zyl_cstr_key_matches" t "Show" 1000) 0)
        (if (or (dv-secret-type tname) (dv-hidden-type tname))
          (dv-derive all tname rest)
          (match (dv-find-type all tname)
            (Some dt (Cons (dv-show-impl t tname dt) (dv-derive all tname rest)))
            (None (dv-derive all tname rest))))
        (dv-derive all tname rest)))))

(defn dv-find-type (forms tname)
  (match forms
    (Nil None)
    (Cons e rest
      (match (Expr.inner e)
        (EDeftype n _ _ _ (if (> (str-eq n tname) 0) (Some e) (dv-find-type rest tname)))
        (_ (dv-find-type rest tname))))))

; --- Show --------------------------------------------------------------------

(defn dv-id (n) (Expr (EAtom (AIdent n))))
(defn dv-str (s) (Expr (EAtom (AStr s))))
(defn dv-cat (a b) (Expr (EApply "str-concat" (Cons a (Cons b Nil)))))

(defn dv-show-impl (trait tname dt)
  (match (Expr.inner dt)
    (EDeftype _ variants _ sm
      (let body (Expr (EMatch (dv-id "self") (dv-show-arms trait variants (dv-is-struct sm))))
        (Expr (EImplBlock trait tname (Cons (IB (DN "show" (Cons (P "self" None) Nil) body)) Nil)))))
    (_ dt)))

(defn dv-is-struct (sm)
  (match sm
    (Some _ 1)
    (None 0)))

(defn dv-show-arms (trait variants isst)
  (match variants
    (Nil Nil)
    (Cons v rest
      (let n (list-length (AV.fields v))
        (let binds (dv-binders n 0)
          (Cons (MA (AV.name v) (dv-bind-exprs binds) (dv-show-variant trait v (dv-redact binds (dv-ctor-mask (AV.name v)) (dv-hidden-mask (AV.name v)) 0) isst))
                (dv-show-arms trait rest isst)))))))

(defn dv-binders (n i)
  (if (>= i n) Nil (Cons (str-concat "_dv" (ffi-call "zyl_int_text" i 1000)) (dv-binders n (+ i 1)))))

(defn dv-bind-exprs (bs)
  (match bs
    (Nil Nil)
    (Cons b t (Cons (dv-id b) (dv-bind-exprs t)))))

; A binder of a Secret (or Show-protected) field becomes "!secret" ("!hidden"),
; which dv-show-call prints as that marker.
(defn dv-redact (binds mask hmask i)
  (match binds
    (Nil Nil)
    (Cons b t
      (Cons (if (= (bit-and (shr mask i) 1) 1) "!secret" (if (= (bit-and (shr hmask i) 1) 1) "!hidden" b))
            (dv-redact t mask hmask (+ i 1))))))

(defn dv-show-call (trait b)
  (if (> (str-eq b "!secret") 0)
    (dv-str "<secret>")
    (if (> (str-eq b "!hidden") 0)
      (dv-str "<hidden>")
      (Expr (EApply (str-concat trait ".show") (Cons (dv-id b) Nil))))))

; `Name`, `Name(a, b)`, or for a struct `Name { f: a, g: b }`.
(defn dv-show-variant (trait v binds isst)
  (let name (dv-short (AV.name v))
    (match binds
      (Nil (dv-str name))
      (_
        (if (> isst 0)
          (dv-cat (dv-str (str-concat name " { ")) (dv-cat (dv-show-fields trait (AV.fields v) binds) (dv-str " }")))
          (dv-cat (dv-str (str-concat name "(")) (dv-cat (dv-show-items trait binds) (dv-str ")"))))))))

(defn dv-show-items (trait binds)
  (match binds
    (Nil (dv-str ""))
    (Cons b t
      (match t
        (Nil (dv-show-call trait b))
        (_ (dv-cat (dv-show-call trait b) (dv-cat (dv-str ", ") (dv-show-items trait t))))))))

(defn dv-show-fields (trait names binds)
  (match names
    (Nil (dv-str ""))
    (Cons f frest
      (match binds
        (Nil (dv-str ""))
        (Cons b brest
          (let one (dv-cat (dv-str (str-concat f ": ")) (dv-show-call trait b))
            (match brest
              (Nil one)
              (_ (dv-cat one (dv-cat (dv-str ", ") (dv-show-fields trait frest brest)))))))))))

; Text after the last "::".
(defn dv-short (n) (dv-short-from n 0 -1))

(defn dv-short-from (n i found)
  (let c (ffi-call "zyl_cstr_byte_at" n i 1000)
    (if (< c 1)
      (if (< found 0) n (str-substring n (+ found 2) (- (str-length n) (+ found 2))))
      (if (and (= c 58) (= (ffi-call "zyl_cstr_byte_at" n (+ i 1) 1000) 58))
        (dv-short-from n (+ i 2) i)
        (dv-short-from n (+ i 1) found)))))
