; === Zyl Standard Library — Compiler AST types ===
; Module: compiler/ast
;
; The compiler front-end is built entirely on recursive algebraic data
; types (spec §9 deftype). Every phase communicates in ADT values and
; every traversal is a structural `match`:
;
;   Token  — lexer output; a token stream is a (List Token)
;   Ast    — reader/parser output; source trees are nested AList forms
;            (Zyl's no-dispatch parsing: special forms are recognised by
;            the consumer, not by the parser)
;   Env    — immutable name→slot chain used by lowering/codegen
;   VTable — immutable variant-name→(tag, arity) chain for ADTs
;
; There are no numeric node-kind tags, no projection/downcast accessors,
; no raw arena record layouts, and no index-based node tables anywhere.
;
; Pattern wildcards are written `_` throughout stdlib/compiler, and `_`
; may repeat within one pattern. (Named dummies `d1`, `d2`, ... were used
; while the Rust bootstrap, now archived, miscompiled bare `_`.)

(use allocator/allocator)

; --- Lexer tokens ----------------------------------------------------------

; Every token carries the byte offset in the source it was lexed from --
; the last field of every variant. The reader copies it onto the Ast node
; it builds (parser.zyl's `at`), which is how any later diagnostic gets a
; real file:line:col to point at.
(deftype Token
  (TkEof Int)
  (TkIdent String Int)
  (TkInt Int Int)
  (TkFloat String Int)
  (TkString String Int)
  (TkBool Bool Int)
  (TkSymbol String Int)
  (TkKeyword String Int)
  (TkLParen Int)
  (TkRParen Int)
  (TkLBrace Int)
  (TkRBrace Int)
  (TkLBracket Int)
  (TkRBracket Int)
  (TkColon Int)
  (TkQuote Int)
  (TkQuasi Int)
  (TkUnquote Int)
  (TkSplice Int))

; --- Parsed source ---------------------------------------------------------

; A parsed s-expression: an atom or a parenthesised list of forms.
(deftype Ast
  (AstIdent String)
  (AstInt Int)
  (AstFloat String)
  (AString String)
  (AstBool Bool)
  (AList (List Ast)))

; --- Immutable environments -------------------------------------------------

; Immutable environment chain: name -> stack slot offset from rbp.
(deftype Env
  (EnvBind String Int Int Env)   ; name, rbp-offset, kind (0 int,1 str,2 float)
  (EnvNil))

; Look up a name in an Env chain.
; Returns: Int (offset, or 0 if unbound)
(defn env-lookup (env name)
  (match env
    (EnvBind n off _ rest (if (str-eq n name) off (env-lookup rest name)))
    (EnvNil 0)))

; Look up the kind of a name in an Env chain.
; Returns: Int (0 int, 1 str, 2 float, 0 if unbound)
(defn env-kind-of (env name)
  (match env
    (EnvBind n _ k rest (if (str-eq n name) k (env-kind-of rest name)))
    (EnvNil 0)))

; --- Variant tables ---------------------------------------------------------

; Immutable variant table: variant name -> tag + field names.
;
; Third slot used to be a bare field-count Int (vt-arity-of, its only
; reader, was itself unused anywhere) — widened to the actual field-name
; list so struct-get (see icnf.zyl's ic-struct-get) can find which
; position a named field lives at without a second, separately-threaded
; table. A struct is just a single-variant deftype (see expr_inner.zyl's
; parse-defstruct), so this table already has an entry per struct type
; for free.
; VTFn: a plain top-level function's name (not a constructor) — see
; icnf.zyl's ic-collect-vt, which also walks EDefn forms to register
; these so ic-safe-callee can tell "this call-head is a genuine
; existing top-level function" from "this call-head is an unresolvable
; name that might be a capture" without conflating it with vt-tag-of's
; ADT-dispatch lookup (a VTFn entry is invisible to vt-tag-of/
; vt-arity-of, which only ever see VTEntry — no risk of a plain
; function name aliasing a real constructor's tag).
; gid (5th field): a per-deftype-DECLARATION-unique id, the same value on
; every variant that came from one `deftype` call — unlike `tag` (which
; restarts at 0 for every deftype, since codegen's dispatch needs small
; per-type-relative tags), gid lets ic-check-exhaustive find a variant's
; siblings across the whole flat table. See vt-names-with-gid below.
; VTClosureFn (5th kind): marks a NAME -- a let-bound local, never a real
; top-level defn (see icnf.zyl's ic-lambda/ic-is-closure-shaped) -- as
; holding a CAPTURING closure value (a heap [tag,code,env] triple, not a
; bare code pointer). Purely additive bookkeeping alongside VTEntry/VTFn:
; every existing query below treats it as absent unless it specifically
; asks vt-returns-closure.
;
; VTClosureReturn (6th kind): a DIFFERENT fact about a name -- that
; CALLING it (not loading its own value) produces a closure-triple
; result. Genuinely distinct from VTClosureFn: `outer` in `(let outer
; (fn (x) (fn (y) (+ x y))) (let add5 (outer 5) ...))` is itself a
; plain non-capturing lambda (its OWN value is a bare code pointer --
; ic-lambda's unmodified fast path, correctly called with the ordinary
; convention), but its BODY's tail is another `fn` that DOES capture
; `x`, so CALLING `outer` hands back a real closure triple. Conflating
; the two (an earlier version of this marked `outer` itself via
; VTClosureFn, using ic-free-vars's result for the OUTER lambda) marked
; the wrong name and left `add5` uncovered -- add5's own call then used
; the plain bare-pointer convention on an actual triple and crashed.
; See ic-lower-let (sets it) and ic-is-closure-shaped's EApply arm
; (reads it to decide whether the LET-BOUND RESULT gets VTClosureFn).
(deftype VTable
  (VTEntry String Int (List String) Int VTable) ; variant name, tag, field names, gid
  (VTFn String VTable)                       ; plain top-level function name
  (VTClosureFn String VTable)                ; name known to hold a capturing closure
  (VTClosureReturn String VTable)            ; name known: CALLING it returns a closure
  (VTIndex (SMap VTable) (SMap Int) VTable)  ; by name: rest's VTEntry nodes, its VTFn names
  (VTNil))

; VTIndex sits on top of the program's table (icnf.zyl's ic-program), so a
; lookup walks only the entries pushed since and then answers by hash. The
; table below it holds only VTEntry and VTFn nodes; the first node of each
; name is indexed, the one a scan would find. A table without an index is
; still searched linearly.
(defn vt-with-index (vt)
  (let es (ffi-call "zyl_smap_new" 1000)
    (let fs (ffi-call "zyl_smap_new" 1000)
      (let _ (vt-index-fill vt es fs)
        (VTIndex es fs vt)))))

(defn vt-index-fill (vt es fs)
  (match vt
    (VTEntry n _ _ _ rest
      (let _ (if (ffi-call "zyl_smap_has" es n 1000) unit (ffi-call "zyl_smap_put" es n vt 1000))
        (vt-index-fill rest es fs)))
    (VTFn n rest (let _ (ffi-call "zyl_smap_put" fs n 1 1000) (vt-index-fill rest es fs)))
    (VTClosureFn _ rest (vt-index-fill rest es fs))
    (VTClosureReturn _ rest (vt-index-fill rest es fs))
    (VTIndex _ _ rest (vt-index-fill rest es fs))
    (VTNil unit)))

(defn vt-indexed (es name) (ffi-call "zyl_smap_get_or" es name VTNil 1000))

; Tag for an interned variant name; -1 when absent.
; Returns: Int
(defn vt-tag-of (vt name)
  (match vt
    (VTEntry n tag _ _ rest (if (str-eq n name) tag (vt-tag-of rest name)))
    (VTFn _ rest (vt-tag-of rest name))
    (VTClosureFn _ rest (vt-tag-of rest name))
    (VTClosureReturn _ rest (vt-tag-of rest name))
    (VTIndex es _ _ (match (vt-indexed es name) (VTEntry _ tag _ _ _ tag) (_ -1)))
    (VTNil -1)))

; Field count for an interned variant name; -1 when absent.
; Returns: Int
(defn vt-arity-of (vt name)
  (match vt
    (VTEntry n _ fields _ rest (if (str-eq n name) (list-length fields) (vt-arity-of rest name)))
    (VTFn _ rest (vt-arity-of rest name))
    (VTClosureFn _ rest (vt-arity-of rest name))
    (VTClosureReturn _ rest (vt-arity-of rest name))
    (VTIndex es _ _ (match (vt-indexed es name) (VTEntry _ _ fields _ _ (list-length fields)) (_ -1)))
    (VTNil -1)))

; True when `name` is a registered plain top-level function name.
(defn vt-is-fn (vt name)
  (match vt
    (VTEntry _ _ _ _ rest (vt-is-fn rest name))
    (VTFn n rest (if (str-eq n name) true (vt-is-fn rest name)))
    (VTClosureFn _ rest (vt-is-fn rest name))
    (VTClosureReturn _ rest (vt-is-fn rest name))
    (VTIndex _ fs _ (ffi-call "zyl_smap_has" fs name 1000))
    (VTNil false)))

; gid for an interned variant name; -1 when absent.
(defn vt-gid-of (vt name)
  (match vt
    (VTEntry n _ _ gid rest (if (str-eq n name) gid (vt-gid-of rest name)))
    (VTFn _ rest (vt-gid-of rest name))
    (VTClosureFn _ rest (vt-gid-of rest name))
    (VTClosureReturn _ rest (vt-gid-of rest name))
    (VTIndex es _ _ (match (vt-indexed es name) (VTEntry _ _ _ gid _ gid) (_ -1)))
    (VTNil -1)))

; All variant names sharing one gid (i.e. one deftype declaration's full
; sibling set), in table order.
(defn vt-names-with-gid (vt gid)
  (match vt
    (VTEntry n _ _ g rest
      (if (= g gid) (Cons n (vt-names-with-gid rest gid)) (vt-names-with-gid rest gid)))
    (VTFn _ rest (vt-names-with-gid rest gid))
    (VTClosureFn _ rest (vt-names-with-gid rest gid))
    (VTClosureReturn _ rest (vt-names-with-gid rest gid))
    (VTIndex _ _ rest (vt-names-with-gid rest gid))
    (VTNil Nil)))

; True when `name` is known (via VTClosureFn) to hold a capturing closure
; value -- see icnf.zyl's ic-is-closure-shaped (what marks it) and
; ic-call-or-variant (what consults it to pick ICall vs ICallClosure).
(defn vt-returns-closure (vt name)
  (match vt
    (VTEntry _ _ _ _ rest (vt-returns-closure rest name))
    (VTFn _ rest (vt-returns-closure rest name))
    (VTClosureFn n rest (if (str-eq n name) true (vt-returns-closure rest name)))
    (VTClosureReturn _ rest (vt-returns-closure rest name))
    (VTIndex _ _ _ false)
    (VTNil false)))

; True when `name` is known (via VTClosureReturn) to hand back a closure
; triple when CALLED -- see ic-lower-let (sets it) and
; ic-is-closure-shaped's EApply arm (the only reader).
(defn vt-call-returns-closure (vt name)
  (match vt
    (VTEntry _ _ _ _ rest (vt-call-returns-closure rest name))
    (VTFn _ rest (vt-call-returns-closure rest name))
    (VTClosureFn _ rest (vt-call-returns-closure rest name))
    (VTClosureReturn n rest (if (str-eq n name) true (vt-call-returns-closure rest name)))
    (VTIndex _ _ _ false)
    (VTNil false)))

; --- Token stream helpers ----------------------------------------------------

; Head of a token stream (TkEof when empty).
; Returns: Token
(defn toks-head (toks)
  (match toks
    (Cons t _ t)
    (Nil (TkEof 0))))

; Tail of a token stream (empty when empty).
; Returns: List(Token)
(defn toks-tail (toks)
  (match toks
    (Cons _ rest rest)
    (Nil Nil)))

; --- List literals ---------------------------------------------------------

; `(list a b c)` (the reader's `[a b c]`) is the chain
; `(Cons a (Cons b (Cons c Nil)))`, built in source order, so the elements
; are evaluated left to right and must have one type. Qualification
; (qualify.zyl) rewrites the form this way so `Cons` and `Nil` are
; resolved like hand-written ones; convert-ast does the same for a tree
; that was never qualified.
(defn ast-list-literal (xs)
  (match xs
    (Nil (AstIdent "Nil"))
    (Cons x t
      (ast-span-like (AList (Cons (AstIdent "Cons") (Cons x (Cons (ast-list-literal t) Nil)))) x))))

; `(quote d)` (the reader's `'d`) is constant data: an Int, Float, String
; or Bool is itself, and a list is a list literal of quoted elements, so
; `'((1 2) (3))` is a (List (List Int)). A name has no value to quote; the
; caller rejects one (ast-quote-ok, expr_inner.zyl's quote-check).
(defn ast-quote-data (d)
  (match d
    (AList xs (ast-span-like (ast-list-literal (ast-quote-list xs)) d))
    (_ d)))

(defn ast-quote-list (xs)
  (match xs
    (Nil Nil)
    (Cons h t (Cons (ast-quote-data h) (ast-quote-list t)))))

; Whether quoted data holds no name.
(defn ast-quote-ok (d)
  (match d
    (AList xs (ast-quote-ok-list xs))
    (AstIdent _ false)
    (_ true)))

(defn ast-quote-ok-list (xs)
  (match xs
    (Nil true)
    (Cons h t (if (ast-quote-ok h) (ast-quote-ok-list t) false))))

; `node` with `from`'s source position.
(defn ast-span-like (node from)
  (let _ (ffi-call "zyl_span_copy" node from 1000)
    node))

; --- Quasiquote ---------------------------------------------------------------

; `(quasiquote d)` (the reader's `` `d ``) is quoted data with holes:
; `(unquote e)` (`,e`) is the value of e, and `(unquote-splicing e)`
; (`,@e`) inside a list is the elements of the list e. So `` `(1 ,x ,@ys) ``
; is `(Cons 1 (Cons x (zyl-qq-append ys Nil)))`: built in source order,
; one element type. The constant parts follow `quote`: a name outside an
; unquote has no value (ast-qq-ok is false), and so has no meaning.
(defn ast-qq-data (d)
  (match d
    (AList xs
      (match (ast-unquote-arg xs "unquote")
        (Some e e)
        (None (ast-span-like (ast-qq-list xs) d))))
    (_ d)))

(defn ast-qq-list (xs)
  (match xs
    (Nil (AstIdent "Nil"))
    (Cons h t
      (match (ast-splice-arg h)
        (Some e (ast-span-like (AList (Cons (AstIdent "zyl-qq-append") (Cons e (Cons (ast-qq-list t) Nil)))) h))
        (None (ast-span-like (AList (Cons (AstIdent "Cons") (Cons (ast-qq-data h) (Cons (ast-qq-list t) Nil)))) h))))))

; The e of `(head e)`, when `xs` is exactly that form.
(defn ast-unquote-arg (xs head)
  (match xs
    (Cons h t
      (match h
        (AstIdent n
          (if (str-eq n head)
            (match t (Cons e r (match r (Nil (Some e)) (_ None))) (Nil None))
            None))
        (_ None)))
    (Nil None)))

(defn ast-splice-arg (d)
  (match d
    (AList xs (ast-unquote-arg xs "unquote-splicing"))
    (_ None)))

; "" when `d` is valid quasiquoted data, else why not.
(defn ast-qq-problem (d)
  (match d
    (AList xs
      (match (ast-unquote-arg xs "unquote")
        (Some _ "")
        (None
          (if (ast-head-is xs "unquote")
            "(unquote e) takes one expression"
            (if (ast-head-is xs "quasiquote")
              "a quasiquote inside a quasiquote is not supported"
              (if (ast-head-is xs "unquote-splicing")
                (if (ast-is-some (ast-unquote-arg xs "unquote-splicing"))
                  ",@ splices into a list, so it must be an element of one"
                  "(unquote-splicing e) takes one expression")
                (ast-qq-problem-list xs)))))))
    (AstIdent n (str-concat "`" (str-concat n "` is a name; write ,name for its value")))
    (_ "")))

(defn ast-qq-problem-list (xs)
  (match xs
    (Nil "")
    (Cons h t
      (let p (if (ast-is-some (ast-splice-arg h)) "" (ast-qq-problem h))
        (if (= (str-length p) 0) (ast-qq-problem-list t) p)))))

(defn ast-head-is (xs name)
  (match xs
    (Cons h _ (match h (AstIdent n (str-eq n name)) (_ false)))
    (Nil false)))

(defn ast-is-some (o) (match o (Some _ true) (None false)))
