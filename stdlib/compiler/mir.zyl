; === Zyl Compiler — MIR: machine IR, liveness, register allocation ===
; Module: compiler/mir
;
; The native backend's middle (docs/native-backend-design.md). codegen.zyl
; lowers a function's ICNF to a linear list of MIR instructions over
; virtual registers (vregs, numbered from 0), this module computes
; liveness and assigns each vreg a location by linear scan, and codegen
; emits x86-64 from the result.
;
; Every step is a function of instruction order alone (vregs are
; numbered in lowering order, intervals are sorted by start then by
; vreg, registers are tried in a fixed order), so the same function
; always gets the same assignment.

(use core/list)
(use math/words)

; --- instructions ---------------------------------------------------------

; Labels are small integers local to one function; codegen prefixes them.
(deftype MI
  (MConst Int Int)                    ; d <- n
  (MMov Int Int)                      ; d <- s
  (MBin Int Int Int Int)              ; op, d <- a op b (ICNF operator codes)
  (MBinI Int Int Int Int)             ; op, d <- a op imm (imm fits 32 bits)
  (MParam Int Int)                    ; d <- incoming argument i
  (MCall Int String Bool (List Int) Int) ; d <- call sym(args); user?; region level
  (MTail String (List Int) Int)       ; tail call of a user function; region level
  (MByte Int Int Int Int Int)         ; kind (0 u8, 1 i8, 2 store, 3 store signed), d, off, buf, val (-1)
  (MFnRef Int String)                 ; d <- address of a user function
  (MLabel Int)
  (MJmp Int)
  (MJf Int Int Int Int)               ; op, a, b, L: jump to L when (a op b) is false
  (MJfI Int Int Int Int)              ; op, a, imm, L
  (MJz Int Int)                       ; a, L: jump to L when a is 0
  (MRet Int)
  ; Stage 2: variants, match, constants, regions.
  (MAlloc Int Int Int)                ; d <- a block of n bytes at region level (keeps registers)
  (MLoad Int Int Int)                 ; d <- [base + off]
  (MStore Int Int Int)                ; [base + off] <- v
  (MStoreI Int Int Int)               ; [base + off] <- imm
  (MStackBlk Int Int)                 ; d <- address of frame block k
  (MStr Int String)                   ; d <- a string constant
  (MFlt Int String)                   ; d <- a Float constant's bits
  (MSym Int String)                   ; d <- a symbol's address
  (MRegionCycle)                      ; release and re-open the frame region (a call)
  ; Array access, inline (kind 0 get, 1 set, 2 cap); the slow path is the
  ; runtime's own check, which panics and does not return.
  (MArr Int Int Int Int Int)          ; kind, d, array, index (-1), value (-1)
  ; A construction that may take the block of a dead, unique value
  ; (compiler/reuse.zyl) when its size header is large enough; else as
  ; MAlloc.
  (MReuse Int Int Int Int)            ; d, old value, bytes, region level
  ; A byte buffer or slice handle's data pointer and bound, loaded once
  ; (both never change; an invalid handle gives bound 0, so every access
  ; fails as the runtime's would), and an access through them.
  (MByteData Int Int)                 ; d data, handle
  (MByteBound Int Int)                ; d bound, handle
  (MByteFast Int Int Int Int Int Int) ; kind, d, off, data, bound, val (-1)
  (MRaw Int Int (List Int))           ; runtime primitive kind (cg-raw-kind), d, operands
  (MTls Int String (List Int))        ; d <- thread-local sym, or sym <- the operand (then d gets it)
  (MMem Int Int Int Int Int)          ; raw kind 0-7 (loads, stores), d, base, displacement, value (-1 for a load)
  (MCSub Int Int Int))                ; d <- a - m when a >= m, else a (m an imm32 > 0; branch-free)

; Vregs an instruction reads, and the one it writes (-1 for none).
(defn mi-uses (i)
  (match i
    (MConst _ _ Nil)
    (MMov _ s (Cons s Nil))
    (MBin _ _ a b (Cons a (Cons b Nil)))
    (MBinI _ _ a _ (Cons a Nil))
    (MParam _ _ Nil)
    (MCall _ _ _ args _ args)
    (MTail _ args _ args)
    (MByte _ _ o b v (if (< v 0) (Cons o (Cons b Nil)) (Cons o (Cons b (Cons v Nil)))))
    (MFnRef _ _ Nil)
    (MLabel _ Nil)
    (MJmp _ Nil)
    (MJf _ a b _ (Cons a (Cons b Nil)))
    (MJfI _ a _ _ (Cons a Nil))
    (MJz a _ (Cons a Nil))
    (MRet a (Cons a Nil))
    (MAlloc _ _ _ Nil)
    (MLoad _ b _ (Cons b Nil))
    (MStore b _ v (Cons b (Cons v Nil)))
    (MStoreI b _ _ (Cons b Nil))
    (MStackBlk _ _ Nil)
    (MStr _ _ Nil)
    (MFlt _ _ Nil)
    (MSym _ _ Nil)
    (MRegionCycle Nil)
    (MArr _ _ a ix v (Cons a (mir-opt-use ix (mir-opt-use v Nil))))
    (MReuse _ x _ _ (Cons x Nil))
    (MByteData _ h (Cons h Nil))
    (MByteBound _ h (Cons h Nil))
    (MByteFast _ _ o dt bd v (Cons o (Cons dt (Cons bd (mir-opt-use v Nil)))))
    (MRaw _ _ vs vs)
    (MTls _ _ vs vs)
    (MMem _ _ b _ v (Cons b (mir-opt-use v Nil)))
    (MCSub _ a _ (Cons a Nil))))

(defn mir-opt-use (v rest) (if (< v 0) rest (Cons v rest)))

(defn mi-def (i)
  (match i
    (MConst d _ d)
    (MMov d _ d)
    (MBin _ d _ _ d)
    (MBinI _ d _ _ d)
    (MParam d _ d)
    (MCall d _ _ _ _ d)
    (MByte _ d _ _ _ d)
    (MFnRef d _ d)
    (MAlloc d _ _ d)
    (MLoad d _ _ d)
    (MStackBlk d _ d)
    (MStr d _ d)
    (MFlt d _ d)
    (MSym d _ d)
    (MArr _ d _ _ _ d)
    (MReuse d _ _ _ d)
    (MByteFast _ d _ _ _ _ d)
    (MByteData d _ d)
    (MByteBound d _ d)
    (MRaw _ d _ d)
    (MTls d _ _ d)
    (MMem _ d _ _ _ d)
    (MCSub d _ _ d)
    (_ -1)))

; Instructions that call C (or other code) and so clobber the
; caller-saved registers.
(defn mi-is-call (i)
  (match i
    (MCall _ _ _ _ _ true)
    (MRegionCycle true)
    (_ false)))

; --- scratch memory -------------------------------------------------------

; One arena for a function's tables, reset before the next function.
(def mir-arena-cell (ffi-call "zyl_ref_new" (ffi-call "zyl_arena_create" 0 1000) 1000))
(defn mir-arena () (ffi-call "zyl_ref_get" mir-arena-cell 1000))
(defn mir-reset () (ffi-call "zyl_arena_reset" (mir-arena) 1000))

; --- dead definitions -------------------------------------------------------

; Use counts per vreg over an instruction list.
(defn mir-use-counts (xs nv)
  (let u (w-alloc (mir-arena) (+ nv 1))
    (let _ (mir-count-list xs u) u)))

(defn mir-count-list (xs u)
  (match xs
    (Nil unit)
    (Cons i t (let _ (mir-count-uses (mi-uses i) u 1) (mir-count-list t u)))))

(defn mir-count-uses (vs u k)
  (match vs
    (Nil unit)
    (Cons v t (let _ (w-set u v (+ (w-get u v) k)) (mir-count-uses t u k)))))

; No effect but its result: dropped when the result is never read.
(defn mi-pure (i)
  (match i
    (MConst _ _ true)
    (MMov _ _ true)
    (MBin op _ _ _ (not (or (= op 3) (= op 4))))
    (MBinI _ _ _ _ true)
    (MFnRef _ _ true)
    (MLoad _ _ _ true)
    (MStackBlk _ _ true)
    (MStr _ _ true)
    (MFlt _ _ true)
    (MSym _ _ true)
    (MByteData _ _ true)
    (MByteBound _ _ true)
    (MRaw k _ _ (or (<= k 3) (or (= k 18) (= k 46))))
    (MTls _ _ vs (is-nil vs))
    (MMem k _ _ _ _ (<= k 3))
    (MCSub _ _ _ true)
    (_ false)))

; Drops pure instructions whose result is never read, last first, so a
; chain feeding only dead code goes too (a def before its use in order).
(defn mir-dce (instrs nv)
  (let u (mir-use-counts instrs nv)
    (mir-dce-rev (list-reverse instrs) u Nil)))

(defn mir-dce-rev (rev u acc)
  (match rev
    (Nil acc)
    (Cons i t
      (let d (mi-def i)
        (if (and (>= d 0) (and (= (w-get u d) 0) (mi-pure i)))
          (let _ (mir-count-uses (mi-uses i) u -1) (mir-dce-rev t u acc))
          (mir-dce-rev t u (Cons i acc)))))))

; --- loop rotation ----------------------------------------------------------

; When a loop head (label h) is a conditional jump, a self jump repeats
; that test instead: the same registers are read, so the same branch is
; taken, one jump sooner. Label `nl` (unused) marks the head's fall-through.
(defn mir-rotate (instrs h nl)
  (match (mir-head-test instrs h)
    (Some t (mir-rot-go instrs t h nl))
    (None instrs)))

(defn mir-head-test (xs h)
  (match xs
    (Nil None)
    (Cons i t
      (match i
        (MLabel l (if (= l h) (match t (Cons j _ (if (mir-cond-jump j) (Some j) None)) (Nil None)) (mir-head-test t h)))
        (_ (mir-head-test t h))))))

(defn mir-cond-jump (i) (match i (MJf _ _ _ _ true) (MJfI _ _ _ _ true) (MJz _ _ true) (_ false)))

(defn mir-rot-go (xs t h nl)
  (match xs
    (Nil Nil)
    (Cons i rest
      (match i
        (MJmp l (if (= l h) (Cons t (Cons (MJmp nl) (mir-rot-go rest t h nl))) (Cons i (mir-rot-go rest t h nl))))
        (MLabel l (if (= l h)
                    (match rest (Cons j r2 (Cons i (Cons j (Cons (MLabel nl) (mir-rot-go r2 t h nl))))) (Nil xs))
                    (Cons i (mir-rot-go rest t h nl))))
        (_ (Cons i (mir-rot-go rest t h nl)))))))

; --- copy coalescing ------------------------------------------------------

; `MMov p s` where s is defined once, read only here, by an instruction at
; most 16 back in the same straight line that nothing between reads or
; writes p: that instruction writes p itself and the move goes.
; Moves first, then two-address operands over the final destinations.
(defn mir-coalesce (instrs nv) (mir-coalesce-pass (mir-coalesce-pass instrs nv false) nv true))

(defn mir-coalesce-pass (instrs nv two)
  (let n (list-length instrs)
    (let a (mir-array instrs n)
      (let u (mir-use-counts instrs nv)
        (let dc (w-alloc (mir-arena) (+ nv 1))
          (let di (w-alloc (mir-arena) (+ nv 1))
            (let _ (mir-def-index a n dc di 0)
              (let drop (w-alloc (mir-arena) (+ n 1))
                (let nd (w-alloc (mir-arena) (+ n 1))
                  (let _ (mir-co-scan a n u dc di drop nd 0 two)
                    (mir-co-emit a n drop nd 0)))))))))))

(defn mir-def-index (a n dc di i)
  (if (>= i n) unit
    (let d (mi-def (ffi-call "zyl_array_get" a i 1000))
      (let _ (if (>= d 0) (let _ (w-set dc d (+ (w-get dc d) 1)) (let _ (w-set di d i) unit)) unit)
        (mir-def-index a n dc di (+ i 1))))))

; nd holds the new destination + 1 (0: unchanged).
(defn mir-co-scan (a n u dc di drop nd j two)
  (if (>= j n) unit
    (let _ (match (ffi-call "zyl_array_get" a j 1000)
             (MMov p s
               (if (and (not two) (and (not (= p s)) (and (= (w-get u s) 1) (= (w-get dc s) 1))))
                 (let i (w-get di s)
                   (if (and (< i j) (and (<= (- j i) 16) (= (w-get drop i) 0)))
                     (if (mir-co-clear a (+ i 1) j p)
                       (let _ (w-set drop j 1)
                         (let _ (w-set nd i (+ p 1))
                           ; p's only def was this move: instruction i defines it now (chains).
                           (if (= (w-get dc p) 1) (let _ (w-set di p i) unit) unit)))
                       unit)
                     unit))
                 unit))
             ; d <- x op y with x defined just before and read only here: x's def writes d (two-address form)
             (MBin op d x y (if (and two (and (mir-two-addr op) (and (not (= d y)) (not (= x y))))) (mir-co-operand a u dc di drop nd j d x) unit))
             (MBinI op d x _ (if (and two (not (or (= op 3) (= op 4)))) (mir-co-operand a u dc di drop nd j d x) unit))
             (_ unit))
      (mir-co-scan a n u dc di drop nd (+ j 1) two))))

(defn mir-two-addr (op) (or (<= op 2) (and (>= op 11) (<= op 13))))

; drop 2 marks an instruction whose first operand becomes its destination.
(defn mir-co-operand (a u dc di drop nd j d x)
  (if (and (not (= d x)) (and (= (w-get u x) 1) (= (w-get dc x) 1)))
    (let i (w-get di x)
      (if (and (< i j) (and (<= (- j i) 16) (and (= (w-get drop i) 0) (mir-co-clear a (+ i 1) j d))))
        (let _ (w-set drop j 2) (let _ (w-set nd i (+ d 1)) unit))
        unit))
    unit))

; No control flow, and no read or write of p, in [k, j).
(defn mir-co-clear (a k j p)
  (if (>= k j) true
    (let ins (ffi-call "zyl_array_get" a k 1000)
      (if (or (mir-co-barrier ins) (or (= (mi-def ins) p) (mir-int-in p (mi-uses ins))))
        false
        (mir-co-clear a (+ k 1) j p)))))

(defn mir-co-barrier (i)
  (match i
    (MLabel _ true) (MJmp _ true) (MJf _ _ _ _ true) (MJfI _ _ _ _ true) (MJz _ _ true)
    (MRet _ true) (MTail _ _ _ true)
    (_ false)))

(defn mir-co-emit (a n drop nd i)
  (if (>= i n) Nil
    (if (= (w-get drop i) 2)
      (Cons (mir-self-operand (ffi-call "zyl_array_get" a i 1000)) (mir-co-emit a n drop nd (+ i 1)))
    (if (= (w-get drop i) 1)
      (mir-co-emit a n drop nd (+ i 1))
      (let ins (ffi-call "zyl_array_get" a i 1000)
        (Cons (if (> (w-get nd i) 0) (mi-with-def ins (- (w-get nd i) 1)) ins)
              (mir-co-emit a n drop nd (+ i 1))))))))

(defn mir-self-operand (i)
  (match i
    (MBin op d _ y (MBin op d d y))
    (MBinI op d _ k (MBinI op d d k))
    (_ i)))

; The instruction writing d instead.
(defn mi-with-def (i d)
  (match i
    (MConst _ n (MConst d n))
    (MMov _ s (MMov d s))
    (MBin op _ x y (MBin op d x y))
    (MBinI op _ x k (MBinI op d x k))
    (MParam _ k (MParam d k))
    (MCall _ sym u args l (MCall d sym u args l))
    (MByte k _ o b v (MByte k d o b v))
    (MFnRef _ nm (MFnRef d nm))
    (MAlloc _ k l (MAlloc d k l))
    (MLoad _ b o (MLoad d b o))
    (MStackBlk _ k (MStackBlk d k))
    (MStr _ t (MStr d t))
    (MFlt _ t (MFlt d t))
    (MSym _ t (MSym d t))
    (MArr k _ x ix v (MArr k d x ix v))
    (MReuse _ x b l (MReuse d x b l))
    (MByteData _ h (MByteData d h))
    (MByteBound _ h (MByteBound d h))
    (MByteFast k _ o dt bd v (MByteFast k d o dt bd v))
    (MRaw k _ vs (MRaw k d vs))
    (MTls _ sym vs (MTls d sym vs))
    (MMem k _ b o v (MMem k d b o v))
    (MCSub _ a m (MCSub d a m))
    (_ i)))

; --- liveness -------------------------------------------------------------

; Instructions are held in an (Array MI) for indexed access; live sets
; are word vectors of 64-bit masks, one bit per vreg.

(defn mir-array (instrs n)
  (let a (ffi-call "zyl_array_new" (mir-arena) (if (> n 0) n 1) 1000)
    (let _ (mir-fill a instrs 0)
      a)))

(defn mir-fill (a xs i)
  (match xs
    (Nil unit)
    (Cons h t (let _ (ffi-call "zyl_array_set" a i h 1000) (mir-fill a t (+ i 1))))))

; Position of each label, by label number.
(defn mir-label-pos (a n nlabels)
  (let w (w-alloc (mir-arena) (if (> nlabels 0) nlabels 1))
    (let _ (mir-label-scan a n w 0)
      w)))

(defn mir-label-scan (a n w i)
  (if (>= i n)
    unit
    (let _ (match (ffi-call "zyl_array_get" a i 1000) (MLabel l (let _ (w-set w l i) unit)) (_ unit))
      (mir-label-scan a n w (+ i 1)))))

; A bit set of vregs: `words` words at base index `row * words` of `w`.
(defn bs-get (w words row v)
  (let x (w-get w (+ (* row words) (/ v 64)))
    (= (bit-and (shr x (% v 64)) 1) 1)))

(defn bs-set (w words row v)
  (let k (+ (* row words) (/ v 64))
    (w-set w k (bit-or (w-get w k) (shl 1 (% v 64))))))

; live-in(i) = uses(i) | (live-out(i) - def(i)); live-out(i) = union of
; live-in over the successors. Iterated backwards to a fixpoint; returns
; the live-in table (n rows).
(defn mir-liveness (a n nv lpos)
  (let words (+ (/ nv 64) 1)
    (let lin (w-alloc (mir-arena) (if (> n 0) (* n words) 1))
      (let _ (mir-live-rounds a n words lin lpos)
        lin))))

(defn mir-live-rounds (a n words lin lpos)
  (if (mir-live-pass a n words lin lpos (- n 1) false)
    (mir-live-rounds a n words lin lpos)
    unit))

; One backward pass; true when any live-in set grew.
(defn mir-live-pass (a n words lin lpos i changed)
  (if (< i 0)
    changed
    (let c (mir-live-one a n words lin lpos i)
      (mir-live-pass a n words lin lpos (- i 1) (or changed c)))))

(defn mir-live-one (a n words lin lpos i)
  (let ins (ffi-call "zyl_array_get" a i 1000)
    (let d (mi-def ins)
      (mir-live-words a n words lin lpos i ins d 0 false))))

; Word by word: new = uses | (succ-out & ~def).
(defn mir-live-words (a n words lin lpos i ins d k changed)
  (if (>= k words)
    changed
    (let out (mir-succ-out a n words lin lpos i ins k)
      (let dm (if (and (>= d 0) (= (/ d 64) k)) (bit-not (shl 1 (% d 64))) -1)
        (let um (mir-use-mask (mi-uses ins) k 0)
          (let nw (bit-or um (bit-and out dm))
            (let old (w-get lin (+ (* i words) k))
              (let _ (w-set lin (+ (* i words) k) (bit-or old nw))
                (mir-live-words a n words lin lpos i ins d (+ k 1)
                                (or changed (not (= (bit-or old nw) old))))))))))))

(defn mir-use-mask (us k acc)
  (match us
    (Nil acc)
    (Cons v t (mir-use-mask t k (if (= (/ v 64) k) (bit-or acc (shl 1 (% v 64))) acc)))))

; Word k of the union of the successors' live-in sets.
(defn mir-succ-out (_a n words lin lpos i ins k)
  (let next (if (< (+ i 1) n) (w-get lin (+ (* (+ i 1) words) k)) 0)
    (match ins
      (MJmp l (w-get lin (+ (* (w-get lpos l) words) k)))
      (MJf _ _ _ l (bit-or next (w-get lin (+ (* (w-get lpos l) words) k))))
      (MJfI _ _ _ l (bit-or next (w-get lin (+ (* (w-get lpos l) words) k))))
      (MJz _ l (bit-or next (w-get lin (+ (* (w-get lpos l) words) k))))
      (MRet _ 0)
      (MTail _ _ _ 0)
      (_ next))))

; --- live intervals ---------------------------------------------------------

; start/end per vreg (-1 when never live), and whether a call lies
; strictly inside the interval (the value must then survive the call).
(deftype Iv (Iv Int Int Int Bool))  ; vreg, start, end, crosses a call

(defn mir-intervals (a n nv lin u)
  (let words (+ (/ nv 64) 1)
    (let st (w-alloc (mir-arena) (+ nv 1))
      (let en (w-alloc (mir-arena) (+ nv 1))
        (let _ (mir-iv-init st en 0 nv)
          (let _ (mir-iv-scan a n words lin st en 0 nv u)
            (mir-iv-list a n st en 0 nv lin words)))))))

(defn mir-iv-init (st en v nv)
  (if (>= v nv) unit (let _ (w-set st v -1) (let _ (w-set en v -1) (mir-iv-init st en (+ v 1) nv)))))

(defn mir-iv-touch (st en v i)
  (begin
    (if (or (< (w-get st v) 0) (< i (w-get st v))) (let _ (w-set st v i) unit) unit)
    (if (> i (w-get en v)) (let _ (w-set en v i) unit) unit)))

; A result nothing reads gets no interval (no register, no move).
(defn mir-iv-scan (a n words lin st en i nv u)
  (if (>= i n)
    unit
    (let ins (ffi-call "zyl_array_get" a i 1000)
      (let _ (mir-iv-live words lin st en i 0 nv)
        (let _ (if (and (>= (mi-def ins) 0) (> (w-get u (mi-def ins)) 0)) (mir-iv-touch st en (mi-def ins) i) unit)
          (let _ (mir-iv-uses st en (mi-uses ins) i)
            (mir-iv-scan a n words lin st en (+ i 1) nv u)))))))

(defn mir-iv-uses (st en us i)
  (match us
    (Nil unit)
    (Cons v t (let _ (mir-iv-touch st en v i) (mir-iv-uses st en t i)))))

(defn mir-iv-live (words lin st en i v nv)
  (if (>= v nv)
    unit
    (let _ (if (bs-get lin words i v) (mir-iv-touch st en v i) unit)
      (mir-iv-live words lin st en i (+ v 1) nv))))

(defn mir-iv-list (a n st en v nv lin words)
  (if (>= v nv)
    Nil
    (if (< (w-get st v) 0)
      (mir-iv-list a n st en (+ v 1) nv lin words)
      (Cons (Iv v (w-get st v) (w-get en v) (mir-crosses a (w-get st v) (w-get en v) lin words v n))
            (mir-iv-list a n st en (+ v 1) nv lin words)))))

; A call at a position in [from, to) after which the value is still live.
(defn mir-crosses (a from to lin words v n)
  (if (>= from to)
    false
    (if (and (mi-is-call (ffi-call "zyl_array_get" a from 1000))
             (and (not (= (mi-def (ffi-call "zyl_array_get" a from 1000)) v)) (and (< (+ from 1) n) (bs-get lin words (+ from 1) v))))
      true
      (mir-crosses a (+ from 1) to lin words v n))))

; --- linear scan ------------------------------------------------------------

; Locations: 1..5 caller-saved (rsi rdi r8 r9 r10), 6..10 callee-saved
; (rbx r12 r13 r14 r15); a spill slot is -(k+1). rax, rcx, rdx and r11
; are never allocated: the emitter uses them as scratch.
; Location 11 is rax, only for a result the next instruction returns (mir-ret-vregs).
(defn mir-reg-name (r)
  (if (= r 1) "rsi" (if (= r 2) "rdi" (if (= r 3) "r8" (if (= r 4) "r9" (if (= r 5) "r10"
  (if (= r 6) "rbx" (if (= r 7) "r12" (if (= r 8) "r13" (if (= r 9) "r14" (if (= r 10) "r15" (if (= r 12) "r11" "rax"))))))))))))

(defn mir-callee-saved (r) (and (>= r 6) (<= r 10)))

; Vregs defined once and read once, right after, by a consumer that is safe with rax: they live in rax.
(defn mir-ret-vregs (a n nv u)
  (let dc (w-alloc (mir-arena) (+ nv 1))
    (let _ (mir-def-counts a n dc 0)
      (mir-ret-scan a n u dc 0 Nil))))

(defn mir-def-counts (a n dc i)
  (if (>= i n) unit
    (let d (mi-def (ffi-call "zyl_array_get" a i 1000))
      (let _ (if (>= d 0) (let _ (w-set dc d (+ (w-get dc d) 1)) unit) unit)
        (mir-def-counts a n dc (+ i 1))))))

(defn mir-ret-scan (a n u dc i acc)
  (if (>= (+ i 1) n) acc
    (let ins (ffi-call "zyl_array_get" a i 1000)
      (let d (mi-def ins)
        (mir-ret-scan a n u dc (+ i 1)
          (if (and (>= d 0) (and (mir-rax-def-ok ins) (and (= (w-get u d) 1) (= (w-get dc d) 1))))
            (if (mir-rax-use-ok (ffi-call "zyl_array_get" a (+ i 1) 1000) d) (Cons d acc) acc)
            acc))))))

; Consumers whose sequence reads an operand held in rax before any scratch use of rax.
(defn mir-rax-use-ok (i d)
  (match i
    (MRet r (= r d))
    (MJfI _ a _ _ (= a d))
    (MJz a _ (= a d))
    (MMov _ s (= s d))
    (MBinI op _ a _ (and (= a d) (not (or (= op 3) (= op 4)))))
    (MJf _ a b _ (or (= a d) (= b d)))
    (_ false)))

; Emitters that write their result last, so rax as the result is safe.
(defn mir-rax-def-ok (i)
  (match i
    (MConst _ _ true) (MMov _ _ true) (MBin _ _ _ _ true) (MBinI _ _ _ _ true)
    (MLoad _ _ _ true) (MCall _ _ _ _ _ true) (MRaw _ _ _ true) (MMem k _ _ _ _ (<= k 3))
    (_ false)))

(defn mir-drop-ivs (ivs vs)
  (match ivs
    (Nil Nil)
    (Cons iv t (if (mir-int-in (iv-v iv) vs) (mir-drop-ivs t vs) (Cons iv (mir-drop-ivs t vs))))))

(defn mir-int-in (x xs) (match xs (Nil false) (Cons h t (if (= h x) true (mir-int-in x t)))))

(defn mir-set-locs (al vs r)
  (match vs
    (Nil al)
    (Cons v t (match al (Alloc w _ (let _ (w-set w v r) (mir-set-locs al t r)))))))

; The allocatable location of argument register k (rdi rsi rdx rcx r8
; r9), or 0 for the two that are scratch (rdx, rcx).
(defn mir-arg-reg-loc (k)
  (if (= k 0) 2 (if (= k 1) 1 (if (= k 4) 3 (if (= k 5) 4 0)))))

; Intervals sorted by start, then vreg (insertion sort; stable).
(defn mir-sort-iv (xs)
  (match xs
    (Nil Nil)
    (Cons h t (mir-insert-iv h (mir-sort-iv t)))))

(defn mir-insert-iv (x ys)
  (match ys
    (Nil (Cons x Nil))
    (Cons y t (if (mir-iv-before x y) (Cons x ys) (Cons y (mir-insert-iv x t))))))

(defn mir-iv-before (x y)
  (match x
    (Iv vx sx _ _
      (match y
        (Iv vy sy _ _ (if (< sx sy) true (if (> sx sy) false (< vx vy))))))))

(defn iv-v (x) (match x (Iv v _ _ _ v)))
(defn iv-s (x) (match x (Iv _ s _ _ s)))
(defn iv-e (x) (match x (Iv _ _ e _ e)))
(defn iv-call (x) (match x (Iv _ _ _ c c)))

; The result: location per vreg (0 = never live), and the spill-slot count.
(deftype Alloc (Alloc Words Int))

(defn alloc-loc (al v) (match al (Alloc w _ (w-get w v))))
(defn alloc-spills (al) (match al (Alloc _ n n)))

; `hint`: per vreg, a vreg + 1 whose register it would like (the source
; of the move that defines it), or 0.
; r11 (location 12) is allocatable only when `r11` says no emitted sequence uses it as scratch.
(defn mir-allocate (ivs nv hint r11)
  (let loc (w-alloc (mir-arena) (+ nv 1))
    (let busy (w-alloc (mir-arena) 13)   ; register -> vreg + 1 while taken
      (let _ (if r11 unit (let _ (w-set busy 12 -1) unit))
        (let nsp (mir-scan (mir-sort-iv ivs) Nil loc busy 0 hint)
          (Alloc loc nsp))))))

; The source of each MMov, recorded against its destination.
(defn mir-hints (a n nv)
  (let h (w-alloc (mir-arena) (+ nv 1))
    (let _ (mir-hint-scan a n h 0)
      h)))

(defn mir-hint-scan (a n h i)
  (if (>= i n)
    unit
    ; A parameter would like the register it arrives in (as a negative
    ; hint: -(register + 1)); a move's destination, its source's.
    (let _ (match (ffi-call "zyl_array_get" a i 1000)
             (MMov d s (if (= (w-get h d) 0) (let _ (w-set h d (+ s 1)) unit) unit))
             (MParam d k (let r (mir-arg-reg-loc k) (if (> r 0) (let _ (w-set h d (- 0 r)) unit) unit)))
             (MCall _ _ _ args _ (mir-hint-args h args 0))
             (MTail _ args _ (mir-hint-args h args 0))
             (_ unit))
      (mir-hint-scan a n h (+ i 1)))))

; An unhinted call argument would like its argument register.
(defn mir-hint-args (h args k)
  (match args
    (Nil unit)
    (Cons v t
      (let r (mir-arg-reg-loc k)
        (let _ (if (and (> r 0) (= (w-get h v) 0)) (let _ (w-set h v (- 0 r)) unit) unit)
          (mir-hint-args h t (+ k 1)))))))

; `active`: intervals holding registers, in the order they were given one.
(defn mir-scan (ivs active loc busy nsp hint)
  (match ivs
    (Nil nsp)
    (Cons iv rest
      (let act (mir-expire active (iv-s iv) loc busy)
        (let r (mir-pick-reg busy (iv-call iv) loc hint (iv-v iv))
          (if (> r 0)
            (let _ (w-set busy r (+ (iv-v iv) 1))
              (let _ (w-set loc (iv-v iv) r)
                (mir-scan rest (list-append act (Cons iv Nil)) loc busy nsp hint)))
            (mir-spill iv rest act loc busy nsp hint)))))))

; The hinted register when it is free and of the right class.
(defn mir-pick-reg (busy crosses loc hint v)
  (let h (w-get hint v)
    (let hr (if (> h 0) (w-get loc (- h 1)) (if (< h 0) (- 0 h) 0))
      (if (and (> hr 0) (and (not (= hr 11)) (and (= (w-get busy hr) 0) (or (not crosses) (mir-callee-saved hr)))))
        hr
        (mir-free-reg busy crosses)))))

(defn mir-expire (active pos loc busy)
  (match active
    (Nil Nil)
    (Cons a t
      ; An instruction reads its operands before it writes its result, so
      ; an interval that ends where this one starts can hand it its register.
      (if (<= (iv-e a) pos)
        (let _ (w-set busy (w-get loc (iv-v a)) 0)
          (mir-expire t pos loc busy))
        (Cons a (mir-expire t pos loc busy))))))

; A value live across a call needs a callee-saved register; any other
; takes a caller-saved one first.
(defn mir-free-reg (busy crosses)
  (if crosses
    (mir-first-free busy 6 10)
    (let r (mir-first-free busy 1 5)
      (if (> r 0) r (if (= (w-get busy 12) 0) 12 (mir-first-free busy 6 10))))))

(defn mir-first-free (busy lo hi)
  (if (> lo hi) 0 (if (= (w-get busy lo) 0) lo (mir-first-free busy (+ lo 1) hi))))

; No register: the active interval that ends last (and may use this
; interval's register class) gives up its register if it ends after
; this one; otherwise this one goes to memory.
(defn mir-spill (iv rest active loc busy nsp hint)
  (let victim (mir-last-ending active (iv-call iv) loc -1 -1)
    (if (and (>= victim 0) (> (mir-end-of active victim) (iv-e iv)))
      (let r (w-get loc victim)
        (let _ (w-set loc victim (- 0 (+ nsp 1)))
          (let _ (w-set loc (iv-v iv) r)
            (let _ (w-set busy r (+ (iv-v iv) 1))
              (mir-scan rest (list-append (mir-drop-v active victim) (Cons iv Nil)) loc busy (+ nsp 1) hint)))))
      (let _ (w-set loc (iv-v iv) (- 0 (+ nsp 1)))
        (mir-scan rest active loc busy (+ nsp 1) hint)))))

; A value live across a call can only take a callee-saved register.
(defn mir-last-ending (active needs-callee loc best best-end)
  (match active
    (Nil best)
    (Cons a t
      (if (and (> (iv-e a) best-end) (or (not needs-callee) (mir-callee-saved (w-get loc (iv-v a)))))
        (mir-last-ending t needs-callee loc (iv-v a) (iv-e a))
        (mir-last-ending t needs-callee loc best best-end)))))

(defn mir-end-of (active v)
  (match active
    (Nil -1)
    (Cons a t (if (= (iv-v a) v) (iv-e a) (mir-end-of t v)))))

(defn mir-drop-v (active v)
  (match active
    (Nil Nil)
    (Cons a t (if (= (iv-v a) v) t (Cons a (mir-drop-v t v))))))

; --- parallel moves -----------------------------------------------------------

; Moves into registers from operands (register names, memory or
; immediates, as text). A move whose destination no pending move still
; reads goes first; a cycle is broken through rax. Returns the moves in
; emission order as (dst, src) pairs.
(deftype PMove (PMove String String))

(defn pm-dst (m) (match m (PMove d _ d)))
(defn pm-src (m) (match m (PMove _ s s)))

(defn pm-sequence (moves)
  (pm-seq (pm-drop-self moves) Nil))

(defn pm-drop-self (ms)
  (match ms
    (Nil Nil)
    (Cons m t (if (str-eq (pm-dst m) (pm-src m)) (pm-drop-self t) (Cons m (pm-drop-self t))))))

(defn pm-seq (pending out)
  (match pending
    (Nil (list-reverse out))
    (Cons _ _
      (match (pm-ready pending pending)
        (Some m (pm-seq (pm-remove pending m) (Cons m out)))
        (None
          ; A cycle: park the first move's source in rax.
          (match pending
            (Cons m _
              (let src (pm-src m)
                (pm-seq (pm-redirect pending src "rax") (Cons (PMove "rax" src) out))))
            (Nil (list-reverse out))))))))

(defn pm-ready (cands all)
  (match cands
    (Nil None)
    (Cons m t (if (pm-read-by (pm-dst m) all m) (pm-ready t all) (Some m)))))

; Whether some other pending move reads register `r`.
(defn pm-read-by (r all self)
  (match all
    (Nil false)
    (Cons m t (if (and (not (pm-same m self)) (str-eq (pm-src m) r)) true (pm-read-by r t self)))))

(defn pm-same (a b) (and (str-eq (pm-dst a) (pm-dst b)) (str-eq (pm-src a) (pm-src b))))

(defn pm-remove (ms m)
  (match ms
    (Nil Nil)
    (Cons h t (if (pm-same h m) t (Cons h (pm-remove t m))))))

(defn pm-redirect (ms from to)
  (match ms
    (Nil Nil)
    (Cons m t (Cons (if (str-eq (pm-src m) from) (PMove (pm-dst m) to) m) (pm-redirect t from to)))))
