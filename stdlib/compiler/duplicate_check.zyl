; === Zyl Compiler — Duplicate Top-Level Definition Check ===
; Module: compiler/duplicate_check
;
; Two top-level `defn`s (or two top-level `deftype`s) with the same name
; are never legal: functions resolve by flat global name everywhere
; downstream (codegen's cg-fn-kind-search, arity_check's ac-lookup, the
; link-time symbol table), so a second definition doesn't get rejected --
; it just silently wins-or-loses depending on list order in whatever pass
; happens to scan first, with no diagnostic either way. `E_DUPLICATE_
; DEFINITION` was already reserved in error_codes.zyl's table (see its
; header comment) but never actually raised anywhere until this file.
;
; Scoped to the SAME resolved `exprs` list arity_check/mutability_check
; run against (post module-resolution, post macro-expansion) -- i.e. only
; names that collide WITHIN one actual compiled program. Several names
; (`main`, `list-map`, `map-get`, ...) are legitimately reused across
; DIFFERENT top-level programs/modules that are never `use`d together
; (driver.zyl's `main` vs repl.zyl's `main`) -- checking the whole repo
; instead of one resolved program would have produced constant false
; positives on already-correct code.
;
; "Never used together" was an assumption about which modules those were,
; and it was wrong once: core/map and collections/map both exported `Map`,
; `map-get`, `map-remove` and `map-has`, and a program that imported both
; was accepted here, with the three shared names silently resolving to the
; Int-only one. Nothing prevented the combination, so a name being reused
; across modules is not by itself evidence that it is safe. That pair is
; now core/map's Map and collections/intmap's IntMap.
;
; Undershoot posture, same as arity_check.zyl/mutability_check.zyl: this
; only looks at EDefn/EDeftype names, the two namespaces most likely to
; produce a real silent bug on collision. It deliberately does NOT flag
; ADT variant-constructor name reuse across different deftypes (e.g.
; `CI` naming both `CaptureInfo` and `CompletionItem` in unrelated
; modules) -- confirmed these are resolved per call/match site by the
; surrounding type context, not through any flat global registry, so a
; repeat variant name across two deftypes that legitimately never
; interact is not a bug at all, just a short name reused twice.

(use compiler/ast)
(use compiler/type_system)
(use compiler/expr_inner)
(use compiler/error_report)

(defn dc-check-program (exprs)
  (begin
    (dc-check-names "function" (dc-collect-defn-names exprs) Nil (dc-collect-structs exprs))
    (dc-check-names "type" (dc-collect-deftype-names exprs) Nil Nil)
    (dc-check-prelude exprs)))

; Struct deftypes, by name and node: a generated accessor `T.f`
; (expr_inner.zyl, struct-accessor-forms) carries its struct's span.
(defn dc-collect-structs (exprs)
  (match exprs
    (Nil Nil)
    (Cons e rest
      (match (Expr.inner e)
        (EDeftype name _ _ marker
          (match marker
            (Some _ (Cons (Pair name e) (dc-collect-structs rest)))
            (None (dc-collect-structs rest))))
        (_ (dc-collect-structs rest))))))

; The prelude's constructors are used unqualified throughout the standard
; library, so a program type declaring one of those names would capture
; every standard-library use of it (a `(deftype T (Some Int) None)` made
; core/list's `(Some rest)` an Int). Only the standard library may
; declare them.
(defn dc-check-prelude (exprs)
  (match exprs
    (Nil unit)
    (Cons e rest
      (begin
        (match (Expr.inner e)
          (EDeftype name variants _ _
            (if (dc-stdlib-key name) unit (dc-prelude-variants variants e)))
          (_ unit))
        (dc-check-prelude rest)))))

(defn dc-prelude-variants (variants site)
  (match variants
    (Nil unit)
    (Cons v rest
      (if (dc-prelude-ctor (err-name (AV.name v)))
        (dc-panic-code-at "E_DUPLICATE_VARIANT"
          (str-concat "constructor `" (str-concat (err-name (AV.name v)) "` is already a prelude constructor (Option, Result or List)"))
          "give this constructor a different name" site)
        (dc-prelude-variants rest site)))))

(defn dc-prelude-ctor (n)
  (or (str-eq n "Some") (or (str-eq n "None") (or (str-eq n "Ok")
    (or (str-eq n "Err") (or (str-eq n "Cons") (str-eq n "Nil")))))))

(defn dc-stdlib-key (n)
  (and (>= (str-length n) 8) (str-eq (str-substring n 0 8) "zyl/std@")))

(defn dc-collect-defn-names (exprs)
  (match exprs
    (Nil Nil)
    (Cons e rest
      (match (Expr.inner e)
        (EDefn name _ _ (Cons (Pair name e) (dc-collect-defn-names rest)))
        (_ (dc-collect-defn-names rest))))))

(defn dc-collect-deftype-names (exprs)
  (match exprs
    (Nil Nil)
    (Cons e rest
      (match (Expr.inner e)
        (EDeftype name _ _ _ (Cons (Pair name e) (dc-collect-deftype-names rest)))
        (_ (dc-collect-deftype-names rest))))))

; `seen` accumulates names already passed; a name already in `seen` is a
; duplicate. Linear scan, same complexity class as ac-lookup/mc-in-scope
; elsewhere in this pipeline -- fine for a few thousand top-level names.
; `names` is (List (Pair name node)): the node is carried only so the
; second definition can be reported at the line it is on.
(defn dc-check-names (kind names seen structs)
  (match names
    (Nil 0)
    (Cons p rest
      (match p
        (Pair n site
          (match (dc-find n seen)
            (Some first (dc-fail-pair kind n first site structs))
            (None (dc-check-names kind rest (Cons p seen) structs))))))))

(defn dc-find (name xs)
  (match xs
    (Nil None)
    (Cons h t (match h (Pair n site (if (str-eq n name) (Some site) (dc-find name t)))))))

; Two definitions of `n`: when one is a struct's generated accessor, the
; program's own one is reported, and told where the name comes from.
(defn dc-fail-pair (kind n first second structs)
  (match (dc-struct-of first structs)
    (Some sn (dc-fail-accessor n sn second))
    (None
      (match (dc-struct-of second structs)
        (Some sn (dc-fail-accessor n sn first))
        (None (dc-fail kind n second))))))

; The struct whose form `site` was generated from, by span.
(defn dc-struct-of (site structs)
  (match structs
    (Nil None)
    (Cons s rest
      (match s
        (Pair sn se
          (if (and (= (ffi-call "zyl_span_off" site 1000) (ffi-call "zyl_span_off" se 1000))
                   (= (ffi-call "zyl_span_file" site 1000) (ffi-call "zyl_span_file" se 1000)))
            (Some sn)
            (dc-struct-of site rest)))))))

(defn dc-fail-accessor (n sn site)
  (let name (err-name n)
    (let field (err-name (dc-after-dot name 0))
      (dc-panic-code-at "E_DUPLICATE_DEFINITION"
        (str-concat "function `" (str-concat name (str-concat "` is already defined by `(defstruct " (str-concat (err-name sn) " ...)`, which defines an accessor for every field"))))
        (str-concat "delete this definition and call the generated `(" (str-concat name (str-concat " p)`, or rename it: `(defn get-" (str-concat field " ...)`"))))
        site))))

(defn dc-after-dot (s i)
  (if (>= i (str-length s))
    s
    (if (= (ffi-call "zyl_cstr_byte_at" s i 1000) 46)
      (str-substring s (+ i 1) (- (str-length s) (+ i 1)))
      (dc-after-dot s (+ i 1)))))

(defn dc-fail (kind name site)
  (let m1 ""
    (let m2 (str-concat m1 kind)
      (let m3 (str-concat m2 " `")
        (let m4 (str-concat m3 (err-name name))
          (let msg (str-concat m4 "` is defined more than once in this program")
            (dc-panic-at msg site)))))))

(defn dc-panic-code-at (code msg help site)
  (let off (ffi-call "zyl_span_off" site 1000)
    (let fid (ffi-call "zyl_span_file" site 1000)
      (ffi-call "zyl_panic" (err-at code msg fid off help) 1000))))

(defn dc-panic-at (msg site)
  (let off (ffi-call "zyl_span_off" site 1000)
    (let fid (ffi-call "zyl_span_file" site 1000)
      (let text (err-at "E_DUPLICATE_DEFINITION" msg fid off "rename one of them, or delete the repeated definition")
        (ffi-call "zyl_panic" text 1000)))))
