; === Zyl Standard Library — Compiler mutability/capability check ===
; Module: compiler/mutability_check
;
; Wires in spec/06-capability-types.md's aliasing invariant and
; spec/07-region-memory-model.md S10 for the one shape this compiler can
; actually construct today: a plain `let` binding is TCap (immutable);
; only a `let-mut` binding is TMut (assignable via `set!`). Before this
; pass, `set!` on a plain `let`-bound name silently compiled and ran --
; spec/07 S10's "Either exactly one TMut reference OR any number of TCap
; references" invariant existed only on paper (E_MUT_CONFLICT was
; defined in error_codes.zyl but never raised anywhere; see
; docs' security-audit findings).
;
; This is a conservative, syntax-driven walk over the pre-lowering Expr
; tree (same stage as assert_lowering.zyl/closure_inline.zyl), not a
; general points-to/alias analysis: it tracks which plain names are
; currently in scope as let-mut bindings and rejects any `set!` whose
; target isn't one of them. Two things this deliberately does NOT
; attempt, matching region_inference.zyl's own stated philosophy of
; undershooting rather than risking a false positive that breaks a
; legitimate program:
;   - Cross-actor Send-capability beyond the spawn/send shapes below
;     (spec/07 R3). (A `set!` on a captured outer let-mut from inside a
;     closure IS rejected -- see mc-fn-fence.)
;   - General pointer/alias tracking through the raw FFI/arena
;     primitives (alloc-*, atomic-*, ffi-pin/unpin) -- those bypass the
;     surface `let`/`let-mut` distinction entirely by design (see the
;     security audit's separate finding on that raw-primitive surface).
;
; Every shape with a nested Expr is walked explicitly; anything else
; (declarations, atoms, module/test metadata) falls through the final
; wildcard arm unchanged -- undershooting (an unreached `set!` deep
; inside an unwalked shape) only misses a diagnostic, it can never
; reject a valid program, which is the failure direction that matters:
; a compiler that's too eager to flag E_MUT_CONFLICT on legitimate code
; is far worse than one that misses an edge case.

(use compiler/ast)
(use compiler/expr_inner)
(use core/option)
(use compiler/error_report)

; --- entry point ------------------------------------------------------------

(defn mc-check-program (prog)
  (mc-check-top prog))

(defn mc-check-top (forms)
  (match forms
    (Nil 0)
    (Cons e rest
      (begin
        (match (Expr.inner e)
          (EDefn _ _ body (mc-expr body Nil Nil))
          (ETestDecl _ body _ (mc-expr body Nil Nil))
          (_ 0))
        (mc-check-top rest)))))

; --- scope helpers -----------------------------------------------------------

(defn mc-in-scope (name scope)
  (match scope
    (Nil false)
    (Cons h t (if (str-eq h name) true (mc-in-scope name t)))))

; A `fn`/`lambda` body is walked with this marker pushed onto the
; enclosing mutscope: a let-mut found only BEHIND it belongs to an
; enclosing scope, so the closure holds a by-value copy of it (spec
; §7: capture is by value; icnf.zyl's ic-lambda-closure copies each
; captured value into the environment). A `set!` on that copy would
; silently change only the closure's private copy -- never the
; binding the program named -- so it is rejected instead. The marker
; contains a space, which no identifier can.
(defn mc-fn-fence () "fn fence")

; 0: not a let-mut in scope; 1: a let-mut of this function body;
; 2: a let-mut of an enclosing scope, seen through a closure boundary.
(defn mc-scope-status (name scope fenced)
  (match scope
    (Nil 0)
    (Cons h t
      (if (str-eq h name)
        (if (> fenced 0) 2 1)
        (if (str-eq h (mc-fn-fence))
          (mc-scope-status name t 1)
          (mc-scope-status name t fenced))))))

(defn mc-fail-captured-set (e name)
  (let m1 (str-concat "set! target `" name)
    (let msg (str-concat m1 "` is a let-mut of an enclosing scope, captured by value by this closure")
      (let off (ffi-call "zyl_span_off" e 1000)
        (let fid (ffi-call "zyl_span_file" e 1000)
          (let hint "closures capture by value (spec 7); return the new value from the closure and set! it at the binding's own scope"
            (ffi-call "zyl_panic" (err-at "E_MUT_CONFLICT" msg fid off hint) 1000)))))))

(defn mc-check-set (e name mutscope lets)
  (let status (mc-scope-status name mutscope 0)
    (if (= status 2)
      (mc-fail-captured-set e name)
      (if (= status 0)
        (mc-fail-immutable-set e name lets)
        0))))

; `lets` holds (Pair name node) for each plain `let` in scope, innermost first.
(defn mc-find-let (name lets)
  (match lets
    (Nil None)
    (Cons pr rest
      (match pr
        (Pair n node (if (str-eq n name) (Some node) (mc-find-let name rest)))))))

(defn mc-fail-immutable-set (e name lets)
  (let m1 (str-concat "set! target `" (err-name name))
    (let msg (str-concat m1 "` is not a let-mut binding in scope")
      (let labels (match (mc-find-let name lets)
                    (Some node (Cons (err-label-at node "bound here by `let`, which is immutable (TCap)") Nil))
                    (None Nil))
        (let off (ffi-call "zyl_span_off" e 1000)
          (let fid (ffi-call "zyl_span_file" e 1000)
            (let hint "only a let-mut binding is TMut and may be assigned; declare it with `let-mut`"
              (ffi-call "zyl_panic" (err-at-labels "E_MUT_CONFLICT" msg fid off labels hint) 1000))))))))

(defn mc-list (xs mutscope lets)
  (match xs
    (Nil 0)
    (Cons h t (begin (mc-expr h mutscope lets) (mc-list t mutscope lets)))))

(defn mc-arms (arms mutscope lets)
  (match arms
    (Nil 0)
    (Cons a rest
      (match a
        (MA _ _ body (begin (mc-expr body mutscope lets) (mc-arms rest mutscope lets)))))))

(defn mc-cond-clauses (clauses mutscope lets)
  (match clauses
    (Nil 0)
    (Cons pr rest
      (match pr
        (Pair c b
          (begin
            (mc-expr c mutscope lets)
            (mc-expr b mutscope lets)
            (mc-cond-clauses rest mutscope lets)))))))

(defn mc-for-names (bindings)
  (match bindings
    (Nil Nil)
    (Cons pr rest
      (match pr
        (Pair name _ (Cons name (mc-for-names rest)))))))

(defn mc-for-inits (bindings mutscope lets)
  (match bindings
    (Nil 0)
    (Cons pr rest
      (match pr
        (Pair _ opt
          (begin
            (match opt
              (Some e2 (mc-expr e2 mutscope lets))
              (None 0))
            (mc-for-inits rest mutscope lets)))))))

(defn mc-append (xs ys)
  (match xs
    (Nil ys)
    (Cons h t (Cons h (mc-append t ys)))))

(defn mc-butlast (xs)
  (match xs
    (Nil Nil)
    (Cons h t (if (nil? t) Nil (Cons h (mc-butlast t))))))

(defn mc-check-ffi-args (args)
  (match args
    (Nil 0)
    (Cons a rest
      (begin
        (match (Expr.inner a)
          (ELambda _ _ _
            (ffi-call "zyl_panic" "E_INVALID_CAPABILITY: ffi-call argument is a closure, which is not FFI_Pinnable (Int/Float/Bool/String/composed only) -- pin its result data explicitly instead of passing the closure itself" 1000))
          (EFn _ _ _
            (ffi-call "zyl_panic" "E_INVALID_CAPABILITY: ffi-call argument is a closure, which is not FFI_Pinnable (Int/Float/Bool/String/composed only) -- pin its result data explicitly instead of passing the closure itself" 1000))
          (_ 0))
        (mc-check-ffi-args rest)))))

; --- the actual check ---------------------------------------------------

(defn mc-expr (e mutscope lets)
  (match (Expr.inner e)
    (ESetBang name val
      (begin
        (mc-check-set e name mutscope lets)
        (mc-expr val mutscope lets)))
    (ELet name val body
      (begin
        (mc-expr val mutscope lets)
        (mc-expr body mutscope (Cons (Pair name e) lets))))
    (ELetMut name val body
      (begin
        (mc-expr val mutscope lets)
        (mc-expr body (Cons name mutscope) (Cons (Pair name e) lets))))
    (EDef _ val (mc-expr val mutscope lets))
    (EIf c t eb
      (begin
        (mc-expr c mutscope lets)
        (mc-expr t mutscope lets)
        (mc-expr eb mutscope lets)))
    (EWhile c body (begin (mc-expr c mutscope lets) (mc-expr body mutscope lets)))
    (EFor bindings cond body
      (let names (mc-for-names bindings)
        (begin
          (mc-for-inits bindings mutscope lets)
          (mc-expr cond (mc-append names mutscope) lets)
          (mc-expr body (mc-append names mutscope) lets))))
    (ECond clauses (mc-cond-clauses clauses mutscope lets))
    (EBegin exprs (mc-list exprs mutscope lets))
    (ELambda _ _ body (mc-expr body (Cons (mc-fn-fence) mutscope) lets))
    (EFn _ _ body (mc-expr body (Cons (mc-fn-fence) mutscope) lets))
    (ETryCatch tbody _ handler
      (begin (mc-expr tbody mutscope lets) (mc-expr handler mutscope lets)))
    (EMatch subj arms (begin (mc-expr subj mutscope lets) (mc-arms arms mutscope lets)))
    (ECall op args (begin (mc-expr op mutscope lets) (mc-list args mutscope lets)))
    ; `(ffi-call "sym" a b timeout)` arrives here as EApply("ffi-call",
    ; args) -- expr_inner.zyl's dispatch has no dedicated ffi-call
    ; parser (see icnf.zyl's own ic-expr comment on this same fact) --
    ; not as the EFfiCall constructor that name might suggest; that
    ; constructor is only ever built synthetically by assert_lowering.zyl,
    ; never from real ffi-call source. The trailing timeout arg is
    ; dropped before the FFI_Pinnable check, same as icnf.zyl's own
    ; lowering does.
    (EApply fname args
      (begin
        (if (str-eq fname "ffi-call")
          (mc-check-ffi-args (mc-butlast args))
          0)
        (mc-list args mutscope lets)))
    ; spec/07 R4: ffi-call requires an FFI_Pinnable argument type (Int,
    ; Float, Bool, String, or composed thereof) -- a closure is none of
    ; those (it's a heap [tag,code,env] triple or bare code pointer,
    ; internal representation with no FFI_Pinnable meaning), so passing
    ; one directly is exactly the type-confusion R4 exists to prevent.
    ; This only catches the syntactically-obvious case (a literal
    ; `fn`/`lambda` written straight in the call) -- passing a closure
    ; via an intermediate variable isn't traced (that needs real type
    ; info this pass doesn't have), same conservative-undershoot
    ; posture as everywhere else in this file.
    (EFfiCall _ args _
      (begin
        (mc-check-ffi-args args)
        (mc-list args mutscope lets)))
    (EFfiPin e2 (mc-expr e2 mutscope lets))
    (EFfiUnpin e2 (mc-expr e2 mutscope lets))
    (EAssert c _ (mc-expr c mutscope lets))
    (EUnwrap e2 (mc-expr e2 mutscope lets))
    (EStructGet se _ (mc-expr se mutscope lets))
    (EMakeStruct _ fields (mc-list fields mutscope lets))
    (EMakeVariant _ _ args (mc-list args mutscope lets))
    (EPrint exprs (mc-list exprs mutscope lets))
    (EExit c (mc-expr c mutscope lets))
    (EClose e2 (mc-expr e2 mutscope lets))
    (EFileOpen a b (begin (mc-expr a mutscope lets) (mc-expr b mutscope lets)))
    (EFileRead a b (begin (mc-expr a mutscope lets) (mc-expr b mutscope lets)))
    (EFileWrite a b (begin (mc-expr a mutscope lets) (mc-expr b mutscope lets)))
    (EFileClose e2 (mc-expr e2 mutscope lets))
    (EBufAppend a b (begin (mc-expr a mutscope lets) (mc-expr b mutscope lets)))
    (EWithResource _ init body
      (begin (mc-expr init mutscope lets) (mc-expr body mutscope lets)))
    ; spec/07 R3 / spec/06 rule 5: a spawned closure must only capture
    ; Send-capable (TCap/TAtomic) variables, and a sent message must
    ; itself be Send-capable -- a let-mut (TMut) variable escaping into
    ; another actor thread this way is exactly the aliasing hazard the
    ; capability system exists to catch (two threads, one with the
    ; ability to mutate, sharing the same binding). Checkable
    ; syntactically with the same mutscope this pass already threads:
    ; if the spawned/sent expression references any name that's a
    ; let-mut binding in the CURRENT (enclosing, pre-spawn) scope,
    ; that's a TMut value crossing an actor boundary.
    (ESpawn closure
      (begin
        (if (mc-refs-any closure mutscope)
          (mc-fail-leak e closure mutscope lets "spawned closure captures let-mut (TMut) variable `" "only Send-capable (non-mut) captures may cross into another actor")
          0)
        (mc-expr closure mutscope lets)))
    (ESend actor msg
      (begin
        (mc-expr actor mutscope lets)
        (if (mc-refs-any msg mutscope)
          (mc-fail-leak e msg mutscope lets "message sent to an actor references let-mut (TMut) variable `" "messages must be Send-capable; send a copy bound with plain `let`")
          0)
        (mc-expr msg mutscope lets)))
    (ESendClosure actor closure _
      (begin (mc-expr actor mutscope lets) (mc-expr closure mutscope lets)))
    (ETestDecl _ body _ (mc-expr body mutscope lets))
    (EAssertEqual l r (begin (mc-expr l mutscope lets) (mc-expr r mutscope lets)))
    (EAssertFail e2 _ (mc-expr e2 mutscope lets))
    (EAssertTrue e2 _ (mc-expr e2 mutscope lets))
    (EAssertFalse e2 _ (mc-expr e2 mutscope lets))
    (ETestProperty _ _ body (mc-expr body mutscope lets))
    (ESetup exprs (mc-list exprs mutscope lets))
    (ETeardown exprs (mc-list exprs mutscope lets))
    (ETestCompile e2 _ (mc-expr e2 mutscope lets))
    (EDefn _ _ body (mc-expr body Nil Nil))
    (_ 0)))

; First name of `names` that `e` references, or "".
(defn mc-first-ref (e names)
  (match names
    (Nil "")
    (Cons n rest (if (mc-refs-any e (Cons n Nil)) n (mc-first-ref e rest)))))

(defn mc-fail-leak (site inner mutscope lets what hint)
  (let name (mc-first-ref inner mutscope)
    (let m1 (str-concat what (err-name name))
      (let msg (str-concat m1 "` from the enclosing scope")
        (let labels (match (mc-find-let name lets)
                      (Some node (Cons (err-label-at node "declared `let-mut` here") Nil))
                      (None Nil))
          (let off (ffi-call "zyl_span_off" site 1000)
            (let fid (ffi-call "zyl_span_file" site 1000)
              (ffi-call "zyl_panic" (err-at-labels "E_CAPABILITY_LEAK" msg fid off labels hint) 1000))))))))

; --- free-variable-reference scan (for ESpawn/ESend above) --------------
; True if `e` references ANY name in `names` anywhere in its tree.
; Deliberately the same undershoot-not-overshoot posture as mc-expr: an
; unwalked shape just can't be detected as a capture here, it never
; produces a false positive.

(defn mc-or-list (xs names)
  (match xs
    (Nil false)
    (Cons h t (if (mc-refs-any h names) true (mc-or-list t names)))))

(defn mc-or-arms (arms names)
  (match arms
    (Nil false)
    (Cons a rest
      (match a
        (MA _ _ body (if (mc-refs-any body names) true (mc-or-arms rest names)))))))

(defn mc-refs-any (e names)
  (match (Expr.inner e)
    (EAtom a
      (match a
        (AIdent n (mc-in-scope n names))
        (_ false)))
    (ECall op args (if (mc-refs-any op names) true (mc-or-list args names)))
    (EApply _ args (mc-or-list args names))
    (EDef _ val (mc-refs-any val names))
    (ELet _ val body (if (mc-refs-any val names) true (mc-refs-any body names)))
    (ELetMut _ val body (if (mc-refs-any val names) true (mc-refs-any body names)))
    (EIf c t eb
      (if (mc-refs-any c names) true
        (if (mc-refs-any t names) true (mc-refs-any eb names))))
    (EWhile c body (if (mc-refs-any c names) true (mc-refs-any body names)))
    (EBegin exprs (mc-or-list exprs names))
    (ELambda _ _ body (mc-refs-any body names))
    (EFn _ _ body (mc-refs-any body names))
    (ETryCatch tbody _ handler
      (if (mc-refs-any tbody names) true (mc-refs-any handler names)))
    (EMatch subj arms (if (mc-refs-any subj names) true (mc-or-arms arms names)))
    (EFfiCall _ args _ (mc-or-list args names))
    (EFfiPin e2 (mc-refs-any e2 names))
    (EFfiUnpin e2 (mc-refs-any e2 names))
    (EAssert c _ (mc-refs-any c names))
    (EUnwrap e2 (mc-refs-any e2 names))
    (ESetBang name val
      (if (mc-in-scope name names) true (mc-refs-any val names)))
    (EStructGet se _ (mc-refs-any se names))
    (EMakeStruct _ fields (mc-or-list fields names))
    (EMakeVariant _ _ args (mc-or-list args names))
    (EPrint exprs (mc-or-list exprs names))
    (ESpawn closure (mc-refs-any closure names))
    (ESend actor msg (if (mc-refs-any actor names) true (mc-refs-any msg names)))
    (EWithResource _ init body
      (if (mc-refs-any init names) true (mc-refs-any body names)))
    (_ false)))
