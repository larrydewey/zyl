  (Cons (EC "E_PKG_ARCHIVE_INVALID" 19 1 "package: archive for N V violates the canonical format - M")
  (Cons (EC "E_PKG_NATIVE_PATH_ESCAPE" 19 1 "package: native source path P escapes the package root")
  (Cons (EC "E_PKG_NATIVE_FLAG_DENIED" 19 1 "package: cflag F is outside the allowlist")
  (Cons (EC "E_PKG_NATIVE_BUILD_FAILED" 19 1 "package: cc failed on native source P")
  (Cons (EC "E_PKG_FEATURE_UNKNOWN" 19 1 "package: feature F is not declared by N")
  (Cons (EC "E_PKG_FEATURE_NESTED" 19 1 "package: feature-gate is valid at top level only")
  (Cons (EC "E_PKG_FEATURE_COLLISION" 19 1 "package: gated definition D collides with a base definition")
  (Cons (EC "E_PROV_ATTACH" 19 1 "build: the provenance trailer could not be attached: M")
  Nil))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
; ---------------------------------------------------------------------------
; ACCESSORS
; ---------------------------------------------------------------------------

(defn ec-name (code)
  (match code
    (EC name phase severity message name)))

(defn ec-phase (code)
  (match code
    (EC name phase severity message phase)))

(defn ec-severity (code)
  (match code
    (EC name phase severity message severity)))

(defn ec-message (code)
  (match code
    (EC name phase severity message message)))

; True (1) if code-name appears in the catalog.
(defn ec-contains (code-name codes)
  (match codes
    (Nil false)
    (Cons head rest
      (if (str-eq (ec-name head) code-name)
        true
        (ec-contains code-name rest)))))

; First catalog entry matching code-name; EFound found=0 with an empty code
; when absent.
(defn ec-lookup (code-name codes)
  (match codes
    (Nil (EFound 0 (EC "" 0 0 "")))
    (Cons head rest
      (if (str-eq (ec-name head) code-name)
        (EFound 1 head)
        (ec-lookup code-name rest)))))

(defn ec-count (codes)
  (match codes
    (Nil 0)
    (Cons head rest (+ 1 (ec-count rest)))))
