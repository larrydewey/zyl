          (Cons (EC "E_BYTEBUF_INVALID" 10 1 "runtime: bytebuf magic tag mismatch")
          (Cons (EC "E_BYTEBUF_OVERLAP" 10 1 "runtime: bytebuf append overlapping slice")
          (Cons (EC "E_STACK_BYTEBUF_RETURN" 4 1 "type: Stack ByteBuf cannot be returned")
          (Cons (EC "E_GLOBAL_BYTEBUF_MUT" 4 1 "type: Global ByteBuf must be immutable")
              (Cons (EC "E_CANNOT_INFER" 5 1 "type: cannot infer concrete type for generic parameter G at S - no call-site evidence")
        (Cons (EC "E_CANNOT_INFER" 5 1 "type: cannot infer concrete type for generic parameter G at S - no call-site evidence")
          (Cons (EC "E_CAPABILITY_LEAK" 13 1 "capability: TMut leaked across boundary at S")
            (Cons (EC "E_CIRCULAR_MODULE" 9 1 "module: circular dependency: M")
              (Cons (EC "E_CODEGEN" 8 1 "codegen: M")
                (Cons (EC "E_CODEGEN_BUFFER_FULL" 8 1 "codegen: output buffer full at S")
                  (Cons (EC "E_CODEGEN_BUFFER_LIMIT" 8 1 "codegen: buffer limit reached: M")
                    (Cons (EC "E_CONTRACT_VIOLATION" 14 1 "contract: contract violation - M at S")
                      (Cons (EC "E_DIVISION_BY_ZERO" 15 1 "numeric: division by zero at S")
                        (Cons (EC "E_DUPLICATE_DEFINITION" 4 1 "type: duplicate definition of N at S. previously defined at P")
                          (Cons (EC "E_DUPLICATE_IMPL" 12 1 "trait: duplicate impl of T for U at S")
                            (Cons (EC "E_DUPLICATE_VARIANT" 4 1 "type: duplicate variant V in deftype at S")
