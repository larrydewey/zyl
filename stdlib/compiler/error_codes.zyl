; ---------------------------------------------------------------------------
; ACCESSORS
; ---------------------------------------------------------------------------

(defn ec-name (code)
  (match code
    (EC name phase severity message name)))

(defn ec-phase (code)
  (match code
    (EC name phase severity message phase)))

(defn ec-severity (code)
  (match code
    (EC name phase severity message severity)))

(defn ec-message (code)
  (match code
    (EC name phase severity message message)))

; True (1) if code-name appears in the catalog.
(defn ec-contains (code-name codes)
  (match codes
    (Nil 0)
    (Cons head rest
      (if (= (str-eq (ec-name head) code-name) 1)
        1
        (ec-contains code-name rest)))))

; First catalog entry matching code-name; EFound found=0 with an empty code
; when absent.
(defn ec-lookup (code-name codes)
  (match codes
    (Nil (EFound 0 (EC "" 0 0 "")))
    (Cons head rest
      (if (= (str-eq (ec-name head) code-name) 1)
        (EFound 1 head)
        (ec-lookup code-name rest)))))

(defn ec-count (codes)
  (match codes
    (Nil 0)
    (Cons head rest (+ 1 (ec-count rest)))))
