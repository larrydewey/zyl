  (Cons (EC "E_PKG_UNSIGNED" 19 1 "package: index entry for N V carries no signature")
  (Cons (EC "E_PKG_YANKED" 19 1 "package: resolution selected yanked version V of N")
  (Cons (EC "E_PKG_LOCK_STALE" 19 1 "package: --locked, but the manifests imply a different graph")
  (Cons (EC "E_PKG_LOCK_INVALID" 19 1 "package: zyl.lock is malformed or of an unknown version")
  (Cons (EC "E_PKG_COMPILER_TOO_OLD" 19 1 "package: N requires compiler version V, this is C")
  (Cons (EC "E_PKG_UNKNOWN_EDITION" 19 1 "package: edition E is not known to this compiler")
