; ===========================================================================
; error_codes.zyl — Error code catalog
;
; Single-source-of-truth error codes for the native error system (Phase A.8).
; Phase: 1 lexer | 2 parser | 3 macro | 4 type | 5 mono | 6 region | 7 icnf
;        8 codegen | 9 module | 10 runtime | 11 test | 12 trait | 13 cap
;        14 contract | 15 numeric | 16 ffi | 17 match | 18 misc/user
;        19 package (spec v5.0 SS31: manifest, lock, index, fetch, signature)
; Severity: 1 error | 2 warning | 3 note
;
; Every code name, phase, and default message mirrors src/error.rs (Rust
; bootstrap) plus the self-hosted-only codes from parser.zyl / icnf.zyl /
; monomorphization.zyl. Structural format: one form per line.
; ===========================================================================

(deftype ErrorCode
  ; name, phase, severity, message
  (EC String Int Int String))

(deftype ErrorFind
  ; found, code
  (EFound Int ErrorCode))

(deftype ECatalog
  (ECat list (List ErrorCode)))

; ---------------------------------------------------------------------------
; CATALOG
; ---------------------------------------------------------------------------

