; ===========================================================================
; error_codes.zyl — Error code catalog
;
; Single-source-of-truth error codes for the native error system (Phase A.8).
; Phase: 1 lexer | 2 parser | 3 macro | 4 type | 5 mono | 6 region | 7 icnf
;        8 codegen | 9 module | 10 runtime | 11 test | 12 trait | 13 cap
;        14 contract | 15 numeric | 16 ffi | 17 match | 18 misc/user
;        19 package (spec v5.0 SS31: manifest, lock, index, fetch, signature)
; Severity: 1 error | 2 warning | 3 note
; verify/error-codes.sh fails when a code here is raised nowhere, or a raised code is missing here.
;
; The code names, phases, and default messages started as a mirror of the
; removed Rust bootstrap's src/error.rs (git history, b8bc283), plus
; the codes only the self-hosted compiler raises. Structural format: one
; form per line.
;
; There is deliberately no float-overflow code. A Float literal outside the
; binary64 range is not an error: `1e400` is `inf` and `1e-400` is `0.0`,
; which is what IEEE 754 says and what C, Python, JavaScript and Rust all
; produce. The catalog once carried E_FLOAT_OVERFLOW, raised nowhere, and a
; documented code that cannot happen is worse than a missing one -- it
; implies a check that does not exist. This is the opposite of the integer
; case, where an out-of-range literal was a silent 0 or a silent wrap: both
; are plausible-looking wrong numbers, so those are E_INTEGER_OVERFLOW.
; Regression float-literal-range.zyl pins both ends.
; ===========================================================================

(deftype ErrorCode
  ; name, phase, severity, message
  (EC String Int Int String))

(deftype ErrorFind
  ; found, code
  (EFound Int ErrorCode))

(deftype ECatalog
  (ECat (List ErrorCode)))

; ---------------------------------------------------------------------------
; CATALOG
; ---------------------------------------------------------------------------

(defn error-codes ()
  (Cons (EC "E_BYTE_VALUE_OOB" 1 1 "lexer: byte literal out of range 0-255")
  (Cons (EC "E_INVALID_ESCAPE" 1 1 "lexer: invalid escape sequence in a string literal at S")
