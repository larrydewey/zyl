                                  (Cons (EC "E_EXPECTED_RBRACKET" 2 1 "parser: expected ] but found T at S")
                                    (Cons (EC "E_EXPECTED_RCURLY" 2 1 "parser: expected } but found T at S")
                                      (Cons (EC "E_EXPECTED_RPAREN" 2 1 "parser: expected ) at S but found T")
                                        (Cons (EC "E_FFI_TIMEOUT" 16 1 "ffi: call exceeded timeout of M ms at S")
                                          (Cons (EC "E_FLOAT_OVERFLOW" 1 1 "lexer: float overflow in literal L at S")
                                            (Cons (EC "E_INTEGER_OVERFLOW" 1 1 "lexer: integer overflow in literal L at S")
                                              (Cons (EC "E_INVALID_CAPABILITY" 13 1 "type: invalid capability usage for F - M at S")
                                                (Cons (EC "E_INVALID_CHAR" 1 1 "lexer: invalid character C at S")
                                                  (Cons (EC "E_LIST_NTH_OOB" 10 1 "runtime: list-nth index out of bounds at S")
                                                    (Cons (EC "E_MACRO_ILLEGAL_ACCESS" 3 1 "macro: illegal runtime access in macro expansion")
                                                      (Cons (EC "E_MACRO_NON_TERMINATION" 3 1 "macro: expansion loop detected (max depth exceeded)")
                                                        (Cons (EC "E_MATCH_ARM_COMPLEX" 7 1 "match: arm combines a constant with multiple calls - bind to lets first")
                                                          (Cons (EC "E_MATCH_NONEXHAUSTIVE" 17 1 "match: non-exhaustive pattern match at S - missing cases: M")
                                                            (Cons (EC "E_MODULE_NOT_FOUND" 9 1 "module: module M not found at P")
(Cons (EC "E_MUT_CONFLICT" 13 1 "aliasing: mutable reference conflict at S")
                                                                      (Cons (EC "E_NULL_POINTER" 10 1 "runtime: null pointer dereference")
                                                                  (Cons (EC "E_OUT_OF_MEMORY" 10 1 "runtime: out of memory")
                                                                  (Cons (EC "E_OVERFLOW" 15 1 "numeric: integer overflow at S")
                                                                  (Cons (EC "E_REGION_ESCAPE" 6 1 "region: value escapes region constraint at S")
                                                                    (Cons (EC "E_RESERVED_KEYWORD" 2 1 "parser: reserved keyword K cannot be used as identifier at S")
                                                                      (Cons (EC "E_RETURN_TYPE_MISMATCH" 4 1 "type: return type mismatch in F - expected T, got U at S")
                                                                        (Cons (EC "E_SYMBOL_NOT_EXPORTED" 9 1 "module: symbol N not exported by M")
                                                                          (Cons (EC "E_TEST_FAILURE" 11 1 "test: assertion failed - M")
                                                                            (Cons (EC "E_TEST_RUNNER_ERROR" 11 1 "test: runner error - M")
                                                                              (Cons (EC "E_TOPLEVEL_STMTS_WITH_EXPLICIT_MAIN" 7 1 "icnf: top-level statements combined with explicit main")
                                                                                (Cons (EC "E_TRAIT_BOUND_NOT_SATISFIED" 12 1 "type: unsatisfied trait bound T : U at S")
                                                                                  (Cons (EC "E_TRAIT_NOT_DERIVABLE" 12 1 "trait: cannot derive T for type U at S")
                                                                                    (Cons (EC "E_TRAIT_NOT_FOUND" 12 1 "trait: no implementation found for T at S")
                                                                                      (Cons (EC "E_TYPE_MISMATCH" 4 1 "type: type mismatch at S - expected E, found F")
                                                                                        (Cons (EC "E_UNBALANCED_PARENS" 2 1 "parser: unbalanced parens - open and close counts differ")
                                                                                          (Cons (EC "E_UNBALANCED_UNCLOSED" 2 1 "parser: unclosed opener - opened at S, never reached its matching closer")
                                                                                            (Cons (EC "E_UNBALANCED_UNEXPECTED_CLOSE" 2 1 "parser: unexpected closing delimiter at S - no opener is open here")
                                                                                              (Cons (EC "E_UNBALANCED_MISMATCHED_BRACKET" 2 1 "parser: closing delimiter at S does not match its opener")
                                                                                          (Cons (EC "E_UNBOUND_VARIABLE" 4 1 "type: unbound variable V at S")
                                                                                            (Cons (EC "E_UNEXPECTED_EOF" 1 1 "lexer: unexpected EOF while expecting C at S")
                                                                                              (Cons (EC "E_UNEXPECTED_TOKEN_IN_EXPR" 2 1 "parser: unexpected token T in expression context at S")
                                                                                                (Cons (EC "E_UNINITIALIZED_USE" 6 1 "variable: use of uninitialized variable V at S")
                                                                                                  (Cons (EC "E_UNKNOWN_GENERIC_PARAM" 4 1 "type: unknown generic parameter G at S")
                                                                                                    (Cons (EC "E_UNKNOWN_TYPE" 4 1 "type: unknown type T at S")
                                                                                                      (Cons (EC "E_UNTERMINATED_STRING" 1 1 "lexer: unterminated string at S")
                                                                                                        (Cons (EC "E_USER_ERROR" 10 1 "runtime: user error - M at S")
                                                                                                          Nil))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
; ---------------------------------------------------------------------------
; ACCESSORS
; ---------------------------------------------------------------------------

(defn ec-name (code)
  (match code
    (EC name phase severity message name)))

(defn ec-phase (code)
  (match code
    (EC name phase severity message phase)))

(defn ec-severity (code)
  (match code
    (EC name phase severity message severity)))

(defn ec-message (code)
  (match code
    (EC name phase severity message message)))

; True (1) if code-name appears in the catalog.
(defn ec-contains (code-name codes)
  (match codes
    (Nil 0)
    (Cons head rest
      (if (= (str-eq (ec-name head) code-name) 1)
        1
        (ec-contains code-name rest)))))

; First catalog entry matching code-name; EFound found=0 with an empty code
; when absent.
(defn ec-lookup (code-name codes)
  (match codes
    (Nil (EFound 0 (EC "" 0 0 "")))
    (Cons head rest
      (if (= (str-eq (ec-name head) code-name) 1)
        (EFound 1 head)
        (ec-lookup code-name rest)))))

(defn ec-count (codes)
  (match codes
    (Nil 0)
    (Cons head rest (+ 1 (ec-count rest)))))
