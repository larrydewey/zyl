; === Zyl Compiler — Unused Bindings / Shadowing / Duplicate Parameters ===
; Module: compiler/unused_check
;
; Four checks living together because they share one machine: a flat,
; whole-function reference collector (uc-refs) plus a scope-threading
; walk (uc-walk-scope) with the exact same shape coverage and threading
; discipline as arity_check.zyl's ac-expr / mutability_check.zyl's
; mc-expr (same pipeline stage: post module-resolution, post macro-
; expansion).
;
;   - W_UNUSED_FUNCTION: a top-level `defn` never referenced by name
;     anywhere else in this resolved program (excluding its own body --
;     self-recursion doesn't count as being "used").
;   - W_UNUSED_PARAMETER / W_UNUSED_VARIABLE: a `defn`/`fn`/`lambda`
;     parameter, or a `let`/`let-mut`/`for` binding, that never appears
;     as a plain identifier reference anywhere in its owning function
;     body.
;   - W_SHADOWED_BINDING: a `let`/`let-mut`/`for`/lambda-or-fn-param/
;     match-arm-bound name that reuses a name already in scope.
;   - E_DUPLICATE_PARAMETER: two parameters of the same `defn`/`fn`/
;     `lambda` sharing a name -- purely syntactic, zero legitimate use,
;     kept as a hard error rather than a warning.
;
; Exemption: `_` (the codegen-recognized wildcard -- see cg-bind-one,
; which skips slot allocation for it entirely) and any `_`-prefixed name
; (`_b`, for a discard that still wants a readable name) are exempt from
; the unused, shadowing and duplicate-parameter checks alike, so `_` may
; repeat freely within one binding list. This codebase used to spell
; discards `d1`, `d2`, ... for exactly that reason; that convention is
; gone.
;
; Undershoot posture, same rationale as arity_check.zyl throughout:
;   - uc-refs is deliberately OVER-inclusive (walks every shape it can,
;     including ones arity_check.zyl doesn't bother with, like the byte/
;     atomic primitives) -- for a reference collector, over-counting only
;     ever SUPPRESSES a true-positive warning, it can never manufacture a
;     false one. Under-counting is the dangerous direction here, not
;     over-counting.
;   - The unused check is flat per function, not scope-precise: if a name
;     is used ANYWHERE in the function body, every same-named binding
;     inside it (however deeply shadowed) is considered "used". Misses a
;     real dead shadowed binding sometimes; never flags a live one.
;   - Match-arm pattern-bound names are shadow-checked but NOT unused-
;     checked (out of scope for this pass -- by far the highest-volume
;     binding site in this codebase via the very d1/d2/... convention
;     this file already has to exempt everywhere else, and scoping this
;     precisely needs real scoping the flat approach doesn't have).
;   - A nested (non-top-level) `defn` resets to its own params only, same
;     as arity_check.zyl/mutability_check.zyl already do -- it does NOT
;     inherit or contribute to the enclosing function's shadow/unused
;     bookkeeping, checked independently via its own recursive call.

(use core/list)
(use core/option)
(use compiler/ast)
(use compiler/expr_inner)
(use compiler/error_report)

; uc-check-unused-functions is NOT wired in here, even though it's fully
; implemented below: core/core (compose, is-even, print-string, ...) is
; auto-injected into every single program by module_resolver.zyl's
; mr-resolve-program (see its own header comment), and the resolved
; `exprs` this whole pipeline stage operates on has NO per-defn file-
; provenance field to tell "the user's own dead helper" apart from "an
; auto-injected stdlib function this particular tiny program doesn't
; happen to call". Confirmed by direct testing: even a 5-line test file
; produces a dozen-plus W_UNUSED_FUNCTION warnings for ordinary,
; perfectly normal core/core entries -- pure noise, the opposite of the
; "pleasant development experience" this whole file exists for. Wiring
; this in for real needs the AST to carry which file each top-level form
; came from (or scoping the check to only the entry file's own defns),
; neither of which exists yet.
(defn uc-check-program (exprs)
  (uc-check-top exprs))

; ===========================================================================
; EXEMPTION
; ===========================================================================

(defn uc-is-exempt (name)
  (if (< (str-length name) 1)
    false
    (str-eq (str-substring name 0 1) "_")))

(defn uc-in-list (name xs)
  (match xs
    (Nil false)
    (Cons h t (if (str-eq h name) true (uc-in-list name t)))))

; Warnings go through the runtime sink: stderr, or the LSP's capture buffer.
(defn uc-warn-line (msg)
  (ffi-call "zyl_warn_emit" msg 1000))

; ===========================================================================
; UNUSED TOP-LEVEL FUNCTION
; ===========================================================================

(defn uc-check-unused-functions (exprs)
  (let names (uc-collect-defn-names exprs)
    (let refs (uc-collect-all-refs exprs)
      (uc-report-unused-fns names refs))))

(defn uc-collect-defn-names (exprs)
  (match exprs
    (Nil Nil)
    (Cons e rest
      (match (Expr.inner e)
        (EDefn name _ _ (Cons name (uc-collect-defn-names rest)))
        (_ (uc-collect-defn-names rest))))))

(defn uc-collect-all-refs (exprs)
  (match exprs
    (Nil Nil)
    (Cons e rest
      (match (Expr.inner e)
        (EDefn name _ body (list-append (uc-filter-out name (uc-refs body)) (uc-collect-all-refs rest)))
        (ETestDecl _ body _ (list-append (uc-refs body) (uc-collect-all-refs rest)))
        (_ (uc-collect-all-refs rest))))))

(defn uc-filter-out (name xs)
  (match xs
    (Nil Nil)
    (Cons h t (if (str-eq h name) (uc-filter-out name t) (Cons h (uc-filter-out name t))))))

(defn uc-should-check-fn (name)
  (if (str-eq name "main") false (if (uc-is-exempt name) false true)))

(defn uc-report-unused-fns (names refs)
  (match names
    (Nil 0)
    (Cons n rest
      (begin
        (if (uc-should-check-fn n)
          (if (uc-in-list n refs) unit (uc-warn-unused-fn n))
          unit)
        (uc-report-unused-fns rest refs)))))

(defn uc-warn-unused-fn (name)
  (let m1 "W_UNUSED_FUNCTION: `"
    (let m2 (str-concat m1 name)
      (uc-warn-line (str-concat m2 "` is defined but never called")))))

; ===========================================================================
; WHOLE-BODY REFERENCE COLLECTOR (flat, over-inclusive)
; ===========================================================================

(defn uc-refs-list (xs)
  (match xs
    (Nil Nil)
    (Cons h t (list-append (uc-refs h) (uc-refs-list t)))))

(defn uc-refs-arms (arms)
  (match arms
    (Nil Nil)
    (Cons a rest
      (match a
        (MA _ patterns body (list-append (uc-refs-list patterns) (list-append (uc-refs body) (uc-refs-arms rest))))))))

(defn uc-refs-cond (clauses)
  (match clauses
    (Nil Nil)
    (Cons pr rest
      (match pr (Pair c body (list-append (uc-refs c) (list-append (uc-refs body) (uc-refs-cond rest))))))))

(defn uc-refs-for-inits (bindings)
  (match bindings
    (Nil Nil)
    (Cons pr rest
      (match pr
        (Pair _ valOpt
          (list-append
            (match valOpt (Some v (uc-refs v)) (None Nil))
            (uc-refs-for-inits rest)))))))

(defn uc-refs (e)
  (match (Expr.inner e)
    (EAtom atom (match atom (AIdent n (Cons n Nil)) (_ Nil)))
    (ECall op args (list-append (uc-refs op) (uc-refs-list args)))
    (EDef _ val (uc-refs val))
    (EDefn _ _ body (uc-refs body))
    (ELet _ val body (list-append (uc-refs val) (uc-refs body)))
    (ELetMut _ val body (list-append (uc-refs val) (uc-refs body)))
    (EIf c t eb (list-append (uc-refs c) (list-append (uc-refs t) (uc-refs eb))))
    (ETryCatch tbody _ handler (list-append (uc-refs tbody) (uc-refs handler)))
    (EMatch subj arms (list-append (uc-refs subj) (uc-refs-arms arms)))
    (ESpawn body (uc-refs body))
    (ESend a m (list-append (uc-refs a) (uc-refs m)))
    (ESendClosure a c _ (list-append (uc-refs a) (uc-refs c)))
    (EFfiCall _ args _ (uc-refs-list args))
    (EFfiPin e2 (uc-refs e2))
    (EFfiUnpin e2 (uc-refs e2))
    (EAssert c _ (uc-refs c))
    (EUnwrap e2 (uc-refs e2))
    (EWhile c body (list-append (uc-refs c) (uc-refs body)))
    (EFor bindings cond body (list-append (uc-refs-for-inits bindings) (list-append (uc-refs cond) (uc-refs body))))
    (ECond clauses (uc-refs-cond clauses))
    (EBegin exprs (uc-refs-list exprs))
    (ELambda _ _ body (uc-refs body))
    (EFn _ _ body (uc-refs body))
    (EStructGet se _ (uc-refs se))
    (EMakeStruct _ fields (uc-refs-list fields))
    (EMakeVariant _ _ args (uc-refs-list args))
    (ESetBang name val (Cons name (uc-refs val)))
    (EPrint exprs (uc-refs-list exprs))
    (EExit c (uc-refs c))
    (EClose e2 (uc-refs e2))
    (EFileOpen a b (list-append (uc-refs a) (uc-refs b)))
    (EFileRead a b (list-append (uc-refs a) (uc-refs b)))
    (EFileWrite a b (list-append (uc-refs a) (uc-refs b)))
    (EFileClose e2 (uc-refs e2))
    (EBufAppend a b (list-append (uc-refs a) (uc-refs b)))
    (EWithResource _ init body (list-append (uc-refs init) (uc-refs body)))
    (ETestDecl _ body _ (uc-refs body))
    (EAssertEqual l r (list-append (uc-refs l) (uc-refs r)))
    (EAssertFail e2 _ (uc-refs e2))
    (EAssertTrue e2 _ (uc-refs e2))
    (EAssertFalse e2 _ (uc-refs e2))
    (ETestProperty _ _ body (uc-refs body))
    (ESetup exprs (uc-refs-list exprs))
    (ETeardown exprs (uc-refs-list exprs))
    (ETestCompile e2 _ (uc-refs e2))
    (EApply fname args (Cons fname (uc-refs-list args)))
    (EMacroDef _ args body (list-append (uc-refs-list args) (uc-refs body)))
    (EUnknown _ args (uc-refs-list args))
    (ELoadByte _ off buf (list-append (uc-refs off) (uc-refs buf)))
    (ELoadByteSigned _ off buf (list-append (uc-refs off) (uc-refs buf)))
    (EStoreByte _ off buf val (list-append (uc-refs off) (list-append (uc-refs buf) (uc-refs val))))
    (EStoreByteSigned _ off buf val (list-append (uc-refs off) (list-append (uc-refs buf) (uc-refs val))))
    (EByteSlice buf start len (list-append (uc-refs buf) (list-append (uc-refs start) (uc-refs len))))
    (EByteSliceSub buf start len (list-append (uc-refs buf) (list-append (uc-refs start) (uc-refs len))))
    (EByteBufAppend buf val (list-append (uc-refs buf) (uc-refs val)))
    (EByteBufLen buf (uc-refs buf))
    (EByteBufCap buf (uc-refs buf))
    (EByteBufPtr buf (uc-refs buf))
    (EAlignCheck e2 _ (uc-refs e2))
    (EAtomicLoad buf off (list-append (uc-refs buf) (uc-refs off)))
    (EAtomicStore buf off val (list-append (uc-refs buf) (list-append (uc-refs off) (uc-refs val))))
    (EAtomicAdd buf off val (list-append (uc-refs buf) (list-append (uc-refs off) (uc-refs val))))
    (EAtomicSub buf off val (list-append (uc-refs buf) (list-append (uc-refs off) (uc-refs val))))
    (EAtomicCAS buf off exp2 nv (list-append (uc-refs buf) (list-append (uc-refs off) (list-append (uc-refs exp2) (uc-refs nv)))))
    (EAtomicFetchAdd buf off val (list-append (uc-refs buf) (list-append (uc-refs off) (uc-refs val))))
    (EAtomicMax buf off val (list-append (uc-refs buf) (list-append (uc-refs off) (uc-refs val))))
    (EAtomicMin buf off val (list-append (uc-refs buf) (list-append (uc-refs off) (uc-refs val))))
    (_ Nil)))

; ===========================================================================
; PARAMETERS: duplicate + unused
; ===========================================================================

(defn uc-param-names (params)
  (match params
    (Nil Nil)
    (Cons p rest (Cons (P.name p) (uc-param-names rest)))))

(defn uc-check-dup-params (fname names seen)
  (match names
    (Nil 0)
    (Cons n rest
      (if (uc-is-exempt n)
        (uc-check-dup-params fname rest seen)
        (if (uc-in-list n seen)
          (uc-fail-dup-param fname n)
          (uc-check-dup-params fname rest (Cons n seen)))))))

(defn uc-fail-dup-param (fname pname)
  (let m1 "E_DUPLICATE_PARAMETER: `"
    (let m2 (str-concat m1 pname)
      (let m3 (str-concat m2 "` is used more than once in `")
        (let m4 (str-concat m3 fname)
          (let m5 (str-concat m4 "`'s parameter list")
            (ffi-call "zyl_panic" m5 1000)))))))

; Each P node carries its source span (parse-single-param copies it).
(defn uc-check-unused-params (refs params)
  (match params
    (Nil 0)
    (Cons p rest
      (let n (P.name p)
        (begin
          (if (uc-is-exempt n) unit (if (uc-in-list n refs) unit (uc-warn-unused n "parameter" p)))
          (uc-check-unused-params refs rest))))))

(defn uc-warn-unused (name kind site)
  (let code (if (str-eq kind "parameter") "W_UNUSED_PARAMETER" "W_UNUSED_VARIABLE")
    (let m1 (str-concat "`" name)
      (let msg (str-concat m1 "` is never used")
        (err-warn-at code msg site "remove it, or prefix it with `_` to mark it deliberately unused")))))

; ===========================================================================
; SHADOWING
; ===========================================================================

(defn uc-check-shadow (name scope site)
  (if (uc-is-exempt name)
    unit
    (if (uc-in-list name scope) (uc-warn-shadow name site) unit)))

(defn uc-check-shadow-list (names scope site)
  (match names
    (Nil 0)
    (Cons n rest (begin (uc-check-shadow n scope site) (uc-check-shadow-list rest scope site)))))

(defn uc-warn-shadow (name site)
  (let m1 (str-concat "`" name)
    (let msg (str-concat m1 "` shadows an outer binding of the same name")
      (err-warn-at "W_SHADOWED_BINDING" msg site "rename one of the two bindings"))))

; ===========================================================================
; TOP-LEVEL DRIVER
; ===========================================================================

(defn uc-check-top (exprs)
  (match exprs
    (Nil 0)
    (Cons e rest
      (begin
        (match (Expr.inner e)
          (EDefn name params body (uc-check-fn name params body))
          (ETestDecl _ body _ (uc-check-fn-body body))
          (_ 0))
        (uc-check-top rest)))))

(defn uc-check-fn (name params body)
  (let pnames (uc-param-names params)
    (begin
      (uc-check-dup-params name pnames Nil)
      (let refs (uc-refs body)
        (begin
          (uc-check-unused-params refs params)
          (uc-walk-scope body refs pnames))))))

(defn uc-check-fn-body (body)
  (let refs (uc-refs body)
    (uc-walk-scope body refs Nil)))

; ===========================================================================
; SCOPE-THREADING WALK — shadow + unused-let checks, same shape coverage
; as arity_check.zyl's ac-expr.
; ===========================================================================

(defn uc-walk-list (xs refs scope)
  (match xs
    (Nil 0)
    (Cons h t (begin (uc-walk-scope h refs scope) (uc-walk-list t refs scope)))))

(defn uc-walk-for-bindings (bindings refs scope site)
  (match bindings
    (Nil scope)
    (Cons pr rest
      (match pr
        (Pair name valOpt
          (begin
            (uc-check-shadow name scope site)
            (if (uc-is-exempt name) unit (if (uc-in-list name refs) unit (uc-warn-unused name "variable" site)))
            (match valOpt (Some v (uc-walk-scope v refs scope)) (None 0))
            (uc-walk-for-bindings rest refs (Cons name scope) site)))))))

(defn uc-walk-cond-clauses (clauses refs scope)
  (match clauses
    (Nil 0)
    (Cons pr rest
      (match pr
        (Pair c body (begin (uc-walk-scope c refs scope) (uc-walk-scope body refs scope) (uc-walk-cond-clauses rest refs scope)))))))

(defn uc-walk-arms (arms refs scope)
  (match arms
    (Nil 0)
    (Cons a rest
      (match a
        (MA _ patterns body
          (let pnames (uc-pattern-names patterns)
            (begin
              (uc-check-shadow-list pnames scope body)
              (uc-walk-scope body refs (list-append pnames scope))
              (uc-walk-arms rest refs scope))))))))

(defn uc-pattern-names (fields)
  (match fields
    (Nil Nil)
    (Cons f rest
      (match (Expr.inner f)
        (EAtom atom (match atom (AIdent n (Cons n (uc-pattern-names rest))) (_ (uc-pattern-names rest))))
        (_ (uc-pattern-names rest))))))

(defn uc-walk-lambda-like (label params body refs scope site)
  (let pnames (uc-param-names params)
    (begin
      (uc-check-dup-params label pnames Nil)
      (uc-check-shadow-list pnames scope site)
      (uc-check-unused-params refs params)
      (uc-walk-scope body refs (list-append pnames scope)))))

(defn uc-walk-scope (e refs scope)
  (match (Expr.inner e)
    (ESetBang _ val (uc-walk-scope val refs scope))
    (ELet name val body
      (begin
        (uc-check-shadow name scope e)
        (if (uc-is-exempt name) unit (if (uc-in-list name refs) unit (uc-warn-unused name "variable" e)))
        (uc-walk-scope val refs scope)
        (uc-walk-scope body refs (Cons name scope))))
    (ELetMut name val body
      (begin
        (uc-check-shadow name scope e)
        (if (uc-is-exempt name) unit (if (uc-in-list name refs) unit (uc-warn-unused name "variable" e)))
        (uc-walk-scope val refs scope)
        (uc-walk-scope body refs (Cons name scope))))
    (EDef _ val (uc-walk-scope val refs scope))
    (EIf c t eb (begin (uc-walk-scope c refs scope) (uc-walk-scope t refs scope) (uc-walk-scope eb refs scope)))
    (EWhile c body (begin (uc-walk-scope c refs scope) (uc-walk-scope body refs scope)))
    (EFor bindings cond body
      (let newscope (uc-walk-for-bindings bindings refs scope e)
        (begin (uc-walk-scope cond refs newscope) (uc-walk-scope body refs newscope))))
    (ECond clauses (uc-walk-cond-clauses clauses refs scope))
    (EBegin exprs (uc-walk-list exprs refs scope))
    (ELambda _ params body (uc-walk-lambda-like "<lambda>" params body refs scope e))
    (EFn _ params body (uc-walk-lambda-like "<fn>" params body refs scope e))
    (ETryCatch tbody cvar handler
      (begin
        (uc-walk-scope tbody refs scope)
        (uc-check-shadow cvar scope e)
        (uc-walk-scope handler refs (Cons cvar scope))))
    (EMatch subj arms (begin (uc-walk-scope subj refs scope) (uc-walk-arms arms refs scope)))
    (ECall op args (begin (uc-walk-scope op refs scope) (uc-walk-list args refs scope)))
    (EApply _ args (uc-walk-list args refs scope))
    (EFfiCall _ args _ (uc-walk-list args refs scope))
    (EFfiPin e2 (uc-walk-scope e2 refs scope))
    (EFfiUnpin e2 (uc-walk-scope e2 refs scope))
    (EAssert c _ (uc-walk-scope c refs scope))
    (EUnwrap e2 (uc-walk-scope e2 refs scope))
    (EStructGet se _ (uc-walk-scope se refs scope))
    (EMakeStruct _ fields (uc-walk-list fields refs scope))
    (EMakeVariant _ _ args (uc-walk-list args refs scope))
    (EPrint exprs (uc-walk-list exprs refs scope))
    (EExit c (uc-walk-scope c refs scope))
    (EClose e2 (uc-walk-scope e2 refs scope))
    (EFileOpen a b (begin (uc-walk-scope a refs scope) (uc-walk-scope b refs scope)))
    (EFileRead a b (begin (uc-walk-scope a refs scope) (uc-walk-scope b refs scope)))
    (EFileWrite a b (begin (uc-walk-scope a refs scope) (uc-walk-scope b refs scope)))
    (EFileClose e2 (uc-walk-scope e2 refs scope))
    (EBufAppend a b (begin (uc-walk-scope a refs scope) (uc-walk-scope b refs scope)))
    (EWithResource _ init body (begin (uc-walk-scope init refs scope) (uc-walk-scope body refs scope)))
    (ESpawn closure (uc-walk-scope closure refs scope))
    (ESend actor msg (begin (uc-walk-scope actor refs scope) (uc-walk-scope msg refs scope)))
    (ESendClosure actor closure _ (begin (uc-walk-scope actor refs scope) (uc-walk-scope closure refs scope)))
    (ETestDecl _ body _ (uc-walk-scope body refs scope))
    (EAssertEqual l r (begin (uc-walk-scope l refs scope) (uc-walk-scope r refs scope)))
    (EAssertFail e2 _ (uc-walk-scope e2 refs scope))
    (EAssertTrue e2 _ (uc-walk-scope e2 refs scope))
    (EAssertFalse e2 _ (uc-walk-scope e2 refs scope))
    (ETestProperty _ _ body (uc-walk-scope body refs scope))
    (ESetup exprs (uc-walk-list exprs refs scope))
    (ETeardown exprs (uc-walk-list exprs refs scope))
    (ETestCompile e2 _ (uc-walk-scope e2 refs scope))
    (ELoadByte _ off buf (begin (uc-walk-scope off refs scope) (uc-walk-scope buf refs scope)))
    (ELoadByteSigned _ off buf (begin (uc-walk-scope off refs scope) (uc-walk-scope buf refs scope)))
    (EStoreByte _ off buf val (begin (uc-walk-scope off refs scope) (uc-walk-scope buf refs scope) (uc-walk-scope val refs scope)))
    (EStoreByteSigned _ off buf val (begin (uc-walk-scope off refs scope) (uc-walk-scope buf refs scope) (uc-walk-scope val refs scope)))
    (EByteSlice buf start len (begin (uc-walk-scope buf refs scope) (uc-walk-scope start refs scope) (uc-walk-scope len refs scope)))
    (EByteSliceSub buf start len (begin (uc-walk-scope buf refs scope) (uc-walk-scope start refs scope) (uc-walk-scope len refs scope)))
    (EByteBufAppend buf val (begin (uc-walk-scope buf refs scope) (uc-walk-scope val refs scope)))
    (EByteBufLen buf (uc-walk-scope buf refs scope))
    (EByteBufCap buf (uc-walk-scope buf refs scope))
    (EByteBufPtr buf (uc-walk-scope buf refs scope))
    (EAlignCheck e2 _ (uc-walk-scope e2 refs scope))
    (EAtomicLoad buf off (begin (uc-walk-scope buf refs scope) (uc-walk-scope off refs scope)))
    (EAtomicStore buf off val (begin (uc-walk-scope buf refs scope) (uc-walk-scope off refs scope) (uc-walk-scope val refs scope)))
    (EAtomicAdd buf off val (begin (uc-walk-scope buf refs scope) (uc-walk-scope off refs scope) (uc-walk-scope val refs scope)))
    (EAtomicSub buf off val (begin (uc-walk-scope buf refs scope) (uc-walk-scope off refs scope) (uc-walk-scope val refs scope)))
    (EAtomicCAS buf off exp2 nv (begin (uc-walk-scope buf refs scope) (uc-walk-scope off refs scope) (uc-walk-scope exp2 refs scope) (uc-walk-scope nv refs scope)))
    (EAtomicFetchAdd buf off val (begin (uc-walk-scope buf refs scope) (uc-walk-scope off refs scope) (uc-walk-scope val refs scope)))
    (EAtomicMax buf off val (begin (uc-walk-scope buf refs scope) (uc-walk-scope off refs scope) (uc-walk-scope val refs scope)))
    (EAtomicMin buf off val (begin (uc-walk-scope buf refs scope) (uc-walk-scope off refs scope) (uc-walk-scope val refs scope)))
    (EDefn name params body (uc-check-fn name params body))
    (_ 0)))
