; ===========================================================================
; error_report.zyl — Rich error formatting (Phase A.8 / Phase 1)
;
; Builds ErrorLocation + source-snippet rendering primitives used by the
; native pipeline. All builders return plain Strings; the self-hosted
; driver consumes the fields directly for its renderer.
;
; Every str-concat receives only pre-bound variables or literals, with
; intermediate values going through let. That rule dates from the
; archived Rust bootstrap, which miscompiled an inline call operand to
; its inlined zyl_cstr_concat; the self-hosted compiler has no such bug,
; so it is now only a style kept for readability.
; ===========================================================================

(use compiler/error_codes)
; internal-mode-p: the compiler's own build keeps every warning.
(use compiler/rt_mode)
; sb-read-file, for the on-demand scan of the installed stdlib.
(use compiler/sexp_balance)

; Int-first field order (like CheckState in sexp_balance): a workaround
; for the archived Rust bootstrap, which mis-laid records whose FIRST
; field is a String/pointer in the inline make-variant path.
(deftype ErrorLocation
  ; line, col, file-path
  (EL Int Int String))

(deftype ErrorSnippet
  ; pointer-col, error-line
  (ES Int String))

; ---------------------------------------------------------------------------
; INTEGER -> DECIMAL STRING (no ffi, no arena): digit chars pulled from a
; literal index table via str-substring (match-on-Int is not supported).
; ---------------------------------------------------------------------------

(defn int-to-str (n)
  (if (< n 10)
    (str-substring "0123456789" n 1)
    (let hi (int-to-str (/ n 10))
      (let lo (str-substring "0123456789" (% n 10) 1)
        (str-concat hi lo)))))

; Halving recursion: O(n) bytes total, not the O(n^2) of one char per step.
(defn space-run (n)
  (if (<= n 0)
    ""
    (let h (space-run (/ n 2))
      (let hh (str-concat h h)
        (if (= (% n 2) 1) (str-concat hh " ") hh)))))

; Caret line: col-1 spaces then ^. col is 1-based.
(defn pointer-line (col)
  (let s (space-run (- col 1))
    (str-concat s "^")))

; ---------------------------------------------------------------------------
; LOCATION
; ---------------------------------------------------------------------------

(defn make-loc (file-path line col)
  (EL line col file-path))

(defn el-path (loc)
  (match loc
    (EL line col file-path file-path)))

(defn el-line (loc)
  (match loc
    (EL line col file-path line)))

(defn el-col (loc)
  (match loc
    (EL line col file-path col)))

; file-path is the last field in the record, but the rendered form is
; path:line:col.
(defn loc-string (loc)
  (match loc
    (EL line col file-path
      (let ls (int-to-str line)
        (let cs (int-to-str col)
          (let c1 (str-concat ":" cs)
            (let c2 (str-concat ls c1)
              (let c3 (str-concat ":" c2)
                (str-concat file-path c3)))))))))

; Rust-style header: error[E_CODE]: message
(defn err-header (code-name message)
  (let open (str-concat "error[" code-name)
    (let inner (str-concat open "]: ")
      (str-concat inner message))))

; ---------------------------------------------------------------------------
; SNIPPET
; ---------------------------------------------------------------------------

; Build an ErrorSnippet for pointer-col over a single error line.
(defn make-snippet (pointer-col error-line)
  (ES pointer-col error-line))

(defn es-col (snippet)
  (match snippet
    (ES pointer-col error-line pointer-col)))

(defn es-line (snippet)
  (match snippet
    (ES pointer-col error-line error-line)))

; The "  --> loc" arrow line.
(defn arrow-line (loc)
  (let ls (loc-string loc)
    (str-concat "  " ls)))

; ---------------------------------------------------------------------------
; RICH DIAGNOSTIC
; ---------------------------------------------------------------------------
;
; One shape for every compile error:
;
;   error[E_MALFORMED_PARAMETER]: `(struct-get ...)` is not a parameter
;     --> tests/regression/structs.zyl:16:20
;      |
;   16 | (defn _s-get-x (p (struct-get p "x"))
;      |                   ^
;      = help: a missing `)` earlier on the line puts the body in the list
;
; `fid` is a source id from zyl_source_register and `off` a byte offset into
; that file. A negative offset means no phase recorded a span for this node
; -- every node a later phase synthesises rather than reads -- and that
; degrades to the header and the help line instead of pointing at the wrong
; place. Every str-concat operand is a pre-bound `let`, per this file's own
; header note.
; A canonical symbol key (spec v5.0 SS31.2) is what the compiler works in --
; `local/main@0::exh::Color` -- and what these messages used to print in
; full. The part after the last `::` is the name the user actually wrote;
; the package prefix is noise in an error, and the location line already
; says which file this is.
(defn err-name (n)
  (let cut (err-last-sep n 0 (- 0 1))
    (if (< cut 0)
      n
      (str-substring n (+ cut 2) (- (str-length n) (+ cut 2))))))

; Index of the last "::" in `n`, or -1.
(defn err-last-sep (n i best)
  (if (>= (+ i 1) (str-length n))
    best
    (if (err-colon2-p n i)
      (err-last-sep n (+ i 2) i)
      (err-last-sep n (+ i 1) best))))

(defn err-colon2-p (n i)
  (if (= (ffi-call "zyl_cstr_byte_at" n i 1000) 58)
    (if (= (ffi-call "zyl_cstr_byte_at" n (+ i 1) 1000) 58) true false)
    false))

; A secondary span: another place the diagnostic points at, with its own
; short message (the binding a `set!` targets, the definition a capability
; is used in). Int-first field order, as above.
(deftype ErrLabel
  ; fid, off, text
  (ELbl FileId Int String))

(defn err-label (fid off text) (ELbl fid off text))

; Label at the recorded span of `node`.
(defn err-label-at (node text)
  (ELbl (ffi-call "zyl_span_file" node 1000) (ffi-call "zyl_span_off" node 1000) text))

(defn err-at (code msg fid off help)
  (err-at-labels code msg fid off Nil help))

(defn err-at-labels (code msg fid off labels help)
  (err-diag "error" code msg fid off labels help))

; One renderer for errors and warnings; `sev` is "error" or "warning".
(defn err-diag (sev code msg fid off labels help)
  (if (ffi-call "zyl_diag_json" 1000)
    (err-json sev code msg fid off labels help)
    (err-text sev code msg fid off labels help)))

; A warning at `node`, emitted through the runtime's warning sink -- unless
; it is about a file that is not the user's to fix (docs/diagnostics.md, 7).
(defn err-warn-at (code msg node help)
  (let fid (ffi-call "zyl_span_file" node 1000)
    (let off (ffi-call "zyl_span_off" node 1000)
      (if (err-warn-hidden-p fid)
        unit
        (ffi-call "zyl_warn_emit" (err-diag "warning" code msg fid off Nil help) 1000)))))

; A standard-library file's warnings are hidden while compiling a program;
; ZYL_WARN_ALL=1 shows them, and the compiler's own entries always see them.
(defn err-warn-hidden-p (fid)
  (if (internal-mode-p)
    false
    (if (> (str-length (ffi-call "zyl_getenv_str" "ZYL_WARN_ALL" 1000)) 0)
      false
      (err-stdlib-path-p (ffi-call "zyl_source_path" fid 1000)))))

; "stdlib/..." as the resolver names a module, or any "/stdlib/" component.
(defn err-stdlib-path-p (path)
  (if (err-prefix-p path "stdlib/" 0) true (>= (err-index-of path "/stdlib/" 0) 0)))

; Byte offset of `needle` in `s` at or after `from`, or -1.
(defn err-index-of (s needle from)
  (if (> (+ from (str-length needle)) (str-length s))
    -1
    (if (err-prefix-p s needle from)
      from
      (err-index-of s needle (+ from 1)))))

; Does `needle` match `s` byte for byte at offset `at`?
(defn err-prefix-p (s needle at)
  (if (> (+ at (str-length needle)) (str-length s))
    false
    (err-prefix-go s needle at 0 (str-length needle))))

(defn err-prefix-go (s needle at i n)
  (if (>= i n)
    true
    (if (= (ffi-call "zyl_cstr_byte_at" s (+ at i) 1000) (ffi-call "zyl_cstr_byte_at" needle i 1000))
      (err-prefix-go s needle at (+ i 1) n)
      false)))

(defn err-text (sev code msg fid off labels help)
  (let open (str-concat sev "[")
    (let h1 (str-concat open code)
      (let h2 (str-concat h1 "]: ")
        (let head (str-concat h2 msg)
          (if (< off 0)
            (err-tail head labels 0 fid help)
            (if (<= (ffi-call "zyl_span_line" fid off 1000) 0)
              (err-tail head labels 0 fid help)
              (err-full head fid off labels help))))))))

; Labels, then the help line; `gw` is the gutter width (0 = no snippet).
(defn err-tail (head labels gw fid help)
  (let l1 (err-labels-text labels gw fid)
    (let s1 (str-concat head l1)
      (if (= (str-length help) 0)
        s1
        (let pad (space-run gw)
          (let s2 (str-concat s1 "\n ")
            (let s3 (str-concat s2 pad)
              (let s4 (str-concat s3 " = help: ")
                (str-concat s4 help)))))))))

(defn err-labels-text (labels gw fid)
  (match labels
    (Nil "")
    (Cons l rest
      (let t (err-label-text l gw fid)
        (let r (err-labels-text rest gw fid)
          (str-concat t r))))))

; A located label renders its own source line with a `-` under the column;
; one in another file names that file first.
(defn err-label-text (l gw pfid)
  (match l
    (ELbl fid off text
      (if (< off 0)
        (err-label-note gw text)
        (if (<= (ffi-call "zyl_span_line" fid off 1000) 0)
          (err-label-note gw text)
          (err-label-snippet fid off text gw pfid))))))

(defn err-label-note (gw text)
  (let pad (space-run gw)
    (let s1 (str-concat "\n " pad)
      (let s2 (str-concat s1 " = note: ")
        (str-concat s2 text)))))

(defn err-label-snippet (fid off text gw pfid)
  (let line (ffi-call "zyl_span_line" fid off 1000)
    (let col (ffi-call "zyl_span_snippet_col" fid off 1000)
      (let src (ffi-call "zyl_span_snippet" fid off 1000)
        (let ls (int-to-str line)
          (let w (if (> (str-length ls) gw) (str-length ls) gw)
            (let gut (space-run w)
              (let lpad (space-run (- w (str-length ls)))
                (let pad (space-run (- col 1))
                  (let where (if (= fid pfid) "" (err-label-where fid off gut))
                    (let s1 (str-concat where "\n ")
                      (let s2 (str-concat s1 lpad)
                        (let s3 (str-concat s2 ls)
                          (let s4 (str-concat s3 " | ")
                            (let s5 (str-concat s4 src)
                              (let s6 (str-concat s5 "\n ")
                                (let s7 (str-concat s6 gut)
                                  (let s8 (str-concat s7 " | ")
                                    (let s9 (str-concat s8 pad)
                                      (let sa (str-concat s9 "- ")
                                        (str-concat sa text)))))))))))))))))))))

(defn err-label-where (fid off gut)
  (let path (ffi-call "zyl_source_path" fid 1000)
    (let ls (int-to-str (ffi-call "zyl_span_line" fid off 1000))
      (let cs (int-to-str (ffi-call "zyl_span_col" fid off 1000))
        (let s1 (str-concat "\n" gut)
          (let s2 (str-concat s1 " ::: ")
            (let s3 (str-concat s2 path)
              (let s4 (str-concat s3 ":")
                (let s5 (str-concat s4 ls)
                  (let s6 (str-concat s5 ":")
                    (str-concat s6 cs)))))))))))

(defn err-full (head fid off labels help)
  (let line (ffi-call "zyl_span_line" fid off 1000)
    (let col (ffi-call "zyl_span_col" fid off 1000)
      (let path (ffi-call "zyl_source_path" fid 1000)
        (let text (ffi-call "zyl_span_snippet" fid off 1000)
          (let ls (int-to-str line)
            (let cs (int-to-str col)
              (let gw (str-length ls)
                (let gut (space-run gw)
                  (let pad (space-run (- (ffi-call "zyl_span_snippet_col" fid off 1000) 1))
                    (let s1 (str-concat head "\n  --> ")
                      (let s2 (str-concat s1 path)
                        (let s3 (str-concat s2 ":")
                          (let s4 (str-concat s3 ls)
                            (let s5 (str-concat s4 ":")
                              (let s6 (str-concat s5 cs)
                                (let s7 (str-concat s6 "\n ")
                                  (let s8 (str-concat s7 gut)
                                    (let s9 (str-concat s8 " |\n ")
                                      (let sa (str-concat s9 ls)
                                        (let sb (str-concat sa " | ")
                                          (let sc (str-concat sb text)
                                            (let sd (str-concat sc "\n ")
                                              (let se (str-concat sd gut)
                                                (let sf (str-concat se " | ")
                                                  (let sg (str-concat sf pad)
                                                    (let sh (str-concat sg "^")
                                                      (err-tail sh labels gw fid help))))))))))))))))))))))))))))

; ---------------------------------------------------------------------------
; JSON: one object per diagnostic (severity, code, message, file, line,
; column, labels, help); an unknown location is file "", line 0.
; ---------------------------------------------------------------------------

(defn err-json (sev code msg fid off labels help)
  (let s1 (str-concat "{\"severity\":" (ffi-call "zyl_json_quote" sev 1000))
    (let s2 (str-concat s1 ",\"code\":")
      (let s3 (str-concat s2 (ffi-call "zyl_json_quote" code 1000))
        (let s4 (str-concat s3 ",\"message\":")
          (let s5 (str-concat s4 (ffi-call "zyl_json_quote" msg 1000))
            (let s6 (str-concat s5 (err-json-loc fid off))
              (let s7 (str-concat s6 ",\"labels\":[")
                (let s8 (str-concat s7 (err-json-labels labels 1))
                  (let s9 (str-concat s8 "],\"help\":")
                    (let sa (str-concat s9 (ffi-call "zyl_json_quote" help 1000))
                      (str-concat sa "}"))))))))))))

; `,"file":..,"line":..,"column":..` for a span.
(defn err-json-loc (fid off)
  (let line (if (< off 0) 0 (ffi-call "zyl_span_line" fid off 1000))
    (let known (if (> line 0) 1 0)
      (let col (if (> known 0) (ffi-call "zyl_span_col" fid off 1000) 0)
        (let path (if (> known 0) (ffi-call "zyl_source_path" fid 1000) "")
          (let s1 (str-concat ",\"file\":" (ffi-call "zyl_json_quote" path 1000))
            (let s2 (str-concat s1 ",\"line\":")
              (let s3 (str-concat s2 (int-to-str line))
                (let s4 (str-concat s3 ",\"column\":")
                  (str-concat s4 (int-to-str col)))))))))))

(defn err-json-labels (labels first)
  (match labels
    (Nil "")
    (Cons l rest
      (match l
        (ELbl fid off text
          (let sep (if (> first 0) "" ",")
            (let s1 (str-concat sep "{\"message\":")
              (let s2 (str-concat s1 (ffi-call "zyl_json_quote" text 1000))
                (let s3 (str-concat s2 (err-json-loc fid off))
                  (let s4 (str-concat s3 "}")
                    (str-concat s4 (err-json-labels rest 0))))))))))))

; ---------------------------------------------------------------------------
; SUGGESTIONS — "did you mean": the closest candidate by edit distance,
; compared on the user-visible part of each name (err-name).
; ---------------------------------------------------------------------------

; Closest name in `cands` to `name`, or "" when none is close enough.
; Ties go to the earliest candidate, so the answer is deterministic.
(defn err-suggest (name cands)
  (let short (err-name name)
    (let limit (err-suggest-limit (str-length short))
      (err-suggest-best short cands limit "" (+ limit 1)))))

(defn err-suggest-limit (n)
  (if (< n 3) 1 (if (< n 7) 2 3)))

(defn err-suggest-best (short cands limit best bestd)
  (match cands
    (Nil best)
    (Cons c rest
      (let cs (err-name c)
        (if (str-eq cs short)
          (err-suggest-best short rest limit best bestd)
          (let d (err-edit-distance short cs)
            (if (< d bestd)
              (err-suggest-best short rest limit cs d)
              (err-suggest-best short rest limit best bestd))))))))

; "did you mean `a`, `b` or `c`?" or `fallback` when nothing is close.
(defn err-suggest-help (name cands fallback)
  (let xs (err-suggest-list name cands)
    (match xs
      (Nil fallback)
      (_ (str-concat "did you mean " (str-concat (err-join-ticks xs) "?"))))))

; Up to three names close to `name` (docs/diagnostics.md): within edit
; distance 2 (1 under three letters, none for one letter), or the same letters apart
; from hyphens and case. Nearest first, then alphabetical; never `name` itself.
(defn err-suggest-list (name cands)
  (let short (err-name name)
    (err-take (err-rank-all short cands Nil) 3)))

; distance, candidate
(deftype ErrRank (ERk Int String))

(defn err-rank-all (short cands acc)
  (match cands
    (Nil acc)
    (Cons c rest
      (let cs (err-name c)
        (let d (err-near short cs)
          (if (< d 0)
            (err-rank-all short rest acc)
            (err-rank-all short rest (err-rank-insert acc d cs))))))))

; Insert keeping (distance, name) order; a name already present is kept once.
(defn err-rank-insert (xs d cs)
  (match xs
    (Nil (Cons (ERk d cs) Nil))
    (Cons h t
      (match h
        (ERk hd hs
          (if (str-eq hs cs)
            xs
            (if (err-rank-before d cs hd hs)
              (Cons (ERk d cs) xs)
              (Cons h (err-rank-insert t d cs)))))))))

(defn err-rank-before (d cs hd hs)
  (if (< d hd) true (if (> d hd) false (< (ffi-call "zyl_cstr_cmp" cs hs 1000) 0))))

; The distance when `b` is close enough to offer for `a`, else -1.
(defn err-near (a b)
  (if (str-eq a b)
    -1
    (if (= (str-length b) 0)
      -1
      (if (str-eq (err-fold a) (err-fold b))
        0
        (if (or (< (str-length a) 2) (< (str-length b) 2))
          -1
          (let d (err-edit-distance a b)
            (if (<= d (if (< (str-length a) 3) 1 2)) d -1)))))))

; `s` lower-cased with its hyphens and underscores removed.
(defn err-fold (s)
  (err-fold-go s 0 (str-length s) ""))

(defn err-fold-go (s i n acc)
  (if (>= i n)
    acc
    (let c (ffi-call "zyl_cstr_byte_at" s i 1000)
      (if (or (= c 45) (= c 95))
        (err-fold-go s (+ i 1) n acc)
        (if (and (>= c 65) (<= c 90))
          (err-fold-go s (+ i 1) n (str-concat acc (str-substring "abcdefghijklmnopqrstuvwxyz" (- c 65) 1)))
          (err-fold-go s (+ i 1) n (str-concat acc (str-substring s i 1))))))))

(defn err-take (xs n)
  (match xs
    (Nil Nil)
    (Cons h t (if (<= n 0) Nil (match h (ERk _ cs (Cons cs (err-take t (- n 1)))))))))

; `a`, `b` or `c`
(defn err-join-ticks (xs)
  (match xs
    (Nil "")
    (Cons h t
      (match t
        (Nil (err-tick h))
        (Cons h2 t2
          (match t2
            (Nil (str-concat (err-tick h) (str-concat " or " (err-tick h2))))
            (_ (str-concat (err-tick h) (str-concat ", " (err-join-ticks t))))))))))

(defn err-tick (s)
  (str-concat "`" (str-concat s "`")))

; ---------------------------------------------------------------------------
; WHERE AN UNBOUND NAME MIGHT LIVE: what other Lisps call a Zyl built-in, and
; the standard-library module that defines a name the program did not import.
; ---------------------------------------------------------------------------

; their name, Zyl's name, the module that defines it ("" = built in)
(deftype ErrSyn (ESyn String String String))

(defn err-syn-zyl (x) (match x (ESyn _ z _ z)))
(defn err-syn-module (x) (match x (ESyn _ _ m m)))

(defn err-synonyms ()
  (Cons (ESyn "string-append" "str-concat" "")
  (Cons (ESyn "string-concat" "str-concat" "")
  (Cons (ESyn "concat" "str-concat" "")
  (Cons (ESyn "string-length" "str-length" "")
  (Cons (ESyn "substring" "str-substring" "")
  (Cons (ESyn "string=?" "str-eq" "")
  (Cons (ESyn "string-equal" "str-eq" "")
  (Cons (ESyn "int->string" "Show.show" "")
  (Cons (ESyn "number->string" "Show.show" "")
  (Cons (ESyn "int-to-string" "Show.show" "")
  (Cons (ESyn "to-string" "Show.show" "")
  (Cons (ESyn "display" "print" "")
  (Cons (ESyn "println" "print" "")
  (Cons (ESyn "printf" "print" "")
  (Cons (ESyn "define" "defn" "")
  (Cons (ESyn "setq" "set!" "")
  (Cons (ESyn "eq?" "=" "")
  (Cons (ESyn "equal?" "=" "")
  (Cons (ESyn "mod" "%" "")
  (Cons (ESyn "modulo" "%" "")
  (Cons (ESyn "length" "list-length" "core/list")
  (Cons (ESyn "append" "list-append" "core/list")
  (Cons (ESyn "reverse" "list-reverse" "core/list")
  (Cons (ESyn "first" "car" "core/list")
  (Cons (ESyn "rest" "cdr" "core/list")
  Nil))))))))))))))))))))))))))

(defn err-synonym (name)
  (err-synonym-in (err-name name) (err-synonyms)))

(defn err-synonym-in (short xs)
  (match xs
    (Nil None)
    (Cons h t (match h (ESyn theirs _ _ (if (str-eq theirs short) (Some h) (err-synonym-in short t)))))))

; Names every program can use without a `use` line, for did-you-mean.
(defn err-builtin-names ()
  (Cons "+" (Cons "-" (Cons "*" (Cons "/" (Cons "%" (Cons "<" (Cons ">" (Cons "<=" (Cons ">=" (Cons "="
  (Cons "!=" (Cons "and" (Cons "or" (Cons "not" (Cons "if" (Cons "let" (Cons "let-mut" (Cons "match" (Cons "cond" (Cons "when"
  (Cons "unless" (Cons "while" (Cons "for" (Cons "begin" (Cons "set!" (Cons "fn" (Cons "print" (Cons "exit" (Cons "error" (Cons "read-line"
  (Cons "str-concat" (Cons "str-length" (Cons "str-substring" (Cons "str-eq" (Cons "len" (Cons "list" (Cons "range" (Cons "unwrap" (Cons "Cons" (Cons "Nil"
  (Cons "Some" (Cons "None" (Cons "Ok" (Cons "Err" (Cons "tuple" (Cons "tuple-get" (Cons "struct-get" (Cons "file-open" (Cons "file-read" (Cons "file-write"
  (Cons "file-close" (Cons "bytebuf" (Cons "chan" (Cons "chan-tx" (Cons "chan-rx" (Cons "chan-send" (Cons "chan-recv" (Cons "spawn" (Cons "with-region" (Cons "ffi-call"  Nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))

; The stdlib module whose file defines `name` as a function ("core/list" for
; stdlib/core/list.zyl), or "". The installed stdlib is scanned in its sorted
; listing order, on demand: only an unbound-name report pays for it.
(defn err-stdlib-module-of (name)
  (let short (err-name name)
    (if (= (str-length short) 0)
      ""
      (err-stdlib-scan short (ffi-call "zyl_list_zyl_files" "stdlib" 1000) 0))))

(defn err-stdlib-scan (short listing i)
  (let n (str-length listing)
    (if (>= i n)
      ""
      (let j (err-line-end listing i n)
        (let rel (str-substring listing i (- j i))
          (if (err-stdlib-defines-p rel short)
            (err-module-name rel)
            (err-stdlib-scan short listing (+ j 1))))))))

(defn err-line-end (s i n)
  (if (>= i n) n (if (= (ffi-call "zyl_cstr_byte_at" s i 1000) 10) i (err-line-end s (+ i 1) n))))

; A module the resolver would load: not the compiler, language server or REPL.
(defn err-stdlib-defines-p (rel short)
  (if (err-prefix-p rel "compiler/" 0)
    false
    (if (err-prefix-p rel "lsp/" 0)
      false
      (if (err-prefix-p rel "repl/" 0)
        false
        (match (sb-read-file (str-concat "stdlib/" rel))
          (None false)
          (Some src (err-defines-p src short)))))))

; `(defn name ` or `(pub defn name ` at the start of a line.
(defn err-defines-p (src short)
  (let n1 (str-concat "\n(defn " (str-concat short " "))
    (let n2 (str-concat "\n(pub defn " (str-concat short " "))
      (if (err-prefix-p src (str-substring n1 1 (- (str-length n1) 1)) 0)
        true
        (if (>= (err-index-of src n1 0) 0) true (>= (err-index-of src n2 0) 0))))))

; "core/list.zyl" -> "core/list"
(defn err-module-name (rel)
  (let n (str-length rel)
    (if (and (> n 4) (str-eq (str-substring rel (- n 4) 4) ".zyl"))
      (str-substring rel 0 (- n 4))
      rel)))

; Levenshtein distance, one row at a time.
(defn err-edit-distance (a b)
  (err-ed-rows a b 0 (err-ed-init 0 (str-length b))))

(defn err-ed-init (i n)
  (if (> i n) Nil (Cons i (err-ed-init (+ i 1) n))))

(defn err-ed-rows (a b i prev)
  (if (>= i (str-length a))
    (err-ed-last prev)
    (let c (ffi-call "zyl_cstr_byte_at" a i 1000)
      (err-ed-rows a b (+ i 1) (Cons (+ i 1) (err-ed-row c b 0 prev (+ i 1)))))))

(defn err-ed-row (c b j prev left)
  (if (>= j (str-length b))
    Nil
    (match prev
      (Nil Nil)
      (Cons diag rest
        (match rest
          (Nil Nil)
          (Cons up _
            (let cost (if (= c (ffi-call "zyl_cstr_byte_at" b j 1000)) 0 1)
              (let v (err-min3 (+ up 1) (+ left 1) (+ diag cost))
                (Cons v (err-ed-row c b (+ j 1) rest v))))))))))

(defn err-ed-last (row)
  (match row
    (Nil 0)
    (Cons h t (match t (Nil h) (_ (err-ed-last t))))))

(defn err-min3 (a b c)
  (let m (if (< a b) a b)
    (if (< m c) m c)))
