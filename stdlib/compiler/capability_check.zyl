; === Zyl Standard Library — Package Capability Enforcement ===
; Module: compiler/capability_check
;
; Spec v5.0 §31.9. A program declares the capabilities it may use, and
; absence means none:
;
;     (capabilities io)   ; may do IO; may not use FFI or spawn actors
;     (capabilities)      ; pure computation only
;
;     io      core/io and everything under stdlib/io
;     ffi     ffi-call, ffi-pin, Pin-region allocation
;     actor   spawn, chan, chan-send, chan-recv
;     secret  the Secret capability type and stdlib/math/secret
;     native  shipping and compiling C sources (§31.10)
;     unsafe  :unsafe imports
;
; A package declares them in zyl.pkg; a lone file compiled directly
; declares them with the same form among its own top-level forms; a REPL
; session declares them by typing the form. The pass runs after module
; resolution and before type inference, on the qualified program: every
; top-level definition carries a canonical key (§31.2) whose package half
; says who owns it, so no side table of ownership is needed — the name IS
; the ownership record.
;
; A declared set is a CEILING on the declaring package. It is not
; re-granted per edge: a package that grants itself `ffi` does not hand
; `ffi` to the packages it depends on, and one that depends on an
; ffi-using package does not need `ffi` itself to call into it.
;
; Only the providers are not policed: the implicit standard library (§25)
; has no manifest — it is what provides these capabilities, and policing
; the provider would ban the allocator — and the runtime module is
; compiled the same way. An `ffi-call` of a runtime entry the signature
; table declares is the language's own, called directly with no worker
; and no timeout, so it is not foreign and needs no `ffi` grant; the raw
; entries a program may not reach are E_FFI_RESTRICTED
; (arity_check.zyl).

(use compiler/ast)
(use compiler/expr_inner)
(use compiler/ffi_sigs)
(use compiler/package)
(use compiler/qualify)
(use compiler/error_report)
(use compiler/shadow_check)
(use core/list)
(use core/option)

; ===========================================================================
; GRANTS
; ===========================================================================

; CapGrant itself lives in compiler/package, since the resolver builds the
; grants and this pass consumes them.
(defn cc-find-grant (grants pkg)
  (match grants
    (Nil None)
    (Cons h t (if (str-eq (cg-name h) pkg) (Some h) (cc-find-grant t pkg)))))

; ===========================================================================
; CONSTRUCTS
; ===========================================================================
; Which capability a form needs, or "" for the overwhelming majority that
; need none. Both halves of §31.9 are covered: the syntactic constructs
; (an ffi-call, a spawn, a file operation) and the stdlib modules whose
; canonical keys name a capability-bearing area.

(defn cc-expr-capability (e)
  (match (Expr.inner e)
    (EFfiCall sym _ _ (cc-ffi-symbol-capability sym))
    (EFfiPin _ "ffi")
    (EFfiUnpin _ "ffi")
    (EByteBufPtr _ "ffi")
    (ESpawn _ "actor")
    (ESend _ _ "actor")
    (ESendClosure _ _ _ "actor")
    (EFileOpen _ _ "io")
    (EFileRead _ _ "io")
    (EFileWrite _ _ "io")
    (EFileClose _ "io")
    (EReadLine "io")
    (EApply n args (cc-apply-capability n args))
    (EAtom a (cc-atom-capability a))
    (_ "")))

(defn cc-atom-capability (a)
  (match a
    (AIdent n (cc-name-capability n))
    (_ "")))

; `(ffi-call "sym" ...)` as an application: the symbol decides.
(defn cc-apply-capability (n args)
  (if (str-eq n "ffi-call")
    (cc-ffi-symbol-capability (cc-ffi-arg-symbol args))
    (cc-name-capability n)))

(defn cc-ffi-symbol-capability (sym)
  (if (cc-runtime-symbol-p sym) (cc-entry-capability sym) "ffi"))

; A runtime entry is the language's own, but one that reaches the world is the act its capability names: §31.9 `(capabilities)` is pure computation.
(defn cc-entry-capability (s)
  (if (cc-io-entry-p s) "io"
  (if (cc-addr-entry-p s) "ffi" "")))

; Processes, files, directories, the environment, the clock, the terminal and OS entropy.
(defn cc-io-entry-p (s)
  (or (str-eq s "zyl_system_cmd")
  (or (str-eq s "zyl_exec_cmd")
  (or (str-eq s "zyl_run_bin")
  (or (str-eq s "zyl_mkdir_p")
  (or (str-eq s "zyl_chdir")
  (or (str-eq s "zyl_getcwd")
  (or (str-eq s "zyl_list_files")
  (or (str-eq s "zyl_list_zyl_files")
  (or (str-eq s "zyl_file_size")
  (or (str-eq s "zyl_file_replace")
  (or (str-eq s "zyl_path_exists")
  (or (str-eq s "zyl_blake3_file_hex")
  (or (str-eq s "zyl_bytebuf_read_file")
  (or (str-eq s "zyl_bytebuf_write_exec")
  (or (str-eq s "zyl_getenv")
  (or (str-eq s "zyl_getenv_str")
  (or (str-eq s "zyl_read_line")
  (or (str-eq s "zyl_now_ms")
  (or (str-eq s "zyl_random_words")
  (or (str-eq s "zyl_random_fill")
      (cc-term-entry-p s))))))))))))))))))))))

(defn cc-term-entry-p (s)
  (and (> (pk-len s) 9) (str-eq (pk-sub s 0 9) "zyl_term_")))

; Entries that read or write an address the caller supplies: what C could do, so `ffi`.
(defn cc-addr-entry-p (s)
  (or (ffi-atomic-entry-p s)
  (or (str-eq s "zyl_mem_read")
  (or (str-eq s "zyl_mem_write")
  (or (str-eq s "zyl_ptr_add")
  (or (str-eq s "zyl_ptr_cstr")
  (or (str-eq s "zyl_mem_alloc")
  (or (str-eq s "zyl_mem_free")
  (or (str-eq s "zyl_word_load")
      (str-eq s "zyl_word_store"))))))))))

; `%` is a locked primitive and `zyl_*` is a runtime entry only when the
; signature table declares it (ffi_sigs.zyl). The prefix alone decides
; nothing: a program, or a package's native object, may export anything,
; `zyl_my_helper` included, and such a call is foreign code reaching the
; program without an `ffi` grant -- exactly what this pass exists to
; refuse. A name the table does not declare is not the language's own.
(defn cc-runtime-symbol-p (s)
  (if (< (pk-len s) 1) false
  (if (= (pk-byte-at s 0) 37) true
  (if (< (pk-len s) 4) false
    (if (= (pk-sub s 0 4) "zyl_") (> (str-length (ffi-sig s)) 0) false)))))

(defn cc-ffi-arg-symbol (args)
  (match args
    (Cons a _ (match (Expr.inner a) (EAtom at (cc-atom-str at)) (_ "")))
    (Nil "")))

(defn cc-atom-str (a)
  (match a
    (AStr s s)
    (_ "")))

; A call into a capability-bearing part of the standard library needs the
; same grant as the construct it wraps: `(file-open ...)` and a call to
; `io/file`'s helper are the same act (§31.9, "a `use` of a
; capability-bearing stdlib module").
(defn cc-name-capability (n)
  (let direct (if (cc-secret-name-p n) "secret" (cc-builtin-capability n))
    (if (> (str-length direct) 0)
      direct
      (let m (cc-module-of n)
        (if (= (str-length m) 0)
          ""
          (cc-module-capability m))))))

; `ffi-call`, `spawn` and their neighbours reach lowering as ordinary
; applications of a reserved name rather than as dedicated ExprInner
; forms (icnf's ic-ffi does the same recognition one phase later), so the
; capability they need is recognised by that name here. These names are
; never qualified — they are the language's, not a package's.
(defn cc-builtin-capability (n)
  (if (str-eq n "ffi-call") "ffi"
  (if (str-eq n "ffi-pin") "ffi"
  (if (str-eq n "ffi-unpin") "ffi"
  (if (str-eq n "spawn") "actor"
  (if (str-eq n "chan") "actor"
  (if (str-eq n "chan-send") "actor"
  (if (str-eq n "chan-recv") "actor"
  (if (str-eq n "file-open") "io"
  (if (str-eq n "file-read") "io"
  (if (str-eq n "file-write") "io"
  (if (str-eq n "file-close") "io"
  (if (str-eq n "read-line") "io" "")))))))))))))

; Module half of a canonical key `pkg@major::module::symbol`.
(defn cc-module-of (n)
  (let at (pk-index-of n 64 0)
    (if (< at 0)
      ""
      (let start (cc-colons n at)
        (if (< start 0)
          ""
          (let end (cc-colons n (+ start 2))
            (if (< end 0) "" (pk-sub n (+ start 2) (- end (+ start 2))))))))))

(defn cc-colons (s i)
  (if (>= (+ i 1) (pk-len s))
    -1
    (if (= (pk-byte-at s i) 58)
      (if (= (pk-byte-at s (+ i 1)) 58) i (cc-colons s (+ i 1)))
      (cc-colons s (+ i 1)))))

(defn cc-module-capability (m)
  (if (cc-prefix-p m "io/") "io"
  (if (str-eq m "core/io") "io"
  (if (cc-prefix-p m "actor/") "actor"
  (if (cc-prefix-p m "ffi/") "ffi"
  (if (cc-prefix-p m "math/secret/") "secret" ""))))))

; The Secret type, unqualified or by canonical key (§31.9 `secret`).
(defn cc-secret-name-p (n)
  (or (str-eq n "Secret")
    (and (> (pk-len n) 8) (str-eq (pk-sub n (- (pk-len n) 8) 8) "::Secret"))))

; The first `Secret` in a type expression, if any.
(defn cc-secret-type (t)
  (match (Expr.inner t)
    (EAtom a (match a (AIdent n (if (cc-secret-name-p n) (Some t) None)) (_ None)))
    (EApply n args (if (cc-secret-name-p n) (Some t) (cc-secret-types args)))
    (ECall op args (match (cc-secret-type op) (Some x (Some x)) (None (cc-secret-types args))))
    (_ None)))

(defn cc-secret-types (ts)
  (match ts
    (Nil None)
    (Cons h t (match (cc-secret-type h) (Some x (Some x)) (None (cc-secret-types t))))))

; A Secret parameter needs the grant of the definition's owner.
(defn cc-check-params (name ps grants denied)
  (match (cc-secret-types (ex-param-exprs ps))
    (Some t (cc-check-owned name t grants denied))
    (None unit)))

(defn cc-prefix-p (s p)
  (if (< (pk-len s) (pk-len p))
    false
    (str-eq (pk-sub s 0 (pk-len p)) p)))

; ===========================================================================
; THE PASS
; ===========================================================================

(defn cc-check-program (prog grants denied)
  (let _ (cc-std-reset prog)
    (cc-check-forms prog grants denied)))

; ===========================================================================
; WHAT A STANDARD-LIBRARY FUNCTION REACHES
; ===========================================================================
; The standard library is not policed, but a call into it is the act its
; body performs: (store-run ...) runs a shell as surely as zyl_system_cmd
; does. So each stdlib definition's capabilities are the union of its own
; constructs and of every stdlib definition it names, to a fixpoint over
; the call graph, and a policed call needs them all. Bits: io 1, ffi 2,
; actor 4. Secret is a type obligation, not authority, and is not derived.

(def cc-std-prog (ffi-call "zyl_ref_new" Nil 1000))
(def cc-std-ready (ffi-call "zyl_ref_new" false 1000))
(def cc-std-index (ffi-call "zyl_smap_new" 1000))
(def cc-std-mask (ffi-call "zyl_wvec_new" 1000))
(def cc-std-edges (ffi-call "zyl_wvec_new" 1000))

; One compile per program: the tables are built on the first policed call into the library.
(defn cc-std-reset (prog)
  (let _ (ffi-call "zyl_ref_set" cc-std-prog prog 1000)
    (ffi-call "zyl_ref_set" cc-std-ready false 1000)))

(defn cc-std-key-p (n)
  (and (> (pk-len n) 8) (str-eq (pk-sub n 0 8) "zyl/std@")))

; The capability bits a call to, or a reference to, a stdlib definition carries.
(defn cc-std-needs (e)
  (match (Expr.inner e)
    (EApply n _ (cc-std-name-mask n))
    (EAtom a (match a (AIdent n (cc-std-name-mask n)) (_ 0)))
    (_ 0)))

(defn cc-std-name-mask (n)
  (if (not (cc-std-key-p n)) 0
    (let _ (cc-std-ensure)
      (if (ffi-call "zyl_smap_has" cc-std-index n 1000)
        (ffi-call "zyl_wvec_get" cc-std-mask (ffi-call "zyl_smap_get" cc-std-index n 1000) 1000)
        0))))

(defn cc-std-ensure ()
  (if (ffi-call "zyl_ref_get" cc-std-ready 1000) unit
    (let _ (ffi-call "zyl_smap_clear" cc-std-index 1000)
      (let _ (ffi-call "zyl_wvec_truncate" cc-std-mask 0 1000)
        (let _ (ffi-call "zyl_wvec_truncate" cc-std-edges 0 1000)
          (let forms (ffi-call "zyl_ref_get" cc-std-prog 1000)
            (let _ (cc-std-number forms)
              (let _ (cc-std-scan forms)
                (let _ (cc-std-fix)
                  (ffi-call "zyl_ref_set" cc-std-ready true 1000))))))))))

(defn cc-std-def-name (e)
  (match (Expr.inner e)
    (EDefn name _ _ (if (cc-std-key-p name) name ""))
    (EDef name _ (if (cc-std-key-p name) name ""))
    (_ "")))

; Give every stdlib definition an index, in program order.
(defn cc-std-number (forms)
  (match forms
    (Nil unit)
    (Cons e rest
      (let n (cc-std-def-name e)
        (let _ (if (or (= (pk-len n) 0) (ffi-call "zyl_smap_has" cc-std-index n 1000)) unit
                 (let i (ffi-call "zyl_wvec_len" cc-std-mask 1000)
                   (let _ (ffi-call "zyl_smap_put" cc-std-index n i 1000)
                     (let _ (ffi-call "zyl_wvec_push" cc-std-mask 0 1000)
                       (let _ (ffi-call "zyl_wvec_push" cc-std-edges Nil 1000) unit)))))
          (cc-std-number rest))))))

; Each definition's own bits and the stdlib names it mentions.
(defn cc-std-scan (forms)
  (match forms
    (Nil unit)
    (Cons e rest
      (let n (cc-std-def-name e)
        (let _ (if (= (pk-len n) 0) unit
                 (let i (ffi-call "zyl_smap_get" cc-std-index n 1000)
                   (match (cc-std-body-scan (Cons e Nil) 0 Nil)
                     (Pair m es
                       (let _ (ffi-call "zyl_wvec_set" cc-std-mask i (bit-or m (ffi-call "zyl_wvec_get" cc-std-mask i 1000)) 1000)
                         (ffi-call "zyl_wvec_set" cc-std-edges i (list-append es (ffi-call "zyl_wvec_get" cc-std-edges i 1000)) 1000))))))
          (cc-std-scan rest))))))

(defn cc-std-body-scan (todo m es)
  (match todo
    (Nil (Pair m es))
    (Cons e rest
      (let m2 (bit-or m (cc-cap-bit (cc-expr-capability e)))
        (let es2 (cc-std-edge e es)
          (cc-std-body-scan (list-append (cc-children e) rest) m2 es2))))))

(defn cc-std-edge (e es)
  (match (Expr.inner e)
    (EApply n _ (cc-std-edge-name n es))
    (EAtom a (match a (AIdent n (cc-std-edge-name n es)) (_ es)))
    (_ es)))

(defn cc-std-edge-name (n es)
  (if (and (cc-std-key-p n) (ffi-call "zyl_smap_has" cc-std-index n 1000))
    (Cons (ffi-call "zyl_smap_get" cc-std-index n 1000) es)
    es))

(defn cc-cap-bit (c)
  (if (str-eq c "io") 1 (if (str-eq c "ffi") 2 (if (str-eq c "actor") 4 0))))

; Propagate along the call graph until no mask changes.
(defn cc-std-fix ()
  (if (cc-std-pass 0 (ffi-call "zyl_wvec_len" cc-std-mask 1000) false) (cc-std-fix) unit))

(defn cc-std-pass (i n changed)
  (if (>= i n) changed
    (let old (ffi-call "zyl_wvec_get" cc-std-mask i 1000)
      (let new (cc-std-join (ffi-call "zyl_wvec_get" cc-std-edges i 1000) old)
        (if (= new old)
          (cc-std-pass (+ i 1) n changed)
          (let _ (ffi-call "zyl_wvec_set" cc-std-mask i new 1000)
            (cc-std-pass (+ i 1) n true)))))))

(defn cc-std-join (es m)
  (match es
    (Nil m)
    (Cons j rest (cc-std-join rest (bit-or m (ffi-call "zyl_wvec_get" cc-std-mask j 1000))))))

(defn cc-check-forms (forms grants denied)
  (match forms
    (Nil unit)
    (Cons e rest
      (let _ (cc-check-form e grants denied)
        (cc-check-forms rest grants denied)))))

(defn cc-check-form (e grants denied)
  (match (Expr.inner e)
    (EDefn name ps body (let _ (cc-check-params name ps grants denied) (cc-check-owned name body grants denied)))
    (EDef name value (cc-check-owned name value grants denied))
    (ETestDecl _ body _ _ (cc-check-owned "main" body grants denied))
    (ETestCompile body _ (cc-check-owned "main" body grants denied))
    (EImplBlock tr ty bodies (cc-check-impl tr ty bodies grants denied))
    (_ unit)))

; An impl's owner is its trait's or its type's package (the orphan rule); each user grant bounds it.
(defn cc-check-impl (tr ty bodies grants denied)
  (let _ (if (cc-secret-name-p tr) (cc-check-owned ty (Expr (EAtom (AIdent tr))) grants denied) unit)
    (cc-check-impl-bodies tr ty bodies grants denied)))

(defn cc-check-impl-bodies (tr ty bodies grants denied)
  (match bodies
    (Nil unit)
    (Cons b rest
      (match b
        (IB d
          (match d
            (DN _ ps body
              (let _ (cc-check-params ty ps grants denied)
              (let _ (cc-check-owned tr body grants denied)
                (let _ (if (str-eq (ck-package-of tr) (ck-package-of ty)) unit (cc-check-owned ty body grants denied))
                  (cc-check-impl-bodies tr ty rest grants denied)))))))))))

(defn cc-check-owned (name body grants denied)
  (if (str-eq name "main")
    (match (cc-find-main grants)
      (Some g (cc-check-under g body denied))
      (None unit))
    (match (cc-find-grant grants (ck-package-of name))
      (Some g (cc-check-under g body denied))
      (None unit))))

(defn cc-check-under (g body denied)
  (if (= (cg-enforced g) 0) unit (cc-walk body g denied)))

; The root package's grant for its unqualified `main` (module_resolver's mr-main-grant).
(defn cc-find-main (grants)
  (match grants
    (Nil None)
    (Cons h t (if (and (> (str-length (cg-name h)) 6) (str-eq (str-substring (cg-name h) 0 6) "<main>")) (Some h) (cc-find-main t)))))

; Depth-first over the body. The first violation stops the build at the
; construct that needs the capability, with the line that grants it.
(defn cc-walk (e g denied)
  (let need (cc-expr-capability e)
    (let _ (cc-require need g denied e)
      (let _ (cc-require-mask (cc-std-needs e) g denied e)
        (cc-walk-children e g denied)))))

; Each capability a standard-library callee reaches, in the fixed order io, ffi, actor.
(defn cc-require-mask (m g denied site)
  (if (= m 0) unit
    (let _ (if (cc-bit m 1) (cc-require "io" g denied site) unit)
      (let _ (if (cc-bit m 2) (cc-require "ffi" g denied site) unit)
        (if (cc-bit m 4) (cc-require "actor" g denied site) unit)))))

(defn cc-bit (m b) (= (bit-and m b) b))

(defn cc-require (need g denied site)
  (if (= (str-length need) 0)
    unit
    (if (pk-has-capability denied need)
      (cc-fail site
        (str-concat "`" (str-concat (cc-site-name site) (str-concat "` needs the " (str-concat need " capability, which the root package forbids with deny-capabilities"))))
        (str-concat "remove the use, or drop `" (str-concat need "` from deny-capabilities in zyl.pkg")))
      (if (pk-has-capability (cg-caps g) need)
        unit
        (cc-fail site
          (str-concat "`" (str-concat (cc-site-name site) (str-concat "` needs the " (str-concat need (str-concat " capability, and " (cc-declares g))))))
          (str-concat (cc-fix g need) (cc-fix-why site)))))))

; Why a form with no foreign call still needs ffi, said where the fix is.
(defn cc-fix-why (site)
  (match (Expr.inner site)
    (EByteBufPtr _ "; a raw address differs from run to run, so only code that hands it to C may take it -- read and write the buffer with load-*/store-* instead")
    (_ "")))

; What the declaring side says today: "this file declares none" / "package P declares only io".
(defn cc-declares (g)
  (str-concat (cc-declarer g)
    (match (cg-caps g)
      (Nil " declares none")
      (Cons _ _ (str-concat " declares only " (cc-caps-text (cg-caps g)))))))

(defn cc-declarer (g)
  (if (= (cg-enforced g) 2) "this file"
  (if (= (cg-enforced g) 3) "this session"
    (str-concat "package " (cc-pkg-of g)))))

(defn cc-pkg-of (g)
  (let n (cg-name g)
    (if (and (> (str-length n) 6) (str-eq (str-substring n 0 6) "<main>"))
      (str-substring n 6 (- (str-length n) 6))
      n)))

; The exact line to write: the declared set plus the missing capability.
(defn cc-fix (g need)
  (let form (pk-caps-form-text (pk-caps-union (cg-caps g) (Cons need Nil)))
    (if (= (cg-enforced g) 2)
      (str-concat "add `" (str-concat form "` at the top of the file"))
    (if (= (cg-enforced g) 3)
      (str-concat "type `" (str-concat form "` at the prompt"))
      (str-concat "add `" (str-concat form "` to zyl.pkg"))))))

; The user's own name for the construct: the foreign symbol, the form, or the function called.
(defn cc-site-name (e)
  (match (Expr.inner e)
    (EFfiCall sym _ _ sym)
    (EFfiPin _ "ffi-pin")
    (EFfiUnpin _ "ffi-unpin")
    (EByteBufPtr _ "bytebuf-ptr")
    (ESpawn _ "spawn")
    (ESend _ _ "send")
    (ESendClosure _ _ _ "send")
    (EFileOpen _ _ "file-open")
    (EFileRead _ _ "file-read")
    (EFileWrite _ _ "file-write")
    (EFileClose _ "file-close")
    (EReadLine "read-line")
    (EApply n args (if (str-eq n "ffi-call") (cc-ffi-arg-symbol args) (err-name n)))
    (EAtom a (cc-atom-name a))
    (_ "this form")))

(defn cc-atom-name (a)
  (match a
    (AIdent n (err-name n))
    (_ "this form")))

; At the construct; the note says why a program declares at all.
(defn cc-fail (site msg fix)
  (let off (ffi-call "zyl_span_off" site 1000)
    (let fid (ffi-call "zyl_span_file" site 1000)
      (let why (Cons (ELbl fid (- 0 1) "a program names what it may do, so a reader sees it at the top") Nil)
        (ffi-call "zyl_panic" (err-at-labels "E_PKG_CAPABILITY_VIOLATION" msg fid off why fix) 1000)))))

(defn cc-walk-list (xs g denied)
  (match xs
    (Nil unit)
    (Cons h t
      (let _ (cc-walk h g denied)
        (cc-walk-list t g denied)))))

; Sub-terms of one expression form (expr_inner.zyl, expr-children).
(defn cc-children (e) (expr-children e))

(defn cc-walk-children (e g denied)
  (cc-walk-list (cc-children e) g denied))

; ===========================================================================
; CLOSURE REPORTING (§31.9)
; ===========================================================================
; The effective transitive closure is what the lock records. Growth in it
; is what `zyl update` reports and what --locked refuses.

(defn cc-closure (grants)
  (pk-caps-sorted (cc-closure-in grants Nil)))

(defn cc-closure-in (grants acc)
  (match grants
    (Nil acc)
    (Cons g t (cc-closure-in t (pk-caps-union acc (cg-caps g))))))

(defn cc-check-growth (before after)
  (if (> (list-length after) (list-length before))
    (err-nowhere "E_PKG_CAPABILITY_GROWTH"
      (str-concat "capability: capability closure grew under --locked: "
        (cc-caps-text after)))
    1))

(defn cc-caps-text (caps)
  (match caps
    (Nil "")
    (Cons h t
      (match t
        (Nil h)
        (_ (str-concat h (str-concat " " (cc-caps-text t))))))))

; ===========================================================================
; CONTRACT CONDITIONS (spec §23.7, E_CONTRACT_EFFECT)
; ===========================================================================
; A condition runs or not by profile, so it may only compute; a panic is the contract's own outcome.
; Effects and called parameters per definition, to a fixpoint like the capabilities above; an unseen function value fails closed.
; Lowering wraps each condition as (let zyl#cond C zyl#cond), unspellable in source; no condition, no pass.

; Effect bits: io 1, ffi 2, actor 4, state 8, unseen function value 16, exit 32.
(deftype EfSite
  (EfLeaf Int String Expr)
  (EfCall Int (List EfArg) Expr)
  (EfPcall Int Expr))

; What an argument is, for a callee that calls the parameter it lands in.
(deftype EfArg (EfaPar Int) (EfaFn Int) (EfaLam) (EfaOther))

(def ef-index (ffi-call "zyl_smap_new" 1000))
(def ef-ctors (ffi-call "zyl_smap_new" 1000))
(def ef-methods (ffi-call "zyl_smap_new" 1000))
(def ef-pure (ffi-call "zyl_smap_new" 1000))
(def ef-names (ffi-call "zyl_wvec_new" 1000))
(def ef-bodies (ffi-call "zyl_wvec_new" 1000))
(def ef-params (ffi-call "zyl_wvec_new" 1000))
(def ef-sites (ffi-call "zyl_wvec_new" 1000))
(def ef-mask (ffi-call "zyl_wvec_new" 1000))
(def ef-pc (ffi-call "zyl_wvec_new" 1000))
(def ef-why (ffi-call "zyl_wvec_new" 1000))

(def ef-marker "zyl#cond")

; ===========================================================================
; ENTRY
; ===========================================================================

(defn ef-check-program (prog)
  (let conds (ef-find-forms prog Nil)
    (if (nil? conds) unit
      (let _ (ef-reset)
        (let _ (ef-number prog)
          (let _ (ef-scan-all 0 (ffi-call "zyl_wvec_len" ef-names 1000))
            (let _ (ef-fix)
              (ef-check-conds (list-reverse conds)))))))))

(defn ef-reset ()
  (let _ (if (ffi-call "zyl_smap_has" ef-pure "zyl_panic" 1000) unit (ef-fill-pure (ef-pure-entries)))
  (let _ (if (ffi-call "zyl_smap_has" bs-table "+" 1000) unit (bs-fill (bs-names)))
    (let _ (ffi-call "zyl_smap_clear" ef-index 1000)
      (let _ (ffi-call "zyl_smap_clear" ef-ctors 1000)
        (let _ (ffi-call "zyl_smap_clear" ef-methods 1000)
          (let _ (ffi-call "zyl_wvec_truncate" ef-names 0 1000)
            (let _ (ffi-call "zyl_wvec_truncate" ef-bodies 0 1000)
              (let _ (ffi-call "zyl_wvec_truncate" ef-params 0 1000)
                (let _ (ffi-call "zyl_wvec_truncate" ef-sites 0 1000)
                  (let _ (ffi-call "zyl_wvec_truncate" ef-mask 0 1000)
                    (let _ (ffi-call "zyl_wvec_truncate" ef-pc 0 1000)
                      (ffi-call "zyl_wvec_truncate" ef-why 0 1000)))))))))))))

(defn ef-fill-pure (xs)
  (match xs
    (Nil unit)
    (Cons h t (let _ (ffi-call "zyl_smap_put" ef-pure h 1 1000) (ef-fill-pure t)))))

; ===========================================================================
; FINDING CONDITIONS
; ===========================================================================

(defn ef-marker-p ((n String))
  (and (>= (str-length n) 8) (str-eq (str-substring n 0 8) ef-marker)))

(defn ef-find-forms (xs acc)
  (match xs
    (Nil acc)
    (Cons e t (ef-find-forms t (ef-find e acc)))))

; Every marked condition in reverse source order; walks without allocating, since the language server runs it per edit.
(defn ef-find (e acc)
  (match (Expr.inner e)
    (ELet n v b (if (ef-marker-p n) (Cons v acc) (ef-find b (ef-find v acc))))
    (ELetMut _ v b (ef-find b (ef-find v acc)))
    (EApply _ args (ef-find-forms args acc))
    (ECall f args (ef-find-forms args (ef-find f acc)))
    (EBegin xs (ef-find-forms xs acc))
    (EIf c t f (ef-find f (ef-find t (ef-find c acc))))
    (EMatch sc arms (ef-find-arms arms (ef-find sc acc)))
    (ETryCatch b _ h (ef-find h (ef-find b acc)))
    (EDefn _ _ b (ef-find b acc))
    (EDef _ v (ef-find v acc))
    (ELambda _ _ b (ef-find b acc))
    (EFn _ _ b (ef-find b acc))
    (ETestDecl _ b _ _ (ef-find b acc))
    (EImplBlock _ _ bodies (ef-find-impls bodies acc))
    (EAtom _ acc)
    (EDeftype _ _ _ _ acc)
    (EStructDef _ _ acc)
    (EStructDefPlus _ _ acc)
    (ETraitDecl _ _ _ acc)
    (EMacroDef _ _ _ acc)
    (EUseModule _ _ _ acc)
    (EWhile c b (ef-find b (ef-find c acc)))
    (ESetBang _ v (ef-find v acc))
    (EStructGet b _ (ef-find b acc))
    (EPrint xs (ef-find-forms xs acc))
    (EFfiCall _ args _ (ef-find-forms args acc))
    (EMakeStruct _ args (ef-find-forms args acc))
    (EMakeVariant _ _ args (ef-find-forms args acc))
    (EUnknown _ args (ef-find-forms args acc))
    (ETuple xs (ef-find-forms xs acc))
    (EAssertEqual a b (ef-find b (ef-find a acc)))
    (EAssertTrue b _ (ef-find b acc))
    (EAssertFalse b _ (ef-find b acc))
    (EUnwrap b (ef-find b acc))
    (ECond cs (ef-find-conds cs acc))
    (EError _ acc)
    (ERunTests _ acc)
    (_ (ef-find-forms (expr-children e) acc))))

(defn ef-find-conds (cs acc)
  (match cs
    (Nil acc)
    (Cons pr t (match pr (Pair c b (ef-find-conds t (ef-find b (ef-find c acc))))))))

(defn ef-find-arms (arms acc)
  (match arms
    (Nil acc)
    (Cons a t (ef-find-arms t (ef-find (MA.body a) acc)))))

(defn ef-find-impls (bodies acc)
  (match bodies
    (Nil acc)
    (Cons b t (match b (IB d (match d (DN _ _ body (ef-find-impls t (ef-find body acc)))))))))

; ===========================================================================
; NUMBERING
; ===========================================================================

(defn ef-add (name ps body)
  (let i (ffi-call "zyl_wvec_len" ef-names 1000)
    (let _ (ffi-call "zyl_wvec_push" ef-names name 1000)
      (let _ (ffi-call "zyl_wvec_push" ef-bodies body 1000)
        (let _ (ffi-call "zyl_wvec_push" ef-params ps 1000)
          (let _ (ffi-call "zyl_wvec_push" ef-sites Nil 1000)
            (let _ (ffi-call "zyl_wvec_push" ef-mask 0 1000)
              (let _ (ffi-call "zyl_wvec_push" ef-pc 0 1000)
                (let _ (ffi-call "zyl_wvec_push" ef-why -1 1000)
                  i)))))))))

(defn ef-number (xs)
  (match xs
    (Nil unit)
    (Cons e t (let _ (ef-number-form e) (ef-number t)))))

(defn ef-number-form (e)
  (match (Expr.inner e)
    (EDefn n ps body (ef-number-def n (ef-param-names ps) body))
    (EDef n v (ef-number-def n Nil v))
    (EImplBlock tr _ bodies (ef-number-impl tr bodies))
    (EDeftype _ vs _ _ (ef-number-ctors vs))
    (EStructDef sd _ (ef-number-struct sd))
    (EStructDefPlus sd _ (ef-number-struct sd))
    (_ unit)))

(defn ef-number-def (n ps body)
  (if (ffi-call "zyl_smap_has" ef-index n 1000) unit
    (ffi-call "zyl_smap_put" ef-index n (ef-add n ps body) 1000)))

(defn ef-number-ctors (vs)
  (match vs
    (Nil unit)
    (Cons v t (let _ (ffi-call "zyl_smap_put" ef-ctors (AV.name v) 1 1000) (ef-number-ctors t)))))

(defn ef-number-struct (sd)
  (match sd (SD n _ (ffi-call "zyl_smap_put" ef-ctors n 1 1000))))

; A constructor, or `make-S` for a struct S (qualify.zyl keys the suffix).
(defn ef-ctor-p ((n String))
  (if (ffi-call "zyl_smap_has" ef-ctors n 1000) true
    (and (ef-prefix-p n "make-") (ffi-call "zyl_smap_has" ef-ctors (str-substring n 5 (- (str-length n) 5)) 1000))))

; Each impl method body is a definition; a method name stands for every body that defines it.
(defn ef-number-impl (tr bodies)
  (match bodies
    (Nil unit)
    (Cons b t
      (match b
        (IB d
          (match d
            (DN m ps body
              (let ps2 (ef-param-names ps)
                (let i (ef-add (str-concat (err-name tr) (str-concat "." m)) ps2 body)
                  (let _ (ef-method-add m i (list-length ps2))
                    (ef-number-impl tr t)))))))))))

; The synthetic definition for method m forwards its parameters to each body.
(defn ef-method-add (m i arity)
  (let j (if (ffi-call "zyl_smap_has" ef-methods m 1000)
           (ffi-call "zyl_smap_get" ef-methods m 1000)
           (let k (ef-add m Nil (ffi-call "zyl_wvec_get" ef-bodies i 1000))
             (let _ (ffi-call "zyl_smap_put" ef-methods m k 1000) k)))
    (ffi-call "zyl_wvec_set" ef-sites j
      (Cons (EfCall i (ef-forward 0 arity) (ffi-call "zyl_wvec_get" ef-bodies i 1000)) (ffi-call "zyl_wvec_get" ef-sites j 1000)) 1000)))

(defn ef-forward (k n)
  (if (>= k n) Nil (Cons (EfaPar k) (ef-forward (+ k 1) n))))

(defn ef-param-names (ps)
  (match ps
    (Nil Nil)
    (Cons p t (Cons (P.name p) (ef-param-names t)))))

; ===========================================================================
; SCANNING
; ===========================================================================
; A definition's sites, in source order: its own effects, its calls, and
; the calls of its parameters. `ps` holds the enclosing parameters still in
; scope ("" where a binder hid one).

(defn ef-scan-all (i n)
  (if (>= i n) unit
    (let s (ffi-call "zyl_wvec_get" ef-sites i 1000)
      (let own (ef-scan (ffi-call "zyl_wvec_get" ef-bodies i 1000) (ffi-call "zyl_wvec_get" ef-params i 1000) Nil)
        (let _ (if (nil? s) (ffi-call "zyl_wvec_set" ef-sites i (list-reverse own) 1000) unit)
          (ef-scan-all (+ i 1) n))))))

(defn ef-scan-list (xs ps acc)
  (match xs
    (Nil acc)
    (Cons e t (ef-scan-list t ps (ef-scan e ps acc)))))

(defn ef-leaf (e bits what xs ps acc)
  (ef-scan-list xs ps (Cons (EfLeaf bits what e) acc)))

(defn ef-scan (e ps acc)
  (match (Expr.inner e)
    (EApply n args (ef-scan-apply e n args ps acc))
    (ECall op args (ef-scan-call e op args ps acc))
    (ELet n v b (ef-scan b (ef-drop ps n) (ef-scan v ps acc)))
    (ELetMut n v b (ef-scan b (ef-drop ps n) (ef-scan v ps acc)))
    (ETryCatch b n h (ef-scan h (ef-drop ps n) (ef-scan b ps acc)))
    (EMatch s arms (ef-scan-arms arms ps (ef-scan s ps acc)))
    (EFor bs c b (let ps2 (ef-drop-binds ps bs) (ef-scan-list (expr-children e) ps2 acc)))
    (ELambda _ lps b (ef-scan b (ef-drop-names ps (ef-param-names lps)) acc))
    (EFn _ lps b (ef-scan b (ef-drop-names ps (ef-param-names lps)) acc))
    (EDefn _ lps b (ef-scan b (ef-drop-names ps (ef-param-names lps)) acc))
    (EFfiCall sym args _ (ef-leaf e (ef-entry-bits sym) sym args ps acc))
    (EPrint xs (ef-leaf e 1 "print" xs ps acc))
    (EReadLine (Cons (EfLeaf 1 "read-line" e) acc))
    (EExit b (ef-leaf e 32 "exit" (Cons b Nil) ps acc))
    (EClose b (ef-leaf e 1 "close" (Cons b Nil) ps acc))
    (EFileOpen a b (ef-leaf e 1 "file-open" (Cons a (Cons b Nil)) ps acc))
    (EFileRead a b (ef-leaf e 1 "file-read" (Cons a (Cons b Nil)) ps acc))
    (EFileWrite a b (ef-leaf e 1 "file-write" (Cons a (Cons b Nil)) ps acc))
    (EFileClose b (ef-leaf e 1 "file-close" (Cons b Nil) ps acc))
    (ERunTests _ (Cons (EfLeaf 1 "run-tests" e) acc))
    (EBufAppend a b (ef-leaf e 8 "buf-append" (Cons a (Cons b Nil)) ps acc))
    (ESpawn b (ef-leaf e 4 "spawn" (Cons b Nil) ps acc))
    (ESend a b (ef-leaf e 4 "chan-send" (Cons a (Cons b Nil)) ps acc))
    (ESendClosure a b _ (ef-leaf e 4 "chan-send" (Cons a (Cons b Nil)) ps acc))
    (EFfiPin b (ef-leaf e 2 "ffi-pin" (Cons b Nil) ps acc))
    (EFfiUnpin b (ef-leaf e 2 "ffi-unpin" (Cons b Nil) ps acc))
    (EByteBufPtr b (ef-leaf e 2 "bytebuf-ptr" (Cons b Nil) ps acc))
    (EStoreByte _ _ _ _ (ef-leaf e 8 "store-*" (expr-children e) ps acc))
    (EStoreByteSigned _ _ _ _ (ef-leaf e 8 "store-*" (expr-children e) ps acc))
    (EByteBufAppend _ _ (ef-leaf e 8 "bytebuf-append" (expr-children e) ps acc))
    (EAtomicLoad _ _ (ef-leaf e 8 "bytebuf-atomic-load" (expr-children e) ps acc))
    (EAtomicStore _ _ _ (ef-leaf e 8 "bytebuf-atomic-store" (expr-children e) ps acc))
    (EAtomicAdd _ _ _ (ef-leaf e 8 "bytebuf-atomic-add" (expr-children e) ps acc))
    (EAtomicSub _ _ _ (ef-leaf e 8 "bytebuf-atomic-sub" (expr-children e) ps acc))
    (EAtomicCAS _ _ _ _ (ef-leaf e 8 "bytebuf-atomic-cas" (expr-children e) ps acc))
    (EAtomicFetchAdd _ _ _ (ef-leaf e 8 "bytebuf-atomic-fetch-add" (expr-children e) ps acc))
    (EAtomicMax _ _ _ (ef-leaf e 8 "bytebuf-atomic-max" (expr-children e) ps acc))
    (EAtomicMin _ _ _ (ef-leaf e 8 "bytebuf-atomic-min" (expr-children e) ps acc))
    (_ (ef-scan-list (expr-children e) ps acc))))

(defn ef-scan-arms (arms ps acc)
  (match arms
    (Nil acc)
    (Cons a t (ef-scan-arms t ps (ef-scan (MA.body a) (ef-drop-pats ps (MA.patterns a)) acc)))))

(defn ef-drop-pats (ps pats)
  (match pats
    (Nil ps)
    (Cons p t
      (ef-drop-pats
        (match (Expr.inner p)
          (EAtom a (match a (AIdent n (ef-drop ps n)) (_ ps)))
          (_ ps))
        t))))

(defn ef-drop-binds (ps bs)
  (match bs
    (Nil ps)
    (Cons pr t (match pr (Pair n _ (ef-drop-binds (ef-drop ps n) t))))))

(defn ef-drop-names (ps ns)
  (match ns
    (Nil ps)
    (Cons n t (ef-drop-names (ef-drop ps n) t))))

; A binder hides the parameter it names.
(defn ef-drop (ps (n String))
  (match ps
    (Nil Nil)
    (Cons h t (Cons (if (str-eq h n) "" h) (ef-drop t n)))))

(defn ef-param-index (ps (n String) (i Int))
  (match ps
    (Nil -1)
    (Cons h t (if (and (> (str-length h) 0) (str-eq h n)) i (ef-param-index t n (+ i 1))))))

; ((expr) args): a lambda written in place is scanned where it stands; any other function value is unseen.
(defn ef-scan-call (e op args ps acc)
  (match (Expr.inner op)
    (ELambda _ _ _ (ef-scan-list args ps (ef-scan op ps acc)))
    (EFn _ _ _ (ef-scan-list args ps (ef-scan op ps acc)))
    (_ (ef-scan-list args ps (ef-scan op ps (Cons (EfLeaf 16 "a computed function value" e) acc))))))

(defn ef-scan-apply (e (n String) args ps acc)
  (ef-scan-list args ps (ef-apply-site e n args ps acc)))

(defn ef-apply-site (e (n String) args ps acc)
  (if (str-eq n "ffi-call")
    (let sym (cc-ffi-arg-symbol args) (Cons (EfLeaf (ef-entry-bits sym) sym e) acc))
  (if (str-eq n "zyl-method")
    (ef-method-site e (ef-str-arg args) (ef-rest args) ps acc)
  (if (ffi-call "zyl_smap_has" ef-index n 1000)
    (Cons (EfCall (ffi-call "zyl_smap_get" ef-index n 1000) (ef-args args ps) e) acc)
  (if (ef-ctor-p n) acc
  (if (bs-builtin-p n)
    (let b (ef-builtin-bits n) (if (= b 0) acc (Cons (EfLeaf b n e) acc)))
  (let p (ef-param-index ps n 0)
    (if (>= p 0)
      (if (< p 60) (Cons (EfPcall p e) acc) (Cons (EfLeaf 16 n e) acc))
      (if (ef-dotted-p n)
        (ef-method-site e (ef-method-short n) args ps acc)
        (Cons (EfLeaf 16 n e) acc))))))))))

; `Trait.m` that no definition names: the method m.
(defn ef-dotted-p ((n String))
  (>= (ef-dot (err-name n) 0) 0))

(defn ef-method-short ((n String))
  (let s (err-name n)
    (let d (ef-dot s 0)
      (str-substring s (+ d 1) (- (str-length s) (+ d 1))))))

(defn ef-dot ((s String) (i Int))
  (if (>= i (str-length s)) -1
    (if (= (ffi-call "zyl_cstr_byte_at" s i 1000) 46) i (ef-dot s (+ i 1)))))

; A method no impl defines is one derive generates, after this pass, from pure field operations.
(defn ef-method-site (e (m String) args ps acc)
  (if (ffi-call "zyl_smap_has" ef-methods m 1000)
    (Cons (EfCall (ffi-call "zyl_smap_get" ef-methods m 1000) (ef-args args ps) e) acc)
    acc))

(defn ef-str-arg (args)
  (match args
    (Cons a _ (match (Expr.inner a) (EAtom at (cc-atom-str at)) (_ "")))
    (Nil "")))

(defn ef-rest (args)
  (match args
    (Cons _ t t)
    (Nil Nil)))

(defn ef-args (args ps)
  (match args
    (Nil Nil)
    (Cons a t (Cons (ef-arg a ps) (ef-args t ps)))))

(defn ef-arg (a ps)
  (match (Expr.inner a)
    (EAtom at
      (match at
        (AIdent n
          (let p (ef-param-index ps n 0)
            (if (and (>= p 0) (< p 60)) (EfaPar p)
              (if (ffi-call "zyl_smap_has" ef-index n 1000)
                (EfaFn (ffi-call "zyl_smap_get" ef-index n 1000))
                EfaOther))))
        (_ EfaOther)))
    (ELambda _ _ _ EfaLam)
    (EFn _ _ _ EfaLam)
    (_ EfaOther)))

; ===========================================================================
; WHAT A CONSTRUCT DOES
; ===========================================================================

; Built-in operations that change what a program does; every other built-in computes.
(defn ef-builtin-bits ((n String))
  (if (or (str-eq n "print") (or (str-eq n "print-float") (str-eq n "print-string"))) 1
  (if (or (str-eq n "read-line") (str-eq n "close")) 1
  (if (or (str-eq n "file-open") (or (str-eq n "file-read") (or (str-eq n "file-write") (str-eq n "file-close")))) 1
  (if (or (str-eq n "run-tests") (str-eq n "zyl-contract-warn")) 1
  (if (str-eq n "exit") 32
  (if (or (str-eq n "spawn") (or (str-eq n "chan-send") (str-eq n "chan-recv"))) 4
  (if (or (str-eq n "ffi-pin") (or (str-eq n "ffi-unpin") (str-eq n "bytebuf-ptr"))) 2
  (if (or (str-eq n "bytebuf-append") (or (str-eq n "alloc-free") (or (str-eq n "arena-destroy") (str-eq n "arena-reset")))) 8
  (if (ef-prefix-p n "store-") 8
  (if (ef-prefix-p n "bytebuf-atomic-") 8 0)))))))))))

(defn ef-prefix-p ((s String) (p String))
  (and (>= (str-length s) (str-length p)) (str-eq (str-substring s 0 (str-length p)) p)))

; A runtime entry computes only when listed; a panic is the contract's own outcome.
(defn ef-entry-bits ((sym String))
  (if (ffi-call "zyl_smap_has" ef-pure sym 1000) 0
  (if (cc-runtime-symbol-p sym)
    (if (cc-io-entry-p sym) 1
    (if (str-eq sym "zyl_exit") 32
    (if (ef-prefix-p sym "zyl_actor_") 4
    (if (cc-addr-entry-p sym) 2 8))))
    2)))

(defn ef-pure-entries ()
  ["zyl_panic" "zyl_overflow_panic" "zyl_div_zero_panic" "zyl_bytes_oob_panic"
   "zyl_ralloc" "zyl_aesni_available" "zyl_arena_alloc" "zyl_arena_alloc_zeroed" "zyl_arena_capacity"
   "zyl_arena_create" "zyl_arena_used" "zyl_arena_live" "zyl_arena_create_scoped"
   "zyl_vec_alloc" "zyl_vec_alloc_r" "zyl_words_alloc" "zyl_words_alloc_r" "zyl_argc" "zyl_arg_str"
   "zyl_blake3_hex" "zyl_bytebuf_blake3_hex" "zyl_bytebuf_new"
   "zyl_cstr_byte_at" "zyl_cstr_cmp" "zyl_cstr_concat" "zyl_cstr_decode" "zyl_cstr_eq" "zyl_cstr_from_byte"
   "zyl_cstr_from_int" "zyl_cstr_key_matches" "zyl_cstr_len" "zyl_cstr_sanitize" "zyl_cstr_sub" "zyl_cstr_substr"
   "zyl_cstr_to_int" "zyl_cstr_to_int_base" "zyl_cstr_escapes_ok" "zyl_dirname_cstr"
   "zyl_div_magic" "zyl_div_shift" "zyl_view_ok" "zyl_view_byte" "zyl_view_cmp" "zyl_view_find" "zyl_view_copy"
   "zyl_diag_json" "zyl_err_is" "zyl_intern_name" "zyl_json_quote" "zyl_mangle_key"
   "zyl_f_add" "zyl_f_cmp" "zyl_f_div" "zyl_f_mul" "zyl_f_of_int" "zyl_f_parse" "zyl_f_rem" "zyl_f_sub" "zyl_f_text"
   "zyl_float_bits" "zyl_float_of_bits"
   "zyl_wrap_add" "zyl_wrap_sub" "zyl_wrap_mul" "zyl_sat_add" "zyl_sat_sub" "zyl_sat_mul"
   "zyl_add_overflows" "zyl_sub_overflows" "zyl_mul_overflows" "zyl_overflow_text" "zyl_div_zero_text" "zyl_int_text"
   "zyl_heap_alloc" "zyl_mem_alloc" "zyl_mem_read" "zyl_word_load" "zyl_ptr_add" "zyl_ptr_cstr"
   "zyl_cstr_of_word" "zyl_word_of_cstr" "zyl_heap_block_p" "zyl_runtime_export_p"
   "zyl_val_alloc" "zyl_val_kind" "zyl_val_name" "zyl_val_arity"
   "zyl_region_live_bytes" "zyl_regions_enabled" "zyl_session_arena"
   "zyl_smap_get" "zyl_smap_get_or" "zyl_smap_has" "zyl_smap_new"
   "zyl_source_path" "zyl_span_col" "zyl_span_file" "zyl_span_line" "zyl_span_off" "zyl_span_offset_at"
   "zyl_span_snippet" "zyl_span_snippet_col"
   "zyl_strbuf_new" "zyl_strbuf_new_r" "zyl_strbuf_str"
   "zyl_uf_find" "zyl_uf_level" "zyl_uf_new" "zyl_uf_id" "zyl_variant_cmp" "zyl_variant_eq"
   "zyl_wvec_get" "zyl_wvec_len" "zyl_wvec_new"
   "zyl_array_new" "zyl_array_cap" "zyl_array_filled" "zyl_array_get"
   "zyl_attrh_new" "zyl_attrh_get_or" "zyl_attrh_has"
   "zyl_ref_new" "zyl_ref_new_in" "zyl_ref_get"
   "zyl_words_new" "zyl_words_len" "zyl_words_get" "zyl_words_view" "zyl_words_view_r"
   "zyl_crc32c_u64" "zyl_crc32c_u8" "zyl_crc32c_soft" "zyl_itest_count" "zyl_itest_name" "zyl_itest_fn"])

; ===========================================================================
; FIXPOINT
; ===========================================================================

(defn ef-get-mask ((i Int)) (ffi-call "zyl_wvec_get" ef-mask i 1000))
(defn ef-get-pc ((i Int)) (ffi-call "zyl_wvec_get" ef-pc i 1000))

; What one site adds: (Pair effect-bits parameter-call-bits).
(defn ef-site-bits (s)
  (match s
    (EfLeaf b _ _ (Pair b 0))
    (EfPcall p _ (Pair 0 (shl 1 p)))
    (EfCall j args _ (ef-arg-bits (ef-get-pc j) args 0 (Pair (ef-get-mask j) 0)))))

; Each argument in a position the callee calls; a missing one is unseen.
(defn ef-arg-bits ((pc Int) args (k Int) acc)
  (if (or (>= k 60) (= (shr pc k) 0)) acc
    (let need (= (bit-and (shr pc k) 1) 1)
      (match args
        (Nil (ef-arg-bits pc Nil (+ k 1) (if need (ef-join acc (Pair 16 0)) acc)))
        (Cons a t (ef-arg-bits pc t (+ k 1) (if need (ef-join acc (ef-arg-effect a)) acc)))))))

(defn ef-arg-effect (a)
  (match a
    (EfaPar p (Pair 0 (shl 1 p)))
    (EfaFn j (Pair (bit-or (ef-get-mask j) (if (= (ef-get-pc j) 0) 0 16)) 0))
    (EfaLam (Pair 0 0))
    (EfaOther (Pair 16 0))))

(defn ef-join (a b)
  (match a
    (Pair m p (match b (Pair m2 p2 (Pair (bit-or m m2) (bit-or p p2)))))))

(defn ef-sites-bits (ss acc)
  (match ss
    (Nil acc)
    (Cons s t (ef-sites-bits t (ef-join acc (ef-site-bits s))))))

; Index of the first site with an effect, or -1.
(defn ef-first-effect (ss (i Int))
  (match ss
    (Nil -1)
    (Cons s t (match (ef-site-bits s) (Pair m _ (if (= m 0) (ef-first-effect t (+ i 1)) i))))))

(defn ef-fix ()
  (if (ef-pass 0 (ffi-call "zyl_wvec_len" ef-names 1000) false) (ef-fix) unit))

; A definition's witness is fixed when its mask first turns nonzero, so the chain it starts is well founded.
(defn ef-pass ((i Int) (n Int) (changed Bool))
  (if (>= i n) changed
    (let ss (ffi-call "zyl_wvec_get" ef-sites i 1000)
      (match (ef-sites-bits ss (Pair 0 0))
        (Pair m p
          (let om (ef-get-mask i)
            (let op (ef-get-pc i)
              (let nm (bit-or om m)
                (let np (bit-or op p)
                  (if (and (= nm om) (= np op))
                    (ef-pass (+ i 1) n changed)
                    (let _ (if (and (= om 0) (not (= nm 0))) (ffi-call "zyl_wvec_set" ef-why i (ef-first-effect ss 0) 1000) unit)
                      (let _ (ffi-call "zyl_wvec_set" ef-mask i nm 1000)
                        (let _ (ffi-call "zyl_wvec_set" ef-pc i np 1000)
                          (ef-pass (+ i 1) n true))))))))))))))

; ===========================================================================
; THE CHECK
; ===========================================================================

(defn ef-check-conds (cs)
  (match cs
    (Nil unit)
    (Cons c t (let _ (ef-check-cond c) (ef-check-conds t)))))

; A condition sees no parameters: a function value it calls is unseen.
(defn ef-check-cond (c)
  (let ss (list-reverse (ef-scan c Nil Nil))
    (let k (ef-first-effect ss 0)
      (if (< k 0) unit
        (let s (ef-nth ss k)
          (ef-fail (ef-site-node s) (ef-describe s 0)))))))

(defn ef-nth (ss (k Int))
  (match ss
    (Cons h t (if (= k 0) h (ef-nth t (- k 1))))
    (Nil (EfLeaf 16 "" (Expr (EAtom ANil))))))

(defn ef-site-node (s)
  (match s
    (EfLeaf _ _ e e)
    (EfCall _ _ e e)
    (EfPcall _ e e)))

(defn ef-name ((i Int)) (err-name (ffi-call "zyl_wvec_get" ef-names i 1000)))

; (Pair chain-text effect-bits) for the effect a site brings.
(defn ef-describe (s (depth Int))
  (match s
    (EfLeaf b w _ (Pair (if (ef-prefix-p w "a ") w (str-concat "`" (str-concat w "`"))) b))
    (EfPcall _ _ (Pair "a parameter's function value" 16))
    (EfCall j args _
      (if (not (= (ef-get-mask j) 0))
        (ef-via (str-concat "`" (str-concat (ef-name j) "`")) j depth)
        (ef-describe-arg j (ef-get-pc j) args 0 depth)))))

; Follow callee j's witness down to the construct.
(defn ef-via ((head String) (j Int) (depth Int))
  (let w (ffi-call "zyl_wvec_get" ef-why j 1000)
    (if (or (< w 0) (>= depth 12))
      (Pair head (ef-get-mask j))
      (match (ef-describe (ef-nth (ffi-call "zyl_wvec_get" ef-sites j 1000) w) (+ depth 1))
        (Pair txt b (Pair (str-concat head (str-concat ", which calls " txt)) b))))))

(defn ef-describe-arg ((j Int) (pc Int) args (k Int) (depth Int))
  (let need (and (< k 60) (= (bit-and (shr pc k) 1) 1))
    (match args
      (Nil (Pair (str-concat "`" (str-concat (ef-name j) "` with a function value it calls")) 16))
      (Cons a t
        (if (and need (not (= (match (ef-arg-effect a) (Pair m _ m)) 0)))
          (match a
            (EfaFn f (ef-via (str-concat "`" (str-concat (ef-name j) (str-concat "` with `" (str-concat (ef-name f) "`")))) f depth))
            (_ (Pair (str-concat "`" (str-concat (ef-name j) "` with a function value it calls")) 16)))
          (if (or (>= k 60) (= (shr pc k) 0))
            (Pair (str-concat "`" (str-concat (ef-name j) "`")) 16)
            (ef-describe-arg j pc t (+ k 1) depth)))))))

(defn ef-kind ((b Int))
  (if (= (bit-and b 1) 1) "does I/O"
  (if (= (bit-and b 2) 2) "calls foreign code"
  (if (= (bit-and b 4) 4) "talks to an actor or a channel"
  (if (= (bit-and b 8) 8) "changes shared state (a ref, a buffer, a table or memory)"
  (if (= (bit-and b 32) 32) "ends the program"
    "the compiler cannot follow to the function it runs, so what it does is unknown"))))))

(defn ef-fail (at d)
  (match d
    (Pair chain b
      (ffi-call "zyl_panic"
        (err-at "E_CONTRACT_EFFECT"
          (str-concat "this contract condition calls " (str-concat chain (str-concat ", which " (str-concat (ef-kind b)
            ": a condition must not change what the program does, because the contract profile decides whether it runs at all"))))
          (ffi-call "zyl_span_file" at 1000) (ffi-call "zyl_span_off" at 1000)
          (ef-help b))
        1000))))

(defn ef-help ((b Int))
  (if (= b 16)
    "pass the callee a named function or a `fn` written in place, or compute the value before the check and let the condition only compare it"
    "do the effect before the check and let the condition only compare its result, e.g. `(let v (load) (begin (requires (> v 0)) ...))`"))
