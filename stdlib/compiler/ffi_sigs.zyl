; === Zyl Compiler — Runtime Function Signatures ===
; Module: compiler/ffi_sigs
;
; The type of every runtime function reached through `ffi-call`
; (docs/sound-types-design.md). The type pass (type_annotate.zyl,
; ta-ffi-typed) reads these in strict mode; a symbol missing here is an
; untyped result. Syntax: parameter types, `->`, the result type; a
; capitalized name with arguments in parentheses is a type constructor,
; e.g. "(SMap v)", and a lowercase name is a type variable shared across
; the signature. Must agree with runtime/actor_runtime.c. Opaque handle
; types: Arena, Ptr (a raw address), Words (math/words arrays), StrBuf,
; (SMap v), (WVec v), UF, Actor, Fd, FileId, FnPtr.
;
; Not listed yet, because their honest type is "any word" and their
; callers must be restructured first (docs/ffi-signature-draft.md):
; zyl_abs, zyl_attr_clear, zyl_attr_copy, zyl_attr_get, zyl_attr_set, zyl_call_argv, zyl_cell_get, zyl_cell_set, zyl_cstr_of_word, zyl_ffi_timed_argv, zyl_fnmap_get, zyl_fnmap_put, zyl_heap_block_p, zyl_itest_add, zyl_itest_fn, zyl_native_double, zyl_repl_global_set, zyl_smap_global, zyl_val_alloc, zyl_val_arity, zyl_val_kind, zyl_val_name, zyl_word_of_cstr, zyl_wvec_global.

(defn ffi-sig (s)
  (ffi-sig-lookup s ffi-sig-tab))

; Built once, before the compiler's main runs.
(def ffi-sig-tab (ffi-sig-table))

(defn ffi-sig-lookup (s tab)
  (match tab
    (Nil "")
    (Cons e rest
      (match e
        (FSig k t (if (str-eq k s) t (ffi-sig-lookup s rest)))))))

(deftype FSig (FSig String String))

(defn ffi-sig-table ()
