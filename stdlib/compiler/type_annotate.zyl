; === Zyl Compiler — Type Annotation ===
; Module: compiler/type_annotate
;
; The type checker (docs/sound-types-design.md, spec 4.8-4.10):
; Hindley-Milner over the final Expr program, just before ICNF lowering,
; with SCC generalization of top-level functions, static trait
; resolution and per-type specialization. Every failure is an error; all
; are reported (ta-type-error), then the compile fails
; (ta-fail-if-errors). A poisoned variable only stops one error from
; cascading. Each node's type is recorded so lowering can give codegen a
; print/compare/float kind (ta-kind).

(use core/list)
(use core/option)
(use compiler/type_system)
(use compiler/expr_inner)
(use compiler/error_report)
(use compiler/ffi_sigs)
(use compiler/rt_mode)
(use compiler/node_tables)

; Types. Negative TaV ids are template slots (see ta-inst).
(deftype TaTy (TaV Int) (TaC String (List TaTy)) (TaF (List TaTy) TaTy))

; Per-type info: params (names), struct?
(deftype TaTd (TaTd String (List String) Bool Int))
; Per-variant info: type name, slot count, constructor template, field
; names, struct?, type parameter count.
(deftype TaVd (TaVd String Int TaTy (List String) Bool Int))
; Function scheme: slot count, template.
(deftype TaSc (TaSc Int TaTy))
; Conversion result: type plus extended annotation scope.
(deftype TaR (TaR TaTy (List (Pair String TaTy))))

; Handles (all mutable in the runtime), in accessor order: vars fnmap
; fnexp fnstate fnty fnsc tjidx tjlow tjstack types variants fields
; pending counter onstack fieldtys traits impls special fntg fninst specs
; extra fnspecs fnsp fnpp.
(deftype TaSt
  (TaSt (WVec TaBind) (SMap Int) (WVec Expr) (WVec Int) (WVec TaTy) (WVec TaSc)
        (WVec Int) (WVec Int) (WVec Int) (SMap TaTd) (SMap TaVd) (SMap (List String))
        (WVec TaPend) (WVec Int) (WVec Int) (SMap (List Expr)) (SMap TaSc)
        (SMap (List (Pair String String))) (WVec TaSp) (WVec Int) (WVec TaTy) (SMap Int)
        (WVec Expr) (WVec Int) (WVec Int) (WVec Int)))

(defn ta-vars (st) (match st (TaSt x _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x)))
(defn ta-fnmap (st) (match st (TaSt _ x _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x)))
(defn ta-fnexp (st) (match st (TaSt _ _ x _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x)))
(defn ta-fnstate (st) (match st (TaSt _ _ _ x _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x)))
(defn ta-fnty (st) (match st (TaSt _ _ _ _ x _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x)))
(defn ta-fnsc (st) (match st (TaSt _ _ _ _ _ x _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x)))
(defn ta-tjidx (st) (match st (TaSt _ _ _ _ _ _ x _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x)))
(defn ta-tjlow (st) (match st (TaSt _ _ _ _ _ _ _ x _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x)))
(defn ta-tjstack (st) (match st (TaSt _ _ _ _ _ _ _ _ x _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x)))
(defn ta-types (st) (match st (TaSt _ _ _ _ _ _ _ _ _ x _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x)))
(defn ta-variants (st) (match st (TaSt _ _ _ _ _ _ _ _ _ _ x _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x)))
(defn ta-fields (st) (match st (TaSt _ _ _ _ _ _ _ _ _ _ _ x _ _ _ _ _ _ _ _ _ _ _ _ _ _ x)))
(defn ta-pending (st) (match st (TaSt _ _ _ _ _ _ _ _ _ _ _ _ x _ _ _ _ _ _ _ _ _ _ _ _ _ x)))
(defn ta-counter (st) (match st (TaSt _ _ _ _ _ _ _ _ _ _ _ _ _ x _ _ _ _ _ _ _ _ _ _ _ _ x)))
(defn ta-onstack (st) (match st (TaSt _ _ _ _ _ _ _ _ _ _ _ _ _ _ x _ _ _ _ _ _ _ _ _ _ _ x)))
(defn ta-fieldtys (st) (match st (TaSt _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x _ _ _ _ _ _ _ _ _ _ x)))
(defn ta-traits (st) (match st (TaSt _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x _ _ _ _ _ _ _ _ _ x)))
(defn ta-impls (st) (match st (TaSt _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x _ _ _ _ _ _ _ _ x)))
(defn ta-special (st) (match st (TaSt _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x _ _ _ _ _ _ _ x)))
(defn ta-fntg (st) (match st (TaSt _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x _ _ _ _ _ _ x)))
(defn ta-fninst (st) (match st (TaSt _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x _ _ _ _ _ x)))
(defn ta-specs (st) (match st (TaSt _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x _ _ _ _ x)))
(defn ta-extra (st) (match st (TaSt _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x _ _ _ x)))
(defn ta-fnspecs (st) (match st (TaSt _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x _ _ x)))
(defn ta-fnsp (st) (match st (TaSt _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x _ x)))
(defn ta-fnpp (st) (match st (TaSt _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x x)))

; The checker's tables are allocated once per process and emptied for each
; run, so a long-lived host (the language server) re-checks without growing.
; A TaSt is valid until the next ta-st-new.
(def ta-pool-s0 (ffi-call "zyl_smap_new" 1000))
(def ta-pool-w0 (ffi-call "zyl_wvec_new" 1000))
(def ta-pool-w1 (ffi-call "zyl_wvec_new" 1000))
(def ta-pool-w2 (ffi-call "zyl_wvec_new" 1000))
(def ta-pool-w3 (ffi-call "zyl_wvec_new" 1000))
(def ta-pool-w4 (ffi-call "zyl_wvec_new" 1000))
(def ta-pool-w5 (ffi-call "zyl_wvec_new" 1000))
(def ta-pool-w6 (ffi-call "zyl_wvec_new" 1000))
(def ta-pool-s1 (ffi-call "zyl_smap_new" 1000))
(def ta-pool-s2 (ffi-call "zyl_smap_new" 1000))
(def ta-pool-s3 (ffi-call "zyl_smap_new" 1000))
(def ta-pool-w7 (ffi-call "zyl_wvec_new" 1000))
(def ta-pool-w8 (ffi-call "zyl_wvec_new" 1000))
(def ta-pool-w9 (ffi-call "zyl_wvec_new" 1000))
(def ta-pool-s4 (ffi-call "zyl_smap_new" 1000))
(def ta-pool-w10 (ffi-call "zyl_wvec_new" 1000))
(def ta-pool-w11 (ffi-call "zyl_wvec_new" 1000))
(def ta-pool-w12 (ffi-call "zyl_wvec_new" 1000))
(def ta-pool-s5 (ffi-call "zyl_smap_new" 1000))
(def ta-pool-w13 (ffi-call "zyl_wvec_new" 1000))
(def ta-pool-w14 (ffi-call "zyl_wvec_new" 1000))
(def ta-pool-w15 (ffi-call "zyl_wvec_new" 1000))
(def ta-pool-w16 (ffi-call "zyl_wvec_new" 1000))

(defn ta-fresh-smap (m) (let _ (ffi-call "zyl_smap_clear" m 1000) m))
(defn ta-fresh-wvec (v) (let _ (ffi-call "zyl_wvec_truncate" v 0 1000) v))

(defn ta-st-new ()
  (TaSt
        ta-var-store
        (ta-fresh-smap ta-pool-s0)
        (ta-fresh-wvec ta-pool-w0)
        (ta-fresh-wvec ta-pool-w1)
        (ta-fresh-wvec ta-pool-w2)
        (ta-fresh-wvec ta-pool-w3)
        (ta-fresh-wvec ta-pool-w4)
        (ta-fresh-wvec ta-pool-w5)
        (ta-fresh-wvec ta-pool-w6)
        (ta-fresh-smap ta-pool-s1)
        (ta-fresh-smap ta-pool-s2)
        (ta-fresh-smap ta-pool-s3)
        (ta-fresh-wvec ta-pool-w7)
        (ta-fresh-wvec ta-pool-w8)
        (ta-fresh-wvec ta-pool-w9)
        field-type-table
        (ta-fresh-smap ta-pool-s4)
        ta-impl-table
        (ta-fresh-wvec ta-pool-w10)
        (ta-fresh-wvec ta-pool-w11)
        (ta-fresh-wvec ta-pool-w12)
        (ta-fresh-smap ta-pool-s5)
        (ta-fresh-wvec ta-pool-w13)
        (ta-fresh-wvec ta-pool-w14)
        (ta-fresh-wvec ta-pool-w15)
        (ta-fresh-wvec ta-pool-w16)))

; --- small helpers ------------------------------------------------------------

(defn ta-seq (_a b) b)
(defn ta-streq (a b) (ffi-call "zyl_cstr_eq" a b 1000))
(defn ta-key-is (key name) (ffi-call "zyl_cstr_key_matches" key name 1000))
(defn ta-wget (v i) (ffi-call "zyl_wvec_get" v i 1000))
(defn ta-wset (v i x) (ffi-call "zyl_wvec_set" v i x 1000))
(defn ta-wpush (v x) (ffi-call "zyl_wvec_push" v x 1000))
(defn ta-wlen (v) (ffi-call "zyl_wvec_len" v 1000))
(defn ta-sget (m k) (ffi-call "zyl_smap_get" m k 1000))
(defn ta-sput (m k x) (ffi-call "zyl_smap_put" m k x 1000))
; The type recorded for `node`, or (ta-no-type) when there is none.
(defn ta-attr (node) (ffi-call "zyl_attrh_get_or" node-types node (ta-no-type) 1000))

(defn ta-int () (TaC "Int" Nil))
; "Not set yet" in the per-function type vectors (never unified with).
(defn ta-no-type () (TaC "" Nil))
(defn ta-no-type-p (t) (match t (TaC n _ (= (str-length n) 0)) (_ false)))

; Typed lookups in the string maps: presence, then the value (the default
; is never returned for a present key).
(defn ta-shas (m k) (ffi-call "zyl_smap_has" m k 1000))
(defn ta-sget-or (m k d) (ffi-call "zyl_smap_get_or" m k d 1000))
(defn ta-no-td () (TaTd "" Nil false 0))
(defn ta-no-vd () (TaVd "" 0 (ta-no-type) Nil false 0))

; Impl lists by dotted method name (other passes read it), the Show.show
; method's dotted name, ADT variants for structural equality, and the
; short names that are only aliases of a qualified type name.
(def ta-impl-table (ffi-call "zyl_smap_new" 1000))
(def ta-name-table (ffi-call "zyl_smap_new" 1000))
(def ta-eqv-table (ffi-call "zyl_smap_new" 1000))
(def ta-alias-table (ffi-call "zyl_smap_new" 1000))
; Declared trait names (a trait is not a type).
(def ta-trait-set (ffi-call "zyl_smap_new" 1000))
(defn ta-bool () (TaC "Bool" Nil))
(defn ta-str () (TaC "String" Nil))
(defn ta-flt () (TaC "Float" Nil))

(defn ta-fresh (st) (TaV (ta-wpush (ta-vars st) (TbFree))))

(defn ta-rec (e t)
  (let _ (ffi-call "zyl_attrh_set" node-types e t 1000)
    t))

; --- union-find ---------------------------------------------------------------
; Each variable is unbound, poisoned (a failed unification; strict mode
; reports it) or bound to a type.
(deftype TaBind (TbFree) (TbPoison) (TbTy TaTy))

; The variable store of the current program. The type pass and the queries
; after it (ta-kind, ta-scalar) share it; ta-annotate-program empties it.
(def ta-var-store (ffi-call "zyl_wvec_new" 1000))

(defn ta-bind-of (st i) (ta-wget (ta-vars st) i))

(defn ta-bind-set (st i t) (ta-wset (ta-vars st) i (TbTy t)))

(defn ta-resolve (st t)
  (match t
    (TaV i
      (if (< i 0)
        t
        (match (ta-bind-of st i)
          (TbTy b (ta-resolve-bound st i b))
          (_ t))))
    (_ t)))

(defn ta-resolve-bound (st i b)
  (let r (ta-resolve st b)
    (let _ (ta-bind-set st i r)
      r)))

(defn ta-poisoned (st i)
  (match (ta-bind-of st i)
    (TbPoison true)
    (_ false)))

; Root variable of `t` (last var in its chain), or -1.
(defn ta-root (st t)
  (match t
    (TaV i
      (if (< i 0)
        -1
        (match (ta-bind-of st i)
          (TbTy b (ta-root-next st i b))
          (_ i))))
    (_ -1)))

(defn ta-root-next (st i b)
  (match b
    (TaV _ (ta-root st b))
    (_ i)))

(defn ta-poison (st t)
  (let r (ta-root st t)
    (if (< r 0) unit (ta-wset (ta-vars st) r (TbPoison)))))

; --- type errors (docs/sound-types-design.md) -------------------------------
; Every unification failure, occurs-check failure and "don't know" type is
; an error at the innermost expression being typed (ta-cur-node). All of a
; program's type errors are reported, then the compile fails
; (ta-annotate-program). ZYL_STRICT_TYPES=report reports them as
; W_TYPE_STRICT warnings instead and lets the compile go on: a tool for
; counting what is left, never a way to run an ill-typed program in
; production.
(def ta-report-mode (ffi-call "zyl_ref_new" false 1000))
(def ta-error-count (ffi-call "zyl_ref_new" 0 1000))
(def ta-cur-node (ffi-call "zyl_ref_new" (Expr (EAtom ANil)) 1000))
; Names already reported as unbound: each is reported once per program.
(def ta-unbound-seen (ffi-call "zyl_smap_new" 1000))
; Unbound names waiting to be reported, with the help each one earned at
; its own use site, so the flush can group by cause (see ta-unbound).
(def ta-unbound-pending (ffi-call "zyl_wvec_new" 1000))
; The help strings already spoken for by a group, so the second name that
; wants the same fix joins the first one's message instead of starting one.
(def ta-unbound-grouped (ffi-call "zyl_smap_new" 1000))
; 1 while the head of a call is itself a list, `((x) ...)`.
(def ta-list-head (ffi-call "zyl_ref_new" 0 1000))
; Constructor names in declaration order, for did-you-mean.
(def ta-ctor-names (ffi-call "zyl_wvec_new" 1000))
; 1 while main's result is unified with Int, so a clash names main.
(def ta-in-main (ffi-call "zyl_ref_new" 0 1000))

; One remembered unbound name: the name as the reader wrote it, where it
; was first used, and the help that use site earned.
; the stdlib module that would define it, "" when none does (a typo, or a
; name out of scope) -- the cause a group shares.
(deftype TAUnb (TAUnb String Expr String String))
(defn make-TAUnb (n node help module) (TAUnb n node help module))
(defn TAUnb.name (e) (match e (TAUnb n _ _ _ n)))
(defn TAUnb.node (e) (match e (TAUnb _ node _ _ node)))
(defn TAUnb.help (e) (match e (TAUnb _ _ h _ h)))
(defn TAUnb.module (e) (match e (TAUnb _ _ _ m m)))

; The checker is always strict; kept as a predicate for the call sites
; that once chose between the strict and the permissive rule.
(defn ta-strict-p () true)

(defn ta-report-p () (ffi-call "zyl_ref_get" ta-report-mode 1000))

(defn ta-strict (msg)
  (ta-type-error (if (ta-starts-with msg "no type for") "E_CANNOT_INFER" (if (ta-starts-with msg "infinite type") "E_INFINITE_TYPE" "E_TYPE_MISMATCH"))
                 msg (ffi-call "zyl_ref_get" ta-cur-node 1000) Nil ""))

(defn ta-starts-with (s p)
  (and (>= (str-length s) (str-length p)) (ta-streq (str-substring s 0 (str-length p)) p)))

(defn ta-type-error (code msg node labels help)
  (let fid (ffi-call "zyl_span_file" node 1000)
    (let off (ffi-call "zyl_span_off" node 1000)
      (if (ta-report-p)
        (ffi-call "zyl_warn_emit" (err-diag "warning" "W_TYPE_STRICT" msg fid off labels help) 1000)
        (begin
          (ffi-call "zyl_ref_set" ta-error-count (+ (ffi-call "zyl_ref_get" ta-error-count 1000) 1) 1000)
          (ffi-call "zyl_warn_emit" (err-diag "error" code msg fid off labels help) 1000))))))

; A name defined nowhere: E_UNBOUND_VARIABLE, reported once per program at
; its first use (docs/diagnostics.md, 6), and typed as an absorbing unknown
; so that nothing depending on it is reported as well.
;
; It is not reported here but remembered, with the help its use site
; earned, and ta-flush-unbound reports it after the walk. The reason is
; grouping: one missing `(use collections/vec)` makes every name that
; module defines unbound, and `(vec 1 2)` expands to two of them, so three
; separate messages carrying the same fix -- and the reader's third
; question is "is this a different mistake?". The help needs the scope of
; its own use site, so it is computed now and grouped later.
(defn ta-unbound (st env n)
  (let _ (if (ta-shas ta-unbound-seen n)
           unit
           (let _ (ta-sput ta-unbound-seen n 1)
             (ta-unbound-remember (err-name n) (ffi-call "zyl_ref_get" ta-cur-node 1000)
                                  (ta-unbound-help st env n) (err-stdlib-module-of n))))
    (ta-poisoned-var st)))

(defn ta-unbound-remember (name node help module)
  (let _ (ffi-call "zyl_wvec_push" ta-unbound-pending (make-TAUnb name node help module) 1000)
    unit))

; One message per group: the first name of a group speaks, and every other
; name that earned the same help is named in its message. A group of one
; -- the common case, a genuine typo or a name out of scope -- reads
; exactly as it always did.
(defn ta-flush-unbound ()
  (begin
    (ffi-call "zyl_smap_clear" ta-unbound-grouped 1000)
    (ta-flush-unbound-go 0 (ffi-call "zyl_wvec_len" ta-unbound-pending 1000))))

(defn ta-flush-unbound-go (i n)
  (if (>= i n)
    0
    (let e (ffi-call "zyl_wvec_get" ta-unbound-pending i 1000)
      (let m (TAUnb.module e)
        ; No module means no shared cause: the help is a typo suggestion
        ; or a spelling synonym, and two names with two different ones
        ; must not be merged into a single message that keeps only the
        ; first. Each speaks for itself.
        (let _ (if (= (str-length m) 0)
                 (ta-unbound-report e Nil)
                 (if (ta-shas ta-unbound-grouped m)
                   unit
                   (let _ (ta-sput ta-unbound-grouped m 1)
                     (ta-unbound-report e (ta-unbound-group m)))))
          (ta-flush-unbound-go (+ i 1) n))))))

; The names sharing one help, in the order they were first used.
(defn ta-unbound-group (m)
  (ta-unbound-rev (ta-unbound-group-go m 0 (ffi-call "zyl_wvec_len" ta-unbound-pending 1000) Nil)))

(defn ta-unbound-group-go (m i n acc)
  (if (>= i n)
    acc
    (let e (ffi-call "zyl_wvec_get" ta-unbound-pending i 1000)
      (ta-unbound-group-go m (+ i 1) n
        (if (str-eq (TAUnb.module e) m) (Cons e acc) acc)))))

(defn ta-unbound-rev (xs)
  (match xs
    (Nil Nil)
    (Cons h t (ta-unbound-append (ta-unbound-rev t) h))))

(defn ta-unbound-append (xs x)
  (match xs
    (Nil (Cons x Nil))
    (Cons h t (Cons h (ta-unbound-append t x)))))

(defn ta-unbound-report (e group)
  (ta-type-error "E_UNBOUND_VARIABLE" (ta-unbound-msg e group)
                 (TAUnb.node e) Nil (ta-unbound-help-line group (TAUnb.help e))))

; The group shares its fix, so the help says so once: "these are defined
; in `core/map`: add `(use core/map)`". A name no module defines has no
; group to speak for it and keeps the help its own use site earned.
(defn ta-unbound-help-line (group own)
  (match group
    (Nil own)
    (Cons h t
      (if (is-nil t)
        own
        (let m (TAUnb.module h)
          (if (= (str-length m) 0)
            own
            (let q (str-concat "`" (str-concat m "`"))
              (let names (ta-unbound-names group 0 (list-length group) "")
                (let head (str-concat " are defined in " q)
                  (let whole (str-concat names head)
                    (let tail (str-concat ": add `(use " (str-concat q "`)"))
                      (str-concat whole tail))))))))))))

; "`a` is not defined" for one name, which is the usual case and reads
; exactly as it always has; "`a`, `b` and `c` are not defined" for the
; several that share one fix.
(defn ta-unbound-msg (e group)
  (match group
    (Nil (ta-unbound-one (TAUnb.name e)))
    (Cons h t
      (if (is-nil t)
        (ta-unbound-one (TAUnb.name h))
        (str-concat (ta-unbound-names group 0 (list-length group) "") " are not defined")))))

(defn ta-unbound-one (name)
  (str-concat "`" (str-concat name "` is not defined")))

(defn ta-unbound-names (group i n acc)
  (if (>= i n)
    acc
    (let name (str-concat "`" (str-concat (TAUnb.name (ta-nth-at group i)) "`"))
      (let sep (if (= (str-length acc) 0) "" (if (>= (+ i 1) n) " and " ", "))
        (ta-unbound-names group (+ i 1) n (str-concat acc (str-concat sep name)))))))

(defn ta-nth-at (xs i)
  (match xs
    (Nil (make-TAUnb "" (Expr (EAtom ANil)) "" ""))
    (Cons h t (if (< i 1) h (ta-nth-at t (- i 1))))))

; The help for an unbound name, in order of likelihood: a close name in
; scope, the Zyl spelling of another Lisp's name, the stdlib module that
; defines it, and last how to define it.
(defn ta-unbound-help (st env n)
  (let h (ta-unbound-help-1 st env n)
    (if (= (ffi-call "zyl_ref_get" ta-list-head 1000) 0)
      h
      (str-concat h "; `((params) body)` is not a function: write `(fn (params) body)`"))))

(defn ta-unbound-help-1 (st env n)
  (let dym (err-suggest-help-scoped n (ta-env-names env) (ta-visible-names st Nil) "")
    (if (> (str-length dym) 0)
      dym
      (match (err-synonym n)
        (Some syn (ta-synonym-help syn))
        (None
          (let m (err-stdlib-module-of n)
            (if (> (str-length m) 0)
              (ta-use-help (err-name n) m)
              (ta-define-help (err-name n)))))))))

(defn ta-synonym-help (syn)
  (let z (err-syn-zyl syn)
    (let m (err-syn-module syn)
      (if (= (str-length m) 0)
        (str-concat "Zyl spells it `" (str-concat z "`"))
        (str-concat "Zyl spells it `" (str-concat z (str-concat "`, from `" (str-concat m (str-concat "`: add `(use " (str-concat m ")`"))))))))))

(defn ta-use-help (short m)
  (str-concat "`" (str-concat short (str-concat "` is defined in `" (str-concat m (str-concat "`: add `(use " (str-concat m ")`")))))))

(defn ta-define-help (short)
  (str-concat "define it with `(defn " (str-concat short " (...) ...)`, or bind it with `let`")))

; Every name a did-you-mean may offer: locals, definitions (the program's
; and its imports'), constructors, and the built-in forms.
(defn ta-visible-names (st env)
  (list-append (ta-env-names env)
    (list-append (ta-fn-names st 0 (ta-wlen (ta-fnexp st)))
      (list-append (ta-wvec-strings ta-ctor-names 0 (ffi-call "zyl_wvec_len" ta-ctor-names 1000))
        (err-builtin-names)))))

(defn ta-env-names (env)
  (match env
    (Nil Nil)
    (Cons p rest (match p (Pair k _ (Cons k (ta-env-names rest)))))))

(defn ta-fn-names (st i n)
  (if (>= i n)
    Nil
    (match (Expr.inner (ta-wget (ta-fnexp st) i))
      (EDefn name _ _ (Cons name (ta-fn-names st (+ i 1) n)))
      (_ (ta-fn-names st (+ i 1) n)))))

(defn ta-wvec-strings (v i n)
  (if (>= i n) Nil (Cons (ffi-call "zyl_wvec_get" v i 1000) (ta-wvec-strings v (+ i 1) n))))

; A fresh variable standing for a type the pass does not know.
(defn ta-dk (st why)
  (let _ (ta-strict (str-concat "no type for " why))
    (ta-fresh st)))

(defn ta-dk-list (st n acc)
  (let _ (if (> n 0) (ta-strict "field without a type") unit)
    (ta-fresh-list st n acc)))

(defn ta-occurs (st i t)
  (match (ta-resolve st t)
    (TaV j (= i j))
    (TaC _ args (ta-occurs-list st i args))
    (TaF ps r (if (ta-occurs-list st i ps) true (ta-occurs st i r)))))

(defn ta-occurs-list (st i ts)
  (match ts
    (Nil false)
    (Cons h t (if (ta-occurs st i h) true (ta-occurs-list st i t)))))

; Returns 1 when unified, 0 on a conflict (whose vars are then poisoned).
; A conflict inside the types (an element of two lists, say) is reported
; there, so the enclosing unification does not report it again.
(defn ta-unify (st a b)
  (let before (ffi-call "zyl_ref_get" ta-error-count 1000)
  (let ok (ta-unify-r st (ta-resolve st a) (ta-resolve st b))
    (if (> ok 0)
      1
      (let _ (if (and (ta-strict-p) (= (ffi-call "zyl_ref_get" ta-error-count 1000) before))
               (if (= (ffi-call "zyl_ref_get" ta-in-main 1000) 0)
                 (ta-strict (ta-plain-mismatch st a b))
                 (let _ (ta-main-mismatch st (ffi-call "zyl_ref_get" ta-cur-node 1000) a) unit))
               unit)
        (ta-seq (ta-poison st a) (ta-seq (ta-poison st b) 0)))))))

; The message when no site knows why the two types had to agree.
(defn ta-plain-mismatch (st a b)
  (str-concat "type mismatch: `" (str-concat (ta-pretty st a) (str-concat "` and `" (str-concat (ta-pretty st b) "` must be the same type")))))

(defn ta-unify-r (st ra rb)
  (match ra
    (TaV i (ta-unify-var st i ra rb))
    (_ (match rb
         (TaV j (ta-unify-var st j rb ra))
         (_ (ta-unify-con st ra rb))))))

(defn ta-unify-var (st i v other)
  (if (< i 0)
    1
    (if (ta-poisoned st i)
      (ta-unify-poisoned st v other)
      (match other
        (TaV j (if (= i j) 1 (ta-seq (ta-bind-set st i other) 1)))
        (_ (if (ta-occurs st i other)
             (ta-seq (ta-strict "infinite type: this value would have to contain itself") (ta-seq (ta-wset (ta-vars st) i (TbPoison)) 1))
             (ta-seq (ta-bind-set st i other) 1)))))))

; A poisoned class absorbs: an unbound var joining it becomes poisoned.
(defn ta-unify-poisoned (st v other)
  (match other
    (TaV j (if (< j 0) 1 (if (ta-poisoned st j) 1 (ta-seq (ta-bind-set st j v) 1))))
    (_ 1)))

(defn ta-unify-con (st ra rb)
  (match ra
    (TaC n1 a1
      (match rb
        (TaC n2 a2
          (if (ta-streq n1 n2)
            (if (= (list-length a1) (list-length a2)) (ta-unify-list st a1 a2) 0)
            0))
        (_ 0)))
    (TaF p1 r1
      (match rb
        (TaF p2 r2
          (if (= (list-length p1) (list-length p2))
            (let ok (ta-unify-list st p1 p2)
              (if (> (ta-unify st r1 r2) 0) ok 0))
            0))
        (_ 0)))
    (_ 0)))

(defn ta-unify-list (st xs ys)
  (match xs
    (Nil 1)
    (Cons x xr
      (match ys
        (Nil 1)
        (Cons y yr
          (let ok (ta-unify st x y)
            (if (> (ta-unify-list st xr yr) 0) ok 0)))))))

; Unify, returning `a` on success and a fresh poisoned var on conflict.
(defn ta-join (st a b)
  (if (> (ta-unify st a b) 0) a (ta-poisoned-var st)))

(defn ta-poisoned-var (st) (TaV (ta-wpush (ta-vars st) (TbPoison))))

; --- templates ----------------------------------------------------------------

(defn ta-fresh-list (st n acc)
  (if (<= n 0) acc (ta-fresh-list st (- n 1) (Cons (ta-fresh st) acc))))

(defn ta-nth (xs i fb)
  (match xs
    (Nil fb)
    (Cons h t (if (= i 0) h (ta-nth t (- i 1) fb)))))

; Substitute slot -k-1 with the k-th entry of `slots`.
(defn ta-subst (st t slots)
  (match t
    (TaV i (if (< i 0) (ta-nth slots (- 0 (+ i 1)) t) (ta-resolve st t)))
    (TaC n args (TaC n (ta-subst-list st args slots)))
    (TaF ps r (TaF (ta-subst-list st ps slots) (ta-subst st r slots)))))

(defn ta-subst-list (st ts slots)
  (match ts
    (Nil Nil)
    (Cons h t (Cons (ta-subst st h slots) (ta-subst-list st t slots)))))

(defn ta-inst (st sc)
  (match sc
    (TaSc n t (if (= n 0) t (ta-subst st t (ta-fresh-list st n Nil))))))

; Slots from `args` first, fresh for the rest.
(defn ta-slots-with (st args n)
  (match args
    (Nil (ta-dk-list st n Nil))
    (Cons h t (if (<= n 0) Nil (Cons h (ta-slots-with st t (- n 1)))))))

; Generalize: every unbound var becomes a slot.
(deftype TaGen (TaGen TaTy (List Int)))

(defn ta-gen (st t seen)
  (match (ta-resolve st t)
    (TaV i
      (if (< i 0)
        (TaGen (TaV i) seen)
        (if (ta-poisoned st i)
          (TaGen (TaV i) seen)
          (ta-gen-var i seen))))
    (TaC n args
      (match (ta-gen-list st args seen)
        (TaGenL ts s2 (TaGen (TaC n ts) s2))))
    (TaF ps r
      (match (ta-gen-list st ps seen)
        (TaGenL ts s2
          (match (ta-gen st r s2)
            (TaGen rt s3 (TaGen (TaF ts rt) s3))))))))

(defn ta-gen-var (i seen)
  (let k (ta-index-of seen i 0)
    (if (>= k 0)
      (TaGen (TaV (- 0 (+ k 1))) seen)
      (let n (list-length seen)
        (TaGen (TaV (- 0 (+ n 1))) (list-append seen (Cons i Nil)))))))

(deftype TaGenL (TaGenL (List TaTy) (List Int)))

(defn ta-gen-list (st ts seen)
  (match ts
    (Nil (TaGenL Nil seen))
    (Cons h t
      (match (ta-gen st h seen)
        (TaGen ht s2
          (match (ta-gen-list st t s2)
            (TaGenL tt s3 (TaGenL (Cons ht tt) s3))))))))

(defn ta-index-of (xs x i)
  (match xs
    (Nil -1)
    (Cons h t (if (= h x) i (ta-index-of t x (+ i 1))))))

; --- type expressions ---------------------------------------------------------

; Opaque runtime handle types (compiler/ffi_sigs): nullary ones here,
; parameterized ones in ta-handle-param-type.
;
; `Ptr` is the exception: ta-conv-name-1 resolves it to Int. It is a
; *spelling* in an FFI signature, documenting that the word is an address,
; not a distinct type. There is no pointer representation to be distinct
; from: the runtime's own entry for it is the identity function
; (`zyl_cstr_of_word (w) = w`, runtime/rt/interp.zyl), every address in
; stdlib is documented as an Int (allocator/allocator.zyl), and there is no
; pointer type in the specification. Making it nominal bought one thing --
; rejecting a bare Int where a Ptr was declared -- at the price of needing a
; Ptr-to-Int coercion for the arithmetic that every real use needs
; (elf_link.zyl walks a buffer with `+`), and a cast is the surface this
; language deliberately does not have. So the annotation documents intent
; and the runtime keeps the invariant that matters: an address reaches C
; only from a value that owns memory (bytebuf-ptr, ffi-pin) or from a
; foreign call, never from memory nothing tracks (alloc-malloc is
; E_FFI_RESTRICTED).
(defn ta-builtin-type (n)
  (if (ta-streq n "Arena") true
  (if (ta-streq n "Ptr") true
  (if (ta-streq n "Words") true
  (if (ta-streq n "StrBuf") true
  (if (ta-streq n "UF") true
  (if (ta-streq n "Actor") true
  (if (ta-streq n "Fd") true
  (if (ta-streq n "FileId") true
  (if (ta-streq n "FnPtr") true
  (ta-builtin-prim n)))))))))))

(defn ta-handle-param-type (n)
  (or (ta-streq n "SMap") (or (ta-streq n "WVec") (or (ta-streq n "Attr") (or (ta-streq n "Array") (or (ta-streq n "Ref") (ta-streq n "Pin")))))))

(defn ta-conv-handle (st n args scope acc)
  (match args
    (Nil (TaR (TaC n (list-reverse acc)) scope))
    (Cons a rest
      (match (ta-conv st a scope)
        (TaR t scope2 (ta-conv-handle st n rest scope2 (Cons t acc)))))))

(defn ta-builtin-prim (n)
  (if (ta-streq n "Int") true
  (if (ta-streq n "Float") true
  (if (ta-streq n "String") true
  (if (ta-streq n "Bool") true
  (if (ta-streq n "ByteBuf") true
  (if (ta-streq n "ByteSlice") true
  (ta-streq n "Unit"))))))))

(defn ta-scope-get (scope n)
  (match scope
    (Nil None)
    (Cons p rest
      (match p
        (Pair k v (if (ta-streq k n) (Some v) (ta-scope-get rest n)))))))

; Type expr -> type. Unknown uppercase names become scope-local variables.
(defn ta-conv (st te scope)
  (match (Expr.inner te)
    (EAtom a
      (match a
        (AIdent n (let _ (ta-trait-as-type st n te) (ta-conv-name st n Nil scope)))
        (_ (TaR (ta-dk st "type expression") scope))))
    (EApply head args (ta-conv-name st head args scope))
    (ECall op args
      (match (Expr.inner op)
        (EAtom a
          (match a
            (AIdent n (ta-conv-name st n args scope))
            (_ (TaR (ta-dk st "type expression") scope))))
        (_ (TaR (ta-dk st "type expression") scope))))
    (_ (TaR (ta-dk st "type expression") scope))))

; (alias Name TypeExpr) forms by alias key; a written Name is its target (spec: alias transparency).
(def ta-aliases (ffi-call "zyl_smap_new" 1000))
; Type names that came from a `defstruct`, for `struct?`. The marker is on
; the EDefn, and nothing kept the name, so it is recorded here where the
; fields are already being registered.
(def ta-structs (ffi-call "zyl_smap_new" 1000))
(def ta-alias-depth (ffi-call "zyl_ref_new" 0 1000))

(defn ta-collect-aliases (exprs)
  (match exprs
    (Nil unit)
    (Cons e rest
      (let _ (match (Expr.inner e) (EAliasDecl n _ (ffi-call "zyl_smap_put" ta-aliases n e 1000)) (_ unit))
        (ta-collect-aliases rest)))))

; Every target must name known types, and no alias may reach itself.
(defn ta-check-aliases (st exprs)
  (match exprs
    (Nil unit)
    (Cons e rest
      (let _ (match (Expr.inner e)
               (EAliasDecl n te
                 (match (ta-conv st te Nil)
                   (TaR _ scope
                     (match scope
                       (Nil unit)
                       (Cons p _ (match p (Pair u _
                         (ta-type-error "E_UNKNOWN_TYPE"
                           (str-concat "the target of alias `" (str-concat (err-name n) (str-concat "` names no type: `" (str-concat (err-name u) "`"))))
                           e Nil "an alias names an existing type, as in (alias Meters Int)"))))))))
               (_ unit))
        (ta-check-aliases st rest)))))

(defn ta-conv-alias (st n scope)
  (let d (ffi-call "zyl_ref_get" ta-alias-depth 1000)
    (let decl (ffi-call "zyl_smap_get_or" ta-aliases n (Expr (EAtom ANil)) 1000)
      (if (> d 32)
        (let _ (ta-type-error "E_UNKNOWN_TYPE" (str-concat "alias `" (str-concat (err-name n) "` is defined in terms of itself"))
                              decl Nil "give the alias a target that ends in a real type")
          (TaR (ta-fresh st) scope))
        (match (Expr.inner decl)
          (EAliasDecl _ te
            (let _ (ffi-call "zyl_ref_set" ta-alias-depth (+ d 1) 1000)
              (let r (ta-conv st te scope)
                (let _ (ffi-call "zyl_ref_set" ta-alias-depth d 1000) r))))
          (_ (TaR (ta-fresh st) scope)))))))

(defn ta-conv-name (st n args scope)
  (if (ffi-call "zyl_smap_has" ta-aliases n 1000) (ta-conv-alias st n scope) (ta-conv-name-1 st n args scope)))

(defn ta-conv-name-1 (st n args scope)
  (if (ta-builtin-type n)
    (TaR (if (ta-streq n "Ptr") (ta-int) (TaC n Nil)) scope)
  ; (Fn (A B) R): a function from A B to R.
  (if (and (ta-streq n "Fn") (= (list-length args) 2))
    (match (ta-conv-args st (ta-type-list (ta-nth args 0 (Expr (EAtom ANil)))) scope Nil)
      (TaRL ps s2
        (match (ta-conv st (ta-nth args 1 (Expr (EAtom ANil))) s2)
          (TaR r s3 (TaR (TaF ps r) s3)))))
  (if (ta-handle-param-type n)
    (ta-conv-handle st n args scope Nil)
    (if (ta-streq n "Secret")
      (match args
        (Cons a _ (ta-conv st a scope))
        (Nil (TaR (ta-dk st "Secret without a type") scope)))
      (match (ta-scope-get scope n)
        (Some t (TaR t scope))
        (None
          (if (or (not (ta-shas (ta-types st) n)) (ta-alias-only (ta-types st) n))
            (ta-conv-var st n scope)
            (ta-conv-app st (ta-sget-or (ta-types st) n (ta-no-td)) args scope)))))))))

; A parenthesized list of types, which the reader made a call: `(A B)`
; is A applied to B there, so it is taken apart again; `()` is empty.
(defn ta-type-list (e)
  (match (Expr.inner e)
    (ECall op args (Cons op args))
    (EApply n args (Cons (Expr (EAtom (AIdent n))) args))
    (EAtom a (match a (ANil Nil) (_ (Cons e Nil))))
    (_ (Cons e Nil))))

(defn ta-conv-var (st n scope)
  (match (ta-scope-get scope n)
    (Some t (TaR t scope))
    (None
      (let v (ta-fresh st)
        (if (ta-looks-param n)
          (TaR v (Cons (Pair n v) scope))
          (TaR v scope))))))

; `((T : Ord) a)` reads as a parameter T annotated `Ord` (the lone `:` is
; dropped): a trait in type position would silently be a fresh type.
; An annotation is converted more than once (signature, then body), so
; each is reported once, by position.
(def ta-trait-type-seen (ffi-call "zyl_smap_new" 1000))

(defn ta-trait-as-type (st n te)
  ; `Secret` is also the annotation that marks a secret value.
  (if (and (ta-shas ta-trait-set (err-name n))
           (and (not (ta-shas (ta-types st) n)) (not (ta-streq (err-name n) "Secret"))))
    (let key (str-concat n (str-concat ":" (ffi-call "zyl_int_text" (ffi-call "zyl_span_off" te 1000) 1000)))
      (if (ta-shas ta-trait-type-seen key)
        unit
        (begin
          (ta-sput ta-trait-type-seen key 1)
          (ta-type-error "E_MALFORMED_PARAMETER"
            (str-concat "`" (str-concat (err-name n) "` is a trait, not a type"))
            te Nil
            "trait bounds are not written: use an uppercase type parameter, and a missing impl is reported where the function is used"))))
    unit))

; A type parameter: an uppercase name that is not a qualified key (no '@').
(defn ta-looks-param (n)
  (let c (ffi-call "zyl_cstr_byte_at" n 0 1000)
    (if (and (>= c 65) (<= c 90))
      (ta-no-at n 1)
      false)))

(defn ta-no-at (n i)
  (let c (ffi-call "zyl_cstr_byte_at" n i 1000)
    (if (< c 1) true (if (= c 64) false (ta-no-at n (+ i 1))))))

(defn ta-conv-app (st td args scope)
  (match td
    (TaTd name params _ _
      (match (ta-conv-args st args scope Nil)
        (TaRL ts s2
          ; A bare generic name, as an impl's receiver is annotated
          ; (`impl Eq Result`), stands for any instance: its arguments are
          ; left to inference. Only a partial application is an error.
          (TaR (TaC name (if (nil? ts) (ta-fresh-list st (list-length params) Nil) (ta-pad st name ts (list-length params)))) s2))))))

(deftype TaRL (TaRL (List TaTy) (List (Pair String TaTy))))

(defn ta-conv-args (st args scope acc)
  (match args
    (Nil (TaRL (list-reverse acc) scope))
    (Cons a rest
      (match (ta-conv st a scope)
        (TaR t s2 (ta-conv-args st rest s2 (Cons t acc)))))))

(defn ta-pad (st name ts n)
  (if (<= n 0)
    Nil
    (match ts
      (Nil (Cons (ta-dk st (str-concat "missing type argument of `" (str-concat (err-name name) "`"))) (ta-pad st name Nil (- n 1))))
      (Cons h t (Cons h (ta-pad st name t (- n 1)))))))

; --- collection ---------------------------------------------------------------

; Text after the last "::" (the whole name when there is none).
(defn ta-short (n)
  (let i (ta-last-colons n 0 -1)
    (if (< i 0) n (str-substring n (+ i 2) (- (str-length n) (+ i 2))))))

(defn ta-last-colons (n i found)
  (let c (ffi-call "zyl_cstr_byte_at" n i 1000)
    (if (< c 1)
      found
      (if (= c 58)
        (let d (ffi-call "zyl_cstr_byte_at" n (+ i 1) 1000)
          (if (= d 58) (ta-last-colons n (+ i 2) i) (ta-last-colons n (+ i 1) found)))
        (ta-last-colons n (+ i 1) found)))))

; A qualified name is also reachable by its short name; that alias is
; marked, so it never hides a type parameter of the same spelling.
(defn ta-put2 (m n x)
  (let _ (ta-sput m n x)
    (let s (ta-short n)
      (if (ta-streq s n) unit (begin (ta-sput m s x) (ta-sput ta-alias-table s 1))))))

(defn ta-alias-only (_m n)
  (and (ta-shas ta-alias-table n) (ta-looks-param n)))

(defn ta-collect-a (st exprs)
  (match exprs
    (Nil 0)
    (Cons e rest
      (begin
        (match (Expr.inner e)
          (EDeftype name _ _ _ (ta-put2 (ta-types st) name (TaTd name Nil false 0)))
          (EDefn name _ _ (let _ (ta-add-fn st name e) unit))
          (EImplBlock trait type bodies (ta-add-impls st trait type bodies))
          (_ unit))
        (ta-collect-a st rest)))))

; Impl methods by dotted `Trait.method`: (List (Pair type mangled)).
(defn ta-add-impls (st trait type bodies)
  (match bodies
    (Nil unit)
    (Cons ib rest
      (begin
        (match ib
          (IB dn
            (match dn
              (DN mname _ _ (ta-add-impl st (str-concat trait (str-concat "." mname)) type)))))
        (ta-add-impls st trait type rest)))))

(defn ta-add-impl (st dotted type)
  (let old (ta-sget-or (ta-impls st) dotted Nil)
    (let mangled (str-concat dotted (str-concat "_" type))
      (ta-sput (ta-impls st) dotted (Cons (Pair type mangled) old)))))

(defn ta-add-fn (st name e)
  (let i (ta-wpush (ta-fnexp st) e)
    (begin
      (ta-sput (ta-fnmap st) name (+ i 1))
      (ta-wpush (ta-fnstate st) 0)
      (ta-wpush (ta-fnty st) (ta-no-type))
      (ta-wpush (ta-fnsc st) (TaSc 0 (ta-no-type)))
      (ta-wpush (ta-tjidx st) 0)
      (ta-wpush (ta-tjlow st) 0)
      (ta-wpush (ta-fntg st) 0)
      (ta-wpush (ta-fninst st) (ta-no-type))
      (ta-wpush (ta-fnspecs st) 0)
      (ta-wpush (ta-fnsp st) 0)
      (ta-wpush (ta-fnpp st) 0)
      i)))

; Params of every type first: a field may name a type declared later.
(defn ta-collect-b (st exprs)
  (match exprs
    (Nil 0)
    (Cons e rest
      (begin
        (match (Expr.inner e)
          (EDeftype name variants _ sm (ta-deftype-params st name variants sm))
          (_ unit))
        (ta-collect-b st rest)))))

(defn ta-collect-c (st exprs)
  (match exprs
    (Nil 0)
    (Cons e rest
      (begin
        (match (Expr.inner e)
          (EDeftype name variants _ sm
            (begin
              (ta-deftype st name variants sm)
              (ta-eq-register st name variants)))
          (ETraitDecl name methods _
            (begin (ta-sput ta-trait-set (err-name name) 1) (ta-add-trait st name methods)))
          (_ unit))
        (ta-collect-c st rest)))))

; Method schemes by dotted name; `specs` "!show" names Show.show.
(defn ta-add-trait (st name methods)
  (match methods
    (Nil unit)
    (Cons m rest
      (begin
        (match m
          (TM mname params ret rte (ta-add-method st (str-concat name (str-concat "." mname)) params ret rte)))
        (ta-add-trait st name rest)))))

; `Self` in a method's types is the receiver's type: the first
; parameter's, so (compare (self (other Self)) Int) takes two values of
; one type.
(defn ta-add-method (st dotted params ret rte)
  (let self-t (ta-fresh st)
  (match (ta-params st params Nil (Cons (Pair "Self" self-t) Nil) Nil)
    (TaPE ts _ scope _
     (let _ (match ts (Cons t0 _ (ta-unify st t0 self-t)) (Nil 0))
      (match (match rte (Some te (ta-conv st te scope)) (None (ta-conv-name st ret Nil scope)))
        (TaR rt _
          (match (ta-gen st (TaF ts rt) Nil)
            (TaGen t seen
              (begin
                (ta-sput (ta-traits st) dotted (TaSc (list-length seen) t))
                (ta-mtab-add dotted)
                (if (ta-key-is dotted "Show.show") (ta-sput ta-name-table "!show" dotted) unit)))))))))))

(defn ta-is-struct (sm)
  (match sm
    (Some _ true)
    (None false)))

(defn ta-deftype-params (st name variants sm)
  (let params (ta-implicit-params st variants (ta-params-of-variants st variants Nil))
    (ta-put2 (ta-types st) name (TaTd name params (ta-is-struct sm) 0))))

; A field written without a type, as in (defstruct Point x y), is an
; implicit type parameter of its type: Point is (Point 'x 'y), and each
; value's field types are inferred where it is built. A fresh variable
; per constructor use instead would make the field type existential, so
; a field read could be given any type. The names begin with `'`, which
; no source type can spell.
(defn ta-implicit-params (st variants acc)
  (match variants
    (Nil acc)
    (Cons v rest
      (ta-implicit-params st rest
        (let tes (ta-field-exprs st (AV.name v))
          (if (nil? tes) acc (list-append acc (ta-implicit-names (AV.name v) (AV.fields v) tes))))))))

; A field is untyped when its recorded type is `_` or missing.
(defn ta-untyped-te (tes)
  (match tes
    (Nil true)
    ; A bare `Secret` field marks the field secret without giving its
    ; type, so it is untyped too (secret_check.zyl reads the mark).
    (Cons te _ (match (Expr.inner te) (EAtom a (match a (AIdent n (or (ta-streq n "_") (ta-streq (ta-short n) "Secret"))) (_ false))) (_ false)))))

(defn ta-implicit-name (vname f) (str-concat "'" (str-concat vname (str-concat "." f))))

(defn ta-implicit-names (vname fields tes)
  (match fields
    (Nil Nil)
    (Cons f rest
      (let more (ta-implicit-names vname rest (match tes (Nil Nil) (Cons _ t t)))
        (if (ta-untyped-te tes) (Cons (ta-implicit-name vname f) more) more)))))

; One type expr per field, the implicit parameter standing in for each
; untyped one.
(defn ta-full-field-exprs (vname fields tes)
  (match fields
    (Nil Nil)
    (Cons f rest
      (Cons (if (ta-untyped-te tes) (Expr (EAtom (AIdent (ta-implicit-name vname f)))) (match tes (Cons te _ te) (Nil (Expr (EAtom (AIdent "_"))))))
            (ta-full-field-exprs vname rest (match tes (Nil Nil) (Cons _ t t)))))))

(defn ta-deftype (st name variants _sm)
  (let td (ta-sget-or (ta-types st) name (ta-no-td))
    (match td
      (TaTd _ params isst _ (ta-variants-reg st name params variants isst)))))

(defn ta-field-exprs (st vname)
  (ta-sget-or (ta-fieldtys st) vname Nil))

(defn ta-params-of-variants (st variants acc)
  (match variants
    (Nil acc)
    (Cons v rest (ta-params-of-variants st rest (ta-params-of-list st (ta-field-exprs st (AV.name v)) acc)))))

(defn ta-params-of-list (st tes acc)
  (match tes
    (Nil acc)
    (Cons te rest (ta-params-of-list st rest (ta-params-of st te acc)))))

(defn ta-params-of (st te acc)
  (match (Expr.inner te)
    (EAtom a
      (match a
        (AIdent n (let _ (ta-field-name-check st n te) (ta-param-add st n acc)))
        (_ acc)))
    (EApply _ args (ta-params-of-list st args acc))
    (ECall _ args (ta-params-of-list st args acc))
    (_ acc)))

; A lowercase field type is neither a type nor a parameter (those are uppercase).
(defn ta-field-name-check (st n te)
  (if (or (not (ta-lower-first (err-name n))) (ta-shas (ta-types st) n))
    unit
    (ta-type-error "E_UNKNOWN_TYPE" (str-concat "unknown type `" (str-concat (err-name n) "` in a field"))
                   te Nil "a type parameter is written in uppercase, as in (deftype Box (Bx T))")))

(defn ta-lower-first (n)
  (let c (ffi-call "zyl_cstr_byte_at" n 0 1000) (and (>= c 97) (<= c 122))))

(defn ta-param-add (st n acc)
  (if (or (ta-builtin-type n) (ffi-call "zyl_smap_has" ta-aliases n 1000))
    acc
    (if (and (ta-shas (ta-types st) n) (not (ta-alias-only (ta-types st) n)))
      acc
      (if (ta-looks-param n)
        (if (ta-str-in n acc) acc (list-append acc (Cons n Nil)))
        acc))))

(defn ta-str-in (n xs)
  (match xs
    (Nil false)
    (Cons h t (if (ta-streq h n) true (ta-str-in n t)))))

(defn ta-slot-scope (params i)
  (match params
    (Nil Nil)
    (Cons p rest (Cons (Pair p (TaV (- 0 (+ i 1)))) (ta-slot-scope rest (+ i 1))))))

(defn ta-slot-vars (n i)
  (if (>= i n) Nil (Cons (TaV (- 0 (+ i 1))) (ta-slot-vars n (+ i 1)))))

(defn ta-dummies (n) (if (<= n 0) Nil (Cons -1 (ta-dummies (- n 1)))))

(defn ta-variants-reg (st tname params variants isst)
  (match variants
    (Nil 0)
    (Cons v rest
      (begin
        (ta-variant-reg st tname params v isst)
        (ta-variants-reg st tname params rest isst)))))

(defn ta-variant-reg (st tname params v isst)
  (let np (list-length params)
    (let tes0 (ta-field-exprs st (AV.name v))
     (let tes (if (nil? tes0) tes0 (ta-full-field-exprs (AV.name v) (AV.fields v) tes0))
      (let fts (ta-field-tys st tes (ta-slot-scope params 0) (list-length (AV.fields v)))
        (let raw (TaF fts (TaC tname (ta-slot-vars np 0)))
          (match (ta-gen st raw (ta-dummies np))
            (TaGen t seen
              (let _ (ta-wpush ta-ctor-names (AV.name v))
                (ta-put2 (ta-variants st) (AV.name v)
                         (TaVd tname (list-length seen) t (AV.fields v) isst np)))))))))))

; Field types from their exprs; fields without a recorded type are unknown.
(defn ta-field-tys (st tes scope n)
  (match tes
    (Nil (ta-fresh-list st n Nil))
    (Cons te rest
      (match (ta-conv st te scope)
        (TaR t _ (Cons t (ta-field-tys st rest scope (- n 1))))))))

; --- inference ----------------------------------------------------------------

; The type bound to `n`, or (ta-no-type) when `n` is not local.
(defn ta-env-get (env n)
  (match env
    (Nil (ta-no-type))
    (Cons p rest
      (match p
        (Pair k v (if (ta-streq k n) v (ta-env-get rest n)))))))

(defn ta-expr (st ctx env e)
  (let prev (ffi-call "zyl_ref_get" ta-cur-node 1000)
    (let _ (ffi-call "zyl_ref_set" ta-cur-node e 1000)
      (let t (ta-rec e (ta-expr-node st ctx env e))
        (let _ (ffi-call "zyl_ref_set" ta-cur-node prev 1000)
          t)))))

(defn ta-list (st ctx env es)
  (match es
    (Nil Nil)
    (Cons h t
      (let ht (ta-expr st ctx env h)
        (Cons ht (ta-list st ctx env t))))))

(defn ta-last (ts fb)
  (match ts
    (Nil fb)
    (Cons h t (match t (Nil h) (_ (ta-last t fb))))))

(defn ta-show-prim (n)
  (or (ta-streq n "Int") (or (ta-streq n "Float") (or (ta-streq n "Bool") (ta-streq n "String")))))

;; Byte buffers and slices are their own types; a scalar where one is expected is a clash.
(defn ta-bytebuf () (TaC "ByteBuf" Nil))
(defn ta-byteslice () (TaC "ByteSlice" Nil))

; A load or store takes a ByteBuf or a ByteSlice. A handle whose type is
; still open waits for its function group (like a struct-get on an
; unknown record) and is E_CANNOT_INFER if nothing settles it.
(defn ta-bytes (st ctx env b)
  (let t (ta-expr st ctx env b)
    (let _ (if (= (ta-bytes-try st t b) 0)
             (let _ (ta-wpush (ta-pending st) (TaPend ctx t " bytes" t b)) unit)
             unit)
      t)))

; 1 when settled (accepted or reported), 0 when it must wait.
(defn ta-bytes-try (st t node)
  (match (ta-resolve st t)
    (TaC n _
      (if (or (ta-streq n "ByteBuf") (ta-streq n "ByteSlice"))
        1
        (ta-seq (ta-mismatch st node (ta-bytebuf) t Nil "pass the handle `bytebuf` or `byteslice` returned") 1)))
    (TaV i (if (< i 0) 1 (if (ta-poisoned st i) 1 0)))
    (_ (ta-seq (ta-mismatch st node (ta-bytebuf) t Nil "pass the handle `bytebuf` or `byteslice` returned") 1))))

(defn ta-bytes-ambiguous (node)
  (ta-type-error "E_CANNOT_INFER" "cannot tell whether this is a ByteBuf or a ByteSlice"
    node Nil "annotate it, e.g. ((b ByteBuf))"))

; Handle first, then the other operands; the result is an Int.
(defn ta-bytes-op (st ctx env b rest)
  (let _ (ta-bytes st ctx env b)
    (ta-walk-int st ctx env rest)))

; An operation on one kind of handle.
(defn ta-buf-op (st ctx env b want rest)
  (let _ (ta-expect st ctx env b want)
    (ta-walk-int st ctx env rest)))

; Every operand is an Int; so is the result.
(defn ta-walk-int (st ctx env es)
  (match es
    (Nil (ta-int))
    (Cons e t (let _ (ta-expect st ctx env e (ta-int)) (ta-walk-int st ctx env t)))))

; Type `e` and require `want`.
(defn ta-expect (st ctx env e want)
  (let t (ta-expr st ctx env e)
    (if (ta-clash st want t)
      (ta-seq (ta-mismatch st e want t Nil "") 0)
      (ta-unify st t want))))

; Strict mode (docs/sound-types-design.md): statement forms return Unit,
; conditions must be Bool, arithmetic needs Int or Float. Outside strict
; mode the pass behaves as it always has (Int statements, unchecked
; conditions), so turning the rules on is only ever a report for now.
(defn ta-unit-ty () (TaC "Unit" Nil))

(defn ta-stmt () (if (ta-strict-p) (ta-unit-ty) (ta-int)))

; assert-true / assert-false take a Bool.
(defn ta-assert-bool (st ctx env x)
  (let t (ta-expr st ctx env x)
    (let _ (ta-unify st t (ta-bool))
      (ta-stmt))))

(defn ta-walk-stmt (st ctx env es)
  (let _ (ta-list st ctx env es)
    (ta-stmt)))

; Type the condition `c` of `which` and require Bool, reported at `c`.
(defn ta-cond-bool (st ctx env c which)
  (let t (ta-expr st ctx env c)
    (if (ta-clash st (ta-bool) t)
      (ta-seq (ta-type-error "E_TYPE_MISMATCH"
                (str-concat "`" (str-concat which (str-concat "` needs a Bool condition, but this is `" (str-concat (ta-pretty st t) "`"))))
                c Nil (if (ta-streq (ta-pretty st t) "Int") "compare it, as in `(!= n 0)`" ""))
              0)
      (ta-unify st t (ta-bool)))))

; Arithmetic operand types, checked against the Num class {Int, Float}
; once the whole program is typed (ta-check-num).
; node, operand type, class (1 arithmetic, 2 ordering).
(deftype TaNum (TaNum Expr TaTy Int))

(def ta-num-note-store (ffi-call "zyl_wvec_new" 1000))

(defn ta-num-notes () ta-num-note-store)

(defn ta-note-num (_st e t cls)
  (if (ta-strict-p)
    (let _ (ffi-call "zyl_wvec_push" ta-num-note-store (TaNum e t cls) 1000) 0)
    0))

(defn ta-check-num (st i n)
  (if (>= i n)
    0
    (match (ffi-call "zyl_wvec_get" ta-num-note-store i 1000)
      (TaNum e t0 cls
        (let t (ta-resolve st t0)
          (let _ (match t
                   (TaC name args
                     ; Ordering is on Int, Float and String; an ADT is
                     ; ordered with Ord.compare (derivable), which
                     ; compares its fields by their own Ord.
                     (if (or (ta-streq name "Int") (or (ta-streq name "Float") (and (= cls 2) (ta-streq name "String"))))
                       unit
                       (let _ (ffi-call "zyl_ref_set" ta-cur-node e 1000)
                         (ta-strict (str-concat (if (= cls 1) "arithmetic on " "ordering on ") (ta-show st t))))))
                   (_ unit))
            (ta-check-num st (+ i 1) n)))))))

(defn ta-l2 (a b) (Cons a (Cons b Nil)))
(defn ta-l3 (a b c) (Cons a (Cons b (Cons c Nil))))
(defn ta-l4 (a b c d) (Cons a (Cons b (Cons c (Cons d Nil)))))

(defn ta-expr-node (st ctx env e)
  (match (Expr.inner e)
    (EAtom a (ta-atom st ctx env a e))
    (ECall op args (ta-call-expr st ctx env e op args))
    (EApply fname args (ta-call st ctx env e fname args))
    (ELet name val body (ta-let st ctx env name val body))
    (ELetMut name val body (ta-let st ctx env name val body))
    (EIf c t eb
      (let _ (ta-cond-bool st ctx env c "if")
        (let tt (ta-expr st ctx env t)
          (ta-join st tt (ta-expr st ctx env eb)))))
    (EWhile c body
      (let _ (ta-cond-bool st ctx env c "while")
        (let _ (ta-expr st ctx env body)
          (ta-stmt))))
    (ESetBang name val (ta-set st ctx env name val))
    (EBegin exprs (ta-last (ta-list st ctx env exprs) (ta-unit-ty)))
    (ECond clauses (ta-cond st ctx env clauses (ta-fresh st)))
    (EMatch subj arms (ta-match st ctx env subj arms))
    (EPrint exprs (ta-seq (ta-print st ctx env exprs) (ta-stmt)))
    (EFfiCall sym args _ (let _ (ta-ffi-args st ctx env args) (ta-ffi-ret st sym)))
    (EFileOpen a b (ta-file-open st ctx env a b))
    ; A file is its descriptor, an Int; the data written is a String.
    (EFileRead a b (ta-seq (ta-walk-int st ctx env (ta-l2 a b)) (ta-str)))
    (EFileWrite a b (ta-seq (ta-walk-int st ctx env (Cons a Nil)) (ta-seq (ta-expect st ctx env b (ta-str)) (ta-int))))
    (EFileClose a (ta-walk-int st ctx env (Cons a Nil)))
    (EBufAppend a b (ta-last (ta-list st ctx env (ta-l2 a b)) (ta-int)))
    (EAssert c _ (ta-assert-bool st ctx env c))
    ; Both sides have one type; on an ADT the comparison is its
    ; structural equality, resolved like `==` (a kind-5 note).
    (EAssertEqual l r
      (let tl (ta-expr st ctx env l)
        (let _ (ta-unify st (ta-expr st ctx env r) tl)
          (let _ (ta-note st ctx e 5 "" (ta-sig2 tl tl (ta-bool)) -1)
            (ta-stmt)))))
    (EAssertTrue x _ (ta-assert-bool st ctx env x))
    (EAssertFalse x _ (ta-assert-bool st ctx env x))
    (EUnwrap x (ta-unwrap st ctx env x))
    (EStructGet se field (ta-struct-get st ctx env se field e))
    (ETuple elems (ta-tuple st ctx env e elems))
    (ETupleGet t i (ta-tuple-get st ctx env e t i))
    (EFor bindings cond body (ta-for st ctx env bindings cond body))
    ; (ffi-pin v) copies v's word into a slot in the Pin region and gives
    ; the slot's address, a (Pin a); (ffi-unpin p) reads the value back.
    ; A function is not FFI_Pinnable (spec 16).
    (EFfiPin x
      (let t (ta-expr st ctx env x)
        (match (ta-resolve st t)
          (TaF _ _ (let _ (ta-type-error "E_FFI_TYPE_NOT_PINNABLE" "a function cannot be pinned: FFI_Pinnable types are Int, Float, Bool, String and data built from them" x Nil "") (TaC "Pin" (Cons t Nil))))
          (_ (TaC "Pin" (Cons t Nil))))))
    (EFfiUnpin x
      (let r (ta-fresh st)
        (let _ (ta-unify st (ta-expr st ctx env x) (TaC "Pin" (Cons r Nil)))
          r)))
    ; An actor's entry takes no arguments.
    (ESpawn b (let _ (ta-unify st (ta-expr st ctx env b) (TaF Nil (ta-fresh st))) (TaC "Actor" Nil)))
    ; (chan-send tx v): v has the channel's element type.
    (ESend a m
      (let ta (ta-expr st ctx env a)
        (let el (ta-fresh st)
          (let _ (ta-unify st ta (TaC "Tx" (Cons el Nil)))
            (let _ (ta-unify st (ta-expr st ctx env m) el) (ta-stmt))))))
    (ESendClosure a c _ (ta-walk-stmt st ctx env (ta-l2 a c)))
    (ETryCatch tb cv h
      (let tt (ta-expr st ctx env tb)
        (ta-join st tt (ta-expr st ctx (Cons (Pair cv (ta-str)) env) h))))
    (EFn _ params body (ta-lambda st ctx env params body))
    (ELambda _ params body (ta-lambda st ctx env params body))
    (EDefn _ params body (ta-lambda st ctx env params body))
    (EByteLit _ (ta-int))
    (EByteBuf _ _ (ta-bytebuf))
    ; Loads and stores take either handle; the rest name the one they
    ; need. Offsets, lengths and stored values are Ints.
    (ELoadByte _ b o (ta-bytes-op st ctx env b (Cons o Nil)))
    (ELoadByteSigned _ b o (ta-bytes-op st ctx env b (Cons o Nil)))
    (EStoreByte _ b o v (ta-bytes-op st ctx env b (ta-l2 o v)))
    (EStoreByteSigned _ b o v (ta-bytes-op st ctx env b (ta-l2 o v)))
    (EByteSlice b s l (ta-seq (ta-buf-op st ctx env b (ta-bytebuf) (ta-l2 s l)) (ta-byteslice)))
    (EByteSliceSub b s l (ta-seq (ta-buf-op st ctx env b (ta-byteslice) (ta-l2 s l)) (ta-byteslice)))
    (EByteBufAppend b v (ta-seq (ta-buf-op st ctx env b (ta-bytebuf) Nil) (ta-seq (ta-expect st ctx env v (ta-byteslice)) (ta-int))))
    (EByteBufLen b (ta-buf-op st ctx env b (ta-bytebuf) Nil))
    (EByteBufCap b (ta-buf-op st ctx env b (ta-bytebuf) Nil))
    (EByteBufPtr b (ta-buf-op st ctx env b (ta-bytebuf) Nil))
    (EAlignCheck x _ (ta-walk-int st ctx env (Cons x Nil)))
    (EAtomicLoad b o (ta-buf-op st ctx env b (ta-bytebuf) (Cons o Nil)))
    (EAtomicStore b o v (ta-buf-op st ctx env b (ta-bytebuf) (ta-l2 o v)))
    (EAtomicAdd b o v (ta-buf-op st ctx env b (ta-bytebuf) (ta-l2 o v)))
    (EAtomicSub b o v (ta-buf-op st ctx env b (ta-bytebuf) (ta-l2 o v)))
    (EAtomicCAS b o x v (ta-buf-op st ctx env b (ta-bytebuf) (ta-l3 o x v)))
    (EAtomicFetchAdd b o v (ta-buf-op st ctx env b (ta-bytebuf) (ta-l2 o v)))
    (EAtomicMax b o v (ta-buf-op st ctx env b (ta-bytebuf) (ta-l2 o v)))
    (EAtomicMin b o v (ta-buf-op st ctx env b (ta-bytebuf) (ta-l2 o v)))
    (EReadLine (ta-str))
    ; `exit` and `error` do not return, so their type is anything.
    (EExit x (let _ (ta-unify st (ta-expr st ctx env x) (ta-int)) (ta-fresh st)))
    (EError _ (ta-fresh st))
    (EClose x (ta-walk-int st ctx env (Cons x Nil)))
    (ETestDecl _ body _ _ (let _ (ta-expr st ctx env body) (ta-stmt)))
    (ERunTests _ (ta-int))
    (EAliasDecl _ _ (ta-stmt))
    ; Parsed as placeholders that carry no code (expr_inner.zyl).
    (ETestCompile _ _ (ta-stmt))
    (_ (ta-dk st "form not typed"))))

(defn ta-atom (st ctx env a e)
  (match a
    (AInt _ (ta-int))
    (AFloat _ (ta-flt))
    (ABool _ (ta-bool))
    (AStr _ (ta-str))
    (AKeyword _ (ta-str))
    ; A missing `else` (and, in strict mode, the `unit` value) is Unit.
    (ANil (if (ta-strict-p) (ta-unit-ty) (ta-dk st "nil")))
    (AIdent n (ta-ident st ctx env n e))
    (ASymbol n (ta-ident st ctx env n e))))

(defn ta-ident (st ctx env n e)
  (let lt (ta-env-get env n)
    (if (ta-no-type-p lt)
      (let fi (ta-sget (ta-fnmap st) n)
        (if (> fi 0)
          (ta-fn-value st ctx (- fi 1) e)
          (ta-ctor-value st env n)))
      lt)))

; A top-level function used as a value, `(map f xs)`: like a call, a
; trait-generic one is specialized at the type it is used at (the node is
; renamed to the instance), so no generic original is ever run.
(defn ta-fn-value (st ctx fi e)
  (let tf (ta-fn-ref st ctx fi)
    (let s (ta-wget (ta-fnstate st) fi)
      (if (or (= s 1) (> (ta-wget (ta-fntg st) fi) 0))
        (ta-seq (ta-note st ctx e 1 "" tf fi) tf)
        tf))))

; A bare constructor: its value (nullary) or its function type.
(defn ta-ctor-value (st env n)
  (let vd (ta-sget-or (ta-variants st) n (ta-no-vd))
    (if (not (ta-shas (ta-variants st) n))
      (ta-unbound st env n)
      (match (ta-ctor-inst st vd)
        (TaF ps r (match ps (Nil r) (_ (TaF ps r))))
        (_ (ta-dk st "unknown identifier"))))))

(defn ta-ctor-inst (st vd)
  (match vd
    (TaVd _ nq t _ _ _ (ta-inst st (TaSc nq t)))))

(defn ta-let (st ctx env name val body)
  (let tv (ta-expr st ctx env val)
    (ta-expr st ctx (Cons (Pair name tv) env) body)))

(defn ta-set (st ctx env name val)
  (let tv (ta-expr st ctx env val)
    (let lt (ta-env-get env name)
      (let _ (if (ta-no-type-p lt) 0 (ta-unify st lt tv))
        (ta-stmt)))))

(defn ta-cond (st ctx env clauses r)
  (match clauses
    (Nil r)
    (Cons pr rest
      (match pr
        (Pair c body
          (let _ (ta-cond-bool st ctx env c "cond")
            (let bt (ta-expr st ctx env body)
              (let _ (ta-unify st r bt)
                (ta-cond st ctx env rest r)))))))))

; The mode is a literal fopen mode ("r", "w", "a", with `+` or `b`):
; lowering passes a literal through and used to open anything else, an
; Int such as 0 meaning "read" included, for writing (icnf.zyl).
(defn ta-file-open (st ctx env a b)
  (let ta (ta-expr st ctx env a)
    (let _ (ta-expr st ctx env b)
      (let _ (ta-unify st ta (ta-str))
        (let _ (if (ta-file-mode-ok b)
                 unit
                 (ta-type-error "E_TYPE_MISMATCH" "the mode of file-open must be a string literal: \"r\", \"w\" or \"a\", optionally with + or b"
                                b Nil "write the mode in double quotes, e.g. (file-open path \"r\")"))
          (ta-int))))))

(defn ta-file-mode-ok (b)
  (match (Expr.inner b)
    (EAtom a
      (match a
        (AStr m (or (ta-streq m "r") (or (ta-streq m "w") (or (ta-streq m "a")
                  (or (ta-streq m "r+") (or (ta-streq m "w+") (or (ta-streq m "a+")
                  (or (ta-streq m "rb") (or (ta-streq m "wb") (ta-streq m "ab"))))))))))
        (_ false)))
    (_ false)))

(defn ta-for (st ctx env bindings cond body)
  (match bindings
    (Nil (let _ (ta-cond-bool st ctx env cond "for")
           (let _ (ta-expr st ctx env body)
             (ta-stmt))))
    (Cons pr rest
      (match pr
        (Pair name initOpt
          (let t (match initOpt (Some x (ta-expr st ctx env x)) (None (ta-int)))
            (ta-for st ctx (Cons (Pair name t) env) rest cond body)))))))

; --- calls --------------------------------------------------------------------

(defn ta-call-expr (st ctx env e op args)
  (match (Expr.inner op)
    (EAtom a
      (match a
        (AIdent n (ta-call st ctx env e n args))
        (_ (ta-call-value st ctx env op args))))
    (_ (ta-call-value st ctx env op args))))

(defn ta-call-value (st ctx env op args)
  (let prev (ffi-call "zyl_ref_get" ta-list-head 1000)
    (let _ (ffi-call "zyl_ref_set" ta-list-head 1 1000)
      (let tf (ta-expr st ctx env op)
        (let _ (ffi-call "zyl_ref_set" ta-list-head prev 1000)
          (ta-apply-type st tf (ta-list st ctx env args)))))))

(defn ta-apply-type (st tf ts)
  (let r (ta-fresh st)
    (let _ (ta-unify st tf (TaF ts r))
      r)))

; 1 arithmetic, 2 comparison, 3 Int-only (bitwise, div!/rem!), 0 not an operator.
(defn ta-op-class (n)
  (if (ta-streq n "div!") 3
  (if (ta-streq n "rem!") 3
  (if (ta-streq n "wrapping+") 3
  (if (ta-streq n "wrapping-") 3
  (if (ta-streq n "wrapping*") 3
  (if (ta-streq n "saturating+") 3
  (if (ta-streq n "saturating-") 3
  (if (ta-streq n "saturating*") 3
  (if (ta-streq n "+") 1
  (if (ta-streq n "-") 1
  (if (ta-streq n "*") 1
  (if (ta-streq n "/") 1
  (if (ta-streq n "%") 1
  (if (ta-streq n "<") 2
  (if (ta-streq n ">") 2
  (if (ta-streq n "<=") 2
  (if (ta-streq n ">=") 2
  (if (ta-streq n "==") 2
  (if (ta-streq n "=") 2
  (if (ta-streq n "!=") 2
  (if (ta-streq n "bit-and") 3
  (if (ta-streq n "bit-or") 3
  (if (ta-streq n "bit-xor") 3
  (if (ta-streq n "bit-not") 3
  (if (ta-streq n "shl") 3
  (if (ta-streq n "shr") 3
  (if (ta-streq n "ashr") 3
  0))))))))))))))))))))))))))))

(defn ta-call (st ctx env e n args)
  (if (ta-streq n "zyl-method")
    (ta-method-call st ctx env e args)
    (if (ta-streq n "len")
      (ta-len st ctx env e args)
      (if (ta-pred-name-p n)
        (if (ta-no-type-p (ta-env-get env n))
          (ta-pred st ctx env e n args)
          (ta-call-go st ctx env e n args))
        (ta-call-go st ctx env e n args)))))

; The type predicates of spec 21.4. A value in Zyl is an untyped word, so
; there is nothing at runtime to ask: the answer is a property of the
; operand's static type and is decided here, in the type pass. Lowering
; emits the operand (so its effects still happen) and then the constant.
(defn ta-pred-name-p (n)
  (or (ta-streq n "int?") (or (ta-streq n "float?")
    (or (ta-streq n "bool?") (or (ta-streq n "string?")
      (or (ta-streq n "struct?") (ta-streq n "alias?")))))))

(defn ta-pred (st ctx env e n args)
  (match (ta-list st ctx env args)
    (Nil (ta-pred-arity st e n))
    (Cons x rest
      (match rest
        (Cons _ _ (ta-pred-arity st e n))
        (Nil (ta-pred-go st e n (ta-short (ta-tc-name st x))))))))

(defn ta-pred-arity (st e n)
  (ta-strict (str-concat n " takes exactly one argument"))
  (ta-bool))

; A receiver whose type is not known yet cannot be answered: there is no
; runtime type to fall back on, so this is reported rather than guessed.
(defn ta-pred-go (st e n k)
  (if (= (str-length k) 0)
    (let _ (ta-type-error "E_CANNOT_INFER"
            (str-concat n " cannot decide: the type of its argument is not known here, and a value carries no type at runtime")
            (ffi-call "zyl_ref_get" ta-cur-node 1000) Nil "")
      (ta-bool))
    (let _ (ta-set-name e 2 (ta-pred-ans n k))
      (ta-bool))))

; The answer, as the text lowering reads back.
(defn ta-pred-ans (n k)
  (if (ta-streq n "int?") (if (ta-streq k "Int") "1" "0")
  (if (ta-streq n "float?") (if (ta-streq k "Float") "1" "0")
  (if (ta-streq n "bool?") (if (ta-streq k "Bool") "1" "0")
  (if (ta-streq n "string?") (if (ta-streq k "String") "1" "0")
  (if (ta-streq n "struct?") (if (ffi-call "zyl_smap_has" ta-structs k 1000) "1" "0")
    (if (ffi-call "zyl_smap_has" ta-aliases k 1000) "1" "0")))))))

; The name of a resolved type, or "" when it is not a concrete named type.
(defn ta-tc-name (st t)
  (match (ta-resolve st t)
    (TaC n _ n)
    (_ "")))

(defn ta-len (st ctx env e args)
  (match (ta-list st ctx env args)
    (Nil (ta-len-shape st e))
    (Cons x rest
      (match rest
        (Cons _ _ (ta-len-shape st e))
        (Nil (ta-len-go st e (ta-short (ta-tc-name st x))))))))

; The argument's type is not a concrete named type: it is an unbound
; variable (any of String, List, Vec, Map may still land there), or it is
; the absorbing unknown a failed unification or an unbound name left
; behind. Neither is something `len` can have an opinion about, and the
; pass's own rule is that nothing depending on an unknown is reported --
; reporting it printed "a value of type  " with no type in it, beside the
; error that actually explains why. So: a fresh variable, no diagnostic.
(defn ta-len-unknown (st)
  (ta-fresh st))

; A type name is module-qualified (zyl/std@5::core/map::Map), so comparing
; against a bare "Map" never matches. Keep only what follows the last "::".

; (len x) asks for a type, and the type picks the function. The type name
; reaching here is the short one, so the module is not readable off it; the
; module is fixed per collection instead, below. That is sound because a
; program cannot name a collection type without importing the module that
; defines it, so the length function for a type in hand is always in
; scope. Map is unambiguous: core/map is the canonical Map (what the spec
; means by `len` and `(map key val...)`), and the arena-backed Int -> Int
; structure that used to share the name is now IntMap in
; collections/intmap; len accepts that too, since it also has a length.
(defn ta-len-go (st e k)
  (let sym (ta-short k)
    (if (ta-streq sym "String") (ta-len-pick st e "str-length" "")
    (if (ta-streq sym "List") (ta-len-pick st e "list-length" "core/list")
    (if (ta-streq sym "Vec") (ta-len-pick st e "vec-len" "collections/vec")
    (if (ta-streq sym "Map") (ta-len-pick st e "map-size" "core/map")
    ; IntMap is not the spec's Map, but it is a map with a length, and
    ; rejecting it would be a surprise next to accepting Map.
    (if (ta-streq sym "IntMap") (ta-len-pick st e "intmap-len" "collections/intmap")
      (if (= (str-length sym) 0) (ta-len-unknown st) (ta-len-none st k)))))))))

; The function to call for a length. A prelude function is registered under
; its bare name; a module function under its canonical key
; (zyl/std@5::collections/vec::vec-len), and that key is not derivable here
; without knowing the package and version, so it is found by its tail. The
; module is matched as well as the symbol, so a same-named function in
; another module cannot be picked up by mistake.
(defn ta-len-pick (st e short mod)
  (let _ (ta-set-name e 2 (ta-len-find st short mod))
    (ta-int)))

(defn ta-len-find (st short mod)
  (let fi (ta-sget (ta-fnmap st) short)
    (if (> fi 0)
      (ta-fn-name st (- fi 1))
      (let i (ta-len-scan st (str-concat (str-concat mod "::") short) 0 -1)
        (if (< i 0) short (ta-fn-name st i))))))

(defn ta-len-scan (st suffix i found)
  (if (or (>= i (ta-wlen (ta-fnexp st))) (>= found 0))
    found
    (ta-len-scan st suffix (+ i 1)
      (if (ta-len-tail-p (ta-fn-name st i) suffix) i found))))

(defn ta-len-tail-p (n suffix)
  (let ln (str-length n)
    (let ls (str-length suffix)
      (if (< ln ls)
        false
        (str-eq (str-substring n (- ln ls) ls) suffix)))))

(defn ta-len-shape (st e)
  (ta-strict "len takes exactly one argument")
  (ta-int))

(defn ta-len-none (st k)
  (ta-strict (str-concat (str-concat "len has no length for a value of type " k)
    " (String, List, Vec, or Map)"))
  (ta-int))

;; Dot method calls: how many trait methods are named m, and the dotted
;; name of the i-th under "m#i".
(def ta-mcount-table (ffi-call "zyl_smap_new" 1000))
(def ta-mname-table (ffi-call "zyl_smap_new" 1000))

(defn ta-mcount (m) (ffi-call "zyl_smap_get" ta-mcount-table m 1000))
(defn ta-mname (m i) (ffi-call "zyl_smap_get_or" ta-mname-table (ta-mkey m i) "" 1000))

(defn ta-mshort (d i)
  (if (= i 0) d
    (if (= (ffi-call "zyl_cstr_byte_at" d (- i 1) 1000) 46)
      (str-substring d i (- (str-length d) i))
      (ta-mshort d (- i 1)))))

(defn ta-mkey (m i) (str-concat m (str-concat "#" (ffi-call "zyl_int_text" i 1000))))

(defn ta-mtab-add (dotted)
  (let m (ta-mshort dotted (str-length dotted))
    (let c (ta-mcount m)
      (begin
        (ffi-call "zyl_smap_put" ta-mname-table (ta-mkey m c) dotted 1000)
        (ffi-call "zyl_smap_put" ta-mcount-table m (+ c 1) 1000)))))

(defn ta-method-call (st ctx env e args)
  (match args
    (Cons mexp rest
      (match rest
        (Cons recv more
          (let m (ta-str-lit mexp)
            (let tr (ta-expr st ctx env recv)
              (let dotted (ta-pick-method st e m (ta-resolve st tr))
                (let _ (ta-set-name e 2 dotted)
                  (let ts (Cons tr (ta-list st ctx env more))
                    (let r (ta-fresh st)
                      (let ct (TaF ts r)
                        (let sc (ta-sget-or (ta-traits st) dotted (TaSc 0 (ta-no-type)))
                          (let _ (if (ta-shas (ta-traits st) dotted) (ta-unify st (ta-inst st sc) ct) 0)
                            (ta-seq (ta-note st ctx e 0 dotted ct -1) r)))))))))))
        (Nil (ta-dk st "malformed method call"))))
    (Nil (ta-dk st "malformed method call"))))

(defn ta-str-lit (e)
  (match (Expr.inner e)
    (EAtom a (match a (AStr t t) (_ "")))
    (_ "")))

; One trait method: the only one named m, or the one with an impl for the receiver's type.
(defn ta-pick-method (st e m tr)
  (let c (ta-mcount m)
    (if (= c 0)
      (ta-method-fail e (str-concat "no trait declares a method `" (str-concat m "`")) "declare it in a trait and implement the trait for the receiver's type")
      (match tr
        (TaC n _
          (let hits (ta-method-hits st m n 0 c)
            (if (= (list-length hits) 1)
              (match hits (Cons h _ h) (Nil ""))
              (if (nil? hits)
                (ta-method-fail e (str-concat "no method `" (str-concat m (str-concat "` for type `" (str-concat (err-name n) "`"))))
                  (str-concat "implement a trait that declares `" (str-concat m "` for this type")))
                (ta-method-ambiguous e m hits)))))
        (_ (if (= c 1)
             (ta-mname m 0)
             (ta-method-ambiguous e m (ta-method-all m 0 c))))))))

(defn ta-method-hits (st m n i c)
  (if (>= i c) Nil
    (let d (ta-mname m i)
      (if (>= (ta-impl-fn st d n) 0)
        (Cons d (ta-method-hits st m n (+ i 1) c))
        (ta-method-hits st m n (+ i 1) c)))))

(defn ta-method-all (m i c)
  (if (>= i c) Nil (Cons (ta-mname m i) (ta-method-all m (+ i 1) c))))

(defn ta-method-ambiguous (e m ds)
  (ta-method-fail e (str-concat "method `" (str-concat m (str-concat "` is declared by more than one trait: " (ta-method-names ds))))
    "call it as (Trait.method receiver ...), or give the receiver a known type"))

(defn ta-method-names (ds)
  (match ds
    (Nil "")
    (Cons h t (let hn (err-name h) (if (nil? t) hn (str-concat hn (str-concat ", " (ta-method-names t))))))))

; Reported with the program's other type errors; the method name it
; stands for is empty.
(defn ta-method-fail (node msg help)
  (let _ (ta-type-error "E_TRAIT_NOT_FOUND" msg node Nil help)
    ""))

(defn ta-call-go (st ctx env e n args)
  (if (ta-streq n "with-region")
    (let ts (ta-list st ctx env args)
      (if (nil? ts) (ta-dk st "with-region shape") (ta-last ts (ta-no-type))))
  (if (ta-streq n "ffi-call")
    (ta-ffi-call st ctx env args)
    (let oc (ta-op-class n)
      (if (> oc 0)
        (ta-op st ctx env e n oc args)
        (let bi (ta-builtin-sig st n)
          (if (ta-no-type-p bi)
            (ta-call-named st ctx env e n args)
            (ta-apply-builtin st n bi args (ta-list st ctx env args)))))))))

; A built-in's call, checked argument by argument like a defn's.
(defn ta-apply-builtin (st n bi args ts)
  (match (ta-resolve st bi)
    (TaF ps r
      (if (= (list-length ps) (list-length ts))
        (ta-seq (ta-unify-args st (err-name n) Nil ps args ts 1) r)
        (ta-apply-type st bi ts)))
    (_ (ta-apply-type st bi ts))))

; Arithmetic or comparison on a type variable needs the instance type.
; An equality between two values is also noted: on an ADT it becomes a
; call to the type's structural equality function (ta-eq-fn).
(defn ta-op (st ctx env e n oc args)
  (let ts (ta-list st ctx env args)
    (if (= oc 3)
      (ta-seq (ta-op-ints st n args ts) (ta-int))
      (match ts
        (Nil (ta-int))
        (Cons h t
          (let _ (ta-op-operands st n (ta-rest-or-nil args) t h)
            (let _ (if (= oc 1) (ta-note-num st e h 1) (if (ta-order-op n) (ta-note-num st e h 2) 0))
            (let _ (ta-note-op st ctx h)
              (let _ (if (and (ta-eq-op n) (= (list-length ts) 2)) (ta-note st ctx e 5 "" (ta-sig2 h h (ta-bool)) -1) 0)
                (if (= oc 2) (ta-bool) h))))))))))

; Every later operand must have the first operand's type; a definite clash
; is reported at that operand, naming both types.
(defn ta-op-operands (st n args ts h)
  (match ts
    (Nil 0)
    (Cons t trest
      (match args
        (Nil 0)
        (Cons a arest
          (let _ (if (ta-clash st h t)
                   (ta-seq (ta-type-error "E_TYPE_MISMATCH"
                             (str-concat "the operands of `" (str-concat n (str-concat "` must have one type: the first is `"
                               (str-concat (ta-pretty st h) (str-concat "`, this one is `" (str-concat (ta-pretty st t) "`"))))))
                             a Nil "")
                           0)
                   (ta-unify st t h))
            (ta-op-operands st n arest trest h)))))))

; A bitwise operator takes Ints.
(defn ta-op-ints (st n args ts)
  (match ts
    (Nil 0)
    (Cons t trest
      (match args
        (Nil 0)
        (Cons a arest
          (let _ (if (ta-clash st (ta-int) t)
                   (ta-seq (ta-type-error "E_TYPE_MISMATCH"
                             (str-concat "`" (str-concat n (str-concat "` takes Ints, but this is `" (str-concat (ta-pretty st t) "`"))))
                             a Nil "")
                           0)
                   (ta-unify st t (ta-int)))
            (ta-op-ints st n arest trest)))))))

(defn ta-rest-or-nil (xs)
  (match xs (Nil Nil) (Cons _ r r)))

(defn ta-order-op (n)
  (or (ta-streq n "<") (or (ta-streq n ">") (or (ta-streq n "<=") (ta-streq n ">=")))))

(defn ta-eq-op (n)
  (if (ta-streq n "==") true (if (ta-streq n "=") true (ta-streq n "!="))))

(defn ta-note-op (st ctx t)
  (match (ta-resolve st t)
    (TaV i (if (< i 0) 0 (ta-note st ctx (ta-no-node) 4 "" t -1)))
    (_ 0)))

(defn ta-sig2 (a b r) (TaF (Cons a (Cons b Nil)) r))

; Standard-library string and print functions whose types codegen relies on.
(defn ta-builtin-sig (st n)
  (if (= (intrinsic-arity n) 1) (TaF (Cons (ta-int) Nil) (ta-int))
  (if (= (intrinsic-arity n) 2) (ta-sig2 (ta-int) (ta-int) (ta-int))
  (if (ta-key-is n "str-concat") (ta-sig2 (ta-str) (ta-str) (ta-str))
  (if (ta-key-is n "str-length") (TaF (Cons (ta-str) Nil) (ta-int))
  (if (ta-key-is n "str-substring") (TaF (ta-l3 (ta-str) (ta-int) (ta-int)) (ta-str))
  (if (ta-key-is n "str-equal") (ta-sig2 (ta-str) (ta-str) (if (ta-strict-p) (ta-bool) (ta-fresh st)))
  (if (ta-key-is n "str-eq") (ta-sig2 (ta-str) (ta-str) (if (ta-strict-p) (ta-bool) (ta-fresh st)))
  (if (ta-key-is n "print-string") (TaF (Cons (ta-str) Nil) (ta-unit-ty))
  (if (ta-key-is n "print-float") (TaF (Cons (ta-flt) Nil) (ta-unit-ty))
  ; A def getter's cell (expr_inner.zyl, def-getter). The read is the
  ; only generic result here: its one caller joins it, in the same `if`,
  ; with the value the getter stores under the same key.
  ; Channels (docs/concurrency-determinism-design.md): one element type per channel.
  (if (ta-key-is n "chan") (ta-sig-parse st "Int -> (Chan a)")
  (if (ta-key-is n "chan-tx") (ta-sig-parse st "(Chan a) -> (Tx a)")
  (if (ta-key-is n "chan-rx") (ta-sig-parse st "(Chan a) -> (Rx a)")
  (if (ta-key-is n "chan-recv") (ta-sig-parse st "(Rx a) -> a")
  ; Contract lowering's helpers (expr_inner.zyl): report, test an error
  ; code, re-raise a caught error.
  (if (and (ta-streq n "zyl-repl-global") (ffi-call "zyl_ref_get" repl-compiling 1000)) (ta-sig-parse st "String -> a")
  (if (ta-streq n "zyl-contract-warn") (ta-sig-parse st "String -> Unit")
  (if (ta-streq n "zyl-err-is") (ta-sig-parse st "String String -> Bool")
  (if (ta-streq n "zyl-reraise") (ta-sig-parse st "String -> a")
  (if (ta-streq n "zyl global ready") (ta-sig-parse st "String -> Bool")
  (if (ta-streq n "zyl global get") (ta-sig-parse st "String -> a")
  (if (ta-streq n "zyl global put") (ta-sig-parse st "String a -> Unit")
  ; collections/vec's typed arrays, whose element type every Vec relies on
  ; (the runtime signatures apply only in strict mode for now).
  (if (ta-key-is n "collections/vec::array-new") (ta-sig-parse st "Int -> (Array a)")
  (if (ta-key-is n "collections/vec::array-get") (ta-sig-parse st "(Array a) Int -> a")
  (if (ta-key-is n "collections/vec::array-set") (ta-sig-parse st "(Array a) Int a -> Unit")
  (if (ta-key-is n "collections/vec::array-cap") (ta-sig-parse st "(Array a) -> Int")
  (ta-no-type))))))))))))))))))))))))))

(defn ta-call-named (st ctx env e n args)
  (let lt (ta-env-get env n)
    (if (ta-no-type-p lt)
      (let fi (ta-sget (ta-fnmap st) n)
        (if (> fi 0)
          (ta-call-fn st ctx env e (- fi 1) args)
          (if (ta-shas (ta-traits st) n)
            (ta-trait-call st ctx env e n (Some (ta-sget-or (ta-traits st) n (TaSc 0 (ta-no-type)))) args)
            (if (ta-shas (ta-impls st) n)
              (ta-trait-call st ctx env e n None args)
              (ta-call-ctor st ctx env n args)))))
      (ta-apply-type st lt (ta-list st ctx env args)))))

; A call to a function still open (same SCC) or trait-generic is recorded
; so it can be specialized once its types are known.
(defn ta-call-fn (st ctx env e fi args)
  (let tf (ta-fn-ref st ctx fi)
    (let ts (ta-list st ctx env args)
      (let r (ta-fresh st)
        (let ct (TaF ts r)
          (let _ (ta-unify-call st fi tf args ts ct)
            (let s (ta-wget (ta-fnstate st) fi)
              (if (or (= s 1) (> (ta-wget (ta-fntg st) fi) 0))
                (ta-seq (ta-note st ctx e 1 "" ct fi) r)
                r))))))))

; A call against the callee's type: argument by argument when the arity
; agrees, so a clash is reported at the argument and names the parameter it
; was meant for; as a whole otherwise.
(defn ta-unify-call (st fi tf args ts ct)
  (match (ta-resolve st tf)
    (TaF ps r0
      (if (= (list-length ps) (list-length ts))
        (let _ (ta-unify-args st (err-name (ta-fn-name st fi)) (ta-fn-params st fi) ps args ts 1)
          (match ct (TaF _ r (ta-unify st r0 r)) (_ 0)))
        (ta-unify st tf ct)))
    (_ (ta-unify st tf ct))))

(defn ta-fn-params (st fi)
  (match (Expr.inner (ta-wget (ta-fnexp st) fi))
    (EDefn _ params _ params)
    (_ Nil)))

(defn ta-unify-args (st fname pnames ps args ts k)
  (match ps
    (Nil 0)
    (Cons p prest
      (match args
        (Nil 0)
        (Cons a arest
          (match ts
            (Nil 0)
            (Cons t trest
              (let _ (if (ta-clash st p t)
                       (ta-arg-mismatch st fname (ta-param-at pnames k) k a p t)
                       (ta-unify-at st a t p))
                (ta-unify-args st fname pnames prest arest trest (+ k 1))))))))))

; Unify with the report, if any, placed at `node`.
(defn ta-unify-at (st node a b)
  (let prev (ffi-call "zyl_ref_get" ta-cur-node 1000)
    (let _ (ffi-call "zyl_ref_set" ta-cur-node node 1000)
      (let ok (ta-unify st a b)
        (let _ (ffi-call "zyl_ref_set" ta-cur-node prev 1000)
          ok)))))

(defn ta-param-at (ps k)
  (match ps
    (Nil None)
    (Cons p rest (if (= k 1) (Some p) (ta-param-at rest (- k 1))))))

; "`twice` takes `Int` as its 1st argument (`n`), but this is `String`",
; at the argument, with the parameter labelled where it is declared.
(defn ta-arg-mismatch (st fname p k a want got)
  (let pname (match p (None "") (Some pp (P.name pp)))
    (let m1 (str-concat "`" (str-concat fname (str-concat "` takes `" (str-concat (ta-pretty st want) (str-concat "` as its " (ta-ordinal k))))))
      (let m2 (if (= (str-length pname) 0) "" (str-concat " (`" (str-concat pname "`)")))
        (let msg (str-concat m1 (str-concat " argument" (str-concat m2 (str-concat ", but this is `" (str-concat (ta-pretty st got) "`")))))
          (let labels (match p
                        (None Nil)
                        (Some pp (Cons (err-label-at pp (str-concat "`" (str-concat pname "` is declared here"))) Nil)))
            (ta-seq (ta-type-error "E_TYPE_MISMATCH" msg a labels "") 0)))))))

(defn ta-ordinal (k)
  (if (= k 1) "1st" (if (= k 2) "2nd" (if (= k 3) "3rd" (str-concat (ffi-call "zyl_int_text" k 1000) "th")))))

(defn ta-trait-call (st ctx env e n sc args)
  (let ts (ta-list st ctx env args)
    (let r (ta-fresh st)
      (let ct (TaF ts r)
        (let _ (match sc (Some s (ta-unify st (ta-inst st s) ct)) (None 0))
          (ta-seq (ta-note st ctx e 0 n ct -1) r))))))

(defn ta-print (st ctx env exprs)
  (match exprs
    (Nil (ta-int))
    (Cons a rest
      (let t (ta-expr st ctx env a)
        (ta-seq (ta-note st ctx a 2 "" t -1) (ta-print st ctx env rest))))))

; ctx, node, kind, name, type, function index.
(deftype TaSp (TaSp Int Expr Int String TaTy Int))

; The node of a note that has none (kind 4).
(defn ta-no-node () (Expr (EAtom ANil)))

(defn ta-note (st ctx node kind name t fi)
  (ta-wpush (ta-special st) (TaSp ctx node kind name t fi)))

(defn ta-call-ctor (st ctx env n args)
  (match (ta-ctor-lookup st n)
    (None (ta-seq (ta-list st ctx env args) (ta-unbound st env n)))
    (Some vd
      (let tc (ta-ctor-inst st vd)
        (let ts (ta-list st ctx env args)
          (let _ (ta-check-fields st n tc args ts)
            (ta-apply-type st tc ts)))))))

; `Name` or `make-Name`.
(defn ta-ctor-lookup (st n)
  (if (ta-shas (ta-variants st) n)
    (Some (ta-sget-or (ta-variants st) n (ta-no-vd)))
    (if (ta-starts-make n)
      (ta-vd-find st (str-substring n 5 (- (str-length n) 5)))
      None)))

(defn ta-vd-find (st n)
  (if (ta-shas (ta-variants st) n)
    (Some (ta-sget-or (ta-variants st) n (ta-no-vd)))
    None))

(defn ta-starts-make (n)
  (if (< (str-length n) 6) false (ta-streq (str-substring n 0 5) "make-")))

(defn ta-ffi-call (st ctx env args)
  (match args
    (Nil (ta-dk st "ffi-call shape"))
    (Cons sym rest
      (let ats (ta-list st ctx env (ta-butlast rest))
        (let _ (ta-list st ctx env (ta-last-only rest))
        (match (Expr.inner sym)
          (EAtom a (match a (AStr s (ta-ffi-typed st s ats sym)) (_ (ta-dk st "ffi-call symbol"))))
          (_ (ta-dk st "ffi-call symbol"))))))))

; A runtime entry is typed by its table signature (compiler/ffi_sigs), and
; one with none is E_CANNOT_INFER; a foreign symbol is typed by its
; (extern ...) declaration, and one with none is E_CANNOT_INFER.
; `node` is the ffi-call whose symbol this is: the diagnostic belongs to
; the call the reader wrote, not to whatever expression the type pass
; happened to be standing on (ta-cur-node is a global, and the compiler
; compiles the standard library in this same process, so it still names
; a stdlib module when a program is being checked).
(defn ta-ffi-typed (st s ats node)
  (let spec (if (ta-strict-p) (ffi-sig s) "")
    ; A runtime entry is exported by the runtime or has a table signature.
    (if (or (ta-runtime-export s) (> (str-length spec) 0))
      (if (ta-extern-declared s)
        (ta-extern-on-runtime st s ats spec)
        (if (= (str-length spec) 0)
          (ta-ffi-ret st s)
          (ta-ffi-sig st s ats spec)))
      (ta-ffi-extern st s ats))))

; An extern may not retype the runtime's own entries.
; A runtime entry the program also declared with (extern ...): the
; extern is refused at its own declaration (expr_inner.zyl's
; extern-runtime-entry-p), so here the call is simply typed by the table.
(defn ta-extern-on-runtime (st s ats spec)
  (if (= (str-length spec) 0) (ta-fresh st) (ta-ffi-sig st s ats spec)))

; A symbol typed by its table signature: the arguments unify with its
; parameters and the result is its result.
(defn ta-ffi-sig (st s ats spec)
  (match (ta-sig-parse st spec)
    (TaF ps ret
      (if (= (list-length ps) (list-length ats))
        (let _ (ta-unify-pairs st ats ps) ret)
        (let _ (ta-strict (str-concat "wrong number of arguments to " s)) ret)))
    (_ (ta-dk st "ffi signature"))))

(defn ta-extern-declared (s)
  (match (extern-sig-of s) (Some _ true) (None false)))

; Whether `s` is one of the runtime's own entries (asked of the runtime
; this compiler is linked with).
(defn ta-runtime-export (s) (ffi-call "zyl_runtime_export_p" s 1000))

(defn ta-runtime-sym (s)
  (and (>= (str-length s) 4) (ta-streq (str-substring s 0 4) "zyl_")))

; A foreign symbol is typed by its (extern ...) declaration. Its types
; must be concrete and one machine word wide: no type variable (that would
; be a cast), and nothing built out of a Float -- a bare Float crosses in an
; SSE register, but the eightbyte class of an aggregate containing one is
; not the same thing and is not decided here.
(defn ta-ffi-extern (st s ats)
  (match (extern-sig-of s)
    (None (ta-dk st (str-concat "ffi-call to `" (str-concat s "`, which has no (extern ...) declaration"))))
    (Some sig
      (match sig
        (ExternSig pes re
          (match (ta-conv-args st pes Nil Nil)
            (TaRL ps s2
              (match (ta-conv st re s2)
                (TaR r _
                  (let _ (ta-extern-check st s (Cons r ps))
                    (if (= (list-length ps) (list-length ats))
                      (let _ (ta-unify-pairs st ats ps) r)
                      (let _ (ta-strict (str-concat "wrong number of arguments to " s)) r))))))))))))

(defn ta-extern-check (st s ts)
  (match ts
    (Nil unit)
    (Cons t rest
      (let _ (if (ta-extern-ok st t) unit (ta-strict (ta-extern-why st s t)))
        (ta-extern-check st s rest)))))

; Why this type cannot cross. The two reasons want different words: a bare
; Float does cross now, so "cannot cross the C boundary" alone would
; contradict the Float in the type the reader is looking at.
(defn ta-extern-why (st s t)
  (str-concat "the extern declaration of `"
    (str-concat s
      (str-concat "` uses the type "
        (str-concat (ta-show st t)
          (if (ta-extern-has-var st t)
            ", which is a type variable: any value would become any other"
            ", and a Float crosses on its own but not inside a type"))))))

(defn ta-extern-has-var (st t)
  (match (ta-resolve st t)
    (TaV _ true)
    (TaC _ args (ta-extern-any-var st args))
    (TaF ps r (or (ta-extern-any-var st ps) (ta-extern-has-var st r)))))

(defn ta-extern-any-var (st ts)
  (match ts
    (Nil false)
    (Cons t rest (or (ta-extern-has-var st t) (ta-extern-any-var st rest)))))

; A Float of its own crosses: its 64 bits are the IEEE-754 double C reads,
; and the runtime's mixed call puts them in an xmm register. A Float
; anywhere inside a type does not -- an aggregate is classified eightbyte
; by eightbyte, which this pass does not compute -- so it is refused, as
; is a type variable, which would let any value become any other.
(defn ta-extern-ok (st t)
  (match (ta-resolve st t)
    (TaV _ false)
    (TaC n args (if (ta-streq n "Float") (ta-float-bare-p args) (ta-extern-plain st args)))
    (TaF ps r (and (ta-extern-plain st ps) (ta-extern-ok st r)))))

; (Float) is the type; a Float applied to arguments is a constructor this
; pass does not know, and is treated as the nested case.
(defn ta-float-bare-p (args) (= (list-length args) 0))

; A type that may cross only as one machine word: no Float inside it
; anywhere, and no type variable at any depth.
(defn ta-extern-plain (st ts)
  (match ts
    (Nil true)
    (Cons t rest (and (ta-extern-word st t) (ta-extern-plain st rest)))))

(defn ta-extern-word (st t)
  (match (ta-resolve st t)
    (TaV _ false)
    (TaC n args (and (not (ta-streq n "Float")) (ta-extern-plain st args)))
    (TaF ps r (and (ta-extern-plain st ps) (ta-extern-word st r)))))

(defn ta-unify-pairs (st xs ys)
  (match xs
    (Nil 0)
    (Cons x xr
      (match ys
        (Nil 0)
        (Cons y yr (let _ (ta-unify st x y) (ta-unify-pairs st xr yr)))))))

; --- signature text: "A B -> R", types Int Float Bool String Unit, a
; capitalized name with arguments in parentheses "(SMap v)", and lowercase
; names as type variables shared across one signature.
(deftype TaSP (TaSP TaTy Int (List (Pair String TaTy))))

(defn ta-sig-parse (st spec)
  (ta-sig-params st spec 0 Nil Nil))

(defn ta-sig-params (st spec i acc vars)
  (let j (ta-sig-skip spec i)
    (if (ta-sig-arrow spec j)
      (match (ta-sig-type st spec (ta-sig-skip spec (+ j 2)) vars)
        (TaSP ret _ _ (TaF (list-reverse acc) ret)))
      (if (>= j (str-length spec))
        (TaF (list-reverse acc) (ta-unit-ty))
        (match (ta-sig-type st spec j vars)
          (TaSP t k vars2 (ta-sig-params st spec k (Cons t acc) vars2)))))))

(defn ta-sig-byte (spec i)
  (if (>= i (str-length spec)) 0 (ffi-call "zyl_cstr_byte_at" spec i 1000)))

(defn ta-sig-skip (spec i)
  (if (= (ta-sig-byte spec i) 32) (ta-sig-skip spec (+ i 1)) i))

(defn ta-sig-arrow (spec i)
  (and (= (ta-sig-byte spec i) 45) (= (ta-sig-byte spec (+ i 1)) 62)))

(defn ta-sig-word-end (spec i)
  (let c (ta-sig-byte spec i)
    (if (or (= c 0) (or (= c 32) (or (= c 40) (= c 41)))) i (ta-sig-word-end spec (+ i 1)))))

; One type starting at i: a word, or (Name arg...).
(defn ta-sig-type (st spec i vars)
  (let j (ta-sig-skip spec i)
    (if (= (ta-sig-byte spec j) 40)
      (let k (ta-sig-word-end spec (+ j 1))
        (let name (str-substring spec (+ j 1) (- k (+ j 1)))
          (ta-sig-args st spec k vars name Nil)))
      (let k (ta-sig-word-end spec j)
        (ta-sig-word st (str-substring spec j (- k j)) k vars)))))

(defn ta-sig-args (st spec i vars name acc)
  (let j (ta-sig-skip spec i)
    (if (= (ta-sig-byte spec j) 41)
      (TaSP (TaC name (list-reverse acc)) (+ j 1) vars)
      (match (ta-sig-type st spec j vars)
        (TaSP t k vars2 (ta-sig-args st spec k vars2 name (Cons t acc)))))))

(defn ta-sig-word (st w k vars)
  (let c (ffi-call "zyl_cstr_byte_at" w 0 1000)
    (if (and (>= c 97) (<= c 122))
      (let found (ta-sig-var-find vars w)
        (match found
          (Some t (TaSP t k vars))
          (None (let v (ta-fresh st) (TaSP v k (Cons (Pair w v) vars))))))
      ; `Ptr` resolves to Int here as well as in ta-conv-name-1: this parser
      ; reads extern declarations and the runtime signature table, and a
      ; `Ptr` that meant one thing in a type annotation and another in a
      ; signature would be a worse trap than no distinction at all. See the
      ; note on ta-builtin-type for why it is a spelling.
      (TaSP (if (ta-streq w "Ptr") (ta-int) (TaC w Nil)) k vars))))

(defn ta-sig-var-find (vars w)
  (match vars
    (Nil None)
    (Cons p rest
      (match p
        (Pair k t (if (ta-streq k w) (Some t) (ta-sig-var-find rest w)))))))

(defn ta-butlast (xs)
  (match xs
    (Nil Nil)
    (Cons h t (match t (Nil Nil) (_ (Cons h (ta-butlast t)))))))

(defn ta-last-only (xs)
  (match xs
    (Nil Nil)
    (Cons h t (match t (Nil (Cons h Nil)) (_ (ta-last-only t))))))

(defn ta-ffi-args (st ctx env args)
  (ta-seq (ta-list st ctx env args) 0))

(defn ta-ffi-ret (st s)
  (if (ta-ffi-str s) (ta-str) (ta-dk st "untyped ffi result")))

(defn ta-ffi-str (s)
  (if (ta-streq s "zyl_cstr_concat") true
  (if (ta-streq s "zyl_cstr_substr") true
  (if (ta-streq s "zyl_cstr_sub") true
  (if (ta-streq s "zyl_cstr_from_int") true
  (if (ta-streq s "zyl_cstr_from_byte") true
  (if (ta-streq s "zyl_cstr_sanitize") true
  (if (ta-streq s "zyl_cstr_decode") true
  (if (ta-streq s "zyl_file_read_c") true
  (if (ta-streq s "zyl_int_text") true
  (if (ta-streq s "zyl_f_text") true
  (ta-streq s "zyl_json_quote"))))))))))))

; --- functions and SCCs -------------------------------------------------------

(defn ta-min-low (st ctx v)
  (if (< ctx 0)
    unit
    (let a (ta-wget (ta-tjlow st) ctx)
      (if (< v a) (ta-wset (ta-tjlow st) ctx v) unit))))

(defn ta-fn-ref (st ctx i)
  (let s (ta-wget (ta-fnstate st) i)
    (if (= s 2)
      (ta-inst st (ta-wget (ta-fnsc st) i))
      (if (= s 1)
        (ta-seq (ta-min-low st ctx (ta-wget (ta-tjidx st) i)) (ta-wget (ta-fnty st) i))
        (let _ (ta-visit st i)
          (let _ (ta-min-low st ctx (ta-wget (ta-tjlow st) i))
            (ta-fn-ref-after st i)))))))

(defn ta-fn-ref-after (st i)
  (if (= (ta-wget (ta-fnstate st) i) 2)
    (ta-inst st (ta-wget (ta-fnsc st) i))
    (ta-wget (ta-fnty st) i)))

(deftype TaPE (TaPE (List TaTy) (List (Pair String TaTy)) (List (Pair String TaTy)) Int))

(defn ta-params (st params env scope acc)
  (match params
    (Nil (TaPE (list-reverse acc) env scope 0))
    (Cons p rest
      (match (ta-param-ty st p scope)
        (TaR t s2
          (let _ (ta-rec p t)
            (ta-params st rest (Cons (Pair (P.name p) t) env) s2 (Cons t acc))))))))

(defn ta-param-ty (st p scope)
  (match (P.type p)
    (Some te (ta-conv st te scope))
    (None (TaR (ta-fresh st) scope))))

(defn ta-lambda (st ctx env params body)
  (match (ta-params st params env Nil Nil)
    (TaPE ts env2 _ _
      (TaF ts (ta-expr st ctx env2 body)))))

(defn ta-visit (st v)
  (let c (+ (ta-wlen (ta-counter st)) 1)
    (begin
      (ta-wpush (ta-counter st) 0)
      (ta-wset (ta-tjidx st) v c)
      (ta-wset (ta-tjlow st) v c)
      (ta-wpush (ta-tjstack st) v)
      (ta-wset (ta-fnstate st) v 1)
      (ta-wset (ta-fnsp st) v (ta-wlen (ta-special st)))
      (ta-wset (ta-fnpp st) v (ta-wlen (ta-pending st)))
      (ta-visit-body st v (ta-wget (ta-fnexp st) v))
      (if (= (ta-wget (ta-tjlow st) v) (ta-wget (ta-tjidx st) v))
        (ta-close st v)
        0))))

(defn ta-visit-body (st v e)
  (match (Expr.inner e)
    (EDefn _ params body
      (match (ta-params st params Nil Nil Nil)
        (TaPE ts env _ _
          (let r (ta-fresh st)
            (let _ (ta-wset (ta-fnty st) v (TaF ts r))
              (let inst (ta-wget (ta-fninst st) v)
                (let _ (if (ta-no-type-p inst) 0 (ta-unify st (TaF ts r) inst))
                  (ta-unify st r (ta-expr st v env body)))))))))
    (_ 0)))

; An SCC's pending struct-gets and uses are exactly those recorded since
; its root's visit began: nested SCCs have already taken theirs.
(defn ta-close (st v)
  (let members (ta-pop-scc st v Nil)
    (begin
      (ta-flush-pending st (ta-wget (ta-fnpp st) v))
      (ta-resolve-specials st members (ta-wget (ta-fnsp st) v))
      (ta-gen-members st members))))

(defn ta-pop-scc (st v acc)
  (let w (ffi-call "zyl_wvec_pop" (ta-tjstack st) 1000)
    (if (= w v) (Cons w acc) (ta-pop-scc st v (Cons w acc)))))

; A top-level def's getter is not generalized (the value restriction):
; `(def cells (ffi-call "zyl_wvec_new" 1000))` is one vector of one
; element type, not a vector of every type.
(defn ta-gen-members (st ms)
  (match ms
    (Nil 0)
    (Cons m rest
      (begin
        (if (ffi-call "zyl_smap_has" def-names (ta-fn-name st m) 1000)
          (ta-wset (ta-fnsc st) m (TaSc 0 (ta-wget (ta-fnty st) m)))
        (match (ta-gen st (ta-wget (ta-fnty st) m) Nil)
          (TaGen t seen
            (begin
              (ta-debug-scheme st m t)
              (ta-wset (ta-fnsc st) m (TaSc (list-length seen) t))))))
        (ta-wset (ta-fnstate st) m 2)
        (ta-gen-members st rest)))))

; --- match, unwrap, struct-get ------------------------------------------------

(defn ta-match (st ctx env subj arms)
  (let ts (ta-expr st ctx env subj)
    (ta-arms st ctx env ts arms (ta-fresh st))))

(defn ta-arms (st ctx env ts arms r)
  (match arms
    (Nil r)
    (Cons arm rest
      (match arm
        (MA v pats body
          (let env2 (ta-arm-env st env ts v pats)
            (let bt (ta-expr st ctx env2 body)
              (let _ (ta-unify st r bt)
                (ta-arms st ctx env ts rest r)))))))))

(defn ta-arm-env (st env ts v pats)
  (match (ta-vd-find st v)
    (None env)
    (Some vd
      (match (ta-ctor-inst st vd)
        (TaF fts rt
          (let _ (ta-unify st ts rt)
            (ta-bind-pats st env pats fts)))
        (_ env)))))

(defn ta-bind-pats (st env pats fts)
  (match pats
    (Nil env)
    (Cons p prest
      (match fts
        (Nil env)
        (Cons ft frest (ta-bind-pats st (ta-bind-pat st env p ft) prest frest))))))

(defn ta-bind-pat (st env p ft)
  (match (Expr.inner p)
    (EAtom a
      (match a
        (AIdent n (if (ta-streq n "_") env (ta-seq (ta-rec p ft) (Cons (Pair n ft) env))))
        (_ env)))
    (ECall op sub (ta-arm-env st env ft (ta-ident-of op) sub))
    (EApply n sub (ta-arm-env st env ft n sub))
    (_ env)))

(defn ta-ident-of (e)
  (match (Expr.inner e)
    (EAtom a (match a (AIdent n n) (_ "")))
    (_ "")))

(defn ta-unwrap (st ctx env x)
  (let tx (ta-expr st ctx env x)
    (match (ta-vd-find st "Some")
      (None (ta-dk st "unwrap"))
      (Some vd
        (match (ta-ctor-inst st vd)
          (TaF fts rt
            (let _ (ta-unify st tx rt)
              (ta-nth fts 0 (ta-no-type))))
          (_ (ta-dk st "unwrap")))))))

(deftype TaPend (TaPend Int TaTy String TaTy Expr))

(defn ta-struct-get (st ctx env se field node)
  (let ts (ta-expr st ctx env se)
    (let r (ta-fresh st)
      (let done (ta-sg-try st ts field r node)
        (if (> done 0)
          r
          (let _ (ta-wpush (ta-pending st) (TaPend ctx ts field r node))
            r))))))

; 1 when resolved (or impossible), 0 when it must wait.
(defn ta-sg-try (st ts field r node)
  (match (ta-resolve st ts)
    ; A generated tuple type answers a positional read; `field` carries the
    ; index as text for the pending case, and the type says which reading
    ; it is, so no marker is needed to tell the two apart.
    (TaC n args
      (if (ta-tuple-name-p n)
        (ta-sg-tuple st ts n field r node)
        (ta-sg-struct st n args field r node)))
    (TaV i (if (< i 0) 1 (if (ta-poisoned st i) 1 (ta-sg-guess st ts field r node))))
    (_ 1)))

; Element `field` of a generated tuple type. `r` is unified with the
; element type recorded for the generated type, and the node is named so
; lowering knows which variant to build the read from. 1 when settled.
(defn ta-sg-tuple (st ts n field r node)
  (let _ (ta-set-name node 2 n)
    (match (ta-tuple-vd st n)
      (Some vd (ta-tuple-slot st node n vd field r))
      (None 1))))

(defn ta-tuple-slot (st node n vd field r)
  (match (ta-tuple-nth vd (ta-int-of-text field))
    (Some ft (ta-seq (ta-unify st r ft) 1))
    (None (ta-seq (ta-tuple-oob st node n (ta-int-of-text field)) 1))))

(defn ta-sg-struct (st n args field r node)
  (match (ta-vd-find st n)
    (None 1)
    (Some vd
      (match vd
        (TaVd _ nq t names isst np
          (let idx (if isst (ta-str-index names field 0) -1)
            (if (< idx 0)
              (if isst (ta-no-field node n field names) 1)
              (match (ta-subst st t (ta-slots-with st args nq))
                (TaF fts _
                  (if (< idx (list-length fts))
                    (ta-seq (ta-unify st r (ta-nth fts idx (ta-no-type))) 1)
                    (ta-seq (ta-dk st "struct field index") 1)))
                (_ 1)))))))))

; --- tuples ------------------------------------------------------------------
;
; `(tuple a b)` is a generated single-variant ADT, one per element type
; list, so the element types are part of the type: `(tuple 1 2)` and
; `(tuple "a" "b")` are different types that cannot be confused, and a
; tuple can be read, matched, printed and compared like any other value.
; The name is derived here because the element types are only known here
; -- the parse cannot pick it, and lowering runs after this pass.
;
; The deftype form is pushed onto ta-extra, which ta-annotate returns as
; part of the program, so ic-collect-vt registers the variant and lowering
; finds its tag. It is marked as a struct so that tag is globally unique:
; each generated type numbers its own tags from 0, and a match on one must
; not be able to fire on another.

; A tuple's type is the generated type's name. It has no type parameters,
; because the element types are already in the name.
(defn ta-tuple-type (_st name) (TaC name Nil))

(defn ta-tuple (st ctx env node elems)
  (let ets (ta-list st ctx env elems)
    (let name (ta-tuple-name st (list-length ets) ets)
      (let _ (ta-tuple-declare st name (list-length ets) ets)
        (let _ (ta-set-name node 2 name)
          (ta-tuple-type st name))))))

(defn ta-tuple-name (st n ets)
  (str-concat "__Tuple"
    (str-concat (ffi-call "zyl_int_text" n 1000)
      (str-concat "~" (ta-canon-list st ets)))))

; Register the variant, and emit the deftype that gives it a tag, once per
; name. A repeated element type list reuses the type already declared.
(defn ta-tuple-declare (st name n ets)
  (if (ta-shas (ta-variants st) name)
    0
    (begin
      (ta-put2 (ta-variants st) name
        (TaVd name 0 (TaF ets (TaC name Nil)) (ta-tuple-fields n 0) true 0))
      (ta-wpush (ta-extra st) (ta-tuple-deftype name n))
      0)))

; Field names, "f0".."f{n-1}". Only positional reads are supported, so
; these name positions rather than being written by anyone.
(defn ta-tuple-fields (n i)
  (if (>= i n)
    Nil
    (Cons (str-concat "f" (ffi-call "zyl_int_text" i 1000))
      (ta-tuple-fields n (+ i 1)))))

; The declaration itself. A deftype variant carries field NAMES, and its
; field types live in ta-variants (ta-field-exprs), which is where the
; element types above were recorded.
(defn ta-tuple-deftype (name n)
  (Expr
    (EDeftype name
      (Cons (AV name (ta-tuple-fields n 0)) Nil)
      Nil
      (Some "tuple"))))

; (tuple-get t i) is a field read on a generated tuple type, so it
; defers and flushes exactly as struct-get does: a receiver whose type is
; not known yet is re-checked once the function group is done. That is what
; lets a generic function read element 0 of whatever tuple it is handed --
; the generic original defers, and each instance re-checks with a concrete
; receiver.
(defn ta-tuple-get (st ctx env node t i)
  (let ts (ta-expr st ctx env t)
    (let r (ta-fresh st)
      (let idx (ta-tuple-pending-key i)
        (let done (ta-sg-try st ts idx r node)
          (if (> done 0)
            r
            (let _ (ta-wpush (ta-pending st) (TaPend ctx ts idx r node))
              r)))))))

; The generated type name of a value's type, "" when it is not one.
(defn ta-tuple-type-name (st t)
  (match (ta-resolve st t)
    (TaC n _
      (if (ta-tuple-name-p n) n ""))
    (_ "")))

(defn ta-tuple-name-p (n)
  (if (> (str-length n) 7) (str-eq (str-substring n 0 7) "__Tuple") false))

(defn ta-tuple-vd (st name)
  (if (= (str-length name) 0) None (Some (ta-sget-or (ta-variants st) name (ta-no-vd)))))

; Element i's type, when the generated type has one.
(defn ta-tuple-nth (vd i)
  (match vd
    (TaVd _ _ t _ _ _
      (match t
        (TaF ps _ (ta-nth-ty ps i))
        (_ None)))
    (_ None)))

; Element i by index, read back from the pending's text form.
(defn ta-tuple-nth-by-name (vd field)
  (ta-tuple-nth vd (ta-int-of-text field)))

; A tuple read is tagged so the flush can tell it from a struct field read:
; `@` cannot appear in an identifier, so no field name can collide with it.
; Struct reads carry a bare field name, and route through the "sole struct
; with this field" heuristic, which knows nothing about tuples.
(defn ta-tuple-pending-key (i)
  (str-concat "@t" (ffi-call "zyl_int_text" i 1000)))

(defn ta-tuple-pending-p (s)
  (if (> (str-length s) 2) (= (ffi-call "zyl_cstr_byte_at" s 0 1000) 64) false))

; The index, recovered from the tag.
(defn ta-int-of-text (s) (ffi-call "zyl_cstr_to_int" (str-substring s 2 (- (str-length s) 2)) 1000))

(defn ta-nth-ty (ts i)
  (match ts
    (Nil None)
    (Cons h t (if (<= i 0) (Some h) (ta-nth-ty t (- i 1))))))

; An index past the end, naming the arity so the bound is obvious. The
; error is recorded and a placeholder type returned, so the pass still has
; a type for the node; compilation fails on the recorded error.
(defn ta-tuple-oob (st node name i)
  (let vd (ta-sget-or (ta-variants st) name (ta-no-vd))
    (let n (match vd (TaVd _ _ _ names _ _ (list-length names)) (_ 0))
      (ta-seq 0
        (let _ (ta-type-error "E_INDEX_OUT_OF_BOUNDS"
                (str-concat "this tuple has "
                  (str-concat (ffi-call "zyl_int_text" n 1000)
                    (str-concat " element(s), so index "
                      (str-concat (ffi-call "zyl_int_text" i 1000) " is out of range"))))
                node Nil "tuple indexes start at 0")
          (ta-no-type))))))

(defn ta-str-index (xs s i)
  (match xs
    (Nil -1)
    (Cons h t (if (ta-streq h s) i (ta-str-index t s (+ i 1))))))

; Unresolved receiver: commit when exactly one struct has the field.
; A known struct without the field: a definite error.
(defn ta-no-field (node n field names)
  (let msg (str-concat "no field `" (str-concat field (str-concat "` on struct `" (str-concat (err-name n) "`"))))
    (let _ (ta-type-error "E_TYPE_MISMATCH" msg node Nil (str-concat "its fields are: " (ta-join-names names)))
      1)))

(defn ta-join-names (xs)
  (match xs
    (Nil "")
    (Cons h t (if (nil? t) h (str-concat h (str-concat ", " (ta-join-names t)))))))

(defn ta-sg-guess (st ts field r node)
  (let sn (ta-sole-struct-with st field)
    (if (= (str-length sn) 0)
      0
      (let vd (ta-sget-or (ta-variants st) sn (ta-no-vd))
        (match (ta-ctor-inst st vd)
          (TaF _ rt (ta-seq (ta-unify st ts rt) (ta-sg-try st ts field r node)))
          (_ 1))))))

; The one struct with a field of this name, or "".
(defn ta-sole-struct-with (st field)
  (match (ta-sget-or (ta-fields st) field Nil)
    (Cons h t (match t (Nil h) (_ "")))
    (Nil "")))

; Retry this SCC's pending struct-gets, then drop them.
(defn ta-flush-pending (st from)
  (let pv (ta-pending st)
    (let _ (ta-flush-loop st pv from (ta-wlen pv))
      (ffi-call "zyl_wvec_truncate" pv from 1000))))

(defn ta-flush-loop (st pv i n)
  (if (>= i n)
    0
    (match (ta-wget pv i)
      (TaPend _ ts field r node
        (let _ (ta-flush-one st ts field r node)
          (ta-flush-loop st pv (+ i 1) n))))))

; One deferred read, retried now that the function group is done. A tuple
; read is tagged, so it gets the tuple message rather than being routed
; through the struct-field heuristic, which knows nothing about tuples.
(defn ta-flush-one (st ts field r node)
  (if (ta-streq field " bytes")
    (if (= (ta-bytes-try st ts node) 0) (ta-bytes-ambiguous node) unit)
    (if (ta-tuple-pending-p field)
      (if (= (ta-sg-try st ts field r node) 0) (ta-tuple-unresolved node) unit)
      (if (= (ta-sg-try st ts field r node) 0) (ta-sg-ambiguous field node) unit))))

; A tuple read whose receiver never resolved. A generic function cannot say
; its type parameter is a tuple -- there are no trait bounds to write
; (spec 6.1) -- so this is reported rather than deferred forever.
; The pending already bound the node's type, so this only records the
; error; the value is not used.
(defn ta-tuple-unresolved (node)
  (ta-type-error "E_CANNOT_INFER"
    "`tuple-get` cannot tell this is a tuple: the receiver's type is still unknown here"
    node Nil "take a concrete tuple, so its element types are known"))

; A field read whose record type is still unknown when its function
; group is done: several structs have the field, so the result would be
; any type. (The field's type used to be left free.)
(defn ta-sg-ambiguous (field node)
  (ta-type-error "E_CANNOT_INFER"
    (str-concat "cannot tell which struct's field `" (str-concat field "` this reads: more than one struct has it"))
    node Nil "annotate the value's type, e.g. ((p Point))"))

(defn ta-int-in (x xs)
  (match xs
    (Nil false)
    (Cons h t (if (= h x) true (ta-int-in x t)))))

(defn ta-repush (pv xs)
  (match xs
    (Nil 0)
    (Cons h t (ta-seq (ta-wpush pv h) (ta-repush pv t)))))

; --- annotation checks --------------------------------------------------------
; An argument whose inferred type clashes with the declared type of a
; constructor field is E_TYPE_MISMATCH (a parameter's is ta-unify-args).
; Only a definite clash counts: unknown parts on either side never do.

(defn ta-check-fields (st cname tc args ts)
  (match tc
    (TaF fts _ (ta-check-field-list st cname fts args ts 1))
    (_ 0)))

(defn ta-check-field-list (st cname fts args ts k)
  (match fts
    (Nil 0)
    (Cons want frest
      (match args
        (Nil 0)
        (Cons a arest
          (match ts
            (Nil 0)
            (Cons t trest
              (begin
                (if (ta-clash st want t)
                  (ta-mismatch st a want t Nil
                    (str-concat "field " (str-concat (ffi-call "zyl_int_text" k 1000)
                      (str-concat " of `" (str-concat (err-name cname) (str-concat "` is declared `" (str-concat (ta-pretty st want) "`")))))))
                  unit)
                (ta-check-field-list st cname frest arest trest (+ k 1))))))))))

(defn ta-mismatch (st node want got labels help)
  (let m1 (str-concat "mismatched types: expected `" (ta-pretty st want))
    (let msg (str-concat m1 (str-concat "`, found `" (str-concat (ta-pretty st got) "`")))
      (ta-type-error "E_TYPE_MISMATCH" msg node labels help))))

; True when `a` and `b` can never unify. A variable (known or poisoned) never
; clashes, nor does Unit, which no expression is inferred to have.
(defn ta-clash (st a b)
  (match (ta-resolve st a)
    (TaV _ false)
    (TaC n1 a1
      (match (ta-resolve st b)
        (TaV _ false)
        (TaC n2 a2
          (if (ta-unit n1) false (if (ta-unit n2) false (if (ta-streq n1 n2) (ta-clash-list st a1 a2) true))))
        (TaF _ _ (if (ta-unit n1) false true))))
    (TaF p1 r1
      (match (ta-resolve st b)
        (TaV _ false)
        (TaC n2 _ (if (ta-unit n2) false true))
        (TaF p2 r2
          (if (= (list-length p1) (list-length p2))
            (if (ta-clash-list st p1 p2) true (ta-clash st r1 r2))
            true))))))

(defn ta-clash-list (st xs ys)
  (match xs
    (Nil false)
    (Cons x xr
      (match ys
        (Nil false)
        (Cons y yr (if (ta-clash st x y) true (ta-clash-list st xr yr)))))))

(defn ta-unit (n) (ta-streq n "Unit"))

; --- structural equality ------------------------------------------------------
; `==`/`=`/`!=` on an ADT calls a generated `(defn T.== (a b) ...)` that
; matches both sides and compares their fields with `==`, so nested ADTs,
; Strings and Floats compare by content. A generic field makes it
; trait-generic, specialized per type like any other function. A type with
; a Secret field keeps identity comparison (no early-exit field compare).

(defn ta-eq-register (st name variants)
  (match variants
    (Nil unit)
    (Cons _ _
      (if (ta-secret-variants st variants)
        unit
        (ta-sput ta-eqv-table name variants)))))

(defn ta-secret-variants (st variants)
  (match variants
    (Nil false)
    (Cons v rest (if (ta-secret-list (ta-field-exprs st (AV.name v))) true (ta-secret-variants st rest)))))

(defn ta-secret-list (tes)
  (match tes
    (Nil false)
    (Cons te rest (if (ta-secret-te te) true (ta-secret-list rest)))))

(defn ta-secret-te (te)
  (match (Expr.inner te)
    (EAtom a (match a (AIdent n (ta-key-is n "Secret")) (_ false)))
    (EApply head args (if (ta-key-is head "Secret") true (ta-secret-list args)))
    (ECall op args (if (ta-secret-te op) true (ta-secret-list args)))
    (_ false)))

; Index of the equality function of ADT `n`, made and visited on first use;
; -1 when `n` has none.
(defn ta-eq-fn (st n)
  (let got (ta-sget (ta-specs st) (str-concat "!eq:" n))
    (if (> got 0)
      (- got 1)
      (let vs (ta-sget-or ta-eqv-table n Nil)
        (if (not (ta-shas ta-eqv-table n))
          -1
          (let name (str-concat n ".==")
            (let e (ta-eq-defn name vs)
              (let fi (ta-add-fn st name e)
                (begin
                  (ta-sput (ta-specs st) (str-concat "!eq:" n) (+ fi 1))
                  (ta-wpush (ta-extra st) e)
                  (ta-visit st fi)
                  fi)))))))))

(defn ta-eq-status (st ct)
  (match (ta-recv st ct)
    (TaC n _
      (let fi (ta-eq-fn st n)
        (if (< fi 0) 0 (ta-impl-status st fi ct))))
    (_ 0)))

(defn ta-id (n) (Expr (EAtom (AIdent n))))
(defn ta-blit (b) (Expr (EAtom (ABool b))))

(defn ta-eq-defn (name variants)
  (Expr (EDefn name (ta-l2 (P "_eqa" None) (P "_eqb" None))
    (Expr (EMatch (ta-id "_eqa") (ta-eq-arms variants (list-length variants)))))))

(defn ta-eq-arms (variants nv)
  (match variants
    (Nil Nil)
    (Cons v rest
      (let n (list-length (AV.fields v))
        (let same (MA (AV.name v) (ta-eq-binds "_eqy" n 0) (ta-eq-chain n 0))
          (let inner (if (> nv 1) (ta-l2 same (MA "_" Nil (ta-blit false))) (Cons same Nil))
            (Cons (MA (AV.name v) (ta-eq-binds "_eqx" n 0) (Expr (EMatch (ta-id "_eqb") inner)))
                  (ta-eq-arms rest nv))))))))

(defn ta-eq-var (pre i) (str-concat pre (ffi-call "zyl_int_text" i 1000)))

(defn ta-eq-binds (pre n i)
  (if (>= i n) Nil (Cons (ta-id (ta-eq-var pre i)) (ta-eq-binds pre n (+ i 1)))))

(defn ta-eq-chain (n i)
  (if (>= i n)
    (ta-blit true)
    (Expr (EIf (Expr (EApply "==" (ta-l2 (ta-id (ta-eq-var "_eqx" i)) (ta-id (ta-eq-var "_eqy" i)))))
               (ta-eq-chain n (+ i 1))
               (ta-blit false)))))

; --- driver -------------------------------------------------------------------

(defn ta-register-fields (st exprs)
  (match exprs
    (Nil 0)
    (Cons e rest
      (begin
        (match (Expr.inner e)
          (EDeftype name variants _ sm
            (if (ta-is-struct sm) (ta-register-struct st name variants) 0))
          (_ 0))
        (ta-register-fields st rest)))))

; Keyed by short name, because the name at the definition (a canonical key,
; zyl/std@5::collections/intmap::IntMap) is not the name the type carries
; where it is used. Two modules with a struct of the same name therefore
; share an answer here, which is the same ambiguity `len` has and no worse.
(defn ta-register-struct (st name variants)
  (let _ (ffi-call "zyl_smap_put" ta-structs (ta-short name) 1 1000)
    (ta-register-struct-fields st variants)))

(defn ta-register-struct-fields (st variants)
  (match variants
    (Nil 0)
    (Cons v rest
      (begin
        (ta-register-names st (AV.name v) (AV.fields v))
        (ta-register-struct-fields st rest)))))

(defn ta-register-names (st sname names)
  (match names
    (Nil 0)
    (Cons f rest
      (let old (ta-sget-or (ta-fields st) f Nil)
        (begin
          (ta-sput (ta-fields st) f (Cons sname old))
          (ta-register-names st sname rest))))))

(defn ta-top (st exprs)
  (match exprs
    (Nil 0)
    (Cons e rest
      (begin
        (match (Expr.inner e)
          (EDefn name _ _ (ta-top-fn st name))
          (ETestDecl _ body _ _ (let _ (ta-expr st -1 Nil body) 0))
          (_ 0))
        (ta-top st rest)))))

(defn ta-top-fn (st name)
  (let fi (ta-sget (ta-fnmap st) name)
    (if (> fi 0)
      (if (= (ta-wget (ta-fnstate st) (- fi 1)) 0) (ta-visit st (- fi 1)) 0)
      0)))

; Entry point: annotate every node of the program.
; Returns the specialized instances to append to the program.
(defn ta-annotate-program (exprs)
  (begin
    (ffi-call "zyl_ref_set" ta-report-mode (ta-report-env (ffi-call "zyl_getenv_str" "ZYL_STRICT_TYPES" 1000)) 1000)
    (ffi-call "zyl_ref_set" ta-error-count 0 1000)
    (ffi-call "zyl_ref_set" ta-cur-node (ta-no-node) 1000)
    (ffi-call "zyl_ref_set" ta-list-head 0 1000)
    (ffi-call "zyl_ref_set" ta-in-main 0 1000)
    (ffi-call "zyl_smap_clear" ta-unbound-seen 1000)
    (ffi-call "zyl_wvec_truncate" ta-unbound-pending 0 1000)
    (ffi-call "zyl_wvec_truncate" ta-ctor-names 0 1000)
    (ffi-call "zyl_wvec_truncate" ta-num-note-store 0 1000)
    (node-tables-clear)
    (ffi-call "zyl_wvec_truncate" ta-var-store 0 1000)
    (ffi-call "zyl_smap_clear" ta-impl-table 1000)
    (ffi-call "zyl_smap_clear" ta-name-table 1000)
    (ffi-call "zyl_smap_clear" ta-eqv-table 1000)
    (ffi-call "zyl_smap_clear" ta-alias-table 1000)
    (ffi-call "zyl_smap_clear" ta-aliases 1000)
    (ffi-call "zyl_smap_clear" ta-structs 1000)
    (ffi-call "zyl_ref_set" ta-alias-depth 0 1000)
    (ta-collect-aliases exprs)
    (ffi-call "zyl_smap_clear" ta-mcount-table 1000)
    (ffi-call "zyl_smap_clear" ta-mname-table 1000)
    (let st (ta-st-new)
      (begin
        (ta-collect-a st exprs)
        (ta-collect-b st exprs)
        (ta-collect-c st exprs)
        (ta-check-aliases st exprs)
        (ta-register-fields st exprs)
        (ta-top st exprs)
        (ta-resolve-specials st (Cons -1 Nil) 0)
        (ta-check-num st 0 (ffi-call "zyl_wvec_len" (ta-num-notes) 1000))
        (ta-check-main st)
        (ta-flush-unbound)
        (ta-fail-if-errors)
        (ffi-call "zyl_smap_clear" ta-generic-names 1000)
        (ta-record-generic st 0 (ta-wlen (ta-fnstate st)))
        (ta-extra-list st 0 (ta-wlen (ta-extra st)))))))

; `main` takes nothing and returns the process's Int exit status; a body
; of another type is reported at its last expression, not at the defn.
(defn ta-check-main (st)
  (let fi (ta-sget (ta-fnmap st) "main")
    (if (> fi 0)
      (let e (ta-wget (ta-fnexp st) (- fi 1))
        (match (ta-resolve st (ta-inst st (ta-wget (ta-fnsc st) (- fi 1))))
          (TaF ps r
            (match ps
              (Nil (ta-check-main-result st (ta-last-expr (ta-defn-body e)) r))
              (_ (ta-seq (ta-type-error "E_TYPE_MISMATCH" "main takes no parameters" e Nil "write `(defn main () ...)`") 0))))
          (_ 0)))
      0)))

(defn ta-check-main-result (st last r)
  (if (ta-clash st (ta-int) r)
    (ta-main-mismatch st last r)
    (let _ (ffi-call "zyl_ref_set" ta-in-main 1 1000)
      (let ok (ta-unify-at st last r (ta-int))
        (let _ (ffi-call "zyl_ref_set" ta-in-main 0 1000) ok)))))

; Reported at main's last expression, with the fix.
(defn ta-main-mismatch (st node r)
  (ta-seq (ta-type-error "E_TYPE_MISMATCH"
            (str-concat "main must return the exit status, an Int, but this is `" (str-concat (ta-pretty st r) "`"))
            node Nil "end its body with `0`")
          0))

(defn ta-defn-body (e)
  (match (Expr.inner e) (EDefn _ _ body body) (_ e)))

; The expression whose value a body returns: through let bodies and begins.
(defn ta-last-expr (e)
  (match (Expr.inner e)
    (ELet _ _ body (ta-last-expr body))
    (ELetMut _ _ body (ta-last-expr body))
    (EBegin xs (match xs (Nil e) (_ (ta-last-expr (ta-last xs e)))))
    (_ e)))

(defn ta-report-env (v) (or (ta-streq v "report") (ta-streq v "1")))

; How many errors the pass has reported in this program.
(defn ta-errors-reported () (ffi-call "zyl_ref_get" ta-error-count 1000))

; The closing line (docs/diagnostics.md, 8): a count, no code, no lecture.
(defn ta-summary-text (n)
  (if (= n 1) "1 error" (str-concat (ffi-call "zyl_int_text" n 1000) " errors; fix the first one first")))

; Is `msg` the closing line this pass raised? The driver prints it plain.
(defn ta-summary-p (msg)
  (let n (ta-errors-reported)
    (if (> n 0) (ta-streq msg (ta-summary-text n)) false)))

; Every error was reported where it is; the compile ends with the count.
(defn ta-fail-if-errors ()
  (let n (ta-errors-reported)
    (if (> n 0) (ffi-call "zyl_panic" (ta-summary-text n) 1000) unit)))

; Codegen kind of an annotated Expr: 1 String, 2 Float, else 0.
(defn ta-kind (e)
  (let t (ta-attr e)
    (if (ta-no-type-p t) 0 (ta-kind-of-ty (ta-gresolve ta-var-store t)))))

(defn ta-gresolve (vars t)
  (match t
    (TaV i
      (if (< i 0)
        t
        (match (ffi-call "zyl_wvec_get" vars i 1000)
          (TbTy b (ta-gresolve vars b))
          (_ t))))
    (_ t)))

; 1 when `e`'s type is fully known to be Int, Bool or Float: a word that
; is never a pointer (region inference keeps such values out of object
; classes). A type variable, poisoned or not, is not scalar.
; 1 when `e`'s type is a type the program declared (deftype, defstruct):
; its value is a heap block with a size header (compiler/reuse.zyl).
(defn ta-adt (e)
  (let t (ta-attr e)
    (if (ta-no-type-p t)
      false
      (match (ta-gresolve ta-var-store t)
        (TaC n _
          (not (or (ta-builtin-type n) (or (ta-handle-param-type n) (or (ta-streq n "Secret") (= (str-length n) 0))))))
        (_ false)))))

(defn ta-scalar (e)
  (let t (ta-attr e)
    (if (ta-no-type-p t)
      false
      (match (ta-gresolve ta-var-store t)
        (TaC n args
          (if (is-nil args)
            (if (or (ta-streq n "Int") (or (ta-streq n "Bool") (ta-streq n "Float"))) true false)
            false))
        (_ false)))))

(defn ta-kind-of-ty (t)
  (match t
    (TaC n _ (if (ta-streq n "String") 1 (if (ta-streq n "Float") 2 0)))
    (_ 0)))

; The program with its specialized instances appended and the generic
; originals of trait-generic functions removed: every call and value use
; of one was renamed to an instance, so an original could only be reached
; through an unresolved use, which then fails as an undefined function
; instead of running a guessed impl.
(defn ta-annotate (exprs)
  (let extra (ta-annotate-program exprs)
    (list-append (ta-drop-generic exprs) extra)))

(def ta-generic-names (ffi-call "zyl_smap_new" 1000))

(defn ta-drop-generic (exprs)
  (match exprs
    (Nil Nil)
    (Cons e rest
      (match (Expr.inner e)
        (EDefn name _ _
          (if (ffi-call "zyl_smap_has" ta-generic-names name 1000)
            (ta-drop-generic rest)
            (Cons e (ta-drop-generic rest))))
        (_ (Cons e (ta-drop-generic rest)))))))

(defn ta-record-generic (st i n)
  (if (>= i n)
    unit
    (begin
      (if (and (> (ta-wget (ta-fntg st) i) 0) (ta-fn-original st i))
        (ffi-call "zyl_smap_put" ta-generic-names (ta-fn-name st i) 1 1000)
        unit)
      (ta-record-generic st (+ i 1) n))))

; Instances are named `f~types`; only originals are dropped.
(defn ta-fn-original (st i)
  (not (ta-has-tilde (ta-fn-name st i) 0)))

(defn ta-has-tilde (s i)
  (if (>= i (str-length s)) false (if (= (ffi-call "zyl_cstr_byte_at" s i 1000) 126) true (ta-has-tilde s (+ i 1)))))

; --- debugging (ZYL_DEBUG_TYPES=1 prints every function's scheme) -------------

(defn ta-debug-scheme (st m t)
  (let flag (ffi-call "zyl_getenv_str" "ZYL_DEBUG_TYPES" 1000)
    (if (= (str-length flag) 0)
      unit
      (match (Expr.inner (ta-wget (ta-fnexp st) m))
        (EDefn name _ _
          (let l1 (str-concat name " : ")
            (ffi-call "zyl_warn_emit" (str-concat l1 (ta-show st t)) 1000)))
        (_ unit)))))

(defn ta-show (st t)
  (match (ta-resolve st t)
    (TaV i (if (< i 0) (str-concat "'" (ffi-call "zyl_int_text" (- 0 i) 1000))
             (if (ta-poisoned st i) "!" (str-concat "?" (ffi-call "zyl_int_text" i 1000)))))
    (TaC n args (match args (Nil (ta-short n)) (_ (str-concat (str-concat "(" (ta-short n)) (str-concat (ta-show-list st args) ")")))))
    (TaF ps r (str-concat (str-concat "(" (ta-show-list st ps)) (str-concat " -> " (str-concat (ta-show st r) ")"))))))

(defn ta-show-list (st ts)
  (match ts
    (Nil "")
    (Cons h t (str-concat " " (str-concat (ta-show st h) (ta-show-list st t))))))

; --- deep copy (a specialized clone needs its own nodes) ----------------------

(defn ta-copy (e)
  (let out (ta-copy-node e)
    (let _ (ffi-call "zyl_span_copy" out e 1000)
      out)))

(defn ta-copy-node (e)
  (match (Expr.inner e)
    (EAtom a (Expr (EAtom a)))
    (ECall x0 x1 (Expr (ECall (ta-copy x0) (ta-copy-list x1))))
    (EDef x0 x1 (Expr (EDef x0 (ta-copy x1))))
    (EDefn x0 x1 x2 (Expr (EDefn x0 (ta-copy-params x1) (ta-copy x2))))
    (ELet x0 x1 x2 (Expr (ELet x0 (ta-copy x1) (ta-copy x2))))
    (ELetMut x0 x1 x2 (Expr (ELetMut x0 (ta-copy x1) (ta-copy x2))))
    (EIf x0 x1 x2 (Expr (EIf (ta-copy x0) (ta-copy x1) (ta-copy x2))))
    (ETryCatch x0 x1 x2 (Expr (ETryCatch (ta-copy x0) x1 (ta-copy x2))))
    (EMatch x0 x1 (Expr (EMatch (ta-copy x0) (ta-copy-arms x1))))
    (ESpawn x0 (Expr (ESpawn (ta-copy x0))))
    (ESend x0 x1 (Expr (ESend (ta-copy x0) (ta-copy x1))))
    (ESendClosure x0 x1 x2 (Expr (ESendClosure (ta-copy x0) (ta-copy x1) x2)))
    (EFfiCall x0 x1 x2 (Expr (EFfiCall x0 (ta-copy-list x1) x2)))
    (EFfiPin x0 (Expr (EFfiPin (ta-copy x0))))
    (EFfiUnpin x0 (Expr (EFfiUnpin (ta-copy x0))))
    (EAssert x0 x1 (Expr (EAssert (ta-copy x0) x1)))
    (EUnwrap x0 (Expr (EUnwrap (ta-copy x0))))
    (EWhile x0 x1 (Expr (EWhile (ta-copy x0) (ta-copy x1))))
    (EFor x0 x1 x2 (Expr (EFor (ta-copy-for x0) (ta-copy x1) (ta-copy x2))))
    (ECond x0 (Expr (ECond (ta-copy-cond x0))))
    (EBegin x0 (Expr (EBegin (ta-copy-list x0))))
    (ELambda x0 x1 x2 (Expr (ELambda x0 (ta-copy-params x1) (ta-copy x2))))
    (EFn x0 x1 x2 (Expr (EFn x0 (ta-copy-params x1) (ta-copy x2))))
    (EStructGet x0 x1 (Expr (EStructGet (ta-copy x0) x1)))
    (EMakeStruct x0 x1 (Expr (EMakeStruct x0 (ta-copy-list x1))))
    (EMakeVariant x0 x1 x2 (Expr (EMakeVariant x0 x1 (ta-copy-list x2))))
    (ESetBang x0 x1 (Expr (ESetBang x0 (ta-copy x1))))
    (EPrint x0 (Expr (EPrint (ta-copy-list x0))))
    (EExit x0 (Expr (EExit (ta-copy x0))))
    (EClose x0 (Expr (EClose (ta-copy x0))))
    (EFileOpen x0 x1 (Expr (EFileOpen (ta-copy x0) (ta-copy x1))))
    (EFileRead x0 x1 (Expr (EFileRead (ta-copy x0) (ta-copy x1))))
    (EFileWrite x0 x1 (Expr (EFileWrite (ta-copy x0) (ta-copy x1))))
    (EFileClose x0 (Expr (EFileClose (ta-copy x0))))
    (EBufAppend x0 x1 (Expr (EBufAppend (ta-copy x0) (ta-copy x1))))
    (EAssertEqual x0 x1 (Expr (EAssertEqual (ta-copy x0) (ta-copy x1))))
    (EAssertTrue x0 x1 (Expr (EAssertTrue (ta-copy x0) x1)))
    (EAssertFalse x0 x1 (Expr (EAssertFalse (ta-copy x0) x1)))
    (EApply x0 x1 (Expr (EApply x0 (ta-copy-list x1))))
    (EUnknown x0 x1 (Expr (EUnknown x0 (ta-copy-list x1))))
    (ELoadByte x0 x1 x2 (Expr (ELoadByte x0 (ta-copy x1) (ta-copy x2))))
    (ELoadByteSigned x0 x1 x2 (Expr (ELoadByteSigned x0 (ta-copy x1) (ta-copy x2))))
    (EStoreByte x0 x1 x2 x3 (Expr (EStoreByte x0 (ta-copy x1) (ta-copy x2) (ta-copy x3))))
    (EStoreByteSigned x0 x1 x2 x3 (Expr (EStoreByteSigned x0 (ta-copy x1) (ta-copy x2) (ta-copy x3))))
    (EByteSlice x0 x1 x2 (Expr (EByteSlice (ta-copy x0) (ta-copy x1) (ta-copy x2))))
    (EByteSliceSub x0 x1 x2 (Expr (EByteSliceSub (ta-copy x0) (ta-copy x1) (ta-copy x2))))
    (EByteBufAppend x0 x1 (Expr (EByteBufAppend (ta-copy x0) (ta-copy x1))))
    (EByteBufLen x0 (Expr (EByteBufLen (ta-copy x0))))
    (EByteBufCap x0 (Expr (EByteBufCap (ta-copy x0))))
    (EByteBufPtr x0 (Expr (EByteBufPtr (ta-copy x0))))
    (EAlignCheck x0 x1 (Expr (EAlignCheck (ta-copy x0) x1)))
    (EAtomicLoad x0 x1 (Expr (EAtomicLoad (ta-copy x0) (ta-copy x1))))
    (EAtomicStore x0 x1 x2 (Expr (EAtomicStore (ta-copy x0) (ta-copy x1) (ta-copy x2))))
    (EAtomicAdd x0 x1 x2 (Expr (EAtomicAdd (ta-copy x0) (ta-copy x1) (ta-copy x2))))
    (EAtomicSub x0 x1 x2 (Expr (EAtomicSub (ta-copy x0) (ta-copy x1) (ta-copy x2))))
    (EAtomicCAS x0 x1 x2 x3 (Expr (EAtomicCAS (ta-copy x0) (ta-copy x1) (ta-copy x2) (ta-copy x3))))
    (EAtomicFetchAdd x0 x1 x2 (Expr (EAtomicFetchAdd (ta-copy x0) (ta-copy x1) (ta-copy x2))))
    (EAtomicMax x0 x1 x2 (Expr (EAtomicMax (ta-copy x0) (ta-copy x1) (ta-copy x2))))
    (EAtomicMin x0 x1 x2 (Expr (EAtomicMin (ta-copy x0) (ta-copy x1) (ta-copy x2))))
    (_ e)))

(defn ta-copy-list (xs)
  (match xs
    (Nil Nil)
    (Cons h t (Cons (ta-copy h) (ta-copy-list t)))))

(defn ta-copy-params (ps)
  (match ps
    (Nil Nil)
    (Cons p t
      (let q (match p (P n ty (P n ty)))
        (let _ (ffi-call "zyl_span_copy" q p 1000)
          (Cons q (ta-copy-params t)))))))

(defn ta-copy-arms (arms)
  (match arms
    (Nil Nil)
    (Cons a t
      (match a
        (MA v pats body (Cons (MA v (ta-copy-list pats) (ta-copy body)) (ta-copy-arms t)))))))

(defn ta-copy-for (bs)
  (match bs
    (Nil Nil)
    (Cons pr t
      (match pr
        (Pair n vo (Cons (Pair n (match vo (Some v (Some (ta-copy v))) (None None))) (ta-copy-for t)))))))

(defn ta-copy-cond (cs)
  (match cs
    (Nil Nil)
    (Cons pr t
      (match pr
        (Pair c b (Cons (Pair (ta-copy c) (ta-copy b)) (ta-copy-cond t)))))))

; --- trait resolution and specialization --------------------------------------
; Entry status: 0 nothing to do, 1 act now (concrete), 2 generic (owner
; must be specialized per call site).

(defn ta-take-specials (st from)
  (let sv (ta-special st)
    (let es (ta-take-loop sv from (ta-wlen sv))
      (let _ (ffi-call "zyl_wvec_truncate" sv from 1000)
        es))))

(defn ta-take-loop (sv i n)
  (if (>= i n) Nil (Cons (ta-wget sv i) (ta-take-loop sv (+ i 1) n))))

(defn ta-resolve-specials (st members from)
  (let es (ta-take-specials st from)
    (begin
      (ta-pre-unify st members es)
      (ta-default-locals st es (ta-member-vars st members Nil))
      (ta-tg-fix st es)
      (ta-act-list st members es))))

;; Resolvable trait calls take their impl's type before defaulting (return types the trait left open).
(defn ta-pre-unify (st members es)
  (match es
    (Nil 0)
    (Cons sp rest
      (begin
        (match sp
          (TaSp _ _ kind name t _
            (if (and (= kind 0) (= (ta-sp-status st sp) 1))
              (match (ta-recv st t)
                (TaC n _ (ta-unify-fn st members (ta-impl-fn st name n) t))
                (_ 0))
              0)))
        (ta-pre-unify st members rest)))))

; A variable in a use's type that no member's signature mentions can never
; be fixed by a caller (e.g. E in `(Ok "yes")`): default it to Int.
(defn ta-member-vars (st members acc)
  (match members
    (Nil acc)
    (Cons m rest
      (if (< m 0)
        (ta-member-vars st rest acc)
        (ta-member-vars st rest (ta-vars-of st (ta-wget (ta-fnty st) m) acc))))))

(defn ta-vars-of (st t acc)
  (match (ta-resolve st t)
    (TaV i (if (< i 0) acc (if (ta-poisoned st i) acc (Cons i acc))))
    (TaC _ args (ta-vars-of-list st args acc))
    (TaF ps r (ta-vars-of-list st (Cons r ps) acc))))

(defn ta-vars-of-list (st ts acc)
  (match ts
    (Nil acc)
    (Cons h t (ta-vars-of-list st t (ta-vars-of st h acc)))))

(defn ta-default-locals (st es keep)
  (match es
    (Nil 0)
    (Cons sp rest
      (match sp
        (TaSp _ node kind name t _
          (begin
            ; A trait call's receiver is never defaulted: the impl would
            ; be a guess.
            (if (= kind 0)
              (match (ta-recv st t)
                (TaV i (if (or (< i 0) (ta-int-in i keep)) unit
                         (ta-type-error "E_CANNOT_INFER"
                           (str-concat "cannot tell which impl of `" (str-concat (err-name name) "` to call: the receiver's type is not known"))
                           node Nil "give the receiver a type annotation")))
                (_ unit))
              unit)
            (ta-default-list st (ta-vars-of st t Nil) keep)
            (ta-default-locals st rest keep)))))))

(defn ta-default-list (st vs keep)
  (match vs
    (Nil 0)
    (Cons v rest
      (begin
        (if (ta-int-in v keep) 0 (ta-unify st (TaV v) (ta-int)))
        (ta-default-list st rest keep)))))

(defn ta-tg-fix (st es)
  (if (> (ta-tg-pass st es 0) 0) (ta-tg-fix st es) 0))

(defn ta-tg-pass (st es changed)
  (match es
    (Nil changed)
    (Cons sp rest
      (match sp
        (TaSp c _ _ _ _ _
          (if (< c 0)
            (ta-tg-pass st rest changed)
            (if (> (ta-wget (ta-fntg st) c) 0)
              (ta-tg-pass st rest changed)
              (if (= (ta-sp-status st sp) 2)
                (ta-seq (ta-wset (ta-fntg st) c 1) (ta-tg-pass st rest 1))
                (ta-tg-pass st rest changed)))))))))

(defn ta-sp-status (st sp)
  (match sp
    (TaSp _ _ kind name t fi
      (if (= kind 1)
        (ta-fn-status st fi t)
        (if (= kind 0)
          (ta-trait-status st name t)
          (if (= kind 4)
            (ta-open-var st (ta-resolve st t))
            (if (= kind 5)
              (ta-eq-status st t)
              (ta-print-status st t))))))))

; Only the arguments decide an instance.
(defn ta-args-of (t)
  (match t
    (TaF ps _ ps)
    (_ (Cons t Nil))))

; 1 concrete, 0 has an unbound variable, -1 poisoned.
(defn ta-conc (st t)
  (match (ta-resolve st t)
    (TaV i (if (< i 0) 0 (if (ta-poisoned st i) -1 0)))
    (TaC _ args (ta-conc-list st args 1))
    (TaF ps r (ta-conc-list st (Cons r ps) 1))))

(defn ta-conc-list (st ts acc)
  (match ts
    (Nil acc)
    (Cons h t
      (let c (ta-conc st h)
        (if (< c 0) -1 (ta-conc-list st t (if (= c 0) 0 acc)))))))

(defn ta-args-status (st ct)
  (let c (ta-conc-list st (ta-args-of ct) 1)
    (if (= c 1) 1 (if (= c 0) 2 0))))

(defn ta-fn-status (st fi ct)
  (if (= (ta-wget (ta-fntg st) fi) 0) 0 (ta-args-status st ct)))

; A resolved impl is always renamed; a trait-generic one may also need an instance.
(defn ta-impl-status (st fi ct)
  (if (= (ta-wget (ta-fntg st) fi) 0)
    1
    (let s (ta-args-status st ct)
      (if (= s 2) 2 1))))

(defn ta-recv (st ct)
  (match ct
    (TaF ps _ (match ps (Cons h _ (ta-resolve st h)) (Nil (ta-poisoned-var st))))
    (_ (ta-resolve st ct))))

(defn ta-impl-fn (st dotted n)
  (let fi (ta-sget (ta-fnmap st) (str-concat dotted (str-concat "_" n)))
    (- fi 1)))

(defn ta-open-var (st t)
  (match t
    (TaV i (if (< i 0) 0 (if (ta-poisoned st i) 0 2)))
    (_ 0)))

(defn ta-trait-status (st name ct)
  (let r (ta-recv st ct)
    (match r
      (TaC n _
        (let fi (ta-impl-fn st name n)
          (if (< fi 0) 0 (ta-impl-status st fi ct))))
      (_ (ta-open-var st r)))))

(defn ta-prim (n)
  (if (ta-builtin-type n) true false))

(defn ta-show-ct (t) (TaF (Cons t Nil) (ta-str)))

(defn ta-print-status (st t)
  (let r (ta-resolve st t)
    (match r
      (TaC n args
        (if (ta-prim n)
          0
          (let sd (ta-sget-or ta-name-table "!show" "")
            (if (= (str-length sd) 0)
              0
              (let fi (ta-impl-fn st sd n)
                (if (< fi 0) 0
                  (if (ta-showable-list st args) (ta-impl-status st fi (ta-show-ct r)) 0)))))))
      (_ (ta-open-var st r)))))

; Every type argument has Show too; else the impl's inner Show.show has no target.
(defn ta-showable (st t)
  (match (ta-resolve st t)
    (TaC n args
      (if (ta-prim n)
        (ta-show-prim n)
        (let sd (ta-sget-or ta-name-table "!show" "")
          (if (= (str-length sd) 0) false
            (if (< (ta-impl-fn st sd n) 0) false (ta-showable-list st args))))))
    (TaF _ _ false)
    (TaV _ true)))

(defn ta-showable-list (st ts)
  (match ts
    (Nil true)
    (Cons h rest (if (ta-showable st h) (ta-showable-list st rest) false))))

(defn ta-act-list (st members es)
  (match es
    (Nil unit)
    (Cons sp rest
      (begin
        (let s (ta-sp-status st sp)
          (if (= s 1) (ta-act st members sp) (if (= s 0) (ta-check-no-impl st sp) unit)))
        (ta-act-list st members rest)))))

; A trait call on a concrete receiver type with no impl has no target.
(defn ta-check-no-impl (st sp)
  (match sp
    (TaSp _ node kind name t _
      (if (= kind 0)
        (match (ta-recv st t)
          (TaC n _
            (if (< (ta-impl-fn st name n) 0)
              (let _ (ta-method-fail node (str-concat "no impl of `" (str-concat (err-name name) (str-concat "` for type `" (str-concat (err-name n) "`"))))
                       (str-concat "add (impl " (str-concat (err-name (ta-trait-of name)) (str-concat " " (str-concat (err-name n) " ...)")))))
                unit)
              unit))
          (_ unit))
        unit))))

; `Trait` of a dotted trait-method name `Trait.method`.
(defn ta-trait-of (dotted)
  (let i (ta-last-dot dotted (- (str-length dotted) 1))
    (if (< i 0) dotted (str-substring dotted 0 i))))

(defn ta-last-dot (s i)
  (if (< i 0) -1 (if (= (ffi-call "zyl_cstr_byte_at" s i 1000) 46) i (ta-last-dot s (- i 1)))))

(defn ta-act (st members sp)
  (match sp
    (TaSp _ node kind name t fi
      (if (= kind 1)
        (ta-set-name node 2 (ta-specialize st fi t))
        (if (= kind 0)
          (let r (ta-recv st t)
            (match r
              (TaC n _ (ta-set-name node 2 (ta-impl-target st members (ta-impl-fn st name n) t)))
              (_ unit)))
          (if (= kind 5)
            (match (ta-recv st t)
              (TaC n _ (ta-set-name node 2 (ta-impl-target st members (ta-eq-fn st n) t)))
              (_ unit))
          (let r (ta-resolve st t)
            (match r
              (TaC n _
                (ta-set-name node 3
                  (ta-impl-target st members (ta-impl-fn st (ta-sget-or ta-name-table "!show" "") n) (ta-show-ct r))))
              (_ unit)))))))))

; Table 2: the call's new target; 3: the print argument's Show function.
(defn ta-set-name (node tbl name)
  (ffi-call "zyl_attrh_set" (if (= tbl 2) node-calls node-shows) node name 1000))

; Unify the impl's type with the use, then pick it or an instance of it.
(defn ta-impl-target (st members fi ct)
  (let _ (ta-unify-fn st members fi ct)
    (if (and (> (ta-wget (ta-fntg st) fi) 0) (= (ta-args-status st ct) 1))
      (ta-specialize st fi ct)
      (ta-fn-name st fi))))

(defn ta-unify-fn (st members fi ct)
  (let s0 (ta-wget (ta-fnstate st) fi)
    (let _ (if (= s0 0) (ta-visit st fi) 0)
      (let s (ta-wget (ta-fnstate st) fi)
        (if (= s 2)
          (ta-unify st (ta-inst st (ta-wget (ta-fnsc st) fi)) ct)
          (if (ta-int-in fi members) (ta-unify st (ta-wget (ta-fnty st) fi) ct) 0))))))

(defn ta-fn-name (st fi)
  (match (Expr.inner (ta-wget (ta-fnexp st) fi))
    (EDefn name _ _ name)
    (_ "")))

; One instance per (function, argument types); capped per function.
(defn ta-specialize (st fi ct)
  (let key (str-concat (ta-fn-name st fi) (str-concat "~" (ta-canon-list st (ta-args-of ct))))
    (if (> (ta-sget (ta-specs st) key) 0)
      key
      (let used (ta-wget (ta-fnspecs st) fi)
        (if (> used 255)
          (ta-spec-limit st fi)
          (let _ (ta-wset (ta-fnspecs st) fi (+ used 1))
            (let _ (ta-sput (ta-specs st) key 1)
              (ta-make-instance st fi key ct))))))))

; A function that needs more than 256 instances is almost always
; polymorphic recursion whose argument types grow without end.
(defn ta-spec-limit (st fi)
  (let _ (ta-type-error "E_CANNOT_INFER"
           (str-concat "`" (str-concat (err-name (ta-fn-name st fi)) "` would need more than 256 specialized instances"))
           (ffi-call "zyl_ref_get" ta-cur-node 1000) Nil
           "a trait-generic function calling itself at an ever larger type cannot be specialized; give the recursion a fixed type")
    (ta-fn-name st fi)))

(defn ta-make-instance (st fi key ct)
  (let clone (ta-copy-defn (ta-wget (ta-fnexp st) fi) key)
    (let ci (ta-add-fn st key clone)
      (begin
        (ta-wset (ta-fninst st) ci ct)
        (ta-wpush (ta-extra st) clone)
        (ta-visit st ci)
        key))))

(defn ta-copy-defn (e name)
  (match (Expr.inner e)
    (EDefn _ params body
      (let out (Expr (EDefn name (ta-copy-params params) (ta-copy body)))
        (let _ (ffi-call "zyl_span_copy" out e 1000)
          out)))
    (_ e)))

(defn ta-canon (st t)
  (match (ta-resolve st t)
    (TaV _ "?")
    (TaC n args (match args (Nil n) (_ (str-concat n (str-concat "<" (str-concat (ta-canon-list st args) ">"))))))
    (TaF ps r (str-concat "fn<" (str-concat (ta-canon-list st ps) (str-concat ">" (ta-canon st r)))))))

(defn ta-canon-list (st ts)
  (match ts
    (Nil "")
    (Cons h t
      (let a (ta-canon st h)
        (match t (Nil a) (_ (str-concat a (str-concat "," (ta-canon-list st t)))))))))

(defn ta-extra-list (st i n)
  (if (>= i n) Nil (Cons (ta-wget (ta-extra st) i) (ta-extra-list st (+ i 1) n))))

; Renamed call target (table 2) / Show function for a print argument (table 3).
(defn ta-renamed (e) (ffi-call "zyl_attrh_get_or" node-calls e "" 1000))
(defn ta-print-show (e) (ffi-call "zyl_attrh_get_or" node-shows e "" 1000))

; --- readable types (REPL :type, diagnostics) ---------------------------------

(defn ta-pretty (st t)
  (match (ta-resolve st t)
    (TaV i (if (< i 0) (ta-slot-name (- 0 (+ i 1))) (if (ta-poisoned st i) "?" "a")))
    (TaC n args (match args (Nil (ta-short n)) (_ (str-concat "(" (str-concat (ta-short n) (str-concat " " (str-concat (ta-pretty-list st args) ")")))))))
    (TaF ps r (str-concat "(" (str-concat (ta-pretty-list st ps) (str-concat " -> " (str-concat (ta-pretty st r) ")")))))))

(defn ta-pretty-list (st ts)
  (match ts
    (Nil "")
    (Cons h t (match t (Nil (ta-pretty st h)) (_ (str-concat (ta-pretty st h) (str-concat " " (ta-pretty-list st t))))))))

(defn ta-slot-name (k)
  (if (= k 0) "a" (if (= k 1) "b" (if (= k 2) "c" (if (= k 3) "d" (str-concat "t" (ffi-call "zyl_int_text" k 1000)))))))

; The inferred type of `node` after annotating `exprs` (REPL `:type`).
(defn ta-type-text (exprs node)
  (let _ (ta-annotate-program exprs)
    (let t (ta-attr node)
      (if (ta-no-type-p t)
        "?"
        (match (ta-gen (ta-st-new) t Nil)
          (TaGen g _ (ta-pretty (ta-st-new) g)))))))
