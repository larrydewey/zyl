; === Zyl Compiler — List head/tail helpers ===
; Module: compiler/resolver
;
; Only shd/stl (head/tail, like car/cdr) remain here; codegen.zyl depends
; on them. The name is historical: this file once held a `(use ...)`
; resolver that the boot pipeline never called, and it was removed.
; Module resolution is compiler/module_resolver.

(defn shd (xs)
  (match xs
    (Cons h _ h)
    (Nil "")))

(defn stl (xs)
  (match xs
    (Cons _ t t)
    (Nil Nil)))
