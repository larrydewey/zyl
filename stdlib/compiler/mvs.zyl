; === Zyl Standard Library — Minimal Version Selection ===
; Module: compiler/mvs
;
; Spec v5.0 §31.5:
;
;     for each package P reachable from the root:
;         selected(P) = max over all requirements R on P of version(R)
;
; Every requirement is a MINIMUM and the selection is the greatest
; minimum. There is no search, no backtracking and no solver, and three
; properties follow that a solver cannot offer:
;
;   - resolution is a pure function of the manifests in the graph; it does
;     not depend on index contents and cannot drift between machines or
;     between days;
;   - adding a dependency never silently upgrades an unrelated one;
;   - removing a dependency never silently downgrades another.
;
; Upgrades are therefore explicit: they rewrite a requirement in a
; manifest. `zyl update` edits manifests; it does not "solve" anything.
;
; Feature unification (§31.10) rides along in the same walk. Features are
; additive, so a package is compiled once with the UNION of every
; feature requested anywhere in the graph, and an optional dependency
; enters the graph exactly when its feature is in that union. Growing a
; package's feature set re-walks it, since the union may have pulled in
; dependencies that were invisible a moment ago.

(use compiler/index)
(use compiler/lock)
(use compiler/package)
(use compiler/store)
(use core/list)
(use core/option)

; ===========================================================================
; RESOLVED NODES
; ===========================================================================

; name, selected version, where it came from, its root directory, and the
; features it is compiled with.
(deftype MvsNode (MN String PkgVersion PkgSource String (List String)))

(defn mn-name (n) (match n (MN x _ _ _ _ x)))
(defn mn-version (n) (match n (MN _ v _ _ _ v)))
(defn mn-source (n) (match n (MN _ _ s _ _ s)))
(defn mn-root (n) (match n (MN _ _ _ r _ r)))
(defn mn-features (n) (match n (MN _ _ _ _ f f)))

; One pending requirement: the dependency as written, plus the root
; directory of the package that wrote it, since a path dependency is
; relative to its requirer.
(deftype MvsReq (MR PkgDep String))

(defn mr2-dep (r) (match r (MR d _ d)))
(defn mr2-from (r) (match r (MR _ f f)))

; How to reach package sources: the index directory, whether fetching is
; allowed (only `zyl fetch`/`zyl update` pass 1 — a build is offline by
; §31.7), the lock to take recorded hashes from, and the root package's
; overrides.
(deftype MvsCtx (MC String Int (List LockPkg) (List PkgOverride)))

(defn mc-index (c) (match c (MC i _ _ _ i)))
(defn mc-online (c) (match c (MC _ o _ _ o)))
(defn mc-locked (c) (match c (MC _ _ l _ l)))
(defn mc-overrides (c) (match c (MC _ _ _ o o)))

; ===========================================================================
; SELECTION TABLE
; ===========================================================================

(defn mvs-find (nodes name)
  (match nodes
    (Nil None)
    (Cons h t (if (str-eq (mn-name h) name) (Some h) (mvs-find t name)))))

(defn mvs-replace (nodes node)
  (match nodes
    (Nil (Cons node Nil))
    (Cons h t
      (if (str-eq (mn-name h) (mn-name node))
        (Cons node t)
        (Cons h (mvs-replace t node))))))

; Two requirements on one name whose majors differ cannot both be met:
; distinct majors are distinct packages by §31.1, spelled with a /vN
; segment, so the same name carrying two majors is a manifest error
; rather than something to resolve.
(defn mvs-check-unit (arena name a b)
  (if (= (pv-compat-unit a) (pv-compat-unit b))
    1
    (ffi-call "zyl_panic"
      (str-concat "E_PKG_VERSION_CONFLICT: package: requirement on " (str-concat name
        (str-concat " cannot be satisfied within one compatibility unit: "
          (str-concat (pv-str arena a) (str-concat " vs " (pv-str arena b)))))) 1000)))

; ===========================================================================
; SOURCES
; ===========================================================================

; A root package MAY override any selection graph-wide (§31.5). An
; override never propagates from a dependency — only the root's (or the
; workspace's) overrides are consulted, which is why this takes the
; context's list rather than the current manifest's.
(defn mvs-override (ctx dep)
  (mvs-find-override (mc-overrides ctx) (pd-name dep)))

(defn mvs-find-override (overrides name)
  (match overrides
    (Nil None)
    (Cons h t (if (str-eq (pov-name h) name) (Some h) (mvs-find-override t name)))))

(defn mvs-apply-override (dep o)
  (match (pov-source o)
    (PSPath p (PD (pd-name dep) (pd-version dep) (pd-features dep) (PSPath p)))
    (PSGit u r (PD (pd-name dep) (pd-version dep) (pd-features dep) (PSGit u r)))
    (PSRegistry (mvs-override-version dep o))))

(defn mvs-override-version (dep o)
  (if (= (pv-major (pov-version o)) 0)
    (if (= (pv-minor (pov-version o)) 0)
      (if (= (pv-patch (pov-version o)) 0) dep (mvs-pinned dep o))
      (mvs-pinned dep o))
    (mvs-pinned dep o)))

(defn mvs-pinned (dep o)
  (PD (pd-name dep) (pov-version o) (pd-features dep) (pd-source dep)))

(defn mvs-resolve-dep (ctx dep)
  (match (mvs-override ctx dep)
    (Some o (mvs-apply-override dep o))
    (None dep)))

; Where a dependency's source lives. A path dependency is relative to the
; package that declared it; everything else lives in the content store,
; found by the hash the lock records (offline) or the index gives (during
; a fetch).
(defn mvs-root-of (arena ctx dep from)
  (match (pd-source dep)
    (PSPath p (str-concat from (str-concat "/" p)))
    (PSGit u r (mvs-git-root arena ctx dep u r))
    (PSRegistry (mvs-store-root arena ctx dep))))

; A git dependency is pinned by revision and enters the store like any
; other package: cloned once, canonically archived, and thereafter known
; by the hash of that archive (§31.7). Its `.git` directory is excluded
; from the archive, so the hash describes the source and not the history
; that happened to deliver it.
(defn mvs-git-root (arena ctx dep url rev)
  (match (lk-find-in (mc-locked ctx) (pd-name dep))
    (Some lp (store-require (pd-name dep) (pv-str arena (pd-version dep)) (lp-hash lp)))
    (None
      (if (= (mc-online ctx) 0)
        (ffi-call "zyl_panic"
          (str-concat "E_PKG_NOT_IN_STORE: package: " (str-concat (pd-name dep)
            " is a git dependency that is not in the store - run zyl fetch")) 1000)
        (mvs-git-fetch arena dep url rev)))))

(defn mvs-git-fetch (arena dep url rev)
  (let work (str-concat (store-home) (str-concat "/tmp/git-" (store-flat-name (pd-name dep))))
    (let _ (store-run (str-concat "rm -rf '" (str-concat work "'")))
      (let _ (store-fetch-git url rev work)
        (let tar (store-tmp-path (pd-name dep) ".tar")
          (let hash (store-write-tar arena work tar)
            (store-install arena tar hash)))))))

(defn mvs-store-root (arena ctx dep)
  (match (lk-find-in (mc-locked ctx) (pd-name dep))
    (Some lp (store-require (pd-name dep) (pv-str arena (pd-version dep)) (lp-hash lp)))
    (None (mvs-index-root arena ctx dep))))

; No lock entry: only a fetching command may look the package up in the
; index, and only after verifying it (§31.8).
(defn mvs-index-root (arena ctx dep)
  (if (= (mc-online ctx) 0)
    (ffi-call "zyl_panic"
      (str-concat "E_PKG_NOT_IN_STORE: package: " (str-concat (pd-name dep)
        " is not in the lock or the store - run zyl fetch")) 1000)
    (mvs-fetch-dep arena ctx dep)))

(defn mvs-fetch-dep (arena ctx dep)
  (let entry (idx-read arena (mc-index ctx) (pd-name dep))
    (let iv (idx-require-version arena entry (pd-version dep))
      (let _ (idx-check-yanked arena entry iv)
        (let _ (idx-verify arena (pd-name dep) iv)
          (mvs-ensure-store arena dep iv))))))

(defn mvs-ensure-store (arena dep iv)
  (if (> (store-has (iv-hash iv)) 0)
    (store-dir (iv-hash iv))
    (let tmp (store-tmp-path (pd-name dep) ".tar.zst")
      (let _ (store-fetch-url (iv-url iv) tmp)
        (let tar (store-decompress tmp (store-tmp-path (pd-name dep) ".tar"))
          (store-install arena tar (iv-hash iv)))))))

; ===========================================================================
; THE WALK
; ===========================================================================

; The manifest a requirement actually resolves to, checked against what
; the requirement claimed: a directory whose manifest names a different
; package is a broken path dependency or a tampered store entry, and
; either way it may not enter the graph unnoticed.
(defn mvs-manifest-of (arena ctx dep from)
  (let root (mvs-root-of arena ctx dep from)
    (let m (pk-read-manifest arena (str-concat root "/zyl.pkg"))
      (let _ (mvs-check-identity arena m dep root)
        m))))

(defn mvs-check-identity (_arena m dep root)
  (if (not (str-eq (mf-name m) (pd-name dep)))
    (ffi-call "zyl_panic"
      (str-concat "E_MANIFEST_INVALID: package: " (str-concat root
        (str-concat " declares package " (str-concat (mf-name m)
          (str-concat ", required as " (pd-name dep)))))) 1000)
    (let _ (pk-check-edition (mf-edition m) (mf-name m))
      (let _ (pk-check-compiler (mf-zyl m) (mf-name m))
        (pk-check-capabilities (mf-capabilities m) (mf-name m))))))

; The features a dependency edge asks for, plus whatever the selection
; already carries: features are additive and unified across the graph
; (§31.10), so this set only ever grows.
(defn mvs-merge-features (existing wanted)
  (pk-caps-union existing wanted))

(defn mvs-features-grew (before after)
  (if (= (list-length before) (list-length after)) 0 1))

; Dependencies contributed by the features in `feats`, in manifest order.
; An optional dependency enters the graph exactly when its feature is in
; the unified set.
(defn mvs-feature-deps (m feats)
  (mvs-feature-deps-in (mf-features m) feats))

(defn mvs-feature-deps-in (features feats)
  (match features
    (Nil Nil)
    (Cons f t
      (if (> (pk-has-capability feats (pf-name f)) 0)
        (list-append (pf-deps f) (mvs-feature-deps-in t feats))
        (mvs-feature-deps-in t feats)))))

; Every feature an edge requests must be declared by the package it names
; (§31.10), or the request is a typo that would silently do nothing.
(defn mvs-check-features (m feats)
  (match feats
    (Nil 1)
    (Cons f t
      (if (> (mvs-declares-feature m f) 0)
        (mvs-check-features m t)
        (ffi-call "zyl_panic"
          (str-concat "E_PKG_FEATURE_UNKNOWN: package: feature " (str-concat f
            (str-concat " is not declared by " (mf-name m)))) 1000)))))

(defn mvs-declares-feature (m f)
  (mvs-declares-in (mf-features m) f))

(defn mvs-declares-in (features f)
  (match features
    (Nil 0)
    (Cons h t (if (str-eq (pf-name h) f) 1 (mvs-declares-in t f)))))

(defn mvs-reqs-of (m root)
  (mvs-reqs-list (mf-deps m) root))

(defn mvs-reqs-list (deps root)
  (match deps
    (Nil Nil)
    (Cons d t (Cons (MR d root) (mvs-reqs-list t root)))))

; One requirement. Either it is already covered by the selection (same or
; higher version, no new features) and contributes nothing, or it raises
; the selection and its own dependencies join the worklist.
(defn mvs-step (arena ctx nodes req)
  (let dep (mvs-resolve-dep ctx (mr2-dep req))
    (match (mvs-find nodes (pd-name dep))
      (Some cur (mvs-step-existing arena ctx nodes dep cur req))
      (None (mvs-step-new arena ctx nodes dep req)))))

(defn mvs-step-existing (arena ctx nodes dep cur req)
  (let _ (mvs-check-unit arena (pd-name dep) (mn-version cur) (pd-version dep))
    (let feats (mvs-merge-features (mn-features cur) (pd-features dep))
      (let higher (if (> (pv-cmp (pd-version dep) (mn-version cur)) 0) 1 0)
        (if (= (+ higher (mvs-features-grew (mn-features cur) feats)) 0)
          (MSel nodes Nil)
          (mvs-select arena ctx nodes dep req feats))))))

(defn mvs-step-new (arena ctx nodes dep req)
  (mvs-select arena ctx nodes dep req (pd-features dep)))

; The result of one step: the updated selection and the requirements it
; adds to the worklist.
(deftype MvsSel (MSel (List MvsNode) (List MvsReq)))

(defn msel-nodes (s) (match s (MSel n _ n)))
(defn msel-reqs (s) (match s (MSel _ r r)))

(defn mvs-select (arena ctx nodes dep req feats)
  (let m (mvs-manifest-of arena ctx dep (mr2-from req))
    (let _ (mvs-check-features m feats)
      (let root (mvs-root-of arena ctx dep (mr2-from req))
        (let version (mvs-selected-version dep m)
          (let node (MN (pd-name dep) version (pd-source dep) root feats)
            (MSel (mvs-replace nodes node)
                  (mvs-reqs-list (list-append (mf-deps m) (mvs-feature-deps m feats)) root))))))))

; The requirement names a minimum; the manifest found at that source
; names what is actually there. Under MVS the selection is the
; requirement's version — a path dependency, which has no version of its
; own to select from, contributes its manifest's version instead so that
; the lock records what was really built.
(defn mvs-selected-version (dep m)
  (match (pd-source dep)
    (PSPath p (mf-version m))
    (PSGit u r (mf-version m))
    (PSRegistry (pd-version dep))))

(defn mvs-run (arena ctx nodes reqs budget)
  (if (< budget 1)
    (ffi-call "zyl_panic" "E_PKG_CYCLE: package: dependency graph is not a DAG" 1000)
    (match reqs
      (Nil nodes)
      (Cons r rest
        (let sel (mvs-step arena ctx nodes r)
          (mvs-run arena ctx (msel-nodes sel)
                   (list-append (msel-reqs sel) rest) (- budget 1)))))))

; Resolve the whole graph reachable from `m`, whose own directory is
; `root`. dev-deps never enter a dependent's graph (§31.3); they are the
; caller's business when the caller IS the root package.
(defn mvs-resolve (arena ctx m root)
  (mvs-run arena ctx Nil (mvs-reqs-of m root) 100000))

(defn mvs-resolve-with-dev (arena ctx m root)
  (mvs-run arena ctx Nil
    (list-append (mvs-reqs-of m root) (mvs-reqs-list (mf-dev-deps m) root))
    100000))

; ===========================================================================
; CAPABILITY CLOSURE (§31.9)
; ===========================================================================
; The effective transitive closure of everything the graph may do. It is
; written to the lock, and `zyl update` reports its growth; under
; --locked, growth is E_PKG_CAPABILITY_GROWTH.

(defn mvs-closure (arena nodes acc)
  (match nodes
    (Nil (pk-caps-sorted acc))
    (Cons n t
      (mvs-closure arena t
        (pk-caps-union acc (mf-capabilities (pk-read-manifest arena (str-concat (mn-root n) "/zyl.pkg"))))))))

(defn mvs-closure-grew (before after)
  (if (> (list-length after) (list-length before)) 1 0))
