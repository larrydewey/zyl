; === Zyl Standard Library — Self-Hosting: x86_64 codegen ===
; Module: compiler/codegen
;
; Walks the recursive Icnf instruction tree (see compiler/icnf) and emits
; GAS .intel_syntax noprefix assembly text. Expression code is evaluated
; into rax (a pure stack-machine discipline): every sub-expression leaves
; its value in rax; binary operators push the left operand around the
; right operand's evaluation.
;
; Conventions:
;   - Parameters arrive in SysV registers (rdi rsi rdx rcx r8 r9) and are
;     spilled to [rbp-8*(i+1)] in the prologue.
;   - Locals (let / match bindings) get slots from a downward-growing
;     offset counter carried in the emitter state.
;   - Names are resolved through an immutable Env chain (see ast.zyl).
;   - Calls support up to 6 register arguments; argument values are pushed
;     and popped in reverse so evaluation order stays strictly
;     left-to-right (spec evaluation-order rule).
;   - Floats travel as bit patterns in rax and move to xmm0/xmm1 for SSE
;     arithmetic; print selects %d/%f/%s by the operand's kind.
;   - rbx and r12, the only callee-saved registers the emitted code
;     touches, are saved in the two lowest frame words by every
;     function's prologue and restored by its epilogue, so C callers of
;     Zyl functions keep them (cg-save-callee-saved).
;
; Emitter state is an immutable CGState threaded functionally through
; every emitter function (no mutable records, no raw cells):
;   CGState = (CGS arena buffer next-label next-slot rodata)
; Two-value results use small wrapper ADTs:
;   CGR = state + int + string  (fresh labels / slot offsets)
;   CGE = state + env           (match-binding sequences)
;
; Pattern wildcards are written `_`, which may repeat within one
; pattern. (Named dummies `d1`, `d2`, ... were used while the Rust
; bootstrap, now archived, miscompiled bare `_`.)

(use compiler/node_tables)
(use allocator/allocator)
(use compiler/ast)
(use compiler/icnf)
; shd (compiler/resolver.zyl) is called below (cg-bind-one/
; icnf-binds-slots/cg-param-env) but was never declared as a real
; dependency -- harmless for the assemble.py bundle (every `use` line
; is stripped there, and resolver.zyl is always inlined into the same
; bundle regardless), but a standalone program that `use`s
; compiler/codegen directly as a library (e.g.
; integration/selfhost-codegen.zyl) got an undefined reference to
; f_shd at link time since the module resolver had no way to know to
; pull resolver.zyl in too.
(use compiler/resolver)
(use core/list)
(use compiler/error_report)

; --- Emitter state ----------------------------------------------------------

; One rodata entry: label, payload text, kind (0 string, 1 float).
(deftype REntry (REntry String String Int))

; Known top-level function names (for fn-value references), plus each
; one's own body kind (see kind-of's ICall arm and cg-collect-one,
; below) -- 0 (int) for anything not staticaly known to be a fixed
; string/float shape.
(deftype FnName (FN String Int) FNNil)

(deftype CGState (CGS Arena StrBuf Int Int (List REntry) (List FnName)))
; fields: arena, buffer, next-label, next-slot, rodata, fn-names, fn names
; fields: arena, text buffer, next label number, next slot offset,
; known top-level function names

(deftype CGR (CGR CGState Int String))

(deftype CGE (CGE CGState Env))

; Result wrapper: state + two labels.
(deftype CGP (CGP CGState String String))

; Allocate two consecutive labels. Each match is the entire body of its
; own defn (nested matches miscompile in the current bootstrap).
(defn cg-label-pair (st)
  (cg-label-pair-2 (cg-label-new st)))

(defn cg-label-pair-2 (r1)
  (match r1
    (CGR st1 _ la (cg-label-second st1 la))))

(defn cg-label-second (st1 la)
  (match (cg-label-new st1)
    (CGR st2 _ lb (CGP st2 la lb))))

(defn no-fnnames () Nil)


; Codegen text buffer: 64MB, zero-initialized (buf-append appends at
; strlen, so the zero fill terminates every intermediate string). The
; driver checks the final length against E_CODEGEN_BUFFER_LIMIT after
; emission — overflow would otherwise corrupt the arena silently.
(defn cg-new (arena)
  (let buf (buf-new arena 67108864)
    (CGS arena buf 0 8 (no-rentries) (no-fnnames))))   ; slots 1..n

(defn cg-with-fnname (st nm kind)
  (match st
    (CGS a b n s rd fns2
      (CGS a b n s rd (Cons (FN nm kind) fns2)))))

(defn cgg-fns (st)
  (match st
    (CGS _ _ _ _ _ fns fns)))

; True when `nm` is a known top-level function name.
(defn cg-fn-known (st nm)
  (cg-fn-search (cgg-fns st) nm))

(defn cg-fn-search (fns nm)
  (if (is-nil fns)
    0
    (cg-fn-check-head (fnhead fns) (fntail fns) nm)))

; Head of a List(FnName); FNNil when empty.
(defn fnhead (xs)
  (match xs
    (Cons h d h)
    (Nil (FNNil))))

; Tail of a List(FnName); empty when empty.
(defn fntail (xs)
  (match xs
    (Cons h d d)
    (Nil Nil)))

(defn cg-fn-check-head (h t nm)
  (match h
    (FN s _ (if (str-eq s nm) 1 (cg-fn-search t nm)))
    (FNNil (cg-fn-search t nm))))

; Look up `nm`'s recorded return kind; 0 (int) if it's not a known
; top-level function name at all (matches every other "not found"
; default in this file).
(defn cg-fn-kind-search (fns nm)
  (if (is-nil fns)
    0
    (cg-fn-kind-check-head (fnhead fns) (fntail fns) nm)))

(defn cg-fn-kind-check-head (h t nm)
  (match h
    (FN s k (if (str-eq s nm) k (cg-fn-kind-search t nm)))
    (FNNil (cg-fn-kind-search t nm))))

; Empty rodata list.
(defn no-rentries () Nil)

(defn cg-buffer (st)
  (match st
    (CGS _ buf _ _ _ _ (buf-str buf))))

(defn cg-with-rodata (st entry)
  (match st
    (CGS a b n s rd fns
      (CGS a b n s (Cons entry rd) fns))))

; Bounds-checked against the fixed 64MB capacity cg-new allocates for
; `buf` (see cg-new below): the driver's own post-emission length check
; against E_CODEGEN_BUFFER_LIMIT runs AFTER cg-program returns, which is
; too late to prevent an overflowing append from already having
; scribbled past the malloc'd block during codegen (buf-append/
; zyl_str_append have no capacity awareness at all). Checking here, on
; every write, is the only point that can actually stop it.
(defn cg-emit (st s)
  (match st
    (CGS _ buf _ _ _ _
      (begin (ffi-call "zyl_str_append_capped" buf s 67108864 1000) st))))

(defn cg-emit-int (st n)
  (match st
    (CGS arena buf _ _ _ _
      (begin
        (ffi-call "zyl_str_append_capped" buf (ffi-call "zyl_cstr_from_int" arena n 1000) 67108864 1000)
        st))))

(defn cg-nl (st)
  (cg-emit st "
"))

; Fresh label .L<N>.
; Returns: CGR (advanced state; string field carries the label text).
(defn cg-label-new (st)
  (match st
    (CGS arena buf n slot rd fns
      (let lblbuf (buf-new arena 32)
        (begin
          (buf-append lblbuf ".L")
          (buf-append lblbuf (ffi-call "zyl_cstr_from_int" arena n 1000))
          (CGR (CGS arena buf (+ n 1) slot rd fns) 0 (buf-str lblbuf)))))))

; Allocate one 8-byte local slot.
; Returns: CGR (advanced state; int field carries the rbp offset, negative).
(defn cg-new-slot (st)
  (match st
    (CGS a b n off rd fns
      (CGR (CGS a b n (+ off 8) rd fns) (- off) ""))))

; ===========================================================================
; RODATA INTERNING
; ===========================================================================

; Intern a string constant; emit `lea rax, [rip+label]`.
(defn cg-string-const (st content)
  (match (cg-label-new st)
    (CGR st2 _ lbl
      (let st3 (cg-with-rodata st2 (REntry lbl content 0))
        (let st4 (cg-emit st3 "    lea rax, [rip+")
          (let st5 (cg-emit st4 lbl)
            (cg-nl (cg-emit st5 "]"))))))))

; Intern a float constant; load its bits into rax via xmm0.
(defn cg-float-const (st text)
  (match (cg-label-new st)
    (CGR st2 _ lbl
      (let st3 (cg-with-rodata st2 (REntry lbl text 1))
        (let st4 (cg-emit st3 "    movsd xmm0, [rip+")
          (let st5 (cg-emit st4 lbl)
            (let st6 (cg-nl (cg-emit st5 "]"))
              (cg-nl (cg-emit st6 "    movq rax, xmm0")))))))))

(defn cg-rodata-of (st)
  (match st
    (CGS _ _ _ _ rd _ rd)))

; ===========================================================================
; KINDS (for print format + float/string/struct dispatch):
;   0 int, 1 string, 2 float, 3 struct/variant (heap-allocated aggregate)
; ===========================================================================

; kind-of's IFfi arm used to unconditionally return 0 (int), regardless of
; what the FFI actually returns -- so `(print (str-concat "=> " ...))`
; (str-concat lowers to IFfi "zyl_cstr_concat", see icnf.zyl's
; ic-str-builtin-sym) picked %d formatting and printed the raw string
; pointer as a garbage integer instead of the text. Never caught before:
; grepping the whole tree, tools/repl.zyl is the only caller anywhere
; that ever printed a str-concat/ffi-string result directly. Named here
; rather than solved with real return-type inference (kind-of has none)
; since these are exactly the fixed set of C symbols icnf.zyl ever emits
; that hand back a string pointer.
(defn ffi-str-kind (name)
  (if (str-eq name "zyl_cstr_concat") 1
  (if (str-eq name "zyl_cstr_substr") 1
  (if (str-eq name "zyl_cstr_sub") 1
  (if (str-eq name "zyl_cstr_from_int") 1
  (if (str-eq name "zyl_cstr_sanitize") 1
  (if (str-eq name "zyl_cstr_decode") 1
  (if (str-eq name "zyl_file_read_c") 1
    0))))))))

; kind-of's ICall arm used to unconditionally return 0 (int), regardless
; of what the called function actually returns -- so `(print (some-fn
; ...))` for any ordinary top-level function returning a string/float
; picked %d formatting and printed the raw pointer/bit pattern instead.
; Same root cause and same fix shape as ffi-str-kind above (this file
; has no real return-type inference), but for plain user functions
; instead of a fixed set of C runtime symbols: cg-collect-fnnames now
; also records each top-level function's own body kind (computed with
; an empty env, so it only ever reflects genuinely fixed shapes -- a
; function returning a literal, arithmetic, or a call to an
; EARLIER-defined function in the same list; a function whose return
; kind depends on one of its own parameters, or that forward-references
; a function defined later in the list, still defaults to 0 -- kind-of
; has no per-call-site specialization either way, so this is already
; the same class of approximation the rest of this file makes).
; ICallClosure is deliberately NOT covered: `name` there is a local
; variable holding a closure value, not a top-level function name, and
; the CGS fn-kind table only knows about the latter.
; Legacy kind first; else the type-annotation kind (attr table 1).
(defn kind-of (st env e)
  (let k (kind-of-base st env e)
    (if (> k 0) k (icnf-kind e))))

(defn kind-of-base (st env e)
  (match e
    (IConst 0)
    (IStr _ 1)
    (ISymAddr _ 0)
    (IFlt _ 2)
    (ILoad n (env-kind-of env n))
    (IBinop op l r
     (if (> op 4)
       0
       (if (= (kind-of st env l) 2)
         2
         (if (= (kind-of st env r) 2) 2 0))))
    (IIf _ t _ (kind-of st env t))
    (ICall name _ (cg-fn-kind-search (cgg-fns st) name))
    (IFfi name _ (ffi-str-kind name))
    (IPrint _ 0)
    (IWhile _ _ 0)
    (ISet _ _ 0)
    ; ILet's own kind is whatever its BODY evaluates to, not a fixed 0 --
    ; matters now that literal-pattern match's if-chain desugaring
    ; (expr_inner.zyl) always wraps its result in a let (binding the
    ; scrutinee once), so a function whose whole body is such a match
    ; had its real string/float kind masked by this let wrapper even
    ; after fixing kind-of's ICall arm above. Same env passed through
    ; unchanged (not extended with the let's own binding): every leaf
    ; this needs to see through bottoms out at a literal (IStr/IFlt),
    ; whose kind doesn't depend on env at all.
    (ILet _ _ body (kind-of st env body))
    (ISeq _ 0)
    ; `==`/`!=` between two struct/ADT-kind operands used to fall straight
    ; into cg-ibinop's raw `cmp rax, rcx` (same bare pointer comparison bug
    ; already fixed for strings above) -- since IVariant construction
    ; heap-allocates a fresh block every time, two separately-constructed
    ; but field-for-field-identical values (e.g. a derived-Eq struct's
    ; make-<Name> called twice with the same arguments) live at different
    ; addresses, so pointer equality silently said "not equal" regardless
    ; of content. zyl_variant_eq (actor_runtime.c) already does real
    ; structural comparison and was already used by cg-variant's own
    ; comment describing the encoding it depends on -- just never actually
    ; called from anywhere. Kind 3 marks a value as struct/variant-typed
    ; so cg-expr's IBinop case can route `==`/`!=` through it instead.
    (IVariant _ _ _ 3)
    (IStackVariant _ _ _ 3)
    (IMatch _ _ 0)
    (IFn _ 0)
    (ICallClosure _ _ 0)
    (ITryCatch _ _ _ 0)
    (IRegion _ _ _ _ body (kind-of st env body))))

; ===========================================================================
; EXPRESSION EMISSION (result always in rax)
; ===========================================================================

(defn cg-expr (st env e)
  (match e
    (IConst v
     (let st2 (cg-emit st "    mov rax, ")
       (let st3 (cg-emit-int st2 v)
         (cg-nl st3))))
    (IStr s (cg-string-const st s))
    (ISymAddr s (cg-sym-addr st s))
    (IFlt t (cg-float-const st t))
    (ILoad n (cg-load-value st env n e))
    ; `=`/`!=` between two STRING-kind operands used to fall straight into
    ; cg-ibinop's raw `cmp rax, rcx` — a bare POINTER comparison. Since
    ; str-substring/str-concat/etc. always heap-allocate a FRESH buffer,
    ; two textually-identical strings routinely live at different
    ; addresses (e.g. str-contains-loop's per-candidate str-substring
    ; result, or two independently-parsed occurrences of the same
    ; identifier), so pointer equality silently gave the wrong answer —
    ; deterministically wrong within one build, but the wrongness itself
    ; depends on allocation order, which shifts between stage2 and stage3
    ; (compiled by different machine code), breaking the self-hosting
    ; fixed point. Route string-kind `=`/`!=` through zyl_cstr_eq instead.
    (IBinop op l r
     (if (> (if (= (kind-of st env l) 2) 1 (if (= (kind-of st env r) 2) 1 0)) 0)
       (cg-fbinop st env op l r)
       (if (> (if (and (> op 4) (< op 11)) (if (or (= (kind-of st env l) 1) (= (kind-of st env r) 1)) 1 0) 0) 0)
         (cg-strbinop st env op l r)
         (if (> (if (and (> op 4) (< op 11)) (if (or (= (kind-of st env l) 3) (= (kind-of st env r) 3)) 1 0) 0) 0)
           (cg-variantbinop st env op l r)
           (cg-ibinop st env op l r)))))
    (ICall name args (cg-call-user st env name args e))
    (ICallClosure name args (cg-call-user st env name args e))
    (IFfi sym args (cg-call-args st env sym args false (cg-site-level e)))
    (IPrint a (cg-print st env a))
    (IIf c t eb (cg-if-dispatch st env c t eb 0))
    (IWhile c body (cg-while-dispatch st env c body))
    (ISet n v
     (let st2 (cg-expr st env v)
       (let st3 (cg-emit st2 "    mov [rbp")
         (let st4 (cg-emit-int st3 (env-lookup env n))
           (cg-nl (cg-emit st4 "], rax"))))))
    (ILet n v body (cg-let-dispatch st env n v body 0))
    (ISeq es (cg-seq st env es 0))
    (IVariant _ tag fields (cg-variant st env tag fields (cg-site-level e)))
    (IStackVariant _ tag fields (cg-stack-variant st env tag fields))
    (IMatch scr arms (cg-match st env scr arms 0))
    ; A bare function node is never emitted as a value expression; keep st.
    (IFn _ _ _ st)
    (ITryCatch tbody cvar cbody (cg-trycatch st env tbody cvar cbody))
    (IRegion k b a l body (cg-region-scope st env e k b a l body))))

; A call by name: a local holding a function value (indirect), or a
; top-level function. A name that is neither is reported here, at the
; call, instead of as an undefined `_ZYL_<name>` from the linker. The
; common way to write one by accident is the `((x) body)` lambda
; shorthand, which spec 7.1 rejects: its `(x)` is a call to `x`.
(defn cg-call-user (st env name args site)
  (if (= (env-lookup env name) 0)
    (if (= (cg-fn-known st name) 1)
      (cg-call-args st env name args true (cg-site-level site))
      (cg-fail-undefined-fn st env name site))
    (cg-call-args st env name args true (cg-site-level site))))

; Tail-position emission; tl is the frame size, 0 when not in tail position.
(defn cg-tail (st env e tl)
  (if (= tl 0)
    (cg-expr st env e)
    (match e
      (IIf c t eb (cg-if-dispatch st env c t eb tl))
      (ILet n v body (cg-let-dispatch st env n v body tl))
      (ISeq es (cg-seq st env es tl))
      (IMatch scr arms (cg-match st env scr arms tl))
      (ICall name args (cg-tail-call st env name args tl e))
      (_ (cg-expr st env e)))))

;; Tail calls reuse the frame. tl packs the frame size and this function's
;; parameter count (cg-tail-tl); a callee may take stack arguments only as
;; far as this function's own incoming stack-argument area reaches.
(defn cg-tail-tl (fsz nparams) (+ fsz (* 1000000 nparams)))
(defn cg-tail-tl-r (fsz nparams rflags) (+ (cg-tail-tl fsz nparams) (* 1000000000 rflags)))
(defn cg-tl-fsz (tl) (% tl 1000000))
(defn cg-tl-params (tl) (% (/ tl 1000000) 1000))
(defn cg-tl-rflags (tl) (/ tl 1000000000))

(defn cg-tail-fits (tl m) (<= (cg-stack-count m) (cg-stack-count (cg-tl-params tl))))

(defn cg-tail-call (st env name args tl site)
  (let m (list-length args)
    (if (= (env-lookup env name) 0)
      (if (and (= (cg-fn-known st name) 1) (cg-tail-fits tl m))
        (cg-tail-direct st env name args tl site)
        (cg-expr st env site))
      (if (cg-tail-fits tl (+ m 1))
        (cg-tail-indirect st env name args tl site)
        (cg-expr st env site)))))

(defn cg-tail-direct (st env name args tl site)
  (let n (list-length args)
    (let st2 (cg-tail-stage (cg-tail-regions (cg-scratch-all st env args) tl site) n)
      (let sym (cg-sym-for (cg-arena-of st2) name 1)
        (cg-emit-line (cg-tail-leave st2 tl) (cg-cat2 (cg-arena-of st2) (str-intern (cg-arena-of st2) "    jmp ") sym))))))

; Through a local function value: the env goes last, as in cg-call-indirect.
(defn cg-tail-indirect (st env name args tl site)
  (let off (env-lookup env name)
    (let m (+ (list-length args) 1)
      (let st3 (cg-closure-env-scratch (cg-label-pair (cg-scratch-all st env args)) off)
        (let st4 (cg-tail-stage (cg-tail-regions st3 tl site) m)
          (match (cg-label-new st4)
            (CGR st5 _ lc
              (let st6 (cg-closure-magic-cmp st5 "r10" off)
                (let st7 (cg-nl (cg-emit (cg-emit st6 "    jne ") lc))
                  (let st8 (cg-label-def (cg-emit-line st7 "    mov r10, [r10+8]") lc)
                    (cg-emit-line (cg-tail-leave st8 tl) "    jmp r10")))))))))))

;; ── Regions (docs/regions-design.md) ─────────────────────────────────────
;; A function region inference flagged (attr 4 on its IFn: bit 0 frame
;; region, bit 1 result region) has six words above its parameters:
;;   [rbp-8]   rax saved across the exit call
;;   [rbp-16]  the result region its caller chose (zyl_cur_region at entry)
;;   [rbp-48]  the frame region header (prev, bump, end, blocks)
;; and its parameters start at [rbp-56]. The runtime (ZylRegion) shares
;; this layout, and so does code from the committed seed. A site's level (attr 4, level+1:
;; 1 frame, 2 result, 3 heap; 4+k the k-th with-region scope of the
;; function; 0 unannotated) picks the region.

(defn cg-region-flags (f)
  (let v (icnf-region f)
    (if (= v 0) 0 (- v 4))))

(defn cg-region-shift (rflags) (if (> rflags 0) 6 0))

(defn cg-site-level (e) (icnf-region e))

; r11 = the region for a site of level `lvl`, then zyl_cur_region = r11.
(defn cg-set-cur-region (st lvl)
  (if (= lvl 0)
    st
    (let st2 (if (> lvl 3)
               (cg-emit-line (cg-emit-int (cg-emit st "    lea r11, [rbp-") (cg-scope-base lvl)) "]")
               (cg-emit-line st (if (= lvl 1) "    lea r11, [rbp-48]"
                                  (if (= lvl 2) "    mov r11, [rbp-16]" "    xor r11d, r11d"))))
      (cg-emit-line st2 "    mov QWORD PTR fs:zyl_cur_region@tpoff, r11"))))

; Frame offset of the header of scope `lvl - 4` (recorded by
; cg-region-scope when it reserved the header).
(defn cg-scope-base (lvl) (ffi-call "zyl_wvec_get" (ffi-call "zyl_wvec_global" 5 1000) (- lvl 4) 1000))

; (with-region ...): a header in the frame (the frame header's four words,
; then kind, block, alignment, limit, bytes used; the runtime marks it with
; the low bit of `blocks`), pushed on the chain before the body and popped
; and released after it.
(defn cg-region-scope (st env e k b a l body)
  (let idx (- (icnf-region e) 1)
    (let base (cg-reserve-words st 10)
      (let st2 (cg-reset-slots st (+ base 8))
        (let savr (cg-new-slot st2)
          (match savr
            (CGR st3 save _
              (let _ (if (>= idx 0) (cg-scope-record idx base) unit)
                (let st4 (cg-emit-lines st3
                           (Cons (str-concat "    lea rdi, [rbp-" (str-concat (ffi-call "zyl_int_text" base 1000) "]"))
                           (Cons (str-concat "    mov rsi, " (ffi-call "zyl_int_text" k 1000))
                           (Cons (str-concat "    mov rdx, " (ffi-call "zyl_int_text" b 1000))
                           (Cons (str-concat "    mov rcx, " (ffi-call "zyl_int_text" a 1000))
                           (Cons (str-concat "    mov r8, " (ffi-call "zyl_int_text" l 1000)) Nil))))))
                  (let st5 (cg-ext-call-aligned st4 "    call zyl_region_scope_enter" 5)
                    (let st6 (cg-expr st5 env body)
                      (let st7 (cg-emit-line (cg-emit-int (cg-emit st6 "    mov [rbp") save) "], rax")
                        (let st8 (cg-emit-line (cg-emit-int (cg-emit st7 "    lea rdi, [rbp-") base) "]")
                          (let st9 (cg-ext-call-aligned st8 "    call zyl_region_exit" 1)
                            (cg-emit-line (cg-emit-int (cg-emit st9 "    mov rax, [rbp") save) "]")))))))))))))))

; The next `n` slots, as the offset of the lowest one (they are consecutive).
(defn cg-reserve-words (st n)
  (match st
    (CGS _ _ _ off _ _ (+ off (* 8 (- n 1))))))

(defn cg-scope-record (idx base)
  (let v (ffi-call "zyl_wvec_global" 5 1000)
    (let _ (cg-wvec-grow v (+ idx 1))
      (ffi-call "zyl_wvec_set" v idx base 1000))))

(defn cg-wvec-grow (v n)
  (if (< (ffi-call "zyl_wvec_len" v 1000) n)
    (let _ (ffi-call "zyl_wvec_push" v 0 1000) (cg-wvec-grow v n))
    0))

(defn cg-region-call (st fname)
  (let st2 (cg-emit-line st "    lea rdi, [rbp-48]")
    (cg-ext-call-aligned st2 (str-concat "    call " fname) 1)))

; Entry: keep the result region; push an empty frame region on this
; thread's chain (zyl_region_enter, inline).
(defn cg-region-prologue (st rflags)
  (let st2 (if (> (bit-and rflags 2) 0)
             (cg-emit-line (cg-emit-line st "    mov rax, QWORD PTR fs:zyl_cur_region@tpoff") "    mov [rbp-16], rax")
             st)
    (if (> (bit-and rflags 1) 0)
      (cg-emit-lines st2 (Cons "    mov rax, QWORD PTR fs:zyl_region_top@tpoff"
                         (Cons "    mov [rbp-48], rax"
                         (Cons "    xor eax, eax"
                         (Cons "    mov [rbp-40], rax"
                         (Cons "    mov [rbp-32], rax"
                         (Cons "    mov [rbp-24], rax"
                         (Cons "    lea rax, [rbp-48]"
                         (Cons "    mov QWORD PTR fs:zyl_region_top@tpoff, rax" Nil)))))))))
      st2)))

(defn cg-emit-lines (st lines)
  (match lines
    (Nil st)
    (Cons l rest (cg-emit-lines (cg-emit-line st l) rest))))

; Pop and release the frame region (zyl_region_exit, inline: the call
; only when a block was taken), keeping rax. r10/r11 are free here.
(defn cg-region-release (st)
  (match (cg-label-new st)
    (CGR st2 _ lskip
      (let st3 (cg-emit-line st2 "    cmp qword ptr [rbp-24], 0")
        (let st4 (cg-nl (cg-emit (cg-emit st3 "    je ") lskip))
          (let st5 (cg-region-call st4 "zyl_region_free")
            (let st6 (cg-label-def st5 lskip)
              (match (cg-label-new st6)
                (CGR st7 _ lkeep
                  (let st8 (cg-emit-lines st7 (Cons "    mov r10, [rbp-48]"
                                               (Cons "    mov QWORD PTR fs:zyl_region_top@tpoff, r10"
                                               (Cons "    lea r11, [rbp-48]"
                                               (Cons "    cmp QWORD PTR fs:zyl_cur_region@tpoff, r11" Nil)))))
                    (let st9 (cg-nl (cg-emit (cg-emit st8 "    jne ") lkeep))
                      (cg-label-def (cg-emit-line st9 "    mov QWORD PTR fs:zyl_cur_region@tpoff, 0") lkeep))))))))))))

; Release the frame region, keeping the value in rax.
(defn cg-region-epilogue (st rflags)
  (if (> (bit-and rflags 1) 0)
    (let st2 (cg-emit-line st "    mov [rbp-8], rax")
      (cg-emit-line (cg-region-release st2) "    mov rax, [rbp-8]"))
    st))

; Before a tail jump: the frame (and its region) is about to be reused.
; Region inference made every tail-call argument at least level R, so
; nothing the callee receives lives in the region released here.
(defn cg-tail-regions (st tl site)
  (let rf (cg-tl-rflags tl)
    (let st2 (if (> (bit-and rf 1) 0) (cg-region-release st) st)
      (cg-set-cur-region st2 (cg-site-level site)))))

; n args are in scratch slots: stack args to the incoming area, then registers.
(defn cg-tail-stage (st n)
  (cg-tail-regs (cg-tail-stack st n 6) n (- (cg-min-int n 6) 1)))

(defn cg-tail-stack (st n i)
  (if (>= i n)
    st
    (let st2 (cg-emit-line (cg-emit-int (cg-emit st "    mov r10, [rsp+") (* 8 (- n 1 i))) "]")
      (let st3 (cg-emit-line (cg-emit-int (cg-emit st2 "    mov [rbp+") (+ 16 (* 8 (- i 6)))) "], r10")
        (cg-tail-stack st3 n (+ i 1))))))

(defn cg-tail-regs (st n i)
  (if (< i 0)
    st
    (cg-tail-regs (cg-load-reg-one st (cg-reg-of i) (* 8 (- n 1 i))) n (- i 1))))

(defn cg-tail-leave (st tl)
  (let st2 (cg-restore-callee-saved st (cg-tl-fsz tl))
    (cg-emit-line (cg-emit-line st2 "    mov rsp, rbp") "    pop rbp")))

; Every name visible at this point: locals first, then top-level functions.
(defn cg-visible-names (st env)
  (list-append (cg-env-names env) (cg-fn-names (cgg-fns st))))

(defn cg-env-names (env)
  (match env
    (EnvBind n _ _ rest (Cons n (cg-env-names rest)))
    (EnvNil Nil)))

(defn cg-fn-names (fns)
  (if (is-nil fns)
    Nil
    (match (fnhead fns)
      (FN s _ (Cons s (cg-fn-names (fntail fns))))
      (FNNil (cg-fn-names (fntail fns))))))

(defn cg-fail-undefined-fn (st env n site)
  (let m1 "call to undefined function `"
    (let m2 (str-concat m1 (err-name n))
      (let msg (str-concat m2 "`")
        (let off (ffi-call "zyl_span_off" site 1000)
          (let fid (ffi-call "zyl_span_file" site 1000)
            (let hint (err-suggest-help n (cg-visible-names st env) "define it, or bind it with `let`; an anonymous function is written (fn (params) body) -- ((params) body) is not lambda syntax (spec 7.1)")
              (let text (err-at "E_UNBOUND_VARIABLE" msg fid off hint)
                (ffi-call "zyl_panic" text 1000)))))))))

; Load a variable / function value into rax.
; `site` is the ILoad node itself, carried only so an unbound identifier
; can be reported at the place it was written.
(defn cg-load-value (st env n site)
  (if (= (env-lookup env n) 0)
    (cg-load-nonslot st env n site)
    (cg-load-slot st n (env-lookup env n))))

(defn cg-load-slot (st _n off)
  (let st2 (cg-emit st "    mov rax, [rbp")
    (let st3 (cg-emit-int st2 off)
      (cg-nl (cg-emit st3 "]")))))

(defn cg-load-nonslot (st env n site)
  ; Function value reference: load the function's address so it can be
  ; passed as an argument and called indirectly (HOF support).
  (if (= (cg-fn-known st n) 1)
    (cg-load-fnref st n)
    (if (str-eq n "nil")
      (cg-load-unresolved st)
      (cg-fail-unbound st env n site))))

; A name that resolves to neither a bound local slot nor a known
; top-level function is a genuine unbound identifier (`nil` is the one
; deliberate exception above, handled by cg-load-unresolved). This used
; to fall through silently to cg-load-unresolved for EVERY unbound name,
; not just `nil` -- compiling the reference to the bare integer 0, so a
; typo'd or never-bound name never failed to compile, it just became 0
; and crashed later, at runtime, wherever that 0 was used as a pointer
; (an arena, a buffer, an FFI argument) -- far from the actual mistake.
; Confirmed: this is exactly what was happening to every free `arena`
; reference in early stdlib/lsp/*.zyl drafts (none of those functions
; ever bound `arena`), each one segfaulting inside whatever FFI call
; first dereferenced the resulting garbage/near-null pointer. Hard
; failure at compile time, at the actual unbound reference, replaces
; that entire class of bug with a real error at the real location.
(defn cg-fail-unbound (st env n site)
  (let m1 "unbound identifier `"
    (let m2 (str-concat m1 (err-name n))
      (let msg (str-concat m2 "`")
        (let off (ffi-call "zyl_span_off" site 1000)
          (let fid (ffi-call "zyl_span_file" site 1000)
            (let hint (err-suggest-help n (cg-visible-names st env) "check the spelling, or bind it with `let` before this point")
              (let text (err-at "E_UNBOUND_VARIABLE" msg fid off hint)
                (ffi-call "zyl_panic" text 1000)))))))))

; A foreign symbol's address, loaded through the GOT so it resolves the
; same way for a libc function and for a native-dependency object.
(defn cg-sym-addr (st s)
  (let st2 (cg-emit st "    mov rax, QWORD PTR [rip+")
    (let st3 (cg-emit st2 s)
      (cg-nl (cg-emit st3 "@GOTPCREL]")))))

(defn cg-load-fnref (st n)
  (let st2 (cg-emit st "    lea rax, [rip+")
    (let st3 (cg-emit st2 (cg-sym-mangled (cg-arena-of st) n))
      (let st4 (cg-emit st3 "]")
        (cg-nl st4)))))

; Fallback for a name that's neither a bound slot nor a known function —
; e.g. the bare (undefined) identifier `nil` used pervasively across this
; codebase as a discarded/placeholder value. Used to emit "mov rax, [rbp"
; + literal 0 + "]" — i.e. the bare text "[rbp0]", which GAS parses as a
; reference to an undefined symbol named `rbp0` (no register+immediate
; syntax without a +/- between them), not as [rbp+0]. A plain immediate
; load avoids the memory-operand text construction entirely, matching
; what the archived Rust bootstrap did for the same case.
(defn cg-load-unresolved (st)
  (cg-nl (cg-emit st "    mov rax, 0")))

(defn cg-if-dispatch (st env c t eb tl)
  (cg-if-labels (cg-label-pair st) env c t eb tl))

(defn cg-if-labels (p env c t eb tl)
  (cg-if-parts p env c t eb tl))

(defn cg-while-dispatch (st env c body)
  (cg-while-labels (cg-label-pair st) env c body))

(defn cg-while-labels (p env c body)
  (match p
    (CGP st lstart lend (cg-while-parts st env c body lstart lend))))

(defn cg-let-dispatch (st env n v body tl)
  (match (cg-new-slot st)
    (CGR st2 off _
      (cg-let-store st2 env n v body off tl))))

(defn cg-let-store (st env n v body off tl)
  (let k (kind-of st env v)
    (let st3 (cg-expr st env v)
      (let st4 (cg-emit st3 "    mov [rbp")
        (let st5 (cg-emit-int st4 off)
          (let st6 (cg-nl (cg-emit st5 "], rax"))
            (cg-tail st6 (EnvBind n off k env) body tl)))))))

; (if c t e): condition tested, then branch tails. p carries the state
; plus the else/join labels.
(defn cg-if-parts (p env c t eb tl)
  (match p
    (CGP st lelse lend
      (let st2 (cg-expr st env c)
        (let st3 (cg-emit st2 "    test rax, rax")
          (let st4 (cg-nl st3)
            (let st5 (cg-emit st4 "    je ")
              (let st6 (cg-nl (cg-emit st5 lelse))
                (let st7 (cg-tail st6 env t tl)
                  (let st8 (cg-emit st7 "    jmp ")
                    (let st9 (cg-nl (cg-emit st8 lend))
                      (let st10 (cg-emit-label st9 lelse)
                        (let st11 (cg-tail st10 env eb tl)
                          (cg-emit-label st11 lend))))))))))))))

; (while c body...)
; `while` is an expression like everything else here: its value is the
; BODY's value from the last iteration that ran (0/unit if the condition
; was false from the start) — used directly by `for`'s desugaring into a
; plain while (ic-for in icnf.zyl), which some regression tests assert
; on (e.g. control-flow.zyl's "for-loop-early-exit"). Used to hardcode
; `xor eax, eax` after the loop regardless, unlike the archived Rust
; bootstrap, which threads the last body value through a dedicated slot.
(defn cg-while-parts (st env c body lstart lend)
  (match (cg-new-slot st)
    (CGR st0 off _ (cg-while-body st0 env c body lstart lend off))))

(defn cg-while-body (st env c body lstart lend off)
  (let st1 (cg-while-store (cg-emit-line st "    mov rax, 0") off)
    (let st2 (cg-emit-label st1 lstart)
      (let st3 (cg-expr st2 env c)
        (let st4 (cg-emit-line st3 "    test rax, rax")
          (let st5 (cg-emit st4 "    je ")
            (let st6 (cg-nl (cg-emit st5 lend))
              (let st7 (cg-expr st6 env body)
                (let st8 (cg-while-store st7 off)
                  (let st9 (cg-emit st8 "    jmp ")
                    (let st10 (cg-nl (cg-emit st9 lstart))
                      (let st11 (cg-emit-label st10 lend)
                        (cg-while-load st11 off)))))))))))))

(defn cg-while-store (st off)
  (let st1 (cg-emit st "    mov [rbp")
    (let st2 (cg-emit-int st1 off)
      (cg-emit-line st2 "], rax"))))

(defn cg-while-load (st off)
  (let st1 (cg-emit st "    mov rax, [rbp")
    (let st2 (cg-emit-int st1 off)
      (cg-emit-line st2 "]"))))

(defn cg-emit-line (st s)
  (cg-nl (cg-emit st s)))

(defn cg-seq (st env es tl)
  (if (is-nil es)
    (cg-emit-line st "    xor eax, eax")
    (if (is-nil (tl2 es))
      (cg-tail st env (ih-ic es) tl)
      (let st2 (cg-expr st env (ih-ic es))
        (cg-seq st2 env (tl2 es) tl)))))

; Integer binary op: lhs -> rax (pushed), rhs -> rax, lhs restored to rax,
; rhs kept in rcx. Div/Rem use cqo/idiv with divisor safe in rcx.
(defn cg-ibinop (st env op l r)
  (let st2 (cg-expr st env l)
    (let st3 (cg-emit-line st2 "    push rax")
      (let st4 (cg-expr st3 env r)
        (let st5 (cg-emit-line st4 "    mov rcx, rax")
          (let st6 (cg-emit-line st5 "    pop rax")
            (if (< op 5)
              (cg-arith-mnem st6 op)
              (if (> op 10)
                (cg-bit-mnem st6 op)
                (cg-cmp-set st6 op)))))))))

; String `=`/`!=`: content comparison via the C runtime (zyl_cstr_eq),
; reusing cg-call-args' proven-safe ABI/stack-alignment handling instead
; of hand-rolling a new call sequence.
; String `<`/`>`/`<=`/`>=` order by bytes (zyl_cstr_cmp).
(defn cg-strbinop (st env op l r)
  (if (> op 8)
    (let st2 (cg-expr st env (IFfi "zyl_cstr_eq" (Cons l (Cons r Nil))))
      (if (= op 10)
        (cg-emit-line st2 "    xor rax, 1")
        st2))
    (let st2 (cg-expr st env (IFfi "zyl_cstr_cmp" (Cons l (Cons r Nil))))
      (cg-variant-cmp-set st2 op))))

; Struct/variant `==`/`!=`: structural comparison via the C runtime
; (zyl_variant_eq), same shape as cg-strbinop above. `<`/`>`/`<=`/`>=`
; had the identical bare-pointer-comparison bug (two field-for-field-
; identical structs are still two separately heap-allocated addresses,
; so which one comes out "less" depended on allocation order, not
; content -- e.g. two structs built with the same field values compared
; as `<` true just because the first one built happened to land at a
; lower address). zyl_variant_cmp (actor_runtime.c) does a real
; lexicographic field-by-field comparison (skipping the shared
; discriminant word, which never differs between same-type values) and
; returns -1/0/1; cg-variant-cmp-set turns that into the right bool for
; each of the four ops the same way cg-cmp-set already does for a
; direct register comparison.
(defn cg-variantbinop (st env op l r)
  (if (> op 8)
    (let st2 (cg-expr st env (IFfi "zyl_variant_eq" (Cons l (Cons r Nil))))
      (if (= op 10)
        (cg-emit-line st2 "    xor rax, 1")
        st2))
    (let st2 (cg-expr st env (IFfi "zyl_variant_cmp" (Cons l (Cons r Nil))))
      (cg-variant-cmp-set st2 op))))

(defn cg-variant-cmp-set (st op)
  (let st2 (cg-emit-line st "    cmp rax, 0")
    (let st3 (cg-emit st2 "    set")
      (if (= op 5)
        (cg-setcc st3 "l al")
        (if (= op 6)
          (cg-setcc st3 "g al")
          (if (= op 7)
            (cg-setcc st3 "le al")
            (cg-setcc st3 "ge al")))))))

(defn cg-arith-mnem (st op)
  ; Div (3) and Rem (4) both sign-extend rax into rdx via cqo before idiv,
  ; otherwise a stale rdx makes the 128-bit quotient overflow (SIGFPE).
  (let st2 (if (> op 2) (cg-emit-line st "    cqo") st)
    (let mnem (if (= op 0) "    add rax, rcx"
              (if (= op 1) "    sub rax, rcx"
                (if (= op 2) "    imul rax, rcx"
                  "    idiv rcx")))
      (let st3 (cg-emit-line st2 mnem)
        (if (= op 4)
          (cg-emit-line st3 "    mov rax, rdx")
          st3)))))

; Bitwise ops (11 bit-and, 12 bit-or, 13 bit-xor, 14 shl, 15 shr,
; 16 ashr) with lhs in rax and rhs in rcx, same register contract as
; cg-arith-mnem/cg-cmp-set above.
;
; Shift counts are NOT left to the bare x86 semantics. `shl rax, cl`
; masks its count to 6 bits, so `(shl x 64)` would silently mean
; `(shl x 0)` -- i.e. x unchanged where every language and every piece
; of crypto code means 0. Both logical shifts therefore AND the result
; with a mask that is all-ones only when the count is in 0..63:
; `cmp rdx, 64` + `sbb rdx, rdx` leaves rdx = -1 when the (unsigned)
; count is below 64 and 0 otherwise, which also catches a negative
; count (huge as unsigned). `ashr` instead saturates: an out-of-range
; count clamps to 63 via cmovae, so the result is the sign bit
; replicated, which is what an arithmetic shift means in the limit.
;
; Every sequence here is branchless and its instruction stream does not
; depend on the operand VALUES -- only on the opcode, which is a
; compile-time constant. That is what makes these usable as the
; building blocks of constant-time code.
(defn cg-bit-mnem (st op)
  (if (= op 11) (cg-emit-line st "    and rax, rcx")
  (if (= op 12) (cg-emit-line st "    or rax, rcx")
  (if (= op 13) (cg-emit-line st "    xor rax, rcx")
  (if (= op 16) (cg-bit-ashr st)
    (cg-bit-logical-shift st op))))))

(defn cg-bit-logical-shift (st op)
  (let st2 (cg-emit-line st "    mov rdx, rcx")
    (let st3 (cg-emit-line st2 (if (= op 14) "    shl rax, cl" "    shr rax, cl"))
      (let st4 (cg-emit-line st3 "    cmp rdx, 64")
        (let st5 (cg-emit-line st4 "    sbb rdx, rdx")
          (cg-emit-line st5 "    and rax, rdx"))))))

(defn cg-bit-ashr (st)
  (let st2 (cg-emit-line st "    mov rdx, 63")
    (let st3 (cg-emit-line st2 "    cmp rcx, 64")
      (let st4 (cg-emit-line st3 "    cmovae rcx, rdx")
        (cg-emit-line st4 "    sar rax, cl")))))

(defn cg-cmp-set (st op)
  (let st2 (cg-emit-line st "    cmp rax, rcx")
    (let st3 (cg-emit st2 "    set")
      (if (= op 5)
        (cg-setcc st3 "l al")
        (if (= op 6)
          (cg-setcc st3 "g al")
          (if (= op 7)
            (cg-setcc st3 "le al")
            (if (= op 8)
              (cg-setcc st3 "ge al")
              (if (= op 9)
                (cg-setcc st3 "e al")
                (cg-setcc-ne st3)))))))))

(defn cg-setcc (st s)
  (let st4 (cg-nl (cg-emit st s))
    (cg-emit-line st4 "    movzx rax, al")))

(defn cg-setcc-ne (st)
  (let st4 (cg-nl (cg-emit st "ne al"))
    (cg-emit-line st4 "    movzx rax, al")))

; Float binary op: bits in rax; xmm0 = lhs, xmm1 = rhs.
(defn cg-fbinop (st env op l r)
  (let st2 (cg-expr st env l)
    (let st3 (cg-emit-line st2 "    push rax")
      (let st4 (cg-expr st3 env r)
        (let st5 (cg-emit-line st4 "    movq xmm1, rax")
          (let st6 (cg-emit-line st5 "    pop rax")
            (let st7 (cg-emit-line st6 "    movq xmm0, rax")
              (if (< op 5)
                (cg-farith st7 op)
                (cg-fcmp st7 op)))))))))

(defn cg-farith (st op)
  (let st2 (cg-emit st "    ")
    (let st3 (if (= op 0) (cg-emit st2 "addsd")
             (if (= op 1) (cg-emit st2 "subsd")
               (if (= op 2) (cg-emit st2 "mulsd")
                 (cg-emit st2 "divsd"))))
      (let st4 (cg-emit-line st3 " xmm0, xmm1")
        (cg-emit-line st4 "    movq rax, xmm0")))))

(defn cg-fcmp (st op)
  (let st2 (cg-emit-line st "    comisd xmm0, xmm1")
    (let st3 (cg-emit st2 "    set")
      (if (= op 5)
        (cg-fsetcc st3 "b al")
        (if (= op 6)
          (cg-fsetcc st3 "a al")
          (if (= op 7)
            (cg-fsetcc st3 "be al")
            (if (= op 8)
              (cg-fsetcc st3 "ae al")
              (if (= op 9)
                (cg-fsetcc st3 "e al")
                (cg-fsetcc-ne st3)))))))))

; unsigned-comparison flags carry the usual sense here
(defn cg-fsetcc (st s)
  (let st4 (cg-nl (cg-emit st s))
    (cg-emit-line st4 "    movzx rax, al")))

(defn cg-fsetcc-ne (st)
  (let st4 (cg-nl (cg-emit st "ne al"))
    (cg-emit-line st4 "    movzx rax, al")))

; Register-name dispatch by arg index (SysV).
(defn cg-reg-of (i)
  (if (= i 0) "rdi"
    (if (= i 1) "rsi"
      (if (= i 2) "rdx"
        (if (= i 3) "rcx"
          (if (= i 4) "r8"
            "r9"))))))

; Call: arguments are staged through scratch slots so that more than six
; parameters work (SysV stack args):
;   phase 0: 8-byte alignment pad if N+S is odd (S = stack args)
;   phase 1: evaluate every argument left-to-right into an 8-byte
;            scratch slot (`sub rsp, 8` / `mov [rsp], rax`)
;   phase 2: copy-push stack args (index >= 6) in reverse order so arg 6
;            sits at [rsp] at the call
;   phase 3: load register args from their scratch slots ([rsp+off],
;            offsets account for the copy-pushes)
;   phase 4: call; cleanup removes pad + scratch + copy-pushes.
; `mangle` adds the _ZYL_ prefix for user functions.
; `lvl` is the site's region level (0 when unannotated). A runtime call
; with a level goes to the function's region-aware `_r` entry point.
(defn cg-call-args (st env name args mangle lvl)
  (if (> mangle 0)
    (if (= (env-lookup env name) 0)
      (cg-call-args-go st env name args mangle lvl)
      (cg-call-indirect st env name args lvl))
    (cg-call-args-go st env name args mangle lvl)))

(defn cg-call-args-go (st env name args mangle lvl)
  (let n (list-length args)
    (let st2 (if (= (% (+ n (cg-stack-count n)) 2) 1)
               (cg-emit-line st "    sub rsp, 8")
               st)
      (let st3 (cg-scratch-all st2 env args)
        (let st4 (cg-copy-stack-args st3 n (- n 1) 0)
          (let st5 (cg-set-cur-region (cg-load-reg-args st4 n (- (cg-min-int n 6) 1)) lvl)
            (if (> mangle 0)
              (cg-fire-user st5 env name n)
              (cg-fire-ext st5 env (if (> lvl 0) (str-concat name "_r") name) n))))))))

; Number of stack-passed (SysV) arguments for a call of arity n.
(defn cg-stack-count (n)
  (if (> n 6) (- n 6) 0))

(defn cg-min-int (a b)
  (if (< a b) a b))

; Phase 1: evaluate each argument once and spill it into a scratch slot.
(defn cg-scratch-all (st env args)
  (if (is-nil args)
    st
    (let st2 (cg-expr st env (ih-ic args))
      (let st3 (cg-emit-line st2 "    sub rsp, 8")
        (let st4 (cg-emit-line st3 "    mov [rsp], rax")
          (cg-scratch-all st4 env (tl2 args)))))))

; Phase 2: copy-push args i = n-1 down to 6 from their scratch slots
; (no-op for arity <= 6); `pushed` counts bytes already copy-pushed.
(defn cg-copy-stack-args (st n i pushed)
  (if (< i 6)
    st
    (let st2 (cg-copy-one st (+ (* 8 (- n 1 i)) pushed))
      (cg-copy-stack-args st2 n (- i 1) (+ pushed 8)))))

(defn cg-copy-one (st off)
  (let st2 (cg-emit st "    mov r10, [rsp+")
    (let st3 (cg-emit-int st2 off)
      (let st4 (cg-emit st3 "]")
        (let st5 (cg-nl st4)
          (cg-emit-line st5 "    push r10"))))))

; Phase 3: load register args i = min(n,6)-1 down to 0 from scratch;
; offsets skip over the S copy-pushed stack args.
(defn cg-load-reg-args (st n i)
  ; NOTE: the offset must be built through lets — a binop whose direct
  ; operands are BOTH calls silently computes 0 in stage>=2 binaries
  ; (generalisation of the match-arm one-call rule).
  (if (< i 0)
    st
    (let a (* 8 (- n 1 i))
      (let b (* 8 (cg-stack-count n))
        (let st2 (cg-load-reg-one st (cg-reg-of i) (+ a b))
          (cg-load-reg-args st2 n (- i 1)))))))

(defn cg-load-reg-one (st reg off)
  (let st2 (cg-emit st "    mov ")
    (let st3 (cg-emit st2 reg)
      (let st4 (cg-emit st3 ", [rsp+")
        (let st5 (cg-emit-int st4 off)
          (cg-nl (cg-emit st5 "]")))))))

; HOF indirect calls are implemented but gated OFF: the path crashes
; inside stage1's own execution (see PROGRESS.md stage2 blocker #3).
(defn cg-hof-enabled () 1)

; Full call-target symbol: _ZYL_<name> for user fns, <name> otherwise.
(defn cg-sym-for (arena name mangle)
  (if (> mangle 0)
    (cg-sym-mangled arena name)
    (ffi-call "zyl_cstr_sanitize" arena name 1000)))

; Assembly label for a definition. A canonical key (spec v5.0 SS31.2 —
; `pkg@major::module::symbol`, always carrying '@') is mangled by the
; runtime's zyl_mangle_key, whose output IS the spec's label: injective,
; so `acme/json`, `acme.json` and `acme-json` stay three symbols. Names
; without a key are the handful the compiler recognises by spelling
; (`main`, the inlined string builtins) plus anything a nested compile
; hands over unqualified; they keep the historical `_ZYL_` + sanitize
; spelling, which is safe for that fixed vocabulary.
(defn cg-sym-mangled (arena name)
  (if (> (cg-canonical-key-p name) 0)
    (ffi-call "zyl_mangle_key" arena name 1000)
    (let buf (buf-new arena 512)
      (begin
        (buf-append buf "_ZYL_")
        (buf-append buf (ffi-call "zyl_cstr_sanitize" arena name 1000))
        (buf-str buf)))))

; '@' (64) never appears in a source identifier -- the lexer does not
; accept it -- so it marks a name the resolver qualified.
(defn cg-canonical-key-p (name)
  (cg-has-at name 0))

(defn cg-has-at (name i)
  (if (>= i (ffi-call "zyl_cstr_len" name 1000))
    false
    (if (= (ffi-call "zyl_cstr_byte_at" name i 1000) 64)
      true
      (cg-has-at name (+ i 1)))))

(defn cg-cat2 (arena a b)
  (let buf (buf-new arena (+ (alloc-strlen a) (+ (alloc-strlen b) 1)))
    (begin
      (buf-append buf a)
      (buf-append buf b)
      (buf-str buf))))

(defn cg-cat3 (arena a b c)
  (cg-cat2 arena (cg-cat2 arena a b) c))

; Build "call f_<sanitized>" as a single string.
(defn cg-call-user-str (st _env name)
  (let sym (cg-sym-for (cg-arena-of st) name 1)
    (cg-cat2 (cg-arena-of st) (str-intern (cg-arena-of st) "call ") sym)))

; ── mangled (user fn) path: n args already pushed, rsp pre-aligned ──

(defn cg-fire-user (st env name n)
  (cg-user-direct st env name n))

(defn cg-call-cleanup (st n)
  ; Built through lets: no binop may directly combine two calls.
  (let ns (+ n (cg-stack-count n))
    (let tot (* 8 (+ ns (% ns 2)))
      (let st2 (cg-emit st "    add rsp, ")
        (cg-nl (cg-emit-int st2 tot))))))

(defn cg-user-direct (st env name n)
  (let st2 (cg-emit-line st (cg-call-user-str st env name))
    (cg-call-cleanup st2 n)))

; ── indirect call: through a local holding a function value ──
; The value is either a plain code address (a top-level function or a
; non-capturing `fn`) or a closure: a pointer to a [tag, code, env]
; triple whose tag word is ic-closure-magic (icnf.zyl's ic-lambda-closure).
; The call always passes n+1 arguments: the n real ones, then the env
; for a closure or 0 for a plain function, which just ignores it (the
; SysV caller owns every argument register and stack slot, so an extra
; one is harmless). Staging is cg-call-args's phases 0-3 with m = n+1,
; the env computed last, as the final scratch slot, so left-to-right
; argument evaluation is unchanged. The code address is picked by the
; same tag test into r10 after the registers are loaded (r10/r11 are
; never argument registers). A code address's first 8 bytes are this
; compiler's own prologue (`push rbp` = 0x55 first), never the tag.
(defn cg-call-indirect (st env name args lvl)
  (let n (list-length args)
    (let m (+ n 1)
      (let off (env-lookup env name)
        (let st2 (if (= (% (+ m (cg-stack-count m)) 2) 1)
                   (cg-emit-line st "    sub rsp, 8")
                   st)
          (let st3 (cg-scratch-all st2 env args)
            (let st4 (cg-closure-env-scratch (cg-label-pair st3) off)
              (let st5 (cg-copy-stack-args st4 m (- m 1) 0)
                (let st6 (cg-set-cur-region (cg-load-reg-args st5 m (- (cg-min-int m 6) 1)) lvl)
                  (let st7 (cg-closure-target (cg-label-new st6) off)
                    (cg-call-cleanup st7 m)))))))))))

(defn cg-closure-magic-cmp (st reg off)
  (let st2 (cg-emit st "    mov ")
    (let st3 (cg-emit st2 reg)
      (let st4 (cg-emit st3 ", [rbp")
        (let st5 (cg-emit-int st4 off)
          (let st6 (cg-nl (cg-emit st5 "]"))
            (let st7 (cg-emit st6 "    mov r11, ")
              (let st8 (cg-nl (cg-emit-int st7 (ic-closure-magic)))
                (let st9 (cg-emit st8 "    cmp qword ptr [")
                  (cg-nl (cg-emit (cg-emit st9 reg) "], r11")))))))))))

; rax = env of the closure in slot `off`, or 0; pushed as a scratch slot.
(defn cg-closure-env-scratch (p off)
  (match p
    (CGP st la lb
      (let st2 (cg-closure-magic-cmp st "rax" off)
        (let st3 (cg-nl (cg-emit (cg-emit st2 "    jne ") la))
          (let st4 (cg-emit-line st3 "    mov rax, [rax+16]")
            (let st5 (cg-nl (cg-emit (cg-emit st4 "    jmp ") lb))
              (let st6 (cg-label-def st5 la)
                (let st7 (cg-emit-line st6 "    xor eax, eax")
                  (let st8 (cg-label-def st7 lb)
                    (let st9 (cg-emit-line st8 "    sub rsp, 8")
                      (cg-emit-line st9 "    mov [rsp], rax"))))))))))))

; r10 = code address of the value in slot `off`; then the call.
(defn cg-closure-target (r off)
  (match r
    (CGR st _ lc
      (let st2 (cg-closure-magic-cmp st "r10" off)
        (let st3 (cg-nl (cg-emit (cg-emit st2 "    jne ") lc))
          (let st4 (cg-emit-line st3 "    mov r10, [r10+8]")
            (let st5 (cg-label-def st4 lc)
              (cg-emit-line st5 "    call r10"))))))))

; ── ext (FFI) path ──

; `name` is an arbitrary string literal from source (ffi-call's target),
; not a compiler-chosen symbol -- unlike cg-fire-user/cg-sym-for it was
; being spliced into the emitted ".s" text unsanitized. Any byte in the
; literal (a decoded escape like "\n" included) landed verbatim in the
; assembly source, so a crafted ffi-call name could inject extra
; assembly lines rather than merely naming an odd symbol. Route it
; through the same zyl_cstr_sanitize used for user-call symbols first:
; that collapses everything outside [A-Za-z0-9_] to '_', so the emitted
; text can only ever be a single `call <identifier>` line -- callable
; native symbol names are still unrestricted (per spec/09's arbitrary
; ffi-call-by-name model), only assembly-source injection is closed.
(defn cg-fire-ext (st _env name n)
  (let sym (ffi-call "zyl_cstr_sanitize" (cg-arena-of st) name 1000)
    (let st2 (cg-cat2 (cg-arena-of st) (str-intern (cg-arena-of st) "call ") sym)
      (let st3 (cg-ext-call-aligned st st2 n)
        (cg-call-cleanup st3 n)))))

; A C function may assume the SysV guarantee that rsp is 16-byte aligned
; at the call, and some do in a way that faults when it is not: gcc
; compiles a struct copy or an __m128i local into `movaps`, which
; requires the alignment rather than merely preferring it. This backend
; cannot promise it by construction -- cg-function's frame leaves rsp at
; 8 mod 16 inside a body, and every intermediate push (an argument
; scratch slot, a variant field) shifts it again under any sub-
; expression that contains its own call -- so the parity pad in
; cg-call-args preserves whatever alignment happened to hold rather than
; establishing one.
;
; Found the hard way: the REPL's `tcsetattr` (a 60-byte struct termios,
; copied with movaps) segfaulted on its second call and not its first,
; purely because the two call sites sat at different depths. printf with
; a float argument (cg-print) and zyl_heap_alloc (cg-variant) had each
; been patched with this same save/AND/restore locally; this puts it on
; every C call instead of waiting for the next one to crash.
;
; r12 is callee-saved, so the callee hands it back. The register
; arguments are already loaded by the time this runs (cg-call-args phase
; 3), so moving rsp cannot disturb them.
;
; Arity 7 and up passes its extra arguments ON the stack, at [rsp] at
; the moment of the call, so rsp cannot simply be rounded down: the
; S stack arguments are copied into a fresh 16-byte-aligned block below
; the current rsp (through r10, which carries no argument), and the call
; is made from there. The block lies entirely below r12, so the copy
; never overwrites a source word. Without it a varargs callee such as
; snprintf, which spills the SSE registers with movaps when al is
; nonzero, faulted whenever the call sat at the wrong depth.
(defn cg-ext-call-aligned (st callstr n)
  (let st2 (cg-emit-line st "    mov r12, rsp")
    (let st3 (if (> n 6) (cg-ext-stack-args-realign st2 (- n 6)) (cg-emit-line st2 "    and rsp, -16"))
      (let st4 (cg-emit-line st3 callstr)
        (cg-emit-line st4 "    mov rsp, r12")))))

(defn cg-ext-stack-args-realign (st count)
  (let st2 (cg-emit-int (cg-emit st "    sub rsp, ") (* 8 count))
    (let st3 (cg-emit-line (cg-nl st2) "    and rsp, -16")
      (cg-ext-copy-stack-arg st3 0 count))))

(defn cg-ext-copy-stack-arg (st k count)
  (if (>= k count)
    st
    (let st2 (cg-emit-int (cg-emit st "    mov r10, [r12+") (* 8 k))
      (let st3 (cg-emit-line st2 "]")
        (let st4 (cg-emit-int (cg-emit st3 "    mov [rsp+") (* 8 k))
          (cg-ext-copy-stack-arg (cg-emit-line st4 "], r10") (+ k 1) count))))))

; print: pick the format by the argument's kind.
; `print`'s own "value" (this is a Lisp where everything is an
; expression, so a print statement is also usable as one) used to be
; whatever printf happened to leave in rax -- its return value, the
; byte count written, an ABI artifact never meant to be meaningful
; here. That leaked two different ways: it silently became the process
; exit code whenever a print was the tail expression of `main` (see
; the entry stub's own comment), and it made nested prints like
; `(print (print x))` show a second, garbage-looking number (the
; inner print's byte count) instead of anything sensible. print now
; always evaluates to a clean, deterministic 0 -- the ordinary "this
; statement has no useful value" convention -- by zeroing eax again
; right after the call, regardless of what printf itself returned.
; printf is called through the same rsp save/AND/restore idiom
; cg-variant uses: the frame size cg-function picks leaves rsp at 8 mod
; 16 inside a body, and a call staging its arguments on the stack
; shifts it again, so the alignment at any given call site is not
; something this backend can predict. printf tolerated that as long as
; al was 0 -- with no vararg floats it never reaches the `movaps` that
; spills the SSE argument registers. `print` on a Float sets al to 1 and
; does reach it, so an unaligned frame there was a hard crash rather
; than a wrong answer. r12 is callee-saved, so printf gives it back.
(defn cg-print (st env a)
  (let k (kind-of st env a)
    (let st2 (cg-expr st env a)
      (if (= k 2)
        (let st3 (cg-emit-line st2 "    movq xmm0, rax")
          (let st4 (cg-emit-line st3 "    lea rdi, [rip+.Lfmtf]")
            (let st5 (cg-emit-line st4 "    mov eax, 1")
              (cg-emit-line (cg-print-call st5) "    xor eax, eax"))))
        (if (= k 1)
          (let st3 (cg-emit-line st2 "    mov rsi, rax")
            (let st4 (cg-emit-line st3 "    lea rdi, [rip+.Lfmts]")
              (let st5 (cg-emit-line st4 "    xor eax, eax")
                (cg-emit-line (cg-print-call st5) "    xor eax, eax"))))
          (let st3 (cg-emit-line st2 "    mov rsi, rax")
            (let st4 (cg-emit-line st3 "    lea rdi, [rip+.Lfmtd]")
              (let st5 (cg-emit-line st4 "    xor eax, eax")
                (cg-emit-line (cg-print-call st5) "    xor eax, eax")))))))))

; The call itself, on a 16-byte-aligned stack. Emitted after rdi/rsi/al
; are already set, so aligning here cannot disturb them.
(defn cg-print-call (st)
  (let st2 (cg-emit-line st "    mov r12, rsp")
    (let st3 (cg-emit-line st2 "    and rsp, -16")
      (let st4 (cg-emit-line st3 "    call printf")
        (cg-emit-line st4 "    mov rsp, r12")))))

; Variant construction: [tag][f0]..[fn-1], allocated via zyl_heap_alloc
; (not raw malloc) so the runtime's hidden qword-count header lands
; before the block — the same mechanism the archived Rust bootstrap used,
; which zyl_variant_eq (actor_runtime.c) reads to do structural equality
; on two separately-allocated ADT/struct values without a runtime type
; tag. Fields are evaluated and pushed, then popped into the block
; (right to left). Alignment for the call is forced via rsp itself
; (save to r12, AND down to 16, restore after) rather than padding by
; this call's own field-count parity: that parity-based padding used to
; assume rsp was already 16-aligned at entry to cg-variant, which broke
; whenever this construction sat inside an outer field-push (nested
; variant/call arguments), because the outer call's already-pushed word
; count shifts the actual parity out from under a check that only looks
; at n. Saving/restoring rsp around the call sidesteps that regardless
; of any outer pushes.
(defn cg-variant (st env tag fields lvl)
  (let n (list-length fields)
    (let st2 (cg-push-fields st env fields)
      (let st3 (cg-emit-line st2 "    mov r12, rsp")
        (let st4 (cg-emit-line st3 "    and rsp, -16")
          (let st5 (cg-nl (cg-emit-int (cg-emit st4 "    mov rdi, ") (* 8 (+ n 1))))
            (let st6 (cg-variant-alloc st5 lvl)
              (let st7 (cg-emit-line st6 "    mov rsp, r12")
                (let st8 (cg-emit-line st7 "    mov rbx, rax")
                  (let st9 (cg-emit-int (cg-emit st8 "    mov qword ptr [rbx], ") tag)
                    (let st10 (cg-nl st9)
                      (let st11 (cg-pop-fields st10 (- n 1))
                        (cg-emit-line st11 "    mov rax, rbx")))))))))))))

; Level 1 (frame) and 2 (result) allocate in a region; anything else in
; the heap, exactly as before regions.
(defn cg-variant-alloc (st lvl)
  (if (> lvl 3)
    (cg-emit-line (cg-emit-line (cg-emit-int (cg-emit st "    lea rsi, [rbp-") (cg-scope-base lvl)) "]") "    call zyl_ralloc")
  (if (= lvl 1)
    (cg-emit-line (cg-emit-line st "    lea rsi, [rbp-48]") "    call zyl_ralloc")
    (if (= lvl 2)
      (cg-emit-line (cg-emit-line st "    mov rsi, [rbp-16]") "    call zyl_ralloc")
      (cg-emit-line st "    call zyl_heap_alloc")))))

; Evaluate each field left-to-right, pushing its value.
(defn cg-push-fields (st env fields)
  (if (is-nil fields)
    st
    (let st2 (cg-expr st env (ih-ic fields))
      (cg-push-fields (cg-emit-line st2 "    push rax") env (tl2 fields)))))

; Pop n fields into the block rbx points at (reverse order restores the
; original left-to-right layout).
(defn cg-pop-fields (st j)
  (if (< j 0)
    st
    (let st2 (cg-emit-line st "    pop rax")
      (let st3 (cg-emit st2 "    mov [rbx+")
        (let st4 (cg-emit-int st3 (* 8 (+ j 1)))
          (let st5 (cg-nl (cg-emit st4 "], rax"))
            (cg-pop-fields st5 (- j 1))))))))

; ── Stack-allocated variant (IStackVariant) ──────────────────────────────
; Same [tag, field0, field1, ...] layout cg-variant builds on the heap,
; but written directly into (n+1) slots reserved in the CURRENT
; function's own frame (cg-reserve-block, a run of consecutive
; cg-new-slot calls) -- no zyl_heap_alloc call, no staging through
; pushes: each field is evaluated and stored straight to its final
; offset, since there's no allocation call in between that could clobber
; a value still waiting to be written (unlike cg-variant, which stages
; through pushes specifically because zyl_heap_alloc happens AFTER every
; field is evaluated). Only reached when region_inference.zyl has
; already proven the binding never escapes this frame -- see
; ri-name-safe-in.
(defn cg-reserve-block (st count)
  (match (cg-new-slot st)
    (CGR st2 off _
      (if (<= count 1)
        (CGR st2 off "")
        (cg-reserve-block st2 (- count 1))))))

(defn cg-stack-variant (st env tag fields)
  (let n (list-length fields)
    (match (cg-reserve-block st (+ n 1))
      (CGR st2 base _
        (let st3 (cg-emit st2 "    mov qword ptr [rbp")
          (let st4 (cg-emit-int st3 base)
            (let st5 (cg-emit st4 "], ")
              (let st6 (cg-nl (cg-emit-int st5 tag))
                (let st7 (cg-stack-write-fields st6 env base fields 0)
                  (let st8 (cg-emit st7 "    lea rax, [rbp")
                    (let st9 (cg-emit-int st8 base)
                      (cg-nl (cg-emit st9 "]")))))))))))))

(defn cg-stack-write-fields (st env base fields idx)
  (match fields
    (Nil st)
    (Cons f rest
      (let st2 (cg-expr st env f)
        (let st3 (cg-emit st2 "    mov [rbp")
          (let st4 (cg-emit-int st3 (+ base (* 8 (+ idx 1))))
            (let st5 (cg-nl (cg-emit st4 "], rax"))
              (cg-stack-write-fields st5 env base rest (+ idx 1)))))))))

; Match: evaluate scrutinee, keep it on the stack for the whole dispatch,
; replace it with the arm-body result, pop at the end.
; Stack invariant: exactly one pushed word ([rsp] = scrutinee or result).
(defn cg-match (st env scr arms tl)
  (cg-match-labels (cg-label-pair st) env scr arms tl))

(defn cg-match-labels (p env scr arms tl)
  (match p
    (CGP st lend lzero
      (cg-match-scrutinee st env scr arms lend lzero tl))))

(defn cg-match-scrutinee (st env scr arms lend lzero tl)
  (let st3 (cg-expr st env scr)
    (let st4 (cg-emit-line st3 "    push rax")
      (cg-match-arms st4 env arms lend lzero tl))))

(defn cg-match-arms (st env arms lend lzero tl)
  (let st5 (cg-arms st env arms lend lzero tl)
    ; fall-through: no arm matched -> 0
    (let st6 (cg-emit-label st5 lzero)
      (let st7 (cg-emit-line st6 "    mov qword ptr [rsp], 0")
        (let st8 (cg-emit-label st7 lend)
          (cg-emit-line st8 "    pop rax"))))))

; Emit arms[i..]. Each arm checks [rsp]'s tag; a failed check jumps to
; the next arm's label (or the zero fall-through after the last arm); a
; successful match binds pattern vars and evaluates the body.
(defn cg-arms (st env arms lend lzero tl)
  (if (is-nil arms)
    st
    (cg-arm-one (CGP st lend lzero) (hd-ia arms) (tl2 arms) env tl)))

(defn cg-arm-one (p arm rest env tl)
  (match p
    (CGP st lend lzero
      (match arm
        (IArm vname tag binds body
          (if (is-nil rest)
            ; last arm: failed tag check falls through to the zero label
            (cg-arm-match (CGP st lzero lend) env tag binds body tl)
            ; more arms follow: failures jump to a fresh next-arm label
            (let picked (cg-label-new st)
              (let lnext (cgr-str picked)
                (let st-after (cg-arm-match (CGP (cgr-st picked) lnext lend) env tag binds body tl)
                  (cg-arms (cg-emit-label st-after lnext) env rest lend lzero tl))))))))))

; Emit one arm's tag check, bindings, body and exit jump. flabel (carried
; in p) is where a failed tag check goes; lend is the match join label.
;
; A wildcard/catch-all arm (any pattern name that doesn't resolve to a
; real variant, e.g. `_`)
; gets sentinel tag -1 from vt-tag-of ("not found"). Unconditionally
; emitting a tag check for it — `cmp rax, -1` — can never actually match
; a real scrutinee's tag, so the wildcard arm's own body was NEVER
; reachable: every such arm always "failed" its own check and fell
; through to lzero's hardcoded 0, silently discarding whatever the arm
; was supposed to compute. This is the single mechanism behind the
; entire "rbp0"/wildcard-arm-returns-0 bug class chased through this
; session once cg-load-unresolved stopped being the direct culprit — the
; archived Rust bootstrap's codegen.rs special-cased this (skips cmp/je
; for the wildcard arm, routes the no-match fallthrough straight to its
; body); this mirrors that: skip the tag check entirely and match
; unconditionally when tag is the sentinel.
(defn cg-arm-match (p env tag binds body tl)
  (match p
    (CGP st flabel lend
      (if (= tag -1)
        (match (cg-bind-fields st env binds 0)
          (CGE st6 arm-env
            (let st7 (cg-tail st6 arm-env body tl)
              (let st8 (cg-emit-line st7 "    mov [rsp], rax")
                (let st9 (cg-emit st8 "    jmp ")
                  (cg-nl (cg-emit st9 lend)))))))
        (let st3 (cg-tag-check st tag)
          (let st4 (cg-emit st3 "    jne ")
            (let st5 (cg-nl (cg-emit st4 flabel))
              (match (cg-bind-fields st5 env binds 0)
                (CGE st6 arm-env
                  (let st7 (cg-tail st6 arm-env body tl)
                    (let st8 (cg-emit-line st7 "    mov [rsp], rax")
                      (let st9 (cg-emit st8 "    jmp ")
                        (cg-nl (cg-emit st9 lend))))))))))))))

(defn cgr-st (r)
  (match r
    (CGR s _ _ s)))

(defn cgr-str (r)
  (match r
    (CGR _ _ s s)))

; Arm prologue: load scrutinee pointer from [rsp] and its tag.
(defn cg-tag-check (st tag)
  (let st2 (cg-emit-line st "    mov rax, [rsp]")
    (let st3 (cg-emit-line st2 "    mov rax, [rax]")
      (let st4 (cg-emit st3 "    cmp rax, ")
        (cg-nl (cg-emit-int st4 tag))))))

; Bind pattern variables: field j of [rsp]'s block goes into a fresh slot.
; "_" wildcards are skipped by codegen. Returns: CGE (state + extended env).
(defn cg-bind-fields (st env binds j)
  (if (is-nil binds)
    (CGE st env)
    (cg-bind-one st env binds j)))

(defn cg-bind-one (st env binds j)
  (let st2 (cg-load-field st j)
    (let b (shd binds)
      (if (str-eq b (str-intern (cg-arena-of st) "_"))
        (cg-bind-fields st2 env (tl2 binds) (+ j 1))
        (cg-bind-slot st2 env binds j b)))))

(defn cg-bind-slot (st env binds j b)
  (match (cg-new-slot st)
    (CGR st3 off _
      (cg-bind-store st3 env binds j b off))))

(defn cg-bind-store (st env binds j b off)
  (let st4 (cg-store-rax-slot st off)
    (cg-bind-fields st4 (EnvBind b off 0 env) (tl2 binds) (+ j 1))))

; Load field j of the block at [rsp]: rax = [[rsp] + 8*(j+1)].
(defn cg-load-field (st j)
  (let st2 (cg-emit-line st "    mov rax, [rsp]")
    (let st3 (cg-emit st2 "    mov rax, [rax+")
      (let st4 (cg-emit-int st3 (* 8 (+ j 1)))
        (cg-nl (cg-emit st4 "]"))))))

(defn cg-store-rax-slot (st off)
  (let st2 (cg-emit st "    mov [rbp")
    (let st3 (cg-emit-int st2 off)
      (cg-nl (cg-emit st3 "], rax")))))

(defn cg-emit-label (st lbl)
  (cg-nl (cg-emit (cg-emit st lbl) ":")))

; ===========================================================================
; TRY / CATCH — inline setjmp/longjmp via the runtime's existing panic-
; frame stack (zyl_try_push/zyl_try_pop/zyl_panic, added for the test
; harness's own recovery, never wired to anything else until now).
;
; `error` (allocator.zyl) now calls zyl_panic, which — if a frame is
; active — pops it and longjmps to its buffer instead of exiting.
; setjmp/longjmp only work correctly when the function that calls
; setjmp is still on the stack when the corresponding longjmp fires, so
; setjmp is called INLINE here in the generated code itself, not via an
; FFI wrapper function (which would return and pop its own frame before
; any later longjmp could target it).
;
; Every bare `call` below (zyl_try_push/setjmp/zyl_try_pop/
; zyl_try_frame_msg) is wrapped in cg-call0-aligned's save-rsp/and-16/
; restore dance, mirroring cg-variant's own alignment fix elsewhere in
; this file — this call site's own stack depth (mid-expression, with
; earlier pushes already live) isn't guaranteed 16-aligned otherwise.
; This is safe across the longjmp specifically because setjmp/longjmp's
; whole contract is to save and restore every callee-saved register
; (including r12, used here to stash the pre-alignment rsp) as of the
; setjmp call site — the "mov rsp, r12" right after `call setjmp`
; behaves identically whether we got there by falling through or by
; landing via a later longjmp, regardless of what r12 held in between.
(defn cg-call0-aligned (st sym)
  (let st2 (cg-emit-line st "    mov r12, rsp")
    (let st3 (cg-emit-line st2 "    and rsp, -16")
      (let st4 (cg-emit-line st3 (str-concat "    call " sym))
        (cg-emit-line st4 "    mov rsp, r12")))))

(defn cg-trycatch (st env tbody cvar cbody)
  (match (cg-label-pair st)
    (CGP st1 lcatch ldone
      (match (cg-new-slot st1)
        (CGR st2 cvar-off _
          (cg-trycatch-emit st2 env tbody cvar cbody lcatch ldone cvar-off))))))

(defn cg-trycatch-emit (st env tbody cvar cbody lcatch ldone cvar-off)
  ; The frame ptr lives in cvar's slot: a stack word would be overwritten by the body's call args.
  (let st2 (cg-call0-aligned st "zyl_try_push")
    (let st3 (cg-store-rax-slot st2 cvar-off)
      (let st4 (cg-emit-line st3 "    mov rdi, rax")
        (let st5 (cg-call0-aligned st4 "setjmp")
          (let st6 (cg-emit-line st5 "    cmp rax, 0")
            (let st7 (cg-emit st6 "    jne ")
              (let st8 (cg-nl (cg-emit st7 lcatch))
                (cg-trycatch-try st8 env tbody cvar cbody lcatch ldone cvar-off)))))))))

; setjmp returned 0: run the body, then pop our frame so a later error doesn't unwind here.
(defn cg-trycatch-try (st env tbody cvar cbody lcatch ldone cvar-off)
  (let st3 (cg-expr st env tbody)
    (let st4 (cg-emit-line st3 "    push rax")
      (let st5 (cg-call0-aligned st4 "zyl_try_pop")
        (let st6 (cg-emit-line st5 "    pop rax")
          (let st7 (cg-emit st6 "    jmp ")
            (let st8 (cg-nl (cg-emit st7 ldone))
              (let st9 (cg-emit-label st8 lcatch)
                (cg-trycatch-catch st9 env cbody cvar ldone cvar-off)))))))))

; Landed via longjmp (zyl_panic already popped our frame): read its message
; through the frame ptr kept in cvar's slot, then bind cvar to it.
(defn cg-trycatch-catch (st env cbody cvar ldone cvar-off)
  (let st2 (cg-while-load st cvar-off)
    (let st3 (cg-emit-line st2 "    mov rdi, rax")
      (let st4 (cg-call0-aligned st3 "zyl_try_frame_msg")
        (let st5 (cg-store-rax-slot st4 cvar-off)
          (let st6 (cg-expr st5 (EnvBind cvar cvar-off 0 env) cbody)
            (cg-emit-label st6 ldone)))))))

; ===========================================================================
; FUNCTION / PROGRAM EMISSION
; ===========================================================================

; ─── Frame sizing ────────────────────────────────────────────────────────
; Upper bound on stack slots a function needs: total Icnf nodes in its
; body (every node may own one 8-byte slot). Keeps frames small so deep
; recursion in the compiler stays within the machine stack.

; NOTE: match-arm bodies must stay SINGLE expressions (one call or one
; binop-with-one-call). The Rust bootstrap (now archived) dropped
; computations when a match-arm body combined a constant with MULTIPLE
; calls (seen as frames collapsing to minimum size in stage>=2
; binaries). Hence these helpers.
(defn icnf-add2 (a b) (+ a b))
(defn icnf-add3 (a b c) (+ a (+ b c)))

(defn icnf-size (e)
  (match e
    (IConst _ 1)
    (IStr _ 1)
    (ISymAddr _ 1)
    (IFlt _ 1)
    (ILoad _ 1)
    (IBinop _ l r (icnf-add3 3 (icnf-size l) (icnf-size r)))
    (ICall _ args (icnf-add2 2 (icnf-count-list args)))
    (IFfi _ args (icnf-add2 2 (icnf-count-list args)))
    (IPrint a (+ 1 (icnf-size a)))
    (IIf c t eb (icnf-add3 4 (icnf-size c) (icnf-add2 (icnf-size t) (icnf-size eb))))
    (IWhile c b (icnf-add3 3 (icnf-size c) (icnf-size b)))
    (ISet _ v (+ 2 (icnf-size v)))
    (ILet _ v b (icnf-add3 3 (icnf-size v) (icnf-size b)))
    (ISeq es (+ 1 (icnf-count-list es)))
    (IVariant _ _ fields (+ 1 (icnf-count-list fields)))
    (IStackVariant _ _ fields (+ 1 (icnf-count-list fields)))
    (IMatch scr arms (icnf-add3 2 (icnf-size scr) (icnf-count-arms arms)))
    (IFn _ _ _ 1)
    (ICallClosure _ args (icnf-add2 2 (icnf-count-list args)))
    (ITryCatch tbody _ cbody (icnf-add3 4 (icnf-size tbody) (icnf-size cbody)))
    (IRegion _ _ _ _ body (+ 2 (icnf-size body)))))

(defn icnf-count-list (xs)
  (match xs
    (Nil 0)
    (Cons h t (+ (icnf-size h) (icnf-count-list t)))))

; Static slot-count estimate: every runtime `cg-new-slot` corresponds to
; exactly one ILet node or one non-wildcard pattern bind, allocated once
; during codegen (branches accumulate, never reuse). Frames are now sized
; from this instead of the uniform 16*(64+icnf-size) waste.
(defn icnf-slot-count (e)
  (match e
    (IConst _ 0)
    (IStr _ 0)
    (ISymAddr _ 0)
    (IFlt _ 0)
    (ILoad _ 0)
    (IBinop _ l r (icnf-add2 (icnf-slot-count l) (icnf-slot-count r)))
    (ICall _ args (icnf-count-slots-list args))
    (IFfi _ args (icnf-count-slots-list args))
    (IPrint a (icnf-slot-count a))
    (IIf c t eb (icnf-add3 (icnf-slot-count c) (icnf-slot-count t) (icnf-slot-count eb)))
    (IWhile c b (+ 1 (icnf-add2 (icnf-slot-count c) (icnf-slot-count b))))
    (ISet _ v (icnf-slot-count v))
    (ILet _ v b (+ 1 (icnf-add2 (icnf-slot-count v) (icnf-slot-count b))))
    (ISeq es (icnf-count-slots-list es))
    (IVariant _ _ fields (icnf-count-slots-list fields))
    ; +1 slot for the block base plus one per field, on top of each
    ; field's own subexpression slots -- this block is reserved as
    ; (n+1) CONSECUTIVE cg-new-slot calls (cg-reserve-block), unlike
    ; IVariant's fields (which only ever need scratch slots transiently
    ; during heap-alloc staging, already counted by icnf-count-slots-list
    ; alone).
    (IStackVariant _ _ fields (icnf-add2 (+ 1 (list-length fields)) (icnf-count-slots-list fields)))
    (IMatch scr arms (icnf-add2 (icnf-slot-count scr) (icnf-count-arm-slots arms)))
    (IFn _ _ _ 0)
    (ICallClosure _ args (icnf-count-slots-list args))
    (ITryCatch tbody _ cbody (+ 1 (icnf-add2 (icnf-slot-count tbody) (icnf-slot-count cbody))))
    ; The region header (cg-region-scope): ten consecutive slots, and
    ; one for the body's value across the release call.
    (IRegion _ _ _ _ body (+ 11 (icnf-slot-count body)))))

(defn icnf-count-slots-list (xs)
  (if (is-nil xs)
    0
    (icnf-add2 (icnf-slot-count (hd-icnf xs)) (icnf-count-slots-list (tl2 xs)))))

(defn icnf-count-arm-slots (arms)
  (if (is-nil arms)
    0
    (icnf-arm-slots (hd-ia arms) (tl2 arms))))

(defn icnf-arm-slots (arm rest)
  ; binops never combine two direct calls here (constraint 8).
  (match arm
    (IArm _ _ binds body
      (icnf-add2 (icnf-binds-slots binds 0)
                 (icnf-add2 (icnf-slot-count body) (icnf-count-arm-slots rest))))))

; Count of non-wildcard pattern binds (each gets exactly one slot).
(defn icnf-binds-slots (binds acc)
  (if (is-nil binds)
    acc
    (icnf-binds-slots (tl2 binds)
                      (+ acc (icnf-bind-real (shd binds))))))

(defn icnf-bind-real (b)
  ; exact "_" (length 1, byte '_') gets no slot in cg-bind-one
  (if (= (alloc-strlen b) 1)
    (if (= (byte-at b 0) 95) false true)
    true))

(defn icnf-count-arms (xs)
  (if (is-nil xs)
    0
    (icnf-arm-size (hd-ia xs) (tl2 xs))))

(defn icnf-arm-size (arm rest)
  ; Match-arm bodies must contain at most ONE call (see icnf-add2 note);
  ; nest the sum through helpers.
  (match arm
    (IArm _ _ _ body
      (icnf-add2 1 (icnf-add2 (icnf-size body) (icnf-count-arms rest))))))

(defn cg-function (st f)
  ; Extract the IFn fields via tiny two-arm helpers: a trailing catch-all
  ; arm on this single large IFn arm was dropped between macro expand and
  ; icnf, leaving only the first arm and tripping exhaustiveness.
  (if
    (ifn-tag-p f)
    (let name (ifn-tag-name f)
      (let params (ifn-tag-params f)
        (let body (ifn-tag-body f)
     (let rflags (cg-region-flags f)
     (let env (cg-param-env-s params (ifn-tag-kinds f) 0 (cg-region-shift rflags) (EnvNil))
; Frame sized from actual slot usage: param slots + one per ILet /
        ; non-wildcard pattern bind (+ headroom), rounded to 16 bytes.
        ; The old uniform 16*(64+icnf-size) wasted ~16x stack.
        (let nslots (icnf-add2 (+ (list-length params) (cg-region-shift rflags))
                               (+ (icnf-slot-count body) 8))
          ; 16*(1 + ns/2) >= 8*ns and stays 16-byte aligned
          ; Entry rsp is 8 mod 16 (after push rbp), so fsz must be 16n+8.
          ; The extra 16 bytes at the bottom of the frame hold the
          ; caller's rbx and r12 (see cg-save-callee-saved).
          (let fsz (+ 24 (* 16 (+ 1 (/ nslots 2))))
          (let st1 st
           (let st2 (cg-emit st1 (cg-sym-mangled (cg-arena-of st) name))
             (let st3 (cg-emit-line st2 ":")
               (let st4 (cg-emit-line st3 "    push rbp")
                 (let st5 (cg-emit-line st4 "    mov rbp, rsp")
                   (let st6 (cg-emit st5 "    sub rsp, ")
                     (let st7 (cg-save-callee-saved (cg-nl (cg-emit-int st6 fsz)) fsz)
                       (let st8 (cg-region-prologue (cg-param-spills-s st7 0 (list-length params) (cg-region-shift rflags)) rflags)
                         ; per-function slot counter reset after params
                         (let st9 (cg-reset-slots st8 (* 8 (+ 1 (+ (list-length params) (cg-region-shift rflags)))))
                            (let st10 (cg-body-exit st9 env body fsz (list-length params) (cg-wipes-frame name) rflags)
                              (let st11 (cg-emit-line st10 "    mov rsp, rbp")
                                (let st12 (cg-emit-line st11 "    pop rbp")
                                  (cg-emit-line st12 "    ret"))))))))))))))))))))
    st))

; A function secret_check.zyl marked (Secret params or secret lets) zeroes its
; whole frame on return and makes no tail calls, so no copy outlives the call.
(defn cg-wipes-frame (name)
  (> (ffi-call "zyl_smap_get" (ffi-call "zyl_smap_global" 4 1000) (str-concat "w|" (cg-base-name name 0)) 1000) 0))

; A specialized instance `f~T` is wiped like `f`.
(defn cg-base-name (n i)
  (if (>= i (ffi-call "zyl_cstr_len" n 1000))
    n
    (if (= (ffi-call "zyl_cstr_byte_at" n i 1000) 126)
      (str-substring n 0 i)
      (cg-base-name n (+ i 1)))))

(defn cg-body-exit (st env body fsz np wipe rflags)
  (if wipe
    (cg-wipe-frame (cg-restore-callee-saved (cg-region-epilogue (cg-expr st env body) rflags) fsz) fsz)
    (cg-restore-callee-saved (cg-region-epilogue (cg-tail st env body (cg-tail-tl-r fsz np rflags)) rflags) fsz)))

; rep stosq over [rbp-fsz, rbp), keeping the result in r11 meanwhile.
(defn cg-wipe-frame (st fsz)
  (let st2 (cg-emit-line st "    mov r11, rax")
    (let st3 (cg-emit-line (cg-emit-int (cg-emit st2 "    lea rdi, [rbp-") fsz) "]")
      (let st4 (cg-emit-line (cg-emit-int (cg-emit st3 "    mov ecx, ") (/ fsz 8)) "")
        (let st5 (cg-emit-line st4 "    xor eax, eax")
          (let st6 (cg-emit-line st5 "    rep stosq")
            (cg-emit-line st6 "    mov rax, r11")))))))

; SysV makes rbx and r12-r15 callee-saved. Generated code uses rbx (the
; block pointer in cg-variant) and r12 (the saved rsp around every
; aligned C call, cg-ext-call-aligned / cg-print-call / cg-variant /
; setjmp), and nothing else in that set. Zyl-to-Zyl calls never rely on
; either surviving a call, but C does: a Zyl function is entered from C
; as main's big-stack worker, as a test body under zyl_run_tests, as an
; actor entry, and as any callback handed to a C function (qsort's
; comparator), and a C caller compiled with optimization keeps live
; values in these registers across the call. So every generated function
; saves both in the two lowest words of its frame and restores them
; before returning. The pair lives below every local slot, where no
; slot offset reaches.
(defn cg-save-callee-saved (st fsz)
  (let st2 (cg-emit-int (cg-emit st "    mov [rbp-") fsz)
    (let st3 (cg-emit-line st2 "], rbx")
      (let st4 (cg-emit-int (cg-emit st3 "    mov [rbp-") (- fsz 8))
        (cg-emit-line st4 "], r12")))))

(defn cg-restore-callee-saved (st fsz)
  (let st2 (cg-emit-int (cg-emit st "    mov rbx, [rbp-") fsz)
    (let st3 (cg-emit-line st2 "]")
      (let st4 (cg-emit-int (cg-emit st3 "    mov r12, [rbp-") (- fsz 8))
        (cg-emit-line st4 "]")))))

(defn ifn-tag-p (f)
  (match f
    (IFn a b c true)
    (_ false)))

(defn ifn-tag-name (f)
  (match f
    (IFn a b c a)
    (_ "a-name")))

(defn ifn-tag-params (f)
  (match f
    (IFn a b c b)
    (_ (no-strs))))

(defn ifn-tag-body (f)
  (match f
    (IFn a b c c)
    (_ (no-icnfs))))

; Declared representation kind per parameter (see icnf.zyl's IFn).
(defn ifn-tag-kinds (f)
  (match f
    (IFn a b c k k)
    (_ Nil)))

(defn cg-reset-slots (st next-off)
  (match st
    (CGS a b n _ rd fns (CGS a b n next-off rd fns))))

; Immutable param environment: param i -> offset -(8*(i+1)), carrying
; the declared kind so a String or Float parameter is emitted as one.
; A kind list shorter than the param list (a lambda's, which is empty)
; simply falls back to 0, the behaviour before kinds existed.
(defn cg-param-env-s (params kinds i shift acc)
  (if (is-nil params)
    acc
    (cg-param-env-s (tl2 params) (cg-kinds-tail kinds) (+ i 1) shift
                    (EnvBind (shd params) (- (* 8 (+ i (+ shift 1))))
                             (cg-kinds-head kinds) acc))))

(defn cg-param-env (params kinds i acc)
  (if (is-nil params)
    acc
    (cg-param-env (tl2 params) (cg-kinds-tail kinds) (+ i 1)
                  (EnvBind (shd params) (- (* 8 (+ i 1)))
                           (cg-kinds-head kinds) acc))))

(defn cg-kinds-head (kinds)
  (match kinds
    (Cons h _ h)
    (Nil 0)))

(defn cg-kinds-tail (kinds)
  (match kinds
    (Cons _ t t)
    (Nil Nil)))

; The same, with the parameter slots starting `shift` words further down.
(defn cg-param-spills-s (st i n shift)
  (if (or (>= i n) (= shift 0))
    (if (>= i n) st (cg-param-spills st i n))
    (let st2 (if (< i 6)
               (cg-emit st "    mov r10, ")
               (cg-emit (cg-emit-int (cg-emit st "    mov r10, [rbp+") (+ 16 (* 8 (- i 6)))) "]"))
      (let st3 (if (< i 6) (cg-emit st2 (cg-reg-of i)) st2)
        (let st4 (cg-emit-int (cg-emit (cg-nl st3) "    mov [rbp") (- (* 8 (+ i (+ shift 1)))))
          (cg-param-spills-s (cg-nl (cg-emit st4 "], r10")) (+ i 1) n shift))))))

; Spill incoming args to param slots: indices 0..5 from SysV registers,
; indices >= 6 from the caller's stack frame ([rbp+16] is stack arg 6).
(defn cg-param-spills (st i n)
  (if (>= i n)
    st
    (if (< i 6)
      (cg-param-spill-reg st i n)
      (cg-param-spill-stack st i n))))

(defn cg-param-spill-reg (st i n)
  (let st2 (cg-emit st "    mov [rbp")
    (let st3 (cg-emit-int st2 (- (* 8 (+ i 1))))
      (let st4 (cg-emit st3 "], ")
        (let st5 (cg-emit st4 (cg-reg-of i))
          (cg-param-spills (cg-nl st5) (+ i 1) n))))))

(defn cg-param-spill-stack (st i n)
  (let st2 (cg-emit st "    mov r10, [rbp+")
    (let st3 (cg-emit-int st2 (+ 16 (* 8 (- i 6))))
      (let st4 (cg-emit st3 "]")
        (let st5 (cg-nl st4)
          (let st6 (cg-emit st5 "    mov [rbp")
            (let st7 (cg-emit-int st6 (- (* 8 (+ i 1))))
              (let st8 (cg-emit st7 "], r10")
                (cg-param-spills (cg-nl st8) (+ i 1) n)))))))))

; Emit the whole program: header, functions, entry stub, format strings,
; rodata. Functions are emitted in lowering order (source order); the
; entry stub calls f_main, which the lowering guarantees exists.
; Returns: final CGState (retrieve the buffer with cg-buffer).
; Record every top-level defn name so function-value references
; (higher-order arguments) resolve to addresses.
(defn cg-collect-fnnames (st fns)
  (if (is-nil fns)
    st
    (cg-collect-one st (fnhead-if fns) (tl2 fns))))

; Head of a List(IFunc); empty placeholder when exhausted.
(defn fnhead-if (xs)
  (list-head-or xs (IFn "" Nil (IConst 0) Nil)))

; A function's recorded return kind is read off its body. That body is
; measured in an environment holding its own parameters, so a function
; that returns a String or Float parameter is recorded as returning one
; rather than defaulting to Int.
(defn cg-collect-one (st f rest)
  (match f
    (IFn nm ps body ks
      (cg-collect-fnnames
        (cg-with-fnname st nm (kind-of st (cg-param-env ps ks 0 (EnvNil)) body))
        rest))
    (_ (cg-collect-fnnames st rest))))

(defn cg-program (st fns)
  (let st0 (cg-collect-fnnames st fns)
    (cg-program-run st0 fns)))

;; Like cg-program, but first names the assembly's source with a fixed
;; `.file "<basename>"` directive. Without one, the assembler records no
;; FILE symbol and the linker substitutes the name of the object file
;; `cc` compiled into, which is a fresh random /tmp/ccXXXXXX.o on every
;; build: two builds of the same source differed by those bytes in the
;; symbol table. The basename (never the full path) keeps the output
;; independent of where the checkout lives.
(defn cg-program-file (st fns srcpath)
  (let st1 (cg-emit st ".file \"")
    (let st2 (cg-emit st1 (cg-file-name srcpath))
      (cg-program (cg-emit-line st2 "\"") fns))))

;; Basename of `path`, or "main.zyl" when it is empty or holds a byte that
;; would need escaping inside a GAS string (a quote, a backslash, a
;; control character).
(defn cg-file-name (path)
  (let len (ffi-call "zyl_cstr_len" path 1000)
    (let start (cg-after-last-slash path 0 0 len)
      (if (>= start len)
        "main.zyl"
        (if (cg-file-name-bad path start len)
          "main.zyl"
          (str-substring path start (- len start)))))))

(defn cg-after-last-slash (path i acc len)
  (if (>= i len)
    acc
    (if (= (ffi-call "zyl_cstr_byte_at" path i 1000) 47)
      (cg-after-last-slash path (+ i 1) (+ i 1) len)
      (cg-after-last-slash path (+ i 1) acc len))))

(defn cg-file-name-bad (path i len)
  (if (>= i len)
    false
    (let c (ffi-call "zyl_cstr_byte_at" path i 1000)
      (if (< c 32)
        true
        (if (= c 34)
          true
          (if (= c 92)
            true
            (cg-file-name-bad path (+ i 1) len)))))))

(defn cg-program-run (st fns)
  (let st1 (cg-header st)
    (let st2 (cg-functions st1 fns)
      (let st3 (cg-entry-stub st2)
        (let st4 (cg-format-strings st3)
          (cg-rodata-emit-list st4 (cg-reverse-rodata (cg-rodata-of st4))))))))

; Reverse the collected rodata list so entries emit in creation order.
(defn cg-reverse-rodata (xs)
  (cg-rev-acc xs (no-rentries)))

(defn cg-rev-acc (xs acc)
  (match xs
    (Nil acc)
    (Cons h t (cg-rev-acc t (Cons h acc)))))

(defn cg-header (st)
  (let st1 (cg-emit-line st ".intel_syntax noprefix")
    (let st2 (cg-emit-line st1 ".text")
      (cg-emit-line st2 ".globl main"))))

(defn cg-entry-stub (st)
  ; Run user main on a big-stack worker thread (C runtime helper): the
  ; self-hosted compiler recurses deeply while parsing large inputs.
  ;
  ; MUST call zyl_ensure_arenas@plt before any allocation happens (it
  ; sets the global g_heap_arena/g_pin_arena used by zyl_heap_alloc,
  ; which backs str-concat/str-substring/str-length and every other
  ; heap-allocating builtin). This mirrors codegen.rs's entry stub,
  ; which always emits this call. This self-hosted stub used to omit
  ; it entirely, leaving g_heap_arena permanently NULL for any binary
  ; produced by this codegen — every heap-allocating builtin silently
  ; returned 0 (null) from zyl_heap_alloc's `!g_heap_arena` guard, and
  ; the first caller to actually dereference that null buffer (here,
  ; zyl_cstr_substr's memcpy into a null `buf`) segfaulted deep into
  ; the run instead of failing at start.
  ; edi=argc, rsi=argv at entry (SysV main ABI) — save them via
  ; zyl_save_args BEFORE any other call (which would clobber the
  ; caller-saved edi/rsi), so driver.zyl's zyl_argc/zyl_arg_str FFI
  ; helpers can see the real argv later in the run.
  ;
  ; zyl_call_on_big_stack's return value (user main's real return
  ; value, via g_bigstack_result) now becomes this process's actual
  ; exit code -- this used to zero eax here unconditionally, silently
  ; discarding it for every Zyl program ever compiled by this codegen.
  ; That was only safe because print (this language's overwhelmingly
  ; common tail expression) used to leave printf's own return value in
  ; rax, an arbitrary byte count with no relation to program correctness
  ; -- exactly what broke tests/regression/generics-multi-type.zyl the
  ; first time this zeroing was removed without also fixing print. Now
  ; that cg-print always leaves a clean 0 (see its own comment), a
  ; `main` whose tail is print exits 0 as expected, and one whose tail
  ; returns a nonzero Int exits with it. Top-level (run-tests) does NOT
  ; get this: the implicit `main` icnf.zyl's ic-finish-program builds
  ; around top-level statements ends in a constant 0, so zyl_run_tests'
  ; pass/fail result (actor_runtime.c: 0 if all passed, 1 if any failed)
  ; is discarded and a failing test file still exits 0.
  (let st1 (cg-emit-line st "main:")
    (let st2 (cg-emit-line st1 "    push rbp")
      (let st3 (cg-emit-line st2 "    mov rbp, rsp")
        (let st3a (cg-emit-line st3 "    call zyl_save_args")
          (let st3b (cg-emit-line st3a "    call zyl_ensure_arenas")
            (let st4 (cg-emit-line st3b "    lea rdi, [rip+_ZYL_main]")
              (let st5 (cg-emit-line st4 "    call zyl_call_on_big_stack")
                  (let st7 (cg-emit-line st5 "    pop rbp")
                    (let st8 (cg-emit-line st7 "    ret")
                      st8))))))))))

(defn cg-format-strings (st)
  (let st1 (cg-emit-line st ".section .rodata")
    (let st2 (cg-emit-line st1 ".Lfmtd:")
      ; %lld, not %d: an Int is a 64-bit machine word, and printf
      ; reading only 32 bits of it silently truncated every value at or
      ; above 2^31 (a hash constant, a large product, any pointer-shaped
      ; value) to a wrong, usually negative, number.
      (let st3 (cg-emit-line st2 "    .string \"%lld\\n\"")
        (let st4 (cg-emit-line st3 ".Lfmtf:")
          (let st5 (cg-emit-line st4 "    .string \"%f\\n\"")
            (let st6 (cg-emit-line st5 ".Lfmts:")
              (cg-emit-line st6 "    .string \"%s\\n\""))))))))

(defn cg-dbg (msg)
  (let f (file-open "/tmp/dbg2" "a")
    (let _ (file-write f msg)
      (file-close f))))

(defn cg-functions (st fns)
  (if (is-nil fns)
    st
    (cg-functions-step st (fh-if fns) (tl2 fns))))

(defn cg-functions-step (st f rest)
  (match f
    (IFn nm params body
      (cg-functions-go st nm f rest))
    (_ (cg-functions st rest))))

(defn cg-functions-go (st _nm f rest)
  (cg-functions (cg-function st f) rest))

; Emit one rodata entry.
(defn cg-rodata-entry (st e)
  (match e
    (REntry lbl text kind
      (if (= kind 0)
        (cg-str-entry st lbl text)
        (cg-flt-entry st lbl text)))))

; Escape a string for a .string directive: backslash and quote doubled,
; everything else copied verbatim. Deterministic left-to-right.
(defn cg-escape (arena s)
  (let n (alloc-strlen s)
    (buf-str (cg-esc-loop arena s n 0 (buf-new arena (+ (* 2 n) 1))))))

(defn cg-esc-loop (arena s n i out)
  (if (>= i n)
    out
    (cg-esc-ch arena s n i out (byte-at s i))))

(defn cg-esc-ch (arena s n i out c)
  (if (= c 92)
    (cg-esc-both arena s n i out c)
    (if (= c 34)
      (cg-esc-quote arena s n i out c)
      (if (= c 10)
        (cg-esc-newline arena s n i out)
        (cg-esc-one arena s n i out c)))))

(defn cg-esc-one (arena s n i out _c)
  (begin
    (buf-append out (sub-str arena s i 1))
    (cg-esc-loop arena s n (+ i 1) out)))

(defn cg-esc-both (arena s n i out _c)
  (begin
    (buf-append out (sub-str arena s i 1))
    (buf-append out (sub-str arena s i 1))
    (cg-esc-loop arena s n (+ i 1) out)))

(defn cg-esc-quote (arena s n i out _c)
  (begin
    (buf-append out (str-intern arena "\\"))
    (buf-append out (sub-str arena s i 1))
    (cg-esc-loop arena s n (+ i 1) out)))

(defn cg-esc-newline (arena s n i out)
  (begin
    (buf-append out (str-intern arena "\\"))
    (buf-append out (str-intern arena "n"))
    (cg-esc-loop arena s n (+ i 1) out)))

(defn cg-str-entry (st lbl content)
  (let st2 (cg-label-def st lbl)
    (let st4 (cg-emit st2 "    .string \"")
      (let st5 (cg-emit st4 (cg-escape (cg-arena-of st) content))
        (cg-nl (cg-emit st5 "\""))))))

; Emit "<label>:" on one line.
(defn cg-label-def (st lbl)
  (cg-nl (cg-emit (cg-emit st lbl) ":")))

(defn cg-flt-entry (st lbl text)
  (let st2 (cg-label-def st lbl)
    (let st4 (cg-emit st2 "    .double ")
      (cg-nl (cg-emit st4 text)))))

(defn cg-rodata-emit-list (st xs)
  (match xs
    (Nil st)
    (Cons e rest
      (let st2 (cg-rodata-entry st e)
        (cg-rodata-emit-list st2 rest)))))
; ===========================================================================
; TYPED LIST HEADS/TAILS (total via fallback values)
; ===========================================================================

; Shared polymorphic list head (constraint 6 lifted: per-site generic
; inference makes one shared helper safe across element types).
(defn list-head-or (xs default)
  (match xs
    (Cons a _ a)
    (Nil default)))

(defn ih-ic (xs)
  (list-head-or xs (IConst 0)))

(defn fh-if (xs)
  (list-head-or xs (IFn "" Nil (IConst 0) Nil)))

(defn hd-ia (xs)
  (list-head-or xs (IArm "" -1 Nil (IConst 0))))

; Head of a list of Icnf nodes (distinct from hd-ia: IArm lists).
(defn hd-icnf (xs)
  (match xs
    (Cons a d74a a)
    (Nil (IConst 0))))

(defn cg-arena-of (st)
  (match st
    (CGS a _ _ _ _ _ a)))

(defn tl2 (xs)
  (match xs
    (Cons a rest rest)
    (Nil Nil)))
