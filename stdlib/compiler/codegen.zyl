; === Zyl Standard Library — Self-Hosting: x86_64 codegen ===
; Module: compiler/codegen
;
; Walks the recursive Icnf instruction tree (see compiler/icnf) and emits
; GAS .intel_syntax noprefix assembly text. Expression code is evaluated
; into rax (a pure stack-machine discipline): every sub-expression leaves
; its value in rax; binary operators push the left operand around the
; right operand's evaluation.
;
; Conventions:
;   - Parameters arrive in SysV registers (rdi rsi rdx rcx r8 r9) and are
;     spilled to [rbp-8*(i+1)] in the prologue.
;   - Locals (let / match bindings) get slots from a downward-growing
;     offset counter carried in the emitter state.
;   - Names are resolved through an immutable Env chain (see ast.zyl).
;   - Calls support up to 6 register arguments; argument values are pushed
;     and popped in reverse so evaluation order stays strictly
;     left-to-right (spec evaluation-order rule).
;   - Floats travel as bit patterns in rax and move to xmm0/xmm1 for SSE
;     arithmetic; print selects %d/%f/%s by the operand's kind.
;
; Emitter state is an immutable CGState threaded functionally through
; every emitter function (no mutable records, no raw cells):
;   CGState = (CGS arena buffer next-label next-slot rodata)
; Two-value results use small wrapper ADTs:
;   CGR = state + int + string  (fresh labels / slot offsets)
;   CGE = state + env           (match-binding sequences)
;
; Bootstrap constraint note: pattern wildcards must be named dummies
; (`dN`) because the Rust bootstrap miscompiles bare `_` patterns.

(use allocator/allocator)
(use compiler/ast)
(use compiler/icnf)
; shd (compiler/resolver.zyl) is called below (cg-bind-one/
; icnf-binds-slots/cg-param-env) but was never declared as a real
; dependency -- harmless for the assemble.py bundle (every `use` line
; is stripped there, and resolver.zyl is always inlined into the same
; bundle regardless), but a standalone program that `use`s
; compiler/codegen directly as a library (e.g.
; integration/selfhost-codegen.zyl) got an undefined reference to
; f_shd at link time since the module resolver had no way to know to
; pull resolver.zyl in too.
(use compiler/resolver)

; --- Emitter state ----------------------------------------------------------

; One rodata entry: label, payload text, kind (0 string, 1 float).
(deftype REntry (REntry String String Int))

; Known top-level function names (for fn-value references), plus each
; one's own body kind (see kind-of's ICall arm and cg-collect-one,
; below) -- 0 (int) for anything not staticaly known to be a fixed
; string/float shape.
(deftype FnName (FN String Int) FNNil)

(deftype CGState (CGS Int Int Int Int (List REntry) (List FnName)))
; fields: arena, buffer, next-label, next-slot, rodata, fn-names, fn names
; fields: arena, text buffer, next label number, next slot offset,
; known top-level function names

(deftype CGR (CGR CGState Int String))

(deftype CGE (CGE CGState Env))

; Result wrapper: state + two labels.
(deftype CGP (CGP CGState String String))

; Allocate two consecutive labels. Each match is the entire body of its
; own defn (nested matches miscompile in the current bootstrap).
(defn cg-label-pair (st)
  (cg-label-pair-2 (cg-label-new st)))

(defn cg-label-pair-2 (r1)
  (match r1
    (CGR st1 d1 la (cg-label-second st1 la))))

(defn cg-label-second (st1 la)
  (match (cg-label-new st1)
    (CGR st2 d2 lb (CGP st2 la lb))))

(defn no-fnnames () None)


; Codegen text buffer: 64MB, zero-initialized (buf-append appends at
; strlen, so the zero fill terminates every intermediate string). The
; driver checks the final length against E_CODEGEN_BUFFER_LIMIT after
; emission — overflow would otherwise corrupt the arena silently.
(defn cg-new (arena)
  (let buf (arena-alloc-zeroed arena 67108864)
    (CGS arena buf 0 8 (no-rentries) (no-fnnames))))   ; slots 1..n

(defn cg-with-fnname (st nm kind)
  (match st
    (CGS a b n s rd fns2
      (CGS a b n s rd (Cons (FN nm kind) fns2)))))

(defn cgg-fns (st)
  (match st
    (CGS d70 d71 d72 d73 d74 fns fns)))

; True when `nm` is a known top-level function name.
(defn cg-fn-known (st nm)
  (cg-fn-search (cgg-fns st) nm))

(defn cg-fn-search (fns nm)
  (if (is-nil fns)
    0
    (cg-fn-check-head (fnhead fns) (fntail fns) nm)))

; Head of a List(FnName); FNNil when empty.
(defn fnhead (xs)
  (match xs
    (Cons h d h)
    (Nil (FNNil))))

; Tail of a List(FnName); empty when empty.
(defn fntail (xs)
  (match xs
    (Cons h d d)
    (Nil None)))

(defn cg-fn-check-head (h t nm)
  (match h
    (FN s d1 (if (= (str-eq s nm) 1) 1 (cg-fn-search t nm)))
    (FNNil (cg-fn-search t nm))))

; Look up `nm`'s recorded return kind; 0 (int) if it's not a known
; top-level function name at all (matches every other "not found"
; default in this file).
(defn cg-fn-kind-search (fns nm)
  (if (is-nil fns)
    0
    (cg-fn-kind-check-head (fnhead fns) (fntail fns) nm)))

(defn cg-fn-kind-check-head (h t nm)
  (match h
    (FN s k (if (= (str-eq s nm) 1) k (cg-fn-kind-search t nm)))
    (FNNil (cg-fn-kind-search t nm))))

; Empty rodata list.
(defn no-rentries () Nil)

(defn cg-buffer (st)
  (match st
    (CGS d1 buf d2 d3 d4 d5 buf)))

(defn cg-with-rodata (st entry)
  (match st
    (CGS a b n s rd fns
      (CGS a b n s (Cons entry rd) fns))))

(defn cg-emit (st s)
  (match st
    (CGS d6 buf d7 d8 d9 d10
      (begin (buf-append buf s) st))))

(defn cg-emit-int (st n)
  (match st
    (CGS arena buf d10 d11 d12 d13
      (begin
        (buf-append buf (ffi-call "zyl_cstr_from_int" arena n 1000))
        st))))

(defn cg-nl (st)
  (cg-emit st "
"))

; Fresh label .L<N>.
; Returns: CGR (advanced state; string field carries the label text).
(defn cg-label-new (st)
  (match st
    (CGS arena buf n slot rd fns
      (let lblbuf (arena-alloc-zeroed arena 32)
        (begin
          (buf-append lblbuf (str-intern arena ".L"))
          (buf-append lblbuf (ffi-call "zyl_cstr_from_int" arena n 1000))
          (CGR (CGS arena buf (+ n 1) slot rd fns) 0 lblbuf))))))

; Allocate one 8-byte local slot.
; Returns: CGR (advanced state; int field carries the rbp offset, negative).
(defn cg-new-slot (st)
  (match st
    (CGS a b n off rd fns
      (CGR (CGS a b n (+ off 8) rd fns) (- off) ""))))

; ===========================================================================
; RODATA INTERNING
; ===========================================================================

; Intern a string constant; emit `lea rax, [rip+label]`.
(defn cg-string-const (st content)
  (match (cg-label-new st)
    (CGR st2 d13 lbl
      (let st3 (cg-with-rodata st2 (REntry lbl content 0))
        (let st4 (cg-emit st3 "    lea rax, [rip+")
          (let st5 (cg-emit st4 lbl)
            (cg-nl (cg-emit st5 "]"))))))))

; Intern a float constant; load its bits into rax via xmm0.
(defn cg-float-const (st text)
  (match (cg-label-new st)
    (CGR st2 d14 lbl
      (let st3 (cg-with-rodata st2 (REntry lbl text 1))
        (let st4 (cg-emit st3 "    movsd xmm0, [rip+")
          (let st5 (cg-emit st4 lbl)
            (let st6 (cg-nl (cg-emit st5 "]"))
              (cg-nl (cg-emit st6 "    movq rax, xmm0")))))))))

(defn cg-rodata-of (st)
  (match st
    (CGS d15 d16 d17 d18 rd d19 rd)))

; ===========================================================================
; KINDS (for print format + float/string/struct dispatch):
;   0 int, 1 string, 2 float, 3 struct/variant (heap-allocated aggregate)
; ===========================================================================

; kind-of's IFfi arm used to unconditionally return 0 (int), regardless of
; what the FFI actually returns -- so `(print (str-concat "=> " ...))`
; (str-concat lowers to IFfi "zyl_cstr_concat", see icnf.zyl's
; ic-str-builtin-sym) picked %d formatting and printed the raw string
; pointer as a garbage integer instead of the text. Never caught before:
; grepping the whole tree, tools/repl.zyl is the only caller anywhere
; that ever printed a str-concat/ffi-string result directly. Named here
; rather than solved with real return-type inference (kind-of has none)
; since these are exactly the fixed set of C symbols icnf.zyl ever emits
; that hand back a string pointer.
(defn ffi-str-kind (name)
  (if (> (str-eq name "zyl_cstr_concat") 0) 1
  (if (> (str-eq name "zyl_cstr_substr") 0) 1
  (if (> (str-eq name "zyl_cstr_sub") 0) 1
  (if (> (str-eq name "zyl_cstr_from_int") 0) 1
  (if (> (str-eq name "zyl_cstr_sanitize") 0) 1
  (if (> (str-eq name "zyl_cstr_decode") 0) 1
  (if (> (str-eq name "zyl_file_read_c") 0) 1
    0))))))))

; kind-of's ICall arm used to unconditionally return 0 (int), regardless
; of what the called function actually returns -- so `(print (some-fn
; ...))` for any ordinary top-level function returning a string/float
; picked %d formatting and printed the raw pointer/bit pattern instead.
; Same root cause and same fix shape as ffi-str-kind above (this file
; has no real return-type inference), but for plain user functions
; instead of a fixed set of C runtime symbols: cg-collect-fnnames now
; also records each top-level function's own body kind (computed with
; an empty env, so it only ever reflects genuinely fixed shapes -- a
; function returning a literal, arithmetic, or a call to an
; EARLIER-defined function in the same list; a function whose return
; kind depends on one of its own parameters, or that forward-references
; a function defined later in the list, still defaults to 0 -- kind-of
; has no per-call-site specialization either way, so this is already
; the same class of approximation the rest of this file makes).
; ICallClosure is deliberately NOT covered: `name` there is a local
; variable holding a closure value, not a top-level function name, and
; the CGS fn-kind table only knows about the latter.
(defn kind-of (st env e)
  (match e
    (IConst 0)
    (IStr d19 1)
    (IFlt d20 2)
    (ILoad n (env-kind-of env n))
    (IBinop op l r
     (if (> op 4)
       0
       (if (= (kind-of st env l) 2)
         2
         (if (= (kind-of st env r) 2) 2 0))))
    (IIf d21 t d22 (kind-of st env t))
    (ICall name d24 (cg-fn-kind-search (cgg-fns st) name))
    (IFfi name d26 (ffi-str-kind name))
    (IPrint d27 0)
    (IWhile d28 d29 0)
    (ISet d30 d31 0)
    ; ILet's own kind is whatever its BODY evaluates to, not a fixed 0 --
    ; matters now that literal-pattern match's if-chain desugaring
    ; (expr_inner.zyl) always wraps its result in a let (binding the
    ; scrutinee once), so a function whose whole body is such a match
    ; had its real string/float kind masked by this let wrapper even
    ; after fixing kind-of's ICall arm above. Same env passed through
    ; unchanged (not extended with the let's own binding): every leaf
    ; this needs to see through bottoms out at a literal (IStr/IFlt),
    ; whose kind doesn't depend on env at all.
    (ILet d32 d33 body (kind-of st env body))
    (ISeq d35 0)
    ; `==`/`!=` between two struct/ADT-kind operands used to fall straight
    ; into cg-ibinop's raw `cmp rax, rcx` (same bare pointer comparison bug
    ; already fixed for strings above) -- since IVariant construction
    ; heap-allocates a fresh block every time, two separately-constructed
    ; but field-for-field-identical values (e.g. a derived-Eq struct's
    ; make-<Name> called twice with the same arguments) live at different
    ; addresses, so pointer equality silently said "not equal" regardless
    ; of content. zyl_variant_eq (actor_runtime.c) already does real
    ; structural comparison and was already used by cg-variant's own
    ; comment describing the encoding it depends on -- just never actually
    ; called from anywhere. Kind 3 marks a value as struct/variant-typed
    ; so cg-expr's IBinop case can route `==`/`!=` through it instead.
    (IVariant d36 d37 d38 3)
    (IStackVariant d105 d106 d107 3)
    (IMatch d39 d40 0)
    (IFn d41 0)
    (ICallClosure d42 d43 0)
    (ITryCatch d96 d97 d98 0)))

; ===========================================================================
; EXPRESSION EMISSION (result always in rax)
; ===========================================================================

(defn cg-expr (st env e)
  (match e
    (IConst v
     (let st2 (cg-emit st "    mov rax, ")
       (let st3 (cg-emit-int st2 v)
         (cg-nl st3))))
    (IStr s (cg-string-const st s))
    (IFlt t (cg-float-const st t))
    (ILoad n (cg-load-value st env n))
    ; `=`/`!=` between two STRING-kind operands used to fall straight into
    ; cg-ibinop's raw `cmp rax, rcx` — a bare POINTER comparison. Since
    ; str-substring/str-concat/etc. always heap-allocate a FRESH buffer,
    ; two textually-identical strings routinely live at different
    ; addresses (e.g. str-contains-loop's per-candidate str-substring
    ; result, or two independently-parsed occurrences of the same
    ; identifier), so pointer equality silently gave the wrong answer —
    ; deterministically wrong within one build, but the wrongness itself
    ; depends on allocation order, which shifts between stage2 and stage3
    ; (compiled by different machine code), breaking the self-hosting
    ; fixed point. Route string-kind `=`/`!=` through zyl_cstr_eq instead.
    (IBinop op l r
     (if (> (if (= (kind-of st env l) 2) 1 (if (= (kind-of st env r) 2) 1 0)) 0)
       (cg-fbinop st env op l r)
       (if (> (if (or (= op 9) (= op 10)) (if (or (= (kind-of st env l) 1) (= (kind-of st env r) 1)) 1 0) 0) 0)
         (cg-strbinop st env op l r)
         (if (> (if (> op 4) (if (or (= (kind-of st env l) 3) (= (kind-of st env r) 3)) 1 0) 0) 0)
           (cg-variantbinop st env op l r)
           (cg-ibinop st env op l r)))))
    (ICall name args (cg-call-args st env name args true 0))
    (ICallClosure name args (cg-call-closure-args st env name args))
    (IFfi sym args (cg-call-args st env sym args false 0))
    (IPrint a (cg-print st env a))
    (IIf c t eb (cg-if-dispatch st env c t eb))
    (IWhile c body (cg-while-dispatch st env c body))
    (ISet n v
     (let st2 (cg-expr st env v)
       (let st3 (cg-emit st2 "    mov [rbp")
         (let st4 (cg-emit-int st3 (env-lookup env n))
           (cg-nl (cg-emit st4 "], rax"))))))
    (ILet n v body (cg-let-dispatch st env n v body))
    (ISeq es (cg-seq st env es))
    (IVariant d46 tag fields (cg-variant st env tag fields))
    (IStackVariant d108 tag fields (cg-stack-variant st env tag fields))
    (IMatch scr arms (cg-match st env scr arms))
    ; A bare function node is never emitted as a value expression; keep st.
    (IFn d47 d48 d49 st)
    (ITryCatch tbody cvar cbody (cg-trycatch st env tbody cvar cbody))))

; Load a variable / function value into rax.
(defn cg-load-value (st env n)
  (if (= (env-lookup env n) 0)
    (cg-load-nonslot st env n)
    (cg-load-slot st n (env-lookup env n))))

(defn cg-load-slot (st n off)
  (let st2 (cg-emit st "    mov rax, [rbp")
    (let st3 (cg-emit-int st2 off)
      (cg-nl (cg-emit st3 "]")))))

(defn cg-load-nonslot (st env n)
  ; Function value reference: load the function's address so it can be
  ; passed as an argument and called indirectly (HOF support).
  (if (= (cg-fn-known st n) 1)
    (cg-load-fnref st n)
    (cg-load-unresolved st)))

(defn cg-load-fnref (st n)
  (let st2 (cg-emit st "    lea rax, [rip+_ZYL_")
    (let st3 (cg-emit st2 (ffi-call "zyl_cstr_sanitize" (cg-arena-of st) n 1000))
      (let st4 (cg-emit st3 "]")
        (cg-nl st4)))))

; Fallback for a name that's neither a bound slot nor a known function —
; e.g. the bare (undefined) identifier `nil` used pervasively across this
; codebase as a discarded/placeholder value. Used to emit "mov rax, [rbp"
; + literal 0 + "]" — i.e. the bare text "[rbp0]", which GAS parses as a
; reference to an undefined symbol named `rbp0` (no register+immediate
; syntax without a +/- between them), not as [rbp+0]. A plain immediate
; load avoids the memory-operand text construction entirely, matching
; what the Rust bootstrap already does for the same case.
(defn cg-load-unresolved (st)
  (cg-nl (cg-emit st "    mov rax, 0")))

(defn cg-if-dispatch (st env c t eb)
  (cg-if-labels (cg-label-pair st) env c t eb))

(defn cg-if-labels (p env c t eb)
  (cg-if-parts p env c t eb))

(defn cg-while-dispatch (st env c body)
  (cg-while-labels (cg-label-pair st) env c body))

(defn cg-while-labels (p env c body)
  (match p
    (CGP st lstart lend (cg-while-parts st env c body lstart lend))))

(defn cg-let-dispatch (st env n v body)
  (match (cg-new-slot st)
    (CGR st2 off d45
      (cg-let-store st2 env n v body off))))

(defn cg-let-store (st env n v body off)
  (let k (kind-of st env v)
    (let st3 (cg-expr st env v)
      (let st4 (cg-emit st3 "    mov [rbp")
        (let st5 (cg-emit-int st4 off)
          (let st6 (cg-nl (cg-emit st5 "], rax"))
            (cg-expr st6 (EnvBind n off k env) body)))))))

; (if c t e): condition tested, then branch tails. p carries the state
; plus the else/join labels.
(defn cg-if-parts (p env c t eb)
  (match p
    (CGP st lelse lend
      (let st2 (cg-expr st env c)
        (let st3 (cg-emit st2 "    test rax, rax")
          (let st4 (cg-nl st3)
            (let st5 (cg-emit st4 "    je ")
              (let st6 (cg-nl (cg-emit st5 lelse))
                (let st7 (cg-expr st6 env t)
                  (let st8 (cg-emit st7 "    jmp ")
                    (let st9 (cg-nl (cg-emit st8 lend))
                      (let st10 (cg-emit-label st9 lelse)
                        (let st11 (cg-expr st10 env eb)
                          (cg-emit-label st11 lend))))))))))))))

; (while c body...)
; `while` is an expression like everything else here: its value is the
; BODY's value from the last iteration that ran (0/unit if the condition
; was false from the start) — used directly by `for`'s desugaring into a
; plain while (ic-for in icnf.zyl), which some regression tests assert
; on (e.g. control-flow.zyl's "for-loop-early-exit"). Used to hardcode
; `xor eax, eax` after the loop regardless, matching a Rust bootstrap
; that instead threads the last body value through a dedicated slot.
(defn cg-while-parts (st env c body lstart lend)
  (match (cg-new-slot st)
    (CGR st0 off d1 (cg-while-body st0 env c body lstart lend off))))

(defn cg-while-body (st env c body lstart lend off)
  (let st1 (cg-while-store (cg-emit-line st "    mov rax, 0") off)
    (let st2 (cg-emit-label st1 lstart)
      (let st3 (cg-expr st2 env c)
        (let st4 (cg-emit-line st3 "    test rax, rax")
          (let st5 (cg-emit st4 "    je ")
            (let st6 (cg-nl (cg-emit st5 lend))
              (let st7 (cg-expr st6 env body)
                (let st8 (cg-while-store st7 off)
                  (let st9 (cg-emit st8 "    jmp ")
                    (let st10 (cg-nl (cg-emit st9 lstart))
                      (let st11 (cg-emit-label st10 lend)
                        (cg-while-load st11 off)))))))))))))

(defn cg-while-store (st off)
  (let st1 (cg-emit st "    mov [rbp")
    (let st2 (cg-emit-int st1 off)
      (cg-emit-line st2 "], rax"))))

(defn cg-while-load (st off)
  (let st1 (cg-emit st "    mov rax, [rbp")
    (let st2 (cg-emit-int st1 off)
      (cg-emit-line st2 "]"))))

(defn cg-emit-line (st s)
  (cg-nl (cg-emit st s)))

(defn cg-seq (st env es)
  (if (is-nil es)
    (cg-emit-line st "    xor eax, eax")
    (if (is-nil (tl2 es))
      (cg-expr st env (ih-ic es))
      (let st2 (cg-expr st env (ih-ic es))
        (cg-seq st2 env (tl2 es))))))

; Integer binary op: lhs -> rax (pushed), rhs -> rax, lhs restored to rax,
; rhs kept in rcx. Div/Rem use cqo/idiv with divisor safe in rcx.
(defn cg-ibinop (st env op l r)
  (let st2 (cg-expr st env l)
    (let st3 (cg-emit-line st2 "    push rax")
      (let st4 (cg-expr st3 env r)
        (let st5 (cg-emit-line st4 "    mov rcx, rax")
          (let st6 (cg-emit-line st5 "    pop rax")
            (if (< op 5)
              (cg-arith-mnem st6 op)
              (cg-cmp-set st6 op))))))))

; String `=`/`!=`: content comparison via the C runtime (zyl_cstr_eq),
; reusing cg-call-args' proven-safe ABI/stack-alignment handling instead
; of hand-rolling a new call sequence.
(defn cg-strbinop (st env op l r)
  (let st2 (cg-expr st env (IFfi "zyl_cstr_eq" (Cons l (Cons r Nil))))
    (if (= op 10)
      (cg-emit-line st2 "    xor rax, 1")
      st2)))

; Struct/variant `==`/`!=`: structural comparison via the C runtime
; (zyl_variant_eq), same shape as cg-strbinop above. `<`/`>`/`<=`/`>=`
; had the identical bare-pointer-comparison bug (two field-for-field-
; identical structs are still two separately heap-allocated addresses,
; so which one comes out "less" depended on allocation order, not
; content -- e.g. two structs built with the same field values compared
; as `<` true just because the first one built happened to land at a
; lower address). zyl_variant_cmp (actor_runtime.c) does a real
; lexicographic field-by-field comparison (skipping the shared
; discriminant word, which never differs between same-type values) and
; returns -1/0/1; cg-variant-cmp-set turns that into the right bool for
; each of the four ops the same way cg-cmp-set already does for a
; direct register comparison.
(defn cg-variantbinop (st env op l r)
  (if (> op 8)
    (let st2 (cg-expr st env (IFfi "zyl_variant_eq" (Cons l (Cons r Nil))))
      (if (= op 10)
        (cg-emit-line st2 "    xor rax, 1")
        st2))
    (let st2 (cg-expr st env (IFfi "zyl_variant_cmp" (Cons l (Cons r Nil))))
      (cg-variant-cmp-set st2 op))))

(defn cg-variant-cmp-set (st op)
  (let st2 (cg-emit-line st "    cmp rax, 0")
    (let st3 (cg-emit st2 "    set")
      (if (= op 5)
        (cg-setcc st3 "l al")
        (if (= op 6)
          (cg-setcc st3 "g al")
          (if (= op 7)
            (cg-setcc st3 "le al")
            (cg-setcc st3 "ge al")))))))

(defn cg-arith-mnem (st op)
  ; Div (3) and Rem (4) both sign-extend rax into rdx via cqo before idiv,
  ; otherwise a stale rdx makes the 128-bit quotient overflow (SIGFPE).
  (let st2 (if (> op 2) (cg-emit-line st "    cqo") st)
    (let mnem (if (= op 0) "    add rax, rcx"
              (if (= op 1) "    sub rax, rcx"
                (if (= op 2) "    imul rax, rcx"
                  "    idiv rcx")))
      (let st3 (cg-emit-line st2 mnem)
        (if (= op 4)
          (cg-emit-line st3 "    mov rax, rdx")
          st3)))))

(defn cg-cmp-set (st op)
  (let st2 (cg-emit-line st "    cmp rax, rcx")
    (let st3 (cg-emit st2 "    set")
      (if (= op 5)
        (cg-setcc st3 "l al")
        (if (= op 6)
          (cg-setcc st3 "g al")
          (if (= op 7)
            (cg-setcc st3 "le al")
            (if (= op 8)
              (cg-setcc st3 "ge al")
              (if (= op 9)
                (cg-setcc st3 "e al")
                (cg-setcc-ne st3)))))))))

(defn cg-setcc (st s)
  (let st4 (cg-nl (cg-emit st s))
    (cg-emit-line st4 "    movzx rax, al")))

(defn cg-setcc-ne (st)
  (let st4 (cg-nl (cg-emit st "ne al"))
    (cg-emit-line st4 "    movzx rax, al")))

; Float binary op: bits in rax; xmm0 = lhs, xmm1 = rhs.
(defn cg-fbinop (st env op l r)
  (let st2 (cg-expr st env l)
    (let st3 (cg-emit-line st2 "    push rax")
      (let st4 (cg-expr st3 env r)
        (let st5 (cg-emit-line st4 "    movq xmm1, rax")
          (let st6 (cg-emit-line st5 "    pop rax")
            (let st7 (cg-emit-line st6 "    movq xmm0, rax")
              (if (< op 5)
                (cg-farith st7 op)
                (cg-fcmp st7 op)))))))))

(defn cg-farith (st op)
  (let st2 (cg-emit st "    ")
    (let st3 (if (= op 0) (cg-emit st2 "addsd")
             (if (= op 1) (cg-emit st2 "subsd")
               (if (= op 2) (cg-emit st2 "mulsd")
                 (cg-emit st2 "divsd"))))
      (let st4 (cg-emit-line st3 " xmm0, xmm1")
        (cg-emit-line st4 "    movq rax, xmm0")))))

(defn cg-fcmp (st op)
  (let st2 (cg-emit-line st "    comisd xmm0, xmm1")
    (let st3 (cg-emit st2 "    set")
      (if (= op 5)
        (cg-fsetcc st3 "b al")
        (if (= op 6)
          (cg-fsetcc st3 "a al")
          (if (= op 7)
            (cg-fsetcc st3 "be al")
            (if (= op 8)
              (cg-fsetcc st3 "ae al")
              (if (= op 9)
                (cg-fsetcc st3 "e al")
                (cg-fsetcc-ne st3)))))))))

; unsigned-comparison flags carry the usual sense here
(defn cg-fsetcc (st s)
  (let st4 (cg-nl (cg-emit st s))
    (cg-emit-line st4 "    movzx rax, al")))

(defn cg-fsetcc-ne (st)
  (let st4 (cg-nl (cg-emit st "ne al"))
    (cg-emit-line st4 "    movzx rax, al")))

; Register-name dispatch by arg index (SysV).
(defn cg-reg-of (i)
  (if (= i 0) "rdi"
    (if (= i 1) "rsi"
      (if (= i 2) "rdx"
        (if (= i 3) "rcx"
          (if (= i 4) "r8"
            "r9"))))))

; Call: arguments are staged through scratch slots so that more than six
; parameters work (SysV stack args):
;   phase 0: 8-byte alignment pad if N+S is odd (S = stack args)
;   phase 1: evaluate every argument left-to-right into an 8-byte
;            scratch slot (`sub rsp, 8` / `mov [rsp], rax`)
;   phase 2: copy-push stack args (index >= 6) in reverse order so arg 6
;            sits at [rsp] at the call
;   phase 3: load register args from their scratch slots ([rsp+off],
;            offsets account for the copy-pushes)
;   phase 4: call; cleanup removes pad + scratch + copy-pushes.
; `mangle` adds the _ZYL_ prefix for user functions.
(defn cg-call-args (st env name args mangle i)
  (let n (list-length args)
    (let st2 (if (= (% (+ n (cg-stack-count n)) 2) 1)
               (cg-emit-line st "    sub rsp, 8")
               st)
      (let st3 (cg-scratch-all st2 env args)
        (let st4 (cg-copy-stack-args st3 n (- n 1) 0)
          (let st5 (cg-load-reg-args st4 n (- (cg-min-int n 6) 1))
            (if (> mangle 0)
              (cg-fire-user st5 env name n)
              (cg-fire-ext st5 env name n))))))))

; Number of stack-passed (SysV) arguments for a call of arity n.
(defn cg-stack-count (n)
  (if (> n 6) (- n 6) 0))

(defn cg-min-int (a b)
  (if (< a b) a b))

; Phase 1: evaluate each argument once and spill it into a scratch slot.
(defn cg-scratch-all (st env args)
  (if (is-nil args)
    st
    (let st2 (cg-expr st env (ih-ic args))
      (let st3 (cg-emit-line st2 "    sub rsp, 8")
        (let st4 (cg-emit-line st3 "    mov [rsp], rax")
          (cg-scratch-all st4 env (tl2 args)))))))

; Phase 2: copy-push args i = n-1 down to 6 from their scratch slots
; (no-op for arity <= 6); `pushed` counts bytes already copy-pushed.
(defn cg-copy-stack-args (st n i pushed)
  (if (< i 6)
    st
    (let st2 (cg-copy-one st (+ (* 8 (- n 1 i)) pushed))
      (cg-copy-stack-args st2 n (- i 1) (+ pushed 8)))))

(defn cg-copy-one (st off)
  (let st2 (cg-emit st "    mov r10, [rsp+")
    (let st3 (cg-emit-int st2 off)
      (let st4 (cg-emit st3 "]")
        (let st5 (cg-nl st4)
          (cg-emit-line st5 "    push r10"))))))

; Phase 3: load register args i = min(n,6)-1 down to 0 from scratch;
; offsets skip over the S copy-pushed stack args.
(defn cg-load-reg-args (st n i)
  ; NOTE: the offset must be built through lets — a binop whose direct
  ; operands are BOTH calls silently computes 0 in stage>=2 binaries
  ; (generalisation of the match-arm one-call rule).
  (if (< i 0)
    st
    (let a (* 8 (- n 1 i))
      (let b (* 8 (cg-stack-count n))
        (let st2 (cg-load-reg-one st (cg-reg-of i) (+ a b))
          (cg-load-reg-args st2 n (- i 1)))))))

(defn cg-load-reg-one (st reg off)
  (let st2 (cg-emit st "    mov ")
    (let st3 (cg-emit st2 reg)
      (let st4 (cg-emit st3 ", [rsp+")
        (let st5 (cg-emit-int st4 off)
          (cg-nl (cg-emit st5 "]")))))))

; HOF indirect calls are implemented but gated OFF: the path crashes
; inside stage1's own execution (see PROGRESS.md stage2 blocker #3).
(defn cg-hof-enabled () 1)

; Full call-target symbol: _ZYL_<name> for user fns, <name> otherwise.
(defn cg-sym-for (arena name mangle)
  (if (> mangle 0)
    (cg-sym-mangled arena name)
    (ffi-call "zyl_cstr_sanitize" arena name 1000)))

(defn cg-sym-mangled (arena name)
  (let buf (arena-alloc-zeroed arena 512)
    (begin
      (buf-append buf (str-intern arena "_ZYL_"))
      (buf-append buf (ffi-call "zyl_cstr_sanitize" arena name 1000))
      buf)))

(defn cg-cat2 (arena a b)
  (let buf (arena-alloc-zeroed arena (+ (alloc-strlen a) (alloc-strlen b) 1))
    (begin
      (buf-append buf a)
      (buf-append buf b)
      buf)))

(defn cg-cat3 (arena a b c)
  (cg-cat2 arena (cg-cat2 arena a b) c))

; Build "call f_<sanitized>" as a single string.
(defn cg-call-user-str (st env name)
  (let sym (cg-sym-for (cg-arena-of st) name 1)
    (cg-cat2 (cg-arena-of st) (str-intern (cg-arena-of st) "call ") sym)))

; ── mangled (user fn) path: n args already pushed, rsp pre-aligned ──

(defn cg-fire-user (st env name n)
  ; If `name` is a local binding it holds a function value: indirect call.
  (if (= (env-lookup env name) 0)
    (cg-user-direct st env name n)
    (cg-user-indirect st env name n)))

(defn cg-call-cleanup (st n)
  ; Built through lets: no binop may directly combine two calls.
  (let ns (+ n (cg-stack-count n))
    (let tot (* 8 (+ ns (% ns 2)))
      (let st2 (cg-emit st "    add rsp, ")
        (cg-nl (cg-emit-int st2 tot))))))

(defn cg-user-direct (st env name n)
  (let st2 (cg-emit-line st (cg-call-user-str st env name))
    (cg-call-cleanup st2 n)))

; Indirect (HOF): target address is in the local's stack slot. Load it
; into r10 AFTER the register args are staged so nothing clobbers them.
(defn cg-indirect-target (st off)
  (let st2 (cg-emit st "    mov r10, [rbp")
    (let st3 (cg-emit-int st2 off)
      (let st4 (cg-emit st3 "]")
        (let st5 (cg-nl st4)
          (cg-emit-line st5 "    call r10"))))))

(defn cg-user-indirect (st env name n)
  (let st2 (cg-indirect-target st (env-lookup env name))
    (cg-call-cleanup st2 n)))

; ── closure call path (ICallClosure) ──
; `name`'s own stack slot holds a heap [tag,code,env] triple (see
; icnf.zyl's ic-lambda-closure), not a bare code pointer: real args are
; staged into registers exactly like an ordinary call (mirrors
; cg-call-args's phases 0-3), then this unpacks code/env from the
; triple and passes env as one extra trailing register argument (index
; n, right after the n real args) before calling through code. r11
; (never used for arg staging) holds the triple pointer and then the
; code pointer in turn, so it's never live across the env-register move.
(defn cg-call-closure-args (st env name args)
  (let n (list-length args)
    (let st2 (if (= (% (+ n (cg-stack-count n)) 2) 1)
               (cg-emit-line st "    sub rsp, 8")
               st)
      (let st3 (cg-scratch-all st2 env args)
        (let st4 (cg-copy-stack-args st3 n (- n 1) 0)
          (let st5 (cg-load-reg-args st4 n (- (cg-min-int n 6) 1))
            (cg-closure-fire st5 env name n)))))))

(defn cg-closure-fire (st env name n)
  (let st2 (cg-emit st "    mov r11, [rbp")
    (let st3 (cg-emit-int st2 (env-lookup env name))
      (let st4 (cg-nl (cg-emit st3 "]"))
        (let st5 (cg-emit st4 "    mov ")
          (let st6 (cg-emit st5 (cg-reg-of n))
            (let st7 (cg-nl (cg-emit st6 ", [r11+16]"))
              (let st8 (cg-emit-line st7 "    mov r11, [r11+8]")
                (let st9 (cg-emit-line st8 "    call r11")
                  (cg-call-cleanup st9 n))))))))))

; ── ext (FFI) path ──

(defn cg-fire-ext (st env name n)
  (let st2 (cg-cat2 (cg-arena-of st) (str-intern (cg-arena-of st) "call ") (str-intern (cg-arena-of st) name))
    (let st3 (cg-emit-line st st2)
      (cg-call-cleanup st3 n))))

; print: pick the format by the argument's kind.
; `print`'s own "value" (this is a Lisp where everything is an
; expression, so a print statement is also usable as one) used to be
; whatever printf happened to leave in rax -- its return value, the
; byte count written, an ABI artifact never meant to be meaningful
; here. That leaked two different ways: it silently became the process
; exit code whenever a print was the tail expression of `main` (see
; the entry stub's own comment), and it made nested prints like
; `(print (print x))` show a second, garbage-looking number (the
; inner print's byte count) instead of anything sensible. print now
; always evaluates to a clean, deterministic 0 -- the ordinary "this
; statement has no useful value" convention -- by zeroing eax again
; right after the call, regardless of what printf itself returned.
(defn cg-print (st env a)
  (let k (kind-of st env a)
    (let st2 (cg-expr st env a)
      (if (= k 2)
        (let st3 (cg-emit-line st2 "    movq xmm0, rax")
          (let st4 (cg-emit-line st3 "    lea rdi, [rip+.Lfmtf]")
            (let st5 (cg-emit-line st4 "    mov eax, 1")
              (let st6 (cg-emit-line st5 "    call printf")
                (cg-emit-line st6 "    xor eax, eax")))))
        (if (= k 1)
          (let st3 (cg-emit-line st2 "    mov rsi, rax")
            (let st4 (cg-emit-line st3 "    lea rdi, [rip+.Lfmts]")
              (let st5 (cg-emit-line st4 "    xor eax, eax")
                (let st6 (cg-emit-line st5 "    call printf")
                  (cg-emit-line st6 "    xor eax, eax")))))
          (let st3 (cg-emit-line st2 "    mov rsi, rax")
            (let st4 (cg-emit-line st3 "    lea rdi, [rip+.Lfmtd]")
              (let st5 (cg-emit-line st4 "    xor eax, eax")
                (let st6 (cg-emit-line st5 "    call printf")
                  (cg-emit-line st6 "    xor eax, eax"))))))))))

; Variant construction: [tag][f0]..[fn-1], allocated via zyl_heap_alloc
; (not raw malloc) so the runtime's hidden qword-count header lands
; before the block — the same mechanism the Rust bootstrap already uses,
; which zyl_variant_eq (actor_runtime.c) reads to do structural equality
; on two separately-allocated ADT/struct values without a runtime type
; tag. Fields are evaluated and pushed, then popped into the block
; (right to left). Alignment for the call is forced via rsp itself
; (save to r12, AND down to 16, restore after) rather than padding by
; this call's own field-count parity: that parity-based padding used to
; assume rsp was already 16-aligned at entry to cg-variant, which broke
; whenever this construction sat inside an outer field-push (nested
; variant/call arguments), because the outer call's already-pushed word
; count shifts the actual parity out from under a check that only looks
; at n. Saving/restoring rsp around the call sidesteps that regardless
; of any outer pushes.
(defn cg-variant (st env tag fields)
  (let n (list-length fields)
    (let st2 (cg-push-fields st env fields)
      (let st3 (cg-emit-line st2 "    mov r12, rsp")
        (let st4 (cg-emit-line st3 "    and rsp, -16")
          (let st5 (cg-nl (cg-emit-int (cg-emit st4 "    mov rdi, ") (* 8 (+ n 1))))
            (let st6 (cg-emit-line st5 "    call zyl_heap_alloc")
              (let st7 (cg-emit-line st6 "    mov rsp, r12")
                (let st8 (cg-emit-line st7 "    mov rbx, rax")
                  (let st9 (cg-emit-int (cg-emit st8 "    mov qword ptr [rbx], ") tag)
                    (let st10 (cg-nl st9)
                      (let st11 (cg-pop-fields st10 (- n 1))
                        (cg-emit-line st11 "    mov rax, rbx")))))))))))))

; Evaluate each field left-to-right, pushing its value.
(defn cg-push-fields (st env fields)
  (if (is-nil fields)
    st
    (let st2 (cg-expr st env (ih-ic fields))
      (cg-push-fields (cg-emit-line st2 "    push rax") env (tl2 fields)))))

; Pop n fields into the block rbx points at (reverse order restores the
; original left-to-right layout).
(defn cg-pop-fields (st j)
  (if (< j 0)
    st
    (let st2 (cg-emit-line st "    pop rax")
      (let st3 (cg-emit st2 "    mov [rbx+")
        (let st4 (cg-emit-int st3 (* 8 (+ j 1)))
          (let st5 (cg-nl (cg-emit st4 "], rax"))
            (cg-pop-fields st5 (- j 1))))))))

; ── Stack-allocated variant (IStackVariant) ──────────────────────────────
; Same [tag, field0, field1, ...] layout cg-variant builds on the heap,
; but written directly into (n+1) slots reserved in the CURRENT
; function's own frame (cg-reserve-block, a run of consecutive
; cg-new-slot calls) -- no zyl_heap_alloc call, no staging through
; pushes: each field is evaluated and stored straight to its final
; offset, since there's no allocation call in between that could clobber
; a value still waiting to be written (unlike cg-variant, which stages
; through pushes specifically because zyl_heap_alloc happens AFTER every
; field is evaluated). Only reached when region_inference.zyl has
; already proven the binding never escapes this frame -- see
; ri-name-safe-in.
(defn cg-reserve-block (st count)
  (match (cg-new-slot st)
    (CGR st2 off d1
      (if (<= count 1)
        (CGR st2 off "")
        (cg-reserve-block st2 (- count 1))))))

(defn cg-stack-variant (st env tag fields)
  (let n (list-length fields)
    (match (cg-reserve-block st (+ n 1))
      (CGR st2 base d1
        (let st3 (cg-emit st2 "    mov qword ptr [rbp")
          (let st4 (cg-emit-int st3 base)
            (let st5 (cg-emit st4 "], ")
              (let st6 (cg-nl (cg-emit-int st5 tag))
                (let st7 (cg-stack-write-fields st6 env base fields 0)
                  (let st8 (cg-emit st7 "    lea rax, [rbp")
                    (let st9 (cg-emit-int st8 base)
                      (cg-nl (cg-emit st9 "]")))))))))))))

(defn cg-stack-write-fields (st env base fields idx)
  (match fields
    (Nil st)
    (Cons f rest
      (let st2 (cg-expr st env f)
        (let st3 (cg-emit st2 "    mov [rbp")
          (let st4 (cg-emit-int st3 (+ base (* 8 (+ idx 1))))
            (let st5 (cg-nl (cg-emit st4 "], rax"))
              (cg-stack-write-fields st5 env base rest (+ idx 1)))))))))

; Match: evaluate scrutinee, keep it on the stack for the whole dispatch,
; replace it with the arm-body result, pop at the end.
; Stack invariant: exactly one pushed word ([rsp] = scrutinee or result).
(defn cg-match (st env scr arms)
  (cg-match-labels (cg-label-pair st) env scr arms))

(defn cg-match-labels (p env scr arms)
  (match p
    (CGP st lend lzero
      (cg-match-scrutinee st env scr arms lend lzero))))

(defn cg-match-scrutinee (st env scr arms lend lzero)
  (let st3 (cg-expr st env scr)
    (let st4 (cg-emit-line st3 "    push rax")
      (cg-match-arms st4 env arms lend lzero))))

(defn cg-match-arms (st env arms lend lzero)
  (let st5 (cg-arms st env arms lend lzero)
    ; fall-through: no arm matched -> 0
    (let st6 (cg-emit-label st5 lzero)
      (let st7 (cg-emit-line st6 "    mov qword ptr [rsp], 0")
        (let st8 (cg-emit-label st7 lend)
          (cg-emit-line st8 "    pop rax"))))))

; Emit arms[i..]. Each arm checks [rsp]'s tag; a failed check jumps to
; the next arm's label (or the zero fall-through after the last arm); a
; successful match binds pattern vars and evaluates the body.
(defn cg-arms (st env arms lend lzero)
  (if (is-nil arms)
    st
    (cg-arm-one (CGP st lend lzero) (hd-ia arms) (tl2 arms) env)))

(defn cg-arm-one (p arm rest env)
  (match p
    (CGP st lend lzero
      (match arm
        (IArm vname tag binds body
          (if (is-nil rest)
            ; last arm: failed tag check falls through to the zero label
            (cg-arm-match (CGP st lzero lend) env tag binds body)
            ; more arms follow: failures jump to a fresh next-arm label
            (let picked (cg-label-new st)
              (let lnext (cgr-str picked)
                (let st-after (cg-arm-match (CGP (cgr-st picked) lnext lend) env tag binds body)
                  (cg-arms (cg-emit-label st-after lnext) env rest lend lzero))))))))))

; Emit one arm's tag check, bindings, body and exit jump. flabel (carried
; in p) is where a failed tag check goes; lend is the match join label.
;
; A wildcard/catch-all arm (any pattern name that doesn't resolve to a
; real variant, e.g. this codebase's pervasive dummy names d1/d2/...)
; gets sentinel tag -1 from vt-tag-of ("not found"). Unconditionally
; emitting a tag check for it — `cmp rax, -1` — can never actually match
; a real scrutinee's tag, so the wildcard arm's own body was NEVER
; reachable: every such arm always "failed" its own check and fell
; through to lzero's hardcoded 0, silently discarding whatever the arm
; was supposed to compute. This is the single mechanism behind the
; entire "rbp0"/wildcard-arm-returns-0 bug class chased through this
; session once cg-load-unresolved stopped being the direct culprit — the
; Rust bootstrap's codegen.rs already special-cases this (skips cmp/je
; for the wildcard arm, routes the no-match fallthrough straight to its
; body); this mirrors that: skip the tag check entirely and match
; unconditionally when tag is the sentinel.
(defn cg-arm-match (p env tag binds body)
  (match p
    (CGP st flabel lend
      (if (= tag -1)
        (match (cg-bind-fields st env binds 0)
          (CGE st6 arm-env
            (let st7 (cg-expr st6 arm-env body)
              (let st8 (cg-emit-line st7 "    mov [rsp], rax")
                (let st9 (cg-emit st8 "    jmp ")
                  (cg-nl (cg-emit st9 lend)))))))
        (let st3 (cg-tag-check st tag)
          (let st4 (cg-emit st3 "    jne ")
            (let st5 (cg-nl (cg-emit st4 flabel))
              (match (cg-bind-fields st5 env binds 0)
                (CGE st6 arm-env
                  (let st7 (cg-expr st6 arm-env body)
                    (let st8 (cg-emit-line st7 "    mov [rsp], rax")
                      (let st9 (cg-emit st8 "    jmp ")
                        (cg-nl (cg-emit st9 lend))))))))))))))

(defn cgr-st (r)
  (match r
    (CGR s d49 d50 s)))

(defn cgr-str (r)
  (match r
    (CGR d51 d52 s s)))

; Arm prologue: load scrutinee pointer from [rsp] and its tag.
(defn cg-tag-check (st tag)
  (let st2 (cg-emit-line st "    mov rax, [rsp]")
    (let st3 (cg-emit-line st2 "    mov rax, [rax]")
      (let st4 (cg-emit st3 "    cmp rax, ")
        (cg-nl (cg-emit-int st4 tag))))))

; Bind pattern variables: field j of [rsp]'s block goes into a fresh slot.
; "_" wildcards are skipped by codegen. Returns: CGE (state + extended env).
(defn cg-bind-fields (st env binds j)
  (if (is-nil binds)
    (CGE st env)
    (cg-bind-one st env binds j)))

(defn cg-bind-one (st env binds j)
  (let st2 (cg-load-field st j)
    (let b (shd binds)
      (if (> (str-eq b (str-intern (cg-arena-of st) "_")) 0)
        (cg-bind-fields st2 env (tl2 binds) (+ j 1))
        (cg-bind-slot st2 env binds j b)))))

(defn cg-bind-slot (st env binds j b)
  (match (cg-new-slot st)
    (CGR st3 off d53
      (cg-bind-store st3 env binds j b off))))

(defn cg-bind-store (st env binds j b off)
  (let st4 (cg-store-rax-slot st off)
    (cg-bind-fields st4 (EnvBind b off 0 env) (tl2 binds) (+ j 1))))

; Load field j of the block at [rsp]: rax = [[rsp] + 8*(j+1)].
(defn cg-load-field (st j)
  (let st2 (cg-emit-line st "    mov rax, [rsp]")
    (let st3 (cg-emit st2 "    mov rax, [rax+")
      (let st4 (cg-emit-int st3 (* 8 (+ j 1)))
        (cg-nl (cg-emit st4 "]"))))))

(defn cg-store-rax-slot (st off)
  (let st2 (cg-emit st "    mov [rbp")
    (let st3 (cg-emit-int st2 off)
      (cg-nl (cg-emit st3 "], rax")))))

(defn cg-emit-label (st lbl)
  (cg-nl (cg-emit (cg-emit st lbl) ":")))

; ===========================================================================
; TRY / CATCH — inline setjmp/longjmp via the runtime's existing panic-
; frame stack (zyl_try_push/zyl_try_pop/zyl_panic, added for the test
; harness's own recovery, never wired to anything else until now).
;
; `error` (allocator.zyl) now calls zyl_panic, which — if a frame is
; active — pops it and longjmps to its buffer instead of exiting.
; setjmp/longjmp only work correctly when the function that calls
; setjmp is still on the stack when the corresponding longjmp fires, so
; setjmp is called INLINE here in the generated code itself, not via an
; FFI wrapper function (which would return and pop its own frame before
; any later longjmp could target it).
;
; Every bare `call` below (zyl_try_push/setjmp/zyl_try_pop/
; zyl_try_frame_msg) is wrapped in cg-call0-aligned's save-rsp/and-16/
; restore dance, mirroring cg-variant's own alignment fix elsewhere in
; this file — this call site's own stack depth (mid-expression, with
; earlier pushes already live) isn't guaranteed 16-aligned otherwise.
; This is safe across the longjmp specifically because setjmp/longjmp's
; whole contract is to save and restore every callee-saved register
; (including r12, used here to stash the pre-alignment rsp) as of the
; setjmp call site — the "mov rsp, r12" right after `call setjmp`
; behaves identically whether we got there by falling through or by
; landing via a later longjmp, regardless of what r12 held in between.
(defn cg-call0-aligned (st sym)
  (let st2 (cg-emit-line st "    mov r12, rsp")
    (let st3 (cg-emit-line st2 "    and rsp, -16")
      (let st4 (cg-emit-line st3 (str-concat "    call " sym))
        (cg-emit-line st4 "    mov rsp, r12")))))

(defn cg-trycatch (st env tbody cvar cbody)
  (match (cg-label-pair st)
    (CGP st1 lcatch ldone
      (match (cg-new-slot st1)
        (CGR st2 cvar-off d1
          (cg-trycatch-emit st2 env tbody cvar cbody lcatch ldone cvar-off))))))

(defn cg-trycatch-emit (st env tbody cvar cbody lcatch ldone cvar-off)
  ; rax = new frame ptr (jmp_buf is its first field); save it across the
  ; setjmp call, then use it as setjmp's own argument.
  (let st2 (cg-call0-aligned st "zyl_try_push")
    (let st3 (cg-emit-line st2 "    push rax")
      (let st4 (cg-emit-line st3 "    mov rdi, rax")
        (let st5 (cg-call0-aligned st4 "setjmp")
          (let st6 (cg-emit-line st5 "    cmp rax, 0")
            (let st7 (cg-emit st6 "    jne ")
              (let st8 (cg-nl (cg-emit st7 lcatch))
                (cg-trycatch-try st8 env tbody cvar cbody lcatch ldone cvar-off)))))))))

; setjmp returned 0 (direct call, no panic yet): drop the saved frame
; ptr (not needed on this path — zyl_try_pop operates on the runtime's
; own top-of-stack global, not this specific pointer), run the try body,
; then pop our frame so an error AFTER this point doesn't unwind here.
(defn cg-trycatch-try (st env tbody cvar cbody lcatch ldone cvar-off)
  (let st2 (cg-emit-line st "    pop rax")
    (let st3 (cg-expr st2 env tbody)
      (let st4 (cg-emit-line st3 "    push rax")
        (let st5 (cg-call0-aligned st4 "zyl_try_pop")
          (let st6 (cg-emit-line st5 "    pop rax")
            (let st7 (cg-emit st6 "    jmp ")
              (let st8 (cg-nl (cg-emit st7 ldone))
                (let st9 (cg-emit-label st8 lcatch)
                  (cg-trycatch-catch st9 env cbody cvar ldone cvar-off))))))))))

; Landed here via longjmp (zyl_panic already popped our frame from the
; runtime's own stack before jumping, so no zyl_try_pop call on this
; path — that would incorrectly pop whatever frame is now on top,
; typically an enclosing try/catch's). The frame ptr saved before
; setjmp is still on our own stack (longjmp restores rsp to right after
; that push, discarding only what the try body itself pushed) — use it
; to read the message zyl_panic stashed.
(defn cg-trycatch-catch (st env cbody cvar ldone cvar-off)
  (let st2 (cg-emit-line st "    pop rax")
    (let st3 (cg-emit-line st2 "    mov rdi, rax")
      (let st4 (cg-call0-aligned st3 "zyl_try_frame_msg")
        (let st5 (cg-store-rax-slot st4 cvar-off)
          (let st6 (cg-expr st5 (EnvBind cvar cvar-off 0 env) cbody)
            (cg-emit-label st6 ldone)))))))

; ===========================================================================
; FUNCTION / PROGRAM EMISSION
; ===========================================================================

; ─── Frame sizing ────────────────────────────────────────────────────────
; Upper bound on stack slots a function needs: total Icnf nodes in its
; body (every node may own one 8-byte slot). Keeps frames small so deep
; recursion in the compiler stays within the machine stack.

; NOTE: match-arm bodies must stay SINGLE expressions (one call or one
; binop-with-one-call). The Rust bootstrap drops computations when a
; match-arm body combines a constant with MULTIPLE calls (seen as frames
; collapsing to minimum size in stage>=2 binaries). Hence these helpers.
(defn icnf-add2 (a b) (+ a b))
(defn icnf-add3 (a b c) (+ a (+ b c)))

(defn icnf-size (e)
  (match e
    (IConst d54 1)
    (IStr d55 1)
    (IFlt d56 1)
    (ILoad d57 1)
    (IBinop d58 l r (icnf-add3 3 (icnf-size l) (icnf-size r)))
    (ICall d59 args (icnf-add2 2 (icnf-count-list args)))
    (IFfi d60 args (icnf-add2 2 (icnf-count-list args)))
    (IPrint a (+ 1 (icnf-size a)))
    (IIf c t eb (icnf-add3 4 (icnf-size c) (icnf-size t) (icnf-size eb)))
    (IWhile c b (icnf-add3 3 (icnf-size c) (icnf-size b)))
    (ISet d61 v (+ 2 (icnf-size v)))
    (ILet d62 v b (icnf-add3 3 (icnf-size v) (icnf-size b)))
    (ISeq es (+ 1 (icnf-count-list es)))
    (IVariant d63 d64 fields (+ 1 (icnf-count-list fields)))
    (IStackVariant d109 d110 fields (+ 1 (icnf-count-list fields)))
    (IMatch scr arms (icnf-add3 2 (icnf-size scr) (icnf-count-arms arms)))
    (IFn d65 d66 d67 1)
    (ICallClosure d94 args (icnf-add2 2 (icnf-count-list args)))
    (ITryCatch tbody d102 cbody (icnf-add3 4 (icnf-size tbody) (icnf-size cbody)))))

(defn icnf-count-list (xs)
  (match xs
    (Nil 0)
    (Cons h t (+ (icnf-size h) (icnf-count-list t)))))

; Static slot-count estimate: every runtime `cg-new-slot` corresponds to
; exactly one ILet node or one non-wildcard pattern bind, allocated once
; during codegen (branches accumulate, never reuse). Frames are now sized
; from this instead of the uniform 16*(64+icnf-size) waste.
(defn icnf-slot-count (e)
  (match e
    (IConst d80 0)
    (IStr d81 0)
    (IFlt d82 0)
    (ILoad d83 0)
    (IBinop d84 l r (icnf-add2 (icnf-slot-count l) (icnf-slot-count r)))
    (ICall d85 args (icnf-count-slots-list args))
    (IFfi d86 args (icnf-count-slots-list args))
    (IPrint a (icnf-slot-count a))
    (IIf c t eb (icnf-add3 (icnf-slot-count c) (icnf-slot-count t) (icnf-slot-count eb)))
    (IWhile c b (+ 1 (icnf-add2 (icnf-slot-count c) (icnf-slot-count b))))
    (ISet d87 v (icnf-slot-count v))
    (ILet d88 v b (+ 1 (icnf-add2 (icnf-slot-count v) (icnf-slot-count b))))
    (ISeq es (icnf-count-slots-list es))
    (IVariant d89 d90 fields (icnf-count-slots-list fields))
    ; +1 slot for the block base plus one per field, on top of each
    ; field's own subexpression slots -- this block is reserved as
    ; (n+1) CONSECUTIVE cg-new-slot calls (cg-reserve-block), unlike
    ; IVariant's fields (which only ever need scratch slots transiently
    ; during heap-alloc staging, already counted by icnf-count-slots-list
    ; alone).
    (IStackVariant d111 d112 fields (icnf-add2 (+ 1 (list-length fields)) (icnf-count-slots-list fields)))
    (IMatch scr arms (icnf-add2 (icnf-slot-count scr) (icnf-count-arm-slots arms)))
    (IFn d91 d92 d93 0)
    (ICallClosure d95 args (icnf-count-slots-list args))
    (ITryCatch tbody d103 cbody (+ 1 (icnf-add2 (icnf-slot-count tbody) (icnf-slot-count cbody))))))

(defn icnf-count-slots-list (xs)
  (if (is-nil xs)
    0
    (icnf-add2 (icnf-slot-count (hd-icnf xs)) (icnf-count-slots-list (tl2 xs)))))

(defn icnf-count-arm-slots (arms)
  (if (is-nil arms)
    0
    (icnf-arm-slots (hd-ia arms) (tl2 arms))))

(defn icnf-arm-slots (arm rest)
  ; binops never combine two direct calls here (constraint 8).
  (match arm
    (IArm d91 d92 binds body
      (icnf-add2 (icnf-binds-slots binds 0)
                 (icnf-add2 (icnf-slot-count body) (icnf-count-arm-slots rest))))))

; Count of non-wildcard pattern binds (each gets exactly one slot).
(defn icnf-binds-slots (binds acc)
  (if (is-nil binds)
    acc
    (icnf-binds-slots (tl2 binds)
                      (+ acc (icnf-bind-real (shd binds))))))

(defn icnf-bind-real (b)
  ; exact "_" (length 1, byte '_') gets no slot in cg-bind-one
  (if (= (alloc-strlen b) 1)
    (if (= (byte-at b 0) 95) 0 1)
    1))

(defn icnf-count-arms (xs)
  (if (is-nil xs)
    0
    (icnf-arm-size (hd-ia xs) (tl2 xs))))

(defn icnf-arm-size (arm rest)
  ; Match-arm bodies must contain at most ONE call (see icnf-add2 note);
  ; nest the sum through helpers.
  (match arm
    (IArm d65 d66 d67 body
      (icnf-add2 1 (icnf-add2 (icnf-size body) (icnf-count-arms rest))))))

(defn cg-function (st f)
  ; Extract the IFn fields via tiny two-arm helpers: a trailing catch-all
  ; arm on this single large IFn arm was dropped between macro expand and
  ; icnf, leaving only the first arm and tripping exhaustiveness.
  (if
    (ifn-tag-p f)
    (let name (ifn-tag-name f)
      (let params (ifn-tag-params f)
        (let body (ifn-tag-body f)
     (let env (cg-param-env params 0 (EnvNil))
       ; Frame sized from actual slot usage: param slots + one per ILet /
       ; non-wildcard pattern bind (+ headroom), rounded to 16 bytes.
       ; The old uniform 16*(64+icnf-size) wasted ~16x stack.
       (let nslots (icnf-add2 (list-length params)
                              (+ (icnf-slot-count body) 8))
         ; 16*(1 + ns/2) >= 8*ns and stays 16-byte aligned
         (let fsz (* 16 (+ 1 (/ nslots 2)))
          (let st1 (cg-emit st "_ZYL_")
           (let st2 (cg-emit st1 (ffi-call "zyl_cstr_sanitize" (cg-arena-of st) name 1000))
             (let st3 (cg-emit-line st2 ":")
               (let st4 (cg-emit-line st3 "    push rbp")
                 (let st5 (cg-emit-line st4 "    mov rbp, rsp")
                   (let st6 (cg-emit st5 "    sub rsp, ")
                     (let st7 (cg-nl (cg-emit-int st6 fsz))
                       (let st8 (cg-param-spills st7 0 (list-length params))
                         ; per-function slot counter reset after params
                         (let st9 (cg-reset-slots st8 (* 8 (+ 1 (list-length params))))
                            (let st10 (cg-expr st9 env body)
                              (let st11 (cg-emit-line st10 "    mov rsp, rbp")
                                (let st12 (cg-emit-line st11 "    pop rbp")
                                  (cg-emit-line st12 "    ret")))))))))))))))))))
    st))

(defn ifn-tag-p (f)
  (match f
    (IFn a b c 1)
    (d1 0)))

(defn ifn-tag-name (f)
  (match f
    (IFn a b c a)
    (d1 "a-name")))

(defn ifn-tag-params (f)
  (match f
    (IFn a b c b)
    (d1 (no-strs))))

(defn ifn-tag-body (f)
  (match f
    (IFn a b c c)
    (d1 (no-icnfs))))

(defn cg-reset-slots (st next-off)
  (match st
    (CGS a b n d69 rd fns (CGS a b n next-off rd fns))))

; Immutable param environment: param i -> offset -(8*(i+1)).
(defn cg-param-env (params i acc)
  (if (is-nil params)
    acc
    (cg-param-env (tl2 params) (+ i 1)
                  (EnvBind (shd params) (- (* 8 (+ i 1))) 0 acc))))

; Spill incoming args to param slots: indices 0..5 from SysV registers,
; indices >= 6 from the caller's stack frame ([rbp+16] is stack arg 6).
(defn cg-param-spills (st i n)
  (if (>= i n)
    st
    (if (< i 6)
      (cg-param-spill-reg st i n)
      (cg-param-spill-stack st i n))))

(defn cg-param-spill-reg (st i n)
  (let st2 (cg-emit st "    mov [rbp")
    (let st3 (cg-emit-int st2 (- (* 8 (+ i 1))))
      (let st4 (cg-emit st3 "], ")
        (let st5 (cg-emit st4 (cg-reg-of i))
          (cg-param-spills (cg-nl st5) (+ i 1) n))))))

(defn cg-param-spill-stack (st i n)
  (let st2 (cg-emit st "    mov r10, [rbp+")
    (let st3 (cg-emit-int st2 (+ 16 (* 8 (- i 6))))
      (let st4 (cg-emit st3 "]")
        (let st5 (cg-nl st4)
          (let st6 (cg-emit st5 "    mov [rbp")
            (let st7 (cg-emit-int st6 (- (* 8 (+ i 1))))
              (let st8 (cg-emit st7 "], r10")
                (cg-param-spills (cg-nl st8) (+ i 1) n)))))))))

; Emit the whole program: header, functions, entry stub, format strings,
; rodata. Functions are emitted in lowering order (source order); the
; entry stub calls f_main, which the lowering guarantees exists.
; Returns: final CGState (retrieve the buffer with cg-buffer).
; Record every top-level defn name so function-value references
; (higher-order arguments) resolve to addresses.
(defn cg-collect-fnnames (st fns)
  (if (is-nil fns)
    st
    (cg-collect-one st (fnhead-if fns) (tl2 fns))))

; Head of a List(IFunc); empty placeholder when exhausted.
(defn fnhead-if (xs)
  (list-head-or xs (IFn "" Nil (IConst 0))))

(defn cg-collect-one (st f rest)
  (match f
    (IFn nm d78 body
      (cg-collect-fnnames (cg-with-fnname st nm (kind-of st (EnvNil) body)) rest))
    (d80 (cg-collect-fnnames st rest))))

(defn cg-program (st fns)
  (let st0 (cg-collect-fnnames st fns)
    (cg-program-run st0 fns)))

(defn cg-program-run (st fns)
  (let st1 (cg-header st)
    (let st2 (cg-functions st1 fns)
      (let st3 (cg-entry-stub st2)
        (let st4 (cg-format-strings st3)
          (cg-rodata-emit-list st4 (cg-reverse-rodata (cg-rodata-of st4))))))))

; Reverse the collected rodata list so entries emit in creation order.
(defn cg-reverse-rodata (xs)
  (cg-rev-acc xs (no-rentries)))

(defn cg-rev-acc (xs acc)
  (match xs
    (Nil acc)
    (Cons h t (cg-rev-acc t (Cons h acc)))))

(defn cg-header (st)
  (let st1 (cg-emit-line st ".intel_syntax noprefix")
    (let st2 (cg-emit-line st1 ".text")
      (cg-emit-line st2 ".globl main"))))

(defn cg-entry-stub (st)
  ; Run user main on a big-stack worker thread (C runtime helper): the
  ; self-hosted compiler recurses deeply while parsing large inputs.
  ;
  ; MUST call zyl_ensure_arenas@plt before any allocation happens (it
  ; sets the global g_heap_arena/g_pin_arena used by zyl_heap_alloc,
  ; which backs str-concat/str-substring/str-length and every other
  ; heap-allocating builtin). This mirrors codegen.rs's entry stub,
  ; which always emits this call. This self-hosted stub used to omit
  ; it entirely, leaving g_heap_arena permanently NULL for any binary
  ; produced by this codegen — every heap-allocating builtin silently
  ; returned 0 (null) from zyl_heap_alloc's `!g_heap_arena` guard, and
  ; the first caller to actually dereference that null buffer (here,
  ; zyl_cstr_substr's memcpy into a null `buf`) segfaulted deep into
  ; the run instead of failing at start.
  ; edi=argc, rsi=argv at entry (SysV main ABI) — save them via
  ; zyl_save_args BEFORE any other call (which would clobber the
  ; caller-saved edi/rsi), so driver.zyl's zyl_argc/zyl_arg_str FFI
  ; helpers can see the real argv later in the run.
  ;
  ; zyl_call_on_big_stack's return value (user main's real return
  ; value, via g_bigstack_result) now becomes this process's actual
  ; exit code -- this used to zero eax here unconditionally, silently
  ; discarding it for every Zyl program ever compiled by this codegen.
  ; That was only safe because print (this language's overwhelmingly
  ; common tail expression) used to leave printf's own return value in
  ; rax, an arbitrary byte count with no relation to program correctness
  ; -- exactly what broke tests/regression/generics-multi-type.zyl the
  ; first time this zeroing was removed without also fixing print. Now
  ; that cg-print always leaves a clean 0 (see its own comment), a
  ; `main` whose tail is print exits 0 as expected, and one whose tail
  ; is (run-tests) genuinely propagates zyl_run_tests' pass/fail result
  ; (actor_runtime.c: 0 if all passed, 1 if any failed) as the process
  ; exit code for the first time.
  (let st1 (cg-emit-line st "main:")
    (let st2 (cg-emit-line st1 "    push rbp")
      (let st3 (cg-emit-line st2 "    mov rbp, rsp")
        (let st3a (cg-emit-line st3 "    call zyl_save_args")
          (let st3b (cg-emit-line st3a "    call zyl_ensure_arenas")
            (let st4 (cg-emit-line st3b "    lea rdi, [rip+_ZYL_main]")
              (let st5 (cg-emit-line st4 "    call zyl_call_on_big_stack")
                  (let st7 (cg-emit-line st5 "    pop rbp")
                    (let st8 (cg-emit-line st7 "    ret")
                      st8))))))))))

(defn cg-format-strings (st)
  (let st1 (cg-emit-line st ".section .rodata")
    (let st2 (cg-emit-line st1 ".Lfmtd:")
      (let st3 (cg-emit-line st2 "    .string \"%d\\n\"")
        (let st4 (cg-emit-line st3 ".Lfmtf:")
          (let st5 (cg-emit-line st4 "    .string \"%f\\n\"")
            (let st6 (cg-emit-line st5 ".Lfmts:")
              (cg-emit-line st6 "    .string \"%s\\n\""))))))))

(defn cg-dbg (msg)
  (let f (file-open "/tmp/dbg2" "a")
    (let d1 (file-write f msg)
      (file-close f))))

(defn cg-functions (st fns)
  (if (is-nil fns)
    st
    (cg-functions-step st (fh-if fns) (tl2 fns))))

(defn cg-functions-step (st f rest)
  (match f
    (IFn nm params body
      (cg-functions-go st nm f rest))
    (d96 (cg-functions st rest))))

(defn cg-functions-go (st nm f rest)
  (cg-functions (cg-function st f) rest))

; Emit one rodata entry.
(defn cg-rodata-entry (st e)
  (match e
    (REntry lbl text kind
      (if (= kind 0)
        (cg-str-entry st lbl text)
        (cg-flt-entry st lbl text)))))

; Escape a string for a .string directive: backslash and quote doubled,
; everything else copied verbatim. Deterministic left-to-right.
(defn cg-escape (arena s)
  (let n (alloc-strlen s)
    (cg-esc-loop arena s n 0 (arena-alloc-zeroed arena (+ (* 2 n) 1)))))

(defn cg-esc-loop (arena s n i out)
  (if (>= i n)
    out
    (cg-esc-ch arena s n i out (byte-at s i))))

(defn cg-esc-ch (arena s n i out c)
  (if (= c 92)
    (cg-esc-both arena s n i out c)
    (if (= c 34)
      (cg-esc-quote arena s n i out c)
      (if (= c 10)
        (cg-esc-newline arena s n i out)
        (cg-esc-one arena s n i out c)))))

(defn cg-esc-one (arena s n i out c)
  (begin
    (buf-append out (sub-str arena s i 1))
    (cg-esc-loop arena s n (+ i 1) out)))

(defn cg-esc-both (arena s n i out c)
  (begin
    (buf-append out (sub-str arena s i 1))
    (buf-append out (sub-str arena s i 1))
    (cg-esc-loop arena s n (+ i 1) out)))

(defn cg-esc-quote (arena s n i out c)
  (begin
    (buf-append out (str-intern arena "\\"))
    (buf-append out (sub-str arena s i 1))
    (cg-esc-loop arena s n (+ i 1) out)))

(defn cg-esc-newline (arena s n i out)
  (begin
    (buf-append out (str-intern arena "\\"))
    (buf-append out (str-intern arena "n"))
    (cg-esc-loop arena s n (+ i 1) out)))

(defn cg-str-entry (st lbl content)
  (let st2 (cg-label-def st lbl)
    (let st4 (cg-emit st2 "    .string \"")
      (let st5 (cg-emit st4 (cg-escape (cg-arena-of st) content))
        (cg-nl (cg-emit st5 "\""))))))

; Emit "<label>:" on one line.
(defn cg-label-def (st lbl)
  (cg-nl (cg-emit (cg-emit st lbl) ":")))

(defn cg-flt-entry (st lbl text)
  (let st2 (cg-label-def st lbl)
    (let st4 (cg-emit st2 "    .double ")
      (cg-nl (cg-emit st4 text)))))

(defn cg-rodata-emit-list (st xs)
  (match xs
    (Nil st)
    (Cons e rest
      (let st2 (cg-rodata-entry st e)
        (cg-rodata-emit-list st2 rest)))))
; ===========================================================================
; TYPED LIST HEADS/TAILS (total via fallback values)
; ===========================================================================

; Shared polymorphic list head (constraint 6 lifted: per-site generic
; inference makes one shared helper safe across element types).
(defn list-head-or (xs default)
  (match xs
    (Cons a d70 a)
    (Nil default)))

(defn ih-ic (xs)
  (list-head-or xs (IConst 0)))

(defn fh-if (xs)
  (list-head-or xs (IFn "" Nil (IConst 0))))

(defn hd-ia (xs)
  (list-head-or xs (IArm "" -1 Nil (IConst 0))))

; Head of a list of Icnf nodes (distinct from hd-ia: IArm lists).
(defn hd-icnf (xs)
  (match xs
    (Cons a d74a a)
    (Nil (IConst 0))))

(defn cg-arena-of (st)
  (match st
    (CGS a d74 d75 d76 d77 d78 a)))

(defn tl2 (xs)
  (match xs
    (Cons a rest rest)
    (Nil Nil)))
