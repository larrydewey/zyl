; === Zyl Standard Library — Self-Hosting: x86_64 codegen ===
; Module: compiler/codegen
;
; Walks the recursive Icnf instruction tree (see compiler/icnf) and emits
; GAS .intel_syntax noprefix assembly text. Expression code is evaluated
; into rax (a pure stack-machine discipline): every sub-expression leaves
; its value in rax; binary operators push the left operand around the
; right operand's evaluation.
;
; Conventions:
;   - Parameters arrive in SysV registers (rdi rsi rdx rcx r8 r9) and are
;     spilled to [rbp-8*(i+1)] in the prologue.
;   - Locals (let / match bindings) get slots from a downward-growing
;     offset counter threaded through the emitter state.
;   - Names are resolved through an immutable Env chain (see ast.zyl).
;   - Calls support up to 6 register arguments; argument values are pushed
;     and popped in reverse so evaluation order stays strictly
;     left-to-right (spec evaluation-order rule).
;   - Floats travel as bit patterns in rax and move to xmm0/xmm1 for SSE
;     arithmetic; print selects %d/%f/%s by the operand's syntactic kind.

(use allocator/allocator)
(use compiler/ast)
(use compiler/icnf)

; Emitter state cells:
;   [0]=arena  [8]=text buffer  [16]=label counter  [24]=next slot offset
;   [32]=rodata list (Rodata)
(defn cg-new (arena)
  (let st (arena-alloc-zeroed arena 48)
    (let buf (arena-alloc-zeroed arena 8388608)
      (begin
        (alloc-write-int st arena)
        (alloc-write-int (+ st 8) buf)
        (alloc-write-int (+ st 16) 0)
        (alloc-write-int (+ st 24) 8)   ; params occupy slots 1..n
        (alloc-write-int (+ st 32) (RNil))
        st))))

(defn cg-emit (st s)
  (buf-append (alloc-read-int (+ st 8)) s))

(defn cg-emit-int (st n)
  (cg-emit st (ffi-call "zyl_cstr_from_int" (alloc-read-int st) n 1000)))

(defn cg-nl (st) (cg-emit st "
"))

; Fresh label .L<N>; returns the label string.
(defn cg-label-new (st)
  (let arena (alloc-read-int st)
    (let n (alloc-read-int (+ st 16))
      (let buf (arena-alloc-zeroed arena 32)
        (begin
          (alloc-write-int (+ st 16) (+ n 1))
          (buf-append buf (str-intern arena ".L"))
          (buf-append buf (ffi-call "zyl_cstr_from_int" arena n 1000))
          buf)))))

; Allocate one 8-byte local slot; returns its rbp offset (negative).
(defn cg-new-slot (st)
  (let off (alloc-read-int (+ st 24))
    (begin
      (alloc-write-int (+ st 24) (+ off 8))
      (- off))))

; ===========================================================================
; RODATA COLLECTION (threaded through state cell [32]... see cg-rodata*)
; Rodata entries live in an immutable list stored at state offset 32.
; ===========================================================================

(deftype Rodata
  (RStr String String Rodata)   ; label, content
  (RFlt String String Rodata)   ; label, literal text
  (RNil))

(defn cg-rodata-get (st) (alloc-read-int (+ st 32)))
(defn cg-rodata-put (st rd) (alloc-write-int (+ st 32) rd))

; Intern a string constant; emit `lea rax, [rip+label]`.
(defn cg-string-const (st content)
  (let lbl (cg-label-new st)
    (begin
      (cg-rodata-put st (RStr lbl content (cg-rodata-get st)))
      (cg-emit st "    lea rax, [rip+")
      (cg-emit st lbl)
      (cg-emit st "]")
      (cg-nl st))))

; Intern a float constant; load its bits into rax via xmm0.
(defn cg-float-const (st text)
  (let lbl (cg-label-new st)
    (begin
      (cg-rodata-put st (RFlt lbl text (cg-rodata-get st)))
      (cg-emit st "    movsd xmm0, [rip+")
      (cg-emit st lbl)
      (cg-emit st "]")
      (cg-nl st)
      (cg-emit st "    movq rax, xmm0")
      (cg-nl st))))

; ===========================================================================
; KINDS (for print format + float detection)
; ===========================================================================
; 0 int, 1 string, 2 float

(defn kind-of (env e)
  (match e
    (IConst 0)
    (IStr  w1 1)
    (IFlt  w2 2)
    (ILoad n (env-kind-of env n))
    (IBinop op l r
     (if (> op 4)
       0
       (let kl (kind-of env l)
         (let kr (kind-of env r)
           (if (= kl 2)
             2
             (if (= kr 2) 2 0))))))
    (IIf c t e (kind-of env t))
    (ICall  w3  w4 0)
    (IFfi  w5  w6 0)
    (IPrint  w7 0)
    (IWhile c b 0)
    (ISet  w8  w9 0)
    (ILet  w10  w11  w12 0)
    (ISeq  w13 0)
    (IVariant  w14  w15  w16 0)
    (IMatch  w17  w18 0)))

; ===========================================================================
; EXPRESSION EMISSION (result always in rax)
; ===========================================================================

(defn cg-expr (st env e)
  (match e
    (IConst v
     (begin
       (cg-emit st "    mov rax, ")
       (cg-emit-int st v)
       (cg-nl st)))
    (IStr s (cg-string-const st s))
    (IFlt t (cg-float-const st t))
    (ILoad n
     (begin
       (cg-emit st "    mov rax, [rbp")
       (cg-emit-int st (env-lookup env n))
       (cg-emit st "]")
       (cg-nl st)))
    (IBinop op l r
     (if (> (if (= (kind-of env l) 2) 1 (if (= (kind-of env r) 2) 1 0)) 0)
       (cg-fbinop st env op l r)
       (cg-ibinop st env op l r)))
    (ICall name args (cg-call-args st env name args true 0))
    (IFfi sym args (cg-call-args st env sym args false 0))
    (IPrint a (cg-print st env a))
    (IIf c t eb
     (let lelse (cg-label-new st)
       (let lend (cg-label-new st)
         (begin
           (cg-expr st env c)
           (cg-emit st "    test rax, rax")
           (cg-nl st)
           (cg-emit st "    je ")
           (cg-emit st lelse)
           (cg-nl st)
           (cg-expr st env t)
           (cg-emit st "    jmp ")
           (cg-emit st lend)
           (cg-nl st)
           (cg-emit-label st lelse)
           (cg-expr st env eb)
           (cg-emit-label st lend)))))
    (IWhile c body
     (let lstart (cg-label-new st)
       (let lend (cg-label-new st)
         (begin
           (cg-emit-label st lstart)
           (cg-expr st env c)
           (cg-emit st "    test rax, rax")
           (cg-nl st)
           (cg-emit st "    je ")
           (cg-emit st lend)
           (cg-nl st)
           (cg-expr st env body)
           (cg-emit st "    jmp ")
           (cg-emit st lstart)
           (cg-nl st)
           (cg-emit-label st lend)
           (cg-emit st "    xor eax, eax")
           (cg-nl st)))))
    (ISet n v
     (begin
       (cg-expr st env v)
       (cg-emit st "    mov [rbp")
       (cg-emit-int st (env-lookup env n))
       (cg-emit st "], rax")
       (cg-nl st)))
    (ILet n v body
     (let off (cg-new-slot st)
       (let k (kind-of env v)
         (begin
           (cg-expr st env v)
           (cg-emit st "    mov [rbp")
           (cg-emit-int st off)
           (cg-emit st "], rax")
           (cg-nl st)
           (cg-expr st (EnvBind n off k env) body)))))
    (ISeq es (cg-seq st env es))
    (IVariant  w19 tag fields (cg-variant st env tag fields))
    (IMatch scr arms (cg-match st env scr arms))))

(defn cg-seq (st env es)
  (if (is-nil es)
    (begin
      (cg-emit st "    xor eax, eax")
      (cg-nl st))
    (if (is-nil (list-cdr es))
      (cg-expr st env (ih es))
      (begin
        (cg-expr st env (ih es))
        (cg-seq st env (tl2 es))))))

; Integer binary op: lhs -> rax (pushed), rhs -> rax, lhs restored to rax,
; rhs kept in rcx. Div/Rem use cqo/idiv with divisor safe in rcx.
(defn cg-ibinop (st env op l r) (begin (cg-expr st env l) (cg-emit st "    push rax") (cg-nl st) (cg-expr st env r) (cg-emit st "    mov rcx, rax") (cg-nl st) (cg-emit st "    pop rax") (cg-nl st) (if (< op 5) (begin (let mnem (if (= op 0) "    add rax, rcx" (if (= op 1) "    sub rax, rcx" (if (= op 2) "    imul rax, rcx" "    idiv rcx"))) (begin (if (= op 3) (begin (cg-emit st "    cqo") (cg-nl st)) 0) (cg-emit st mnem) (cg-nl st) (if (= op 4) (begin (cg-emit st "    mov rax, rdx") (cg-nl st)) 0)))) (begin (cg-emit st "    cmp rax, rcx") (cg-nl st) (cg-emit st "    set") (if (= op 5) (cg-emit st "l al") (if (= op 6) (cg-emit st "g al") (if (= op 7) (cg-emit st "le al") (if (= op 8) (cg-emit st "ge al") (if (= op 9) (cg-emit st "e al") (cg-emit st "ne al")))))) (cg-nl st) (cg-emit st "    movzx rax, al") (cg-nl st)))))

; Float binary op: bits in rax; xmm0 = lhs, xmm1 = rhs.
(defn cg-fbinop (st env op l r)
  (begin
    (cg-expr st env l)
    (cg-emit st "    push rax")
    (cg-nl st)
    (cg-expr st env r)
    (cg-emit st "    movq xmm1, rax")
    (cg-nl st)
    (cg-emit st "    pop rax")
    (cg-nl st)
    (cg-emit st "    movq xmm0, rax")
    (cg-nl st)
    (if (< op 5)
      (begin
        (cg-emit st "    ")
        (if (= op 0) (cg-emit st "addsd"))
        (if (= op 1) (cg-emit st "subsd"))
        (if (= op 2) (cg-emit st "mulsd"))
        (if (= op 3) (cg-emit st "divsd"))
        (cg-emit st " xmm0, xmm1")
        (cg-nl st)
        (cg-emit st "    movq rax, xmm0")
        (cg-nl st))
      (begin
        (cg-emit st "    comisd xmm0, xmm1")
        (cg-nl st)
        (cg-emit st "    set")
        ; unsigned-comparison flags: below/above carry the usual sense here
        (if (= op 5) (cg-emit st "b al")
          (if (= op 6) (cg-emit st "a al")
            (if (= op 7) (cg-emit st "be al")
              (if (= op 8) (cg-emit st "ae al")
                (if (= op 9) (cg-emit st "e al")
                  (cg-emit st "ne al"))))))
        (cg-nl st)
        (cg-emit st "    movzx rax, al")
        (cg-nl st)))))

; Register-name dispatch by arg index (SysV).
(defn cg-reg-of (i)
  (if (= i 0) "rdi"
    (if (= i 1) "rsi"
      (if (= i 2) "rdx"
        (if (= i 3) "rcx"
          (if (= i 4) "r8"
            "r9"))))))

; Call: evaluate args left-to-right, pushing each result; then pop into
; registers in reverse; call; clean up any pad. `mangle` adds the f_ prefix
; for user functions.
(defn cg-call-args (st env name args mangle i)
  (if (is-nil args)
    (cg-call-fire st env name mangle i)
    (begin
      (cg-expr st env (ih args))
      (cg-emit st "    push rax")
      (cg-nl st)
      (cg-call-args st env name (tl2 args) mangle (+ i 1)))))

(defn cg-call-fire (st env name mangle i)
  (let pad (if (= (% i 2) 1)
             1
             0)
    (begin
      (cg-pop-regs st (- i 1))
      ; alignment pad goes AFTER the pops so it cannot shift a pushed arg
      ; out of place for the register pops.
      (if (= pad 1)
        (begin
          (cg-emit st "    sub rsp, 8")
          (cg-nl st))
        0)
      (cg-emit st "    call ")
      (if mangle (cg-emit st "f_") 0)
      (cg-emit st (ffi-call "zyl_cstr_sanitize" (alloc-read-int st) name 1000))
      (cg-nl st)
      (if (= pad 1)
        (begin
          (cg-emit st "    add rsp, 8")
          (cg-nl st))
        0))))

; Pop j+1 pushed args into their registers (reverse order).
(defn cg-pop-regs (st j)
  (if (< j 0)
    0
    (begin
      (cg-emit st "    pop ")
      (cg-emit st (cg-reg-of j))
      (cg-nl st)
      (cg-pop-regs st (- j 1)))))

; print: pick the format by the argument's kind.
(defn cg-print (st env a)
  (let k (kind-of env a)
    (begin
      (cg-expr st env a)
      (if (= k 2)
        (begin
          ; float: value already in xmm-compatible bits
          (cg-emit st "    movq xmm0, rax")
          (cg-nl st)
          (cg-emit st "    lea rdi, [rip+.Lfmtf]")
          (cg-nl st)
          (cg-emit st "    mov eax, 1")
          (cg-nl st))
        (if (= k 1)
          (begin
            (cg-emit st "    mov rsi, rax")
            (cg-nl st)
            (cg-emit st "    lea rdi, [rip+.Lfmts]")
            (cg-nl st)
            (cg-emit st "    xor eax, eax")
            (cg-nl st))
          (begin
            (cg-emit st "    mov rsi, rax")
            (cg-nl st)
            (cg-emit st "    lea rdi, [rip+.Lfmtd]")
            (cg-nl st)
            (cg-emit st "    xor eax, eax")
            (cg-nl st))))
      (cg-emit st "    call printf")
      (cg-nl st))))

; Variant construction: malloc'd block [tag][f0]..[fn-1].
; Fields are evaluated and pushed, then popped into the block (right to
; left). An odd field count gets 8 bytes of pad to keep rsp 16-aligned
; across malloc.
(defn cg-variant (st env tag fields)
  (let n (list-length fields)
    (begin
      (cg-push-fields st env fields)
      (if (= (% n 2) 1)
        (begin
          (cg-emit st "    sub rsp, 8")
          (cg-nl st))
        0)
      (cg-emit st "    mov rdi, ")
      (cg-emit-int st (* 8 (+ n 1)))
      (cg-nl st)
      (cg-emit st "    call malloc")
      (cg-nl st)
      (cg-emit st "    mov rbx, rax")
      (cg-nl st)
      (cg-emit st "    mov qword ptr [rbx], ")
      (cg-emit-int st tag)
      (cg-nl st)
      (if (= (% n 2) 1)
        (begin
          (cg-emit st "    add rsp, 8")
          (cg-nl st))
        0)
      (cg-pop-fields st (- n 1))
      (cg-emit st "    mov rax, rbx")
      (cg-nl st))))

; Evaluate each field left-to-right, pushing its value.
(defn cg-push-fields (st env fields)
  (if (is-nil fields)
    0
    (begin
      (cg-expr st env (ih fields))
      (cg-emit st "    push rax")
      (cg-nl st)
      (cg-push-fields st env (tl2 fields)))))

; Pop n fields into the block rbx points at (reverse order restores the
; original left-to-right layout).
(defn cg-pop-fields (st j)
  (if (< j 0)
    0
    (begin
      (cg-emit st "    pop rax")
      (cg-nl st)
      (cg-emit st "    mov [rbx+")
      (cg-emit-int st (* 8 (+ j 1)))
      (cg-emit st "], rax")
      (cg-nl st)
      (cg-pop-fields st (- j 1)))))

; Match: evaluate scrutinee, keep it on the stack for the whole dispatch,
; replace it with the arm-body result, pop at the end.
; Stack invariant: exactly one pushed word ([rsp] = scrutinee or result).
(defn cg-match (st env scr arms)
  (let lend (cg-label-new st)
    (let lzero (cg-label-new st)
      (begin
        (cg-expr st env scr)
        (cg-emit st "    push rax")
        (cg-nl st)
        (cg-arms st env arms lend lzero)
        ; fall-through: no arm matched -> 0
        (cg-emit-label st lzero)
        (cg-emit st "    mov qword ptr [rsp], 0")
        (cg-nl st)
        (cg-emit-label st lend)
        (cg-emit st "    pop rax")
        (cg-nl st)))))

; Emit arms[i..]. Each arm checks [rsp]'s tag; a failed check jumps to
; the next arm's label (or the zero fall-through after the last arm); a
; successful match binds pattern vars and evaluates the body.
(defn cg-arms (st env arms lend lzero)
  (if (is-nil arms)
    0
    (let arm (list-car arms)
      (match arm
        (IArm vname tag binds body
         (let rest (list-cdr arms)
           (let lnext (if (is-nil rest) lzero (cg-label-new st))
             (begin
               ; tag check: [rsp] holds the scrutinee pointer
               (cg-emit st "    mov rax, [rsp]")
               (cg-nl st)
               (cg-emit st "    mov rax, [rax]")
               (cg-nl st)
               (cg-emit st "    cmp rax, ")
               (cg-emit-int st tag)
               (cg-nl st)
               (cg-emit st "    jne ")
               (cg-emit st lnext)
               (cg-nl st)
               ; bind pattern vars to fields, then emit the body
               (let arm-env (cg-bind-fields st env binds 0)
                 (begin
                   (cg-expr st arm-env body)
                   (cg-emit st "    mov [rsp], rax")
                   (cg-nl st)
                   (cg-emit st "    jmp ")
                   (cg-emit st lend)
                   (cg-nl st)))
               (if (is-nil rest)
                 0
                 (begin
                   (cg-emit-label st lnext)
                   (cg-arms st env rest lend lzero)))))))))))

; Bind pattern variables: field j of [rsp]'s block goes into a fresh slot.
; Returns: Env (the extended environment).
(defn cg-bind-fields (st env binds j)
  (if (is-nil binds)
    env
    (let b (list-car binds)
      (begin
        (cg-emit st "    mov rax, [rsp]")
        (cg-nl st)
        (cg-emit st "    mov rax, [rax+")
        (cg-emit-int st (* 8 (+ j 1)))
        (cg-emit st "]")
        (cg-nl st)
        (if (str-eq b (str-intern (alloc-read-int st) "_"))
          (cg-bind-fields st env (tl2 binds) (+ j 1))
          (let off (cg-new-slot st)
            (begin
              (cg-emit st "    mov [rbp")
              (cg-emit-int st off)
              (cg-emit st "], rax")
              (cg-nl st)
              (cg-bind-fields st (EnvBind b off 0 env) (list-cdr binds) (+ j 1)))))))))

(defn cg-emit-label (st lbl)
  (begin
    (cg-emit st lbl)
    (cg-emit st ":")
    (cg-nl st)))

; ===========================================================================
; FUNCTION / PROGRAM EMISSION
; ===========================================================================

(defn cg-function (st f)
  (match f
    (IFn name params body
     (let env (cg-param-env params 0 None)
       (begin
         (cg-emit st "f_")
         (cg-emit st (ffi-call "zyl_cstr_sanitize" (alloc-read-int st) name 1000))
         (cg-emit st ":")
         (cg-nl st)
         (cg-emit st "    push rbp")
         (cg-nl st)
         (cg-emit st "    mov rbp, rsp")
         (cg-nl st)
         (cg-emit st "    sub rsp, 4096")
         (cg-nl st)
         (cg-param-spills st 0 (list-length params))
         (alloc-write-int (+ st 24) (* 8 (+ 1 (list-length params)))) ; locals start after params
         (cg-expr st env body)
         (cg-emit st "    mov rsp, rbp")
         (cg-nl st)
         (cg-emit st "    pop rbp")
         (cg-nl st)
         (cg-emit st "    ret")
         (cg-nl st))))))

; Immutable param environment: param i -> offset -(8*(i+1)).
(defn cg-param-env (params i acc)
  (if (is-nil params)
    acc
    (cg-param-env (tl2 params) (+ i 1)
                  (EnvBind (shd params) (- (* 8 (+ i 1))) 0 acc))))

; Spill incoming SysV registers to param slots.
(defn cg-param-spills (st i n)
  (if (>= i n)
    0
    (begin
      (cg-emit st "    mov [rbp")
      (cg-emit-int st (- (* 8 (+ i 1))))
      (cg-emit st "], ")
      (cg-emit st (cg-reg-of i))
      (cg-nl st)
      (cg-param-spills st (+ i 1) n))))

; Emit the whole program: header, functions, entry stub, rodata.
; Functions are emitted in lowering order (source order); the entry stub
; calls f_main, which the lowering guarantees exists.
(defn cg-program (st fns)
  (begin
    (cg-emit st ".intel_syntax noprefix")
    (cg-nl st)
    (cg-emit st ".text")
    (cg-nl st)
    (cg-emit st ".globl main")
    (cg-nl st)
    (cg-functions st fns)
    (cg-emit st "main:")
    (cg-nl st)
    (cg-emit st "    push rbp")
    (cg-nl st)
    (cg-emit st "    mov rbp, rsp")
    (cg-nl st)
    (cg-emit st "    call f_main")
    (cg-nl st)
    (cg-emit st "    xor eax, eax")
    (cg-nl st)
    (cg-emit st "    pop rbp")
    (cg-nl st)
    (cg-emit st "    ret")
    (cg-nl st)
    (cg-emit st ".section .rodata")
    (cg-nl st)
    (cg-emit st ".Lfmtd:")
    (cg-nl st)
    (cg-emit st "    .string \"%d\\n\"")
    (cg-nl st)
    (cg-emit st ".Lfmtf:")
    (cg-nl st)
    (cg-emit st "    .string \"%f\\n\"")
    (cg-nl st)
    (cg-emit st ".Lfmts:")
    (cg-nl st)
    (cg-emit st "    .string \"%s\\n\"")
    (cg-nl st)
    (cg-rodata-emit st (cg-rodata-get st))))


; Typed list heads (total via fallback values).
(defn ih (xs)
  (match xs
    (Cons a rest a)
    (None (IConst 0))))

(defn fh (xs)
  (match xs
    (Cons f rest f)
    (None (IFn "" None (IConst 0)))))

(defn shd (xs)
  (match xs
    (Cons s rest s)
    (None "")))

(defn cg-functions (st fns)
  (if (is-nil fns)
    0
    (begin
      (cg-function st (fh fns))
      (cg-functions st (tl2 fns)))))

(defn cg-rodata-emit (st rd)
  (match rd
    (RNil 0)
    (RStr lbl content rest
     (begin
       (cg-emit st lbl)
       (cg-emit st ":")
       (cg-nl st)
       (cg-emit st "    .string \"")
       (cg-emit st content)
       (cg-emit st "\"")
       (cg-nl st)
       (cg-rodata-emit st rest)))
    (RFlt lbl text rest
     (begin
       (cg-emit st lbl)
       (cg-emit st ":")
       (cg-nl st)
       (cg-emit st "    .double ")
       (cg-emit st text)
       (cg-nl st)
       (cg-rodata-emit st rest)))))

; Return the emitter's text buffer pointer.
(defn cg-buffer (st)
  (alloc-read-int (+ st 8)))

(defn tl2 (xs)
  (match xs
    (Cons a rest rest)
    (None None)))
