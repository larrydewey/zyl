; === Explaining an error code ===
; Module: compiler/explain
;
; `zyl explain E_ARITY_MISMATCH`: what the code means, which phase raises it,
; and where in this tree it is raised -- with the diagnostic text that site
; produces, which is where the fix for it is written down.
;
; WHY THIS IS A COMMAND. There are over a hundred codes, each raised from up to a dozen
; places, and the useful part of a code is not its name but the sentence that
; tells you what to do about it. That sentence already exists, once per raise
; site, as the `help` argument the compiler passes alongside the message. It
; was only ever printed at the moment of failure, and only for the one site
; that fired. So the knowledge was in the tree and unreachable until something
; failed.
;
; The common codes also carry a short table (explain-notes), kept honest by tests/scripts/explain-examples.sh.
;
; The scan is a substring search over the tree, not a parse. It has to cope
; with source that does not compile, with comments, and with a half-written
; file, so it never needs to be correct about Zyl -- only about text.

(use compiler/error_codes)
; sb-read-all and sb-read-file, for reading the tree. Declared rather than
; picked up from whichever module happens to be compiled alongside: without
; this, `use compiler/explain` from a program that does not also use the
; compiler's own reader failed with an unbound `sb-read-all`.
(use compiler/sexp_balance)

; ---------------------------------------------------------------------------
; The catalog
; ---------------------------------------------------------------------------

; A single-variant record, so one arm is exhaustive and a catch-all after it
; would be E_UNREACHABLE_MATCH_ARM.
;
; The arm's body is the LAST element inside the pattern form, not a form after
; it: `(Rec b1 b2 body)`. Written as `(match c (EC a b c d) body)` the body is
; a stray form and every binding reads as unbound -- which is what "unbound
; identifier" pointed at here for four accessors in a row.
(defn ec-name (c) (match c (EC an ap as am an)))
(defn ec-phase (c) (match c (EC an ap as am ap)))
(defn ec-severity (c) (match c (EC an ap as am as)))
(defn ec-message (c) (match c (EC an ap as am am)))

; The catalog's phase number, as words a reader can act on.
(defn ec-phase-name (p)
  (match p
    (1 "reading the source")
    (2 "reading the source")
    (3 "macros")
    (4 "types")
    (5 "types")
    (6 "memory regions")
    (7 "code generation")
    (8 "code generation and linking")
    (9 "modules")
    (10 "running the program")
    (11 "tests")
    (12 "traits")
    (13 "capabilities")
    (14 "contracts")
    (15 "numbers")
    (16 "foreign calls")
    (17 "match")
    (18 "definitions and bindings")
    (19 "packages")
    (_ "other")))

(defn ec-severity-name (s) (if (= s 1) "error" (if (= s 2) "warning" "note")))

(defn ec-find (name codes)
  (match codes
    (Nil None)
    (Cons h t (if (str-eq (ec-name h) name) (Some h) (ec-find name t)))))

; Codes sharing a prefix, for a name that is not exactly one of them.
(defn ec-prefix (p codes acc)
  (match codes
    (Nil (list-reverse acc))
    (Cons h t
      (if (str-starts-with (ec-name h) p)
        (ec-prefix p t (Cons h acc))
        (ec-prefix p t acc)))))

(defn str-starts-with (s p)
  (if (< (str-length s) (str-length p))
    false
    (str-eq (str-substring s 0 (str-length p)) p)))

; ---------------------------------------------------------------------------
; Text search over the tree
; ---------------------------------------------------------------------------

; Every offset at which `needle` occurs in `hay`, in order.
; Every offset at which `needle` occurs in `hay`, in order. `n` is the length
; of the haystack, not 0: passing 0 made the bound test true immediately and the
; search return nothing at all, which is why every code reported "raised at 0
; places". And the limit handed to index-of is `n`, not `from + nl`: limiting
; each step to the current window means a needle further along is never found,
; so this found the first occurrence and nothing after it.
(defn find-all ((hay String) (needle String))
  (find-all-from hay needle 0 (str-length hay)))

(defn find-all-from ((hay String) (needle String) (from Int) (n Int))
  (let nl (str-length needle)
    (if (>= (+ from nl) n)
      Nil
      (let at (index-of hay needle from n)
        (if (< at 0)
          Nil
          (Cons at (find-all-from hay needle (+ at nl) n)))))))

; Index of `needle` in `hay` at or after `from`, or -1.
;
; The window is the NEEDLE's length, not the distance to the limit: comparing
; everything from `from` to the end against the needle can never match, so the
; first version of this found nothing anywhere in the tree and reported every
; code as raised zero times.
(defn index-of ((hay String) (needle String) (from Int) (limit Int))
  (let nl (str-length needle)
    (if (> (+ from nl) limit)
      -1
      (if (str-eq (str-substring hay from nl) needle)
        from
        (index-of hay needle (+ from 1) limit)))))

; Line number (1-based) of byte offset `off`.
(defn line-of ((src String) (off Int))
  (line-of-go src 0 off 1))

(defn line-of-go ((src String) (i Int) (off Int) (line Int))
  (if (>= i off)
    line
    (if (= (byte-at src i) 10)
      (line-of-go src (+ i 1) off (+ line 1))
      (line-of-go src (+ i 1) off line))))

(defn byte-at ((s String) (i Int))
  (if (< i (str-length s)) (ffi-call "zyl_view_byte" s 0 1099511627776 i 1000) 10))

(defn line-start ((src String) (off Int))
  (if (<= off 0) 0 (let p (last-nl-before src off) (if (< p 0) 0 (+ p 1)))))

(defn last-nl-before ((src String) (off Int))
  (let p (index-of-nl src 0 off)
    (if (< p 0) -1 (last-nl-before src p))))

(defn index-of-nl ((src String) (from Int) (limit Int))
  (if (>= from limit)
    -1
    (if (= (byte-at src from) 10) from (index-of-nl src (+ from 1) limit))))

(defn str-trim-left (s)
  (if (= (str-length s) 0)
    ""
    (if (= (ffi-call "zyl_view_byte" s 0 1099511627776 0 1000) 32)
      (str-trim-left (str-substring s 1 (- (str-length s) 1)))
      s)))

; ---------------------------------------------------------------------------
; One code, in full
; ---------------------------------------------------------------------------

; A place the code is raised: the file, and the line in it.
;
; The source text at that line was shown too, and removed: it needed a second
; line-lookup whose off-by-one printed the file header under every site, which
; is worse than not printing it. `file:line` is what an editor wants anyway.
;
; A record rather than a flat list of four interleaved values. The flat
; version needed an `off` and a `shown` smuggled through the same list as the
; path and the source, and reading it required counting elements -- in the file
; whose subject is not having to count things.
(deftype ExSite (ExSite String Int))

(defn site-path (x) (match x (ExSite p l p)))
(defn site-line (x) (match x (ExSite p l l)))

; How many sites to list. Every site is counted; the source line is shown for
; the first few, because a list of forty identical locations is less use than a
; few real ones.
(def ex-text-sites 6)
(def ex-site-cap 40)

(defn explain-code (code root files)
  (match (ec-find code (error-codes))
    (None
      (begin
        (print (str-concat "zyl explain: no code named " (str-concat code " in the catalog.")))
        (print "")
        (explain-similar code)
        1))
    (Some c
      (let sites (explain-sites code root files)
        (begin
          (print (str-concat code (str-concat "  (" (str-concat (ec-phase-name (ec-phase c)) (str-concat ", " (str-concat (ec-severity-name (ec-severity c)) ")"))))))
          (print "")
          (match (exn-find code (explain-notes))
            (Some x (print-note x))
            (None (begin
                    (print (str-concat "  " (ec-message c)))
                    (if (= (ec-severity c) 2)
                      (begin
                        (print "")
                        (print (str-concat "  a warning: the build goes on. To fix it, "
                          (str-concat (ex-fix-text code) "."))))
                      unit))))
          (print-site-block sites)
          0)))))

; Meaning, then the wrong program and its correction, each line indented.
(defn print-note (x)
  (begin
    (print (str-concat "  " (exn-meaning x)))
    (print "")
    (print "  wrong:")
    (print-indented (exn-wrong x))
    (print "  right:")
    (print-indented (exn-right x))))

(defn print-indented (src)
  (print-indented-go src 0 (str-length src)))

(defn print-indented-go (src i n)
  (if (>= i n)
    unit
    (let j (index-of-nl src i n)
      (let e (if (< j 0) n j)
        (begin
          (print (str-concat "    " (str-substring src i (- e i))))
          (print-indented-go src (+ e 1) n))))))

; Where the code is raised, when this tree has the compiler's source; nothing otherwise.
(defn print-site-block (sites)
  (let n (list-length sites)
    (if (= n 0)
      unit
      (begin
        (print "")
        (print (str-concat "  raised at "
          (str-concat (ffi-call "zyl_int_text" n 1000)
            (if (= n 1) " place in this tree:" " places in this tree:"))))
        (print-sites sites 0)))))

; A name that is not a code gets the codes that start with it, which is the
; question actually being asked far more often than "what does this mean".
(defn explain-similar (code)
  (let near (ec-prefix code (error-codes) Nil)
    (if (= (list-length near) 0)
      (begin
        (print "  Nothing in the catalog starts with that. `zyl explain` with no")
        (print "  argument lists every code."))
      (begin
        (print "  Codes starting with that:")
        (print-code-lines near)))))

(defn print-code-lines (xs)
  (match xs
    (Nil unit)
    (Cons h t
      (begin
        (print (code-line (ec-name h) (ec-message h)))
        (print-code-lines t)))))

; ---------------------------------------------------------------------------
; Finding the places a code is raised
; ---------------------------------------------------------------------------

(defn explain-sites (code root files)
  (explain-sites-go code root files 0 Nil))

(defn explain-sites-go ((code String) (root String) (files String) (n Int) (acc (List ExSite)))
  (if (>= n (ex-line-count files))
    (list-reverse acc)
    (let name (ex-file-at files n)
      (if (or (= (str-length name) 0) (ex-skipped-p name))
        (explain-sites-go code root files (+ n 1) acc)
        (let full (str-concat (str-concat root "/") name)
          (match (read-source full)
            (None (explain-sites-go code root files (+ n 1) acc))
            (Some src
              (let acc (add-hits acc src name (find-all src (quoted code)) 0)
                (explain-sites-go code root files (+ n 1) acc)))))))))

; Not raise sites: copies of the tree, tests that mention a code, and the catalog and this table.
(defn ex-skipped-p (name)
  (or (str-starts-with name "build/") (or (str-starts-with name ".claude/") (or (str-starts-with name "tests/")
    (or (str-eq name "stdlib/compiler/explain.zyl") (str-eq name "stdlib/compiler/error_codes.zyl"))))))

; The needle carries its own quotes, so a comment or a doc string mentioning
; the code does not count as a place it is raised.
(defn quoted (code) (str-concat "\"" (str-concat code "\"")))

(defn add-hits ((acc (List ExSite)) (src String) (rel String) (hits (List Int)) (n Int))
  (match hits
    (Nil acc)
    (Cons off rest
      (if (> (list-length acc) ex-site-cap)
        acc
        (Cons (ExSite rel (line-of src off)) (add-hits acc src rel rest (+ n 1)))))))

; One print per line, so a site is one line: `print` puts each value on its own
; line and three calls produced a path, a colon and a number on three lines.
(defn print-sites (sites (shown Int))
  (match sites
    (Nil unit)
    (Cons x rest
      (begin
        (print (str-concat (str-concat "    " (site-path x))
          (str-concat ":" (ffi-call "zyl_int_text" (site-line x) 1000))))
        (print-sites rest (+ shown 1))))))

; ---------------------------------------------------------------------------
; Every code
; ---------------------------------------------------------------------------

(defn explain-list ()
  (begin
    (print "zyl explain CODE: what a code means, with a wrong program and its fix.")
    (print "zyl explain warnings: the codes that do not stop the build.")
    (print-phases (error-codes) 0)
    0))

; ---------------------------------------------------------------------------
; The warnings
; ---------------------------------------------------------------------------

; `zyl explain warnings`: the codes whose severity is 2. They report
; something worth fixing and do not stop the build, which is the one
; question a reader has when a code they have never seen turns out to be
; spelled `warning[...]` -- and the one that is cheapest to answer badly,
; because a code with no explanation reads as a failure.
(defn explain-warnings ()
  (begin
    (print "Warnings: reported, and the build goes on. Each line says what to do.")
    (print-warnings (error-codes) 0)
    (print "")
    (print "They are also listed in docs/errors.md; `zyl explain CODE` explains one.")
    0))

(defn print-warnings (codes n)
  (match codes
    (Nil unit)
    (Cons h t
      (begin
        (if (= (ec-severity h) 2)
          (let _ (print (warn-line h))
            (print-warnings t (+ n 1)))
          (print-warnings t n))))))

(defn warn-line (c)
  (str-concat "  " (str-concat (ec-name c) (str-concat "  " (str-concat (ex-fix-text (ec-name c))
    (str-concat " -- " (ex-short-meaning c)))))))

; What to do about it. A note's corrected program is the fix where there
; is one; otherwise the advice is written out here, because a warning that
; names no action is the one a reader cannot act on.
(defn ex-fix-text (code)
  (match (exn-find code (explain-notes))
    (Some x (exn-fix x))
    (None (ex-warn-fix code))))

(defn ex-warn-fix (code)
  (if (str-eq code "W_UNUSED_PARAMETER") "remove it, or prefix it with `_` to mark it deliberately unused"
  (if (str-eq code "W_UNUSED_VARIABLE") "remove it, or prefix it with `_` to mark it deliberately unused"
  (if (str-eq code "W_SHADOWED_BINDING") "rename one of the two bindings"
  (if (str-eq code "W_RECOVER_SHADOW") "move the arm before the one that catches every error"
  (if (str-eq code "W_PANIC_UNMARKED") "rename it `name!` so callers can see it may stop the program, or return an Option"
  (if (str-eq code "E_ZEROIZE_MISSING") "call `zeroize`/`zeroize-bytes` on it, or let the function pass it on unchanged"
      "see docs/errors.md")))))))

; One heading per phase, in catalog order (the catalog is sorted by phase).
(defn print-phases (codes last)
  (match codes
    (Nil unit)
    (Cons h t
      (begin
        (if (str-eq (ec-phase-name (ec-phase h)) (ec-phase-name last))
          unit
          (begin (print "") (print (ec-phase-name (ec-phase h)))))
        (print (code-line (ec-name h) (ex-short-meaning h)))
        (print-phases t (ec-phase h))))))

; The table's sentence when there is one, else the catalog text without its "phase: " tag.
(defn ex-short-meaning (c)
  (match (exn-find (ec-name c) (explain-notes))
    (Some x (exn-meaning x))
    (None
      (let m (ec-message c)
        (let i (index-of m ": " 0 (str-length m))
          (ex-drop-at-s (if (and (>= i 0) (< i 16)) (str-substring m (+ i 2) (- (str-length m) (+ i 2))) m)))))))

; The catalog's " at S" stands for a source position, which a listing has none of.
(defn ex-drop-at-s (m)
  (let i (index-of m " at S" 0 (str-length m))
    (if (< i 0)
      m
      (let after (+ i 5)
        (if (and (< after (str-length m)) (let b (byte-at m after) (or (and (>= b 65) (<= b 90)) (and (>= b 97) (<= b 122)))))
          m
          (ex-drop-at-s (str-concat (str-substring m 0 i) (str-substring m after (- (str-length m) after)))))))))

; One print per line: `print` puts every value on its own line, so a label and
; its value printed separately come out as two lines. Everything here builds the
; line and prints it once.
(defn code-line (name message)
  (str-concat (str-concat "  " name) (str-concat (pad name 34) message)))

(defn field-line (label value)
  (let tag (str-concat label ":")
    (str-concat (str-concat "  " tag) (str-concat (pad tag 12) value))))

; `width` minus the name's length, as a string of spaces. It returns the
; padding rather than printing it, because every caller is building a line.
(defn pad (s width)
  (let n (- width (str-length s))
    (if (< n 2) "  " (spaces n))))

(defn spaces (n)
  (spaces-go n ""))

(defn spaces-go (n acc)
  (if (<= n 0) acc (spaces-go (- n 1) (str-concat acc " "))))

; ---------------------------------------------------------------------------
; File enumeration, borrowed in shape from drv-balance
; ---------------------------------------------------------------------------

; `len` is the listing's length, not 0: passing 0 made the bound test true
; immediately, so the scan reported zero files and every code reported "raised
; at 0 places" -- the same mistake as find-all, in the function that feeds it.
(defn ex-line-count (listing)
  (ex-line-count-go listing 0 (str-length listing)))

(defn ex-line-count-go ((listing String) (i Int) (len Int))
  (if (>= i len) 0 (+ 1 (ex-line-count-go listing (next-nl listing i len) len))))

(defn next-nl ((listing String) (i Int) (len Int))
  (let j (index-of-nl listing i len) (if (< j 0) len (+ j 1))))

(defn ex-file-at (listing (n Int))
  (let i (nth-start listing n 0 0 (str-length listing))
    (if (< i 0)
      ""
      (let j (index-of-nl listing i (str-length listing))
        (str-substring listing i (if (< j 0) (str-length listing) (- j i)))))))

; Byte offset where the n-th entry starts.
(defn nth-start ((listing String) (n Int) (count Int) (i Int) (len Int))
  (if (>= count n)
    i
    (let j (next-nl listing i len)
      (if (>= j len) -1 (nth-start listing n (+ count 1) j len)))))

(defn read-source (path)
  (let fd (file-open path "r")
    (if (< fd 1)
      None
      (let s (sb-read-all fd "")
        (begin (file-close fd) (Some s))))))

; Prose for the most common codes: meaning, a minimal wrong program, its correction.
; tests/scripts/explain-examples.sh compiles every pair and requires the wrong one to raise its code.
(deftype ExNote (ExN String String String String))

(defn exn-code (x) (match x (ExN c _ _ _ c)))
(defn exn-meaning (x) (match x (ExN _ m _ _ m)))
(defn exn-wrong (x) (match x (ExN _ _ w _ w)))
(defn exn-right (x) (match x (ExN _ _ _ r r)))
; What to do about it, when the note says. A warning that names no action
; is the one a reader cannot act on.
(defn exn-fix (x) (match x (ExN _ _ _ f f)))

(defn explain-notes ()
  (Cons (ExN "E_TYPE_MISMATCH" "A value has a different type from the one this place needs."
          "(defn main () (begin (print (+ 1 \"2\")) 0))"
          "(defn main () (begin (print (+ 1 2)) 0))")
  (Cons (ExN "E_MALFORMED_FORM" "A special form is missing a part, or has one too many."
          "(defn main () (let x 1))"
          "(defn main () (let x 0 x))")
  (Cons (ExN "E_CANNOT_INFER" "Nothing in the program says what type this is; a foreign function needs an `extern` with its signature."
          "(capabilities ffi)\n(defn main () (begin (print (ffi-call \"abs\" -3 1000)) 0))"
          "(capabilities ffi)\n(extern \"abs\" (Int) Int)\n(defn main () (begin (print (ffi-call \"abs\" -3 1000)) 0))")
  (Cons (ExN "E_MUT_CONFLICT" "`set!` changes only a `let-mut` binding; every other binding and every struct field is immutable."
          "(defn main () (let n 1 (begin (set! n 2) n)))"
          "(defn main () (let-mut n 1 (begin (set! n 2) (- n 2))))")
  (Cons (ExN "E_UNBOUND_VARIABLE" "A name is used that nothing defines here: a typo, a missing `(use ...)`, or a binding out of scope."
          "(defn main () (begin (print (str-lenght \"abc\")) 0))"
          "(defn main () (begin (print (str-length \"abc\")) 0))")
  (Cons (ExN "E_REGION_ESCAPE" "A value would outlive the region it was allocated in."
          "(defn make-buf () (bytebuf Stack 16))\n(defn main () (begin (print (bytebuf-cap (make-buf))) 0))"
          "(defn make-buf () (bytebuf Heap 16))\n(defn main () (begin (print (bytebuf-cap (make-buf))) 0))")
  (Cons (ExN "E_MALFORMED_PARAMETER" "A parameter is not a name or a `(name Type)` pair with a concrete type."
          "(defn f ((a Ord)) a)\n(defn main () (f 0))"
          "(defn f ((a Int)) a)\n(defn main () (f 0))")
  (Cons (ExN "E_ARITY_MISMATCH" "A function is called with a different number of arguments than it takes."
          "(defn add (a b) (+ a b))\n(defn main () (add 1))"
          "(defn add (a b) (+ a b))\n(defn main () (- (add 1 2) 3))")
  (Cons (ExN "E_FFI_RESTRICTED" "A program called a locked runtime primitive, which only the runtime itself may use."
          "(defn main () (begin (print (ffi-call \"%load64\" 4096 1000)) 0))"
          "(defn main () (begin (print (ffi-call \"zyl_cstr_len\" \"abc\" 1000)) 0))")
  (Cons (ExN "E_INVALID_CAPABILITY" "A value that cannot cross into foreign code, such as a closure, was passed to `ffi-call`."
          "(defn main () (begin (ffi-call \"zyl_cstr_len\" (fn (x) x) 1000) 0))"
          "(defn main () (begin (ffi-call \"zyl_cstr_len\" \"x\" 1000) 0))")
  (Cons (ExN "E_MATCH_NONEXHAUSTIVE" "A match on literals has no arm for the values none of its patterns name."
          "(defn f (n) (match n (1 10) (2 20)))\n(defn main () (begin (print (f 1)) 0))"
          "(defn f (n) (match n (1 10) (2 20) (_ 0)))\n(defn main () (begin (print (f 1)) 0))")
  (Cons (ExN "E_NON_EXHAUSTIVE_MATCH" "A match on a type's constructors leaves one of them without an arm."
          "(deftype Shape (Circle Int) (Square Int))\n(defn area (s) (match s (Circle r (* r r))))\n(defn main () (area (Circle 0)))"
          "(deftype Shape (Circle Int) (Square Int))\n(defn area (s) (match s (Circle r (* r r)) (Square w (* w w))))\n(defn main () (area (Circle 0)))")
  (Cons (ExN "E_UNREACHABLE_MATCH_ARM" "An arm can never run, because an earlier arm already matches everything it would."
          "(defn f (o) (match o (_ 0) (Some x x)))\n(defn main () (f (Some 0)))"
          "(defn f (o) (match o (Some x x) (_ 0)))\n(defn main () (f (Some 0)))")
  (Cons (ExN "E_FFI_TIMEOUT_REQUIRED" "Every `ffi-call` ends with a timeout: a positive whole number of milliseconds, written literally."
          "(defn main () (begin (print (ffi-call \"zyl_cstr_len\" \"abc\" 0)) 0))"
          "(defn main () (begin (print (ffi-call \"zyl_cstr_len\" \"abc\" 1000)) 0))")
  (Cons (ExN "E_TRAIT_NOT_FOUND" "A trait method is used on a type that has no `impl` of that trait."
          "(defn main () (with-resource (s \"text\") (begin (print s) 0)))"
          "(defn main () (let s \"text\" (begin (print s) 0)))")
  (Cons (ExN "E_NESTED_PATTERN" "A constructor arm binds plain names only; match the inner value in a second `match`."
          "(defn f (o) (match o (Some (Some x) x) (_ 0)))\n(defn main () (f (Some (Some 0))))"
          "(defn f (o) (match o (Some inner (match inner (Some x x) (None 0))) (None 0)))\n(defn main () (f (Some (Some 0))))")
  (Cons (ExN "E_TRAIT_NOT_DERIVABLE" "`derive` names a trait it cannot write an impl for."
          "(defstruct Point (x Int))\n(derive Point Frobnicate)\n(defn main () 0)"
          "(defstruct Point (x Int))\n(derive Point Eq)\n(defn main () 0)")
  (Cons (ExN "E_MACRO_NON_TERMINATION" "Macro expansion never finishes: the macros expand into each other forever."
          "(defmacro ping (x) (pong x))\n(defmacro pong (x) (ping x))\n(defn main () (ping 0))"
          "(defmacro ping (x) x)\n(defn main () (ping 0))")
  (Cons (ExN "E_DUPLICATE_DEFINITION" "Two top-level definitions share one name."
          "(defn f (x) x)\n(defn f (x) (+ x 1))\n(defn main () (f 0))"
          "(defn f (x) x)\n(defn g (x) (+ x 1))\n(defn main () (f (- (g 0) 1)))")
  (Cons (ExN "E_SECRET_ESCAPE" "A `Secret` value reaches output, a file or another observable place without `declassify`."
          "(capabilities io)\n(use core/core)\n(defn leak ((key Secret)) (file-write 2 key))\n(defn main () (begin (leak 5) 0))"
          "(capabilities io)\n(use core/core)\n(defn leak ((key Secret)) (file-write 2 \"<redacted>\"))\n(defn main () (begin (leak 5) 0))")
  (Cons (ExN "E_RESERVED_KEYWORD" "A keyword of the language is used as a name."
          "(defn f (test) test)\n(defn main () (f 0))"
          "(defn f (t) t)\n(defn main () (f 0))")
  (Cons (ExN "E_INDEX_OUT_OF_BOUNDS" "An index is outside the tuple, array or buffer it reads."
          "(use core/core)\n(defn main () (let t (tuple 1 2) (begin (print (tuple-get t 5)) 0)))"
          "(use core/core)\n(defn main () (let t (tuple 1 2) (begin (print (tuple-get t 1)) 0)))")
  (Cons (ExN "E_CT_VIOLATION" "A branch, index or division depends on a `Secret`, which leaks it through timing."
          "(capabilities secret)\n(use core/core)\n(defn check ((key Secret) (guess Int)) (if (= key guess) 1 0))\n(defn main () (- (check 7 7) 1))"
          "(capabilities secret)\n(use core/core)\n(use math/secret/secret)\n(defn check ((key Secret) (guess Int)) (ct-eq key guess))\n(defn main () (- (check 7 7) 1))")
  (Cons (ExN "E_FFI_PIN_REQUIRED" "A `Secret` passed to foreign code must go through `ffi-pin`."
          "(capabilities ffi)\n(use core/core)\n(extern \"abs\" (Int) Int)\n(defn raw ((key Secret)) (ffi-call \"abs\" key 1000))\n(defn main () (begin (raw 5) 0))"
          "(capabilities ffi)\n(use core/core)\n(defn raw ((key Secret)) (let p (ffi-pin key) (ffi-unpin p)))\n(defn main () (begin (raw 5) 0))")
  (Cons (ExN "E_CONTRACT_VIOLATION" "A `requires`, `ensures` or `invariant` check was false when it ran."
          "(defn half (n) (begin (requires (>= n 0)) (/ n 2)))\n(defn main () (half -4))"
          "(defn half (n) (begin (requires (>= n 0)) (/ n 2)))\n(defn main () (half 0))")
  (Cons (ExN "E_REGION_EXHAUSTED" "A `with-region` region ran out of the space its `:size` or `:limit` gives it."
          "(defn main () (with-region (fixed :size 64) (begin (print (str-length (str-concat \"a\" (str-concat \"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\" \"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\")))) 0)))"
          "(defn main () (with-region (fixed :size 4096) (begin (print (str-length (str-concat \"a\" (str-concat \"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\" \"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\")))) 0)))")
  (Cons (ExN "E_CHANNEL_CLOSED" "`chan-recv` on a channel whose sender has finished and whose values are all taken."
          "(capabilities actor)\n(use actor/actor)\n(defn main () (let c (chan 1) (let rx (chan-rx c) (let tx (chan-tx c) (let a (spawn (fn () (chan-send tx 7))) (begin (actor-wait a) (print (chan-recv rx)) (print (chan-recv rx)) 0))))))"
          "(capabilities actor)\n(use actor/actor)\n(defn main () (let c (chan 1) (let rx (chan-rx c) (let tx (chan-tx c) (let a (spawn (fn () (chan-send tx 7))) (begin (actor-wait a) (print (chan-recv rx)) 0))))))")
  (Cons (ExN "E_FFI_TIMEOUT" "A foreign call ran longer than its timeout; it is abandoned and this error raised."
          "(capabilities ffi)\n(extern \"usleep\" (Int) Int)\n(defn main () (begin (ffi-call \"usleep\" 300000 50) 0))"
          "(capabilities ffi)\n(extern \"usleep\" (Int) Int)\n(defn main () (begin (ffi-call \"usleep\" 1000 1000) 0))")
  (Cons (ExN "E_DUPLICATE_PARAMETER" "A function declares the same parameter name twice."
          "(defn f (a a) a)\n(defn main () (f 0 0))"
          "(defn f (a b) (+ a b))\n(defn main () (f 0 0))")
  (Cons (ExN "E_OVERFLOW" "An Int `+`, `-` or `*` whose result does not fit, or the smallest Int divided by -1."
          "(defn grow (n) (* n 4))\n(defn main () (begin (print (grow 9223372036854775807)) 0))"
          "(defn grow (n) (saturating* n 4))\n(defn main () (begin (print (grow 9223372036854775807)) 0))")
  (Cons (ExN "E_PARTIAL_OPERATION" "An Int `/` or `%` whose divisor is not a nonzero literal, so it could be zero."
          "(defn mean (t n) (/ t n))\n(defn main () (mean 10 2))"
          "(defn mean (t n) (match (div? t n) (Some q q) (None 0)))\n(defn main () (begin (print (mean 10 0)) 0))")
  (Cons (ExN "E_DIVISION_BY_ZERO" "`div!` or `rem!` met a zero divisor."
          "(defn per (t n) (div! t n))\n(defn main () (begin (print (per 10 0)) 0))"
          "(defn per (t n) (match (div? t n) (Some q q) (None 0)))\n(defn main () (begin (print (per 10 0)) 0))")
  (Cons (ExN "E_INTEGER_OVERFLOW" "An integer literal does not fit in a 64-bit Int."
          "(defn main () (begin (print 99999999999999999999) 0))"
          "(defn main () (begin (print 9223372036854775807) 0))")
  Nil))))))))))))))))))))))))))))))))))

(defn exn-find (code xs)
  (match xs
    (Nil None)
    (Cons h t (if (str-eq (exn-code h) code) (Some h) (exn-find code t)))))
