; === Zyl Standard Library — Region Inference / Escape Analysis ===
; Module: compiler/region_inference
; Works on Icnf instructions (compiler/icnf.zyl)
;
; This used to be a two-pass, fully general Region ADT (Stack/Heap/
; Global/Circular/Pin, spec §9.1 rules R1-R8) with its own scoped
; environment, struct/function signature tables, and capture analysis --
; ~600 lines computing region metadata that no caller ever read back
; (its result was thrown away before codegen in both this file's own
; history and, it turns out, the original Rust bootstrap's
; region_inference.rs too: its own error path was silently swallowed in
; collect_definitions, so E_REGION_ESCAPE never actually fired there
; either; see docs/rust-eviction-plan.md's Phase B writeup). Region
; inference had never affected a single compiled program's behavior in
; any implementation this compiler has ever had. Deleted rather than
; kept around unused, once ri-transform-fns below (the real thing)
; replaced it at both call sites (driver.zyl, tools/repl.zyl) with zero
; behavior change for anything already passing -- git history has the
; old machinery if anyone needs the general Region ADT shape again.
;
; ri-transform-fns is a genuine Icnf -> Icnf rewrite, narrower than that
; old design: for a `(let x (SomeVariant ...) body)`, if `x` provably
; never escapes `body` -- never passed to a call, never captured by a
; nested `fn`, never anything except the scrutinee of a `match` or an
; argument to `print` -- its IVariant construction is rewritten to
; IStackVariant, which cg-stack-variant (codegen.zyl) allocates directly
; in the current function's own frame instead of on the heap.
; Deliberately narrow and conservative (R1 from spec §9.1: Stack for
; values that provably don't escape): a name that's merely unused in
; some particular way isn't specifically hunted for, only the common,
; easy-to-prove-safe shape of "constructed, then only matched or
; printed" is promoted. Getting this wrong is a silent memory-corruption
; bug, not a crash-on-sight one, so every uncertain case falls back to
; the always-correct heap path unchanged -- undershooting here can only
; cost a missed optimization, never a wrong program.


(use compiler/node_tables)
(use compiler/error_report)

; True when EVERY occurrence of `name` inside `e` is either the
; scrutinee of an IMatch or a direct argument to IPrint -- the only two
; contexts proven not to retain the pointer past this expression's own
; evaluation. Any other occurrence (call argument, another variant's
; field, a set! target, referenced at all inside a nested `fn`) makes
; the whole thing unsafe: `name`'s value might be retained somewhere
; that outlives this function's own stack frame.
(defn ri-is-load-of (e name)
  (match e
    (ILoad n (str-eq n name))
    (_ false)))

(defn ri-name-safe-in (e name)
  (match e
    (IConst _ true)
    (IStr _ true)
    (ISymAddr _ true)
    (IFlt _ true)
    (ILoad n (if (str-eq n name) false true))
    (IBinop _ l r (if (ri-name-safe-in l name) (ri-name-safe-in r name) false))
    (ICall _ args (ri-name-safe-in-list args name))
    (ICallClosure _ args (ri-name-safe-in-list args name))
    (IFfi _ args (ri-name-safe-in-list args name))
    (IPrint a (if (ri-is-load-of a name) true (ri-name-safe-in a name)))
    (IIf c t eb
      (if (ri-name-safe-in c name)
        (if (ri-name-safe-in t name) (ri-name-safe-in eb name) false)
        false))
    (IWhile c b (if (ri-name-safe-in c name) (ri-name-safe-in b name) false))
    (ISet _ v (ri-name-safe-in v name))
    (ILet _ v b (if (ri-name-safe-in v name) (ri-name-safe-in b name) false))
    (ISeq es (ri-name-safe-in-list es name))
    (IVariant _ _ fields (ri-name-safe-in-list fields name))
    (IStackVariant _ _ fields (ri-name-safe-in-list fields name))
    (IMatch scr arms
      (if (ri-is-load-of scr name)
        (ri-name-safe-in-arms arms name)
        (if (ri-name-safe-in scr name) (ri-name-safe-in-arms arms name) false)))
    (IFn _ _ body (not (ri-name-referenced body name)))
    (ITryCatch tbody _ cbody
      (if (ri-name-safe-in tbody name) (ri-name-safe-in cbody name) false))
    (IRegion _ _ _ _ body (ri-name-safe-in body name))))

(defn ri-name-safe-in-list (xs name)
  (match xs
    (Nil true)
    (Cons h t (if (ri-name-safe-in h name) (ri-name-safe-in-list t name) false))))

(defn ri-name-safe-in-arms (arms name)
  (match arms
    (Nil true)
    (Cons a rest
      (match a
        (IArm _ _ _ body
          (if (ri-name-safe-in body name) (ri-name-safe-in-arms rest name) false))))))

; Unconditional "does `name` appear anywhere at all" — used only for the
; IFn case above: a nested closure that references `name` in ANY
; position captures it (by value, into its own heap-allocated env — see
; icnf.zyl's ic-lambda-closure), and that env outlives this frame, so
; any reference at all inside a closure is unsafe, not just the
; unrecognized-position ones ri-name-safe-in itself checks for.
(defn ri-name-referenced (e name)
  (match e
    (IConst _ false)
    (IStr _ false)
    (ISymAddr _ false)
    (IFlt _ false)
    (ILoad n (str-eq n name))
    (IBinop _ l r (if (ri-name-referenced l name) true (ri-name-referenced r name)))
    (ICall _ args (ri-name-referenced-list args name))
    (ICallClosure _ args (ri-name-referenced-list args name))
    (IFfi _ args (ri-name-referenced-list args name))
    (IPrint a (ri-name-referenced a name))
    (IIf c t eb
      (if (ri-name-referenced c name) true
        (if (ri-name-referenced t name) true (ri-name-referenced eb name))))
    (IWhile c b (if (ri-name-referenced c name) true (ri-name-referenced b name)))
    (ISet _ v (ri-name-referenced v name))
    (ILet _ v b (if (ri-name-referenced v name) true (ri-name-referenced b name)))
    (ISeq es (ri-name-referenced-list es name))
    (IVariant _ _ fields (ri-name-referenced-list fields name))
    (IStackVariant _ _ fields (ri-name-referenced-list fields name))
    (IMatch scr arms
      (if (ri-name-referenced scr name) true (ri-name-referenced-arms arms name)))
    (IFn _ _ body (ri-name-referenced body name))
    (ITryCatch tbody _ cbody
      (if (ri-name-referenced tbody name) true (ri-name-referenced cbody name)))
    (IRegion _ _ _ _ body (ri-name-referenced body name))))

(defn ri-name-referenced-list (xs name)
  (match xs
    (Nil false)
    (Cons h t (if (ri-name-referenced h name) true (ri-name-referenced-list t name)))))

(defn ri-name-referenced-arms (arms name)
  (match arms
    (Nil false)
    (Cons a rest
      (match a
        (IArm _ _ _ body
          (if (ri-name-referenced body name) true (ri-name-referenced-arms rest name)))))))

; The actual Icnf -> Icnf rewrite, structurally recursing everywhere
; (nothing here changes shape except ILet's own val/body, and even then
; only ever IVariant -> IStackVariant, never anything structural).
(defn ri-transform-fns (fns)
  (match fns
    (Nil Nil)
    (Cons f rest (Cons (ri-transform-fn f) (ri-transform-fns rest)))))

(defn ri-transform-fn (f)
  (match f
    (IFn name params body kinds (IFn name params (ri-transform-expr body) kinds))
    (_ (ri-transform-expr f))))

(defn ri-to-stack-variant (val)
  (match val
    (IVariant nm tag fields (IStackVariant nm tag fields))
    (_ val)))

(defn ri-transform-let (name val body)
  (let val2 (ri-transform-expr val)
    (let body2 (ri-transform-expr body)
      (match val2
        (IVariant _ _ _
          (if (ri-name-safe-in body2 name)
            (ILet name (ri-to-stack-variant val2) body2)
            (ILet name val2 body2)))
        (_ (ILet name val2 body2))))))

(defn ri-transform-list (xs)
  (match xs
    (Nil Nil)
    (Cons h t (Cons (ri-transform-expr h) (ri-transform-list t)))))

(defn ri-transform-arms (arms)
  (match arms
    (Nil Nil)
    (Cons a rest
      (match a
        (IArm v tag binds body (Cons (IArm v tag binds (ri-transform-expr body)) (ri-transform-arms rest)))))))

(defn ri-transform-expr (e)
  (ic-keep-span (ic-keep-kind (ri-transform-node e) e) e))

(defn ri-transform-node (e)
  (match e
    (IConst _ e)
    (IStr _ e)
    (ISymAddr _ e)
    (IFlt _ e)
    (ILoad _ e)
    (IBinop op l r (IBinop op (ri-transform-expr l) (ri-transform-expr r)))
    (ICall name args (ic-keep-span (ICall name (ri-transform-list args)) e))
    (ICallClosure name args (ic-keep-span (ICallClosure name (ri-transform-list args)) e))
    (IFfi name args (ic-keep-span (IFfi name (ri-transform-list args)) e))
    (IPrint a (IPrint (ri-transform-expr a)))
    (IIf c t eb (IIf (ri-transform-expr c) (ri-transform-expr t) (ri-transform-expr eb)))
    (IWhile c b (IWhile (ri-transform-expr c) (ri-transform-expr b)))
    (ISet name v (ISet name (ri-transform-expr v)))
    (ILet name val body (ri-transform-let name val body))
    (ISeq es (ISeq (ri-transform-list es)))
    (IVariant nm tag fields (IVariant nm tag (ri-transform-list fields)))
    (IStackVariant nm tag fields (IStackVariant nm tag (ri-transform-list fields)))
    (IMatch scr arms (IMatch (ri-transform-expr scr) (ri-transform-arms arms)))
    (IFn name params body kinds (IFn name params (ri-transform-expr body) kinds))
    (ITryCatch tbody cvar cbody (ITryCatch (ri-transform-expr tbody) cvar (ri-transform-expr cbody)))
    (IRegion k b a l body (IRegion k b a l (ri-transform-expr body)))))

; ===========================================================================
; Per-call regions (docs/regions-design.md)
;
; Every allocation site and every call site gets a level, stored in attr
; table 4 as level+1:
;   1  L  the value does not outlive this call: the frame's own region
;   2  R  the value may reach this call's result: the region the caller
;         chose for the result (zyl_cur_region at entry)
;   3  H  the heap
; A function node gets its flags in the same table: bit 0 when it has an
; L site (it needs a frame region), bit 1 when it has an R site (it keeps
; the result region), plus 4 so that the entry is never 0.
;
; Levels belong to abstract object classes (a union-find in the runtime,
; zyl_uf_*), field-insensitive: a variant, its fields and whatever is
; read out of it share one class. A function's summary is the level of
; each parameter's class: 0 the argument does not escape the call, 1 it
; may reach the result, 2 it escapes. Summaries live in smap 7 as
; packed+1 (2 bits per parameter, the first 31 parameters; any later
; parameter counts as escaping), and start at 0. Every function is
; re-analysed in program order until no summary changes; levels only
; ever rise, so this terminates, and the order makes it deterministic.
; ===========================================================================

(deftype RgB (RgB String Int))

(defn rg-summaries () (ffi-call "zyl_smap_global" 7 1000))

(defn rg-sites () (ffi-call "zyl_wvec_global" 1 1000))

(defn rg-new (lvl) (ffi-call "zyl_uf_new" lvl 1000))

(defn rg-union (a b) (ffi-call "zyl_uf_union" a b 1000))

(defn rg-raise (a lvl) (ffi-call "zyl_uf_raise" a lvl 1000))

(defn rg-level (a) (ffi-call "zyl_uf_level" a 1000))

(defn rg-lookup (env n)
  (match env
    (Nil -1)
    (Cons b rest
      (match b
        (RgB k c (if (str-eq k n) c (rg-lookup rest n)))))))

; Summary of a top-level function, or -1 when `n` is not one.
(defn rg-summary (n)
  (let v (ffi-call "zyl_smap_get" (rg-summaries) n 1000)
    (if (= v 0) -1 (- v 1))))

(defn rg-param-level (summary i)
  (if (> i 30) 2 (% (shr summary (* 2 i)) 4)))

; Record a site: its node and its class. Every site recorded allocates,
; or calls something that may allocate, in the region chosen for it; a
; call to a function that never allocates into its result region is not
; a site (its result region is never read, so choosing one is wasted).
(defn rg-site (_rec node c)
  (let _ (ffi-call "zyl_wvec_push" (rg-sites) node 1000)
    (let _ (ffi-call "zyl_wvec_push" (rg-sites) c 1000)
      (ffi-call "zyl_wvec_push" (rg-sites) (rg-scope-top) 1000))))

; with-region scopes. rg-scope-starts holds, per scope of the current
; function (numbered in walk order), the first class id created inside
; it; rg-scope-stack the scopes open at this point. Union-find keeps the
; lower id as a root, so a class created inside a scope whose root is
; below the scope's first id has been joined to something from outside:
; it escapes the scope.
(defn rg-scope-starts () (ffi-call "zyl_wvec_global" 3 1000))

(defn rg-scope-stack () (ffi-call "zyl_wvec_global" 4 1000))

; The IRegion node of each scope, for locating a diagnostic whose own site
; has no source position.
(defn rg-scope-nodes () (ffi-call "zyl_wvec_global" 6 1000))

(defn rg-scope-top ()
  (let n (ffi-call "zyl_wvec_len" (rg-scope-stack) 1000)
    (if (= n 0) -1 (ffi-call "zyl_wvec_get" (rg-scope-stack) (- n 1) 1000))))

(defn rg-region (e body env rec)
  (let bnd (rg-new 0)
    (let start (rg-new 0)
      (let idx (ffi-call "zyl_wvec_len" (rg-scope-starts) 1000)
        (let _ (ffi-call "zyl_wvec_push" (rg-scope-starts) start 1000)
          (let _ (ffi-call "zyl_wvec_push" (rg-scope-stack) idx 1000)
            (let cb (rg-expr body env 0 rec)
              (let _ (ffi-call "zyl_wvec_pop" (rg-scope-stack) 1000)
                (let _ (if (> rec 0) (icnf-region-set e (+ idx 1)) unit)
                (let _ (ffi-call "zyl_wvec_push" (rg-scope-nodes) e 1000)
                  (rg-union bnd cb)))))))))))

; Bit 62 of a summary: the function may allocate in its result region
; (directly, or through a call that may). Transitive through the
; fixpoint; a function value called through a local always may.
(defn rg-res-alloc (summary) (bit-and (shr summary 62) 1))

; Runtime functions and how they treat their arguments. Only the ones
; listed here are trusted; any other symbol keeps its arguments and
; result in the heap. 1: allocates a fresh result in zyl_cur_region and
; keeps no argument; 2: result is (part of) the first argument; 0: no
; allocation and no argument kept. Must agree with actor_runtime.c:
; every level-1 function allocates only through zyl_result_alloc.
(defn rg-ffi-kind (s)
  (if (str-eq s "zyl_cstr_concat") 1
  (if (str-eq s "zyl_cstr_substr") 1
  (if (str-eq s "zyl_cstr_from_byte") 1
  (if (str-eq s "zyl_int_text") 1
  (if (str-eq s "zyl_f_text") 1
  (if (str-eq s "zyl_file_read_c") 1
  (if (str-eq s "zyl_variant_field") 2
  (if (str-eq s "zyl_cstr_len") 0
  (if (str-eq s "zyl_cstr_eq") 0
  (if (str-eq s "zyl_cstr_cmp") 0
  (if (str-eq s "zyl_cstr_byte_at") 0
  (if (str-eq s "zyl_cstr_to_int") 0
  (if (str-eq s "zyl_cstr_key_matches") 0
  (if (str-eq s "zyl_variant_eq") 0
  (if (str-eq s "zyl_variant_cmp") 0
  (if (str-eq s "zyl_err_is") 0
  (if (str-eq s "zyl_mem_read") 0
  (if (str-eq s "zyl_span_off") 0
  (if (str-eq s "zyl_span_file") 0
  (if (str-eq s "zyl_attr_get") 0
  (if (str-eq s "zyl_smap_get") 0
  (if (str-eq s "zyl_smap_global") 0
  (if (str-eq s "zyl_wvec_global") 0
  (if (str-eq s "zyl_wvec_get") 0
  (if (str-eq s "zyl_wvec_len") 0
  (if (str-eq s "zyl_diag_json") 0
  (if (str-eq s "zyl_load_byte") 0
  (if (str-eq s "zyl_load_n") 0
  (rg-ffi-kind-bytes s))))))))))))))))))))))))))))))

; Byte buffers: 0 as above; 2 as above (a slice points into its buffer);
; 4 (stores: width, endian, offset, buffer, value): only the stored value
; escapes (a stored word may be a pointer); 5 (atomics: buffer, offset,
; values): everything but the buffer escapes.
(defn rg-ffi-kind-bytes (s)
  (if (str-eq s "zyl_bytebuf_len") 0
  (if (str-eq s "zyl_bytebuf_cap") 0
  (if (str-eq s "zyl_bytebuf_append") 0
  (if (str-eq s "zyl_align_check") 0
  (if (str-eq s "zyl_load_byte_signed") 0
  (if (str-eq s "zyl_load_n_signed") 0
  (if (str-eq s "zyl_bytebuf_atomic_load") 0
  (if (str-eq s "zyl_byte_slice") 2
  (if (str-eq s "zyl_byte_slice_sub") 2
  (if (str-eq s "zyl_bytebuf_ptr") 2
  (if (str-eq s "zyl_store_byte") 4
  (if (str-eq s "zyl_store_byte_signed") 4
  (if (str-eq s "zyl_store_n") 4
  (if (str-eq s "zyl_bytebuf_atomic_store") 5
  (if (str-eq s "zyl_bytebuf_atomic_add") 5
  (if (str-eq s "zyl_bytebuf_atomic_sub") 5
  (if (str-eq s "zyl_bytebuf_atomic_cas") 5
  (if (str-eq s "zyl_bytebuf_atomic_fetch_add") 5
  (if (str-eq s "zyl_bytebuf_atomic_max") 5
  (if (str-eq s "zyl_bytebuf_atomic_min") 5
  3)))))))))))))))))))))

; `(bytebuf Stack N)`: region code 0 as the first argument.
(defn rg-stack-bytebuf-p (name args)
  (if (str-eq name "zyl_bytebuf_new")
    (match args
      (Cons a _ (match a (IConst n (if (= n 0) true false)) (_ false)))
      (Nil false))
    false))

(defn rg-stack-sites () (ffi-call "zyl_wvec_global" 2 1000))

(defn rg-last (cs)
  (match cs
    (Nil Nil)
    (Cons h t (if (is-nil t) (Cons h Nil) (rg-last t)))))

(defn rg-rest (cs)
  (match cs
    (Nil Nil)
    (Cons _ t t)))

(defn rg-list (xs env rec)
  (match xs
    (Nil Nil)
    (Cons h t
      (let c (rg-expr h env 0 rec)
        (Cons c (rg-list t env rec))))))

(defn rg-raise-all (cs lvl)
  (match cs
    (Nil 0)
    (Cons c rest (let _ (rg-raise c lvl) (rg-raise-all rest lvl)))))

; Arguments against the callee's summary; in tail position each is at
; least R, since the frame is released before the callee runs.
(defn rg-apply-summary (cs summary i c tail)
  (match cs
    (Nil 0)
    (Cons a rest
      (let lvl (rg-param-level summary i)
        (let _ (if (= lvl 1) (rg-union a c) (if (= lvl 2) (rg-raise a 2) unit))
          (let _ (if (> tail 0) (rg-raise a 1) unit)
            (rg-apply-summary rest summary (+ i 1) c tail)))))))

(defn rg-call (e name args env tail rec)
  (let cs (rg-list args env rec)
    (let local (rg-lookup env name)
      (if (>= local 0)
        ; Through a function value: whatever it is may keep its arguments,
        ; and its result may point into the closure.
        (let _ (rg-raise-all cs 2)
          (let c (rg-union (rg-new 0) local)
            (let _ (rg-site rec e c) c)))
        (let s (rg-summary name)
          (if (< s 0)
            (let _ (rg-raise-all cs 2)
              (let c (rg-new 2)
                (let _ (rg-site rec e c) c)))
            (let c (rg-new 0)
              (let _ (rg-apply-summary cs s 0 c tail)
                (let _ (if (> (rg-res-alloc s) 0) (rg-site rec e c) 0) c)))))))))

(defn rg-first (cs)
  (match cs
    (Nil (rg-new 0))
    (Cons h _ h)))

(defn rg-ffi (e name args env rec)
  (let cs (rg-list args env rec)
    (if (rg-stack-bytebuf-p name args)
      ; An explicit Stack buffer lives in the frame region; rg-check-stack
      ; reports it if its class ends above L.
      (let c (rg-new 0)
        (let _ (rg-site rec e c)
          (let _ (if (> rec 0)
                   (let _ (ffi-call "zyl_wvec_push" (rg-stack-sites) e 1000)
                     (ffi-call "zyl_wvec_push" (rg-stack-sites) c 1000))
                   0)
            c)))
      (let k (rg-ffi-kind name)
        (if (= k 0)
          (rg-new 0)
          (if (= k 1)
            (let c (rg-new 0)
              (let _ (rg-site rec e c) c))
            (if (= k 2)
              (rg-first cs)
              (if (= k 4)
                (let _ (rg-raise-all (rg-last cs) 2) (rg-new 0))
                (if (= k 5)
                  (let _ (rg-raise-all (rg-rest cs) 2) (rg-new 0))
                  (let _ (rg-raise-all cs 2) (rg-new 2)))))))))))

(defn rg-fields (fs c env rec)
  (match fs
    (Nil c)
    (Cons f rest
      (let fc (rg-expr f env 0 rec)
        (let _ (rg-union c fc)
          (rg-fields rest c env rec))))))

(defn rg-seq (es env tail rec)
  (match es
    (Nil (rg-new 0))
    (Cons h t
      (if (is-nil t)
        (rg-expr h env tail rec)
        (let _ (rg-expr h env 0 rec)
          (rg-seq t env tail rec))))))

(defn rg-bind-all (names c env)
  (match names
    (Nil env)
    (Cons n rest (rg-bind-all rest c (Cons (RgB n c) env)))))

(defn rg-arms (arms sc res env tail rec)
  (match arms
    (Nil res)
    (Cons a rest
      (match a
        (IArm _ _ binds body
          (let bc (rg-expr body (rg-bind-all binds sc env) tail rec)
            (rg-arms rest sc (rg-union res bc) env tail rec)))))))

; A node the type pass proved scalar (attr 5: Int, Bool or Float) holds no
; pointer, so it joins no class; its children are still analysed.
(defn rg-expr (e env tail rec)
  (let c (rg-expr-node e env tail rec)
    (if (> (icnf-scalar e) 0) (rg-new 0) c)))

(defn rg-expr-node (e env tail rec)
  (match e
    (IConst _ (rg-new 0))
    (IStr _ (rg-new 0))
    (ISymAddr _ (rg-new 0))
    (IFlt _ (rg-new 0))
    (ILoad n (let c (rg-lookup env n) (if (< c 0) (rg-new 0) c)))
    (IBinop _ l r (let _ (rg-expr l env 0 rec) (let _ (rg-expr r env 0 rec) (rg-new 0))))
    (ICall name args (rg-call e name args env tail rec))
    (ICallClosure name args (rg-call e name args env tail rec))
    (IFfi name args (rg-ffi e name args env rec))
    (IPrint a (let _ (rg-expr a env 0 rec) (rg-new 0)))
    (IIf c t eb
      (let _ (rg-expr c env 0 rec)
        (let ct (rg-expr t env tail rec)
          (rg-union ct (rg-expr eb env tail rec)))))
    (IWhile c b (let _ (rg-expr c env 0 rec) (let _ (rg-expr b env 0 rec) (rg-new 0))))
    (ISet n v
      (let cv (rg-expr v env 0 rec)
        (let cn (rg-lookup env n)
          (let _ (if (>= cn 0) (rg-union cn cv) (rg-raise cv 2))
            (rg-new 0)))))
    (ILet n v body
      (let cv (rg-expr v env 0 rec)
        (rg-expr body (Cons (RgB n cv) env) tail rec)))
    (ISeq es (rg-seq es env tail rec))
    (IVariant _ _ fields
      (let c (rg-fields fields (rg-new 0) env rec)
        (let _ (rg-site rec e c) c)))
    (IStackVariant _ _ fields (rg-fields fields (rg-new 0) env rec))
    (IMatch scr arms
      (let sc (rg-expr scr env 0 rec)
        (rg-arms arms sc (rg-new 0) env tail rec)))
    (IFn _ _ _ _ (rg-new 2))
    (ITryCatch tbody cvar cbody
      (let tc (rg-expr tbody env 0 rec)
        (rg-union tc (rg-expr cbody (Cons (RgB cvar (rg-new 2)) env) 0 rec))))
    (IRegion _ _ _ _ body (rg-region e body env rec))))

(defn rg-param-env (params env acc)
  (match params
    (Nil (RgPE env acc))
    (Cons p rest
      (let c (rg-new 0)
        (rg-param-env rest (Cons (RgB p c) env) (Cons c acc))))))

(deftype RgPE (RgPE (List RgB) (List Int)))

; Pack parameter levels; `cs` is in reverse parameter order.
(defn rg-pack (cs i n acc)
  (match cs
    (Nil acc)
    (Cons c rest
      (let idx (- n (+ i 1))
        (let lvl (if (> idx 30) 0 (rg-level c))
          (rg-pack rest (+ i 1) n (bit-or acc (shl lvl (* 2 (if (> idx 30) 0 idx))))))))))

; Analyse one function; returns 1 when its summary rose.
(defn rg-fn (f rec)
  (match f
    (IFn name params body _
      (let _ (ffi-call "zyl_uf_reset" 1000)
        (let _ (ffi-call "zyl_wvec_truncate" (rg-sites) 0 1000)
        (let _ (ffi-call "zyl_wvec_truncate" (rg-scope-starts) 0 1000)
        (let _ (ffi-call "zyl_wvec_truncate" (rg-scope-nodes) 0 1000)
        (let _ (ffi-call "zyl_wvec_truncate" (rg-scope-stack) 0 1000)
        (match (rg-param-env params Nil Nil)
          (RgPE env cs
            (let ret (rg-new 1)
              (let bc (rg-expr body env 1 rec)
                (let _ (rg-union bc ret)
                  (let flags (rg-mark-sites 0 (ffi-call "zyl_wvec_len" (rg-sites) 1000) 0 rec)
                  (let old (rg-summary name)
                    ; Joined with the previous summary. The constraints are
                    ; not monotone in the summary (an R parameter unifies
                    ; its argument with the result, an H one only raises
                    ; it), so a recomputed level can fall, and the rounds
                    ; could cycle. Keeping the higher level is sound: an H
                    ; argument lives in the heap, which outlives anything
                    ; the result could need.
                    (let packed (rg-join old (bit-or (rg-pack cs 0 (list-length params) 0)
                                                     (shl (if (> (bit-and flags 2) 0) 1 0) 62)) 0)
                      (let _ (if (> rec 0) (icnf-region-set f (+ flags 4)) unit)
                        (if (= packed old)
                          false
                          (let _ (ffi-call "zyl_smap_put" (rg-summaries) name (+ packed 1) 1000)
                            true)))))))))))))))))
    (_ false)))

; Per-parameter maximum of two summaries, and the OR of bit 62.
(defn rg-join (a b i)
  (if (> i 30)
    (bit-or (bit-and a (shl 1 62)) (bit-and b (shl 1 62)))
    (let la (% (shr a (* 2 i)) 4)
      (let lb (% (shr b (* 2 i)) 4)
        (bit-or (shl (if (> la lb) la lb) (* 2 i)) (rg-join a b (+ i 1)))))))

(defn rg-round (fns rec changed)
  (match fns
    (Nil changed)
    (Cons f rest
      (let c (rg-fn f rec)
        (rg-round rest rec (if (> c 0) 1 changed))))))

(defn rg-fixpoint (fns)
  (if (> (rg-round fns 0 0) 0) (rg-fixpoint fns) 0))

(defn rg-init (fns)
  (match fns
    (Nil 0)
    (Cons f rest
      (let _ (match f
               (IFn name _ _ _ (ffi-call "zyl_smap_put" (rg-summaries) name 1 1000))
               (_ unit))
        (rg-init rest)))))

; Final pass: annotate every site and function (rg-fn with rec = 1).
(defn rg-annotate (fns)
  (match fns
    (Nil 0)
    (Cons f rest
      (let _ (ffi-call "zyl_wvec_truncate" (rg-stack-sites) 0 1000)
        (let _ (rg-fn f 1)
          (let _ (rg-check-stack 0 (ffi-call "zyl_wvec_len" (rg-stack-sites) 1000))
            (rg-annotate rest)))))))

; E_REGION_ESCAPE: a Stack buffer (or a slice of it) that is returned,
; stored in something longer-lived, or handed to code that may keep it.
(defn rg-check-stack (i n)
  (if (>= i n)
    0
    (let node (ffi-call "zyl_wvec_get" (rg-stack-sites) i 1000)
      (let lvl (rg-level (ffi-call "zyl_wvec_get" (rg-stack-sites) (+ i 1) 1000))
        (if (> lvl 0)
          (let off (ffi-call "zyl_span_off" node 1000)
            (let fid (ffi-call "zyl_span_file" node 1000)
              (ffi-call "zyl_panic"
                (err-at "E_REGION_ESCAPE"
                        (if (= lvl 1) "a Stack bytebuf is returned from the function that allocates it"
                            "a Stack bytebuf escapes its frame (stored, sent or passed to code that may keep it)")
                        fid off
                        "allocate it in the Heap region, or keep it and every slice of it inside this function")
                1000)))
          (rg-check-stack (+ i 2) n))))))

; Levels of the recorded sites, as function flags (bit 0: an L site,
; bit 1: an R site); with rec = 1 each site's level is also stored.
(defn rg-mark-sites (i n flags rec)
  (if (>= i n)
    flags
    (let node (ffi-call "zyl_wvec_get" (rg-sites) i 1000)
      (let c (ffi-call "zyl_wvec_get" (rg-sites) (+ i 1) 1000)
        (let scope (ffi-call "zyl_wvec_get" (rg-sites) (+ i 2) 1000)
          (let lvl (rg-level c)
            (if (and (>= scope 0) (rg-in-scope c lvl scope))
              ; Placed in the with-region scope: no frame or result region.
              (let _ (if (> rec 0) (icnf-region-set node (+ 4 scope)) unit)
                (rg-mark-sites (+ i 3) n flags rec))
              (let _ (if (and (> rec 0) (>= scope 0)) (rg-scope-escape (rg-located node scope) lvl) 0)
                (let _ (if (> rec 0) (icnf-region-set node (+ lvl 1)) unit)
                  (rg-mark-sites (+ i 3) n
                    (bit-or flags (if (= lvl 0) 1 (if (= lvl 1) 2 0))) rec))))))))))

(defn rg-in-scope (c lvl scope)
  (if (> lvl 0)
    false
    (>= (ffi-call "zyl_uf_find" c 1000)
        (ffi-call "zyl_wvec_get" (rg-scope-starts) scope 1000))))

(defn rg-located (node scope)
  (if (>= (ffi-call "zyl_span_off" node 1000) 0)
    node
    (ffi-call "zyl_wvec_get" (rg-scope-nodes) scope 1000)))

(defn rg-scope-escape (node lvl)
  (let off (ffi-call "zyl_span_off" node 1000)
    (let fid (ffi-call "zyl_span_file" node 1000)
      (ffi-call "zyl_panic"
        (err-at "E_REGION_ESCAPE"
                (if (= lvl 2) "a value allocated inside with-region escapes to the heap (stored, sent or passed to code that may keep it)"
                    "a value allocated inside with-region outlives it")
                fid off
                "compute a result that does not point into the region (a number, or data built outside it)")
        1000))))

; Entry point: annotate `fns` (the list codegen receives) in place and
; return it unchanged. ZYL_REGIONS=0 turns regions off: nothing is
; annotated, so every site is H, exactly the old behaviour.
(defn rg-regions (fns)
  (if (ffi-call "zyl_regions_enabled" 1000)
    (let _ (ffi-call "zyl_smap_clear" (rg-summaries) 1000)
    (let _ (rg-init fns)
      (let _ (rg-fixpoint fns)
        (let _ (rg-annotate fns)
          fns))))
    fns))
