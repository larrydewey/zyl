; === Zyl Standard Library — Region Inference Engine ===
; Module: compiler/region_inference
; Provides: Region inference (spec §9.1 rules R1-R8) + capture analysis
; Works on Icnf instructions (compiler/icnf.zyl)
;
; Two-pass algorithm:
;   Pass 1 (ri-collect-defs): gather function signatures + struct regions
;   Pass 2 (ri-infer-expr): analyze each expression, assign regions

; ===========================================================================
; REGION ADT — spec §9.1 (R1-R8)
; ===========================================================================

(deftype Region RStack RHeap RGlobal RCircular RPin)

(deftype RegionCaptureInfo (RCI (List String) (List (Pair String Region))))

; ===========================================================================
; REGION ENVIRONMENT — scoped bindings: name → (region, escaped?)
; ===========================================================================

(deftype RE (RE (List RegionBind) (List (List RegionBind))))
(deftype RegionBind (RB String Region Bool))

; RegionEnv wraps RE for clarity; constructors access RE fields directly.
(defn RegionEnv (cur parents)
  (RE cur parents))

(defn RE.cur (self)
  (match self
    ((RE c d1) c)))

(defn RE.parens (self)
  (match self
    ((RE d2 p) p)))

; ===========================================================================
; REGION INFERENCE RESULTS
; ===========================================================================

(deftype RegionResult (RR Region (Option RegionCaptureInfo)))

(defn RR.reg (r) (match r (RR reg d1 reg)))
(defn RR.capture (r) (match r (RR d1 c c)))

(deftype RegionInferer (RI RegionEnv (List StructRegion) (List FuncSig)))

(defn RI.env (ri) (match ri (RI e d1 d2 e)))
(defn RI.sr (ri) (match ri (RI d1 s d2 s)))
(defn RI.fs (ri) (match ri (RI d1 d2 f f)))

; ===========================================================================
; STRUCT / FUNCTION SIGNATURE HELPERS
; ===========================================================================

(deftype StructRegion (SR String (List VariantRegion)))
(defn SR.name (sr) (match sr (SR n d1 n)))
(defn SR.variants (sr) (match sr (SR d1 v v)))

(deftype VariantRegion (VR String (List FieldRegion)))
(deftype FieldRegion (FldR String Region))
(deftype FuncSig (FS String (List Region) Region))
(defn FS.name (fs) (match fs (FS n d1 d2 n)))
(defn FS.params (fs) (match fs (FS d1 p d2 p)))
(defn FS.ret (fs) (match fs (FS d1 d2 r r)))

; ===========================================================================
; REGION ENVIRONMENT HELPERS
; ===========================================================================

(defn env-new ()
  (RE Nil Nil))
(defn re-env-get (env name)
  (env-get-cur (RE.cur env) (RE.parens env) name))
(defn env-get-cur (binds parents name)
  (match binds
    (Nil (env-get-parents parents name))
    ((RB n r esc) rest
      (if (= (str-eq n name) 0)
        (Some (Pair r esc))
        (env-get-cur rest parents name)))))
(defn env-get-parents (parents name)
  (match parents
    (Nil None)
    ((Cons scope rest)
      (match (re-env-get-binds scope name)
        (Some pr (Some pr))
        (None (env-get-parents rest name))))))
(defn re-env-get-binds (binds name)
  (match binds
    (Nil None)
    ((RB n r esc) rest
      (if (= (str-eq n name) 0)
        (Some (Pair r esc))
        (re-env-get-binds rest name)))))
(defn env-is-escaped (env name)
  (match (re-env-get env name)
    (Some pr (match pr (Pair r esc (if esc 1 0))))
    (None 0)))
(defn re-env-bind (env name region)
  (RegionEnv (Cons (RB name region 0) (RE.cur env)) (RE.parens env)))
(defn env-contains (env name)
  (if (= (env-contains-cur (RE.cur env) name) 1)
    1
    (env-contains-parents (RE.parens env))))
(defn env-contains-cur (binds name)
  (match binds
    (Nil 0)
    ((RB n d3 d4) rest
      (if (= (str-eq n name) 0) 1 (env-contains-cur rest name)))))
(defn env-contains-parents (parents)
  (env-contains-parents-inner parents))
(defn env-contains-parents-inner (parents)
  (match parents
    (Nil 0)
    ((Cons scope rest)
      (if (= (env-contains-cur scope) 1) 1
        (env-contains-parents-inner rest)))
    (Nil 0)))
(defn env-escape (env name)
  (if (= (env-contains-cur (RE.cur env) name) 1)
    (env-escape-cur (RE.cur env) name (RE.parens env))
    (env-escape-parents (RE.parens env) name)))
(defn env-escape-cur (binds name parens)
  (env-escape-cur-inner binds name parens Nil 0))
(defn env-escape-cur-inner (binds name parens accum found)
  (match binds
    (Nil (if (= found 1)
            (RegionEnv Nil (list-reverse accum))
            (env-escape-parents parens name)))
    ((RB n r esc) rest
      (if (= (str-eq n name) 0)
        (RegionEnv (list-reverse (Cons (RB n r 1) accum)) parens)
        (env-escape-cur-inner rest name parens
          (Cons (RB n r esc) accum) found)))))
(defn env-escape-parents (parents name)
  (env-escape-parents-inner parents name Nil))
(defn env-escape-parents-inner (parents name depth)
  (match parents
    (Nil (RegionEnv Nil Nil))
    ((Cons scope rest)
      (let (esc new-scope) (env-escape-scope scope name)
        (if (= esc 1)
          (RegionEnv (Cons scope new-scope) (RE.parens (RegionEnv Nil new-scope)))
          (if (= (list-length rest) 0)
            (RegionEnv (Cons scope Nil) (RE.parens (RegionEnv Nil Nil)))
            (env-escape-parents-inner rest name (Cons depth Nil))))))))
(defn env-escape-scope (scope name)
  (env-escape-scope-inner scope name Nil 0))
(defn env-escape-scope-inner (scope name accum found)
  (match scope
    (Nil (Pair found Nil))
    (Cons hd rest
      (match hd
        (RB n r esc
          (if (= (str-eq n name) 0)
            (let new-r (if (= r RStack) RHeap r)
              (Pair 1 (list-reverse (Cons (RB n new-r 1) accum))))
            (env-escape-scope-inner rest name
              (Cons (RB n r esc) accum) found)))))))
(defn env-enter (env)
  (RegionEnv Nil (Cons (RE.cur env) (RE.parens env))))
(defn env-exit (env)
  (match (Pair (RE.cur env) (RE.parens env))
    (Pair current parens
      (if (= (list-length current) 0)
        (RegionEnv Nil parens)
        (if (= (list-length parens) 0)
          (RegionEnv current parens)
          (env-merge-into-last current parens))))))
(defn env-merge-into-last (current parens)
  (match parens
    (Nil (RegionEnv current parens))
    ((Cons last rest)
      (RegionEnv Nil (Cons (env-merge-binds current last) rest)))))
(defn env-merge-binds (incoming outer)
  (env-merge-binds-loop incoming outer Nil))
(defn env-merge-binds-loop (incoming outer acc)
  (match incoming
    (Nil (env-add-remaining outer acc))
    ((Cons bind rest)
      (match bind
        ((RB n r esc)
          (if (= esc 1)
            (env-merge-binds-loop rest outer acc)
            (if (= (env-list-has outer n) 1)
              (env-merge-binds-loop rest outer acc)
              (env-merge-binds-loop rest outer (Cons bind acc)))))))))
(defn env-list-has (binds name)
  (match binds
    (Nil 0)
    (Cons hd rest
      (match hd
        (RB n d5 d6
          (if (= (str-eq n name) 0) 1 (env-list-has rest name)))))))
(defn env-add-remaining (binds acc)
  (match binds
    (Nil acc)
    ((Cons bind rest) (env-add-remaining rest (Cons bind acc)))))
(defn env-snapshot (env)
  (RegionEnv (RE.cur env) (RE.parens env)))
(defn env-bindings (env)
  (env-bindings-cur (RE.cur env) (env-bindings-parents (RE.parens env))))
(defn env-bindings-cur (binds names)
  (match binds
    (Nil names)
    (Cons hd rest
      (match hd
        (RB n d7 d8
          (if (= (env-names-has names n) 1)
            (env-bindings-cur rest names)
            (env-bindings-cur rest (Cons n names))))))))
(defn env-names-has (names name)
  (match names
    (Nil 0)
    ((Cons h rest) (if (= (str-eq h name) 0) 1 (env-names-has rest name)))))
(defn env-bindings-parents (parents)
  (match parents
    (Nil Nil)
    ((Cons scope rest)
      (env-bindings-cur scope (env-bindings-parents rest)))))

(defn ri-new ()
  (RI (env-new) Nil Nil))

(defn ri-union-regions (a b)
  (match (Pair a b)
    ((Pair RGlobal d9) RGlobal)
    ((Pair d10 RGlobal) RGlobal)
    ((Pair RHeap RCircular) RHeap)
    ((Pair RCircular RHeap) RHeap)
    ((Pair RHeap d11) RHeap)
    ((Pair d12 RHeap) RHeap)
    ((Pair RPin RStack) RPin)
    ((Pair RStack RPin) RPin)
    ((Pair d13 d14) (if (>= (region-rank a) (region-rank b)) a b))))

(defn region-rank (r)
  (match r
    (RStack 0)
    (RPin 1)
    (RHeap 2)
    (RCircular 3)
    (RGlobal 4)))

(defn ri-is-literal-const ((ic Icnf))
  (match ic
    (IConst d15 1)
    (IStr d16 1)
    (IFlt d17 1)
    (ILoad d18 0)
    (IBinop d5 a b (if (= (ri-is-literal-const a) 1)
                      (ri-is-literal-const b)
                      0))
    (ICall d6 args (ri-is-literal-icnf-list args))
    (ICallClosure d99 args (ri-is-literal-icnf-list args))
    (IFfi d7 args (ri-is-literal-icnf-list args))
    (IPrint d (ri-is-literal-const d))
    (IIf c t e (if (= (ri-is-literal-const c) 1)
                  (if (= (ri-is-literal-const t) 1)
                    (ri-is-literal-const e)
                    0)
                  0))
    (IWhile d19 d20 0)
    (ISet d21 d22 0)
    (ILet d14 val body
      (if (= (ri-is-literal-const val) 1)
        (ri-is-literal-const body)
        0))
    (ISeq d15 (ri-is-literal-icnf-list d15))
    (IVariant d16 d23 d18 (ri-is-literal-icnf-list d18))
    (IStackVariant d113 d114 d115 (ri-is-literal-icnf-list d115))
    (IMatch scr arms
      (if (= (ri-is-literal-const scr) 1)
        (ri-is-literal-arms arms)
        0))
    (IFn d20 d21 d22 (ri-is-literal-const d22))
    (ITryCatch d102 d103 d104 0)))

(defn ri-is-literal-icnf-list (icnfs)
  (match icnfs
    (Nil 1)
    ((Cons h rest) (if (= (ri-is-literal-const h) 1)
                     (ri-is-literal-icnf-list rest)
                     0))))

(defn ri-is-literal-arms (arms)
  ; the stray trailing `0` after the inner match used to sit as a SECOND
  ; bare trailing form on the `(Cons arm rest)` arm — that shape (nested
  ; pattern + 2 trailing forms, the first a list not a tail-binding atom)
  ; is misparsed as Cons-nested-pattern sugar, silently discarding the
  ; real inner match and always returning 0. IArm is a single-variant
  ; type, so the inner match is already exhaustive without it.
  (match arms
    (Nil 1)
    ((Cons arm rest)
      (match arm
        ((IArm d24 d25 d26 body)
          (if (= (ri-is-literal-const body) 1)
            (ri-is-literal-arms rest)
            0))))))

(defn ri-analyze-captures (outer-env ic)
  (ri-capture-collect ic outer-env Nil))

(defn ri-capture-collect ((ic Icnf) captured-refs env)
  (match ic
    (ILoad name
      (if (= (env-contains env name) 1)
        (ri-capture-add name (re-env-get env name) captured-refs)
        captured-refs))
    (IBinop d1 a b (ri-capture-collect a
      (ri-capture-collect b captured-refs env)
      env))
    (ICall d2 args (ri-capture-collect-list args captured-refs env))
    (ICallClosure d100 args (ri-capture-collect-list args captured-refs env))
    (IFfi d3 args (ri-capture-collect-list args captured-refs env))
    (IPrint d (ri-capture-collect d captured-refs env))
    (IIf c t e
      (ri-capture-collect e
        (ri-capture-collect t
          (ri-capture-collect c captured-refs env)
          env)
        env))
    (IWhile c b
      (ri-capture-collect b
        (ri-capture-collect c captured-refs env)
        env))
    (ISet d10 val
      (if (= (env-contains env d10) 1)
        (ri-capture-add d10 (re-env-get env d10)
          (ri-capture-collect val captured-refs env))
        (ri-capture-collect val captured-refs env)))
    (ILet d11 val body
      (let new-env (re-env-bind env d11 RStack)
        (ri-capture-collect body captured-refs new-env)))
    (ISeq items (ri-capture-collect-list items captured-refs env))
    (IConst d17 captured-refs)
    (IStr d18 captured-refs)
    (IFlt d19 captured-refs)
    (IVariant d12 d13 args (ri-capture-collect-list args captured-refs env))
    (IStackVariant d116 d117 args (ri-capture-collect-list args captured-refs env))
    (IMatch scr arms
      (ri-capture-collect-arms arms
        (ri-capture-collect scr captured-refs env)
        env))
    (IFn d15 d16 body
      (ri-capture-collect body captured-refs env))
    (ITryCatch tbody d105 cbody
      (ri-capture-collect cbody
        (ri-capture-collect tbody captured-refs env)
        env))))

(defn ri-capture-collect-list (icnfs acc env)
  (match icnfs
    (Nil acc)
    ((Cons h rest)
      (ri-capture-collect-list rest
        (ri-capture-collect h acc env)
        env))))

(defn ri-capture-add (name get-result acc)
  (match get-result
    (Some pr
      (match pr
        (Pair r esc
          (if (= (ri-capture-list-has acc name) 1)
            acc
            (Cons (Pair name r) acc)))))
    (None acc)))

(defn ri-capture-list-has (refs name)
  (match refs
    (Nil 0)
    (Cons hd rest
      (match hd
        (Pair n d27
          (if (= (str-eq n name) 0) 1 (ri-capture-list-has rest name)))))))

(defn ri-capture-collect-arms (arms acc env)
  (match arms
    (Nil acc)
    ((Cons arm rest)
      (match arm
        ((IArm d28 d29 binds body)
          (let arm-env (ri-bind-params binds env RStack)
            (ri-capture-collect-arms rest
              (ri-capture-collect body acc arm-env)
              env)))))))

(defn ri-bind-params (params env region)
  (match params
    (Nil env)
    ((Cons name rest)
      (ri-bind-params rest (re-env-bind env name region) region))))

(defn ri-infer-expr (ri (ic Icnf))
  (match ic
    (IConst d30 (RR RStack None))
    (IStr d31 (RR RHeap None))
    (IFlt d32 (RR RHeap None))
    (ILoad name
      (match (re-env-get (RI.env ri) name)
        (Some pr (match pr (Pair r esc (RR r None))))
        (None (RR RStack None))))
    (IBinop d4 left right
      (let lr (ri-infer-expr ri left)
        (let rr (ri-infer-expr ri right)
          (RR (ri-union-regions (RR.reg lr) (RR.reg rr)) None))))
    (ICall d5 args
      (begin
        (ri-infer-args ri args)
        (RR RHeap None)))
    (ICallClosure d101 args
      (begin
        (ri-infer-args ri args)
        (RR RHeap None)))
    (IFfi d6 args
      (begin
        (ri-infer-args ri args)
        (RR RPin None)))
    (IPrint d7
      (begin
        (ri-infer-expr ri d7)
        (RR RStack None)))
    (IIf cond then_ else_
      (begin
        (ri-infer-expr ri cond)
        (let tr (ri-infer-expr ri then_)
          (let er (ri-infer-expr ri else_)
            (RR (ri-union-regions (RR.reg tr) (RR.reg er)) None)))))
    (IWhile cond body
      (begin
        (ri-infer-expr ri cond)
        (ri-infer-expr ri body)))
    (ISet name val
      (let vr (ri-infer-expr ri val)
        (if (= (env-contains (RI.env ri) name) 0)
          (RR RStack None)
          (RR (RR.reg vr) None))))
    (ILet name val body
      (let env0 (RI.env ri)
        (let d33 (ri-infer-expr ri val)
          (let env1 (env-enter env0)
            (let env2 (re-env-bind env1 name RStack)
              (let ri2 (RI env2 (RI.sr ri) (RI.fs ri))
                (let result (ri-infer-expr ri2 body)
                  (let env3 (RI.env ri2)
                    (let env4 (env-exit env3)
                      (RI env4 (RI.sr ri) (RI.fs ri))
                      result)))))))))
    (ISeq items
      (ri-infer-seq ri items))
    (IVariant d13 d14 d15
      (begin
        (ri-infer-args ri d15)
        (RR RHeap None)))
    (IStackVariant d118 d119 d120
      (begin
        (ri-infer-args ri d120)
        (RR RStack None)))
    (IMatch scrutinee arms
      (begin
        (ri-infer-expr ri scrutinee)
        (ri-infer-match-arms ri arms (RR RStack None))))
    (IFn name params body
      (let env0 (RI.env ri)
        (let env1 (env-enter env0)
          (let env2 (ri-bind-params params env1 RStack)
            (let ri2 (RI env2 (RI.sr ri) (RI.fs ri))
              (let d34 (ri-infer-expr ri2 body)
                (let env3 (RI.env ri2)
                  (let env4 (env-exit env3)
                    (RI env4 (RI.sr ri) (RI.fs ri))
                    (RR RHeap None)))))))))
    (ITryCatch tbody d106 cbody
      (begin
        (ri-infer-expr ri tbody)
        (ri-infer-expr ri cbody)))))

(defn ri-infer-args (ri icnfs)
  (ri-infer-args-loop ri icnfs RStack))

(defn ri-infer-args-loop (ri args region)
  (match args
    (Nil region)
    ((Cons ic rest)
      (ri-infer-args-loop ri
        rest
        (ri-union-regions region (RR.reg (ri-infer-expr ri ic)))))))

(defn ri-infer-seq (ri items)
  (ri-infer-seq-loop ri items (RR RStack None)))

(defn ri-infer-seq-loop (ri items result)
  (match items
    (Nil result)
    ((Cons ic rest)
      (ri-infer-seq-loop ri
        rest
        (ri-infer-expr ri ic)))))

(defn ri-infer-match-arms (ri arms acc)
  (match arms
    (Nil acc)
    ((Cons arm rest)
      (match arm
        ((IArm d35 d36 binds body)
          (let env0 (RI.env ri)
            (let env1 (env-enter env0)
              (let env2 (ri-bind-params binds env1 RStack)
                (let ri2 (RI env2 (RI.sr ri) (RI.fs ri))
                  (let arm-result (ri-infer-expr ri2 body)
                    (let env3 (RI.env ri2)
                      (let env4 (env-exit env3)
                        (let new-acc (RR
                          (ri-union-regions
                            (RR.reg acc)
                            (RR.reg arm-result))
                          None)
                        (ri-infer-match-arms
                          (RI env4 (RI.sr ri) (RI.fs ri))
                          rest
                          new-acc))))))))))))))

(defn ri-collect-defs (ri items)
  (ri-collect-defs-loop ri items))

(defn ri-collect-defs-loop (ri items)
  (match items
    (Nil ri)
    ((Cons ic rest)
      (let ri2 (ri-collect-one ic ri)
        (ri-collect-defs-loop ri2 rest)))))

(defn ri-collect-one ((ic Icnf) ri)
  (match ic
    (IFn name params body
      (let param-regions (ri-make-param-regions (list-length params))
        (let fsig (FS name param-regions RHeap)
          (ri-add-func-sig ri name fsig))))
    (IVariant name d3 args
      (let field-regions (SR name
        (Cons (VR "default"
          (ri-make-field-regions args Nil)) Nil)))
      (ri-add-struct-region ri field-regions))
    (ISeq d4
      (ri-collect-defs-loop ri d4))
    (d5 ri)))

(defn ri-make-param-regions (count)
  (ri-make-param-regions-loop count Nil))

(defn ri-make-param-regions-loop (count acc)
  (if (= count 0)
    (list-reverse acc)
    (ri-make-param-regions-loop (- count 1)
      (Cons RStack acc))))

(defn ri-make-field-regions (args acc)
  (match args
    (Nil acc)
    ((Cons d37 rest)
      (ri-make-field-regions rest
        (Cons (FldR "" RStack) acc)))))

(defn ri-add-func-sig (ri name fsig)
  (let fs (RI.fs ri)
    (if (ri-func-sig-exists fs name)
      ri
      (RI (RI.env ri) (RI.sr ri)
        (Cons (FS name (FS.params fsig) (FS.ret fsig)) fs)))))

(defn ri-func-sig-exists (sigs name)
  (match sigs
    (Nil 0)
    (Cons hd rest
      (match hd
        (FS n d38 d39
          (if (= (str-eq n name) 0) 1 (ri-func-sig-exists rest name)))))))

(defn ri-add-struct-region (ri sr)
  (let srlist (RI.sr ri)
    (if (ri-sr-exists srlist (SR.name sr))
      ri
      (RI (RI.env ri) (Cons sr srlist) (RI.fs ri)))))

(defn ri-sr-exists (srs name)
  (match srs
    (Nil 0)
    (Cons hd rest
      (match hd
        (SR n d40
          (if (= (str-eq n name) 0) 1 (ri-sr-exists rest name)))))))

(defn ri-infer (icnf-list ri)
  (let ri2 (ri-collect-defs ri icnf-list)
    (if (= (list-length icnf-list) 0)
      ri2
      (ri-infer-expressions ri2 icnf-list))))

(defn ri-infer-expressions (ri items)
  (match items
    (Nil ri)
    ((Cons ic rest)
      (let d1 (ri-infer-expr ri ic)
        (ri-infer-expressions ri rest)))))

; ===========================================================================
; REAL ESCAPE ANALYSIS + STACK PROMOTION
; ===========================================================================
;
; Everything above this point computes region metadata that nothing ever
; reads back (ri-infer's result is discarded by every caller) -- true of
; both this file's own history and, it turns out, the original Rust
; bootstrap's region_inference.rs too (its own error path is silently
; swallowed in collect_definitions, so E_REGION_ESCAPE never actually
; fired there either; see docs/rust-eviction-plan.md). Region inference
; has never affected a single compiled program's behavior in any
; implementation this compiler has had.
;
; ri-transform-fns is the real thing: a genuine Icnf -> Icnf rewrite.
; For a `(let x (SomeVariant ...) body)`, if `x` provably never escapes
; `body` -- never passed to a call, never captured by a nested `fn`,
; never anything except the scrutinee of a `match` or an argument to
; `print` -- its IVariant construction is rewritten to IStackVariant,
; which cg-stack-variant (codegen.zyl) allocates directly in the current
; function's own frame instead of on the heap. Deliberately narrow and
; conservative (R1 from spec §9.1: Stack for values that provably don't
; escape): a name that's merely unused in some particular way isn't
; specifically hunted for, only the common, easy-to-prove-safe shape of
; "constructed, then only matched or printed" is promoted. Getting this
; wrong is a silent memory-corruption bug, not a crash-on-sight one, so
; every uncertain case falls back to the always-correct heap path
; unchanged -- undershooting here can only cost a missed optimization,
; never a wrong program.

; True when EVERY occurrence of `name` inside `e` is either the
; scrutinee of an IMatch or a direct argument to IPrint -- the only two
; contexts proven not to retain the pointer past this expression's own
; evaluation. Any other occurrence (call argument, another variant's
; field, a set! target, referenced at all inside a nested `fn`) makes
; the whole thing unsafe: `name`'s value might be retained somewhere
; that outlives this function's own stack frame.
(defn ri-is-load-of (e name)
  (match e
    (ILoad n (str-eq n name))
    (d1 0)))

(defn ri-name-safe-in (e name)
  (match e
    (IConst d1 1)
    (IStr d2 1)
    (IFlt d3 1)
    (ILoad n (if (> (str-eq n name) 0) 0 1))
    (IBinop d4 l r (if (> (ri-name-safe-in l name) 0) (ri-name-safe-in r name) 0))
    (ICall d5 args (ri-name-safe-in-list args name))
    (ICallClosure d6 args (ri-name-safe-in-list args name))
    (IFfi d7 args (ri-name-safe-in-list args name))
    (IPrint a (if (> (ri-is-load-of a name) 0) 1 (ri-name-safe-in a name)))
    (IIf c t eb
      (if (> (ri-name-safe-in c name) 0)
        (if (> (ri-name-safe-in t name) 0) (ri-name-safe-in eb name) 0)
        0))
    (IWhile c b (if (> (ri-name-safe-in c name) 0) (ri-name-safe-in b name) 0))
    (ISet d8 v (ri-name-safe-in v name))
    (ILet d9 v b (if (> (ri-name-safe-in v name) 0) (ri-name-safe-in b name) 0))
    (ISeq es (ri-name-safe-in-list es name))
    (IVariant d10 d11 fields (ri-name-safe-in-list fields name))
    (IStackVariant d12 d13 fields (ri-name-safe-in-list fields name))
    (IMatch scr arms
      (if (> (ri-is-load-of scr name) 0)
        (ri-name-safe-in-arms arms name)
        (if (> (ri-name-safe-in scr name) 0) (ri-name-safe-in-arms arms name) 0)))
    (IFn d14 d15 body (= (ri-name-referenced body name) 0))
    (ITryCatch tbody d16 cbody
      (if (> (ri-name-safe-in tbody name) 0) (ri-name-safe-in cbody name) 0))))

(defn ri-name-safe-in-list (xs name)
  (match xs
    (Nil 1)
    (Cons h t (if (> (ri-name-safe-in h name) 0) (ri-name-safe-in-list t name) 0))))

(defn ri-name-safe-in-arms (arms name)
  (match arms
    (Nil 1)
    (Cons a rest
      (match a
        (IArm d1 d2 d3 body
          (if (> (ri-name-safe-in body name) 0) (ri-name-safe-in-arms rest name) 0))))))

; Unconditional "does `name` appear anywhere at all" — used only for the
; IFn case above: a nested closure that references `name` in ANY
; position captures it (by value, into its own heap-allocated env — see
; icnf.zyl's ic-lambda-closure), and that env outlives this frame, so
; any reference at all inside a closure is unsafe, not just the
; unrecognized-position ones ri-name-safe-in itself checks for.
(defn ri-name-referenced (e name)
  (match e
    (IConst d1 0)
    (IStr d2 0)
    (IFlt d3 0)
    (ILoad n (str-eq n name))
    (IBinop d4 l r (if (> (ri-name-referenced l name) 0) 1 (ri-name-referenced r name)))
    (ICall d5 args (ri-name-referenced-list args name))
    (ICallClosure d6 args (ri-name-referenced-list args name))
    (IFfi d7 args (ri-name-referenced-list args name))
    (IPrint a (ri-name-referenced a name))
    (IIf c t eb
      (if (> (ri-name-referenced c name) 0) 1
        (if (> (ri-name-referenced t name) 0) 1 (ri-name-referenced eb name))))
    (IWhile c b (if (> (ri-name-referenced c name) 0) 1 (ri-name-referenced b name)))
    (ISet d8 v (ri-name-referenced v name))
    (ILet d9 v b (if (> (ri-name-referenced v name) 0) 1 (ri-name-referenced b name)))
    (ISeq es (ri-name-referenced-list es name))
    (IVariant d10 d11 fields (ri-name-referenced-list fields name))
    (IStackVariant d12 d13 fields (ri-name-referenced-list fields name))
    (IMatch scr arms
      (if (> (ri-name-referenced scr name) 0) 1 (ri-name-referenced-arms arms name)))
    (IFn d14 d15 body (ri-name-referenced body name))
    (ITryCatch tbody d16 cbody
      (if (> (ri-name-referenced tbody name) 0) 1 (ri-name-referenced cbody name)))))

(defn ri-name-referenced-list (xs name)
  (match xs
    (Nil 0)
    (Cons h t (if (> (ri-name-referenced h name) 0) 1 (ri-name-referenced-list t name)))))

(defn ri-name-referenced-arms (arms name)
  (match arms
    (Nil 0)
    (Cons a rest
      (match a
        (IArm d1 d2 d3 body
          (if (> (ri-name-referenced body name) 0) 1 (ri-name-referenced-arms rest name)))))))

; The actual Icnf -> Icnf rewrite, structurally recursing everywhere
; (nothing here changes shape except ILet's own val/body, and even then
; only ever IVariant -> IStackVariant, never anything structural).
(defn ri-transform-fns (fns)
  (match fns
    (Nil Nil)
    (Cons f rest (Cons (ri-transform-fn f) (ri-transform-fns rest)))))

(defn ri-transform-fn (f)
  (match f
    (IFn name params body (IFn name params (ri-transform-expr body)))
    (d1 (ri-transform-expr f))))

(defn ri-to-stack-variant (val)
  (match val
    (IVariant nm tag fields (IStackVariant nm tag fields))
    (d1 val)))

(defn ri-transform-let (name val body)
  (let val2 (ri-transform-expr val)
    (let body2 (ri-transform-expr body)
      (match val2
        (IVariant d1 d2 d3
          (if (> (ri-name-safe-in body2 name) 0)
            (ILet name (ri-to-stack-variant val2) body2)
            (ILet name val2 body2)))
        (d4 (ILet name val2 body2))))))

(defn ri-transform-list (xs)
  (match xs
    (Nil Nil)
    (Cons h t (Cons (ri-transform-expr h) (ri-transform-list t)))))

(defn ri-transform-arms (arms)
  (match arms
    (Nil Nil)
    (Cons a rest
      (match a
        (IArm v tag binds body (Cons (IArm v tag binds (ri-transform-expr body)) (ri-transform-arms rest)))))))

(defn ri-transform-expr (e)
  (match e
    (IConst d1 e)
    (IStr d2 e)
    (IFlt d3 e)
    (ILoad d4 e)
    (IBinop op l r (IBinop op (ri-transform-expr l) (ri-transform-expr r)))
    (ICall name args (ICall name (ri-transform-list args)))
    (ICallClosure name args (ICallClosure name (ri-transform-list args)))
    (IFfi name args (IFfi name (ri-transform-list args)))
    (IPrint a (IPrint (ri-transform-expr a)))
    (IIf c t eb (IIf (ri-transform-expr c) (ri-transform-expr t) (ri-transform-expr eb)))
    (IWhile c b (IWhile (ri-transform-expr c) (ri-transform-expr b)))
    (ISet name v (ISet name (ri-transform-expr v)))
    (ILet name val body (ri-transform-let name val body))
    (ISeq es (ISeq (ri-transform-list es)))
    (IVariant nm tag fields (IVariant nm tag (ri-transform-list fields)))
    (IStackVariant nm tag fields (IStackVariant nm tag (ri-transform-list fields)))
    (IMatch scr arms (IMatch (ri-transform-expr scr) (ri-transform-arms arms)))
    (IFn name params body (IFn name params (ri-transform-expr body)))
    (ITryCatch tbody cvar cbody (ITryCatch (ri-transform-expr tbody) cvar (ri-transform-expr cbody)))))
