; AST traversal helpers for type inference / compiler phases.
; Operates on pool-based AST nodes (same representation as parser output).
;
; Node layout reference (must match parser.zyl post-form rewrites):
;   ATOM kinds: 1 ident(str), 2 int(val), 3 float, 4 bool(val), 5 string,
;               6 keyword, 7 symbol
;   CALL(8): a=head, kids=args          DEF(9): a=value, str=name
;   DEFN(10): str=name, kids=params, a=body
;   LET(11)/LET-MUT(12): str=name, a=value, b=body
;   IF(13): a=cond, b=then, c=else      BEGIN(14): kids=statements
;   STRUCT_GET(15): a=target, str=field LAMBDA/FN(17): kids=params, a=body
;   MATCH(19): a=scrutinee, kids=arms   SPAWN(20): a=closure
;   SEND(21): a=actor, b=msg            SETBANG(25): str=name, a=value
;   WHILE(26): a=cond, b=body

; Bit helpers over the small field masks (no bitwise ops in Zyl yet).
; Returns: Int (0/1)
(defn ast-bit0 (mask) (% mask 2))

; Returns: Int (0/1)
(defn ast-bit1 (mask) (% (/ mask 2) 2))

; Returns: Int (0/1)
(defn ast-bit2 (mask) (% (/ mask 4) 2))

; ===========================================================================
; Field layout table: which of a/b/c each compound kind uses.
; Encoded as a bitmask: bit0=a, bit1=b, bit2=c. Kids are walked for all
; kinds except atoms (kinds 1-7) when kids > 0.
; Returns: Int (bitmask)
(defn ast-fields-of (kind)
  (if (= kind 8)
    1
    (if (= kind 9)
      1
      (if (= kind 10)
        1
        (if (or (= kind 11) (= kind 12))
          3
          (if (= kind 13)
            7
            (if (= kind 15)
              1
              (if (= kind 17)
                1
                (if (= kind 19)
                  1
                  (if (= kind 20)
                    1
                    (if (= kind 21)
                      3
                      (if (= kind 25)
                        1
                        (if (= kind 26)
                          3
                          0)))))))))))))

; Generic pre-order walk over the whole node graph. `visit` is invoked as
; (visit pool node-id); its boolean return continues (1) or prunes (0).
; Returns: Unit
(defn ast-walk-1 (pool node visit)
  (let cont (visit pool node)
    (if (> cont 0)
      (begin
        (let k (pool-kind pool node)
          (begin
            ; atoms have no children
            (if (< k 1)
              0
              (if (> k 7)
                (begin
                  (let mask (ast-fields-of k)
                    (begin
                      (if (> (ast-bit0 mask) 0)
                        (ast-walk-1 pool (pool-a pool node) visit)
                        0)
                      (if (> (ast-bit1 mask) 0)
                        (ast-walk-1 pool (pool-b pool node) visit)
                        0)
                      (if (> (ast-bit2 mask) 0)
                        (ast-walk-1 pool (pool-c pool node) visit)
                        0)))
                  0))
            (let kids (pool-kids pool node)
              (if (> kids 0)
                (ast-walk-kids pool kids visit 0 (kids-len kids))
                0)))))
      0)))

; Visit each child of a kids list in order.
; Returns: Unit
(defn ast-walk-kids (pool kids visit i n)
  (if (< i n)
    (begin
      (ast-walk-1 pool (kids-get kids i) visit)
      (ast-walk-kids pool kids visit (+ i 1) n))
    0)))

; Public walk entry point.
; Returns: Unit
(defn ast-walk (pool node visit)
  (ast-walk-1 pool node visit))

; ===========================================================================
; Count nodes of a specific kind in the AST
; ===========================================================================
; Returns: Int (count)
(defn ast-count-kind (pool node kind)
  (let k (pool-kind pool node)
    (let here (if (= k kind) 1 0)
      (let kids (pool-kids pool node)
        (if (> kids 0)
          (+ here (ast-count-kind-kids pool kids kind 0 (kids-len kids)))
          here)))))

; Sum child counts in order.
; Returns: Int (count)
(defn ast-count-kind-kids (pool kids kind i n)
  (if (< i n)
    (+ (ast-count-kind pool (kids-get kids i) kind)
       (ast-count-kind-kids pool kids kind (+ i 1) n))
    0))

; Count nodes reachable through a/b/c fields too (compound kinds).
; Returns: Int (count)
(defn ast-count-kind-deep (pool node kind)
  (let k (pool-kind pool node)
    (let here (if (= k kind) 1 0)
      (let mask (if (> k 7) (ast-fields-of k) 0)
        (let fa (if (> (ast-bit0 mask) 0)
                  (ast-count-kind-deep pool (pool-a pool node) kind)
                  0)
          (let fb (if (> (ast-bit1 mask) 0)
                    (ast-count-kind-deep pool (pool-b pool node) kind)
                    0)
            (let fc (if (> (ast-bit2 mask) 0)
                      (ast-count-kind-deep pool (pool-c pool node) kind)
                      0)
              (let kids (pool-kids pool node)
                (if (> kids 0)
                  (+ here (+ fa (+ fb (+ fc (ast-count-kind-kids pool kids kind 0 (kids-len kids))))))
                  (+ here (+ fa (+ fb fc))))))))))))

; ===========================================================================
; Collect all identifier names in the AST
; ===========================================================================
; Returns: Int (kids list of name pointers)
(defn ast-collect-idents (arena pool node)
  (let names (kids-new arena 16)
    (begin
      (ast-collect-idents-1 arena pool node names)
      names)))

; Returns: Int (1 if this kind stores expr fields to walk)
(defn ast-has-fields (kind)
  (if (> (ast-fields-of kind) 0) 1 0))

; Returns: Unit
(defn ast-collect-idents-1 (arena pool node names)
  (let k (pool-kind pool node)
    (if (= k 1)
      (kids-push arena names (pool-str pool node))
      (begin
        (let mask (if (> k 7) (ast-fields-of k) 0)
          (begin
            (if (> (ast-bit0 mask) 0)
              (ast-collect-idents-1 arena pool (pool-a pool node) names)
              0)
            (if (> (ast-bit1 mask) 0)
              (ast-collect-idents-1 arena pool (pool-b pool node) names)
              0)
            (if (> (ast-bit2 mask) 0)
              (ast-collect-idents-1 arena pool (pool-c pool node) names)
              0)))
        (let kids (pool-kids pool node)
          (if (> kids 0)
            (ast-collect-idents-kids arena pool kids names 0 (kids-len kids))
            0))))))

; Returns: Unit
(defn ast-collect-idents-kids (arena pool kids names i n)
  (if (< i n)
    (begin
      (ast-collect-idents-1 arena pool (kids-get kids i) names)
      (ast-collect-idents-kids arena pool kids names (+ i 1) n))
    0))

; ===========================================================================
; Accessors (match parser.zyl layouts exactly)
; ===========================================================================

; DEFN(10): name / params / body.
; Returns: Int (name string pointer)
(defn defn-name (pool node)
  (pool-str pool node))

; Returns: Int (params kids list)
(defn defn-params (pool node)
  (pool-kids pool node))

; Returns: Int (body node id)
(defn defn-body (pool node)
  (pool-a pool node))

; LET(11)/LET-MUT(12): name / value / body.
; Returns: Int (name string pointer)
(defn let-name (pool node)
  (pool-str pool node))

; Returns: Int (value node id)
(defn let-init (pool node)
  (pool-a pool node))

; Returns: Int (body node id)
(defn let-body (pool node)
  (pool-b pool node))

; IF(13): cond / then / else.
; Returns: Int (cond node id)
(defn if-cond (pool node)
  (pool-a pool node))

; Returns: Int (then node id)
(defn if-then (pool node)
  (pool-b pool node))

; Returns: Int (else node id)
(defn if-else (pool node)
  (pool-c pool node))

; CALL(8): head / args.
; Returns: Int (head node id)
(defn call-op (pool node)
  (pool-a pool node))

; Returns: Int (args kids list)
(defn call-args (pool node)
  (pool-kids pool node))

; MATCH(19): scrutinee / arms.
; Returns: Int (scrutinee node id)
(defn match-scrutinee (pool node)
  (pool-a pool node))

; Returns: Int (arms kids list)
(defn match-arms (pool node)
  (pool-kids pool node))

; WHILE(26): cond / body.
; Returns: Int (cond node id)
(defn while-cond (pool node)
  (pool-a pool node))

; Returns: Int (body node id)
(defn while-body (pool node)
  (pool-b pool node))

; SETBANG(25): target name / value.
; Returns: Int (target name string pointer)
(defn set-name (pool node)
  (pool-str pool node))

; Returns: Int (value node id)
(defn set-value (pool node)
  (pool-a pool node))

; DEFTYPE(32): type name / variants.
; Returns: Int (variants kids list)
(defn deftype-variants (pool node)
  (pool-kids pool node))

; Returns: Int (type name pointer)
(defn deftype-name (pool node)
  (pool-str pool node))

; DEFSTRUCT(34): struct name / fields.
; Returns: Int (fields kids list)
(defn defstruct-fields (pool node)
  (pool-kids pool node))

; Returns: Int (struct name pointer)
(defn defstruct-name (pool node)
  (pool-str pool node))
