; === Zyl Compiler — Shared Type Declarations ===
; Module: compiler/type_system
;
; The generic Pair and the memory Region family (spec §9) used by the
; parser and ICNF lowering. Type checking itself is compiler/type_annotate;
; the old Type ADT, substitution and unifier that lived here were never run
; and were removed (2026-09-25).

(deftype Pair (Pair A B))

; A byte buffer's region: `(bytebuf Stack N)` and friends.
(deftype Region
  (RStack)
  (RHeap)
  (RGlobal)
  (RCircular)
  (RPin))

; Region id for Icnf immediates (0..4 in the order above).
(defn region-to-int (r)
  (match r
    (RStack 0)
    (RHeap 1)
    (RGlobal 2)
    (RCircular 3)
    (RPin 4)))
