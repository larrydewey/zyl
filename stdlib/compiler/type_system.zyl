; === Zyl Type System — Hindley-Milner Inference ===
; Module: compiler/type_system
; Provides: Type ADT, Subst map, TypeVarGen, TypeEnv, TraitContext, TypeInferer
; Status: Phase 1 rewrite (correct Zyl deftype/match syntax, fixed recursion)

; ===========================================================================
; GENERIC PAIR — used for matching and result types
; ===========================================================================

(deftype Pair (Pair A B))

; ===========================================================================
; TYPE ADT
; ===========================================================================

(deftype Type
  (TInt)
  (TFloat)
  (TBool)
  (TString)
  (TUnit)
  (TFun (List Type))
  (TList (List Type))
  (TArray Type Int)
  (TCap CapKind Type)
  (TStruct String (List Type))
  (TVar Int Type)
  (TMap Type Type)
  (TResult Type Type))

(deftype CapKind
  (TCCap)
  (TCMut)
  (TCAtomic)
  (TCBox)
  (TCPin))

; A nominal (named) type with no type arguments — sugar over TStruct.
(defn TNominal (name) (TStruct name Nil))

; Canonical display name for a Type — used to build monomorphized
; function/struct names. Nested type args are not recursively expanded;
; TStruct's own name carries the meaningful identity for that purpose.
(defn type-to-string (t)
  (match t
    (TInt "Int")
    (TFloat "Float")
    (TBool "Bool")
    (TString "String")
    (TUnit "Unit")
    (TFun d1 "Fn")
    (TList d1 "List")
    (TArray d1 d2 "Array")
    (TCap d1 d2 "Cap")
    (TStruct n d1 n)
    (TVar d1 d2 "Var")
    (TMap d1 d2 "Map")
    (TResult d1 d2 "Result")))

; ===========================================================================
; SUBST MAP — List of (Int Type) bindings
; ===========================================================================

(deftype Subst (SBindings (List TypeBind)))
(defn SBindings.binds (s) (match s (SBindings b b)))

(deftype TypeBind (TB Int Type))

; ===========================================================================
; TYPEVAR GENERATOR
; ===========================================================================

(deftype TypeVarGen (TVG Int))
(defn TVG.n (g) (match g (TVG n n)))

; ===========================================================================
; TYPE ENVIRONMENT — List of (String Type) bindings
; ===========================================================================

(deftype TypeEnv (TEBindings (List EnvBind)))
(defn TEBindings.binds (e) (match e (TEBindings b b)))

(deftype EnvBind (EB String Type))

; Look up a name in a TypeEnv, returning the bound Type or None.
(defn env-get (env name)
  (env-get-binds (TEBindings.binds env) name))

(defn env-get-binds (binds name)
  ; was `((EB k v) rest body)` — the Cons-cell "nested-head + tail-
  ; binding" sugar (head destructured via a nested pattern, tail bound to
  ; "rest"). The self-hosted parser's nested-pattern handling drops the
  ; tail binding entirely for this 3-element shape (only correctly
  ; handles the simpler 2-element `((Variant f1 f2) body)` form), so
  ; "rest" never got bound — "rbp0"/undefined symbol at link time.
  ; Sequential matches sidestep it.
  (match binds
    (Nil None)
    (Cons hd rest
      (match hd
        (EB k v
          (if (= k name)
            (Some v)
            (env-get-binds rest name)))))))

; Bind a name to a type in a TypeEnv.
; Same "type name instead of real constructor" bug as inferer-new's
; (TypeEnv Nil) — TypeEnv's constructor is TEBindings. This one is called
; on every let/lambda/match-arm binding, so it corrupted the environment
; chain everywhere, not just at startup.
(defn env-bind (env bind-name typ)
  ; param named "bind-name", not "name" — a caller passing its own local
  ; variable literally named "name" as this argument collided with this
  ; function's own "name" parameter when inlined, corrupting slot allocation
  ; for the inlined MakeVariant's field ("MakeVariant field load of `name`
  ; ... has no local slot").
  (TEBindings (Cons (EB bind-name typ) (TEBindings.binds env))))

; ===========================================================================
; TRAIT CONTEXT — List of (String (List Type)) bounds
; ===========================================================================

(deftype TraitContext (TCTraitBounds (List TraitBound)))

(deftype TraitBound (TRB String (List Type)))

; ===========================================================================
; TYPE INFERENCE ENGINE
; ===========================================================================

; Full inference-context record owned by the type system (see
; stdlib/compiler/type_inference.zyl for the inference logic that uses it).
; A record with 20 fields, NOT 20 variants — every "TIxxx" name below used
; to be its own single-field variant (nonsensical for a record: each
; `(TypeInferer ...)` construction call names none of those 20 variants, so
; it always resolved to the wildcard sentinel discriminant; and no ti-env/
; ti-subst/... accessor functions existed at all, despite being called
; throughout type_inference.zyl as if they extracted a field). Fixed to one
; variant with all 20 fields, with real accessor functions defined below
; (same convention as Expr.inner / P.name elsewhere in this codebase).
(deftype TypeInferer
  (TypeInferer
    TypeEnv                ; ti-env
    Subst                  ; ti-subst
    Int                    ; ti-next
    (List TypeBind)        ; ti-known-types
    (List FnSig)           ; ti-known-fns
    (List FnReturn)        ; ti-func-returns
    (List AdtDef)          ; ti-adt-defs
    (List TypeBind)        ; ti-variant-to-adt
    (List String)          ; ti-string-match-vars
    (List String)          ; ti-inferring-fns
    (List BodyCache)       ; ti-body-cache
    (List (Pair String (List String))) ; ti-adt-param-order
    (List AdtInstantiation)            ; ti-adt-instantiations
    (List (Pair String (List (List String)))) ; ti-arg-type-observations
    (List (Pair String Expr))           ; ti-function-bodies
    (List String)                    ; ti-skip-generic-def-names
    TraitContext             ; ti-trait-ctx
    (List StructDef)         ; ti-struct-defs
    (List String)            ; ti-generics-in-scope
    (List (Pair String String)))))    ; ti-var-type-map (for occurs-check tracking)

(defn ti-env (ti) (match ti (TypeInferer v tia2 tia3 tia4 tia5 tia6 tia7 tia8 tia9 tia10 tia11 tia12 tia13 tia14 tia15 tia16 tia17 tia18 tia19 tia20 v)))
(defn ti-subst (ti) (match ti (TypeInferer tib1 v tib3 tib4 tib5 tib6 tib7 tib8 tib9 tib10 tib11 tib12 tib13 tib14 tib15 tib16 tib17 tib18 tib19 tib20 v)))
(defn ti-next (ti) (match ti (TypeInferer tic1 tic2 v tic4 tic5 tic6 tic7 tic8 tic9 tic10 tic11 tic12 tic13 tic14 tic15 tic16 tic17 tic18 tic19 tic20 v)))
(defn ti-known-types (ti) (match ti (TypeInferer tid1 tid2 tid3 v tid5 tid6 tid7 tid8 tid9 tid10 tid11 tid12 tid13 tid14 tid15 tid16 tid17 tid18 tid19 tid20 v)))
(defn ti-known-fns (ti) (match ti (TypeInferer tie1 tie2 tie3 tie4 v tie6 tie7 tie8 tie9 tie10 tie11 tie12 tie13 tie14 tie15 tie16 tie17 tie18 tie19 tie20 v)))
(defn ti-func-returns (ti) (match ti (TypeInferer tif1 tif2 tif3 tif4 tif5 v tif7 tif8 tif9 tif10 tif11 tif12 tif13 tif14 tif15 tif16 tif17 tif18 tif19 tif20 v)))
(defn ti-adt-defs (ti) (match ti (TypeInferer tig1 tig2 tig3 tig4 tig5 tig6 v tig8 tig9 tig10 tig11 tig12 tig13 tig14 tig15 tig16 tig17 tig18 tig19 tig20 v)))
(defn ti-variant-to-adt (ti) (match ti (TypeInferer tih1 tih2 tih3 tih4 tih5 tih6 tih7 v tih9 tih10 tih11 tih12 tih13 tih14 tih15 tih16 tih17 tih18 tih19 tih20 v)))
(defn ti-string-match-vars (ti) (match ti (TypeInferer tii1 tii2 tii3 tii4 tii5 tii6 tii7 tii8 v tii10 tii11 tii12 tii13 tii14 tii15 tii16 tii17 tii18 tii19 tii20 v)))
(defn ti-inferring-fns (ti) (match ti (TypeInferer tij1 tij2 tij3 tij4 tij5 tij6 tij7 tij8 tij9 v tij11 tij12 tij13 tij14 tij15 tij16 tij17 tij18 tij19 tij20 v)))
(defn ti-body-cache (ti) (match ti (TypeInferer tik1 tik2 tik3 tik4 tik5 tik6 tik7 tik8 tik9 tik10 v tik12 tik13 tik14 tik15 tik16 tik17 tik18 tik19 tik20 v)))
(defn ti-adt-param-order (ti) (match ti (TypeInferer tik1 tik2 tik3 tik4 tik5 tik6 tik7 tik8 tik9 tik10 tik11 v tik13 tik14 tik15 tik16 tik17 tik18 tik19 tik20 v)))
(defn ti-adt-instantiations (ti) (match ti (TypeInferer tik1 tik2 tik3 tik4 tik5 tik6 tik7 tik8 tik9 tik10 tik11 tik12 v tik14 tik15 tik16 tik17 tik18 tik19 tik20 v)))
(defn ti-arg-type-observations (ti) (match ti (TypeInferer tik1 tik2 tik3 tik4 tik5 tik6 tik7 tik8 tik9 tik10 tik11 tik12 tik13 v tik15 tik16 tik17 tik18 tik19 tik20 v)))
(defn ti-function-bodies (ti) (match ti (TypeInferer tik1 tik2 tik3 tik4 tik5 tik6 tik7 tik8 tik9 tik10 tik11 tik12 tik13 tik14 v tik16 tik17 tik18 tik19 tik20 v)))
(defn ti-skip-generic-def-names (ti) (match ti (TypeInferer tik1 tik2 tik3 tik4 tik5 tik6 tik7 tik8 tik9 tik10 tik11 tik12 tik13 tik14 tik15 v tik17 tik18 tik19 tik20 v)))
(defn ti-trait-ctx (ti) (match ti (TypeInferer tit1 tit2 tit3 tit4 tit5 tit6 tit7 tit8 tit9 tit10 tit11 tit12 tit13 tit14 tit15 tit16 v tit18 tit19 tit20 v)))
(defn ti-struct-defs (ti) (match ti (TypeInferer tis1 tis2 tis3 tis4 tis5 tis6 tis7 tis8 tis9 tis10 tis11 tis12 tis13 tis14 tis15 tis16 tis17 v tis19 tis20 v)))
(defn ti-generics-in-scope (ti) (match ti (TypeInferer tig1 tig2 tig3 tig4 tig5 tig6 tig7 tig8 tig9 tig10 tig11 tig12 tig13 tig14 tig15 tig16 tig17 tig18 v tis20 v)))
(defn ti-var-type-map (ti) (match ti (TypeInferer tvm1 tvm2 tvm3 tvm4 tvm5 tvm6 tvm7 tvm8 tvm9 tvm10 tvm11 tvm12 tvm13 tvm14 tvm15 tvm16 tvm17 tvm18 tvm19 v v)))

; Inference support ADTs (function signatures, return types, ADT defs,
; variant fields, per-site body cache, string-match vars).
(deftype FnSig (FNS Name (List ParamType)))
(deftype ParamType (PT Name Type))
(deftype FnReturn (FR Name Type))
(deftype AdtDef (AD Name (List Variant)))
(deftype Variant (V Name (List Field)))
(deftype Field (F Name Type))
(deftype BodyCache (BC Key Type))
(deftype VarPair (VP Index Int))

; ADT instantiation records for positional monomorphization naming.
; Mirrors Rust AdtInstantiation: {param -> concrete} mapping.
(deftype AdtInstantiation (AI (List (Pair String String))))

; Helper to extract the param-concrete pairs from an AdtInstantiation.
(defn AI.params (ai) (match ai (AI p p)))

; ===========================================================================
; TRAIT CONTEXT — simplified for Zyl (spec §15)
; ===========================================================================

(deftype TraitInfo
  (TI String (List (Pair String (List Type))) (List (Pair String Type)))) ; name, methods (name -> params), return_types

(deftype ImplInfo
  (II String Type (List (Pair String (List Type))))) ; trait_name, impl_type, methods

(deftype TraitContext
  (TC (List TraitInfo) (List ImplInfo))) ; traits, impls

(defn TC.traits (tc) (match tc (TC t d1 t)))
(defn TC.impls (tc) (match tc (TC d1 i i)))

(defn tc-new ()
  (TC Nil Nil))

(defn tc-register-trait (tc trait-info)
  (TC (Cons trait-info (TC.traits tc)) (TC.impls tc)))

(defn tc-register-impl (tc impl-info)
  (TC (TC.traits tc) (Cons impl-info (TC.impls tc))))

(defn tc-check-derivable (tc ty trait-name)
  ; Simplified: auto-derive Eq, Ord, Debug, Clone, Hash for primitives
  (or (= trait-name "Eq")
    (or (= trait-name "Ord")
      (or (= trait-name "Debug")
        (or (= trait-name "Clone") (= trait-name "Hash"))))))

(defn tc-is-send (tc ty)
  ; Simplified: primitives, TCap, TAtomic are Send
  (match ty
    (TInt true)
    (TFloat true)
    (TBool true)
    (TString true)
    (TUnit true)
    (TCap kind inner
      (or (= kind TCCap) (or (= kind TCAtomic) (tc-is-send tc inner))))
    (d1 false)))

; ===========================================================================
; STRUCT DEFINITIONS
; ===========================================================================

(deftype StructDef
  (SD String (List (Pair String (Option Type)))))

; ===========================================================================
; TYPE ENV — shadowing bind for match-arm pattern variables
; ===========================================================================

; Bind a name to a type in a TypeEnv, SHADOWING any existing binding.
; Unlike env-bind (which prepends), this REPLACES the first matching
; binding for the same name. Used for match-arm pattern vars so that
; common short names (a, v, x) don't collide with outer scopes — the
; arm's field type must win.
(defn env-bind-param (env bind-name typ)
  (let
      (binds (TEBindings.binds env))
      (new-binds (env-bind-param-replace binds bind-name typ))
      (TEBindings new-binds)))

(defn env-bind-param-replace (binds bind-name typ)
  (match binds
    (Nil
      (Cons (EB bind-name typ) Nil))
    (Cons hd rest
      (match hd
        (EB k v
          (if (= k bind-name)
            (Cons (EB bind-name typ) rest)
            (Cons (EB k v) (env-bind-param-replace rest bind-name typ))))))))

; ===========================================================================
; NOMINAL TYPE RESOLUTION — mirror Rust resolve_nominal
; ===========================================================================

; Apply substitution then, if the resolved type is nominal (TStruct),
; return its name; else None.
(defn resolve-nominal (subst t)
  (match (subst-apply subst t)
    (TStruct n d1 (Some n))
    (d1 None)))

; ===========================================================================
; UNIFICATION RESULT
; ===========================================================================

(deftype UnifyResult (UOk Subst)
                     (UErr String))

; ===========================================================================
; TYPE VARIABLE GENERATION
; ===========================================================================

(deftype TypeVar (TV Int))

(defn typevar-gen-new (g)
  ; same "type name instead of real constructor" bug as Subst/TypeEnv —
  ; TypeVar's constructor is TV, TypeVarGen's is TVG.
  (Pair (TV (TVG.n g)) (TVG (+ (TVG.n g) 1))))

(defn typevar-gen-next (g)
  (TVG.n g))

; ===========================================================================
; SUBSTITUTION OPERATIONS
; ===========================================================================

; Same "type name instead of real constructor" bug as TypeEnv above —
; Subst's constructor is SBindings, not Subst.
(defn subst-empty ()
  (SBindings Nil))

(defn subst-lookup (s n)
  (subst-lookup-binds (SBindings.binds s) n))

(defn subst-lookup-binds (binds n)
  ; same Cons-cell nested-head-plus-tail-binding bug as env-get-binds above.
  (match binds
    (Nil None)
    (Cons hd rest
      (match hd
        (TB k v
          (if (= k n)
            (Some v)
            (subst-lookup-binds rest n)))))))

(defn subst-insert (s n t)
  (SBindings (Cons (TB n t) (SBindings.binds s))))

; Apply substitution to a single Type — helper to avoid lambda recursion issue
(defn subst-apply-type (s t)
  (match t
    (TInt TInt)
    (TFloat TFloat)
    (TBool TBool)
    (TString TString)
    (TUnit TUnit)
    (TFun args (subst-apply-type-list s args))
    (TList elem (TList (subst-apply-type s elem)))
    (TArray elem len (TArray (subst-apply-type s elem) len))
    (TCap kind inner (TCap kind (subst-apply-type s inner)))
    (TStruct name fields (subst-apply-type-struct s name fields))
    (TVar m inner
     (match (subst-lookup s m)
       (Some t (subst-apply-type s t))
       (None (TVar m (subst-apply-type s inner)))))
    (TMap k v (TMap (subst-apply-type s k) (subst-apply-type s v)))
    (TResult e h (TResult (subst-apply-type s e) (subst-apply-type s h))) ))

(defn subst-apply-type-list (s types)
  (match types
    (Nil Nil)
    ((Cons h t) (Cons (subst-apply-type s h) (subst-apply-type-list s t)))))

(defn subst-apply-type-struct (s name fields)
  (TStruct name (subst-apply-type-list s fields)))

; ===========================================================================
; UTILITY HELPERS — nil?, fst, snd (type_inference.zyl dependencies)
; ===========================================================================


(defn fst (p)
  (match p
    (Pair a d2 a)
    (d1 (fst-pair p))))

(defn fst-pair (p)
  ; was `(Pair (Some a) d3 a)` / `(Pair (None) d4 0)` — nested field
  ; positions (self-hosted parser has no nested-pattern desugaring).
  (match p
    (Pair first d3
      (match first
        (Some a a)
        (None 0)))))

(defn snd (p)
  (match p
    (Pair a b b)
    (d1 (snd-pair p))))

(defn snd-pair (p)
  (match p
    (Pair a b b)
    (d1 0)))

; Main entry — wraps the inner function
(defn subst-apply (s t)
  (subst-apply-type s t))


; ===========================================================================
; FREE TYPE VARIABLE COMPUTATION
; ===========================================================================

(defn type-free-vars (t)
  (match t
    (TInt Nil)
    (TFloat Nil)
    (TBool Nil)
    (TString Nil)
    (TUnit Nil)
    (TFun args (type-free-vars-list args))
    (TList elem (type-free-vars elem))
    (TArray elem d1 (type-free-vars elem))
    (TCap d2 inner (type-free-vars inner))
    (TStruct d3 fields (type-free-vars-list fields))
    (TVar n d4 (Cons n Nil))
    (TMap k v (tfv-union (type-free-vars k) (type-free-vars v)))
    (TResult e h (tfv-union (type-free-vars e) (type-free-vars h))) ))

(defn type-free-vars-list ((types (List Type)))
  (match types
    (Nil Nil)
    ((Cons h t) (tfv-union (type-free-vars h) (type-free-vars-list t)))))

; `(List n)` used "List" as if it were a constructor (it's only ever a
; TYPE NAME in field-type position, e.g. `(List Type)` — never callable);
; the real way to build a one-element list is `(Cons n Nil)`. `union` was
; never defined anywhere either — dedup-merge two int lists directly
; (free-var indices), reusing `=` since ints compare safely (unlike the
; ADT-pointer-equality pitfalls `list-contains` hits for structured values).
(defn tfv-union (a b)
  (match a
    (Nil b)
    (Cons h t
      (if (tfv-contains b h)
        (tfv-union t b)
        (Cons h (tfv-union t b))))))

(defn tfv-contains (lst x)
  (match lst
    (Nil false)
    (Cons h t (if (= h x) true (tfv-contains t x)))))

; ===========================================================================
; UNIFICATION
; ===========================================================================

(defn unify (s t1 t2)
  ; `(let ((name val)) body)` is Scheme-style multi-binding let syntax this
  ; language doesn't have — its real `let` takes exactly one (name val)
  ; pair with a SINGLE wrapping paren: `(let (name val) body)`. Confirmed
  ; empirically that the double-paren form silently produces 0 instead of
  ; evaluating the body. `unify` is called from nearly every infer-expr-*
  ; function, so this was corrupting type inference throughout.
  (let (t1x (subst-apply s t1))
    (let (t2x (subst-apply s t2))
      (unify-terms s t1x t2x))))

; Rewritten to avoid nested field-position patterns like
; `(Pair (TFun args1) (TFun args2))` — the self-hosted parser has no
; equivalent of the Rust bootstrap's desugar_arm_raw (nested-pattern ->
; fresh-var + inner-match desugaring), so every nested position here fed
; convert-ast raw AST-as-code instead of destructuring a pattern,
; corrupting every arm's field bindings (each showed up as the same
; "rbp0"/undefined-symbol-at-link-time failure already fixed elsewhere in
; expr_inner.zyl/resolver.zyl). Sequential t1-then-t2 matches with no
; nested positions anywhere sidestep it entirely; ordering preserved
; exactly (t1 TVar checked first, then t2 TVar, matching the original
; arm order where neither TVar arm could ever be shadowed by an earlier
; same-shape arm since TVar never matches TInt/TFloat/.../TResult).
(defn unify-terms (s t1 t2)
  (match t1
    (TVar n d5 (unify-var s n t2))
    (d10 (unify-terms-not-tvar1 s t1 t2))))

(defn unify-terms-not-tvar1 (s t1 t2)
  (match t2
    (TVar n d8 (unify-var s n t1))
    (d11 (unify-terms-concrete s t1 t2))))

(defn unify-terms-concrete (s t1 t2)
  (match t1
    (TInt (match t2 (TInt (UOk s)) (d1 (UErr "Type mismatch"))))
    (TFloat (match t2 (TFloat (UOk s)) (d1 (UErr "Type mismatch"))))
    (TBool (match t2 (TBool (UOk s)) (d1 (UErr "Type mismatch"))))
    (TString (match t2 (TString (UOk s)) (d1 (UErr "Type mismatch"))))
    (TUnit (match t2 (TUnit (UOk s)) (d1 (UErr "Type mismatch"))))
    (TFun args1
      (match t2
        (TFun args2
          (if (= (list-length args1) (list-length args2))
            (unify-args s args1 args2)
            (UErr "Function arity mismatch")))
        (d1 (UErr "Type mismatch"))))
    (TList e1
      (match t2
        (TList e2 (unify s e1 e2))
        (d1 (UErr "Type mismatch"))))
    (TArray e1 l1
      (match t2
        (TArray e2 l2
          (if (= l1 l2) (unify s e1 e2) (UErr "Array length mismatch")))
        (d1 (UErr "Type mismatch"))))
    (TCap k1 a
      (match t2
        (TCap k2 b
          (if (= k1 k2) (unify s a b) (UErr "Capability kind mismatch")))
        (d1 (UErr "Type mismatch"))))
    (TStruct n1 fs1
      (match t2
        (TStruct n2 fs2
          (if (= n1 n2)
            (if (= (list-length fs1) (list-length fs2))
              (unify-args s fs1 fs2)
              (UErr "Struct field count mismatch"))
            (UErr "Struct name mismatch")))
        (d1 (UErr "Type mismatch"))))
    (TMap k1 v1
      (match t2
        (TMap k2 v2
          (match (unify s k1 k2)
            (UOk sx (unify sx v1 v2))
            (UErr e (UErr e))))
        (d1 (UErr "Type mismatch"))))
    (TResult e1 h1
      (match t2
        (TResult e2 h2
          (match (unify s e1 e2)
            (UOk sx (unify sx h1 h2))
            (UErr e (UErr e))))
        (d1 (UErr "Type mismatch"))))
    (d2 (UErr "Type mismatch"))))

(defn type-contains-var (t n)
  ; Check if type t contains type variable n (occurs check)
  (match t
    (TVar m _ (= m n))
    (TFun args (type-contains-var-list args n))
    (TList elem (type-contains-var elem n))
    (TArray elem _ (type-contains-var elem n))
    (TCap _ inner (type-contains-var inner n))
    (TStruct _ fields (type-contains-var-list fields n))
    (TMap k v (or (type-contains-var k n) (type-contains-var v n)))
    (TResult e h (or (type-contains-var e n) (type-contains-var h n)))
    (d1 false)))

(defn type-contains-var-list (types n)
  (match types
    (Nil false)
    (Cons h t (or (type-contains-var h n) (type-contains-var-list t n)))))

(defn unify-var (s n t)
  (match (subst-lookup s n)
    (Some tx
     (if (= tx t)
       (UOk s)
       (UErr "Variable already bound")))
    (None
     (if (type-contains-var t n)
       (UErr "Occurs check failed")
       (UOk (subst-insert s n t)) ))))

(defn unify-args (s args1 args2)
  ; args1/args2 are (List Type). Sequential matches instead of a single
  ; Pair-wrapped nested match — same "no nested-pattern desugaring in the
  ; self-hosted parser" issue as unify-terms above.
  (match args1
    (Nil
      (match args2
        (Nil (UOk s))
        (d1 (UErr "argument count mismatch"))))
    (Cons h1 t1
      (match args2
        (Cons h2 t2
          (match (unify s h1 h2)
            (UOk sx (unify-args sx t1 t2))
            (UErr e (UErr e))))
        (d2 (UErr "argument count mismatch"))))))

; ===========================================================================
; ICNF — SSA IR with Region Annotations (spec §18)
; ===========================================================================

; Memory regions (spec §9)
(deftype Region
  (RStack)
  (RHeap)
  (RGlobal)
  (RCircular)
  (RPin))

(defn is-default-region (r)
  (match r (RStack true) (d1 false)))

; BinOpKind (spec §18.2)
(deftype BinOpKind
  (BAdd)
  (BSub)
  (BMul)
  (BDiv)
  (BRem)
  (BEq)
  (BNeq)
  (BLt)
  (BGt)
  (BLe)
  (BGe)
  (BAnd)
  (BOr))

(defn binop-kind-from-int (i)
  (match i
    (0 BAdd)
    (1 BSub)
    (2 BMul)
    (3 BDiv)
    (4 BRem)
    (5 BEq)
    (6 BNeq)
    (7 BLt)
    (8 BGt)
    (9 BLe)
    (10 BGe)
    (11 BAnd)
    (12 BOr)
    (d1 BAdd)))

(defn binop-kind-to-int (k)
  (match k
    (BAdd 0)
    (BSub 1)
    (BMul 2)
    (BDiv 3)
    (BRem 4)
    (BEq 5)
    (BNeq 6)
    (BLt 7)
    (BGt 8)
    (BLe 9)
    (BGe 10)
    (BAnd 11)
    (BOr 12)
    (d1 0)))

; UnOpKind (spec §18.2)
(deftype UnOpKind
  (UNot)
  (UNegate))

; CaptureField (spec §18.3)
(deftype CaptureField (CF String Int))  ; name, ssa_id

(defn CF.name (cf) (match cf (CF n d1 n)))
(defn CF.ssa-id (cf) (match cf (CF d1 s s)))

; MatchArmICNF (spec §18.4)
(deftype MatchArmICNF
  (MAI String Int (List String) (List String) (List ICNFNode))) ; variant_name, discriminant, field_names, field_types, body

(defn MAI.variant-name (a) (match a (MAI n d1 d2 d3 d4 n)))
(defn MAI.discriminant (a) (match a (MAI d1 d d2 d3 d4 d)))
(defn MAI.field-names (a) (match a (MAI d1 d2 n d3 d4 n)))
(defn MAI.field-types (a) (match a (MAI d1 d2 d3 n d4 n)))
(defn MAI.body (a) (match a (MAI d1 d2 d3 d4 b b)))

; ICNFInner — the actual IR operations (spec §18)
(deftype ICNFInner
  (ICConst Atom)                                    ; constant value
  (ICLoad String)                                   ; variable reference
  (ICAssign String Int)                             ; bind ssa_id to value
  (ICBinop BinOpKind Int Int)                       ; binop(left_ssa, right_ssa)
  (ICUnop UnOpKind Int)                             ; unop(operand_ssa)
  (ICCall String (List Int))                        ; direct call(name, arg_ssa_ids...)
  (ICCallIndirect Int (List Int))                   ; indirect call(callee_ssa, arg_ssa_ids...)
  (ICIf Int (List ICNFNode) (List ICNFNode) String) ; cond_ssa, then_body, else_body, result_var
  (ICWhile (List ICNFNode) (List ICNFNode) String)  ; cond_body, body, result_var
  (ICFor (List (Pair String (Option Int))) (List ICNFNode) (List ICNFNode) String) ; init_bindings, cond_nodes, body, result_var
  (ICClosure String (List CaptureField) (List String)) ; name, captures, params
  (ICMakeVariant String String Int (List Int))      ; type_name, variant_name, discriminant, field_ids
  (ICMatch Int String (List MatchArmICNF) String)   ; scrutinee_ssa, type_name, arms, result_var
  (ICTryCatch (List ICNFNode) String (List ICNFNode)) ; try_body, catch_var, catch_body
  (ICBegin (List ICNFNode))
  (ICMakeStruct String (List Int))                  ; name, field_ids
  (ICStructGet Int Int)                             ; struct_value_ssa, field_byte_offset
  (ICFfiCall String (List Int) Int)                 ; name, args, timeout
  (ICSpawn Int)                                     ; closure_ssa
  (ICSend Int Int)                                  ; actor_ssa, msg_ssa
  (ICSendClosure Int String String (List Int))      ; actor_ssa, wrapper_name, handler_name, captured_ids
  (ICErrValue Int)                                  ; error value ssa
  (ICOkValue Int)                                   ; ok value ssa
  (ICUnit)
  (ICPrint (List Int))
  (ICReadLine)
  (ICExit Int)
  (ICClose Int)
  (ICFileOpen Int Int)                              ; path_ssa, mode_ssa
  (ICFileRead Int Int)                              ; handle_ssa, count_ssa
  (ICFileWrite Int Int)                             ; handle_ssa, data_ssa
  (ICFileClose Int)                                 ; handle_ssa
  (ICBufAppend Int Int)                             ; dst_ssa, src_ssa
  (ICWithResource String Int)                       ; var_name, init_ssa
  (ICSetBang String Int)                            ; var_name, value_ssa
  (ICUnwrap Int)
  (ICAssert Int (Option String))                    ; cond_ssa, msg
  (ICFnPtrImm String)                               ; function symbol
  (ICI32Imm Int)                                    ; 32-bit immediate
  (ICStrImm String)                                 ; string literal
  (ICReturn Int)                                    ; return value ssa
  (ICEq Int Int))                                   ; left_ssa, right_ssa

; ICNFNode — single SSA statement with id, region, type, branch flag
(deftype ICNFNode
  (ICN Int Region (Option Type) Bool ICNFInner)) ; id, region, typ, is_branch_body, node

(defn ICN.id (n) (match n (ICN i d1 d2 d3 d4 i)))
(defn ICN.region (n) (match n (ICN d1 r d2 d3 d4 r)))
(defn ICN.typ (n) (match n (ICN d1 d2 t d3 d4 t)))
(defn ICN.is-branch (n) (match n (ICN d1 d2 d3 b d4 b)))
(defn ICN.node (n) (match n (ICN d1 d2 d2 d4 n n)))

; ICNFFuncSig — function signature with SSA body
(deftype ICNFFuncSig
  (IFS String (List (Pair String Type)) (Option Type) (List ICNFNode) Int)) ; name, params, return_type, body, result_id

(defn IFS.name (f) (match f (IFS n d1 d2 d3 d4 n)))
(defn IFS.params (f) (match f (IFS d1 p d2 d3 d4 p)))
(defn IFS.return-type (f) (match f (IFS d1 d2 r d3 d4 r)))
(defn IFS.body (f) (match f (IFS d1 d2 d3 b d4 b)))
(defn IFS.result-id (f) (match f (IFS d1 d2 d3 d4 r r)))

; ICNFProgram — complete output
(deftype ICNFProgram
  (IP (List ICNFFuncSig) (List ICNFNode))) ; functions, top-level stmts

(defn IP.functions (p) (match p (IP f d1 f)))
(defn IP.stmts (p) (match p (IP d1 s s)))

