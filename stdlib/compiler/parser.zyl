; === Zyl Standard Library — Compiler Parser (reader) ===
; Module: compiler/parser
;
; A pure recursive-descent reader over a (List Token) stream, producing
; nested Ast values (see compiler/ast). Deliberately *dispatch-free*
; (spec architecture decision): every parenthesised form becomes an
; (AList ...); special forms (defn, let, if, ...) are recognised by the
; consumer phases, never by the parser.
;
; read-* functions return an AstTok: the parsed form plus the remaining
; token stream (functional threading, no mutable state).
;
; Every decision is a structural `match` on Token/Ast variants with ALL
; constructors enumerated (Zyl matches are exhaustive and have no
; wildcard catch-all). There are no numeric kind codes and no projection
; accessors.

(use allocator/allocator)
(use compiler/ast)
(use compiler/lexer)
(use compiler/sexp_balance)
(use compiler/error_codes)
(use compiler/error_report)
(use compiler/desugar)

; Result wrapper: parsed Ast + remaining tokens.
(deftype AstTok (AstOf Ast (List Token)))

; Empty form list (typed so `Nil` never unifies as Option).
(defn no-forms () Nil)

(defn art-ast (r)
  (match r
    (AstOf a _ a)))

(defn art-rest (r)
  (match r
    (AstOf _ rest rest)))

; ===========================================================================
; STREAM HELPERS
; ===========================================================================

; True only for the stream terminator token.
(defn tok-is-eof (t)
  (match t
    (TkEof _ true)
    (TkIdent _ _ false)
    (TkInt _ _ false)
    (TkIntOverflow _ _ false)
    (TkNumMalformed _ _ false)
    (TkFloat _ _ false)
    (TkString _ _ false)
    (TkBool _ _ false)
    (TkSymbol _ _ false)
    (TkKeyword _ _ false)
    (TkLParen _ false)
    (TkRParen _ false)
    (TkLBrace _ false)
    (TkRBrace _ false)
    (TkLBracket _ false)
    (TkRBracket _ false)
    (TkColon _ false)
    (TkQuote _ false)
    (TkQuasi _ false)
    (TkUnquote _ false)
    (TkSplice _ false)))

; True when the stream is exhausted (empty or at TkEof).
; Returns: Bool
(defn toks-empty (toks)
  (match toks
    (Cons t _ (tok-is-eof t))
    (Nil true)))

; ===========================================================================
; READER
; ===========================================================================

; Byte offset in the source that a token was lexed from.
(defn tok-offset (t)
  (match t
    (TkEof o o)
    (TkIdent _ o o)
    (TkInt _ o o)
    (TkIntOverflow _ o o)
    (TkNumMalformed _ o o)
    (TkFloat _ o o)
    (TkString _ o o)
    (TkBool _ o o)
    (TkSymbol _ o o)
    (TkKeyword _ o o)
    (TkLParen o o)
    (TkRParen o o)
    (TkLBrace o o)
    (TkRBrace o o)
    (TkLBracket o o)
    (TkRBracket o o)
    (TkColon o o)
    (TkQuote o o)
    (TkQuasi o o)
    (TkUnquote o o)
    (TkSplice o o)))

; Record where `node` was read from, then hand it straight back, so a
; construction reads `(ast-at fid off (AstInt v))`. The position is kept beside
; the node instead of inside it -- Ast has no span field, and giving it one
; would mean editing every one of the ~470 sites that name an Ast
; constructor, in a compiler that then has to go on compiling itself. See
; the span table in runtime/rt/ctab.zyl for why keying on the node's
; own address is sound here.
(defn ast-at (fid off node)
  (let _ (ffi-call "zyl_span_set" node off fid 1000)
    node))

; Read one form at the head of `toks`.
; Returns: AstTok
(defn read-form (arena toks fid)
  (let t (toks-head toks)
    (let rest (toks-tail toks)
      (read-dispatch arena t rest fid))))

(defn read-dispatch (arena t rest fid)
  (match t
        (TkLParen o (read-forms arena rest (no-forms) fid o))
        (TkLBracket o (read-forms-bracket arena rest (no-forms) fid o))
        (TkLBrace o (read-forms-brace arena rest (no-forms) fid o))
        (TkQuote o (read-prefixed arena rest fid o "quote"))
        (TkQuasi o (read-prefixed arena rest fid o "quasiquote"))
        (TkUnquote o (read-prefixed arena rest fid o "unquote"))
        (TkSplice o (read-prefixed arena rest fid o "unquote-splicing"))
        (TkRParen _ (read-form-atom arena t rest fid))
        (TkRBrace _ (read-form-atom arena t rest fid))
        (TkRBracket _ (read-form-atom arena t rest fid))
        (TkColon _ (read-form-atom arena t rest fid))
        (TkEof _ (read-form-atom arena t rest fid))
        (TkInt _ _ (read-form-atom arena t rest fid))
        ; Unreachable: check-int-literals reports every one of these before
        ; parsing starts, so no token stream reaching the parser has one.
        (TkIntOverflow _ _ (read-form-atom arena t rest fid))
        (TkNumMalformed _ _ (read-form-atom arena t rest fid))
        (TkFloat _ _ (read-form-atom arena t rest fid))
        (TkString _ _ (read-form-atom arena t rest fid))
        (TkBool _ _ (read-form-atom arena t rest fid))
        (TkIdent _ _ (read-form-atom arena t rest fid))
        (TkSymbol _ _ (read-form-atom arena t rest fid))
        (TkKeyword _ _ (read-form-atom arena t rest fid))))

; Atoms and terminators: everything except openers.
; Returns: AstTok
(defn read-form-atom (_arena t rest fid)
  (match t
    (TkInt v o (AstOf (ast-at fid o (AstInt v)) rest))
    (TkIntOverflow _ o (AstOf (ast-at fid o (AList Nil)) rest))
    (TkNumMalformed _ o (AstOf (ast-at fid o (AList Nil)) rest))
    (TkBool b o (AstOf (ast-at fid o (AstBool b)) rest))
    (TkFloat s o (AstOf (ast-at fid o (AstFloat s)) rest))
    (TkString s o (AstOf (ast-at fid o (AString s)) rest))
    (TkIdent s o (AstOf (ast-at fid o (AstIdent s)) rest))
    (TkSymbol s o (AstOf (ast-at fid o (AstIdent s)) rest))
    ; A keyword keeps its ':' so a consumer can tell `(use pkg:mod)` from
    ; `(use pkg mod)`: the lexer discards whitespace, so the two differ
    ; only in this token's kind, and §24.2 gives the colon form its own
    ; meaning (package:module). Consumers of `:le`/`:be` strip it.
    (TkKeyword s o (AstOf (ast-at fid o (AstIdent (str-concat ":" s))) rest))
    ; closers / colon / eof in atom position: empty form
    (TkEof o (AstOf (ast-at fid o (AList Nil)) rest))
    (TkLParen o (AstOf (ast-at fid o (AList (no-forms))) rest))
    (TkRParen o (AstOf (ast-at fid o (AList (no-forms))) rest))
    (TkLBrace o (AstOf (ast-at fid o (AList (no-forms))) rest))
    (TkRBrace o (AstOf (ast-at fid o (AList (no-forms))) rest))
    (TkLBracket o (AstOf (ast-at fid o (AList (no-forms))) rest))
    (TkRBracket o (AstOf (ast-at fid o (AList (no-forms))) rest))
    (TkColon o (AstOf (ast-at fid o (AList (no-forms))) rest))
    (TkQuote o (AstOf (ast-at fid o (AList (no-forms))) rest))
    (TkQuasi o (AstOf (ast-at fid o (AList (no-forms))) rest))
    (TkUnquote o (AstOf (ast-at fid o (AList (no-forms))) rest))
    (TkSplice o (AstOf (ast-at fid o (AList (no-forms))) rest))))

; Read forms until ')' (or EOF), accumulating into `acc` (reverse order).
; Returns: AstTok wrapping (AList forms...)
(defn read-forms (arena toks acc fid off)
  (if (toks-empty toks)
    (AstOf (ast-at fid off (AList (list-reverse acc))) toks)
    (let t (toks-head toks)
      (if (tok-is-rparen t)
        (AstOf (ast-at fid off (AList (list-reverse acc))) (toks-tail toks))
        (let r (read-form arena toks fid)
          (read-forms arena (art-rest r) (Cons (art-ast r) acc) fid off))))))

(defn tok-is-rparen (t)
  (match t
    (TkRParen _ true)
    (TkEof _ false)
    (TkIdent _ _ false)
    (TkInt _ _ false)
    (TkIntOverflow _ _ false)
    (TkNumMalformed _ _ false)
    (TkFloat _ _ false)
    (TkString _ _ false)
    (TkBool _ _ false)
    (TkSymbol _ _ false)
    (TkKeyword _ _ false)
    (TkLParen _ false)
    (TkLBrace _ false)
    (TkRBrace _ false)
    (TkLBracket _ false)
    (TkRBracket _ false)
    (TkColon _ false)
    (TkQuote _ false)
    (TkQuasi _ false)
    (TkUnquote _ false)
    (TkSplice _ false)))

; Read forms until '}' (or EOF).
; Returns: AstTok wrapping (AList forms...)
(defn read-forms-brace (arena toks acc fid off)
  (if (toks-empty toks)
    (AstOf (ast-at fid off (AList (list-reverse acc))) toks)
    (let t (toks-head toks)
      (if (tok-is-rbrace t)
        (AstOf (ast-at fid off (AList (list-reverse acc))) (toks-tail toks))
        (let r (read-form arena toks fid)
          (read-forms-brace arena (art-rest r) (Cons (art-ast r) acc) fid off))))))

(defn tok-is-rbrace (t)
  (match t
    (TkRBrace _ true)
    (TkEof _ false)
    (TkIdent _ _ false)
    (TkInt _ _ false)
    (TkIntOverflow _ _ false)
    (TkNumMalformed _ _ false)
    (TkFloat _ _ false)
    (TkString _ _ false)
    (TkBool _ _ false)
    (TkSymbol _ _ false)
    (TkKeyword _ _ false)
    (TkLParen _ false)
    (TkRParen _ false)
    (TkLBrace _ false)
    (TkLBracket _ false)
    (TkRBracket _ false)
    (TkColon _ false)
    (TkQuote _ false)
    (TkQuasi _ false)
    (TkUnquote _ false)
    (TkSplice _ false)))

; `[a b]` is the list literal `(list a b)`; `'d` is `(quote d)`, and
; `` `d ``, `,d`, `,@d` are quasiquote, unquote and unquote-splicing
; (expr_inner.zyl gives both their meaning).
(defn bracket-forms (fid off acc)
  (Cons (ast-at fid off (AstIdent "list")) (list-reverse acc)))

;; `'d`, `` `d ``, `,d` and `,@d`: `(head d)`.
(defn read-prefixed (arena rest fid off head)
  (let _ (match rest (Cons t _ (if (tok-closes t) (prefix-alone-fail fid off head) unit)) (Nil (prefix-alone-fail fid off head)))
  (let r (read-form arena rest fid)
    (AstOf (ast-at fid off (AList (Cons (ast-at fid off (AstIdent head)) (Cons (art-ast r) Nil))))
           (art-rest r)))))

; A quote or unquote with no form after it read past the closer (a trailing
; comma in `{ a, }` swallowed the rest of the file).
(defn prefix-alone-fail (fid off head)
  (ffi-call "zyl_panic"
    (err-at "E_MALFORMED_FORM" (str-concat "`" (str-concat (prefix-char head) "` needs a form after it"))
            fid off "an import list is whitespace-separated: { a b }")
    1000))

(defn prefix-char (head)
  (if (str-eq head "quote") "'" (if (str-eq head "quasiquote") "`" (if (str-eq head "unquote") "," ",@"))))

(defn tok-closes (t)
  (match t
    (TkRParen _ true)
    (TkRBracket _ true)
    (TkRBrace _ true)
    (TkEof _ true)
    (_ false)))

; Read forms until ']' (or EOF).
; Returns: AstTok wrapping (AList (list forms...))
(defn read-forms-bracket (arena toks acc fid off)
  (if (toks-empty toks)
    (AstOf (ast-at fid off (AList (bracket-forms fid off acc))) toks)
    (let t (toks-head toks)
      (if (tok-is-rbracket t)
        (AstOf (ast-at fid off (AList (bracket-forms fid off acc))) (toks-tail toks))
        (let r (read-form arena toks fid)
          (read-forms-bracket arena (art-rest r) (Cons (art-ast r) acc) fid off))))))

(defn tok-is-rbracket (t)
  (match t
    (TkRBracket _ true)
    (TkEof _ false)
    (TkIdent _ _ false)
    (TkInt _ _ false)
    (TkIntOverflow _ _ false)
    (TkNumMalformed _ _ false)
    (TkFloat _ _ false)
    (TkString _ _ false)
    (TkBool _ _ false)
    (TkSymbol _ _ false)
    (TkKeyword _ _ false)
    (TkLParen _ false)
    (TkRParen _ false)
    (TkLBrace _ false)
    (TkRBrace _ false)
    (TkLBracket _ false)
    (TkColon _ false)
    (TkQuote _ false)
    (TkQuasi _ false)
    (TkUnquote _ false)
    (TkSplice _ false)))

; Parse a whole source token stream into a program: a List of top-level
; Ast forms in source order.
; Returns: List(Ast)
(defn parse-program (arena toks fid)
  (list-reverse (parse-program-loop arena toks (no-forms) fid)))

(defn parse-program-loop (arena toks acc fid)
  (if (toks-empty toks)
    acc
    (let r (read-form arena toks fid)
      (parse-program-loop arena (art-rest r) (Cons (art-ast r) acc) fid))))

; Whole-source structural balance check, delegated to the native
; sexp_balance scanner (string/comment-aware, stack-based over bracket
; TYPE, not just a net count). The reader consumes to EOF on an unclosed
; form, so imbalance must be caught before parsing ever starts. This
; replaces the old bal-walk depth counter, which only ever compared total
; '(' vs ')' counts -- ")(" and "(]" both netted to a valid count and
; passed straight through to the reader.
(defn check-balanced (src fid)
  (let result (sb-check-string src)
    (if (sb-result-balanced result)
      0
      (report-unbalanced result fid))))

; A failed balance check as a located fatal diagnostic; a mismatched pair
; also labels the opener it failed to close.
; A NUL byte in a source file, as a located E_INVALID_CHAR; 0 when there is none.
(defn check-no-nul (path src)
  (let k (sb-nul-offset path src)
    (if (< k 0) 0
      (ffi-call "zyl_panic" (nul-diagnostic path src k) 1000))))

(defn nul-diagnostic (path src k)
  (err-at "E_INVALID_CHAR" "a NUL byte here ends the text; the rest of the file would be ignored"
          (ffi-call "zyl_source_register" path src 1000) k "remove the NUL byte"))

(defn report-unbalanced (result fid)
  (ffi-call "zyl_panic" (balance-diagnostic result fid) 1000))

; The rendered diagnostic (text or JSON) of a failed balance check in file fid.
(defn balance-diagnostic (result fid)
  (let off (ffi-call "zyl_span_offset_at" fid (sb-line result) (sb-col result) 1000)
    (let labels (match result
                  (MismatchedPair _ _ _ _ ol oc
                    (Cons (err-label fid (ffi-call "zyl_span_offset_at" fid ol oc 1000) "opened here") Nil))
                  (_ Nil))
      (err-at-labels (sb-code result) (sb-message result) fid off labels (sb-hint result)))))

; Convenience: lex + parse in one step from a source buffer pointer.
; Returns: List(Ast)
(defn zyl-parse (arena src)
  (zyl-parse-file arena src "<input>"))

; `path` is what a diagnostic prints and what the span table keys this
; file's text by, so a multi-module build points at the right file.
(defn zyl-parse-file (arena src path)
  (let fid (ffi-call "zyl_source_register" path src 1000)
    (begin
      (check-balanced src fid)
      (let toks (zyl-lex arena src)
        (begin
          (check-int-literals toks fid)
          (check-lexed-to-end toks src fid)
          (ds-program (parse-program arena toks fid)))))))

; A decimal integer literal too large for an Int, or a numeric literal
; that is not a number. Both are reported from the token stream, before
; parsing, because the lexer cannot: it has no file to name in a
; diagnostic. Without the first the literal became 0; without the second
; `1.2.3` became the Float 1.2. Either way the program went on to be
; wrong in whatever it computed.
(defn check-int-literals (toks fid)
  (match toks
    (Nil 0)
    (Cons t rest
      (if (int-overflow-token-p t)
        (let off (tok-offset t)
          (let text (token-text t)
            (ffi-call "zyl_panic"
              (err-at "E_INTEGER_OVERFLOW"
                (str-concat (str-concat "integer literal " text)
                  " does not fit an Int (64-bit signed); the largest is 9223372036854775807 and the smallest -9223372036854775808")
                fid off "write a value in range, or build it with shifts or arithmetic")
              1000)))
        (check-num-tokens t fid (check-int-literals rest fid))))))

(defn int-overflow-token-p (t)
  (match t
    (TkIntOverflow _ _ true)
    (_ false)))

(defn token-text (t)
  (match t
    (TkIntOverflow s _ s)
    (_ "")))

; A '.' belongs to a numeric literal exactly once, so a second one is a
; character the literal cannot use. It used to be dropped instead, and
; `1.2.3` printed as 1.200000.
(defn check-num-tokens (t fid k)
  (if (num-malformed-token-p t)
    (let off (tok-offset t)
      (ffi-call "zyl_panic"
        (err-at "E_INVALID_CHAR"
          (str-concat (str-concat "numeric literal " (num-malformed-text t))
            " has a second `.`; a Float literal has one decimal point")
          fid off "write 1.23, or two literals: 1.2 and 3")
        1000))
    k))

(defn num-malformed-token-p (t)
  (match t
    (TkNumMalformed _ _ true)
    (_ false)))

(defn num-malformed-text (t)
  (match t
    (TkNumMalformed s _ s)
    (_ "")))

; The lexer stops at a byte it cannot tokenize; its final TkEof then sits
; before the end of the source. Report that instead of dropping the rest.
(defn check-lexed-to-end (toks src fid)
  (let off (last-eof-offset toks)
    (if (>= off (ffi-call "zyl_cstr_len" src 1000))
      0
      (let c (ffi-call "zyl_cstr_byte_at" src off 1000)
        (if (= c 34)
          (if (< (scan-str-end src (ffi-call "zyl_cstr_len" src 1000) (+ off 1)) 0)
            (ffi-call "zyl_panic" (err-at "E_UNTERMINATED_STRING" "unterminated string literal" fid off "close it with a double quote") 1000)
            (ffi-call "zyl_panic" (err-at "E_INVALID_ESCAPE" "invalid escape sequence in string literal" fid off "the escapes are \\n \\t \\r \\0 \\\" \\\\ \\e and \\xNN") 1000))
          (ffi-call "zyl_panic"
            (err-at "E_INVALID_CHAR" (str-concat "unexpected character `" (str-concat (ffi-call "zyl_cstr_substr" src off 1 1000) "`"))
              fid off "Zyl has quote, quasiquote and unquote (`'`, `` ` ``, `,`, `,@`); `@`, `#`, `$`, `|`, `^` and `\\` may appear only in strings and comments") 1000))))))

(defn last-eof-offset (toks)
  (match toks
    (Nil 0)
    (Cons t rest
      (match rest
        (Nil (match t (TkEof o o) (_ 1000000000000)))
        (_ (last-eof-offset rest))))))
