; === Zyl Standard Library — Compiler Parser (reader) ===
; Module: compiler/parser
;
; A pure recursive-descent reader over a (List Token) stream, producing
; nested Ast values (see compiler/ast). Deliberately *dispatch-free*
; (spec architecture decision): every parenthesised form becomes an
; (AList ...); special forms (defn, let, if, ...) are recognised by the
; consumer phases, never by the parser.
;
; read-* functions return an AstTok: the parsed form plus the remaining
; token stream (functional threading, no mutable state).
;
; Every decision is a structural `match` on Token/Ast variants with ALL
; constructors enumerated (Zyl matches are exhaustive and have no
; wildcard catch-all). There are no numeric kind codes and no projection
; accessors.

(use allocator/allocator)
(use compiler/ast)
(use compiler/sexp_balance)
(use compiler/error_codes)
(use compiler/error_report)

; Result wrapper: parsed Ast + remaining tokens.
(deftype AstTok (AstOf Ast (List Token)))

; Empty form list (typed so `Nil` never unifies as Option).
(defn no-forms () Nil)

(defn art-ast (r)
  (match r
    (AstOf a _ a)))

(defn art-rest (r)
  (match r
    (AstOf _ rest rest)))

; ===========================================================================
; STREAM HELPERS
; ===========================================================================

; True only for the stream terminator token.
(defn tok-is-eof (t)
  (match t
    (TkEof _ true)
    (TkIdent _ _ false)
    (TkInt _ _ false)
    (TkFloat _ _ false)
    (TkString _ _ false)
    (TkBool _ _ false)
    (TkSymbol _ _ false)
    (TkKeyword _ _ false)
    (TkLParen _ false)
    (TkRParen _ false)
    (TkLBrace _ false)
    (TkRBrace _ false)
    (TkLBracket _ false)
    (TkRBracket _ false)
    (TkColon _ false)))

; True when the stream is exhausted (empty or at TkEof).
; Returns: Bool
(defn toks-empty (toks)
  (match toks
    (Cons t _ (tok-is-eof t))
    (Nil true)))

; ===========================================================================
; READER
; ===========================================================================

; Byte offset in the source that a token was lexed from.
(defn tok-offset (t)
  (match t
    (TkEof o o)
    (TkIdent _ o o)
    (TkInt _ o o)
    (TkFloat _ o o)
    (TkString _ o o)
    (TkBool _ o o)
    (TkSymbol _ o o)
    (TkKeyword _ o o)
    (TkLParen o o)
    (TkRParen o o)
    (TkLBrace o o)
    (TkRBrace o o)
    (TkLBracket o o)
    (TkRBracket o o)
    (TkColon o o)))

; Record where `node` was read from, then hand it straight back, so a
; construction reads `(ast-at fid off (AstInt v))`. The position is kept beside
; the node instead of inside it -- Ast has no span field, and giving it one
; would mean editing every one of the ~470 sites that name an Ast
; constructor, in a compiler that then has to go on compiling itself. See
; the span table in runtime/actor_runtime.c for why keying on the node's
; own address is sound here.
(defn ast-at (fid off node)
  (let _ (ffi-call "zyl_span_set" node off fid 1000)
    node))

; Read one form at the head of `toks`.
; Returns: AstTok
(defn read-form (arena toks fid)
  (let t (toks-head toks)
    (let rest (toks-tail toks)
      (read-dispatch arena t rest fid))))

(defn read-dispatch (arena t rest fid)
  (match t
        (TkLParen o (read-forms arena rest (no-forms) fid o))
        (TkLBracket o (read-forms-bracket arena rest (no-forms) fid o))
        (TkLBrace o (read-forms-brace arena rest (no-forms) fid o))
        (TkRParen _ (read-form-atom arena t rest fid))
        (TkRBrace _ (read-form-atom arena t rest fid))
        (TkRBracket _ (read-form-atom arena t rest fid))
        (TkColon _ (read-form-atom arena t rest fid))
        (TkEof _ (read-form-atom arena t rest fid))
        (TkInt _ _ (read-form-atom arena t rest fid))
        (TkFloat _ _ (read-form-atom arena t rest fid))
        (TkString _ _ (read-form-atom arena t rest fid))
        (TkBool _ _ (read-form-atom arena t rest fid))
        (TkIdent _ _ (read-form-atom arena t rest fid))
        (TkSymbol _ _ (read-form-atom arena t rest fid))
        (TkKeyword _ _ (read-form-atom arena t rest fid))))

; Atoms and terminators: everything except openers.
; Returns: AstTok
(defn read-form-atom (_arena t rest fid)
  (match t
    (TkInt v o (AstOf (ast-at fid o (AstInt v)) rest))
    (TkBool b o (AstOf (ast-at fid o (AstBool b)) rest))
    (TkFloat s o (AstOf (ast-at fid o (AstFloat s)) rest))
    (TkString s o (AstOf (ast-at fid o (AString s)) rest))
    (TkIdent s o (AstOf (ast-at fid o (AstIdent s)) rest))
    (TkSymbol s o (AstOf (ast-at fid o (AstIdent s)) rest))
    ; A keyword keeps its ':' so a consumer can tell `(use pkg:mod)` from
    ; `(use pkg mod)`: the lexer discards whitespace, so the two differ
    ; only in this token's kind, and §24.2 gives the colon form its own
    ; meaning (package:module). Consumers of `:le`/`:be` strip it.
    (TkKeyword s o (AstOf (ast-at fid o (AstIdent (str-concat ":" s))) rest))
    ; closers / colon / eof in atom position: empty form
    (TkEof o (AstOf (ast-at fid o (AList Nil)) rest))
    (TkLParen o (AstOf (ast-at fid o (AList (no-forms))) rest))
    (TkRParen o (AstOf (ast-at fid o (AList (no-forms))) rest))
    (TkLBrace o (AstOf (ast-at fid o (AList (no-forms))) rest))
    (TkRBrace o (AstOf (ast-at fid o (AList (no-forms))) rest))
    (TkLBracket o (AstOf (ast-at fid o (AList (no-forms))) rest))
    (TkRBracket o (AstOf (ast-at fid o (AList (no-forms))) rest))
    (TkColon o (AstOf (ast-at fid o (AList (no-forms))) rest))))

; Read forms until ')' (or EOF), accumulating into `acc` (reverse order).
; Returns: AstTok wrapping (AList forms...)
(defn read-forms (arena toks acc fid off)
  (if (toks-empty toks)
    (AstOf (ast-at fid off (AList (list-reverse acc))) toks)
    (let t (toks-head toks)
      (if (= (tok-is-rparen t) 1)
        (AstOf (ast-at fid off (AList (list-reverse acc))) (toks-tail toks))
        (let r (read-form arena toks fid)
          (read-forms arena (art-rest r) (Cons (art-ast r) acc) fid off))))))

(defn tok-is-rparen (t)
  (match t
    (TkRParen _ true)
    (TkEof _ false)
    (TkIdent _ _ false)
    (TkInt _ _ false)
    (TkFloat _ _ false)
    (TkString _ _ false)
    (TkBool _ _ false)
    (TkSymbol _ _ false)
    (TkKeyword _ _ false)
    (TkLParen _ false)
    (TkLBrace _ false)
    (TkRBrace _ false)
    (TkLBracket _ false)
    (TkRBracket _ false)
    (TkColon _ false)))

; Read forms until '}' (or EOF).
; Returns: AstTok wrapping (AList forms...)
(defn read-forms-brace (arena toks acc fid off)
  (if (toks-empty toks)
    (AstOf (ast-at fid off (AList (list-reverse acc))) toks)
    (let t (toks-head toks)
      (if (= (tok-is-rbrace t) 1)
        (AstOf (ast-at fid off (AList (list-reverse acc))) (toks-tail toks))
        (let r (read-form arena toks fid)
          (read-forms-brace arena (art-rest r) (Cons (art-ast r) acc) fid off))))))

(defn tok-is-rbrace (t)
  (match t
    (TkRBrace _ true)
    (TkEof _ false)
    (TkIdent _ _ false)
    (TkInt _ _ false)
    (TkFloat _ _ false)
    (TkString _ _ false)
    (TkBool _ _ false)
    (TkSymbol _ _ false)
    (TkKeyword _ _ false)
    (TkLParen _ false)
    (TkRParen _ false)
    (TkLBrace _ false)
    (TkLBracket _ false)
    (TkRBracket _ false)
    (TkColon _ false)))

; Read forms until ']' (or EOF).
; Returns: AstTok wrapping (AList forms...)
(defn read-forms-bracket (arena toks acc fid off)
  (if (toks-empty toks)
    (AstOf (ast-at fid off (AList (list-reverse acc))) toks)
    (let t (toks-head toks)
      (if (= (tok-is-rbracket t) 1)
        (AstOf (ast-at fid off (AList (list-reverse acc))) (toks-tail toks))
        (let r (read-form arena toks fid)
          (read-forms-bracket arena (art-rest r) (Cons (art-ast r) acc) fid off))))))

(defn tok-is-rbracket (t)
  (match t
    (TkRBracket _ true)
    (TkEof _ false)
    (TkIdent _ _ false)
    (TkInt _ _ false)
    (TkFloat _ _ false)
    (TkString _ _ false)
    (TkBool _ _ false)
    (TkSymbol _ _ false)
    (TkKeyword _ _ false)
    (TkLParen _ false)
    (TkRParen _ false)
    (TkLBrace _ false)
    (TkRBrace _ false)
    (TkLBracket _ false)
    (TkColon _ false)))

; Parse a whole source token stream into a program: a List of top-level
; Ast forms in source order.
; Returns: List(Ast)
(defn parse-program (arena toks fid)
  (list-reverse (parse-program-loop arena toks (no-forms) fid)))

(defn parse-program-loop (arena toks acc fid)
  (if (toks-empty toks)
    acc
    (let r (read-form arena toks fid)
      (parse-program-loop arena (art-rest r) (Cons (art-ast r) acc) fid))))

; Whole-source structural balance check, delegated to the native
; sexp_balance scanner (string/comment-aware, stack-based over bracket
; TYPE, not just a net count). The reader consumes to EOF on an unclosed
; form, so imbalance must be caught before parsing ever starts. This
; replaces the old bal-walk depth counter, which only ever compared total
; '(' vs ')' counts -- ")(" and "(]" both netted to a valid count and
; passed straight through to the reader.
(defn check-balanced (src fid)
  (let result (sb-check-string src)
    (if (= (sb-result-balanced result) 1)
      0
      (report-unbalanced result fid))))

; Every str-concat argument below is a literal or a pre-bound `let` --
; see error_report.zyl's header comment: an inline call operand in a
; str-concat argument miscompiles under the Rust bootstrap's inlining,
; and this file is compiled by that bootstrap on the way to stage1.
(defn bal-msg (code msg hint)
  (let h (err-header code msg)
    (let n1 (str-concat h "\n  = help: ")
      (str-concat n1 hint))))

(defn bal-msg-loc (code msg line col hint)
  (let h (err-header code msg)
    (let ls (int-to-str line)
      (let cs (int-to-str col)
        (let loc1 (str-concat ls ":")
          (let loc2 (str-concat loc1 cs)
            (let arrow (str-concat "\n  --> line " loc2)
              (let n1 (str-concat h arrow)
                (let n2 (str-concat n1 "\n  = help: ")
                  (str-concat n2 hint))))))))))

; All 5 BalanceResult variants enumerated; Balanced is unreachable here
; (check-balanced already short-circuits on it) but match must stay
; exhaustive.
(defn report-unbalanced (result fid)
  (match result
    (Balanced 0)
    (UnbalancedOpenString
      (let msg (err-at "E_UNTERMINATED_STRING" "unterminated string literal reached end of input" fid -1 (sb-hint result))
        (ffi-call "zyl_panic" msg 1000)))
    (UnclosedOpen closer line col
      (report-bal "E_UNBALANCED_UNCLOSED" "unclosed opener never reached its matching closer" result fid line col))
    (UnbalancedClose closer line col
      (report-bal "E_UNBALANCED_UNEXPECTED_CLOSE" "unexpected closing delimiter" result fid line col))
    (MismatchedPair opener closer line col
      (report-bal "E_UNBALANCED_MISMATCHED_BRACKET" "closing delimiter does not match its opener" result fid line col))))

; sexp_balance tracks line/col directly (it scans the raw bytes itself), so
; convert back to the byte offset err-at renders from.
(defn report-bal (code text result fid line col)
  (let off (ffi-call "zyl_span_offset_at" fid line col 1000)
    (let msg (err-at code text fid off (sb-hint result))
      (ffi-call "zyl_panic" msg 1000))))

; Convenience: lex + parse in one step from a source buffer pointer.
; Returns: List(Ast)
(defn zyl-parse (arena src)
  (zyl-parse-file arena src "<input>"))

; `path` is what a diagnostic prints and what the span table keys this
; file's text by, so a multi-module build points at the right file.
(defn zyl-parse-file (arena src path)
  (let fid (ffi-call "zyl_source_register" path src 1000)
    (begin
      (check-balanced src fid)
      (let toks (zyl-lex arena src)
        (parse-program arena toks fid)))))
