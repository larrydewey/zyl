; === Zyl Standard Library — Compiler Parser (reader) ===
; Module: compiler/parser
;
; A pure recursive-descent reader over a (List Token) stream, producing
; nested Ast values (see compiler/ast). Deliberately *dispatch-free*
; (spec architecture decision): every parenthesised form becomes an
; (AList ...); special forms (defn, let, if, ...) are recognised by the
; consumer phases, never by the parser.
;
; read-* functions return an AstTok: the parsed form plus the remaining
; token stream (functional threading, no mutable state).
;
; Every decision is a structural `match` on Token/Ast variants with ALL
; constructors enumerated (Zyl matches are exhaustive and have no
; wildcard catch-all). There are no numeric kind codes and no projection
; accessors.

(use allocator/allocator)
(use compiler/ast)
(use compiler/sexp_balance)
(use compiler/error_codes)
(use compiler/error_report)

; Result wrapper: parsed Ast + remaining tokens.
(deftype AstTok (AstOf Ast (List Token)))

; Empty form list (typed so `Nil` never unifies as Option).
(defn no-forms () Nil)

(defn art-ast (r)
  (match r
    (AstOf a d1 a)))

(defn art-rest (r)
  (match r
    (AstOf d2 rest rest)))

; ===========================================================================
; STREAM HELPERS
; ===========================================================================

; True only for the stream terminator token.
(defn tok-is-eof (t)
  (match t
    (TkEof true)
    (TkIdent d3 false)
    (TkInt d4 false)
    (TkFloat d5 false)
    (TkString d6 false)
    (TkBool d7 false)
    (TkSymbol d8 false)
    (TkKeyword d9 false)
    (TkLParen false)
    (TkRParen false)
    (TkLBrace false)
    (TkRBrace false)
    (TkLBracket false)
    (TkRBracket false)
    (TkColon false)))

; True when the stream is exhausted (empty or at TkEof).
; Returns: Bool
(defn toks-empty (toks)
  (match toks
    (Cons t d10 (tok-is-eof t))
    (Nil true)))

; ===========================================================================
; READER
; ===========================================================================

; Read one form at the head of `toks`.
; Returns: AstTok
(defn read-form (arena toks)
  (let t (toks-head toks)
    (let rest (toks-tail toks)
      (read-dispatch arena t rest))))

(defn read-dispatch (arena t rest)
  (match t
        (TkLParen (read-forms arena rest (no-forms)))
        (TkLBracket (read-forms-bracket arena rest (no-forms)))
        (TkLBrace (read-forms-brace arena rest (no-forms)))
        (TkRParen (read-form-atom arena t rest))
        (TkRBrace (read-form-atom arena t rest))
        (TkRBracket (read-form-atom arena t rest))
        (TkColon (read-form-atom arena t rest))
        (TkEof (read-form-atom arena t rest))
        (TkInt d11 (read-form-atom arena t rest))
        (TkFloat d12 (read-form-atom arena t rest))
        (TkString d13 (read-form-atom arena t rest))
        (TkBool d14 (read-form-atom arena t rest))
        (TkIdent d15 (read-form-atom arena t rest))
        (TkSymbol d16 (read-form-atom arena t rest))
        (TkKeyword d17 (read-form-atom arena t rest))))

; Atoms and terminators: everything except openers.
; Returns: AstTok
(defn read-form-atom (arena t rest)
  (match t
    (TkInt v (AstOf (AstInt v) rest))
    (TkBool b (AstOf (AstBool b) rest))
    (TkFloat s (AstOf (AstFloat s) rest))
    (TkString s (AstOf (AString s) rest))
    (TkIdent s (AstOf (AstIdent s) rest))
    (TkSymbol s (AstOf (AstIdent s) rest))
    (TkKeyword s (AstOf (AstIdent s) rest))
    ; closers / colon / eof in atom position: empty form
    (TkEof (AstOf (AList Nil) rest))
    (TkLParen (AstOf (AList (no-forms)) rest))
    (TkRParen (AstOf (AList (no-forms)) rest))
    (TkLBrace (AstOf (AList (no-forms)) rest))
    (TkRBrace (AstOf (AList (no-forms)) rest))
    (TkLBracket (AstOf (AList (no-forms)) rest))
    (TkRBracket (AstOf (AList (no-forms)) rest))
    (TkColon (AstOf (AList (no-forms)) rest))))

; Read forms until ')' (or EOF), accumulating into `acc` (reverse order).
; Returns: AstTok wrapping (AList forms...)
(defn read-forms (arena toks acc)
  (if (toks-empty toks)
    (AstOf (AList (list-reverse acc)) toks)
    (let t (toks-head toks)
      (if (= (tok-is-rparen t) 1)
        (AstOf (AList (list-reverse acc)) (toks-tail toks))
        (let r (read-form arena toks)
          (read-forms arena (art-rest r) (Cons (art-ast r) acc)))))))

(defn tok-is-rparen (t)
  (match t
    (TkRParen true)
    (TkEof false)
    (TkIdent d18 false)
    (TkInt d19 false)
    (TkFloat d20 false)
    (TkString d21 false)
    (TkBool d22 false)
    (TkSymbol d23 false)
    (TkKeyword d24 false)
    (TkLParen false)
    (TkLBrace false)
    (TkRBrace false)
    (TkLBracket false)
    (TkRBracket false)
    (TkColon false)))

; Read forms until '}' (or EOF).
; Returns: AstTok wrapping (AList forms...)
(defn read-forms-brace (arena toks acc)
  (if (toks-empty toks)
    (AstOf (AList (list-reverse acc)) toks)
    (let t (toks-head toks)
      (if (= (tok-is-rbrace t) 1)
        (AstOf (AList (list-reverse acc)) (toks-tail toks))
        (let r (read-form arena toks)
          (read-forms-brace arena (art-rest r) (Cons (art-ast r) acc)))))))

(defn tok-is-rbrace (t)
  (match t
    (TkRBrace true)
    (TkEof false)
    (TkIdent d25 false)
    (TkInt d26 false)
    (TkFloat d27 false)
    (TkString d28 false)
    (TkBool d29 false)
    (TkSymbol d30 false)
    (TkKeyword d31 false)
    (TkLParen false)
    (TkRParen false)
    (TkLBrace false)
    (TkLBracket false)
    (TkRBracket false)
    (TkColon false)))

; Read forms until ']' (or EOF).
; Returns: AstTok wrapping (AList forms...)
(defn read-forms-bracket (arena toks acc)
  (if (toks-empty toks)
    (AstOf (AList (list-reverse acc)) toks)
    (let t (toks-head toks)
      (if (= (tok-is-rbracket t) 1)
        (AstOf (AList (list-reverse acc)) (toks-tail toks))
        (let r (read-form arena toks)
          (read-forms-bracket arena (art-rest r) (Cons (art-ast r) acc)))))))

(defn tok-is-rbracket (t)
  (match t
    (TkRBracket true)
    (TkEof false)
    (TkIdent d32 false)
    (TkInt d33 false)
    (TkFloat d34 false)
    (TkString d35 false)
    (TkBool d36 false)
    (TkSymbol d37 false)
    (TkKeyword d38 false)
    (TkLParen false)
    (TkRParen false)
    (TkLBrace false)
    (TkRBrace false)
    (TkLBracket false)
    (TkColon false)))

; Parse a whole source token stream into a program: a List of top-level
; Ast forms in source order.
; Returns: List(Ast)
(defn parse-program (arena toks)
  (list-reverse (parse-program-loop arena toks (no-forms))))

(defn parse-program-loop (arena toks acc)
  (if (toks-empty toks)
    acc
    (let r (read-form arena toks)
      (parse-program-loop arena (art-rest r) (Cons (art-ast r) acc)))))

; Whole-source structural balance check, delegated to the native
; sexp_balance scanner (string/comment-aware, stack-based over bracket
; TYPE, not just a net count). The reader consumes to EOF on an unclosed
; form, so imbalance must be caught before parsing ever starts. This
; replaces the old bal-walk depth counter, which only ever compared total
; '(' vs ')' counts -- ")(" and "(]" both netted to a valid count and
; passed straight through to the reader.
(defn check-balanced (src)
  (let result (sb-check-string src)
    (if (= (sb-result-balanced result) 1)
      0
      (report-unbalanced result))))

; Every str-concat argument below is a literal or a pre-bound `let` --
; see error_report.zyl's header comment: an inline call operand in a
; str-concat argument miscompiles under the Rust bootstrap's inlining,
; and this file is compiled by that bootstrap on the way to stage1.
(defn bal-msg (code msg hint)
  (let h (err-header code msg)
    (let n1 (str-concat h "\n  = help: ")
      (str-concat n1 hint))))

(defn bal-msg-loc (code msg line col hint)
  (let h (err-header code msg)
    (let ls (int-to-str line)
      (let cs (int-to-str col)
        (let loc1 (str-concat ls ":")
          (let loc2 (str-concat loc1 cs)
            (let arrow (str-concat "\n  --> line " loc2)
              (let n1 (str-concat h arrow)
                (let n2 (str-concat n1 "\n  = help: ")
                  (str-concat n2 hint))))))))))

; All 5 BalanceResult variants enumerated; Balanced is unreachable here
; (check-balanced already short-circuits on it) but match must stay
; exhaustive.
(defn report-unbalanced (result)
  (match result
    (Balanced 0)
    (UnbalancedOpenString
      (let msg (bal-msg "E_UNTERMINATED_STRING" "unterminated string literal reached end of input" (sb-hint result))
        (ffi-call "zyl_panic" msg 1000)))
    (UnclosedOpen closer line col
      (let msg (bal-msg-loc "E_UNBALANCED_UNCLOSED" "unclosed opener never reached its matching closer" line col (sb-hint result))
        (ffi-call "zyl_panic" msg 1000)))
    (UnbalancedClose closer line col
      (let msg (bal-msg-loc "E_UNBALANCED_UNEXPECTED_CLOSE" "unexpected closing delimiter" line col (sb-hint result))
        (ffi-call "zyl_panic" msg 1000)))
    (MismatchedPair opener closer line col
      (let msg (bal-msg-loc "E_UNBALANCED_MISMATCHED_BRACKET" "closing delimiter does not match its opener" line col (sb-hint result))
        (ffi-call "zyl_panic" msg 1000)))))

; Convenience: lex + parse in one step from a source buffer pointer.
; Returns: List(Ast)
(defn zyl-parse (arena src)
  (begin
    (check-balanced src)
    (let toks (zyl-lex arena src)
      (parse-program arena toks))))
