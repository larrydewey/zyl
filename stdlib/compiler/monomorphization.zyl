(deftype MonoKV (MK String A))

(deftype MonoCtx (MC
  (MCGenFns (List (MonoKV (List MonoParam))))       ; name → [MonoParam]
  (MCKnownFns (List (MonoKV (List (MonoKV Type))))) ; name → [(param, Type)]
  (MCReturns (List (MonoKV Type)))                   ; name → ret Type
  (MCKTypes (List (MonoKV Type)))                    ; name → Type
  (MCStructs (List (MonoKV (List (MonoKV Type)))))   ; name → [(field, Type)]
  (MCAdtDefs (List (MonoKV (List (MonoKV (List String)))))) ; name → [(variant, [fields])]
  (MCAdtInsts (List (MonoKV (List AdtInstantiation))))   ; name → [AdtInstantiation]
  (MCTImpls (List (MonoKV (List Type))))))             ; trait → [impl_type]

(deftype MonoParam (MP String (List String)))
(defn MP.name (p) (match p (MP n d1 n)))
(defn MP.bounds (p) (match p (MP d1 b b)))
(deftype MonoInstance (MI String Expr (List MonoParam)))

(defn MI.body (mono) (match mono (MI d1 b d2 b)))
(deftype AdtInstantiation (AI (List String) (List Type)))

; ===========================================================================
; Field accessors
; ===========================================================================

(defn mc-gen-fns (ctx) (match ctx (MC g d1 d2 d3 d4 d5 d6 d7 g)))
(defn mc-known-fns (ctx) (match ctx (MC d1 f d2 d3 d4 d5 d6 d7 f)))
(defn mc-returns (ctx) (match ctx (MC d1 d2 r d3 d4 d5 d6 d7 r)))
(defn mc-ktypes (ctx) (match ctx (MC d1 d2 d3 kt d4 d5 d6 d7 kt)))
(defn mc-structs (ctx) (match ctx (MC d1 d2 d3 d4 sd d5 d6 d7 sd)))
(defn mc-adt-defs (ctx) (match ctx (MC d1 d2 d3 d4 d5 adt d6 d7 adt)))
(defn mc-adt-insts (ctx) (match ctx (MC d1 d2 d3 d4 d5 d6 ai d7 ai)))
(defn mc-timpls (ctx) (match ctx (MC d1 d2 d3 d4 d5 d6 d7 ti ti)))

; ===========================================================================
; Helpers — list ops (no stdlib)
; ===========================================================================

(defn list-contains (lst x)
  (match lst
    (Nil false)
    (Cons h t (if (= h x) true (list-contains t x)))))

(defn list-first (lst)
  (match lst
    (Cons h d1 h)
    (d1 nil)))

(defn list-last (lst)
  ; match on `t` instead of `(if (= t Nil) h (list-last t))` — `=` on a
  ; match-arm-bound variable vs. a bare zero-field constructor reference
  ; isn't recognized as a variant comparison by codegen's node_looks_variant
  ; heuristic (arm-bound pattern vars have no Assign node to trace), so it
  ; fell back to raw pointer/integer equality: two separately-allocated Nil
  ; values never compare equal, so this always recursed one call too far
  ; and returned the `nil` fallback instead of the real last element.
  (match lst
    (Cons h t
      (match t
        (Nil h)
        (d2 (list-last t))))
    (d1 nil)))

(defn list-nth (lst i)
  (match lst
    (Nil (list-nth-oob))
    (Cons h t
      (if (= i 0) h (list-nth t (- i 1))))))

; Out-of-bounds list-nth is always a caller bug (indices here are supposed
; to be pre-validated against list-length) — fail loudly instead of
; silently returning an unresolved-identifier sentinel (which the codegen
; would otherwise materialize as a bare 0, corrupting whatever type the
; caller expected back).
(defn list-nth-oob ()
  (ffi-call "f_error" "E_LIST_NTH_OOB: list-nth called with an out-of-range index" 1000))

(defn list-push (lst x)
  (Cons x lst))

; `for` is C-style (init cond body) in this language — it has no foreach/map
; form. list-map/list-map-indexed/list-each stand in for that everywhere
; this module would otherwise want `(for (x lst) body)`.

(defn list-map (f lst)
  (match lst
    (Nil Nil)
    ((Cons h t) (Cons (f h) (list-map f t)))))

(defn list-map-indexed-loop (f lst i)
  (match lst
    (Nil Nil)
    ((Cons h t) (Cons (f i h) (list-map-indexed-loop f t (+ i 1))))))

(defn list-map-indexed (f lst)
  (list-map-indexed-loop f lst 0))

(defn list-each (f lst)
  (match lst
    (Nil nil)
    ((Cons h t) (let d1 (f h) (list-each f t)))))

; ===========================================================================
; KV helpers — List (MonoKV K V)
; ===========================================================================

(defn kv-get (binds key default)
  (match binds
    (Nil default)
    ((MK k v) rest
      (if (= k key) v (kv-get rest key default)))))

(defn kv-set (binds key val)
  (match binds
    (Nil (Cons (MK key val) Nil))
    ((MK k v) rest
      (if (= k key)
        (Cons (MK key val) rest)
        (Cons (MK k v) (kv-set rest key val))))))

(defn kv-contains (binds key)
  (match binds
    (Nil false)
    ((MK k d1) rest
      (if (= k key) true (kv-contains rest key)))))

; ===========================================================================
; String helpers
; ===========================================================================

(defn str-contains-loop (s sub sl ll i)
  (if (> (+ i ll) sl)
    false
    (if (= (str-substring s i ll) sub)
      true
      (str-contains-loop s sub sl ll (+ i 1)))))

(defn str-contains (s sub)
  (let sl (str-length s)
    (let ll (str-length sub)
      (if (<= ll sl)
        (str-contains-loop s sub sl ll 0)
        false))))

(defn str-starts-with (s prefix)
  (let lp (str-length prefix)
    (if (<= lp (str-length s))
      (= (str-substring s 0 lp) prefix)
      false)))

(defn str-drop (s n)
  (if (<= n (str-length s)) (str-substring s n (str-length s)) ""))

(defn str-join (lst sep)
  (match lst
    (Nil "")
    ((Cons h Nil) h)
    ((Cons h t) (str-concat h (str-concat sep (str-join t sep))))))

(defn str-sort (lst)
  (match lst
    (Nil Nil)
    ((Cons h Nil) (Cons h Nil))
    ((Cons h t)
      (let sorted (str-sort t)
        (str-insert h sorted)))))

(defn str-insert (x lst)
  (match lst
    (Nil (Cons x Nil))
    ((Cons h t)
      (if (<= x h)
        (Cons x (Cons h t))
        (Cons h (str-insert x t))))))

(defn str-dedup (lst)
  (match lst
    (Nil Nil)
    ((Cons h t)
      (if (list-contains t h)
        (str-dedup t)
        (Cons h (str-dedup t))))))

; ===========================================================================
; Type helpers
; ===========================================================================

(defn param-type-from-str (s)
  (if (= s "Int") TInt
    (if (= s "Float") TFloat
      (if (= s "Bool") TBool
        (if (= s "String") TString
          (if (= s "Unit") TUnit
            (TVar 0 TUnit)))))))

(defn is-uppercase-ident (name)
  (if (= (str-length name) 0)
    false
    (str-contains "ABCDEFGHIJKLMNOPQRSTUVWXYZ" (str-substring name 0 1))))

; ===========================================================================
; Lookup helpers
; ===========================================================================

(defn lookup-fn-sigs (ctx name)
  (kv-get (mc-known-fns ctx) name Nil))

; Renamed from `lookup-known-type` — that name collided with an unrelated
; function of the same name in type_inference.zyl (both bundled together),
; producing a duplicate assembly symbol at link time. This one is unused
; (mc-ktypes is never populated by anything in this file).
(defn mono-lookup-known-type (ctx name)
  (kv-get (mc-ktypes ctx) name (TVar 0 TUnit)))

; ===========================================================================
; find-satisfying-types
; ===========================================================================

(defn filter-non-tvar (lst)
  (match lst
    (Nil Nil)
    ((Cons h t)
      (if (= h (TVar 0 TUnit))
        (filter-non-tvar t)
        (Cons h (filter-non-tvar t))))))

(defn add-builtin-numeric-types (result)
  (let r1 (if (list-contains result TInt) result (list-push result TInt))
    (let r2 (if (list-contains r1 TFloat) r1 (list-push r1 TFloat))
      (if (list-contains r2 TBool) r2 (list-push r2 TBool)))))

(defn is-auto-derived-trait (trait-name)
  (or (= trait-name "Eq")
    (or (= trait-name "Ord")
      (or (= trait-name "Debug")
        (or (= trait-name "Clone") (= trait-name "Hash"))))))

(defn find-satisfying-types (ctx trait-name)
  (let impls (kv-get (mc-timpls ctx) trait-name Nil)
    (let result (filter-non-tvar impls)
      (if (is-auto-derived-trait trait-name)
        (add-builtin-numeric-types result)
        result))))

; ===========================================================================
; check-trait-bound
; ===========================================================================

(defn check-trait-bound (ctx ty trait-name)
  (if (or (= ty TInt) (= ty TFloat) (= ty TBool) (= ty TString))
    true
    (let impls (kv-get (mc-timpls ctx) trait-name Nil)
      (list-contains impls ty))))

; ===========================================================================
; discover-from-ast — find generic function definitions
; ===========================================================================

(defn extract-mono-params (params)
  (match params
    (Nil Nil)
    (Cons p rest
      (let pname (match p (P n d1 n))
        (let pbounds (match (P.type p) (Some v (Cons v Nil)) (d1 Nil))
          (if (is-uppercase-ident pname)
            (Cons (MP pname pbounds) (extract-mono-params rest))
            (extract-mono-params rest)))))))

(defn ast-ident-name (a)
  ; explicit two-level match, not the `(EAtom (AIdent n2) ...)` nested-
  ; pattern sugar — that sugar desugars into a synthetic-var wrapper match
  ; whose inner binding can lose its stack slot entirely (see
  ; inferer-bind-pattern-vars-atom in type_inference.zyl for the confirmed
  ; case: "MakeVariant field load ... has no local slot").
  (match a
    (EAtom atom
      (match atom
        (AIdent n2 (Some n2))
        (d2 Nil)))
    (d1 Nil)))

(defn ast-apply-args (a)
  (match a
    (EApply d2 ps ps)
    (ECall d3 ps ps)
    (d1 Nil)))

(defn discover-mono-param (i p)
  (let pn (match (ast-ident-name p) (Some v v) (d1 (str-concat "T" (string i))))
    (MP pn Nil)))

(defn discover-from-ast-one (gen-fns expr)
  (match (Expr.inner expr)
    (EDefn name params body
      (let mp (extract-mono-params params)
        (if (> (list-length mp) 0)
          (kv-set gen-fns name (list-push (kv-get gen-fns name Nil) (list-first mp)))
          gen-fns)))
    (EApply "defn" args
      (if (> (list-length args) 2)
        (let n (match (ast-ident-name (list-nth args 0)) (Some v v) (d1 nil))
          (let pexprs (ast-apply-args (list-nth args 1))
            (let mp (list-map-indexed discover-mono-param pexprs)
              (if (and n (> (list-length mp) 0))
                (kv-set gen-fns n (list-push (kv-get gen-fns n Nil) (list-first mp)))
                gen-fns))))
        gen-fns))
    (d1 gen-fns)))

(defn discover-from-ast-loop (gen-fns exprs)
  (match exprs
    (Nil gen-fns)
    (Cons expr rest
      (discover-from-ast-loop (discover-from-ast-one gen-fns expr) rest))))

(defn discover-from-ast (ctx exprs)
  (let gen-fns (discover-from-ast-loop (mc-gen-fns ctx) exprs)
    (MC gen-fns (mc-known-fns ctx) (mc-returns ctx) (mc-ktypes ctx) (mc-structs ctx) (mc-adt-defs ctx) (mc-adt-insts ctx) (mc-timpls ctx))))

; ===========================================================================
; infer-arg-type — infer concrete type from expression structure
; ===========================================================================

(defn infer-arg-type (ctx expr)
  (match (Expr.inner expr)
    (EAtom atom (infer-arg-type-atom ctx atom))
    (d100 (infer-arg-type-rest ctx expr))))

; Split out of infer-arg-type: a single EAtom arm with a real nested match,
; not five separate top-level `(EAtom (Variant ...) ...)` arms — those all
; share the SAME outer discriminant (EAtom), so only the first is ever
; reachable at dispatch time; the rest silently fall into its desugared
; nested match's "unreachable case" arms (this is what crashed the self-
; hosted compiler's own monomorphization pass on any non-AInt atom).
(defn infer-arg-type-atom (ctx atom)
  (match atom
    (AInt d4 TInt)
    (AFloat d6 TFloat)
    (ABool d8 TBool)
    (AStr d10 TString)
    (AIdent name
      (cond
        ((kv-contains (mc-ktypes ctx) name) (kv-get (mc-ktypes ctx) name (TVar 0 TUnit)))
        ((is-uppercase-ident name) (TVar 0 TUnit))
        ((is-generic-param name) (TVar 0 TUnit))
        (else (TNominal name))))
    (d101 (TVar 0 TUnit))))

(defn infer-arg-type-rest (ctx expr)
  (match (Expr.inner expr)
    (EApply fname args
      (cond
        ((kv-contains (mc-returns ctx) fname)
          (let ret (kv-get (mc-returns ctx) fname (TVar 0 TUnit))
            (if (= ret (TVar 0 TUnit))
              (if (str-starts-with fname "make-") (TNominal (str-drop fname 5)) ret)
              ret)))
        ((= fname "vec")
          (if (> (list-length args) 0) (infer-arg-type ctx (list-nth args 0)) (TVar 0 TUnit)))
        ((kv-contains (mc-known-fns ctx) fname)
          (let sigs (kv-get (mc-known-fns ctx) fname Nil)
            (if (>= (list-length sigs) (list-length args))
              (infer-arg-type ctx (list-nth args 0))
              (TVar 0 TUnit))))
        (else (TNominal fname))))
    (ECall op args
      (let op-name (match (ast-ident-name (Expr.inner op)) (Some n n) (d1 nil))
        (cond
          ((or (= op-name "+") (= op-name "-") (= op-name "*") (= op-name "/"))
            (if (> (list-length args) 0) (infer-arg-type ctx (list-nth args 0)) TInt))
          ((or (= op-name "==") (= op-name "!=") (= op-name "<") (= op-name ">") (= op-name "<=") (= op-name ">="))
            TBool)
          ((kv-contains (mc-returns ctx) op-name)
            (let ret (kv-get (mc-returns ctx) op-name (TVar 0 TUnit))
              (if (= ret (TVar 0 TUnit))
                (if (str-starts-with op-name "make-") (TNominal (str-drop op-name 5)) ret)
                ret)))
          ((str-starts-with op-name "make-") (TNominal (str-drop op-name 5)))
          (else (if (> (list-length args) 0) (infer-arg-type ctx (list-nth args 0)) (TVar 0 TUnit))))))
    (EIf d12 then_ else_
      (let tt (infer-arg-type ctx then_)
        (if (is-skip-placeholder else_)
          tt
          (let et (infer-arg-type ctx else_)
            (if (= (type-to-string tt) (type-to-string et)) tt (TVar 0 TUnit))))))
    (ELet d13 val d14 (infer-arg-type ctx val))
    (EBegin exprs
      (if (> (list-length exprs) 0) (infer-arg-type ctx (list-last exprs)) TUnit))
    (EMakeStruct name d15 (TNominal name))
    (EMakeVariant adt_name d16 d17 (TNominal adt_name))
    (d1 (TVar 0 TUnit))))

; ===========================================================================
; unify-types — simplified compatibility check
; ===========================================================================

(defn unify-types (t1 t2)
  (cond
    ((= t1 t2) true)
    ((= t1 (TVar 0 TUnit)) true)
    ((= t2 (TVar 0 TUnit)) true)
    ((= t1 (TCap (TVar 0 TUnit))) true)
    ((= t2 (TCap (TVar 0 TUnit))) true)
    ((= t1 TInt) (= t2 TFloat))
    ((= t1 TFloat) (= t2 TInt))
    (else false)))

; ===========================================================================
; resolve-call-site — determine canonical name for a generic call
; ===========================================================================

(defn kv-type-names (type-map keys)
  (match keys
    (Nil Nil)
    (Cons k rest (Cons (type-to-string (kv-get type-map k (TVar 0 TUnit))) (kv-type-names type-map rest)))))

(defn canonical-name-from-type-map (base-name type-map)
  (let sorted-keys (str-sort (kv-keys type-map))
    (let unique-sorted (str-sort (str-dedup (kv-type-names type-map sorted-keys)))
      (str-concat base-name (str-concat "_" (str-join unique-sorted "_"))))))

(defn resolve-call-site-collect (ctx known args i)
  (match args
    (Nil Nil)
    (Cons arg rest
      (let tail (resolve-call-site-collect ctx known rest (+ i 1))
        (if (< i (list-length known))
          (match (list-nth known i)
            (MK pname expected
              (if (is-uppercase-ident pname)
                (kv-set tail pname (infer-arg-type ctx arg))
                tail)))
          tail)))))

(defn resolve-call-site (ctx fname generics args)
  (if (= (list-length generics) 0)
    None
    (let known (lookup-fn-sigs ctx fname)
      (let type-map (resolve-call-site-collect ctx known args 0)
        (if (= (list-length type-map) 0)
          None
          (Some (canonical-name-from-type-map fname type-map)))))))

; ===========================================================================
; generate-instantiations — create monomorphized function copies
; ===========================================================================

; Simplified: rather than enumerating every combination of bound-satisfying
; types across generic params (the original's abandoned per-arg search),
; pick the first type satisfying each bound and build ONE instantiation
; from it. Good enough for a single concrete instantiation per generic
; function; multiple call-site-specific instantiations are still handled
; by resolve-call-site's own type-map for the ECall/EApply substitution.
(defn collect-instantiations-bounds (ctx generics)
  (match generics
    (Nil Nil)
    (Cons g rest
      (let tail (collect-instantiations-bounds ctx rest)
        (match (MP.bounds g)
          (Nil tail)
          (Cons bound d18
            (match (find-satisfying-types ctx bound)
              (Nil tail)
              (Cons t d19 (Cons (Pair (MP.name g) t) tail)))))))))

(defn pairs-to-kv (pairs)
  (match pairs
    (Nil Nil)
    (Cons pr rest
      (match pr
        (Pair k v (kv-set (pairs-to-kv rest) k v))))))

(defn collect-instantiations (ctx name generics)
  (let pairs (collect-instantiations-bounds ctx generics)
    (if (= (list-length pairs) 0)
      Nil
      (Cons (pairs-to-kv pairs) Nil))))

(defn build-instance-param (p type-map)
  (if (is-uppercase-ident (P.name p))
    (if (kv-contains type-map (P.name p))
      (MP (P.name p) (Cons (type-to-string (kv-get type-map (P.name p) (TVar 0 TUnit))) Nil))
      (MP (P.name p) (match (P.type p) (Some v (Cons v Nil)) (d1 Nil))))
    (MP (P.name p) (match (P.type p) (Some v (Cons v Nil)) (d1 Nil)))))

(defn build-instance-params (params type-map)
  (match params
    (Nil Nil)
    (Cons p rest (Cons (build-instance-param p type-map) (build-instance-params rest type-map)))))

(defn build-instance (name params body type-map)
  (let canonical (canonical-name-from-type-map name type-map)
    (let substituted-body (subst-expr body type-map Nil Nil)
      (let substituted-params (build-instance-params params type-map)
        (MI canonical substituted-body substituted-params)))))

(defn generate-instantiations-loop (name params body inst-sets)
  (match inst-sets
    (Nil Nil)
    (Cons type-map rest
      (Cons (build-instance name params body type-map)
        (generate-instantiations-loop name params body rest)))))

(defn generate-instantiations (ctx name generics params body)
  (let inst-sets (collect-instantiations ctx name generics)
    (generate-instantiations-loop name params body inst-sets)))

; ===========================================================================
; subst-expr — recursive expression transformer
; ===========================================================================

(defn subst-expr-list (exprs type-map var-renames var-types)
  (match exprs
    (Nil Nil)
    (Cons e rest
      (Cons (subst-expr e type-map var-renames var-types)
        (subst-expr-list rest type-map var-renames var-types)))))

(defn subst-defn-param (p type-map)
  (if (is-uppercase-ident (P.name p))
    (if (kv-contains type-map (P.name p))
      (P (P.name p) (Some (type-to-string (kv-get type-map (P.name p) (TVar 0 TUnit)))))
      p)
    p))

(defn subst-defn-params (params type-map)
  (match params
    (Nil Nil)
    (Cons p rest (Cons (subst-defn-param p type-map) (subst-defn-params rest type-map)))))

(defn subst-cond-clauses (clauses type-map var-renames var-types)
  (match clauses
    (Nil Nil)
    (Cons clause rest
      (match clause
        (Pair c b
          (Cons (Pair (subst-expr c type-map var-renames var-types)
                      (subst-expr b type-map var-renames var-types))
            (subst-cond-clauses rest type-map var-renames var-types)))))))

(defn subst-match-arms (arms type-map var-renames var-types)
  (match arms
    (Nil Nil)
    (Cons arm rest
      (Cons
        (MA (MA.variant arm)
            (subst-expr-list (MA.patterns arm) type-map var-renames var-types)
            (subst-expr (MA.body arm) type-map var-renames var-types))
        (subst-match-arms rest type-map var-renames var-types)))))

(defn subst-adt-field (f type-map)
  (if (is-uppercase-ident f)
    (if (kv-contains type-map f)
      (type-to-string (kv-get type-map f (TVar 0 TUnit)))
      f)
    f))

(defn subst-adt-fields (fields type-map)
  (match fields
    (Nil Nil)
    (Cons f rest (Cons (subst-adt-field f type-map) (subst-adt-fields rest type-map)))))

(defn subst-adt-variants (variants type-map)
  (match variants
    (Nil Nil)
    (Cons v rest
      (Cons (AV (AV.name v) (subst-adt-fields (AV.fields v) type-map))
        (subst-adt-variants rest type-map)))))

(defn subst-expr (expr type-map var-renames var-types)
  (match (Expr.inner expr)
    (EDefn name params body
      (let new-params (subst-defn-params params type-map)
        (let child-types (kv-set Nil name (infer-arg-type (MC Nil Nil Nil Nil Nil Nil Nil Nil) (subst-expr body type-map var-renames var-types)))
          (Expr (EDefn name new-params
            (subst-expr body type-map var-renames child-types))))))
    (ECall op args
      (Expr (ECall (subst-expr op type-map var-renames var-types)
             (subst-expr-list args type-map var-renames var-types))))
    (EApply fname args
      (Expr (EApply fname (subst-expr-list args type-map var-renames var-types))))
    (ELet name val body
      (let new-val (subst-expr val type-map var-renames var-types)
        (let child-types (kv-set Nil name (infer-arg-type (MC Nil Nil Nil Nil Nil Nil Nil Nil) new-val))
          (Expr (ELet name new-val (subst-expr body type-map var-renames child-types))))))
    (EIf cond then- else-
      (Expr (EIf (subst-expr cond type-map var-renames var-types)
           (subst-expr then- type-map var-renames var-types)
           (subst-expr else- type-map var-renames var-types))))
    (ELambda name params body
      (Expr (ELambda name params (subst-expr body type-map var-renames var-types))))
    (EFn name params body
      (Expr (EFn name params (subst-expr body type-map var-renames var-types))))
    (EBegin exprs
      (Expr (EBegin (subst-expr-list exprs type-map var-renames var-types))))
    (EPrint exprs
      (Expr (EPrint (subst-expr-list exprs type-map var-renames var-types))))
    (EWhile cond body
      (Expr (EWhile (subst-expr cond type-map var-renames var-types)
              (subst-expr body type-map var-renames var-types))))
    (EFor bindings cond body
      (Expr (EFor bindings
        (subst-expr cond type-map var-renames var-types)
        (subst-expr body type-map var-renames var-types))))
    (ECond clauses
      (Expr (ECond (subst-cond-clauses clauses type-map var-renames var-types))))
    (EMatch subject arms
      (Expr (EMatch (subst-expr subject type-map var-renames var-types)
              (subst-match-arms arms type-map var-renames var-types))))
    (EAtom atom
      (match atom
        (AIdent name
          (Expr (EAtom (AIdent (if (kv-contains var-renames name)
                            (kv-get var-renames name name)
                            name)))))
        (d1 (Expr (EAtom atom)))))
    (EMakeVariant adt_name variant_name args
      (Expr (EMakeVariant adt_name variant_name
        (subst-expr-list args type-map var-renames var-types))))
    (EDeftype name variants d20 bound
      (Expr (EDeftype name (subst-adt-variants variants type-map) Nil bound)))
    (d1 expr)))

(defn substitute-in-expr (expr)
  (subst-expr expr Nil Nil Nil))

(defn substitute-in-adt-field (f)
  (if (is-uppercase-ident f) "" f))

(defn substitute-in-adt-fields (fields)
  (match fields
    (Nil Nil)
    (Cons f rest (Cons (substitute-in-adt-field f) (substitute-in-adt-fields rest)))))

(defn substitute-in-adt-variants (variants)
  (match variants
    (Nil Nil)
    (Cons v rest
      (Cons (AV (AV.name v) (substitute-in-adt-fields (AV.fields v)))
        (substitute-in-adt-variants rest)))))

(defn substitute-in-adt (expr)
  (match (Expr.inner expr)
    (EDeftype name variants d21 bound
      (Expr (EDeftype name (substitute-in-adt-variants variants) Nil bound)))
    (d1 (substitute-in-expr expr))))

; ===========================================================================
; monomorphize — main entry point
; ===========================================================================

(defn annotate-first-param (params type_name)
  (match params
    (Nil Nil)
    ((Cons p rest) (Cons (P (P.name p) (Some type_name)) rest))))

(defn monomorphize-push-instantiations (result instantiations)
  (match instantiations
    (Nil result)
    (Cons mono rest
      (monomorphize-push-instantiations
        (list-push result (Expr (MI.body mono)))
        rest))))

(defn monomorphize-push-impl-bodies (result trait_name type_name bodies)
  (match bodies
    (Nil result)
    (Cons body rest
      (let concrete-name (str-concat trait_name (str-concat "." (str-concat (DN.name body) (str-concat "_" type_name))))
        (let mut-params (annotate-first-param (DN.params body) type_name)
          (monomorphize-push-impl-bodies
            (list-push result (Expr (EDefn concrete-name mut-params (DN.body body))))
            trait_name type_name rest))))))

(defn monomorphize-one (ctx result expr)
  (match (Expr.inner expr)
    (EDefn name params body
      (if (kv-contains (mc-gen-fns ctx) name)
        (let generics (kv-get (mc-gen-fns ctx) name Nil)
          (let instantiations (generate-instantiations ctx name generics params body)
            (let r1 (monomorphize-push-instantiations result instantiations)
              (let r2 (list-push r1 expr)
                (list-push r2 (substitute-in-expr expr))))))
        (list-push result (substitute-in-expr expr))))
    (ECall op args
      (let op-name (match (ast-ident-name (Expr.inner op)) (Some n n) (d1 nil))
        (if (and op-name (kv-contains (mc-gen-fns ctx) op-name))
          (let generics (kv-get (mc-gen-fns ctx) op-name Nil)
            (match (resolve-call-site ctx op-name generics args)
              (Some canonical-name
                (list-push result (Expr (ECall (Expr (EAtom (AIdent canonical-name))) args))))
              (d1 (list-push result (substitute-in-expr expr)))))
          (list-push result (substitute-in-expr expr)))))
    (EApply fname args
      (if (kv-contains (mc-gen-fns ctx) fname)
        (match (resolve-call-site ctx fname (kv-get (mc-gen-fns ctx) fname Nil) args)
          (Some canonical-name
            (list-push result (Expr (EApply canonical-name args))))
          (d1 (list-push result (substitute-in-expr expr))))
        (list-push result (substitute-in-expr expr))))
    (EDeftype name variants d22 bound
      (let acc0 result
        (let subresult (substitute-in-adt expr)
          (list-push acc0 subresult))))
    (EImplBlock trait_name type_name bodies
      (let acc0 result
        (let r1 (monomorphize-push-impl-bodies acc0 trait_name type_name bodies)
          (list-push r1 expr))))
    (d23
      (let acc0 result
        (let subresult (substitute-in-expr expr)
          (list-push acc0 subresult))))))

(defn monomorphize-loop (ctx result exprs)
  (match exprs
    (Nil result)
    (Cons expr rest
      (monomorphize-loop ctx (monomorphize-one ctx result expr) rest))))

(defn monomorphize (ctx exprs)
  (list-reverse (monomorphize-loop ctx Nil exprs)))

; ===========================================================================
; mono-context-new — construct from TypeInferer
; ===========================================================================

(defn mono-context-new (inferer)
  ; TypeInferer's own bookkeeping (TIKnownFns/TIFuncReturns/TIKnownTypes/
  ; TIAdtDefs) uses flat FnSig/FnReturn/TypeBind/AdtDef records, not the
  ; MonoKV-keyed stores MonoCtx expects here — the two aren't the same
  ; shape, so start empty; discover-from-ast/generate-instantiations
  ; populate these via kv-set as monomorphization actually runs.
  (MC Nil Nil Nil Nil Nil Nil Nil Nil))

; ===========================================================================
; kv-keys — extract keys from List (MonoKV K V)
; ===========================================================================

(defn kv-keys (binds)
  (match binds
    (Nil Nil)
    ((MK k d24) rest (Cons k (kv-keys rest)))))
