; === Zyl Compiler — Match Exhaustiveness / Unreachable-Arm Check ===
; Module: compiler/exhaustiveness_check
;
; Real teeth, not a lint: codegen.zyl's cg-match-arms (see cg-match-arms's
; fall-through label `lzero`) compiles a `match` with no arm matching the
; runtime tag by silently overwriting the result slot with the literal
; value 0 and continuing -- no trap, no panic, just a wrong value quietly
; flowing downstream from the match site. A non-exhaustive `match` over
; an ADT is therefore a genuine, silent-corruption-class bug, exactly the
; same failure shape as the original unbound-identifier-to-0 bug this
; whole hardening pass started from.
;
; Two things this file deliberately does NOT need to worry about:
;   1. Literal-pattern matches (`(match n (0 "a") (1 "b") (_ "c"))`) never
;      reach this check at all -- parse-literal-match (expr_inner.zyl)
;      already hard-requires a trailing `_` arm at PARSE time and lowers
;      straight to a nested EIf chain, never producing an EMatch/MatchArm
;      node in the first place. Every EMatch this file ever sees is a
;      real ADT-constructor match.
;   2. A `match` arm's tag is a bare `String` regardless of whether it's
;      a real constructor name or a catch-all bind (`_`, `other`,
;      ...) -- MatchArm has no separate "is this a bind or a tag" flag.
;      This file tells them apart the only reliable way available
;      without full type inference: is the tag a KNOWN constructor name
;      anywhere in this program's own deftypes? If not, it's being used
;      as a plain bind and the arm is a catch-all.
;
; Undershoot posture: a repo-wide scan found a handful of short variant
; names (`CI`, `CF`, `FR`, `MC`) reused by two UNRELATED deftypes in
; different modules (e.g. compiler/expr_inner's `CaptureInfo` vs
; lsp/lsp_types's `CompletionItem`) that DO both get pulled into the same
; resolved program (the LSP build, via lsp/compiler_bridge.zyl using
; both). Since which deftype a given match is really over can't be
; determined without real type inference, any tag claimed by more than
; one deftype in the CURRENT resolved program is marked ambiguous and
; exhaustiveness/unreachable-arm checking is skipped entirely for any
; match that touches it -- missing a diagnostic there is fine; guessing
; wrong and rejecting valid code is not.

(use core/list)
(use core/option)
(use compiler/ast)
(use compiler/expr_inner)
(use compiler/error_report)

(defn ec-check-program (exprs)
  (let dtypes (ec-collect-deftypes exprs)
    (let vowners (ec-build-owners dtypes)
      (ec-walk-top exprs dtypes vowners))))

; ===========================================================================
; DEFTYPE / VARIANT REGISTRY
; ===========================================================================

(defn ec-collect-deftypes (exprs)
  (match exprs
    (Nil Nil)
    (Cons e rest
      (match (Expr.inner e)
        (EDeftype name variants _ _ (Cons (Pair name (ec-variant-names variants)) (ec-collect-deftypes rest)))
        (_ (ec-collect-deftypes rest))))))

(defn ec-variant-names (variants)
  (match variants
    (Nil Nil)
    (Cons v rest
      (match v (AV vname _ (Cons vname (ec-variant-names rest)))))))

(defn ec-variants-of (tyname dtypes)
  (match dtypes
    (Nil None)
    (Cons dt rest
      (match dt
        (Pair t v (if (str-eq t tyname) (Some v) (ec-variants-of tyname rest)))))))

; variant name -> owning deftype name, or "" if claimed by 2+ deftypes.
(defn ec-build-owners (dtypes)
  (ec-build-owners-acc dtypes Nil))

(defn ec-build-owners-acc (dtypes acc)
  (match dtypes
    (Nil acc)
    (Cons dt rest
      (match dt
        (Pair tyname variants (ec-build-owners-acc rest (ec-register-variants tyname variants acc)))))))

(defn ec-register-variants (tyname variants acc)
  (match variants
    (Nil acc)
    (Cons vname rest (ec-register-variants tyname rest (ec-register-one vname tyname acc)))))

(defn ec-register-one (vname tyname acc)
  (match (ec-owner-lookup vname acc)
    (None (Cons (Pair vname tyname) acc))
    (Some existing
      (if (str-eq existing tyname)
        acc
        (ec-owner-replace vname "" acc)))))

(defn ec-owner-lookup (vname acc)
  (match acc
    (Nil None)
    (Cons pr rest
      (match pr
        (Pair v owner (if (str-eq v vname) (Some owner) (ec-owner-lookup vname rest)))))))

(defn ec-owner-replace (vname newowner acc)
  (match acc
    (Nil Nil)
    (Cons pr rest
      (match pr
        (Pair v owner
          (if (str-eq v vname)
            (Cons (Pair v newowner) rest)
            (Cons pr (ec-owner-replace vname newowner rest))))))))

;; Whether `tag` is already covered: `covered` holds (tag . owner) pairs.
;; (This used ec-in-list, which compared each pair with str-eq as if it
;; were a String, so a duplicate arm was never caught.)
(defn ec-covered-p (tag covered)
  (match covered
    (Nil false)
    (Cons p t (match p (Pair h _ (if (str-eq h tag) true (ec-covered-p tag t)))))))

(defn ec-in-list (name xs)
  (match xs
    (Nil false)
    (Cons h t (if (str-eq h name) true (ec-in-list name t)))))

; ===========================================================================
; MATCH CHECK
; ===========================================================================

; `site` is the EMatch node itself, carried down only so a diagnostic can
; name the line the match is on.
(defn ec-check-match (arms dtypes vowners site)
  (begin
    (ec-scan-arms arms dtypes vowners Nil site)
    (ec-arm-bodies arms dtypes vowners)))

(defn ec-scan-arms (arms dtypes vowners covered site)
  (match arms
    (Nil (ec-finish-exhaustive dtypes covered site))
    (Cons a rest
      (match a
        (MA tag _ _
          (match (ec-owner-lookup tag vowners)
            (None
              (if (> (list-length rest) 0)
                (ec-fail-unreachable-bind tag site)
                0))
            (Some owner
              (if (str-eq owner "")
                0
                (if (ec-covered-p tag covered)
                  (ec-fail-duplicate-arm tag site)
                  (ec-scan-arms rest dtypes vowners (Cons (Pair tag owner) covered) site))))))))))

; `covered` is (List (Pair tag owner)); reuses the exact same owner already
; resolved during the scan instead of re-looking it up, so a same-named
; ambiguous tag elsewhere in the registry can't retroactively confuse
; which deftype THIS match's arms actually belong to.
(defn ec-finish-exhaustive (dtypes covered site)
  (match covered
    (Nil 0)
    (Cons first _
      (match first
        (Pair _ tyname (ec-check-consistent-and-full dtypes tyname covered site))))))

(defn ec-check-consistent-and-full (dtypes tyname covered site)
  (if (ec-all-same-owner tyname covered)
    (match (ec-variants-of tyname dtypes)
      (Some all-variants (ec-check-full-coverage tyname all-variants (ec-tags-only covered) site))
      (None 0))
    0))

(defn ec-all-same-owner (tyname covered)
  (match covered
    (Nil true)
    (Cons pr rest
      (match pr
        (Pair _ owner (if (str-eq owner tyname) (ec-all-same-owner tyname rest) false))))))

(defn ec-tags-only (covered)
  (match covered
    (Nil Nil)
    (Cons pr rest (match pr (Pair tag _ (Cons tag (ec-tags-only rest)))))))

(defn ec-check-full-coverage (tyname all-variants covered site)
  (match all-variants
    (Nil 0)
    (Cons v rest
      (if (ec-in-list v covered)
        (ec-check-full-coverage tyname rest covered site)
        (ec-fail-nonexhaustive tyname v site)))))

(defn ec-fail-unreachable-bind (tag site)
  (let m1 "catch-all arm `"
    (let m2 (str-concat m1 (err-name tag))
      (let msg (str-concat m2 "` is followed by more arms that can never run")
        (ec-panic-at "E_UNREACHABLE_MATCH_ARM" msg "move the catch-all arm to the end of the match" site)))))

(defn ec-fail-duplicate-arm (tag site)
  (let m1 "arm `"
    (let m2 (str-concat m1 (err-name tag))
      (let msg (str-concat m2 "` is already matched by an earlier arm and can never run")
        (ec-panic-at "E_UNREACHABLE_MATCH_ARM" msg "delete the repeated arm, or give it a different constructor" site)))))

(defn ec-fail-nonexhaustive (tyname vname site)
  (let m1 "match over `"
    (let m2 (str-concat m1 (err-name tyname))
      (let m3 (str-concat m2 "` does not cover variant `")
        (let m4 (str-concat m3 (err-name vname))
          (let msg (str-concat m4 "`")
            (ec-panic-at "E_NON_EXHAUSTIVE_MATCH" msg "add an arm for that variant, or a `_` catch-all" site)))))))

(defn ec-panic-at (code msg hint site)
  (let off (ffi-call "zyl_span_off" site 1000)
    (let fid (ffi-call "zyl_span_file" site 1000)
      (let text (err-at code msg fid off hint)
        (ffi-call "zyl_panic" text 1000)))))

(defn ec-arm-bodies (arms dtypes vowners)
  (match arms
    (Nil 0)
    (Cons a rest
      (match a
        (MA _ _ body (begin (ec-expr body dtypes vowners) (ec-arm-bodies rest dtypes vowners)))))))

; ===========================================================================
; WHOLE-PROGRAM EXPR WALK — same shape coverage as arity_check.zyl's
; ac-expr (same pipeline stage: post module-resolution, post macro-
; expansion), minus arity-check's `shadowed` threading, which this check
; has no use for.
; ===========================================================================

(defn ec-walk-top (exprs dtypes vowners)
  (match exprs
    (Nil 0)
    (Cons e rest
      (begin
        (match (Expr.inner e)
          (EDefn _ _ body (ec-expr body dtypes vowners))
          (ETestDecl _ body _ (ec-expr body dtypes vowners))
          (_ 0))
        (ec-walk-top rest dtypes vowners)))))

(defn ec-list (xs dtypes vowners)
  (match xs
    (Nil 0)
    (Cons h t (begin (ec-expr h dtypes vowners) (ec-list t dtypes vowners)))))

(defn ec-expr (e dtypes vowners)
  (match (Expr.inner e)
    (ESetBang _ val (ec-expr val dtypes vowners))
    (ELet _ val body (begin (ec-expr val dtypes vowners) (ec-expr body dtypes vowners)))
    (ELetMut _ val body (begin (ec-expr val dtypes vowners) (ec-expr body dtypes vowners)))
    (EDef _ val (ec-expr val dtypes vowners))
    (EIf c t eb (begin (ec-expr c dtypes vowners) (ec-expr t dtypes vowners) (ec-expr eb dtypes vowners)))
    (EWhile c body (begin (ec-expr c dtypes vowners) (ec-expr body dtypes vowners)))
    (EFor bindings cond body
      (begin
        (ec-for-inits bindings dtypes vowners)
        (ec-expr cond dtypes vowners)
        (ec-expr body dtypes vowners)))
    (ECond clauses (ec-cond-clauses clauses dtypes vowners))
    (EBegin exprs (ec-list exprs dtypes vowners))
    (ELambda _ _ body (ec-expr body dtypes vowners))
    (EFn _ _ body (ec-expr body dtypes vowners))
    (ETryCatch tbody _ handler (begin (ec-expr tbody dtypes vowners) (ec-expr handler dtypes vowners)))
    (EMatch subj arms (begin (ec-expr subj dtypes vowners) (ec-check-match arms dtypes vowners e)))
    (ECall op args (begin (ec-expr op dtypes vowners) (ec-list args dtypes vowners)))
    (EApply _ args (ec-list args dtypes vowners))
    (EFfiCall _ args _ (ec-list args dtypes vowners))
    (EFfiPin e2 (ec-expr e2 dtypes vowners))
    (EFfiUnpin e2 (ec-expr e2 dtypes vowners))
    (EAssert c _ (ec-expr c dtypes vowners))
    (EUnwrap e2 (ec-expr e2 dtypes vowners))
    (EStructGet se _ (ec-expr se dtypes vowners))
    (EMakeStruct _ fields (ec-list fields dtypes vowners))
    (EMakeVariant _ _ args (ec-list args dtypes vowners))
    (EPrint exprs (ec-list exprs dtypes vowners))
    (EExit c (ec-expr c dtypes vowners))
    (EClose e2 (ec-expr e2 dtypes vowners))
    (EFileOpen a b (begin (ec-expr a dtypes vowners) (ec-expr b dtypes vowners)))
    (EFileRead a b (begin (ec-expr a dtypes vowners) (ec-expr b dtypes vowners)))
    (EFileWrite a b (begin (ec-expr a dtypes vowners) (ec-expr b dtypes vowners)))
    (EFileClose e2 (ec-expr e2 dtypes vowners))
    (EBufAppend a b (begin (ec-expr a dtypes vowners) (ec-expr b dtypes vowners)))
    (EWithResource _ init body (begin (ec-expr init dtypes vowners) (ec-expr body dtypes vowners)))
    (ESpawn closure (ec-expr closure dtypes vowners))
    (ESend actor msg (begin (ec-expr actor dtypes vowners) (ec-expr msg dtypes vowners)))
    (ESendClosure actor closure _ (begin (ec-expr actor dtypes vowners) (ec-expr closure dtypes vowners)))
    (ETestDecl _ body _ (ec-expr body dtypes vowners))
    (EAssertEqual l r (begin (ec-expr l dtypes vowners) (ec-expr r dtypes vowners)))
    (EAssertFail e2 _ (ec-expr e2 dtypes vowners))
    (EAssertTrue e2 _ (ec-expr e2 dtypes vowners))
    (EAssertFalse e2 _ (ec-expr e2 dtypes vowners))
    (ETestProperty _ _ body (ec-expr body dtypes vowners))
    (ESetup exprs (ec-list exprs dtypes vowners))
    (ETeardown exprs (ec-list exprs dtypes vowners))
    (ETestCompile e2 _ (ec-expr e2 dtypes vowners))
    (ELoadByte _ off buf (begin (ec-expr off dtypes vowners) (ec-expr buf dtypes vowners)))
    (ELoadByteSigned _ off buf (begin (ec-expr off dtypes vowners) (ec-expr buf dtypes vowners)))
    (EStoreByte _ off buf val (begin (ec-expr off dtypes vowners) (ec-expr buf dtypes vowners) (ec-expr val dtypes vowners)))
    (EStoreByteSigned _ off buf val (begin (ec-expr off dtypes vowners) (ec-expr buf dtypes vowners) (ec-expr val dtypes vowners)))
    (EByteSlice buf start len (begin (ec-expr buf dtypes vowners) (ec-expr start dtypes vowners) (ec-expr len dtypes vowners)))
    (EByteSliceSub buf start len (begin (ec-expr buf dtypes vowners) (ec-expr start dtypes vowners) (ec-expr len dtypes vowners)))
    (EByteBufAppend buf val (begin (ec-expr buf dtypes vowners) (ec-expr val dtypes vowners)))
    (EByteBufLen buf (ec-expr buf dtypes vowners))
    (EByteBufCap buf (ec-expr buf dtypes vowners))
    (EByteBufPtr buf (ec-expr buf dtypes vowners))
    (EAlignCheck e2 _ (ec-expr e2 dtypes vowners))
    (EAtomicLoad buf off (begin (ec-expr buf dtypes vowners) (ec-expr off dtypes vowners)))
    (EAtomicStore buf off val (begin (ec-expr buf dtypes vowners) (ec-expr off dtypes vowners) (ec-expr val dtypes vowners)))
    (EAtomicAdd buf off val (begin (ec-expr buf dtypes vowners) (ec-expr off dtypes vowners) (ec-expr val dtypes vowners)))
    (EAtomicSub buf off val (begin (ec-expr buf dtypes vowners) (ec-expr off dtypes vowners) (ec-expr val dtypes vowners)))
    (EAtomicCAS buf off exp2 nv (begin (ec-expr buf dtypes vowners) (ec-expr off dtypes vowners) (ec-expr exp2 dtypes vowners) (ec-expr nv dtypes vowners)))
    (EAtomicFetchAdd buf off val (begin (ec-expr buf dtypes vowners) (ec-expr off dtypes vowners) (ec-expr val dtypes vowners)))
    (EAtomicMax buf off val (begin (ec-expr buf dtypes vowners) (ec-expr off dtypes vowners) (ec-expr val dtypes vowners)))
    (EAtomicMin buf off val (begin (ec-expr buf dtypes vowners) (ec-expr off dtypes vowners) (ec-expr val dtypes vowners)))
    (EDefn _ _ body (ec-expr body dtypes vowners))
    (_ 0)))

(defn ec-cond-clauses (clauses dtypes vowners)
  (match clauses
    (Nil 0)
    (Cons pr rest
      (match pr
        (Pair c body (begin (ec-expr c dtypes vowners) (ec-expr body dtypes vowners) (ec-cond-clauses rest dtypes vowners)))))))

(defn ec-for-inits (bindings dtypes vowners)
  (match bindings
    (Nil 0)
    (Cons pr rest
      (match pr
        (Pair _ valOpt
          (begin
            (match valOpt (Some v (ec-expr v dtypes vowners)) (None 0))
            (ec-for-inits rest dtypes vowners)))))))
