; === The provenance record ===
; Module: compiler/provenance
;
; The CBOR map that a COSE_Sign1 signs. Its fields are the four inputs of
; spec 31.12, the assembly hash, the hash of the image the trailer is attached
; to, and the evidence the verifier gathered while that image was written.
;
; TWO THINGS THIS RECORD DELIBERATELY DOES NOT DO.
;
; It does not fold the evidence into `final-hash`. That hash is 31.12's, over
; the compiler, the graph, the native objects and the ICNF, in that order, and
; it is the project's determinism contract. Widening it to cover the evidence
; would change what that contract means rather than describe something new.
;
; It does not record a time, a host, or a path. The first non-negotiable here
; is that the same source and inputs produce identical output, and an
; attestation has to survive that test or it is decoration. If a build time is
; wanted it is a caller-supplied parameter, like SOURCE_DATE_EPOCH, hashed into
; its own field so that omitting it still reproduces.
;
; KEY ORDER IS CANONICAL, NOT READABLE. RFC 8949 4.2.1 sorts map keys by their
; ENCODED bytes, so a 4-byte key precedes a 6-byte one whatever they spell:
; "kind" comes before "format", and the 12-byte "compiler-hash" comes last of
; all. That reads badly and is required -- two encodings of one record would
; verify differently. `prov-sorted-p` checks it rather than trusting a comment.
;
(use encoding/cbor)
(use encoding/cose)
(use math/words)
(use compiler/verify)

; Bumped only when the record's shape changes. A verifier that does not
; recognise this refuses the trailer rather than guessing at it.
(def prov-format 1)


; A buffer and how much of it is used.
;
; The same pairing the CBOR writer uses: nothing here appends, so the used
; length is a value that has to be carried rather than read back.
(deftype ProvOut (ProvOut ByteBuf Int))


; The byte at `i`, or -1.
(defn prov-byte-at ((s String) (i Int)) (ffi-call "zyl_cstr_byte_at" s i 1000))

(defn prov-length ((s String)) (ffi-call "zyl_cstr_len" s 1000))

(defn prov-sub ((s String) start (n Int)) (ffi-call "zyl_cstr_substr" s start n 1000))

(defn prov-index-of ((s String) c (i Int))
  (if (>= i (prov-length s))
    (- 1)
    (if (= (prov-byte-at s i) c) i (prov-index-of s c (+ i 1)))))


; Hashes arrive from the build as bare hex or with a `blake3:` prefix, and a
; record carries them as 32 raw bytes: a hash is not text, and hex-encoding
; one into the record would double its size and make a byte string
; indistinguishable from a string that happens to look like one.
(defn prov-strip ((h String))
  (let i (prov-index-of h 58 0)
    (if (< i 0) h (prov-sub h (+ i 1) (- (prov-length h) (+ i 1))))))

; The 32 bytes a hash stands for.
;
; PADDED, NOT REJECTED, and the padding is why this is not a one-liner. A build
; with no lock has no graph hash, and §31.12 records that as the empty string --
; so w-from-hex would give a zero-length Words and the copy below would read
; index 0 of nothing. It crashed with E_INDEX_OUT_OF_BOUNDS, which is at least an
; honest failure, but a crash is the wrong answer to "this build has no graph".
;
; A SHORT hex string is zero-padded to 32 bytes. The alternative -- refusing to
; make a record -- would mean the provenance feature was unavailable for exactly
; the builds a reader is most likely to want to check, a single file with no
; package around it. And an all-zero hash is not a claim that the hash was
; zeroes: a hash is a fixed width, and zero-padding a shorter one is what every
; fixed-width field in this record already does. Callers that need to tell an
; absent hash from a real one read the buildinfo beside it, which records the
; empty string.
(defn prov-bytes ((hex String))
  (let p (cbor-buf 32)
    (let w (w-from-hex (prov-strip hex))
      (let have (w-len w)
        (begin
          (for (i 0) (< i 32)
            (begin
              (store-u8 :le p i (if (< i have) (w-get w i) 0))
              (set! i (+ i 1))))
          p)))))


; The evidence is a nested map of its own, and its keys are canonical too:
; reads(5) checks(6) writes(6) dynamic(7) functions(9) unverified(10).
; Shortest first, and where two are the same length the bytes decide: checks
; before writes, since "c" < "w".
;
; `checks` carries the verifier's own report lines, one per check, with the
; unimplemented ones NAMED AS ABSENT. A record saying "V4 ok" for a check that
; does not exist is worse than no record, so the wording is the compiler's.
; The "evidence" key and its map. The key is written HERE rather than by the
; caller because getting it wrong is silent: prov-evidence writes a map, and a
; map where a key belongs is still a well-formed map -- the record simply has
; eight entries and no evidence, and its signature verifies over that.
(defn prov-evidence-entry ((b ByteBuf) (off Int))
  (prov-evidence b (cbor-text b off "evidence")))

(defn prov-evidence ((b ByteBuf) (off Int))
  (let o (cbor-map-head b off 6)

    (let o (cbor-map-text-uint b o "reads" (verify-reads))

      (let o (prov-checks b o)

        (let o (cbor-map-text-uint b o "writes" (verify-writes))

          (let o (cbor-map-text-uint b o "dynamic" (verify-dynamic))

            (let o (cbor-map-text-uint b o "functions" (verify-functions))

              (let o (cbor-map-text-uint b o "unverified" (verify-unverified-writes))

                o))))))))



; "checks" before "writes": both are six bytes, and "c" < "w".
(defn prov-checks ((b ByteBuf) (off Int))
  (let lines (prov-split (verify-report))
    (cbor-map-text-strings b off "checks" lines (list-length lines))))

; verify-report returns four newline-separated lines, each one TERMINATED by its
; newline. Splitting naively on "\n" therefore yields five pieces, the last of
; them empty -- a record claiming five checks when the verifier ran four, which
; is the kind of small lie a record should not be able to tell.
(defn prov-split (s)
  (if (= (prov-length s) 0)
    Nil
    (let cut (prov-newline s 0)
      (if (< cut 0)
        (Cons s Nil)
        (Cons (prov-take s cut) (prov-split (prov-tail s cut)))))))

(defn prov-newline (s (i Int))
  (if (>= i (prov-length s))
    (- 1)
    (if (= (prov-byte-at s i) 10) i (prov-newline s (+ i 1)))))

(defn prov-take (s (n Int)) (prov-sub s 0 (if (< n 0) 0 n)))

(defn prov-tail (s (n Int)) (prov-sub s (+ n 1) (- (prov-length s) (+ n 1))))



; Keys in canonical order, by encoded bytes:
;
;   kind           4   0x64
;   format         6   0x66
;   asm-hash       8   0x68   "asm-hash" < "evidence", both eight
;   evidence       8   0x68
;   icnf-hash      9   0x69
;   final-hash    10   0x6a   "final-hash" < "graph-hash", both ten
;   graph-hash    10   0x6a
;   binary-hash   11   0x6b
;   objects-hash  12   0x6c
;   compiler-hash 13   0x6d
;
; Ten keys. `binary-hash` is BLAKE3 over the image up to the trailer's own
; magic, so the caller passes it in: the record cannot hash the image it is
; about to be appended to.
;
; `objects-hash` IS THE NATIVE-OBJECT HASH of SS31.12, and it is here because
; the record could not otherwise be CHECKED at all. §31.12's final hash is over
; FOUR inputs -- compiler, lock graph, native objects, ICNF -- and three of
; them were here, so a reader could recompute nothing: it had a final hash it
; could not check, and no way to discover that it could not. The fourth input is
; a short string, and a record that omits one of the four things its final hash
; is defined over is a record whose final hash is decoration.
(defn prov-record ((compiler-hex String) (graph-hex String) (objects-hex String) (icnf-hex String) (asm-hex String) (final-hex String) (binary-hex String))
  (let b (cbor-buf 1024)

    (let o (cbor-map-head b 0 10)

      (let o (cbor-map-text-text b o "kind" "provenance")

        (let o (cbor-map-text-uint b o "format" prov-format)

          (let o (cbor-map-text-bytes b o "asm-hash" (prov-bytes asm-hex) 32)

            (let o (prov-evidence-entry b o)

              (let o (cbor-map-text-bytes b o "icnf-hash" (prov-bytes icnf-hex) 32)
              (let o (cbor-map-text-bytes b o "final-hash" (prov-bytes final-hex) 32)
                (let o (cbor-map-text-bytes b o "graph-hash" (prov-bytes graph-hex) 32)
                  (let o (cbor-map-text-bytes b o "binary-hash" (prov-bytes binary-hex) 32)
                    (let o (cbor-map-text-bytes b o "objects-hash" (prov-bytes objects-hex) 32)
                      (let o (cbor-map-text-bytes b o "compiler-hash" (prov-bytes compiler-hex) 32)
                        (ProvOut b o))))))))))))))



; True when the record's ten keys are in canonical order.
;
; This checks the ORDER ABOVE, not the encoder. The encoder writes in whatever
; order it is handed, so if someone reorders these fields for readability the
; signature still verifies and the record is no longer canonical -- which is
; exactly the drift this is here to catch.
(defn prov-sorted-p (r)
  (cbor-keys-sorted-p (match r (ProvOut b n b)) 0 10 (match r (ProvOut _ n n))))

; ---------------------------------------------------------------------------
; The trailer
; ---------------------------------------------------------------------------
;
; Appended to the output file, after the last byte of the ELF image:
;
;   T-16   8   magic "ZYLPROV\0"
;   T-12   4   u32 LE format version
;   T-8    8   u64 LE length of the COSE blob
;   T      n   the COSE_Sign1
;
; THE HASHING RULE. `binary-hash` is BLAKE3 over bytes [0, T-16) -- the whole
; image, excluding the magic onward. Excluding the trailer is what makes the
; record self-describing: a reader locates the trailer by its magic, hashes
; everything before it, and gets the value the signature commits to. It also
; means appending must be the LAST thing that happens to the file, which is why
; this is a separate step the driver takes after linking rather than something
; the linker does.
(def prov-magic "ZYLPROV")
(def prov-magic-len 8)
(def prov-header-len 20)

; The 20 bytes that precede the COSE blob.
(defn prov-header (cose-len)
  (let b (cbor-buf prov-header-len)
    (begin
      (prov-write-magic b 0)
      (prov-store32 b 8 prov-format)
      (prov-store64 b 12 cose-len)
      b)))

(defn prov-write-magic ((b ByteBuf) (off Int))
  (begin
    (for (i 0) (< i 7)
      (begin
        (store-u8 :le b (+ off i) (prov-byte-at prov-magic i))
        (set! i (+ i 1))))
    (store-u8 :le b (+ off 7) 0)))

; u32 and u64 little-endian, written a byte at a time. There is no store-u32
; BE/LE pair that takes a ByteBuf at an arbitrary offset without also asserting
; an alignment this buffer has no reason to have.
(defn prov-store32 ((b ByteBuf) (off Int) (v Int))
  (begin
    (store-u8 :le b off (bit-and v 255))
    (store-u8 :le b (+ off 1) (bit-and (shr v 8) 255))
    (store-u8 :le b (+ off 2) (bit-and (shr v 16) 255))
    (store-u8 :le b (+ off 3) (bit-and (shr v 24) 255))))

(defn prov-store64 ((b ByteBuf) (off Int) (v Int))
  (begin
    (store-u8 :le b off (bit-and v 255))
    (store-u8 :le b (+ off 1) (bit-and (shr v 8) 255))
    (store-u8 :le b (+ off 2) (bit-and (shr v 16) 255))
    (store-u8 :le b (+ off 3) (bit-and (shr v 24) 255))
    (store-u8 :le b (+ off 4) (bit-and (shr v 32) 255))
    (store-u8 :le b (+ off 5) (bit-and (shr v 40) 255))
    (store-u8 :le b (+ off 6) (bit-and (shr v 48) 255))
    (store-u8 :le b (+ off 7) (bit-and (shr v 56) 255))))

; True when the magic is at `off`.
;
; Nothing else about a trailer is believed before this. The offsets that follow
; are relative to a magic nobody has confirmed, so a reader that skips this check
; will happily interpret whatever bytes it finds there.
(defn prov-magic-at ((b ByteBuf) (off Int))
  (prov-magic-scan b off 0))

(defn prov-magic-scan ((b ByteBuf) (off Int) (i Int))
  (if (>= i 7)
    (= (load-u8 :le b (+ off 7)) 0)
    (if (= (load-u8 :le b (+ off i)) (prov-byte-at prov-magic i))
      (prov-magic-scan b off (+ i 1))
      false)))

; Little-endian loads, by repeated shift-and-add rather than a hypothetical
; bit-shift-left: there is no such operator here, and `* 256` reads as what it
; is. A trailer is at most a few kilobytes, so eight of these is not a cost worth
; optimising.
(defn prov-load32 ((b ByteBuf) (off Int))
  (+ (bit-and (load-u8 :le b off) 255)
    (* 256 (+ (bit-and (load-u8 :le b (+ off 1)) 255)
      (* 256 (+ (bit-and (load-u8 :le b (+ off 2)) 255)
        (* 256 (bit-and (load-u8 :le b (+ off 3)) 255)))))))
)
(defn prov-load64 ((b ByteBuf) (off Int))
  (+ (bit-and (load-u8 :le b off) 255)
    (* 256 (+ (bit-and (load-u8 :le b (+ off 1)) 255)
      (* 256 (+ (bit-and (load-u8 :le b (+ off 2)) 255)
        (* 256 (+ (bit-and (load-u8 :le b (+ off 3)) 255)
          (* 256 (+ (bit-and (load-u8 :le b (+ off 4)) 255)
            (* 256 (+ (bit-and (load-u8 :le b (+ off 5)) 255)
              (* 256 (+ (bit-and (load-u8 :le b (+ off 6)) 255)
                (* 256 (bit-and (load-u8 :le b (+ off 7)) 255)))))))))))))
)))

; ---------------------------------------------------------------------------
; Whole files
; ---------------------------------------------------------------------------
;
; Wrappers, and not optional ones. `zyl_bytebuf_read_file` and
; `zyl_bytebuf_write_exec` are raw runtime entries that a program may not
; name (E_FFI_RESTRICTED), so this is the only way a caller outside the
; standard library can get at a binary's bytes at all -- and reading them is
; what both attaching a trailer and verifying one are made of. The real code
; lives here rather than at the call site for the same reason.

(defn prov-read-file (path) (ffi-call "zyl_bytebuf_read_file" path 1000))

(defn prov-write-file (path b (n Int)) (ffi-call "zyl_bytebuf_write_exec" path b n 1000))

; BLAKE3 over the first `n` bytes of a whole file, as bare hex. n < 0 is the
; whole file.
;
; The arena is made HERE and not passed in. zyl_bytebuf_blake3_hex needs one and
; a caller outside the standard library cannot make one -- arena-create is a raw
; entry -- so a parameter would mean every caller had to have an arena it cannot
; obtain, which is the wrapper existing for nothing. It is a 64 KiB block, the
; default, and it is destroyed on the way out: the hash is one line of text.
(defn prov-hash-file (path (n Int))
  (let a (arena-create 0)
    (let h (ffi-call "zyl_bytebuf_blake3_hex" a (prov-read-file path) n 32 1000)
      ; COPIED OUT BEFORE THE ARENA GOES. zyl_bytebuf_blake3_hex writes the hex
      ; into the arena it is handed, and arena-destroy frees those blocks, so
      ; returning `h` directly hands back a pointer into freed memory. Every
      ; other read of it still worked and the crash was somewhere else
      ; entirely: str-concat with an empty string copies through the heap
      ; region, which is what makes the returned String outlive the arena.
      (let out (str-concat h "")
        (begin (arena-destroy a) out)))))

; ---------------------------------------------------------------------------
; Assembling a trailer
; ---------------------------------------------------------------------------

; Copy `n` bytes from `src` at `soff` into `dst` at `doff`. Returns doff+n.
;
; Byte at a time because there is no bulk copy between two ByteBufs in this
; tree's vocabulary, and a trailer is a few kilobytes.
(defn prov-put ((dst ByteBuf) doff (src ByteBuf) soff (n Int))
  (begin
    (for (i 0) (< i n)
      (begin
        (store-u8 :le dst (+ doff i) (load-u8 :le src (+ soff i)))
        (set! i (+ i 1))))
    (+ doff n)))


; The trailer: the header, then the COSE blob, in one buffer.
;
; Assembled whole before it is written rather than written in two calls. The
; header carries the blob's length, so a reader locates the blob by arithmetic
; from the magic; a file whose header and blob arrived separately has no
; arrangement in which a reader can tell a truncated write from a short file.
(defn prov-trailer (cose cose-len)
  (let b (cbor-buf (+ prov-header-len cose-len))
    (let o (prov-put b 0 (prov-header cose-len) 0 prov-header-len)
      (ProvOut b (prov-put b o cose 0 cose-len)))))


; ---------------------------------------------------------------------------
; Finding a trailer in a file that has one
; ---------------------------------------------------------------------------

; The offset of the trailer's magic in a file of `flen` bytes, or -1.
;
; Scanned BACKWARD from the end, and only over the last `prov-scan-window`
; bytes. Two facts make this a bounded search rather than a scan of the file:
; the trailer is appended last, so it is at the end; and a magic that occurs
; inside the image is not a trailer, so the search starts where a trailer can
; be and stops early. A binary whose last KiB holds no magic has no trailer --
; searching the whole image for eight bytes would eventually find one inside a
; string constant and call a signed binary unsigned, or worse, call an unsigned
; one signed.
(defn prov-find (b (flen Int))
  (let lo (if (> flen prov-scan-window) (- flen prov-scan-window) 0)
    (prov-find-from b (- flen prov-header-len) lo)))


; The largest suffix searched for a trailer's magic, in bytes.
;
; A trailer is a 20-byte header plus a COSE blob over a record of a few
; hundred bytes, so a kilobyte is three orders of magnitude more than one needs
; and keeps the window from ever reaching into code.
(def prov-scan-window 1024)


(defn prov-find-from (b (hi Int) (lo Int))
  (if (< hi lo)
    (- 1)
    (if (prov-magic-at b hi) hi (prov-find-from b (- hi 1) lo))))


; The COSE blob at a trailer found at `at`, and its length.
;
; A PAIR, because the two are one fact: the blob begins prov-header-len bytes
; after the magic, and a caller that recomputes one of them from the other has
; an opportunity to be off by the header. Returning them together is what keeps
; "the blob" and "the blob's length" from being two independently-typed Ints
; that a caller has to keep in agreement.
(deftype ProvCose (ProvCose Int Int))

(defn prov-cose-at (b (at Int))
  (ProvCose (+ at prov-header-len) (prov-load64 b (+ at 12))))


; The bytes of a field the record carries as raw bytes, as lowercase hex.
;
; For comparing a field against a hash the build already holds as hex. Reading
; them back as bytes and re-encoding would be a second encoding to be right
; about; this is the encoder's own alphabet, so a mismatch means the bytes
; differ rather than that two hex routines disagree.
(defn prov-get-bytes ((b ByteBuf) (off Int) (n Int))
  (prov-hex b off n ""))


(def prov-digits "0123456789abcdef")

(defn prov-hex ((b ByteBuf) off n (acc String))
  (if (>= off n)
    acc
    (prov-hex b (+ off 1) n
      (str-concat acc
        (str-concat (str-substring prov-digits (/ (load-u8 :le b off) 16) 1)
          (str-substring prov-digits (bit-and (load-u8 :le b off) 15) 1))))))


; ---------------------------------------------------------------------------
; Attaching
; ---------------------------------------------------------------------------

; Append a signed trailer to the image at `path`; 0 on success, -1 on failure.
;
; THE ORDER HERE IS THE WHOLE CONTRACT. `binary-hash` is BLAKE3 over
; [0, T-16) -- the image without the trailer -- so the hash must be taken
; before anything is appended and the append must be the last write to the
; file. Hashing afterwards would commit to the image plus the trailer, and no
; reader could get back to the bytes the record describes.
;
; The file is read, extended and rewritten rather than appended to, because the
; only way this tree can write a byte that is not part of a String is a
; ByteBuf, and file-write stops at a NUL -- which a trailer has two of, in the
; magic and in nearly every CBOR head. Rewriting is also what makes the last
; write the append: there is no window in which the file is the image plus a
; partial trailer.
;
; The seven hashes are the record's inputs in the order prov-record takes them.
; `image-hex` is BLAKE3 of the image alone and is passed in rather than read
; here, because the driver is the one that measured it and two readers of a
; file being rewritten would be a race with themselves.
(defn prov-attach (path compiler-hex graph-hex objects-hex icnf-hex asm-hex
                   final-hex image-hex seedhex)
  (let img (prov-read-file path)
    (if (= (bytebuf-len img) 0)
      (prov-attach-failed path "cannot read the image")
      (let rec (prov-record compiler-hex graph-hex objects-hex icnf-hex asm-hex final-hex image-hex)
        (let rb (match rec (ProvOut b n b))
          (let rn (match rec (ProvOut _ n n))
            (let cose (cose-sign seedhex rb rn)
              (let cn (match cose (CoseOut _ n n))
                (let tr (prov-trailer (match cose (CoseOut b n b)) cn)
                  (let tn (match tr (ProvOut _ n n))
                    (prov-write-image path img
                      (match tr (ProvOut b n b)) tn)))))))))))


; `img` followed by `n` bytes of `tr`, written back over `path`.
;
; `zyl_bytebuf_write_exec` unlinks and recreates, so a failure part way leaves
; no file rather than a truncated one. The buffer is sized exactly: a trailer
; is the only thing ever added, and a capacity that could hold more would be a
; length that could be wrong.
(defn prov-write-image (path img tr (n Int))
  (let total (+ (bytebuf-len img) n)
    (let out (cbor-buf total)
      (let _ (bytebuf-append out (byteslice img 0 (bytebuf-len img)))
        (let _ (bytebuf-append out (byteslice tr 0 n))
          (begin
            (if (= (prov-write-file path out total) 0)
              unit
              (prov-attach-failed path "cannot write the image and its trailer"))))))))


; A failed attach is a build failure, not a warning.
;
; A binary whose provenance could not be attached is a binary that will be
; taken for an unsigned one, because there is nothing in it to say otherwise.
; Continuing would mean the caller had to notice, and the caller is a driver
; with a return code to spend on something else.
(defn prov-attach-failed (path why)
  (ffi-call "zyl_panic"
    (str-concat "E_PROV_ATTACH: " (str-concat why (str-concat " (" (str-concat path ")")))) 1000))


; ---------------------------------------------------------------------------
; Reading a trailer back: `zyl verify`
; ---------------------------------------------------------------------------
;
; Everything above WRITES. From here down a binary somebody else produced is
; read, and every offset in it is a claim the bytes make about themselves, so
; each one is checked against the file's own extent before it is believed.
;
; EVIDENCE AND ATTESTATION ARE REPORTED SEPARATELY, and that is the whole
; design (docs/build-provenance-design.md): a signature says who vouched, the
; evidence says what is true of the bytes, and a verifier that folds the two
; into one boolean is how a signed-but-unsafe binary gets waved through. So
; each line below says which of the two it is, and -- the part the first draft
; of this had wrong -- which claims are RE-DERIVED from the binary and which
; are only ATTESTED by the signer:
;
;   re-derived   binary-hash (BLAKE3 over [0, T-16) of this very file)
;                compiler-hash against this verifier's own image
;                every hash in <binary>.buildinfo, and final-hash recomputed
;                from the four inputs that file records
;   attested     the census: functions, writes, reads, dynamic, unverified,
;                and the four check lines
;
; WHY THE CENSUS IS NOT RE-DERIVED. The handoff that preceded this believed
; the operand census could be recounted from the executable segment and
; required to equal the record. It cannot: the build's census ran over the
; PROGRAM's assembly, and the image also holds the runtime (rt.zo), whose
; operands that census never saw. A recount over the image would differ from
; every honest record, and a recount that subtracted the runtime would be
; trusting a second input nobody signed. The frame bound (V1) is not in the
; image at all -- `# frame N` is an assembler comment. So the census is
; attested, this says so in the output, and the design doc records the
; decision. Putting a frame table in the image is the way to change it.

; The trailer located in a file of `flen` bytes: the magic offset, the format,
; the COSE blob offset and its length. `at` is -1 when there is none.
(deftype ProvTrailer (ProvTrailer Int Int Int Int))

(defn pt-at (t) (match t (ProvTrailer a _ _ _ a)))
(defn pt-format (t) (match t (ProvTrailer _ f _ _ f)))
(defn pt-cose (t) (match t (ProvTrailer _ _ c _ c)))
(defn pt-clen (t) (match t (ProvTrailer _ _ _ n n)))

(defn prov-no-trailer () (ProvTrailer (- 1) 0 0 0))

; Locate the trailer in `b`, a whole file of `flen` bytes.
;
; Found by magic, then the header is read by arithmetic from the magic and
; nothing in it is yet believed: the format and the length are returned for
; the caller to judge with prov-trailer-fits-p. A negative or absurd length
; is reported as what it is rather than used as an offset.
(defn prov-locate (b (flen Int))
  (let at (prov-find b flen)
    (if (< at 0)
      (prov-no-trailer)
      (ProvTrailer at (prov-load32 b (+ at 8)) (+ at prov-header-len) (prov-load64 b (+ at 12))))))

; True when the trailer accounts for every byte after the image: the blob
; begins after the header and ends exactly at the end of the file. A blob that
; is shorter has had something appended after it; one that is longer has been
; truncated. Both are refused before any cryptography runs.
(defn prov-trailer-fits-p (t (flen Int))
  (and (>= (pt-at t) 0)
    (and (>= (pt-clen t) 0)
      (= (+ (pt-cose t) (pt-clen t)) flen))))

; A record inside a verified-shape blob: the buffer, the map head, and the
; offset just past the record. `off` is -1 when the blob is not one this
; tree's COSE module emits.
(deftype ProvRec (ProvRec ByteBuf Int Int))

(defn pr-buf (r) (match r (ProvRec b _ _ b)))
(defn pr-off (r) (match r (ProvRec _ o _ o)))
(defn pr-end (r) (match r (ProvRec _ _ e e)))

; The record carried by the trailer `t` in `b`, located but not verified.
(defn prov-record-of (b t)
  (let p (cose-payload-at b (pt-cose t) (pt-clen t))
    (let poff (match p (PLen o _ o))
      (if (< poff 0)
        (ProvRec b (- 1) (- 1))
        (ProvRec b poff (+ poff (match p (PLen _ n n))))))))

(defn prov-rec-ok-p (r) (>= (pr-off r) 0))

; The offset of `key`'s value in the record's top-level map, or -1.
(defn prov-rec-find (r (key String))
  (cbor-map-find (pr-buf r) (pr-off r) (pr-end r) cbor-max-nesting key))

; The text `key` names, or "".
(defn prov-rec-text (r (key String))
  (let at (prov-rec-find r key)
    (if (< at 0) "" (match (cbor-text-at (pr-buf r) at (pr-end r)) (CT s _ s)))))

; The unsigned integer `key` names, or -1.
(defn prov-rec-uint (r (key String))
  (let at (prov-rec-find r key)
    (if (< at 0) (- 1) (match (cbor-uint-at (pr-buf r) at (pr-end r)) (CU v _ v)))))

; The 32-byte hash `key` names, as bare hex, or "" when absent or not 32 bytes.
;
; Exactly 32 and nothing else: a hash of another width is a record of another
; shape, and hex-encoding 31 bytes would produce a string that compares
; unequal to everything for a reason the reader would have to guess at.
(defn prov-rec-hash (r (key String))
  (let at (prov-rec-find r key)
    (if (< at 0)
      ""
      (let s (cbor-bytes-at (pr-buf r) at (pr-end r))
        (if (= (match s (CS _ n _ n)) 32)
          (let p (match s (CS p _ _ p))
            (prov-hex (pr-buf r) p (+ p 32) ""))
          "")))))

; The offset of `key`'s value inside the nested `evidence` map, or -1.
(defn prov-rec-evidence-find (r (key String))
  (let ev (prov-rec-find r "evidence")
    (if (< ev 0)
      (- 1)
      (cbor-map-find (pr-buf r) ev (pr-end r) cbor-max-nesting key))))

(defn prov-rec-evidence-uint (r (key String))
  (let at (prov-rec-evidence-find r key)
    (if (< at 0) (- 1) (match (cbor-uint-at (pr-buf r) at (pr-end r)) (CU v _ v)))))

; The `checks` lines, in the order the record carries them.
(defn prov-rec-checks (r)
  (let at (prov-rec-evidence-find r "checks")
    (if (< at 0)
      Nil
      (let a (cbor-array-at (pr-buf r) at (pr-end r))
        (if (< (match a (CU n _ n)) 0)
          Nil
          (prov-rec-texts r (match a (CU _ p p)) (match a (CU n _ n))))))))

(defn prov-rec-texts (r (off Int) (n Int))
  (if (<= n 0)
    Nil
    (let t (cbor-text-at (pr-buf r) off (pr-end r))
      (if (< (match t (CT _ e e)) 0)
        Nil
        (Cons (match t (CT s _ s)) (prov-rec-texts r (match t (CT _ e e)) (- n 1)))))))

; True when the record says it is a provenance record of the format this
; verifier knows. Anything else is refused rather than guessed at: a record
; with a newer format may carry keys this reader does not know how to check.
(defn prov-rec-is-provenance-p (r)
  (and (prov-rec-ok-p r)
    (and (str-equal (prov-rec-text r "kind") "provenance")
      (= (prov-rec-uint r "format") prov-format))))

; The signer's kid, as bare hex.
(defn prov-kid (b t) (cose-kid-hex b (pt-cose t)))

; True when the blob verifies under the public key `pubhex`, with or without
; an `ed25519:` prefix.
(defn prov-signed-by-p (b t (pubhex String))
  (cose-verify-at b (pt-cose t) (pt-clen t) (prov-strip pubhex)))

; ---------------------------------------------------------------------------
; The buildinfo beside the binary
; ---------------------------------------------------------------------------
;
; `zyl build` writes <out>.buildinfo with the same four inputs the record
; carries, as text, prefixed hashes and all -- and THAT is what makes the
; record's final-hash checkable: §31.12's final hash is BLAKE3 over the four
; input STRINGS joined by newlines, not over their 32-byte values, so a reader
; holding only the record has the hash and nothing to recompute it from. With
; the buildinfo it has everything, and the two files have to agree.

; The text between `(<field> "` and the next `"`, or "".
(defn prov-bi-field ((text String) (field String))
  (let open (str-concat "(" (str-concat field " \""))
    (let i (prov-find-sub text open 0)
      (if (< i 0)
        ""
        (let start (+ i (prov-length open))
          (let j (prov-index-of text 34 start)
            (if (< j 0) "" (prov-sub text start (- j start)))))))))

; The native-objects text: everything between `(native-objects` and the
; `)` that precedes `(icnf-hash`. Extracted by its neighbours rather than by
; paren matching, because the graph text just before it nests freely and the
; objects text is exactly what drv-object-hashes wrote, parens included.
(defn prov-bi-objects ((text String))
  (let i (prov-find-sub text "(native-objects" 0)
    (if (< i 0)
      ""
      (let start (+ i 15)
        (let j (prov-find-sub text ")\n  (icnf-hash" start)
          (if (< j 0) "" (prov-sub text start (- j start))))))))

; The first offset of `sub` in `s` at or after `from`, or -1.
(defn prov-find-sub ((s String) (sub String) (from Int))
  (let n (prov-length s)
    (let m (prov-length sub)
      (if (> (+ from m) n)
        (- 1)
        (if (prov-sub-at-p s sub from 0 m)
          from
          (prov-find-sub s sub (+ from 1)))))))

(defn prov-sub-at-p ((s String) (sub String) (at Int) (i Int) (m Int))
  (if (>= i m)
    true
    (if (= (prov-byte-at s (+ at i)) (prov-byte-at sub i))
      (prov-sub-at-p s sub at (+ i 1) m)
      false)))

; BLAKE3 over a string, as bare hex; the arena is made and destroyed here for
; the reason prov-hash-file gives.
(defn prov-hash-text ((s String))
  (let a (arena-create 0)
    (let h (ffi-call "zyl_blake3_hex" a s (- 1) 32 1000)
      (let out (str-concat h "")
        (begin (arena-destroy a) out)))))

; §31.12's final hash from its four input strings, as bare hex.
(defn prov-final-of ((ch String) (gh String) (nh String) (ih String))
  (prov-hash-text (str-concat ch (str-concat "\n" (str-concat gh (str-concat "\n" (str-concat nh (str-concat "\n" ih))))))))

; A build-side hash string as the 32 bytes the record would carry, as hex:
; the same padding prov-bytes applies, so an absent graph hash compares equal
; to the zero bytes the record holds for it.
(defn prov-as-record-hex ((h String)) (prov-get-bytes (prov-bytes h) 0 32))

; The whole of a text file, or "".
(defn prov-read-text (path)
  (if (not (ffi-call "zyl_path_exists" path 1000))
    ""
    (let fd (file-open path "r")
      (if (< fd 1)
        ""
        (let s (prov-read-chunks fd "")
          (let _ (file-close fd) s))))))

(defn prov-read-chunks ((fd Int) (acc String))
  (let chunk (file-read fd 1048576)
    (let n (str-length chunk)
      (if (= n 0)
        acc
        (let acc2 (str-concat acc chunk)
          (if (< n 1048576) acc2 (prov-read-chunks fd acc2)))))))

; ---------------------------------------------------------------------------
; The verdict
; ---------------------------------------------------------------------------
;
; `prov-verify` prints the report and returns the exit status: 0 when every
; check that ran passed, 1 otherwise. The MODE is the caller's, because the
; keys live where the caller keeps them:
;
;   0  anchored       the key pinned for a package (§31.8, ~/.zyl/keys)  VERIFIED
;   1  supplied       a public key given out of band                     ATTESTED
;   2  self-asserted  the record's own kid                               SELF-ASSERTED
;
; The verdict word is the mode's, never a stronger one, and the mode is
; printed beside it with where the key came from. `anchored-only` makes any
; mode but the first a failure, for a script that must not accept less.

(def prov-mode-anchored 0)
(def prov-mode-supplied 1)
(def prov-mode-self 2)

; One report line: a 12-column tag, then the text.
(defn prov-say ((tag String) (text String))
  (print (str-concat (prov-pad tag 13) text)))

(defn prov-pad ((s String) (n Int))
  (if (>= (str-length s) n) s (prov-pad (str-concat s " ") n)))

(defn prov-int (n) (ffi-call "zyl_int_text" n 1000))

(defn prov-verify (path (mode Int) (pubhex String) (key-source String) (anchored-only Bool))
  (let b (prov-read-file path)
    (let flen (bytebuf-len b)
      (begin
        (prov-say "zyl verify" path)
        (if (= flen 0)
          (begin
            (prov-say "" (str-concat "cannot read " path))
            (prov-say "VERDICT" "FAILED")
            1)
          (let t (prov-locate b flen)
            (if (< (pt-at t) 0)
              (begin
                (prov-say "TRAILER" (str-concat "none: no ZYLPROV magic in the last "
                  (str-concat (prov-int prov-scan-window) " bytes")))
                (prov-say "VERDICT" "UNSIGNED")
                1)
              (prov-verify-trailer path b flen t mode pubhex key-source anchored-only))))))))

; The trailer exists; is it whole, and is it one this verifier can read?
(defn prov-verify-trailer (path b flen t (mode Int) (pubhex String) (key-source String) (anchored-only Bool))
  (if (not (= (pt-format t) prov-format))
    (begin
      (prov-say "TRAILER" (str-concat "at " (str-concat (prov-int (pt-at t))
        (str-concat ": format " (str-concat (prov-int (pt-format t)) ", which this verifier does not know")))))
      (prov-say "VERDICT" "FAILED")
      1)
    (if (not (prov-trailer-fits-p t flen))
      (begin
        (prov-say "TRAILER" (str-concat "at " (str-concat (prov-int (pt-at t))
          (str-concat ": the COSE blob claims " (str-concat (prov-int (pt-clen t))
            (str-concat " bytes but the file ends " (str-concat (prov-int (- flen (pt-cose t))) " bytes after the header: truncated or extended")))))))
        (prov-say "VERDICT" "FAILED")
        1)
      (let r (prov-record-of b t)
        (if (not (prov-rec-is-provenance-p r))
          (begin
            (prov-say "TRAILER" (str-concat "at " (str-concat (prov-int (pt-at t)) ": the COSE blob is not a COSE_Sign1 over a provenance record this verifier knows")))
            (prov-say "VERDICT" "FAILED")
            1)
          (begin
            (prov-say "TRAILER" (str-concat "at " (str-concat (prov-int (pt-at t))
              (str-concat ": format 1, COSE_Sign1 of " (str-concat (prov-int (pt-clen t)) " bytes, accounting for every byte after the image")))))
            (prov-verify-body path b t r mode pubhex key-source anchored-only)))))))

; The record reads. Evidence first, then the attestation, then the verdict.
(defn prov-verify-body (path b t r (mode Int) (pubhex String) (key-source String) (anchored-only Bool))
  (let e1 (prov-check-image path t r)
    (let e2 (prov-check-compiler r)
      (let e3 (prov-check-buildinfo path r)
        (let _ (prov-say-census r)
          (let a1 (prov-check-signature b t mode pubhex key-source)
            (let a2 (prov-check-mode mode anchored-only)
              (prov-verdict mode (and e1 (and e3 (and a1 a2))) e2))))))))

; EVIDENCE 1: BLAKE3 over [0, T-16) of this file against binary-hash.
(defn prov-check-image (path t r)
  (let ours (prov-hash-file path (pt-at t))
    (let theirs (prov-rec-hash r "binary-hash")
      (if (str-equal ours theirs)
        (begin
          (prov-say "EVIDENCE" (str-concat "binary-hash    re-derived over [0, " (str-concat (prov-int (pt-at t)) "): matches the record")))
          true)
        (begin
          (prov-say "EVIDENCE" (str-concat "binary-hash    re-derived over [0, " (str-concat (prov-int (pt-at t)) "): DIFFERS from the record -- the image was changed after it was signed")))
          (prov-say "" (str-concat "               image  " ours))
          (prov-say "" (str-concat "               record " theirs))
          false)))))

; EVIDENCE 2: the record's compiler-hash against this verifier's own image.
;
; Informational, not a failure: a binary built by another compiler is not
; wrong, it is built by another compiler, and the line says which. But when it
; matches, the chain from this verified binary to a verifiable compiler is
; closed with no further assumption, and that is worth a line that says so.
(defn prov-check-compiler (r)
  (let own (prov-hash-text-file (ffi-call "zyl_arg_str" 0 1000))
    (let theirs (prov-rec-hash r "compiler-hash")
      (if (str-equal own theirs)
        (begin
          (prov-say "" "compiler-hash  re-derived from this verifier's own image: the same compiler")
          true)
        (begin
          (prov-say "" "compiler-hash  re-derived from this verifier's own image: a different compiler (attested only)")
          false)))))

(defn prov-hash-text-file (path) (prov-hash-file path (- 1)))

; EVIDENCE 3: <binary>.buildinfo, when it is there.
;
; Every hash it carries is compared with the record's, and §31.12's final hash
; is recomputed from the four inputs it records. A buildinfo that disagrees
; with the trailer is a failure: the two describe one build, and a reader who
; found them apart would have to pick one to believe.
(defn prov-check-buildinfo (path r)
  (let bi (prov-read-text (str-concat path ".buildinfo"))
    (if (= (prov-length bi) 0)
      (begin
        (prov-say "" (str-concat "buildinfo      no " (str-concat path ".buildinfo: final-hash, graph-hash, objects-hash, icnf-hash and asm-hash are attested only")))
        true)
      (let ch (prov-bi-field bi "compiler-hash")
        (let gh (prov-bi-field bi "graph-hash")
          (let nh (prov-bi-objects bi)
            (let ih (prov-bi-field bi "icnf-hash")
              (let bad (prov-bi-mismatches r ch gh nh ih (prov-bi-field bi "asm-hash") (prov-bi-field bi "final-hash"))
                (if (= (list-length bad) 0)
                  (begin
                    (prov-say "" (str-concat "buildinfo      " (str-concat path ".buildinfo: all six hashes agree with the record, and final-hash recomputes from its four inputs")))
                    true)
                  (begin
                    (prov-say "" (str-concat "buildinfo      " (str-concat path (str-concat ".buildinfo DISAGREES with the record on: " (prov-join bad)))))
                    false))))))))))

; The names of the record fields the buildinfo does not match.
(defn prov-bi-mismatches (r ch gh nh ih ah fh)
  (let a (prov-bi-one r "compiler-hash" ch)
    (let b (prov-bi-one r "graph-hash" gh)
      (let c (prov-bi-one r "objects-hash" (str-concat "blake3:" (prov-hash-text nh)))
        (let d (prov-bi-one r "icnf-hash" ih)
          (let e (prov-bi-one r "asm-hash" ah)
            (let f (prov-bi-one r "final-hash" fh)
              (let g (if (str-equal (prov-as-record-hex (str-concat "blake3:" (prov-final-of ch gh nh ih))) (prov-rec-hash r "final-hash"))
                       Nil
                       (Cons "final-hash recomputed from the four inputs" Nil))
                (prov-cat a (prov-cat b (prov-cat c (prov-cat d (prov-cat e (prov-cat f g))))))))))))))

(defn prov-bi-one (r (key String) (h String))
  (if (str-equal (prov-as-record-hex h) (prov-rec-hash r key)) Nil (Cons key Nil)))

(defn prov-cat (a b) (match a (Nil b) (Cons h t (Cons h (prov-cat t b)))))

(defn prov-join (xs)
  (match xs
    (Nil "")
    (Cons h t (if (= (list-length t) 0) h (str-concat h (str-concat ", " (prov-join t)))))))

; The census, ATTESTED. Said in those words, with the reason.
(defn prov-say-census (r)
  (begin
    (prov-say "" "census         attested, not re-derived: the image also holds the runtime, which the build's census never covered")
    (prov-say "" (str-concat "               functions " (str-concat (prov-int (prov-rec-evidence-uint r "functions"))
      (str-concat ", writes " (str-concat (prov-int (prov-rec-evidence-uint r "writes"))
        (str-concat ", reads " (str-concat (prov-int (prov-rec-evidence-uint r "reads"))
          (str-concat ", dynamic " (str-concat (prov-int (prov-rec-evidence-uint r "dynamic"))
            (str-concat ", unverified " (prov-int (prov-rec-evidence-uint r "unverified"))))))))))))
    (prov-say-checks (prov-rec-checks r))))

(defn prov-say-checks (xs)
  (match xs
    (Nil unit)
    (Cons h t (begin (prov-say "" (str-concat "               " h)) (prov-say-checks t)))))

; ATTESTATION: the signature under the mode's key.
(defn prov-check-signature (b t (mode Int) (pubhex String) (key-source String))
  (let kid (prov-kid b t)
    (let key (if (= mode prov-mode-self) kid (prov-strip pubhex))
      (if (prov-signed-by-p b t key)
        (begin
          (prov-say "ATTESTATION" (str-concat "COSE_Sign1 valid under kid ed25519:" kid))
          (prov-say "" (str-concat "trust: " (str-concat (prov-mode-name mode) (str-concat " -- " key-source))))
          true)
        (begin
          (prov-say "ATTESTATION" (str-concat "COSE_Sign1 does NOT verify under ed25519:" (str-concat key
            (if (str-equal key kid) "" (str-concat " (the record's kid is ed25519:" (str-concat kid ")"))))))
          false)))))

(defn prov-mode-name ((mode Int))
  (if (= mode prov-mode-anchored) "anchored" (if (= mode prov-mode-supplied) "supplied" "self-asserted")))

; `--anchored`: anything less than the pinned key is a failure, said so.
(defn prov-check-mode ((mode Int) (anchored-only Bool))
  (if (and anchored-only (not (= mode prov-mode-anchored)))
    (begin
      (prov-say "" "--anchored was given and the key is not one pinned for a package: that is a failure, not a weaker verdict")
      false)
    true))

; The last line, and the exit status.
(defn prov-verdict ((mode Int) (ok Bool) (same-compiler Bool))
  (if (not ok)
    (begin (prov-say "VERDICT" "FAILED") 1)
    (begin
      (prov-say "VERDICT"
        (str-concat (if (= mode prov-mode-anchored) "VERIFIED" (if (= mode prov-mode-supplied) "ATTESTED" "SELF-ASSERTED"))
          (if same-compiler "" " (built by a compiler other than this one)")))
      0)))
