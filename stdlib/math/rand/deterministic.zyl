; === Zyl Standard Library — ChaCha20 Deterministic RNG ===
; Module: math/rand/deterministic
; Provides: ChaCha20Rng — reproducible, seedable random bytes
;
; Twenty-round ChaCha20 in counter mode. Given the same 32-byte seed it
; produces exactly the same byte stream on every machine and every run,
; which is what tests, simulations and property-based generators need,
; and it is a cryptographically strong stream while doing it.
;
; That strength does NOT make it a source of key material. A
; deterministic generator's whole output is a function of its seed, so
; anything derived from it is only as unpredictable as the seed's
; storage. Seed it from math/rand/crypto if the output must be
; unpredictable, and use math/rand/crypto directly for keys.
;
; State layout (a single math/words array, so the generator can be
; passed around as one Int without needing a mutable struct):
;
;   [0..31]    32-byte key
;   [32..43]   12-byte nonce
;   [44]       block counter
;   [45]       read position within the buffered block (0..64)
;   [46..109]  the 64-byte keystream block currently being read
;
; The buffer means a caller asking for one byte at a time costs one
; ChaCha20 block per 64 bytes rather than one per byte.

(use core/core)
(use math/bits)
(use math/words)
(use math/rand/rand)
(use math/crypto/symmetric/chacha20)

; Total size of the generator's state, in words.
; Returns: Int
(defn chacharng-state-len () 110)

; Create a generator from a 32-byte seed. The nonce starts at zero: a
; ChaCha20Rng is a single keystream, not a multi-message cipher, so the
; nonce carries no information and the counter alone advances.
; Returns: Int
(defn chacharng-new ((arena Int) (seed Int))
  (let st (w-alloc arena 110)
    (begin
      (w-copy st seed 32)
      (w-set st 44 0)
      (w-set st 45 64)
      st)))

; Create a generator from an Int seed, for tests that want a one-liner.
; The seed is spread little-endian over the first 8 key bytes and the
; rest stay zero: adequate for reproducible test data, NOT for anything
; needing 256 bits of seed entropy.
; Returns: Int
(defn chacharng-from-int ((arena Int) (seed Int))
  (let st (w-alloc arena 110)
    (begin
      (for (i 0) (< i 8)
        (begin (w-set st i (bit-and (shr seed (* 8 i)) 255)) (set! i (+ i 1))))
      (w-set st 44 0)
      (w-set st 45 64)
      st)))

; Generate the next keystream block into the state's buffer and reset
; the read position.
; Returns: Int
(defn chacharng-refill ((arena Int) (st Int))
  (let key (w-alloc arena 32)
    (let nonce (w-alloc arena 12)
      (begin
        (w-copy key st 32)
        (chacharng-copy-nonce st nonce)
        (chacharng-store-block arena st key nonce)
        (w-set st 44 (+ (w-get st 44) 1))
        (w-set st 45 0)
        0))))

; Returns: Int
(defn chacharng-copy-nonce ((st Int) (nonce Int))
  (begin
    (for (i 0) (< i 12)
      (begin (w-set nonce i (w-get st (+ 32 i))) (set! i (+ i 1))))
    0))

; Returns: Int
(defn chacharng-store-block ((arena Int) (st Int) (key Int) (nonce Int))
  (let blk (chacha20-block arena key nonce (w-get st 44))
    (begin
      (for (i 0) (< i 64)
        (begin (w-set st (+ 46 i) (w-get blk i)) (set! i (+ i 1))))
      0)))

; The next random byte (0..255).
; Returns: Int
(defn chacharng-next-byte ((arena Int) (st Int))
  (begin
    (if (>= (w-get st 45) 64)
      (chacharng-refill arena st)
      0)
    (chacharng-take-byte st)))

; Returns: Int
(defn chacharng-take-byte ((st Int))
  (let pos (w-get st 45)
    (let v (w-get st (+ 46 pos))
      (begin
        (w-set st 45 (+ pos 1))
        v))))

; Fill `n` bytes (one per word) at `out`.
; Returns: Int
(defn chacharng-fill ((arena Int) (st Int) (out Int) (n Int))
  (begin
    (for (i 0) (< i n)
      (begin
        (w-set out i (chacharng-next-byte arena st))
        (set! i (+ i 1))))
    n))

; A fresh array of `n` random bytes.
; Returns: Int
(defn chacharng-bytes ((arena Int) (st Int) (n Int))
  (let out (w-alloc arena n)
    (begin
      (chacharng-fill arena st out n)
      out)))

; The next 64-bit value, little-endian over 8 generated bytes.
; Returns: Int
(defn chacharng-next-u64 ((arena Int) (st Int))
  (let buf (w-alloc arena 8)
    (begin
      (chacharng-fill arena st buf 8)
      (rand-u64-from-bytes buf 0))))

; A uniform value in [0, bound), redrawing on the rejection case so the
; result is unbiased. Returns -1 only for an invalid bound or after
; `attempts` consecutive rejections.
; Returns: Int
(defn chacharng-below ((arena Int) (st Int) (bound Int) (attempts Int))
  (if (<= attempts 0)
    -1
    (let v (rand-below (chacharng-next-u64 arena st) bound)
      (if (>= v 0)
        v
        (chacharng-below arena st bound (- attempts 1))))))
