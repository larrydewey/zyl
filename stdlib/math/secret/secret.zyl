; === Zyl Standard Library — Constant-Time Primitives & Secret Erasure ===
; Module: math/secret/secret
; Provides: ct-eq / ct-ne / ct-select / ct-mask, zeroize
;
; Every function here is BRANCHLESS: no `if`, no `while`, no early
; return on any value derived from a secret. That is the whole point --
; a MAC tag comparison that returns as soon as two bytes differ leaks
; the length of the matching prefix through timing, which is enough to
; forge a tag one byte at a time. The loops below always run their full
; declared length, and that length is a public parameter (a tag length,
; a digest length), never a secret.
;
; What these rest on, precisely: `bit-and`, `bit-or`, `bit-xor`, `shl`,
; `shr` and `-` each compile to a single fixed machine instruction
; sequence with no data-dependent path (codegen.zyl's cg-bit-mnem and
; cg-arith-mnem), so the instruction stream is identical for every
; operand value. `if`, by contrast, compiles to a conditional jump, so
; it never appears here on a secret-derived condition.
;
; Bool is NOT used as the result type of the comparison primitives:
; converting to Bool would mean a `setcc`-shaped value whose consumers
; (`if`, `and`, `or`) are exactly the branching constructs being
; avoided. ct-eq returns 1 or 0 as an Int, meant to be consumed by
; ct-select or by further masking; `ct-eq-bool` exists for the one
; legitimate case, a caller that has finished with the secret and is
; about to make a control-flow decision on the single accept/reject
; bit -- which every AEAD does, and which leaks nothing beyond the
; verdict itself.

(use core/core)
(use math/words)

; ===========================================================================
; MASKS AND SELECTION
; ===========================================================================

; All-ones when c is 1, all-zeros when c is 0. Undefined for other
; inputs, which is why every producer of a condition in this file
; normalizes to 0/1 first.
; Returns: Int
(defn ct-mask ((c Int))
  (- 0 c))

; 1 when x is zero, 0 otherwise, without branching. `(x | -x)` has its
; top bit set for every non-zero x (including the most negative Int,
; whose negation is itself), so the logical shift by 63 isolates
; "non-zero" and the subtraction inverts it.
; Returns: Int
(defn ct-is-zero ((x Int))
  (- 1 (bit-and (shr (bit-or x (- 0 x)) 63) 1)))

; 1 when x is non-zero, 0 otherwise.
; Returns: Int
(defn ct-is-nonzero ((x Int))
  (bit-and (shr (bit-or x (- 0 x)) 63) 1))

; a when c is 1, b when c is 0. Both operands are always evaluated and
; both are always read; only the mask decides which bits survive.
; Returns: Int
(defn ct-select ((c Int) (a Int) (b Int))
  (let m (ct-mask c)
    (bit-or (bit-and m a) (bit-and (bit-not m) b))))

; ===========================================================================
; COMPARISON
; ===========================================================================

; 1 when a equals b, 0 otherwise. Constant-time in both operands.
; Returns: Int
(defn ct-eq ((a Int) (b Int))
  (ct-is-zero (bit-xor a b)))

; 1 when a differs from b, 0 otherwise.
; Returns: Int
(defn ct-ne ((a Int) (b Int))
  (ct-is-nonzero (bit-xor a b)))

; 1 when the first n words at `a` and `b` are all equal, 0 otherwise.
; The loop runs all n iterations regardless of where (or whether) a
; difference appears: differences are ACCUMULATED with `bit-or` and the
; verdict is taken once, at the end.
; Returns: Int
(defn ct-eq-words ((a Int) (b Int) (n Int))
  (ct-is-zero (ct-diff-acc a b n 0 0)))

; 1 when the first n words differ anywhere, 0 when they all match.
; Returns: Int
(defn ct-ne-words ((a Int) (b Int) (n Int))
  (ct-is-nonzero (ct-diff-acc a b n 0 0)))

; Accumulated bitwise difference of the first n words. Written as tail
; recursion rather than a `for` loop so the accumulator is a plain
; value: the loop bound `n` is public, and the recursion depth depends
; only on it.
; Returns: Int
(defn ct-diff-acc ((a Int) (b Int) (n Int) (i Int) (acc Int))
  (if (>= i n)
    acc
    (ct-diff-acc a b n (+ i 1) (bit-or acc (bit-xor (w-get a i) (w-get b i))))))

; The one intentional secret-to-control-flow boundary: a caller that
; has already reduced a secret comparison to a single accept/reject bit
; and now must act on it. Everything upstream of this call stays
; branchless.
; Returns: Bool
(defn ct-eq-bool ((a Int) (b Int))
  (= (ct-eq a b) 1))

; Same boundary for the n-word form -- what an AEAD's tag check uses.
; Returns: Bool
(defn ct-eq-words-bool ((a Int) (b Int) (n Int))
  (= (ct-eq-words a b n) 1))

; ===========================================================================
; ERASURE
; ===========================================================================

; Overwrite n words at `base` with zeros and keep the writes: the C
; helper writes through a volatile pointer, so the compiler that
; assembles the runtime cannot delete the stores as dead (the classic
; way a memset-before-free disappears at -O2).
;
; This is EXPLICIT erasure. Zyl does not yet zeroize secret-typed
; values automatically on scope exit -- that needs the TCSecret
; capability and a codegen epilogue hook (MATH_CRYPTO_IMPLEMENTATION_
; PLAN.md Phase 0), neither of which exists yet -- so a caller holding
; key material is responsible for calling this before dropping it.
; Returns: Int
(defn zeroize ((base Int) (n Int))
  (ffi-call "zyl_zeroize" base (* n 8) 1000))

; Overwrite n BYTES at a raw address.
; Returns: Int
(defn zeroize-bytes ((base Int) (n Int))
  (ffi-call "zyl_zeroize" base n 1000))
