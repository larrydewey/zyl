; === Zyl Standard Library — AES-GCM ===
; Module: math/crypto/symmetric/aesgcm
; Provides: AES-128/256-GCM authenticated encryption (NIST SP 800-38D)
;
; AES itself is HARDWARE ONLY (AES-NI, via zyl_aes_encrypt_block in
; runtime/actor_runtime.c). There is no software fallback and that is
; deliberate: every portable AES is a table lookup indexed by
; key-dependent bytes, which leaks the key through the data cache.
; `aes-available` reports whether the CPU can do it, and every entry
; point returns None rather than encrypting with something weaker.
;
; GHASH is implemented here in Zyl rather than with PCLMULQDQ, using
; the bit-by-bit algorithm of SP 800-38D with masked conditionals. It
; runs a fixed 128 iterations per block with no data-dependent branch
; and no table, so it is constant-time; it is also considerably slower
; than a carry-less multiply, which is the trade being made for not
; depending on a second CPU feature.
;
; Nonce rule, and it is absolute: GCM is catastrophically broken by
; nonce reuse. Two messages under the same key and IV leak the XOR of
; their plaintexts AND the GHASH subkey H, which yields tag forgery for
; every future message under that key. Use a counter, never a random
; 96-bit value at scale.
;
; A 12-byte IV is required. The other IV lengths SP 800-38D allows go
; through a GHASH-based derivation that adds a second place for a
; length-handling mistake to live, for no benefit any modern protocol
; asks for.

(use core/core)
(use core/option)
(use math/bits)
(use math/words)
(use math/secret/secret)

; ===========================================================================
; AES PRIMITIVE
; ===========================================================================

; 1 when the CPU has AES-NI.
; Returns: Int
(defn aes-available ()
  (ffi-call "zyl_aesni_available" 1000))

; Encrypt one 16-byte block. Returns the output array, or 0 if AES-NI
; is unavailable or the key length is not 16 or 32 bytes.
; Returns: Int
(defn aes-encrypt-block ((arena Int) (key Int) (keylen Int) (blk Int))
  (let out (w-alloc arena 16)
    (if (= (ffi-call "zyl_aes_encrypt_block" key keylen blk out 1000) 1)
      out
      0)))

; ===========================================================================
; GF(2^128) MULTIPLICATION FOR GHASH
;
; A 128-bit field element is held as two words: index 0 the high 64
; bits, index 1 the low 64 bits, matching the big-endian byte order
; GCM specifies.
; ===========================================================================

; The reduction polynomial's representation, 0xE1 followed by zeros.
; Returns: Int
(defn ghash-r-hi () -2233785415175766016)

; z = x * y in GF(2^128). Both operands and the result are 2-word
; arrays. 128 iterations, every one of them performing the same work:
; the conditional XOR of V into Z and the conditional reduction after
; the shift are both masked, never branched.
; Returns: Int
(defn ghash-mul ((arena Int) (z Int) (x Int) (y Int))
  (let v (w-alloc arena 2)
    (begin
      (w-set z 0 0)
      (w-set z 1 0)
      (w-copy v y 2)
      (for (i 0) (< i 128)
        (begin
          (ghash-mul-step z v x i)
          (set! i (+ i 1))))
      z)))

; Returns: Int
(defn ghash-mul-step ((z Int) (v Int) (x Int) (i Int))
  (let bit (ghash-bit x i)
    (let m (ct-mask bit)
      (begin
        (w-set z 0 (bit-xor (w-get z 0) (bit-and m (w-get v 0))))
        (w-set z 1 (bit-xor (w-get z 1) (bit-and m (w-get v 1))))
        (ghash-shift v)
        0))))

; Bit `i` of a 128-bit value counting from the most significant end.
; Returns: Int
(defn ghash-bit ((x Int) (i Int))
  (if (< i 64)
    (bit-and (shr (w-get x 0) (- 63 i)) 1)
    (bit-and (shr (w-get x 1) (- 127 i)) 1)))

; v = v >> 1, XORing in the reduction polynomial when a set bit fell
; off the bottom.
; Returns: Int
(defn ghash-shift ((v Int))
  (let lsb (bit-and (w-get v 1) 1)
    (let m (ct-mask lsb)
      (let hi (w-get v 0)
        (let lo (w-get v 1)
          (begin
            (w-set v 1 (bit-or (shr lo 1) (shl hi 63)))
            (w-set v 0 (shr hi 1))
            (w-set v 0 (bit-xor (w-get v 0) (bit-and m (ghash-r-hi))))
            0))))))

; ===========================================================================
; GHASH
; ===========================================================================

; Load 16 bytes as a 2-word big-endian value.
; Returns: Int
(defn ghash-load ((arena Int) (buf Int) (off Int))
  (let out (w-alloc arena 2)
    (begin
      (w-set out 0 (ghash-load64 buf off))
      (w-set out 1 (ghash-load64 buf (+ off 8)))
      out)))

; Returns: Int
(defn ghash-load64 ((buf Int) (off Int))
  (ghash-load64-loop buf off 0 0))

; Returns: Int
(defn ghash-load64-loop ((buf Int) (off Int) (i Int) (acc Int))
  (if (>= i 8)
    acc
    (ghash-load64-loop buf off (+ i 1) (bit-or (shl acc 8) (bit-and (w-get buf (+ off i)) 255)))))

; Write a 2-word value as 16 big-endian bytes.
; Returns: Int
(defn ghash-store ((val Int) (out Int) (off Int))
  (begin
    (for (i 0) (< i 8)
      (begin
        (w-set out (+ off i) (bit-and (shr (w-get val 0) (* 8 (- 7 i))) 255))
        (w-set out (+ (+ off 8) i) (bit-and (shr (w-get val 1) (* 8 (- 7 i))) 255))
        (set! i (+ i 1))))
    0))

; y = (y XOR block) * H, the GHASH absorption step. A short final block
; is zero-padded, which is what SP 800-38D specifies.
; Returns: Int
(defn ghash-absorb ((arena Int) (y Int) (h Int) (buf Int) (off Int) (n Int))
  (let blk (ghash-load-padded arena buf off n)
    (let tmp (w-alloc arena 2)
      (begin
        (w-set y 0 (bit-xor (w-get y 0) (w-get blk 0)))
        (w-set y 1 (bit-xor (w-get y 1) (w-get blk 1)))
        (ghash-mul arena tmp y h)
        (w-copy y tmp 2)
        0))))

; Returns: Int
(defn ghash-load-padded ((arena Int) (buf Int) (off Int) (n Int))
  (let pad (w-alloc arena 16)
    (begin
      (for (i 0) (< i n)
        (begin (w-set pad i (w-get buf (+ off i))) (set! i (+ i 1))))
      (ghash-load arena pad 0))))

; GHASH over a whole byte array, absorbing 16 bytes at a time.
; Returns: Int
(defn ghash-bytes ((arena Int) (y Int) (h Int) (buf Int) (len Int))
  (begin
    (for (off 0) (< off len)
      (begin
        (ghash-absorb arena y h buf off (if (< (- len off) 16) (- len off) 16))
        (set! off (+ off 16))))
    0))

; ===========================================================================
; COUNTER MODE
; ===========================================================================

; The pre-counter block J0 = IV || 0x00000001 for a 12-byte IV.
; Returns: Int
(defn gcm-j0 ((arena Int) (iv Int))
  (let j (w-alloc arena 16)
    (begin
      (w-copy j iv 12)
      (w-set j 15 1)
      j)))

; A counter block: J0 with its low 32 bits replaced by `ctr`.
; Returns: Int
(defn gcm-counter ((arena Int) (j0 Int) (ctr Int))
  (let b (w-alloc arena 16)
    (begin
      (w-copy b j0 16)
      (w-set b 12 (bit-and (shr ctr 24) 255))
      (w-set b 13 (bit-and (shr ctr 16) 255))
      (w-set b 14 (bit-and (shr ctr 8) 255))
      (w-set b 15 (bit-and ctr 255))
      b)))

; XOR `len` bytes of `src` with the AES-CTR keystream starting at
; counter value `start`, writing into `dst`. Returns 1 on success, 0 if
; AES is unavailable.
;
; Payload encryption starts at counter 2, NOT 1: counter 1 is J0
; itself, whose encryption is the tag mask. Starting the keystream at
; J0 would XOR the tag mask into the first plaintext block and leave
; the tag computable from the ciphertext -- a total break, and an easy
; one to write by accident.
; Returns: Int
(defn gcm-ctr-xor ((arena Int) (key Int) (keylen Int) (j0 Int) (start Int) (src Int) (dst Int) (len Int))
  (gcm-ctr-loop arena key keylen j0 start src dst len 0))

; Returns: Int
(defn gcm-ctr-loop ((arena Int) (key Int) (keylen Int) (j0 Int) (start Int) (src Int) (dst Int) (len Int) (off Int))
  (if (>= off len)
    1
    (let ks (aes-encrypt-block arena key keylen (gcm-counter arena j0 (+ start (/ off 16))))
      (if (= ks 0)
        0
        (begin
          (gcm-xor-block src dst ks off (if (< (- len off) 16) (- len off) 16))
          (gcm-ctr-loop arena key keylen j0 start src dst len (+ off 16)))))))

; Returns: Int
(defn gcm-xor-block ((src Int) (dst Int) (ks Int) (off Int) (n Int))
  (begin
    (for (i 0) (< i n)
      (begin
        (w-set dst (+ off i) (bit-xor (w-get src (+ off i)) (w-get ks i)))
        (set! i (+ i 1))))
    0))

; ===========================================================================
; TAG
; ===========================================================================

; The GHASH subkey H = AES_K(0^128).
; Returns: Int
(defn gcm-subkey ((arena Int) (key Int) (keylen Int))
  (let zero (w-alloc arena 16)
    (let hb (aes-encrypt-block arena key keylen zero)
      (if (= hb 0)
        0
        (ghash-load arena hb 0)))))

; The authentication tag over (aad, ciphertext). The trailing block of
; bit lengths is what binds the two together -- without it, bytes could
; be moved from one to the other.
; Returns: Int
(defn gcm-tag ((arena Int) (key Int) (keylen Int) (j0 Int) (h Int) (aad Int) (aadlen Int) (ct Int) (ctlen Int))
  (let y (w-alloc arena 2)
    (let lens (w-alloc arena 16)
      (begin
        (ghash-bytes arena y h aad aadlen)
        (ghash-bytes arena y h ct ctlen)
        (gcm-put-len lens 0 (* aadlen 8))
        (gcm-put-len lens 8 (* ctlen 8))
        (ghash-absorb arena y h lens 0 16)
        (gcm-finish-tag arena key keylen j0 y)))))

; Returns: Int
(defn gcm-put-len ((buf Int) (off Int) (bits Int))
  (begin
    (for (i 0) (< i 8)
      (begin
        (w-set buf (+ off i) (bit-and (shr bits (* 8 (- 7 i))) 255))
        (set! i (+ i 1))))
    0))

; Returns: Int
(defn gcm-finish-tag ((arena Int) (key Int) (keylen Int) (j0 Int) (y Int))
  (let mask (aes-encrypt-block arena key keylen j0)
    (if (= mask 0)
      0
      (let tag (w-alloc arena 16)
        (begin
          (ghash-store y tag 0)
          (for (i 0) (< i 16)
            (begin
              (w-set tag i (bit-xor (w-get tag i) (w-get mask i)))
              (set! i (+ i 1))))
          tag)))))

; ===========================================================================
; AEAD INTERFACE
; ===========================================================================

; Encrypt and authenticate. Returns Some(ciphertext || 16-byte tag), or
; None when AES-NI is unavailable or the key length is unsupported.
; Returns: Option
(defn gcm-encrypt ((arena Int) (key Int) (keylen Int) (iv Int) (aad Int) (aadlen Int) (pt Int) (ptlen Int))
  (let h (gcm-subkey arena key keylen)
    (if (= h 0)
      None
      (let j0 (gcm-j0 arena iv)
        (let ct (w-alloc arena (+ ptlen 16))
          (if (= (gcm-ctr-xor arena key keylen j0 2 pt ct ptlen) 0)
            None
            (gcm-seal arena key keylen j0 h aad aadlen ct ptlen)))))))

; Returns: Option
(defn gcm-seal ((arena Int) (key Int) (keylen Int) (j0 Int) (h Int) (aad Int) (aadlen Int) (ct Int) (ptlen Int))
  (let tag (gcm-tag arena key keylen j0 h aad aadlen ct ptlen)
    (if (= tag 0)
      None
      (begin
        (for (i 0) (< i 16)
          (begin (w-set ct (+ ptlen i) (w-get tag i)) (set! i (+ i 1))))
        (Some ct)))))

; Verify and decrypt a sealed message (ciphertext followed by its tag).
; The tag is checked BEFORE any plaintext is produced, with a
; constant-time comparison; a failure returns None and nothing else.
; Returns: Option
(defn gcm-decrypt ((arena Int) (key Int) (keylen Int) (iv Int) (aad Int) (aadlen Int) (sealed Int) (ctlen Int))
  (let h (gcm-subkey arena key keylen)
    (if (= h 0)
      None
      (let j0 (gcm-j0 arena iv)
        (let expect (gcm-tag arena key keylen j0 h aad aadlen sealed ctlen)
          (if (= expect 0)
            None
            (gcm-open arena key keylen j0 sealed ctlen expect)))))))

; Returns: Option
(defn gcm-open ((arena Int) (key Int) (keylen Int) (j0 Int) (sealed Int) (ctlen Int) (expect Int))
  (let given (w-alloc arena 16)
    (begin
      (for (i 0) (< i 16)
        (begin (w-set given i (w-get sealed (+ ctlen i))) (set! i (+ i 1))))
      (if (ct-eq-words-bool expect given 16)
        (gcm-open-verified arena key keylen j0 sealed ctlen)
        None))))

; Returns: Option
(defn gcm-open-verified ((arena Int) (key Int) (keylen Int) (j0 Int) (sealed Int) (ctlen Int))
  (let pt (w-alloc arena (+ ctlen 16))
    (if (= (gcm-ctr-xor arena key keylen j0 2 sealed pt ctlen) 0)
      None
      (Some pt))))
