; === Zyl Standard Library — Big Natural Numbers ===
; Module: math/bignum/bignum
; Provides: fixed-width natural-number arithmetic over math/words
;
; A Nat is a math/words array of `n` limbs, least-significant limb
; first, each holding 24 bits. Its width is FIXED by the caller and
; never derived from the value, which is what makes the operations
; constant-time: a 2048-bit modulus is 86 limbs whether the value in
; it is 2 or 2^2047, and every loop below runs the full limb count.
;
; Why 24-bit limbs rather than the natural 64:
;
;   Zyl's Int is a SIGNED 64-bit machine word and the language has no
;   widening multiply, so a limb product must fit in 63 bits on its
;   own AND leave room for the accumulation of a whole column of them.
;   32-bit limbs already overflow on a single product ((2^32-1)^2 is
;   above 2^63). 24-bit limbs give a 48-bit product, leaving 15 bits of
;   headroom -- enough to accumulate 32768 of them, far more than any
;   key size needs (a 4096-bit modulus is 171 limbs).
;
;   24 bits also divides evenly into bytes (3 per limb), so the
;   byte-string conversions that every protocol needs are exact shifts
;   rather than a bit-level repacking.
;
; Constant-time discipline: add, sub, compare, conditional select and
; multiply all run a fixed number of iterations with no data-dependent
; branch. DIVISION is the exception and is deliberately absent from
; this module -- a constant-time general division is both hard and
; unnecessary, because every secret-dependent reduction in this library
; goes through Montgomery arithmetic (math/bignum/montgomery) instead.

(use core/core)
(use math/bits)
(use math/words)
(use math/secret/secret)

; ===========================================================================
; SHAPE
; ===========================================================================

; Bits per limb.
; Returns: Int
(defn bn-limb-bits () 24)

; Mask of one limb's bits (2^24 - 1).
; Returns: Int
(defn bn-limb-mask () 16777215)

; Limbs needed to hold `bits` bits.
; Returns: Int
(defn bn-limbs-for-bits ((bits Int))
  (/ (+ bits 23) 24))

; Limbs needed to hold `nbytes` bytes.
; Returns: Int
(defn bn-limbs-for-bytes ((nbytes Int))
  (bn-limbs-for-bits (* nbytes 8)))

; Allocate an n-limb Nat, zeroed.
; Returns: Words
(defn bn-alloc ((arena Arena) (n Int))
  (w-alloc arena n))

; Set every limb to zero.
; Returns: Words
(defn bn-zero ((a Words) (n Int))
  (w-fill a n 0))

; Copy n limbs.
; Returns: Words
(defn bn-copy ((dst Words) (src Words) (n Int))
  (w-copy dst src n))

; Set a Nat to a small value (below 2^24).
; Returns: Words
(defn bn-set-small ((a Words) (n Int) (v Int))
  (begin
    (bn-zero a n)
    (w-set a 0 (bit-and v 16777215))
    a))

; ===========================================================================
; ADDITION AND SUBTRACTION
; ===========================================================================

; out = a + b (mod 2^(24n)); returns the carry out of the top limb.
; Returns: Int
(defn bn-add ((out Words) (a Words) (b Words) (n Int))
  (bn-add-loop out a b n 0 0))

; Returns: Int
(defn bn-add-loop ((out Words) (a Words) (b Words) (n Int) (i Int) (carry Int))
  (if (>= i n)
    carry
    (let s (+ (+ (w-get a i) (w-get b i)) carry)
      (begin
        (w-set out i (bit-and s 16777215))
        (bn-add-loop out a b n (+ i 1) (shr s 24))))))

; out = a - b (mod 2^(24n)); returns the borrow out of the top limb
; (1 when a < b). The borrow is extracted from the difference's sign
; bit with a logical shift, not from a comparison, so no branch depends
; on the operand values.
; Returns: Int
(defn bn-sub ((out Words) (a Words) (b Words) (n Int))
  (bn-sub-loop out a b n 0 0))

; Returns: Int
(defn bn-sub-loop ((out Words) (a Words) (b Words) (n Int) (i Int) (borrow Int))
  (if (>= i n)
    borrow
    (let d (- (- (w-get a i) (w-get b i)) borrow)
      (begin
        (w-set out i (bit-and d 16777215))
        (bn-sub-loop out a b n (+ i 1) (bit-and (shr d 63) 1))))))

; out = a + b where b is a single limb; returns the carry.
; Returns: Int
(defn bn-add-limb ((out Words) (a Words) (n Int) (v Int))
  (bn-add-limb-loop out a n 0 (bit-and v 16777215)))

; Returns: Int
(defn bn-add-limb-loop ((out Words) (a Words) (n Int) (i Int) (carry Int))
  (if (>= i n)
    carry
    (let s (+ (w-get a i) carry)
      (begin
        (w-set out i (bit-and s 16777215))
        (bn-add-limb-loop out a n (+ i 1) (shr s 24))))))

; ===========================================================================
; CONSTANT-TIME COMPARISON AND SELECTION
; ===========================================================================

; 1 when every limb is zero, 0 otherwise. Accumulates first, decides
; once -- no early exit.
; Returns: Int
(defn bn-is-zero ((a Words) (n Int))
  (ct-is-zero (bn-or-acc a n 0 0)))

; Returns: Int
(defn bn-or-acc ((a Words) (n Int) (i Int) (acc Int))
  (if (>= i n)
    acc
    (bn-or-acc a n (+ i 1) (bit-or acc (w-get a i)))))

; 1 when a equals b, 0 otherwise, constant-time.
; Returns: Int
(defn bn-eq ((a Words) (b Words) (n Int))
  (ct-eq-words a b n))

; 1 when a < b, 0 otherwise, constant-time. Computed as the borrow out
; of a full-width subtraction into a scratch array, which is exactly
; the "did it go negative" bit and costs no branch.
; Returns: Int
(defn bn-lt ((arena Arena) (a Words) (b Words) (n Int))
  (let scratch (bn-alloc arena n)
    (bn-sub scratch a b n)))

; dst = src when mask is all-ones, unchanged when mask is zero. The
; mask must be 0 or -1 (ct-mask produces exactly that).
; Returns: Int
(defn bn-cond-copy ((dst Words) (src Words) (n Int) (mask Int))
  (begin
    (for (i 0) (< i n)
      (begin
        (w-set dst i (bit-or (bit-and mask (w-get src i)) (bit-and (bit-not mask) (w-get dst i))))
        (set! i (+ i 1))))
    0))

; a = a - b when `cond` is 1, unchanged when it is 0. The subtraction
; ALWAYS runs; only the write-back is masked, so the timing and the
; memory access pattern are identical either way. This is the primitive
; behind every "reduce once if the result overflowed" step.
; Returns: Int
(defn bn-cond-sub ((arena Arena) (a Words) (b Words) (n Int) (cond Int))
  (let scratch (bn-alloc arena n)
    (begin
      (bn-sub scratch a b n)
      (bn-cond-copy a scratch n (ct-mask cond))
      0)))

; ===========================================================================
; SHIFTS
; ===========================================================================

; a = a * 2 (mod 2^(24n)); returns the bit shifted out.
; Returns: Int
(defn bn-shl1 ((a Words) (n Int))
  (bn-shl1-loop a n 0 0))

; Returns: Int
(defn bn-shl1-loop ((a Words) (n Int) (i Int) (carry Int))
  (if (>= i n)
    carry
    (let v (+ (shl (w-get a i) 1) carry)
      (begin
        (w-set a i (bit-and v 16777215))
        (bn-shl1-loop a n (+ i 1) (shr v 24))))))

; a = a / 2, discarding the low bit.
; Returns: Int
(defn bn-shr1 ((a Words) (n Int))
  (bn-shr1-loop a n (- n 1) 0))

; Returns: Int
(defn bn-shr1-loop ((a Words) (n Int) (i Int) (carry Int))
  (if (< i 0)
    0
    (let v (w-get a i)
      (begin
        (w-set a i (bit-or (shr v 1) (shl carry 23)))
        (bn-shr1-loop a n (- i 1) (bit-and v 1))))))

; Bit `k` of a Nat (0 = least significant), as 0 or 1.
; Returns: Int
(defn bn-bit ((a Words) (k Int))
  (bit-and (shr (w-get a (/ k 24)) (% k 24)) 1))

; ===========================================================================
; MULTIPLICATION
; ===========================================================================

; out = a * b, where out has 2n limbs and a, b have n each. Schoolbook:
; n^2 limb products, every one of them executed regardless of operand
; values.
; Returns: Words
(defn bn-mul ((out Words) (a Words) (b Words) (n Int))
  (begin
    (bn-zero out (* 2 n))
    (for (i 0) (< i n)
      (begin
        (bn-mul-row out a b n i)
        (set! i (+ i 1))))
    (bn-normalize out (* 2 n))
    out))

; Propagate carries so every limb again holds exactly 24 bits. The
; row loop leaves ONE limb per row (the one just past the row's own
; span) holding an un-normalized sum of carries -- correct in value,
; since every later read adds it in and re-masks, but the final top
; limb has no later read to fix it. One linear pass settles them all.
; Returns: Int
(defn bn-normalize ((a Words) (n Int))
  (bn-normalize-loop a n 0 0))

; Returns: Int
(defn bn-normalize-loop ((a Words) (n Int) (i Int) (carry Int))
  (if (>= i n)
    carry
    (let v (+ (w-get a i) carry)
      (begin
        (w-set a i (bit-and v 16777215))
        (bn-normalize-loop a n (+ i 1) (shr v 24))))))

; Add a[*] * b[i] shifted by i limbs into the accumulator.
; Returns: Int
(defn bn-mul-row ((out Words) (a Words) (b Words) (n Int) (i Int))
  (let bi (w-get b i)
    (bn-mul-row-loop out a n i 0 bi 0)))

; Returns: Int
(defn bn-mul-row-loop ((out Words) (a Words) (n Int) (i Int) (j Int) (bi Int) (carry Int))
  (if (>= j n)
    (begin
      (w-set out (+ i n) (+ (w-get out (+ i n)) carry))
      0)
    (let t (+ (+ (* (w-get a j) bi) (w-get out (+ i j))) carry)
      (begin
        (w-set out (+ i j) (bit-and t 16777215))
        (bn-mul-row-loop out a n i (+ j 1) bi (shr t 24))))))

; out = a * a (2n limbs). Squaring is routed through the general
; multiply rather than the usual symmetry optimization: the symmetric
; form doubles cross terms and halves the work, but it also makes the
; carry chain depend on the diagonal, and correctness of the plain
; version is easy to see.
; Returns: Words
(defn bn-sqr ((out Words) (a Words) (n Int))
  (bn-mul out a a n))

; ===========================================================================
; BYTE CONVERSION
; ===========================================================================

; Load a big-endian byte string (one byte per word, `nbytes` of them)
; into an n-limb Nat. Bytes beyond the Nat's width are ignored.
; Returns: Words
(defn bn-from-bytes-be ((a Words) (n Int) (bytes Words) (nbytes Int))
  (begin
    (bn-zero a n)
    (for (i 0) (< i nbytes)
      (begin
        (bn-or-byte a n (- (- nbytes 1) i) (w-get bytes i))
        (set! i (+ i 1))))
    a))

; OR one byte into the limb array at byte position `pos` counting from
; the least significant end. A byte can straddle two limbs (24 bits is
; three whole bytes, so in fact it never does -- but the shift form
; below is written so it would still be correct if the limb width
; changed).
; Returns: Int
(defn bn-or-byte ((a Words) (n Int) (pos Int) (v Int))
  (let bitpos (* pos 8)
    (let limb (/ bitpos 24)
      (let off (% bitpos 24)
        (if (>= limb n)
          0
          (begin
            (w-set a limb (bit-and (bit-or (w-get a limb) (shl (bit-and v 255) off)) 16777215))
            (bn-or-byte-carry a n limb off v)))))))

; The part of a straddling byte that lands in the next limb up.
; Returns: Int
(defn bn-or-byte-carry ((a Words) (n Int) (limb Int) (off Int) (v Int))
  (if (<= off 16)
    0
    (if (>= (+ limb 1) n)
      0
      (begin
        (w-set a (+ limb 1) (bit-or (w-get a (+ limb 1)) (shr (bit-and v 255) (- 24 off))))
        0))))

; Write an n-limb Nat as `nbytes` big-endian bytes (one per word).
; Returns: Words
(defn bn-to-bytes-be ((out Words) (nbytes Int) (a Words) (n Int))
  (begin
    (for (i 0) (< i nbytes)
      (begin
        (w-set out i (bn-byte-at a n (- (- nbytes 1) i)))
        (set! i (+ i 1))))
    out))

; Byte `pos` (counting from the least significant end) of a Nat.
; Returns: Int
(defn bn-byte-at ((a Words) (n Int) (pos Int))
  (let bitpos (* pos 8)
    (let limb (/ bitpos 24)
      (let off (% bitpos 24)
        (if (>= limb n)
          0
          (bit-and (bit-or (shr (w-get a limb) off) (bn-byte-carry a n limb off)) 255))))))

; Returns: Int
(defn bn-byte-carry ((a Words) (n Int) (limb Int) (off Int))
  (if (<= off 16)
    0
    (if (>= (+ limb 1) n)
      0
      (shl (w-get a (+ limb 1)) (- 24 off)))))

; Load a little-endian byte string into an n-limb Nat. Curve25519 and
; Ed25519 encode every scalar and coordinate little-endian, so this is
; the conversion those modules actually use.
; Returns: Words
(defn bn-from-bytes-le ((a Words) (n Int) (bytes Words) (nbytes Int))
  (begin
    (bn-zero a n)
    (for (i 0) (< i nbytes)
      (begin
        (bn-or-byte a n i (w-get bytes i))
        (set! i (+ i 1))))
    a))

; Write an n-limb Nat as `nbytes` little-endian bytes.
; Returns: Words
(defn bn-to-bytes-le ((out Words) (nbytes Int) (a Words) (n Int))
  (begin
    (for (i 0) (< i nbytes)
      (begin
        (w-set out i (bn-byte-at a n i))
        (set! i (+ i 1))))
    out))

; The index of the highest set bit plus one, or 0 for a zero value.
;
; VARIABLE TIME, and deliberately so: it scans until it finds a set
; bit, which reveals the value's magnitude. Use it only on public
; quantities -- an RSA public exponent, a modulus's declared size --
; never on a secret scalar, where the whole point of the fixed-width
; representation is that its length says nothing.
; Returns: Int
(defn bn-bit-length ((a Words) (n Int))
  (bn-bit-length-loop a (- (* 24 n) 1)))

; Returns: Int
(defn bn-bit-length-loop ((a Words) (i Int))
  (if (< i 0)
    0
    (if (= (bn-bit a i) 1)
      (+ i 1)
      (bn-bit-length-loop a (- i 1)))))
