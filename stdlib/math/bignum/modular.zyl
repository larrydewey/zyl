; === Zyl Standard Library — Modular Arithmetic ===
; Module: math/bignum/modular
; Provides: modular add/sub/inverse and primality testing
;
; The constant-time operations here (add, sub, inverse-by-Fermat) are
; for secret values. The primality test is NOT constant-time and is
; documented as such: it is for validating PUBLIC parameters -- a
; received modulus, a curve prime, a generated candidate before it
; becomes a key -- where the input is not secret. Primality testing a
; secret prime factor with this would leak it through timing.

(use core/core)
(use math/bits)
(use math/words)
(use math/secret/secret)
(use math/bignum/bignum)
(use math/bignum/montgomery)

; ===========================================================================
; ADD / SUB MOD M
; ===========================================================================

; out = (a + b) mod m, for a, b < m. One conditional subtraction
; suffices because the sum is below 2m; the subtraction always runs and
; only its write-back is masked.
; Returns: Int
(defn mod-add ((arena Int) (out Int) (a Int) (b Int) (m Int) (n Int))
  (let carry (bn-add out a b n)
    (let scratch (bn-alloc arena n)
      (let borrow (bn-sub scratch out m n)
        (let cond (bit-or (ct-is-nonzero carry) (- 1 borrow))
          (begin
            (bn-cond-copy out scratch n (ct-mask cond))
            out))))))

; out = (a - b) mod m, for a, b < m. When the subtraction borrows, the
; modulus is added back -- again masked rather than branched.
; Returns: Int
(defn mod-sub ((arena Int) (out Int) (a Int) (b Int) (m Int) (n Int))
  (let borrow (bn-sub out a b n)
    (let scratch (bn-alloc arena n)
      (begin
        (bn-add scratch out m n)
        (bn-cond-copy out scratch n (ct-mask borrow))
        out))))

; out = (a * 2) mod m.
; Returns: Int
(defn mod-double ((arena Int) (out Int) (a Int) (m Int) (n Int))
  (mod-add arena out a a m n))

; ===========================================================================
; INVERSE
; ===========================================================================

; out = a^-1 mod p for PRIME p, by Fermat's little theorem
; (a^(p-2) = a^-1 mod p). This is the constant-time route to an
; inverse: it is a fixed exponentiation, so unlike the binary extended
; Euclidean algorithm its running time and memory pattern do not
; depend on `a` at all. It costs more multiplications than Euclid, and
; that is the trade being made deliberately.
;
; The modulus must be prime. For a composite modulus the result is
; meaningless (silently, as it is in every Fermat-based inverse).
; Returns: Int
(defn mod-inverse-prime ((arena Int) (out Int) (a Int) (p Int) (n Int))
  (let e (bn-alloc arena n)
    (let two (bn-alloc arena n)
      (begin
        (bn-set-small two n 2)
        (bn-sub e p two n)
        (mont-exp arena out a e (* 24 n) p n)
        out))))

; ===========================================================================
; PRIMALITY (PUBLIC VALUES ONLY)
; ===========================================================================

; Miller-Rabin with the caller's chosen small bases. NOT constant-time:
; it exits as soon as a base proves compositeness, and the loop counts
; depend on the candidate's bits. Use it on public parameters only.
;
; Returns 1 for "probably prime", 0 for "definitely composite".
; Returns: Int
(defn mr-probably-prime ((arena Int) (cand Int) (n Int) (rounds Int))
  (if (= (bn-even cand) 1)
    0
    (mr-rounds arena cand n rounds 2)))

; 1 when the number is even.
; Returns: Int
(defn bn-even ((a Int))
  (- 1 (bit-and (w-get a 0) 1)))

; Try the small prime bases 2, 3, 5, 7, ... for `rounds` of them.
; Returns: Int
(defn mr-rounds ((arena Int) (cand Int) (n Int) (rounds Int) (base Int))
  (if (<= rounds 0)
    1
    (if (= (mr-witness arena cand n base) 0)
      0
      (mr-rounds arena cand n (- rounds 1) (mr-next-base base)))))

; The next small odd base to try.
; Returns: Int
(defn mr-next-base ((b Int))
  (if (= b 2) 3 (+ b 2)))

; 1 when `base` does NOT prove `cand` composite.
;
; Decomposes cand-1 as d * 2^s, computes base^d mod cand, and looks for
; the 1 or -1 that a prime must produce.
; Returns: Int
(defn mr-witness ((arena Int) (cand Int) (n Int) (base Int))
  (let d (bn-alloc arena n)
    (let one (bn-alloc arena n)
      (begin
        (bn-set-small one n 1)
        (bn-sub d cand one n)
        (let s (mr-strip-twos d n 0)
          (mr-check arena cand n base d s))))))

; Halve `d` while it is even, returning how many times.
; Returns: Int
(defn mr-strip-twos ((d Int) (n Int) (count Int))
  (if (= (bit-and (w-get d 0) 1) 1)
    count
    (begin
      (bn-shr1 d n)
      (mr-strip-twos d n (+ count 1)))))

; Returns: Int
(defn mr-check ((arena Int) (cand Int) (n Int) (base Int) (d Int) (s Int))
  (let b (bn-alloc arena n)
    (let x (bn-alloc arena n)
      (let one (bn-alloc arena n)
        (let candm1 (bn-alloc arena n)
          (begin
            (bn-set-small b n base)
            (bn-set-small one n 1)
            (bn-sub candm1 cand one n)
            (mont-exp arena x b d (* 24 n) cand n)
            (if (= (bn-eq x one n) 1)
              1
              (mr-square-loop arena x candm1 cand n s))))))))

; Square up to s-1 times looking for cand-1.
; Returns: Int
(defn mr-square-loop ((arena Int) (x Int) (candm1 Int) (cand Int) (n Int) (s Int))
  (if (<= s 0)
    0
    (if (= (bn-eq x candm1 n) 1)
      1
      (begin
        (mr-square-once arena x cand n)
        (mr-square-loop arena x candm1 cand n (- s 1))))))

; Returns: Int
(defn mr-square-once ((arena Int) (x Int) (cand Int) (n Int))
  (let two (bn-alloc arena n)
    (begin
      (bn-set-small two n 2)
      (mont-exp arena x x two (* 24 n) cand n)
      0)))
