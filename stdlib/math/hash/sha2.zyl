; === Zyl Standard Library — SHA-2 ===
; Module: math/hash/sha2
; Provides: SHA-256 (FIPS 180-4 / RFC 6234)
;
; Straight reference implementation over math/words arrays. Message
; bytes live one-per-word (8 bytes of storage per message byte): this
; costs memory but keeps the whole implementation on the plain Int
; path, with no dependence on the byte-buffer primitives' own
; endianness handling, and every word already carries the 0..255 range
; SHA-2 expects.
;
; Constant-time by construction, and it is worth being precise about
; why rather than asserting it: SHA-256's control flow is fixed by the
; message LENGTH alone (64 rounds per block, a block count derived from
; the length), never by message CONTENT, and every operation on a
; content-derived value here is one of add32/bit-and/bit-or/bit-xor/
; rotr32/shr32 -- all of which compile to a single branchless machine
; instruction sequence (codegen.zyl's cg-bit-mnem/cg-arith-mnem) whose
; timing does not depend on operand values. No table is indexed by a
; content-derived value: `sha256-k-table` is indexed by the round
; counter, which is public. Message length is NOT a secret in any
; construction here (it is public in HMAC, HKDF and every signature
; scheme that uses this).

(use core/core)
(use math/bits)
(use math/words)

; ===========================================================================
; CONSTANTS
; ===========================================================================

; The 64 round constants: the first 32 bits of the fractional parts of
; the cube roots of the first 64 primes (FIPS 180-4 s4.2.2). Built into
; an arena array rather than a 64-deep `if` chain so the lookup is a
; single indexed load and the compiler never sees a 64-level nesting.
; Returns: Words
(defn sha256-k-table ((arena Arena))
  (let p (w-alloc arena 64)
    (begin
      (w-set p 0 1116352408)
      (w-set p 1 1899447441)
      (w-set p 2 3049323471)
      (w-set p 3 3921009573)
      (w-set p 4 961987163)
      (w-set p 5 1508970993)
      (w-set p 6 2453635748)
      (w-set p 7 2870763221)
      (w-set p 8 3624381080)
      (w-set p 9 310598401)
      (w-set p 10 607225278)
      (w-set p 11 1426881987)
      (w-set p 12 1925078388)
      (w-set p 13 2162078206)
      (w-set p 14 2614888103)
      (w-set p 15 3248222580)
      (w-set p 16 3835390401)
      (w-set p 17 4022224774)
      (w-set p 18 264347078)
      (w-set p 19 604807628)
      (w-set p 20 770255983)
      (w-set p 21 1249150122)
      (w-set p 22 1555081692)
      (w-set p 23 1996064986)
      (w-set p 24 2554220882)
      (w-set p 25 2821834349)
      (w-set p 26 2952996808)
      (w-set p 27 3210313671)
      (w-set p 28 3336571891)
      (w-set p 29 3584528711)
      (w-set p 30 113926993)
      (w-set p 31 338241895)
      (w-set p 32 666307205)
      (w-set p 33 773529912)
      (w-set p 34 1294757372)
      (w-set p 35 1396182291)
      (w-set p 36 1695183700)
      (w-set p 37 1986661051)
      (w-set p 38 2177026350)
      (w-set p 39 2456956037)
      (w-set p 40 2730485921)
      (w-set p 41 2820302411)
      (w-set p 42 3259730800)
      (w-set p 43 3345764771)
      (w-set p 44 3516065817)
      (w-set p 45 3600352804)
      (w-set p 46 4094571909)
      (w-set p 47 275423344)
      (w-set p 48 430227734)
      (w-set p 49 506948616)
      (w-set p 50 659060556)
      (w-set p 51 883997877)
      (w-set p 52 958139571)
      (w-set p 53 1322822218)
      (w-set p 54 1537002063)
      (w-set p 55 1747873779)
      (w-set p 56 1955562222)
      (w-set p 57 2024104815)
      (w-set p 58 2227730452)
      (w-set p 59 2361852424)
      (w-set p 60 2428436474)
      (w-set p 61 2756734187)
      (w-set p 62 3204031479)
      (w-set p 63 3329325298)
      p)))

; Initial hash state: the first 32 bits of the fractional parts of the
; square roots of the first 8 primes (FIPS 180-4 s5.3.3).
; Returns: Words
(defn sha256-init ((arena Arena))
  (let p (w-alloc arena 8)
    (begin
      (w-set p 0 1779033703)
      (w-set p 1 3144134277)
      (w-set p 2 1013904242)
      (w-set p 3 2773480762)
      (w-set p 4 1359893119)
      (w-set p 5 2600822924)
      (w-set p 6 528734635)
      (w-set p 7 1541459225)
      p)))

; ===========================================================================
; MESSAGE SCHEDULE
; ===========================================================================

; Expand w[0..15] (already loaded) into w[16..63] in place.
; Returns: Words
(defn sha256-schedule ((wp Words))
  (begin
    (for (i 16) (< i 64)
      (begin
        (sha256-schedule-step wp i)
        (set! i (+ i 1))))
    wp))

; One schedule step: w[i] = w[i-16] + s0(w[i-15]) + w[i-7] + s1(w[i-2]).
; Returns: Int
(defn sha256-schedule-step ((wp Words) (i Int))
  (let x (w-get wp (- i 15))
    (let y (w-get wp (- i 2))
      (let s0 (bit-xor (rotr32 x 7) (rotr32 x 18) (shr32 x 3))
        (let s1 (bit-xor (rotr32 y 17) (rotr32 y 19) (shr32 y 10))
          (let lhs (add32 (w-get wp (- i 16)) s0)
            (let rhs (add32 (w-get wp (- i 7)) s1)
              (w-set wp i (add32 lhs rhs)))))))))

; Load 16 big-endian 32-bit words from the 64 message bytes starting at
; `off`, then expand them to the full 64-word schedule.
; Returns: Words
(defn sha256-load-block ((arena Arena) (msg Words) (off Int))
  (let wp (w-alloc arena 64)
    (begin
      (for (t 0) (< t 16)
        (begin
          (sha256-load-word wp msg (+ off (* t 4)) t)
          (set! t (+ t 1))))
      (sha256-schedule wp))))

; Returns: Int
(defn sha256-load-word ((wp Words) (msg Words) (o Int) (t Int))
  (let b0 (w-get msg o)
    (let b1 (w-get msg (+ o 1))
      (let b2 (w-get msg (+ o 2))
        (let b3 (w-get msg (+ o 3))
          (w-set wp t (be-pack32 b0 b1 b2 b3)))))))

; ===========================================================================
; COMPRESSION
; ===========================================================================

; One of the 64 rounds, updating the eight working variables held in
; `wv` (a 0..7 word array standing in for a..h).
; Returns: Int
(defn sha256-round ((wv Words) (kp Words) (wp Words) (i Int))
  (let a (w-get wv 0)
    (let b (w-get wv 1)
      (let c (w-get wv 2)
        (let d (w-get wv 3)
          (let e (w-get wv 4)
            (let f (w-get wv 5)
              (let g (w-get wv 6)
                (let h (w-get wv 7)
                  (let s1 (bit-xor (rotr32 e 6) (rotr32 e 11) (rotr32 e 25))
                    (let ch (bit-xor (bit-and e f) (bit-and (not32 e) g))
                      (let s0 (bit-xor (rotr32 a 2) (rotr32 a 13) (rotr32 a 22))
                        (let mj (bit-xor (bit-and a b) (bit-and a c) (bit-and b c))
                          (let t1 (sha256-t1 h s1 ch (w-get kp i) (w-get wp i))
                            (let t2 (add32 s0 mj)
                              (sha256-shift-vars wv a b c d e f g t1 t2))))))))))))))))

; t1 = h + S1(e) + Ch(e,f,g) + K[i] + W[i], all mod 2^32.
; Returns: Int
(defn sha256-t1 ((h Int) (s1 Int) (ch Int) (k Int) (w Int))
  (let p1 (add32 h s1)
    (let p2 (add32 ch k)
      (add32 (add32 p1 p2) w))))

; a..h <- t1+t2, a, b, c, d+t1, e, f, g.
; Returns: Int
(defn sha256-shift-vars ((wv Words) (a Int) (b Int) (c Int) (d Int) (e Int) (f Int) (g Int) (t1 Int) (t2 Int))
  (begin
    (w-set wv 7 g)
    (w-set wv 6 f)
    (w-set wv 5 e)
    (w-set wv 4 (add32 d t1))
    (w-set wv 3 c)
    (w-set wv 2 b)
    (w-set wv 1 a)
    (w-set wv 0 (add32 t1 t2))
    0))

; Compress the 64-byte block at msg[off..off+64) into `state`.
; Returns: Words
(defn sha256-compress ((arena Arena) (state Words) (msg Words) (off Int) (kp Words))
  (let wp (sha256-load-block arena msg off)
    (let wv (w-alloc arena 8)
      (begin
        (w-copy wv state 8)
        (for (i 0) (< i 64)
          (begin
            (sha256-round wv kp wp i)
            (set! i (+ i 1))))
        (for (j 0) (< j 8)
          (begin
            (w-set state j (add32 (w-get state j) (w-get wv j)))
            (set! j (+ j 1))))
        state))))

; ===========================================================================
; PADDING
; ===========================================================================

; Number of zero bytes between the 0x80 terminator and the 8-byte
; length field, so that the total is a multiple of 64.
; Returns: Int
(defn sha256-pad-zeros ((len Int))
  (let r (% (+ len 1) 64)
    (if (<= r 56) (- 56 r) (- 120 r))))

; Total padded length in bytes.
; Returns: Int
(defn sha256-padded-len ((len Int))
  (+ (+ len 9) (sha256-pad-zeros len)))

; Build the padded message: the message, a 0x80 byte, zeros, then the
; original length in BITS as a 64-bit big-endian value. The zero run
; needs no explicit writing -- w-alloc hands back zeroed arena memory.
; Returns: Words
(defn sha256-pad ((arena Arena) (msg Words) (len Int))
  (let total (sha256-padded-len len)
    (let p (w-alloc arena total)
      (begin
        (w-copy p msg len)
        (w-set p len 128)
        (sha256-write-length p total (* len 8))
        p))))

; Returns: Words
(defn sha256-write-length ((p Words) (total Int) (bits Int))
  (begin
    (for (i 0) (< i 8)
      (begin
        (w-set p (+ (- total 8) i) (be-byte64 bits i))
        (set! i (+ i 1))))
    p))

; ===========================================================================
; TOP-LEVEL DIGEST
; ===========================================================================

; SHA-256 of the `len` message bytes held one-per-word at `msg`.
; Returns an 8-word array holding the digest as big-endian 32-bit words.
; Returns: Words
(defn sha256-words ((arena Arena) (msg Words) (len Int))
  (let kp (sha256-k-table arena)
    (let st (sha256-init arena)
      (let padded (sha256-pad arena msg len)
        (let total (sha256-padded-len len)
          (begin
            (for (off 0) (< off total)
              (begin
                (sha256-compress arena st padded off kp)
                (set! off (+ off 64))))
            st))))))

; SHA-256 digest as a 32-entry byte array (one byte per word).
; Returns: Words
(defn sha256-bytes ((arena Arena) (msg Words) (len Int))
  (let st (sha256-words arena msg len)
    (let out (w-alloc arena 32)
      (begin
        (for (i 0) (< i 8)
          (begin
            (sha256-spread-word out st i)
            (set! i (+ i 1))))
        out))))

; Returns: Int
(defn sha256-spread-word ((out Words) (st Words) (i Int))
  (let v (w-get st i)
    (begin
      (w-set out (* i 4) (be-byte32 v 0))
      (w-set out (+ (* i 4) 1) (be-byte32 v 1))
      (w-set out (+ (* i 4) 2) (be-byte32 v 2))
      (w-set out (+ (* i 4) 3) (be-byte32 v 3))
      0)))

; SHA-256 of a String, as a 64-character lowercase hex String.
; Returns: String
(defn sha256-hex-of-string ((arena Arena) (s String))
  (let msg (w-from-string arena s)
    (let len (w-string-len s)
      (let st (sha256-words arena msg len)
        (w-hex-words st 8)))))
