; === Zyl Standard Library — BLAKE2b ===
; Module: math/hash/blake2b
; Provides: BLAKE2b (RFC 7693), keyed or unkeyed, 1..64 byte digests
;
; BLAKE2b is here primarily because Argon2 is defined in terms of it
; (RFC 9106), but it stands on its own: faster than SHA-2 in software,
; with a built-in keyed mode that replaces HMAC.
;
; The state is eight 64-bit words and the message is absorbed in
; 128-byte blocks. As everywhere else in this library, 64-bit words
; with the top bit set are negative Ints; BLAKE2b only adds, XORs and
; rotates them, all of which are two's-complement-identical for signed
; and unsigned operands.
;
; Constant-time: 12 fixed rounds per block, a message schedule indexed
; by a compile-time constant table, and no branch on any message or key
; byte. The one length-dependent decision -- whether a block is the
; last -- depends on the message length, which is public.

(use core/core)
(use math/bits)
(use math/words)
(use math/secret/secret)

; ===========================================================================
; CONSTANTS
; ===========================================================================

; The BLAKE2b IV: the same eight words as SHA-512's initial state
; (fractional parts of the square roots of the first eight primes).
; Returns: Words
(defn blake2b-iv ((arena Arena))
  (let p (w-alloc arena 8)
    (begin
      (w-set p 0 7640891576956012808)
      (w-set p 1 -4942790177534073029)
      (w-set p 2 4354685564936845355)
      (w-set p 3 -6534734903238641935)
      (w-set p 4 5840696475078001361)
      (w-set p 5 -7276294671716946913)
      (w-set p 6 2270897969802886507)
      (w-set p 7 6620516959819538809)
      p)))

; The message-word permutation sigma, 12 rounds of 16 indices, flattened.
; Returns: Words
(defn blake2b-sigma ((arena Arena))
  (let p (w-alloc arena 192)
    (begin
      (w-set p 0 0)
      (w-set p 1 1)
      (w-set p 2 2)
      (w-set p 3 3)
      (w-set p 4 4)
      (w-set p 5 5)
      (w-set p 6 6)
