; ===========================================================================
; COMPRESSION
; ===========================================================================

; The G mixing function on four words of the working state, indexed
; rather than passed by value so the caller can keep the state in one
; array.
; Returns: Int
(defn blake2b-g ((v Words) (ia Int) (ib Int) (ic Int) (id Int) (x Int) (y Int))
  (begin
    (blake2b-g-half v ia ib ic id x 32 24)
    (blake2b-g-half v ia ib ic id y 16 63)
    0))

; One half of G: a += b + m; d = rotr(d^a, r1); c += d; b = rotr(b^c, r2).
; Returns: Int
(defn blake2b-g-half ((v Words) (ia Int) (ib Int) (ic Int) (id Int) (m Int) (r1 Int) (r2 Int))
  (let a (+ (+ (w-get v ia) (w-get v ib)) m)
    (let d (rotr64 (bit-xor (w-get v id) a) r1)
      (let c (+ (w-get v ic) d)
        (let b (rotr64 (bit-xor (w-get v ib) c) r2)
          (begin
            (w-set v ia a)
            (w-set v id d)
            (w-set v ic c)
            (w-set v ib b)
            0))))))

; One round: four column mixes then four diagonal mixes.
; Returns: Int
(defn blake2b-round ((v Words) (m Words) (sigma Words) (r Int))
  (let s (* r 16)
    (begin
      (blake2b-g v 0 4 8 12 (w-get m (w-get sigma s)) (w-get m (w-get sigma (+ s 1))))
      (blake2b-g v 1 5 9 13 (w-get m (w-get sigma (+ s 2))) (w-get m (w-get sigma (+ s 3))))
      (blake2b-g v 2 6 10 14 (w-get m (w-get sigma (+ s 4))) (w-get m (w-get sigma (+ s 5))))
      (blake2b-g v 3 7 11 15 (w-get m (w-get sigma (+ s 6))) (w-get m (w-get sigma (+ s 7))))
      (blake2b-g v 0 5 10 15 (w-get m (w-get sigma (+ s 8))) (w-get m (w-get sigma (+ s 9))))
      (blake2b-g v 1 6 11 12 (w-get m (w-get sigma (+ s 10))) (w-get m (w-get sigma (+ s 11))))
      (blake2b-g v 2 7 8 13 (w-get m (w-get sigma (+ s 12))) (w-get m (w-get sigma (+ s 13))))
      (blake2b-g v 3 4 9 14 (w-get m (w-get sigma (+ s 14))) (w-get m (w-get sigma (+ s 15))))
      0)))

; Compress one 128-byte block into the state. `t` is the byte counter
; including this block; `last` is 1 for the final block, which inverts
; v[14] and is what stops a block of one message being reusable as the
; final block of another.
; Returns: Int
(defn blake2b-compress ((arena Arena) (h Words) (m Words) (t Int) (last Int))
  (let v (w-alloc arena 16)
    (let iv (blake2b-iv arena)
      (let sigma (blake2b-sigma arena)
        (begin
          (w-copy v h 8)
          (for (i 0) (< i 8)
            (begin (w-set v (+ 8 i) (w-get iv i)) (set! i (+ i 1))))
          (w-set v 12 (bit-xor (w-get v 12) t))
          (w-set v 14 (bit-xor (w-get v 14) (ct-mask last)))
          (for (r 0) (< r 12)
            (begin (blake2b-round v m sigma r) (set! r (+ r 1))))
          (for (j 0) (< j 8)
            (begin
              (w-set h j (bit-xor (w-get h j) (bit-xor (w-get v j) (w-get v (+ 8 j)))))
              (set! j (+ j 1))))
          0)))))

; ===========================================================================
; SPONGE-STYLE DRIVER
; ===========================================================================

; Load 16 little-endian 64-bit words from a 128-byte block of the
; message, zero-padding a short final block.
; Returns: Words
(defn blake2b-load-block ((arena Arena) (msg Words) (off Int) (len Int))
  (let m (w-alloc arena 16)
    (begin
      (for (i 0) (< i 16)
        (begin
          (w-set m i (blake2b-le64 msg (+ off (* i 8)) len))
          (set! i (+ i 1))))
      m)))

; Returns: Int
(defn blake2b-le64 ((msg Words) (off Int) (len Int))
  (blake2b-le64-loop msg off len 7 0))

; Returns: Int
(defn blake2b-le64-loop ((msg Words) (off Int) (len Int) (i Int) (acc Int))
  (if (< i 0)
    acc
    (let byte (if (< (+ off i) len) (w-get msg (+ off i)) 0)
      (blake2b-le64-loop msg off len (- i 1) (bit-or (shl acc 8) (bit-and byte 255))))))

; Initial state: the IV with the parameter block XORed into the first
; word. The parameter block encodes digest length, key length, fanout
; and depth, which is what makes a keyed 32-byte BLAKE2b a different
; function from an unkeyed 64-byte one rather than a truncation of it.
; Returns: Words
(defn blake2b-init ((arena Arena) (outlen Int) (keylen Int))
  (let h (w-copy (w-alloc arena 8) (blake2b-iv arena) 8)
    (begin
      (w-set h 0 (bit-xor (w-get h 0) (bit-or 16842752 (bit-or (shl keylen 8) outlen))))
      h)))

; BLAKE2b with an optional key. `keylen` of 0 means unkeyed; a keyed
; hash prepends a zero-padded 128-byte block holding the key, exactly
; as RFC 7693 s3.3 specifies.
; Returns: Words
(defn blake2b ((arena Arena) (msg Words) (msglen Int) (key Words) (keylen Int) (outlen Int))
  (let h (blake2b-init arena outlen keylen)
    (let input (blake2b-prepare arena msg msglen key keylen)
      (let total (+ msglen (if (> keylen 0) 128 0))
        (begin
          (blake2b-absorb arena h input total)
          (blake2b-emit arena h outlen))))))

; The message with the key block in front of it, when keyed.
; Returns: Words
(defn blake2b-prepare ((arena Arena) (msg Words) (msglen Int) (key Words) (keylen Int))
  (if (= keylen 0)
    msg
    (let buf (w-alloc arena (+ msglen 128))
      (begin
        (w-copy buf key keylen)
        (for (i 0) (< i msglen)
          (begin (w-set buf (+ 128 i) (w-get msg i)) (set! i (+ i 1))))
        buf))))

; Absorb the whole input. An empty input still compresses one zero
; block -- BLAKE2b's definition, not an edge case to skip.
; Returns: Int
(defn blake2b-absorb ((arena Arena) (h Words) (input Words) (total Int))
  (if (= total 0)
    (blake2b-compress arena h (w-alloc arena 16) 0 1)
    (blake2b-absorb-loop arena h input total 0)))

; Returns: Int
(defn blake2b-absorb-loop ((arena Arena) (h Words) (input Words) (total Int) (off Int))
  (if (>= off total)
    0
    (let last (if (>= (+ off 128) total) 1 0)
      (let counter (if (= last 1) total (+ off 128))
        (begin
          (blake2b-compress arena h (blake2b-load-block arena input off total) counter last)
          (blake2b-absorb-loop arena h input total (+ off 128)))))))

; The first `outlen` bytes of the state, little-endian.
; Returns: Words
(defn blake2b-emit ((arena Arena) (h Words) (outlen Int))
  (let out (w-alloc arena outlen)
    (begin
      (for (i 0) (< i outlen)
        (begin
          (w-set out i (bit-and (shr (w-get h (/ i 8)) (* 8 (% i 8))) 255))
          (set! i (+ i 1))))
      out)))

; Unkeyed BLAKE2b-512.
; Returns: Words
(defn blake2b-512 ((arena Arena) (msg Words) (msglen Int))
  (blake2b arena msg msglen (w-alloc arena 1) 0 64))

; Returns: String
(defn blake2b-hex-of-string ((arena Arena) (s String) (outlen Int))
  (let msg (w-from-string arena s)
    (w-hex-bytes (blake2b arena msg (w-string-len s) (w-alloc arena 1) 0 outlen) outlen)))
