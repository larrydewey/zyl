; === Zyl Standard Library — Result ADT ===
; Module: result
; Provides: Generic Result<T, E> ADT and helpers
;
; Cross-module conversions (result-to-option, result-from-option) are in core/core.zyl
; to avoid a circular dependency between result and option modules.

; ===========================================================================
; RESULT ADT — Generic: Result<T, E>
; ===========================================================================

(deftype Result (Ok T) (Err E))

; ===========================================================================
; RESULT OPERATIONS
; ===========================================================================

(defn result-unwrap (res default)
  (match res
    (Ok v v)
    (Err w1x default)))

(defn result-is-ok (res)
  (match res
    (Ok w2x true)
    (Err w3x false)))

(defn result-is-err (res)
  (match res
    (Ok w4x false)
    (Err w5x true)))

(defn result-map (res f)
  (match res
    (Ok v (Ok (f v)))
    (Err e (Err e))))

(defn result-and (res other)
  (match res
    (Ok w6x other)
    (Err w7x res)))

(defn result-or (res other)
  (match res
    (Ok w8x res)
    (Err w9x other)))

(defn result-expect (res msg)
  (match res
    (Ok v v)
    (Err w10x (error msg))))

(defn result-unwrap-or (res default)
  (match res
    (Ok v v)
    (Err w11x default)))

; ===========================================================================
; RESULT CONSTRUCTORS
; ===========================================================================

(defn result-ok (v) (Ok v))

(defn result-err (e) (Err e))

; ===========================================================================
; RESULT UTILITIES
; ===========================================================================

(defn result-flatmap (res f)
  (match res
    (Ok v (f v))
    (Err e (Err e))))

(defn result-inspect (res f)
  (match res
    (Ok v (begin (f v) res))
    (Err e (begin (f e) res))))

; ===========================================================================
; RESULT COMBINATORS
; ===========================================================================

(defn result-and-then (res f)
  (result-flatmap res f))

(defn result-or-else (res f)
  (match res
    (Ok v (Ok v))
    (Err e (f e))))
