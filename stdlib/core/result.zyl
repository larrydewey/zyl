; === Zyl Standard Library — Result ADT ===
; Module: core/result
; Provides: Generic Result<T, E> ADT and helpers
;
; Cross-module conversions (result-to-option, result-from-option) are in core/core.zyl
; to avoid a circular dependency between result and option modules.

; ===========================================================================
; RESULT ADT — Generic: Result<T, E>
; ===========================================================================

(use core/show)
(use allocator/allocator)

(deftype Result (Ok T) (Err E))

; (error msg) returns (Err msg) and does not raise (spec 21.8): the
; error-as-value half, and the one a caller handles by matching. To
; unwind to the nearest try/catch instead -- which is what `panic` in
; allocator does, and what result-expect below wants -- say `panic`.
; The two live apart on purpose: this one has to name Err, and Err is
; declared here, in a module that depends on allocator, so allocator
; cannot define this without a dependency cycle.
(defn error (msg)
  (Err msg))

; ===========================================================================
; RESULT OPERATIONS
; ===========================================================================

(defn result-unwrap (res default)
  (match res
    (Ok v v)
    (Err _ default)))

(defn result-is-ok (res)
  (match res
    (Ok _ true)
    (Err _ false)))

(defn result-is-err (res)
  (match res
    (Ok _ false)
    (Err _ true)))

(defn result-map (res f)
  (match res
    (Ok v (Ok (f v)))
    (Err e (Err e))))

(defn result-and (res other)
  (match res
    (Ok _ other)
    (Err _ res)))

(defn result-or (res other)
  (match res
    (Ok _ res)
    (Err _ other)))

(defn result-expect (res msg)
  (match res
    (Ok v v)
    (Err _ (panic msg))))

(defn result-unwrap-or (res default)
  (match res
    (Ok v v)
    (Err _ default)))

; ===========================================================================
; RESULT CONSTRUCTORS
; ===========================================================================

(defn result-ok (v) (Ok v))

(defn result-err (e) (Err e))

; ===========================================================================
; RESULT UTILITIES
; ===========================================================================

(defn result-flatmap (res f)
  (match res
    (Ok v (f v))
    (Err e (Err e))))

(defn result-inspect (res f)
  (match res
    (Ok v (begin (f v) res))
    (Err e (begin (f e) res))))

; ===========================================================================
; RESULT COMBINATORS
; ===========================================================================

(defn result-and-then (res f)
  (result-flatmap res f))

(defn result-or-else (res f)
  (match res
    (Ok v (Ok v))
    (Err e (f e))))

(impl Show Result
  (defn show (self)
    (match self
      (Ok x (str-concat "Ok(" (str-concat (Show.show x) ")")))
      (Err e (str-concat "Err(" (str-concat (Show.show e) ")"))))))

(impl Debug Result
  (defn debug (self)
    (match self
      (Ok x (str-concat "Ok(" (str-concat (Debug.debug x) ")")))
      (Err e (str-concat "Err(" (str-concat (Debug.debug e) ")"))))))

(impl Eq Result (defn eq (self other) (== self other)))

; Ok sorts before Err.
(impl Ord Result
  (defn compare (self other)
    (match self
      (Ok x (match other (Ok y (Ord.compare x y)) (Err _ -1)))
      (Err e (match other (Ok _ 1) (Err f (Ord.compare e f)))))))

(impl Hash Result
  (defn hash (self)
    (match self
      (Ok x (int-wrap-mul (bit-xor 1469598103934665603 (Hash.hash x)) 1099511628211))
      (Err e (int-wrap-mul (bit-xor 1099511628211 (Hash.hash e)) 1469598103934665603)))))

(impl Clone Result (defn clone (self) self))
