; === Zyl Standard Library — Option ADT ===
; Module: option
; Provides: Generic Option<T> definition and helpers

; ===========================================================================
; GENERIC OPTION
; ===========================================================================

(deftype Option (Some T) None)

(defn option-unwrap (opt default)
  (match opt
    (Some v) v
    (None) default))

(defn option-is-some (opt)
  (match opt
    (Some _) true
    (None) false))

(defn option-is-none (opt)
  (match opt
    (Some _) false
    (None) true))
