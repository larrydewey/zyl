; === Zyl Standard Library — Option ADT ===
; Module: option
; Provides: Generic Option<T> ADT and helpers
;
; Cross-module conversions (option-to-result, option-from-result) are in core/core.zyl
; to avoid a circular dependency between option and result modules.

; ===========================================================================
; OPTION ADT — Generic: Option<T>
; ===========================================================================

(use core/show)
(use allocator/allocator)

(deftype Option (Some T) None)

; ===========================================================================
; OPTION OPERATIONS
; ===========================================================================

(defn option-unwrap (opt default)
  (match opt
    (Some v v)
    (None default)))

(defn option-is-some (opt)
  (match opt
    (Some _ true)
    (None false)))

(defn option-is-none (opt)
  (match opt
    (Some _ false)
    (None true)))

(defn option-map (opt f)
  (match opt
    (Some v (Some (f v)))
    (None None)))

(defn option-and (opt other)
  (match opt
    (Some _ other)
    (None None)))

(defn option-or (opt other)
  (match opt
    (Some _ opt)
    (None other)))

(defn option-expect (opt msg)
  (match opt
    (Some v v)
    (None (error msg))))

(defn option-unwrap-or (opt default)
  (match opt
    (Some v v)
    (None default)))

; ===========================================================================
; OPTION CONSTRUCTORS
; ===========================================================================

(defn option-none () None)

(defn option-some (x) (Some x))

; ===========================================================================
; OPTION UTILITIES
; ===========================================================================

(defn option-flatmap (opt f)
  (match opt
    (Some v (f v))
    (None None)))

(defn option-inspect (opt f)
  (match opt
    (Some v (begin (f v) opt))
    (None opt)))

(impl Show Option
  (defn show (self)
    (match self
      (Some x (str-concat "Some(" (str-concat (Show.show x) ")")))
      (None "None"))))

(impl Debug Option
  (defn debug (self)
    (match self
      (Some x (str-concat "Some(" (str-concat (Debug.debug x) ")")))
      (None "None"))))

(impl Eq Option (defn eq (self other) (== self other)))

; None sorts before Some.
(impl Ord Option
  (defn compare (self other)
    (match self
      (None (match other (None 0) (Some _ -1)))
      (Some x (match other (None 1) (Some y (Ord.compare x y)))))))

(impl Hash Option
  (defn hash (self)
    (match self
      (None 1469598103934665603)
      (Some x (* (bit-xor 1469598103934665603 (Hash.hash x)) 1099511628211)))))

(impl Clone Option (defn clone (self) self))
