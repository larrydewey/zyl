; === Zyl Standard Library — Core ===
; Module: core
; Provides: all standard library types and functions (inlined)

; ===========================================================================
; OPTION ADT
; ===========================================================================

(deftype OptionInt (SomeInt Int) None)
(deftype OptionBool (SomeBool Bool) None)

(defn option-int-unwrap (opt default)
  (match opt
    (SomeInt v) v
    (None) default))

(defn option-int-is-some (opt)
  (match opt
    (SomeInt _) true
    (None) false))

(defn option-int-is-none (opt)
  (match opt
    (SomeInt _) false
    (None) true))

(defn option-bool-unwrap (opt default)
  (match opt
    (SomeBool v) v
    (None) default))

(defn option-bool-is-some (opt)
  (match opt
    (SomeBool _) true
    (None) false))

(defn option-bool-is-none (opt)
  (match opt
    (SomeBool _) false
    (None) true))

; ===========================================================================
; RESULT ADT
; ===========================================================================

(deftype ResultInt (OkInt Int) (ErrInt String))

(defn result-int-unwrap (res default)
  (match res
    (OkInt v) v
    (ErrInt _) default))

(defn result-int-is-ok (res)
  (match res
    (OkInt _) true
    (ErrInt _) false))

(defn result-int-is-err (res)
  (match res
    (OkInt _) false
    (ErrInt _) true))

; ===========================================================================
; LIST ADT
; ===========================================================================

(deftype List (Cons Int (List)) None)

(defn is-nil (xs)
  (match xs
    (Cons _ _) false
    (None) true))

(defn list-car (xs)
  (match xs
    (Cons v _) (SomeInt v)
    (None) None))

(defn list-cdr (xs)
  (match xs
    (Cons _ rest) rest
    (None) None))

(defn list-head (xs)
  (match xs
    (Cons v _) (SomeInt v)
    (None) None))

(defn list-tail (xs)
  (match xs
    (Cons _ rest) rest
    (None) None))

(defn list-length (xs)
  (match xs
    (None) 0
    (Cons _ rest) (+ 1 (list-length rest))))

(defn list-append (xs ys)
  (match xs
    (None) ys
    (Cons h t) (Cons h (list-append t ys))))

(defn list-reverse (xs)
  (list-reverse-acc xs None))

(defn list-reverse-acc (xs acc)
  (match xs
    (None) acc
    (Cons h t) (list-reverse-acc t (Cons h acc))))

(defn list-sum (xs)
  (match xs
    (None) 0
    (Cons h t) (+ h (list-sum t))))

(defn list-product (xs)
  (match xs
    (None) 1
    (Cons h t) (* h (list-product t))))

; ===========================================================================
; COMBINATORS
; ===========================================================================

(defn identity (x) x)

(defn const (a _b) a)

; ===========================================================================
; ARITHMETIC HELPERS
; ===========================================================================

(defn abs (x)
  (if (< x 0) (- 0 x) x))

(defn max (a b)
  (if (> a b) a b))

(defn min (a b)
  (if (< a b) a b))

(defn clamp (x lo hi)
  (if (< x lo) lo (if (> x hi) hi x)))

(defn signum (x)
  (if (== x 0) 0 (if (> x 0) 1 -1)))

(defn square (x) (* x x))

(defn cube (x) (* x x x))

; ===========================================================================
; BOOL HELPERS
; ===========================================================================

(defn xor (a b)
  (if a (if b false true) (if b true false)))

(defn nand (a b)
  (not (and a b)))

(defn nor (a b)
  (not (or a b)))

; ===========================================================================
; TYPE PREDICATES
; ===========================================================================

(defn is-bool (x)
  (if (== x true) true (if (== x false) true false)))

(defn is-zero (x)
  (== x 0))

(defn is-even (n)
  (== 0 (% n 2)))

(defn is-odd (n)
  (!= 0 (% n 2)))

; ===========================================================================
; BOOLEAN HELPERS
; ===========================================================================

(defn when (pred body)
  (if pred body (begin)))

(defn unless (pred body)
  (if (not pred) body (begin)))
