; === Zyl Standard Library — Core ===
; Module: core
; Provides: generic Option<T>, generic Result<T, E>, combinators,
;           arithmetic, bool, type-predicates

; ===========================================================================
; OPTION ADT — Generic: Option<T>
; ===========================================================================

(deftype Option (Some T) None)

(defn option-unwrap (opt default)
  (match opt
    (Some v) v
    (None) default))

(defn option-is-some (opt)
  (match opt
    (Some _) true
    (None) false))

(defn option-is-none (opt)
  (match opt
    (Some _) false
    (None) true))

; ===========================================================================
; RESULT ADT — Generic: Result<T, E>
; ===========================================================================

(deftype Result (Ok T) (Err E))

(defn result-unwrap (res default)
  (match res
    (Ok v) v
    (Err _) default))

(defn result-is-ok (res)
  (match res
    (Ok _) true
    (Err _) false))

(defn result-is-err (res)
  (match res
    (Ok _) false
    (Err _) true))

; ===========================================================================
; LIST ADT — Generic: List<T>
; ===========================================================================

(deftype List (Cons T (List T)) None)

(defn is-nil (xs)
  (match xs
    (Cons _ _) false
    (None) true))

(defn list-car (xs)
  (match xs
    (Cons v _) (Some v)
    (None) None))

(defn list-cdr (xs)
  (match xs
    (Cons _ rest) rest
    (None) None))

; Length
(defn list-length (xs)
  (match xs
    (None) 0
    (Cons _ rest) (+ 1 (list-length rest))))

; Append
(defn list-append (xs ys)
  (match xs
    (None) ys
    (Cons h t) (Cons h (list-append t ys))))

; Reverse
(defn list-reverse (xs)
  (list-reverse-acc xs None))

(defn list-reverse-acc (xs acc)
  (match xs
    (None) acc
    (Cons h t) (list-reverse-acc t (Cons h acc))))

; Sum of list (Int only — monomorphized by use site)
(defn list-sum (xs)
  (match xs
    (None) 0
    (Cons h t) (+ h (list-sum t))))

; ===========================================================================
; COMBINATORS
; ===========================================================================

(defn identity (x) x)

(defn const (a _b) a)

(defn flip (f a b) (f b a))

(defn compose (f g)
  (fn (x) (f (g x))))

(defn apply (f x) (f x))

; ===========================================================================
; ARITHMETIC HELPERS
; ===========================================================================

(defn abs (x)
  (if (< x 0) (- 0 x) x))

(defn max (a b)
  (if (> a b) a b))

(defn min (a b)
  (if (< a b) a b))

(defn clamp (x lo hi)
  (if (< x lo) lo (if (> x hi) hi x)))

(defn signum (x)
  (if (== x 0) 0 (if (> x 0) 1 -1)))

(defn square (x) (* x x))

(defn cube (x) (* x x x))

; ===========================================================================
; BOOL HELPERS
; ===========================================================================

(defn xor (a b)
  (if a (if b false true) (if b true false)))

(defn nand (a b)
  (not (and a b)))

(defn nor (a b)
  (not (or a b)))

(defn implies (a b)
  (if a b true))

; ===========================================================================
; TYPE PREDICATES
; ===========================================================================

(defn is-bool (x)
  (if (== x true) true (if (== x false) true false)))

(defn is-zero (x)
  (== x 0))

(defn is-even (n)
  (== 0 (% n 2)))

(defn is-odd (n)
  (!= 0 (% n 2)))

; ===========================================================================
; BOOLEAN HELPERS
; ===========================================================================

(defn when (pred body)
  (if pred body (begin)))

(defn unless (pred body)
  (if (not pred) body (begin)))

; ===========================================================================
; I/O HELPERS
; ===========================================================================

(defn print-int ((n Int))
  (print n))

(defn print-float ((f Float))
  (print f))

(defn print-string ((s String))
  (print s))

(defn print-bool ((b Bool))
  (print b))
