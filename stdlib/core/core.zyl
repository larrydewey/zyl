; === Zyl Standard Library — Core (Re-export Monolith) ===
; Module: core/core
; Provides: re-exports from option/result/list + base utilities
;
; This file acts as the monolithic facade: import this once to get everything.
; Individual modules (core/option, core/result, core/list) are the source of truth.

; ===========================================================================
; RE-EXPORTS FROM MODULES
; ===========================================================================

(use core/option)
(use core/result)
(use core/list)

; ===========================================================================
; CROSS-CONVERSIONS (option <-> result)
; ===========================================================================
; These need both Option and Result types, which are only available here
; because both modules are in scope. Placing them in option.zyl or result.zyl
; would create a circular dependency.

(defn option-to-result (opt err)
  (match opt
    (Some v (Ok v))
    (None (Err err))))

(defn option-from-result (res default)
  (match res
    (Ok v (Some v))
    (Err _ (Some default))))

(defn result-to-option (res)
  (match res
    (Ok v (Some v))
    (Err _ None)))

(defn result-from-option (opt err)
  (match opt
    (Some v (Ok v))
    (None (Err err))))

; ===========================================================================
; COMBINATORS
; ===========================================================================

(defn identity (x) x)

(defn const (a _b) a)

(defn flip (f a b) (f b a))

(defn compose (f g)
  (fn (x) (f (g x))))

(defn apply (f x) (f x))

; ===========================================================================
; ARITHMETIC HELPERS
; ===========================================================================

(defn abs (x)
  (if (< x 0) (- 0 x) x))

(defn max (a b)
  (if (> a b) a b))

(defn min (a b)
  (if (< a b) a b))

(defn clamp (x lo hi)
  (if (< x lo) lo (if (> x hi) hi x)))

(defn signum (x)
  (if (== x 0) 0 (if (> x 0) 1 -1)))

(defn square (x) (* x x))

(defn cube (x) (* x x x))

; ===========================================================================
; BOOL HELPERS
; ===========================================================================

(defn xor (a b)
  (if a (if b false true) (if b true false)))

(defn nand (a b)
  (not (and a b)))

(defn nor (a b)
  (not (or a b)))

(defn implies (a b)
  (if a b true))

; ===========================================================================
; BOOLEAN HELPERS
; ===========================================================================

(defn when (pred body)
  (if pred body (begin)))

(defn unless (pred body)
  (if (not pred) body (begin)))

; ===========================================================================
; TYPE PREDICATES
; ===========================================================================

(defn is-bool (x)
  (if (== x true) true (if (== x false) true false)))

(defn is-zero (x)
  (== x 0))

(defn is-even (n)
  (== 0 (% n 2)))

(defn is-odd (n)
  (!= 0 (% n 2)))

; ===========================================================================
; I/O HELPERS
; ===========================================================================

(defn print-int ((n Int))
  (print n))

(defn print-float ((f Float))
  (print f))

(defn print-string ((s String))
  (print s))

(defn print-bool ((b Bool))
  (print b))
