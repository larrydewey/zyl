; === Zyl Standard Library — List ADT ===
; Module: list
; Provides: Generic List<T> ADT and list utilities
;
; Note: This file is also included in core.zyl for simplicity.
;       It exists separately for documentation and potential future
;       modularization.

; ===========================================================================
; LIST ADT — Generic: List<T>
; ===========================================================================

(deftype List (Cons T (List T)) None)

; ===========================================================================
; LIST OPERATIONS
; ===========================================================================

(defn is-nil (xs)
  (match xs
    (Cons _ _) false
    (None) true))

(defn list-car (xs)
  (match xs
    (Cons v _) (Some v)
    (None) None))

(defn list-cdr (xs)
  (match xs
    (Cons _ rest) rest
    (None) None))

; Length
(defn list-length (xs)
  (match xs
    (None) 0
    (Cons _ rest) (+ 1 (list-length rest))))

; Append
(defn list-append (xs ys)
  (match xs
    (None) ys
    (Cons h t) (Cons h (list-append t ys))))

; Reverse
(defn list-reverse (xs)
  (list-reverse-acc xs None))

(defn list-reverse-acc (xs acc)
  (match xs
    (None) acc
    (Cons h t) (list-reverse-acc t (Cons h acc))))

; Sum of list (Int only — monomorphized by use site)
(defn list-sum (xs)
  (match xs
    (None) 0
    (Cons h t) (+ h (list-sum t))))
