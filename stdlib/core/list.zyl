; === Zyl Standard Library — List ADT ===
; Module: list
; Provides: Generic List<T> ADT and list utilities
;
; list-car returns Option<T>, requires Option to be in scope
; (provided via core/core.zyl which imports option before list)

; ===========================================================================
; LIST ADT — Generic: List<T>
; ===========================================================================

(use core/show)
(deftype List (Cons T (List T)) Nil)

; ===========================================================================
; LIST OPERATIONS
; ===========================================================================

(defn is-nil (xs)
  (match xs
    (Cons _ _ false)
    (Nil true)))

(defn list-car (xs)
  (match xs
    (Cons v _ (Some v))
    (Nil None)))

(defn list-cdr (xs)
  (match xs
    (Cons _ rest rest)
    (Nil None)))

; Total tail: Nil for the empty list rather than list-cdr's None, so a
; chain of tails type-checks as List all the way down (list-cdr's Cons
; arm yields the tail itself, a List, while its Nil arm yields None --
; fine for a single "is there a tail" question, not composable).
(defn list-rest (xs)
  (match xs
    (Cons _ rest rest)
    (Nil Nil)))

; ---------------------------------------------------------------------------
; LISP-TRADITIONAL ACCESSOR NAMES
;
; Plain functions, not macros: each takes exactly one argument and
; evaluates it exactly once, so a macro would buy no evaluation-order
; or syntax-capture advantage, and a function can be passed to a
; higher-order function (map/filter) where a macro name cannot.
; ---------------------------------------------------------------------------

; First element as Option<T>. Alias of list-car.
(defn car (xs)
  (list-car xs))

; Tail as returned by list-cdr (None for the empty list). Use list-rest
; when the result must always be a List.
(defn cdr (xs)
  (list-cdr xs))

; Second element as Option<T>.
(defn cadr (xs)
  (list-car (list-rest xs)))

; Third element as Option<T>.
(defn caddr (xs)
  (list-car (list-rest (list-rest xs))))

; Tail of the tail, total (Nil when shorter than two elements).
(defn cddr (xs)
  (list-rest (list-rest xs)))

; Length
(defn list-length (xs)
  (match xs
    (Nil 0)
    (Cons _ rest (+ 1 (list-length rest)))))

; Append
(defn list-append (xs ys)
  (match xs
    (Nil ys)
    (Cons h t (Cons h (list-append t ys)))))

; Reverse
(defn list-reverse (xs)
  (list-reverse-acc xs Nil))

(defn list-reverse-acc (xs acc)
  (match xs
    (Nil acc)
    (Cons h t (list-reverse-acc t (Cons h acc)))))

; Sum of list (Int only — monomorphized by use site)
(defn list-sum (xs)
  (match xs
    (Nil 0)
    (Cons h t (+ h (list-sum t)))))

(impl Show List (defn show (self) (str-concat "[" (str-concat (list-show-items self) "]"))))

(defn list-show-items (xs)
  (match xs
    (Nil "")
    (Cons h t
      (match t
        (Nil (Show.show h))
        (_ (str-concat (Show.show h) (str-concat ", " (list-show-items t))))))))
