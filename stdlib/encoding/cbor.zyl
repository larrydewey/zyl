; === CBOR (RFC 8949), canonical form only ===
; Module: encoding/cbor
;
; Exists for one consumer today -- the build provenance record, which is
; signed as a COSE_Sign1 and appended to the binary. It is here rather than
; inline in that feature because the encoding is the part that has to be
; exactly right and the part nobody should be re-deriving per call site.
;
; CANONICAL, NOT MERELY CONFORMANT. This encoder emits the deterministic form
; of RFC 8949 §4.2.1 and nothing else: shortest-form head arguments, definite
; lengths, and map keys in the order the caller supplies them. That is not
; fastidiousness. A COSE signature is over bytes, so two encodings of one
; record would verify differently, and the project's first non-negotiable is
; that the same inputs produce the same output. An encoder that could emit
; either `0x18 0x01` or `0x01` for the integer 1 would make a build
; unattestable, and an unattestable build is one nobody can check.
;
; Consequently there is no "encode it however" path here: no indefinite
; lengths, no alternative integer forms, no caller-chosen key order. A map is
; written by the caller in the order it wants and `cbor-keys-sorted-p` checks
; the result, which puts the burden where it belongs -- on the one function
; that builds a record, rather than on every function that encodes a value.
;
; The writer is an explicit offset into a ByteBuf rather than a growable
; buffer, for the same reason `elf_link.zyl` does it: the caller knows the
; size it wants, and a hidden reallocation is one more thing to be right about
; in a component whose output is signed.

; A buffer to encode into, with room for `cap` bytes.
;
; Callers outside the standard library cannot call `zyl_bytebuf_new` -- it is a
; raw runtime entry, E_FFI_RESTRICTED -- so a module that hands out ByteBufs
; has to hand them out itself. That is the only reason this exists; there is
; no allocation policy here. The region argument is 1 because that is what
; elf_link.zyl passes and the escape check reads the literal: 0 is read as the
; current region, and a buffer allocated in the caller's frame and returned is
; E_REGION_ESCAPE. The runtime ignores the argument -- zyl_bytebuf_new is
; malloc'd -- but the static check is not reading the runtime.
(defn cbor-buf (cap) (ffi-call "zyl_bytebuf_new" 1 (if (> cap 0) cap 1) 1000))

; ---------------------------------------------------------------------------
; Heads
; ---------------------------------------------------------------------------

; One byte holding major<<5 | argument, for argument < 24.
(defn cbor-h0 ((b ByteBuf) (off Int) major arg)
  (begin
    (store-u8 :le b off (+ (* major 32) arg))
    (+ off 1)))

; The argument, shortest form. Returns the new offset.
;
; The thresholds are the ones in the RFC: under 24 fits the head, then one
; byte reaches 255, two reaches 65535, four reaches 2^32, and anything wider
; needs eight. Encoding 0 as 0x1800 is a different byte string, which is the
; whole reason this function exists.
(defn cbor-head ((b ByteBuf) (off Int) major arg)
  (if (< arg 24)
    (cbor-h0 b off major arg)
    (if (< arg 256)
      (begin
        (store-u8 :le b off (+ (* major 32) 24))
        (store-u8 :le b (+ off 1) arg)
        (+ off 2))
      (if (< arg 65536)
        (begin
          (store-u8 :le b off (+ (* major 32) 25))
          (store-u8 :le b (+ off 1) (bit-and (shr arg 8) 255))
          (store-u8 :le b (+ off 2) (bit-and arg 255))
          (+ off 3))
        (if (< arg 4294967296)
          (begin
            (store-u8 :le b off (+ (* major 32) 26))
            (store-u8 :le b (+ off 1) (bit-and (shr arg 24) 255))
            (store-u8 :le b (+ off 2) (bit-and (shr arg 16) 255))
            (store-u8 :le b (+ off 3) (bit-and (shr arg 8) 255))
            (store-u8 :le b (+ off 4) (bit-and arg 255))
            (+ off 5))
          (begin
            (store-u8 :le b off (+ (* major 32) 27))
            (cbor-u64 b (+ off 1) arg)
            (+ off 9)))))))

; Eight bytes, most significant first -- CBOR is big-endian for arguments,
; unlike the `store-u8 :le` used to write them.
(defn cbor-u64 ((b ByteBuf) (off Int) v)
  (begin
    (store-u8 :le b off (bit-and (shr v 56) 255))
    (store-u8 :le b (+ off 1) (bit-and (shr v 48) 255))
    (store-u8 :le b (+ off 2) (bit-and (shr v 40) 255))
    (store-u8 :le b (+ off 3) (bit-and (shr v 32) 255))
    (store-u8 :le b (+ off 4) (bit-and (shr v 24) 255))
    (store-u8 :le b (+ off 5) (bit-and (shr v 16) 255))
    (store-u8 :le b (+ off 6) (bit-and (shr v 8) 255))
    (store-u8 :le b (+ off 7) (bit-and v 255))
    (+ off 8)))

; ---------------------------------------------------------------------------
; Values
; ---------------------------------------------------------------------------

; Major 0.
(defn cbor-uint ((b ByteBuf) (off Int) n)
  (if (< n 0) (cbor-nint b off (- 0 n)) (cbor-head b off 0 n)))

; Major 1: the encoded argument is one less than the magnitude, so -1 is 0.
(defn cbor-nint ((b ByteBuf) (off Int) n) (cbor-head b off 1 (- n 1)))

; Copy `len` bytes of `s` into `b` at `off`; returns the offset after them.
; Just the copy: the head is the caller's, because the two string majors differ
; only in that byte and getting it wrong is invisible until something tries to
; decode the result.
;
; Byte at a time, because there is no String-to-ByteSlice primitive and this
; runs once per build, not per value in a loop that matters.
(defn cbor-copy ((b ByteBuf) (off Int) (s String) (len Int))
  (let i (ffi-call "zyl_ref_new" 0 1000)
    (begin
      (while (< (ffi-call "zyl_ref_get" i 1000) len)
        (begin
          (store-u8 :le b (+ off (ffi-call "zyl_ref_get" i 1000))
            (ffi-call "zyl_view_byte" s 0 1099511627776 (ffi-call "zyl_ref_get" i 1000) 1000))
          (ffi-call "zyl_ref_set" i (+ (ffi-call "zyl_ref_get" i 1000) 1) 1000)))
      (+ off len))))

; Major 2, from a String treated as raw bytes. Hashes and signatures are the
; reason this exists: a 32-byte hash is not text and must not be hex.
(defn cbor-bytes ((b ByteBuf) (off Int) (s String) (len Int))
  (let o1 (cbor-head b off 2 len) (cbor-copy b o1 s len)))

; Major 3. The length is the byte length, which is what CBOR wants; a
; multi-byte character is one head byte-count and several payload bytes.
;
; This calls cbor-copy and not cbor-bytes. Delegating to cbor-bytes is the
; obvious one-liner and it emits major 2, so every text key in a record comes
; out a byte string: a map that encodes, and decodes to nothing readable.
(defn cbor-text ((b ByteBuf) (off Int) (s String))
  (let len (str-length s)
    (let o1 (cbor-head b off 3 len) (cbor-copy b o1 s len))))

(defn cbor-text-head ((b ByteBuf) (off Int) len) (cbor-head b off 3 len))

; Major 4 and 5. The count is the number of items, not a byte length, which is
; the detail that makes these two different from a string head.
(defn cbor-array-head ((b ByteBuf) (off Int) n) (cbor-head b off 4 n))
(defn cbor-map-head ((b ByteBuf) (off Int) n) (cbor-head b off 5 n))

; Major 7, simple values 20/21/22.
(defn cbor-bool ((b ByteBuf) (off Int) (v Int)) (cbor-h0 b off 7 (if (> v 0) 21 20)))
(defn cbor-null ((b ByteBuf) (off Int)) (cbor-h0 b off 7 22))

; ---------------------------------------------------------------------------
; Sizing
; ---------------------------------------------------------------------------

; The encoded size of a head, so a caller can size a buffer before writing.
; Having this and the writer agree is worth a test rather than a comment: they
; are the same function's logic stated twice, and the failure mode is a
; truncated record that still signs.
(defn cbor-head-size (arg)
  (if (< arg 24) 1 (if (< arg 256) 2 (if (< arg 65536) 3 (if (< arg 4294967296) 5 9)))))

; An upper bound on the record, for sizing: every value as its head plus a
; 64-byte payload. Deliberately an over-estimate -- a buffer that is too big
; costs a few bytes, one that is too small truncates a signature.
(defn cbor-budget (items bytes-each) (+ 16 (* items (+ 12 bytes-each))))

; ---------------------------------------------------------------------------
; Maps
; ---------------------------------------------------------------------------
;
; A canonical map has its keys sorted by ENCODED bytes (RFC 8949 4.2.1), not by
; the text they spell and not by length alone. For text keys under 24 bytes
; that means comparing the head byte first, so every 4-byte key precedes every
; 6-byte one regardless of what they say -- "kind" sorts before "format", and a
; 12-byte key sorts last of all. It looks wrong and it is right, which is
; exactly the kind of thing an encoder should check rather than an author
; remember.

; One entry: a text key and a byte-string value. Values are BYTES because the
; things a provenance record carries are 32-byte hashes, and a hash is not text;
; hex-encoding one into the record would double its size and make a byte string
; indistinguishable from a string that happens to look like one.
(defn cbor-map-text-bytes ((b ByteBuf) (off Int) (k String) (v ByteBuf) (vlen Int))
  (let o (cbor-text b off k)
    (let o (cbor-head b o 2 vlen)
      (cbor-copy-bytes b o v 0 vlen))))

; One entry: a text key and a text value.
(defn cbor-map-text-text ((b ByteBuf) (off Int) (k String) (v String))
  (let o (cbor-text b off k)
    (cbor-text b o v)))

; One entry: a text key and an unsigned integer.
(defn cbor-map-text-uint ((b ByteBuf) (off Int) (k String) (n Int))
  (let o (cbor-text b off k)
    (cbor-uint b o n)))

; One entry: a text key and an array of text strings.
(defn cbor-map-text-strings ((b ByteBuf) (off Int) (k String) (items List) (n Int))
  (let o (cbor-text b off k)
    (let o (cbor-array-head b o n)
      (cbor-text-strings b o items))))

(defn cbor-text-strings ((b ByteBuf) (off Int) items)
  (match items
    (Nil off)
    (Cons h rest (cbor-text-strings b (cbor-text b off h) rest))))

; Copy `n` raw bytes. cbor-copy takes a String, which stops at a zero byte, and
; a 32-byte hash contains them often enough to matter.
(defn cbor-copy-bytes ((dst ByteBuf) (off Int) (src ByteBuf) (soff Int) (n Int))
  (begin
    (for (i 0) (< i n)
      (begin
        (store-u8 :le dst (+ off i) (load-u8 :le src (+ soff i)))
        (set! i (+ i 1))))
    (+ off n)))

; ---------------------------------------------------------------------------
; Checking the result
; ---------------------------------------------------------------------------

; How deep cbor-skip-value will follow nested arrays and maps. A hostile blob
; nests without end and this walks structure an attacker chose, so the bound
; is a real limit: past it the answer is -1, i.e. not understood, not accepted.
; It lives here rather than beside the reader because the sortedness walk needs
; it too, and it is that walk -- not the reader -- which has to step over the
; nested `evidence` map in the middle of a record's keys.
(def cbor-max-nesting 16)

; One decoded key: its byte length, and the offset of its first character.
; Two fields, and deliberately not three: a match arm binds its leading names and
; RETURNS its last one, so a redundant middle field is a field nothing can
; reach. `(match k (CKey len start len))` reads the length and `(match k (CKey
; len start start))` reads the start, which is easy to get backwards.
(deftype CKey (CKey Int Int))

; The next key at `off`, assuming it is a definite-length text string.
(defn cbor-read-key ((b ByteBuf) (off Int))
  (let ib (load-u8 :le b off)
    (let arg (bit-and ib 31)
      (if (not (= (bit-and (shr ib 5) 7) 3))
        (CKey (- 1) (- 1))
        (let klen (cbor-arg-at b off arg 1000000)
          (if (< klen 0)
            (CKey (- 1) (- 1))
            (CKey klen (+ off 1 (cbor-arg-width arg)))))))))

; True when the map at `off` has its `n` keys in canonical order, and `off` is
; where the map's body starts.
;
; The encoder writes in whatever order the caller supplies, so this is the only
; thing standing between a convenient call site and an uncanonical record whose
; signature verifies against itself and against nothing else.
;
; `off` IS THE MAP HEAD, like cbor-map-find's, and it used not to be: this took
; the body's first key, and the reader took the head, so a caller that got one
; right got the other wrong and a caller that got them the same way got both
; wrong. Two functions reading the same map must agree about where it starts.
(defn cbor-keys-sorted-p ((b ByteBuf) (off Int) (n Int) (len Int))
  (if (<= n 1)
    true
    (let ib (load-u8 :le b off)
      (if (not (= (bit-and (shr ib 5) 7) 5))
        false
        (let w (cbor-arg-width (bit-and ib 31))
          (if (or (< w 0) (> (+ off 1 w) len))
            false
            (cbor-keys-sorted-from b (+ off 1 w) n len)))))))

; The body of the sortedness walk: consecutive keys from the map's first pair.
(defn cbor-keys-sorted-from ((b ByteBuf) (off Int) (n Int) (len Int))
  (if (<= n 1)
    true
    (let a (cbor-read-key b off)
      (if (< (match a (CKey v u v)) 0)
        false
        (let klen (match a (CKey v u v))
          (let kend (+ (match a (CKey v u u)) klen)
            (let after (cbor-skip-value b kend len cbor-max-nesting)
              (if (< after 0)
                false
                (let bkey (cbor-read-key b after)
                  (if (cbor-key-gt b a bkey klen)
                    false
                    (cbor-keys-sorted-from b after (- n 1) len)))))))))))

; True when key `a` sorts AFTER key `b`: longer first, then bytewise.
;
; Longer comes later because the length rides in the head byte for a short text
; string, so comparing lengths is comparing those head bytes. cbor-keys-sorted-p
; rejects when this holds, which is why the direction matters: an inverted pair
; of these two comparisons accepts every record that is wrong and rejects every
; one that is right.
(defn cbor-key-gt (buf a b klen)
  (let blen (match b (CKey v u v))
    (if (< blen 0)
      false
      (if (> klen blen)
        true
        (if (< klen blen)
          false
          (cbor-bytes-gt buf (match a (CKey v u u)) buf (match b (CKey v u u)) klen 0))))))

; The offset just past the value at `off`, or -1 if it runs past the buffer.
;
; Arrays and maps are SKIPPED BY COUNTING, not by refusing. Refusing them looked
; correct until the provenance record put a nested `evidence` map in the middle
; of its nine keys: the walk hit major 5, returned -1, and reported the record as
; unsorted when it was perfectly canonical. A checker that cannot step over the
; values it will meet is not a checker.
;
; `depth` bounds the recursion. A hostile blob can nest maps arbitrarily deep,
; and this walks attacker-chosen structure, so the bound is a real limit rather
; than a formality: past it the answer is -1, i.e. not understood, not accepted.
(defn cbor-skip-value ((b ByteBuf) (off Int) (len Int) (depth Int))
  (if (<= depth 0)

    (- 1)
    (let ib (load-u8 :le b off)

      (let major (bit-and (shr ib 5) 7)

        (let arg (bit-and ib 31)

          (let w (cbor-arg-width arg)

            (let arg (cbor-arg-at b off arg len)

              (if (<= (+ off 1 w) len)

                (let base (+ off 1 w)

                  (if (= major 5)

                    (cbor-skip-items b base len (- depth 1) (* 2 arg))
                    (if (= major 4)

                      (cbor-skip-items b base len (- depth 1) arg)
                      (if (or (= major 2) (= major 3))

                        (if (<= (+ base arg) len) (+ base arg) (- 1))

                        (if (<= base len) base (- 1))))))
                (- 1)))))))))

; Step over `n` consecutive values.
(defn cbor-skip-items ((b ByteBuf) (off Int) (len Int) (depth Int) (n Int))
  (if (<= n 0)
    off
    (let next (cbor-skip-value b off len depth)
      (if (< next 0) (- 1) (cbor-skip-items b next len depth (- n 1))))))

; The argument a head ACTUALLY denotes.
;
; Four forms: in the head, one byte, two bytes, four bytes -- the same four
; cose-read-plen reads, and for the same reason: the writer emits all four, so
; a reader that stopped at two would call a record it had signed malformed.
; The eight-byte form is refused; nothing here produces a value that needs it.
;
; The low five bits of the head byte are the argument only when they are under
; 24. From 24 up they are an ESCAPE CODE -- 24 means "the argument is the next
; byte", 25 "the next two", and so on -- and the real value lives in the bytes
; after. Reading `arg` straight out of the head byte and using it as a length
; turns 0x58 0x20 into "a byte string of 24 bytes" when it is 32, which is how a
; canonical record nine keys long was reported as unsorted: the walk stepped 8
; bytes short of the next key and every comparison after that was noise.
(defn cbor-arg-at ((b ByteBuf) (off Int) (arg Int) (len Int))
  (if (< arg 24)
    arg
    (if (= arg 24)
      (if (< (+ off 1) len) (load-u8 :le b (+ off 1)) (- 1))
      (if (= arg 25)
        (if (< (+ off 2) len)
          (+ (* 256 (load-u8 :le b (+ off 1))) (load-u8 :le b (+ off 2)))
          (- 1))
        (if (= arg 26)
          (if (< (+ off 4) len)
            (+ (* 16777216 (load-u8 :le b (+ off 1)))
              (+ (* 65536 (load-u8 :le b (+ off 2)))
                (+ (* 256 (load-u8 :le b (+ off 3))) (load-u8 :le b (+ off 4)))))
            (- 1))
          (- 1))))))

; Width of a head argument: 0 when it rides in the head byte, else 1, 2, 4 or 8.
(defn cbor-arg-width (arg)
  (if (< arg 24) 0 (if (= arg 24) 1 (if (= arg 25) 2 (if (= arg 26) 4 (if (= arg 27) 8 (- 1)))))))

; True when the `n` bytes at `a` sort after the `n` bytes at `b`.
(defn cbor-bytes-gt ((a ByteBuf) aoff (b ByteBuf) boff (n Int) (i Int))
  (if (>= i n)
    false
    (let x (load-u8 :le a (+ aoff i))
      (let y (load-u8 :le b (+ boff i))
        (if (> x y) true (if (< x y) false (cbor-bytes-gt a aoff b boff n (+ i 1))))))))

; ---------------------------------------------------------------------------
; Reading
; ---------------------------------------------------------------------------
;
; A reader beside the writer, and it is here for one consumer: `zyl verify`
; reads a record it did not build. Everything above is a writer that knows the
; shape it is producing; this is the other direction, where the shape is
; somebody else's claim and every offset has to be CHECKED rather than walked
; forward on trust.
;
; WHY A READER RATHER THAN A POSITIONAL WALK. A first attempt walked the
; claims in the order the encoder wrote them, hard-coding each offset. It was
; ~300 lines and it found five bugs in itself, four of them in the traversal
; rather than in the data -- one of which inverted a bounds test, so it
; returned failure precisely when the bytes DID fit and every well-formed
; record was refused. It passed every test written for it, because every test
; asked only whether it rejects something, and a checker that rejects
; everything passes all of those. This one is keyed by claim name instead of
; by offset, and `tests/cbor_test.zyl` states the "does it say yes" case first.
;
; Bounds are checked at every step and failure is -1, never an index past the
; end. `len` is the caller's trust boundary and is the blob's own extent, not
; the buffer's capacity: a reader that used the capacity would read claims out
; of whatever follows the blob, which is exactly the thing a reader placed
; inside a signed trailer must not do.
;
; THE NESTING LIMIT IS A LIMIT, NOT A DEFAULT. This walks structure an
; attacker chose, so past cbor-max-nesting the answer is "not understood",
; which is -1 and never "accepted".

; A value and the offset just past it. The pair makes a read composable: the
; next claim starts where this one ended, so no reader here recomputes a
; length from a head it has already parsed.
(deftype CU (CU Int Int))

; A byte string or text string: where the payload starts, how long it is, and
; the offset just past it. Three fields because a reader of a 32-byte hash
; wants all three, and recomputing any of them is a chance to be off by one.
(deftype CS (CS Int Int Int))

; A text claim's payload offset and its length.
(deftype CT (CT String Int))

; A key head's payload offset and its length.
(deftype CK (CK Int Int))

; A uint at `off`, and the offset after it. Major 0 only.
;
; Major 1 is REFUSED rather than converted. Every count in a record is a
; magnitude, so a negative one is not a number to be read but a claim of the
; wrong shape; accepting it would leave a reader and a writer disagreeing
; about what a count is. Returns (CU -1 -1) for anything else.
(defn cbor-uint-at ((b ByteBuf) (off Int) (len Int))
  (let ib (load-u8 :le b off)
    (if (not (= (bit-and (shr ib 5) 7) 0))
      (CU (- 1) (- 1))
      (let arg (cbor-arg-at b off (bit-and ib 31) len)
        (let w (cbor-arg-width (bit-and ib 31))
          (if (or (< arg 0) (< w 0) (> (+ off 1 w) len))
            (CU (- 1) (- 1))
            (CU arg (+ off 1 w))))))))

; A byte string at `off`: payload offset, length, offset past it. Major 2 only.
;
; A text string in this position is REFUSED on purpose. The values that carry
; meaning in a record are 32-byte hashes and are bytes; a record that spelled
; one as text would be a record this reader has to refuse rather than guess
; about, because hex-decoding it would be a second interpretation applied to
; somebody else's bytes.
(defn cbor-bytes-at ((b ByteBuf) (off Int) (len Int))
  (let ib (load-u8 :le b off)
    (if (not (= (bit-and (shr ib 5) 7) 2))
      (CS (- 1) (- 1) (- 1))
      (let arg (cbor-arg-at b off (bit-and ib 31) len)
        (let w (cbor-arg-width (bit-and ib 31))
          (if (or (< arg 0) (< w 0) (> (+ off 1 w arg) len))
            (CS (- 1) (- 1) (- 1))
            (CS (+ off 1 w) arg (+ off 1 w arg))))))))

; The text at `off`, and the offset past it. Major 3 only.
;
; The length is the byte length CBOR declares. The result is a String, which
; ends at a NUL, so text holding one reads back short: that is why hashes are
; byte strings and read through cbor-bytes-at, never through here. A byte
; string in this position is refused for the mirror of the reason above.
(defn cbor-text-at ((b ByteBuf) (off Int) (len Int))
  (let ib (load-u8 :le b off)
    (if (not (= (bit-and (shr ib 5) 7) 3))
      (CT "" (- 1))
      (let arg (cbor-arg-at b off (bit-and ib 31) len)
        (let w (cbor-arg-width (bit-and ib 31))
          (if (or (< arg 0) (< w 0) (> (+ off 1 w arg) len))
            (CT "" (- 1))
            (cbor-text-finish b (+ off 1 w) arg)))))))

(defn cbor-text-finish ((b ByteBuf) (off Int) (n Int))
  (CT (cbor-slice-str b off n 0 "") (+ off n)))

; `n` bytes at `off` as a String.
;
; Built a byte at a time with zyl_cstr_from_byte, which is quadratic in `n` and
; is used only on a record's short prose claims: the issuer string, a
; measurement type, the four check lines. The alternative -- copy the bytes
; into a buffer and convert that -- is not available, because there is no
; ByteBuf-to-String entry: the two that look like it, zyl_cstr_substr and
; zyl_view_copy, both take a String, which is the direction this cannot go.
(defn cbor-slice-str ((b ByteBuf) (off Int) (n Int) (i Int) (acc String))
  (if (>= i n)
    acc
    (cbor-slice-str b off n (+ i 1)
      (str-concat acc (ffi-call "zyl_cstr_from_byte" (load-u8 :le b (+ off i)) 1000)))))

; The bytes of `key`, one Int per byte, so a key comparison goes through the
; same byte equality every other comparison in this module uses.
(defn cbor-text-bytes (s (i Int))
  (if (>= i (str-length s))
    Nil
    (Cons (ffi-call "zyl_view_byte" s 0 1099511627776 i 1000) (cbor-text-bytes s (+ i 1)))))

; ONE COUNTER, NOT TWO.
;
; `off` is fixed and `i` walks. Advancing both was the bug this module's first
; key comparison had: it compared `in` against `i` and so refused every key of
; length four or more -- which is every key in a provenance record, so every
; claim lookup failed while the reader reported only "not found" and looked
; exactly like a record with nothing in it.
(defn cbor-bytes-eq ((b ByteBuf) (off Int) xs (i Int))
  (match xs
    (Nil true)
    (Cons h rest (if (= (load-u8 :le b (+ off i)) h)
                   (cbor-bytes-eq b off rest (+ i 1))
                   false))))

; The payload offset and length of the text head at `off`, or (CK -1 -1).
(defn cbor-key-span ((b ByteBuf) (off Int) (len Int))
  (let ib (load-u8 :le b off)
    (if (not (= (bit-and (shr ib 5) 7) 3))
      (CK (- 1) (- 1))
      (let arg (cbor-arg-at b off (bit-and ib 31) len)
        (let w (cbor-arg-width (bit-and ib 31))
          (if (or (< arg 0) (< w 0) (> (+ off 1 w arg) len))
            (CK (- 1) (- 1))
            (CK (+ off 1 w) arg)))))))

; The offset of the value for `key` in the map whose HEAD is at `off`, or -1.
;
; `off` IS THE HEAD, and that distinction was the whole bug in the first
; version of this function: it read a text head where the map head stood,
; found major type 5 instead of 3, and answered -1 for every claim in every
; record. That is indistinguishable from a record with no claims in it, which
; is the same failure as a reader that refuses everything.
;
; The pair count comes from the head rather than from the caller, so a caller
; cannot ask for the third pair of a two-pair map. It is still only a bound:
; the walk steps over each value structurally, and a pair running past `len`
; ends the search with "not found" rather than an answer from beyond the blob.
;
; A key appearing twice returns the FIRST, which is what RFC 8949 5.6 requires
; and the one a canonical map cannot produce anyway.
(defn cbor-map-find ((b ByteBuf) (off Int) (len Int) (depth Int) (key String))
  (if (<= depth 0)
    (- 1)
    (let ib (load-u8 :le b off)
      (if (not (= (bit-and (shr ib 5) 7) 5))
        (- 1)
        (let pairs (cbor-arg-at b off (bit-and ib 31) len)
          (let w (cbor-arg-width (bit-and ib 31))
            (if (or (< pairs 0) (< w 0) (> (+ off 1 w) len))
              (- 1)
              (cbor-map-scan b (+ off 1 w) len depth pairs key))))))))

; One key/value pair at a time, from the map's body.
;
; Separate from cbor-map-find so the head is consumed exactly once. The first
; version recursed into itself with the body offset, so every step after the
; first re-read a head that was not there.
(defn cbor-map-scan ((b ByteBuf) (off Int) (len Int) (depth Int) (pairs Int) (key String))
  (if (or (<= depth 0) (<= pairs 0))
    (- 1)
    (let ks (cbor-key-span b off len)
      (let klen (match ks (CK _ n n))
        (if (< klen 0)
          (- 1)
          (let kstart (match ks (CK p _ p))
            (let kend (+ kstart klen)
              (if (and (= klen (str-length key)) (cbor-bytes-eq b kstart (cbor-text-bytes key 0) 0))
                kend
                (let after (cbor-skip-value b kend len (- depth 1))
                  (if (< after 0)
                    (- 1)
                    (cbor-map-scan b after len depth (- pairs 1) key)))))))))))

; THE VALUE IS SKIPPED ON EVERY MISMATCH, and `depth` is spent on nesting only.
;
; Two bugs, both from the first version and both the kind a reader tells
; nobody about. A key of the RIGHT length but the wrong bytes continued from
; the end of the key, so the next pair's "key" was this pair's value: every
; lookup past a same-length neighbour answered -1, and "name" was not found in
; a map that held "kind" before it. And depth went down once per PAIR, so a
; map of more pairs than the nesting limit could not be read to its end; the
; record has ten and the limit is sixteen, which is how it stayed hidden.

; The array whose head is at `off`: its item count and the offset of its
; first item, or (CU -1 -1). Major 4 only. Items are read from there with
; cbor-text-at and the like, each one starting where the last one ended.
(defn cbor-array-at ((b ByteBuf) (off Int) (len Int))
  (let ib (load-u8 :le b off)
    (if (not (= (bit-and (shr ib 5) 7) 4))
      (CU (- 1) (- 1))
      (let arg (cbor-arg-at b off (bit-and ib 31) len)
        (let w (cbor-arg-width (bit-and ib 31))
          (if (or (< arg 0) (< w 0) (> (+ off 1 w) len))
            (CU (- 1) (- 1))
            (CU arg (+ off 1 w))))))))
