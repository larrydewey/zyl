; === Zyl Standard Library — Arena-backed Vec<T> ===
; Module: collections (vec submodule)
;
; Elements are stored as machine words, so any value fits. The last field
; is a phantom that carries T for type inference and is never read.

(use core/show)
(use allocator/allocator)

(deftype Vec (VecC Int Int Int Int T)) ; ptr len cap arena phantom

; Reinterpret a word as any type (the identity at run time).
(defn vec-cast (w) (ffi-call "zyl_cstr_of_word" w 1000))

(defn vec-ptr (v) (match v (VecC p _ _ _ _ p)))
(defn vec-arena (v) (match v (VecC _ _ _ a _ a)))

; `w` read back as v's element type.
(defn vec-elem (v w) (match v (VecC _ _ _ _ ph (if (= 0 1) ph (vec-cast w)))))

; `x`, checked against v's element type.
(defn vec-check (v x) (match v (VecC _ _ _ _ ph (if (= 0 1) ph x))))

(defn vec-make (ptr len cap arena) (VecC ptr len cap arena (vec-cast 0)))

(defn vec-with (v ptr len cap) (match v (VecC _ _ _ a ph (VecC ptr len cap a ph))))

; Create an empty Vec with room for `cap` elements, stored in `arena`: a
; handle from `arena-create`, or 0 (any value <= 0) for a new private arena.
; A negative `cap` means 0; the Vec grows by doubling, in the same arena.
; Returns: Vec
(defn vec-create ((arena Int) (cap Int))
  (let a (if (> arena 0) arena (arena-create 0))
    (let c (if (< cap 0) 0 cap)
      (vec-make (arena-alloc a (* c 8)) 0 c a))))

; Create an empty Vec with room for `cap` elements in a new private arena.
; Returns: Vec
(defn vec-create-default ((cap Int))
  (vec-create 0 cap))

; Get the length of the Vec.
; Returns: Int
(defn vec-len (v) (match v (VecC _ n _ _ _ n)))

; Get the capacity of the Vec.
; Returns: Int
(defn vec-cap (v) (match v (VecC _ _ c _ _ c)))

; Get element at index i. Returns -1 (as a word) if out of bounds.
; Returns: T
(defn vec-get (v (i Int))
  (if (or (< i 0) (>= i (vec-len v)))
    (vec-elem v -1)
    (vec-elem v (alloc-read-int (+ (vec-ptr v) (* i 8))))))

; Set element at index i to value. Writing at or past the current length
; extends it (up to capacity); out-of-capacity writes are no-ops.
; Returns: Vec
(defn vec-set (v (i Int) value)
  (if (or (< i 0) (>= i (vec-cap v)))
    v
    (let new-len (if (>= i (vec-len v)) (+ i 1) (vec-len v))
      (begin
        (alloc-write-int (+ (vec-ptr v) (* i 8)) (vec-check v value))
        (vec-with v (vec-ptr v) new-len (vec-cap v))))))

; Push a value onto the Vec, reallocating if needed.
; Returns: Vec
(defn vec-push (v value)
  (let current-len (vec-len v)
    (let current-cap (vec-cap v)
      (if (>= current-len current-cap)
        (let new-cap (if (<= current-cap 0) 16 (* current-cap 2))
          (let new-ptr (arena-alloc (vec-arena v) (* new-cap 8))
            (let old-ptr (vec-ptr v)
              (begin
                (for (j 0) (< j current-len)
                  (begin
                    (alloc-write-int (+ new-ptr (* j 8)) (alloc-read-int (+ old-ptr (* j 8))))
                    (set! j (+ j 1))))
                (alloc-write-int (+ new-ptr (* current-len 8)) (vec-check v value))
                (vec-with v new-ptr (+ current-len 1) new-cap)))))
        (begin
          (alloc-write-int (+ (vec-ptr v) (* current-len 8)) (vec-check v value))
          (vec-with v (vec-ptr v) (+ current-len 1) current-cap))))))

; Pop the last value: returns the Vec with length reduced by one.
; Popping an empty Vec returns it unchanged.
; Returns: Vec
(defn vec-pop (v)
  (let current-len (vec-len v)
    (if (<= current-len 0)
      v
      (vec-with v (vec-ptr v) (- current-len 1) (vec-cap v)))))

; Read the last value without removing it. Returns -1 (as a word) if empty.
; Returns: T
(defn vec-last (v)
  (let current-len (vec-len v)
    (if (<= current-len 0)
      (vec-elem v -1)
      (vec-elem v (alloc-read-int (+ (vec-ptr v) (* (- current-len 1) 8)))))))

; Free the arena-allocated buffer. Vec becomes empty but arena handle remains.
; Returns: Vec
(defn vec-free (v)
  (begin
    (alloc-free (vec-ptr v))
    (vec-with v 0 0 0)))

(impl Show Vec (defn show (self) (str-concat "[" (str-concat (vec-show-from self 0) "]"))))

(defn vec-show-from (v (i Int))
  (if (>= i (vec-len v))
    ""
    (let item (Show.show (vec-get v i))
      (if (= i (- (vec-len v) 1))
        item
        (str-concat item (str-concat ", " (vec-show-from v (+ i 1))))))))
