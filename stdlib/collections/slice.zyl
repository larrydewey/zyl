; === Zyl Standard Library — Slices ===
; Module: collections/slice
;
; A Slice is a zero-copy window on a Vec's storage: the array, an offset
; and a length. Making a slice or a sub-slice copies nothing, and every
; read is checked against the slice's own bounds. Like a Vec version, a
; slice shares its storage: an element set through a Vec that still uses
; that storage is visible through the slice. A slice holds the array, so
; region inference keeps the storage alive for as long as the slice.

(use core/show)
(use collections/vec)

(deftype Slice (SliceC (Array T) Int Int)) ; storage, offset, length

(defn slice-store (s) (match s (SliceC a _ _ a)))
(defn slice-off (s) (match s (SliceC _ o _ o)))

; The number of elements in the slice.
; Returns: Int
(defn slice-len (s) (match s (SliceC _ _ n n)))

; A slice of all of `v`.
; Returns: Slice
(defn slice-of-vec (v) (SliceC (vec-store v) 0 (vec-len v)))

; A partial operation is spelled: `name!` stops the program on a bad range
; or index (E_INDEX_OUT_OF_BOUNDS, caught by `try`), `name?` returns an
; Option, and there is no plain name (docs/soundness.md).

; Stops the program: `who` was asked for off..off+len of `what` of n elements.
(defn slice-range! ((who String) (alt String) (what String) (off Int) (len Int) (n Int))
  (ffi-call "zyl_panic"
    (str-concat "E_INDEX_OUT_OF_BOUNDS: " (str-concat who (str-concat " range " (str-concat (ffi-call "zyl_int_text" off 1000)
      (str-concat ".." (str-concat (ffi-call "zyl_int_text" (+ off len) 1000) (str-concat " is outside a " (str-concat what
        (str-concat " of " (str-concat (ffi-call "zyl_int_text" n 1000)
          (str-concat " elements\n  = help: use `" (str-concat alt "` and match its Option"))))))))))))
    1000))

(defn slice-range-ok ((off Int) (len Int) (n Int))
  (not (or (< off 0) (or (< len 0) (> len (- n off))))))

; The `len` elements of `v` from `off`. A range outside the Vec stops the
; program (E_INDEX_OUT_OF_BOUNDS).
; Returns: Slice
(defn slice-vec! (v (off Int) (len Int))
  (if (slice-range-ok off len (vec-len v))
    (SliceC (vec-store v) off len)
    (slice-range! "slice-vec!" "(slice-vec? v off len)" "Vec" off len (vec-len v))))

; The `len` elements of `v` from `off`, or None when the range is outside the Vec.
; Returns: Option Slice
(defn slice-vec? (v (off Int) (len Int))
  (if (slice-range-ok off len (vec-len v))
    (Some (SliceC (vec-store v) off len))
    None))

; The `len` elements of `s` from `off`. A range outside the slice stops the
; program (E_INDEX_OUT_OF_BOUNDS).
; Returns: Slice
(defn slice-sub! (s (off Int) (len Int))
  (if (slice-range-ok off len (slice-len s))
    (SliceC (slice-store s) (+ (slice-off s) off) len)
    (slice-range! "slice-sub!" "(slice-sub? s off len)" "slice" off len (slice-len s))))

; The `len` elements of `s` from `off`, or None when the range is outside the slice.
; Returns: Option Slice
(defn slice-sub? (s (off Int) (len Int))
  (if (slice-range-ok off len (slice-len s))
    (Some (SliceC (slice-store s) (+ (slice-off s) off) len))
    None))

; Element i of the slice. An index outside it stops the program
; (E_INDEX_OUT_OF_BOUNDS).
; Returns: T
(defn slice-get! (s (i Int))
  (if (or (< i 0) (>= i (slice-len s)))
    (ffi-call "zyl_panic"
      (str-concat "E_INDEX_OUT_OF_BOUNDS: slice-get! index " (str-concat (ffi-call "zyl_int_text" i 1000)
        (str-concat " is outside a slice of " (str-concat (ffi-call "zyl_int_text" (slice-len s) 1000)
          " elements\n  = help: use `(slice-get? s i)` and match its Option, or check the index against `slice-len` first"))))
      1000)
    (array-get (slice-store s) (+ (slice-off s) i))))

; Element i, or None when i is outside the slice.
; Returns: Option T
(defn slice-get? (s (i Int))
  (if (or (< i 0) (>= i (slice-len s)))
    None
    (Some (array-get (slice-store s) (+ (slice-off s) i)))))

; Element i, or `default` when i is outside the slice.
; Returns: T
(defn slice-get-or (s (i Int) default)
  (if (or (< i 0) (>= i (slice-len s)))
    default
    (array-get (slice-store s) (+ (slice-off s) i))))

; The slice without its first `n` elements (empty when `n` >= its length).
; Returns: Slice
(defn slice-drop (s (n Int))
  (let k (if (< n 0) 0 (if (> n (slice-len s)) (slice-len s) n))
    (SliceC (slice-store s) (+ (slice-off s) k) (- (slice-len s) k))))

; The first `n` elements of the slice (all of it when `n` >= its length).
; Returns: Slice
(defn slice-take (s (n Int))
  (let k (if (< n 0) 0 (if (> n (slice-len s)) (slice-len s) n))
    (SliceC (slice-store s) (slice-off s) k)))

; `f` applied to an accumulator and each element in order, from `init`.
; Returns: the accumulator's type
(defn slice-fold (s f init) (slice-fold-from s f init 0))

(defn slice-fold-from (s f acc (i Int))
  (if (>= i (slice-len s))
    acc
    (slice-fold-from s f (f acc (slice-get! s i)) (+ i 1))))

; A new Vec holding the slice's elements (a copy), allocated in the region
; the calling frame runs in.
; Returns: Vec
(defn slice-to-vec (s)
  (slice-push-from s (vec-new-cap (slice-len s)) 0))

(defn slice-push-from (s v (i Int))
  (if (>= i (slice-len s))
    v
    (slice-push-from s (vec-push v (slice-get! s i)) (+ i 1))))

(impl Show Slice (defn show (self) (str-concat "[" (str-concat (slice-show-from self 0) "]"))))

(defn slice-show-from (s (i Int))
  (if (>= i (slice-len s))
    ""
    (let item (Show.show (slice-get! s i))
      (if (= i (- (slice-len s) 1))
        item
        (str-concat item (str-concat ", " (slice-show-from s (+ i 1))))))))
