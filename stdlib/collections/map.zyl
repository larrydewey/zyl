; === Zyl Standard Library — Arena-backed Map<K, V> ===
; Module: collections/map
; Provides: Arena-backed Map<K, V>

(use allocator/allocator)
(use math/words)

(defstruct Map (kptr Words) (vptr Words) (len Int) (cap Int) (arena Arena))

; Create an empty Map with the given initial capacity on the given arena.
; Returns: Map
(defn map-create ((arena Arena) (cap Int))
  (let c (if (< cap 0) 0 cap)
    (make-Map (w-alloc arena c) (w-alloc arena c) 0 c arena)))

; Create an empty Map with the given initial capacity in a new private
; arena.
; Returns: Map
(defn map-create-default ((cap Int))
  (map-create (arena-create 0) cap))

; Get the number of entries.
; Returns: Int
(defn map-len ((m Map))
  (struct-get m "len"))

; Get the capacity.
; Returns: Int
(defn map-cap ((m Map))
  (struct-get m "cap"))

; Internal: lookup key `k` at index `i`. Returns 1-based index if found, 0 if not.
(defn map-get-at ((m Map) (k Int) (i Int))
  (let stored (w-get (struct-get m "kptr") i)
    (if (== k stored)
      (+ i 1)
      0)))

; Look up a key, returning the default when absent.
; Returns: V
(defn map-get ((m Map) (k Int) (default Int))
  (let len (map-len m)
    (if (<= len 0)
      default
      (map-get-loop m k default 0 len))))

; Internal lookup loop.
(defn map-get-loop ((m Map) (k Int) (default Int) (i Int) (len Int))
  (if (>= i len)
    default
    (let result (map-get-at m k i)
      (if (> result 0)
        (w-get (struct-get m "vptr") (- result 1))
        (map-get-loop m k default (+ i 1) len)))))

; Put a key-value pair. If key exists, overwrites value in-place.
; Returns: Map
(defn map-put ((m Map) (k Int) (v Int))
  (let existing (map-find m k 0 (map-len m))
    (if (> existing 0)
      (let idx (- existing 1)
        (begin
          (w-set (struct-get m "vptr") idx v)
          m))
      (map-put-inner m k v))))

(defn map-put-inner ((m Map) (k Int) (v Int))
  (let len (map-len m)
    (let cap (map-cap m)
      (if (>= len cap)
        (let new-cap (if (<= cap 0) 16 (* cap 2))
          (let new-kptr (w-alloc (struct-get m "arena") new-cap)
            (let new-vptr (w-alloc (struct-get m "arena") new-cap)
              (let old-kptr (struct-get m "kptr")
                (let old-vptr (struct-get m "vptr")
                  (begin
                    (for (j 0) (< j len)
                      (begin
                        (w-set new-kptr j (w-get old-kptr j))
                        (w-set new-vptr j (w-get old-vptr j))
                        (set! j (+ j 1))))
                    (w-set new-kptr len k)
                    (w-set new-vptr len v)
                    (make-Map new-kptr new-vptr (+ len 1) new-cap (struct-get m "arena"))))))))
        (let new-kptr (struct-get m "kptr")
          (begin
            (w-set new-kptr len k)
            (w-set (struct-get m "vptr") len v)
            (make-Map new-kptr (struct-get m "vptr") (+ len 1) cap (struct-get m "arena"))))))))

; Remove a key. Compacts the arrays in place (like set-remove), so the
; capacity stays the real size of the backing storage and later puts
; reuse the freed slot.
; Returns: Map
(defn map-remove ((m Map) (k Int))
  (let len (map-len m)
    (let removed (map-find m k 0 len)
      (if (<= removed 0)
        m
        (let kptr (struct-get m "kptr")
          (let vptr (struct-get m "vptr")
            (begin
              (for (j (- removed 1)) (< j (- len 1))
                (begin
                  (w-set kptr j (w-get kptr (+ j 1)))
                  (w-set vptr j (w-get vptr (+ j 1)))
                  (set! j (+ j 1))))
              (make-Map kptr vptr (- len 1) (map-cap m) (struct-get m "arena")))))))))

; Internal: 1-based index of key k in [i, len), or 0 if absent.
(defn map-find ((m Map) (k Int) (i Int) (len Int))
  (if (>= i len)
    0
    (let stored (w-get (struct-get m "kptr") i)
      (if (== k stored)
        (+ i 1)
        (map-find m k (+ i 1) len)))))

; Check if a key exists.
; Returns: Bool
(defn map-has ((m Map) (k Int))
  (let len (map-len m)
    (if (<= len 0)
      false
      (map-has-loop m k 0 len))))

; Internal has-loop.
(defn map-has-loop ((m Map) (k Int) (i Int) (len Int))
  (if (>= i len)
    false
    (let stored (w-get (struct-get m "kptr") i)
      (if (== k stored)
        true
        (map-has-loop m k (+ i 1) len)))))

; Free all arena-allocated storage. Map becomes empty.
; Returns: Unit
; An empty Map in the same arena. The storage is the arena's (freeing it
; with C free() was undefined behaviour); it returns at arena-reset.
(defn map-free ((m Map))
  (make-Map (w-alloc (struct-get m "arena") 0) (w-alloc (struct-get m "arena") 0) 0 0 (struct-get m "arena")))
