; === Zyl Standard Library — Set<K> ===
; Module: collections/set
; Provides: region-backed Set<K> with deterministic insertion order.
; Inserting an already-present key is a no-op (ignored).

(use math/words)

(defstruct Set (ptr Words) (len Int) (cap Int))

; Create an empty Set with the given initial capacity. Storage comes from
; the region the calling frame runs in; `cap` is a hint, not a limit.
; Returns: Set
(defn set-create ((cap Int))
  (let c (if (< cap 0) 0 cap)
    (make-Set (w-alloc c) 0 c)))

; Get the number of distinct elements.
; Returns: Int
(defn set-len ((s Set))
  (struct-get s "len"))

; Get the capacity.
; Returns: Int
(defn set-cap ((s Set))
  (struct-get s "cap"))

; Internal: index of key k, or -1 if absent. Scans from i to end.
(defn set-find ((s Set) (k Int) (i Int))
  (if (>= i (set-len s))
    -1
    (let stored (w-get (struct-get s "ptr") i)
      (if (== k stored)
        i
        (set-find s k (+ i 1))))))

; Whether k is present.
; Returns: Bool
(defn set-contains ((s Set) (k Int))
  (>= (set-find s k 0) 0))

; Insert k. If k is already present, this is a no-op (returns s unchanged).
; Returns: Set
(defn set-add ((s Set) (k Int))
  (if (>= (set-find s k 0) 0)
    s
    (let len (set-len s)
      (if (>= len (set-cap s))
        (let new-cap (if (<= (set-cap s) 0) 16 (* (set-cap s) 2))
          (let new-ptr (w-alloc new-cap)
            (let old-ptr (struct-get s "ptr")
              (begin
                (for (j 0) (< j len)
                  (begin
                    (w-set new-ptr j (w-get old-ptr j))
                    (set! j (+ j 1))))
                (w-set new-ptr len k)
                (make-Set new-ptr (+ len 1) new-cap)))))
        (let new-ptr (struct-get s "ptr")
          (begin
            (w-set new-ptr len k)
            (make-Set new-ptr (+ len 1) (struct-get s "cap"))))))))

; Remove k. Compacts the array so iteration order stays dense.
; Returns: Set
(defn set-remove ((s Set) (k Int))
  (let idx (set-find s k 0)
    (if (< idx 0)
      s
      (let len (set-len s)
        (let new-ptr (struct-get s "ptr")
          (begin
            (for (j idx) (< j (- len 1))
              (begin
                (w-set new-ptr j (w-get new-ptr (+ j 1)))
                (set! j (+ j 1))))
            (make-Set new-ptr (- len 1) (struct-get s "cap"))))))))
