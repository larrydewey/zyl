; === Zyl Standard Library — I/O ===
; Module: io
; Provides: File I/O operations (builtin file-open/file-read/file-write/file-close),
;           stdin/stdout helpers, and the OutputStream trait for generic output.

(use allocator/allocator)

; ===========================================================================
; FILE OPERATIONS
; ===========================================================================

; Open a file for reading. Returns a file handle (Int), or -1 on error.
; Returns: Int (handle)
(defn io-file-open-read (path)
  (file-open path "r"))

; Open a file for writing (truncates). Returns a file handle (Int), or -1 on error.
; Returns: Int (handle)
(defn io-file-open-write (path)
  (file-open path "w"))

; Open a file for appending. Returns a file handle (Int), or -1 on error.
; Returns: Int (handle)
(defn io-file-open-append (path)
  (file-open path "a"))

; Close a file
; Returns: Unit
(defn io-file-close (handle)
  (file-close handle))

; Read data from file. Returns a String (content).
; Returns: String
(defn io-file-read (handle count)
  (file-read handle count))

; Write data to file. Returns number of bytes written.
; Returns: Int (bytes written)
(defn io-file-write (handle data)
  (file-write handle data))

; ===========================================================================
; STDIN/STDOUT HELPERS
; ===========================================================================

; Read a line from stdin
; Returns: String
(defn io-read-line ()
  (read-line))

; Print to stdout
; Returns: Unit
(defn io-print (x)
  (print x))

; Print an integer
; Returns: Unit
(defn io-print-int (n)
  (print n))

; Print a string
; Returns: Unit
(defn io-print-string (s)
  (print s))

; Print a float
; Returns: Unit
(defn io-print-float (f)
  (print f))

; Print a newline
; Returns: Unit
(defn io-newline ()
  (print ""))

; ===========================================================================
; ERROR HANDLING FOR I/O
; ===========================================================================

; Try to read from file, return Result
; Returns: Result<String, Int>
; NOTE: Uses explicit Ok/Err — `try`/`catch` (spec §12.2 Result sugar) is not yet
;       desugared by the compiler, so it would emit undefined _ZYL_try/_ZYL_catch
;       symbols at link time. These wrappers are behaviorally identical to
;       `(try (Ok X) (catch e (Err e)))` since the try body is always Ok.
(defn io-safe-read (handle count)
  (Ok (file-read handle count)))

; Try to write to file, return Result
; Returns: Result<Int, Int>
(defn io-safe-write (handle data)
  (Ok (file-write handle data)))

; Try to close file, return Result
; Returns: Result<Unit, Int>
(defn io-safe-close (handle)
  (Ok (file-close handle)))

; ===========================================================================
; OUTPUT STREAM TRAIT
; ===========================================================================

; Generic output abstraction. Implementations receive `self` typed as the
; concrete impl type; dispatch resolves `(Trait.method receiver ...)` to
; `(Trait.method_ImplType receiver ...)` at monomorphization time.

(defstruct Stdout (fd Int))

; Construct an OutputStream writing to stdout (fd 1).
; Returns: Stdout
(defn make-stdout ()
  (make-Stdout 1))

; Growable, arena-backed byte buffer: the text buffer, its length and its
; capacity in mutable cells (runtime Ref), and the arena that owns the
; storage (reclaimed by string-buffer-destroy). Content is appended in place
; with buf-append; when len + chunk + 1 exceeds the capacity, a larger
; buffer is taken from the arena and the content copied into it.
(defstruct StringBuffer (buf (Ref StrBuf)) (len (Ref Int)) (cap (Ref Int)) (arena Arena) (fd Int))

(defn sb-ref-get (r) (ffi-call "zyl_ref_get" r 1000))
(defn sb-ref-set (r v) (ffi-call "zyl_ref_set" r v 1000))

(trait OutputStream
  (write (self) (chunk String) Int)
  (flush (self) Int))

(impl OutputStream Stdout
  (defn write (self chunk) (file-write (struct-get self "fd") chunk))
  (defn flush (self) 0))

(impl OutputStream StringBuffer
  (defn write (self chunk)
    (let len (sb-ref-get (struct-get self "len"))
      (let cap (sb-ref-get (struct-get self "cap"))
        (let clen (alloc-strlen chunk)
          (let need (+ (+ len clen) 1)
            (begin
              (if (> need cap)
                (let new-cap (if (> (* cap 2) need) (* cap 2) need)
                  (let bigger (buf-new (struct-get self "arena") new-cap)
                    (begin
                      (buf-append bigger (buf-str (sb-ref-get (struct-get self "buf"))))
                      (sb-ref-set (struct-get self "buf") bigger)
                      (sb-ref-set (struct-get self "cap") new-cap))))
                unit)
              (buf-append (sb-ref-get (struct-get self "buf")) chunk)
              (sb-ref-set (struct-get self "len") (+ len clen))
              (+ len clen)))))))
  (defn flush (self) (begin (file-write (struct-get self "fd") (string-buffer-str self)) 0)))

; Content of a StringBuffer.
; Returns: String
(defn string-buffer-str ((sb StringBuffer))
  (buf-str (sb-ref-get (struct-get sb "buf"))))

; Current content length of a StringBuffer.
; Returns: Int
(defn string-buffer-len ((sb StringBuffer))
  (sb-ref-get (struct-get sb "len")))

; Destroy a StringBuffer, reclaiming its arena.
; Returns: Unit
(defn string-buffer-destroy ((sb StringBuffer))
  (arena-destroy (struct-get sb "arena")))

; Construct an arena-backed StringBuffer output stream.
; Starts with a 64-byte zeroed block; grows automatically on overflow.
; The arena is reclaimed via `string-buffer-destroy`.
; Returns: StringBuffer
(defn make-string-buffer ()
  (let a (arena-create 0)
    (make-StringBuffer (ffi-call "zyl_ref_new" (buf-new a 64) 1000)
                       (ffi-call "zyl_ref_new" 0 1000)
                       (ffi-call "zyl_ref_new" 64 1000)
                       a 1)))
