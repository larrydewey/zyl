; === Zyl LSP — Main Server Loop ===
; Module: lsp/lsp_server
; JSON-RPC stdio loop: read one Content-Length-framed message, dispatch
; by method, write a response (requests) or nothing (notifications),
; loop -- until `exit`. State (DocManager, Workspace) is threaded
; through the loop as plain function arguments (no mutable globals
; anywhere in this compiler -- top-level `def` isn't a real readable
; global; see codegen.zyl's cg-load-nonslot comment).

(use core/core)
(use core/list)
(use core/option)
(use core/map)
(use allocator/allocator)
(use lsp/lsp_types)
(use lsp/json_rpc)
(use lsp/vfs)
(use lsp/document_manager)
(use lsp/compiler_bridge)
(use lsp/source_index)
(use lsp/capability_registry)
(use lsp/workspace)
(use lsp/services/hover)
(use lsp/services/goto_definition)
(use lsp/services/completion)
(use lsp/services/document_symbols)
(use lsp/services/semantic_tokens)
(use lsp/services/code_action)
(use lsp/services/call_hierarchy)
(use lsp/services/inlay_hints)
(use lsp/services/signature_help)
(use lsp/repl_integration)

(defn lsp-run-server (arena)
  (lsp-loop arena (dm-new) (ws-new) 1))

(defn lsp-loop (arena dm ws running)
  (if (= running 0)
    0
    (match (jr-read-message)
      (None 0)
      (Some raw
        (match (jr-decode-message raw)
          (Right notif (lsp-handle-notification arena dm ws notif))
          (Left req (lsp-handle-request arena dm ws req running)))))))

; ===========================================================================
; PARAM ACCESSORS — LSPAny (a decoded JSON object) -> the handful of
; shapes every handler below actually needs.
; ===========================================================================

(defn lsp-obj-get (paramsOpt key)
  (match paramsOpt
    (Some (LSPObject obj) (map-get obj key))
    (_ None)))

(defn lsp-get-str (paramsOpt key default)
  (match (lsp-obj-get paramsOpt key)
    (Some (LSPString s) s)
    (_ default)))

(defn lsp-get-int (paramsOpt key default)
  (match (lsp-obj-get paramsOpt key)
    (Some (LSPInt i) i)
    (_ default)))

(defn lsp-text-document-uri (paramsOpt)
  (match (lsp-obj-get paramsOpt "textDocument")
    (Some (LSPObject obj)
      (match (map-get obj "uri")
        (Some (LSPString s) s)
        (_ "")))
    (_ "")))

(defn lsp-position-of (paramsOpt)
  (match (lsp-obj-get paramsOpt "position")
    (Some (LSPObject obj)
      (let line (lsp-any-int (map-get obj "line"))
        (let ch (lsp-any-int (map-get obj "character"))
          (Pos line ch))))
    (_ (Pos 0 0))))

(defn lsp-any-int (o)
  (match o (Some (LSPInt i) i) (_ 0)))

; ===========================================================================
; NOTIFICATIONS
; ===========================================================================

(defn lsp-handle-notification (arena dm ws notif)
  (match notif
    (NotifMsg _ method paramsOpt
      (if (> (str-eq method "textDocument/didOpen") 0)
        (lsp-on-did-open arena dm ws paramsOpt)
        (if (> (str-eq method "textDocument/didChange") 0)
          (lsp-on-did-change arena dm ws paramsOpt)
          (if (> (str-eq method "textDocument/didClose") 0)
            (lsp-on-did-close arena dm ws paramsOpt)
            (if (> (str-eq method "textDocument/didSave") 0)
              (lsp-on-did-save arena dm ws paramsOpt)
            (if (> (str-eq method "initialized") 0)
              (lsp-loop arena dm ws 1)
              (if (> (str-eq method "exit") 0)
                (lsp-loop arena dm ws 0)
                (lsp-loop arena dm ws 1))))))))))

(defn lsp-on-did-open (arena dm ws paramsOpt)
  (match (lsp-obj-get paramsOpt "textDocument")
    (Some (LSPObject obj)
      (let uri (lsp-any-str (map-get obj "uri"))
        (let text (lsp-any-str (map-get obj "text"))
          (let version (lsp-any-int (map-get obj "version"))
            (let langId (lsp-any-str (map-get obj "languageId"))
              (let dm2 (dm-on-open arena dm uri text version langId)
                (begin
                  (lsp-publish-diagnostics dm2 uri)
                  (lsp-loop arena dm2 ws 1))))))))
    (_ (lsp-loop arena dm ws 1))))

(defn lsp-any-str (o)
  (match o (Some (LSPString s) s) (_ "")))

; Full-document sync only (TextDocumentSyncKind Incremental is
; advertised, but every change event here is applied as a full-text
; replace when it carries no range, and as a single-edit range replace
; otherwise -- both go through vfs.zyl's real edit application either
; way, so behavior is correct regardless of which the client sends).
(defn lsp-on-did-change (arena dm ws paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (let version (lsp-doc-version paramsOpt)
      (match (lsp-obj-get paramsOpt "contentChanges")
        (Some (LSPArray changes)
          (match changes
            (Cons (LSPObject ch) _
              (match (map-get ch "range")
                (Some (LSPObject rangeObj)
                  (let dm2 (dm-on-change arena dm uri (Cons (lsp-text-edit-of ch rangeObj) Nil) version)
                    (begin (lsp-publish-diagnostics dm2 uri) (lsp-loop arena dm2 ws 1))))
                (None
                  (let dm2 (dm-on-full-change arena dm uri (lsp-any-str (map-get ch "text")) version)
                    (begin (lsp-publish-diagnostics dm2 uri) (lsp-loop arena dm2 ws 1))))))
            (_ (lsp-loop arena dm ws 1))))
        (_ (lsp-loop arena dm ws 1))))))

(defn lsp-doc-version (paramsOpt)
  (match (lsp-obj-get paramsOpt "textDocument")
    (Some (LSPObject obj) (lsp-any-int (map-get obj "version")))
    (_ 0)))

(defn lsp-text-edit-of (ch rangeObj)
  (TE (lsp-range-of rangeObj) (lsp-any-str (map-get ch "text"))))

(defn lsp-range-of (rangeObj)
  (Rng (lsp-pos-field rangeObj "start") (lsp-pos-field rangeObj "end")))

(defn lsp-pos-field (rangeObj key)
  (match (map-get rangeObj key)
    (Some (LSPObject p) (Pos (lsp-any-int (map-get p "line")) (lsp-any-int (map-get p "character"))))
    (_ (Pos 0 0))))

; didSave is advertised with includeText, so the notification carries
; the saved text and the document is re-analysed from it. A client that
; sends the notification WITHOUT text still gets a re-analysis, of the
; buffer the server already holds -- which is the same text, since a
; save cannot change it.
(defn lsp-on-did-save (arena dm ws paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (match (lsp-obj-get paramsOpt "text")
      (Some (LSPString text)
        (let dm2 (dm-on-full-change arena dm uri text (lsp-doc-version paramsOpt))
          (begin (lsp-publish-diagnostics dm2 uri) (lsp-loop arena dm2 ws 1))))
      (_
        (match (dm-get-text dm uri)
          (Some text
            (let dm2 (dm-on-full-change arena dm uri text (lsp-doc-version paramsOpt))
              (begin (lsp-publish-diagnostics dm2 uri) (lsp-loop arena dm2 ws 1))))
          (None (lsp-loop arena dm ws 1)))))))

(defn lsp-on-did-close (arena dm ws paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (lsp-loop arena (dm-on-close dm uri) ws 1)))

(defn lsp-publish-diagnostics (dm uri)
  (let diags (dm-get-diagnostics dm uri)
    (let obj0 (map-insert (map-new) "uri" (LSPString uri))
      (let obj1 (map-insert obj0 "diagnostics" (lsp-diags-to-any diags))
        (jr-write-message (jr-encode-notification (NotifMsg "2.0" "textDocument/publishDiagnostics" (Some (LSPObject obj1)))))))))

(defn lsp-diags-to-any (diags)
  (LSPArray (lsp-diag-list diags)))

(defn lsp-diag-list (diags)
  (match diags
    (Nil Nil)
    (Cons d rest (Cons (lsp-diag-to-any d) (lsp-diag-list rest)))))

(defn lsp-diag-to-any (d)
  (match d
    (Diag rng sev tag code codeDesc source message related data
      (let obj0 (map-insert (map-new) "range" (lsp-range-to-any rng))
        (let obj1 (map-insert obj0 "message" (LSPString message))
          (let obj2 (match sev (Some s (map-insert obj1 "severity" (LSPInt (lsp-severity-int s)))) (None obj1))
            (let obj3 (match source (Some s (map-insert obj2 "source" (LSPString s))) (None obj2))
              (LSPObject (lsp-diag-code-field obj3 code)))))))))

; The error code (`E_ARITY_MISMATCH`, `E_CT_VIOLATION`, ...) as the
; protocol's `code` field, so a client can group, filter or link on it
; rather than only matching the message text. Appendix A of the book
; lists what each one means.
(defn lsp-diag-code-field (obj code)
  (match code
    (Some (Left s) (map-insert obj "code" (LSPString s)))
    (Some (Right n) (map-insert obj "code" (LSPInt n)))
    (None obj)))

(defn lsp-severity-int (s)
  (match s (DSError 1) (DSWarning 2) (DSInformation 3) (DSHint 4)))

(defn lsp-range-to-any (r)
  (match r (Rng s e (LSPObject (map-insert (map-insert (map-new) "start" (lsp-pos-to-any s)) "end" (lsp-pos-to-any e))))))

(defn lsp-pos-to-any (p)
  (match p (Pos l c (LSPObject (map-insert (map-insert (map-new) "line" (LSPInt l)) "character" (LSPInt c))))))

; ===========================================================================
; REQUESTS
; ===========================================================================

(defn lsp-handle-request (arena dm ws req running)
  (match req
    (ReqMsg _ id method paramsOpt
      (if (> (str-eq method "initialize") 0)
        (lsp-req-initialize arena dm ws id paramsOpt)
        (if (> (str-eq method "shutdown") 0)
          (begin (lsp-respond id (Some LSPNull) None) (lsp-loop arena dm ws running))
          (if (> (str-eq method "exit") 0)
            (lsp-loop arena dm ws 0)
            (if (> (str-eq method "textDocument/hover") 0)
              (lsp-req-hover arena dm ws id paramsOpt)
              (if (> (str-eq method "textDocument/definition") 0)
                (lsp-req-definition arena dm ws id paramsOpt)
                (if (> (str-eq method "textDocument/completion") 0)
                  (lsp-req-completion arena dm ws id paramsOpt)
                  (if (> (str-eq method "textDocument/documentSymbol") 0)
                    (lsp-req-document-symbol arena dm ws id paramsOpt)
                    (if (> (str-eq method "textDocument/semanticTokens/full") 0)
                      (lsp-req-semantic-tokens arena dm ws id paramsOpt)
                      (if (> (str-eq method "textDocument/codeAction") 0)
                        (lsp-req-code-action arena dm ws id paramsOpt)
                        (if (> (str-eq method "textDocument/foldingRange") 0)
                          (lsp-req-folding-range arena dm ws id paramsOpt)
                          (if (> (str-eq method "textDocument/selectionRange") 0)
                            (lsp-req-selection-range arena dm ws id paramsOpt)
                            (if (> (str-eq method "textDocument/formatting") 0)
                              (lsp-req-formatting arena dm ws id paramsOpt)
                              (if (> (str-eq method "textDocument/prepareRename") 0)
                                (lsp-req-prepare-rename arena dm ws id paramsOpt)
                                (if (> (str-eq method "textDocument/rename") 0)
                                  (lsp-req-rename arena dm ws id paramsOpt)
                                  (if (> (str-eq method "workspace/symbol") 0)
                                    (lsp-req-workspace-symbol arena dm ws id paramsOpt)
                                    (if (> (str-eq method "workspace/executeCommand") 0)
                                      (lsp-req-execute-command arena dm ws id paramsOpt)
                                      (if (> (str-eq method "textDocument/prepareCallHierarchy") 0)
                                        (lsp-req-prepare-call-hierarchy arena dm ws id paramsOpt)
                                        (if (> (str-eq method "callHierarchy/incomingCalls") 0)
                                          (lsp-req-incoming-calls arena dm ws id paramsOpt)
                                          (if (> (str-eq method "callHierarchy/outgoingCalls") 0)
                                            (lsp-req-outgoing-calls arena dm ws id paramsOpt)
                                            (if (> (str-eq method "textDocument/inlayHint") 0)
                                              (lsp-req-inlay-hint arena dm ws id paramsOpt)
                                              (lsp-handle-request-2 arena dm ws id method paramsOpt running))))))))))))))))))))))))

(defn lsp-respond (id result error)
  (jr-write-message (jr-encode-response (RespMsg "2.0" id result error))))

; The request table is split in two purely for shape: one `if` chain
; deep enough to hold every method this server answers nests further
; than is readable (or than is kind to the code generator). Methods
; added after the original set live here; there is no other difference
; between the two halves.
(defn lsp-handle-request-2 (arena dm ws id method paramsOpt running)
  (if (> (str-eq method "textDocument/references") 0)
    (lsp-req-references arena dm ws id paramsOpt)
    (if (> (str-eq method "textDocument/documentHighlight") 0)
      (lsp-req-document-highlight arena dm ws id paramsOpt)
      (if (> (str-eq method "textDocument/signatureHelp") 0)
        (lsp-req-signature-help arena dm ws id paramsOpt)
        (if (> (str-eq method "textDocument/typeDefinition") 0)
          (lsp-req-type-definition arena dm ws id paramsOpt)
          (if (> (str-eq method "textDocument/implementation") 0)
            (lsp-req-implementation arena dm ws id paramsOpt)
            (if (> (str-eq method "textDocument/semanticTokens/range") 0)
              (lsp-req-semantic-tokens-range arena dm ws id paramsOpt)
              (if (> (str-eq method "textDocument/rangeFormatting") 0)
                (lsp-req-formatting arena dm ws id paramsOpt)
                (begin
                  (lsp-respond id None (Some (RErr -32601 (str-concat "method not found: " method) None)))
                  (lsp-loop arena dm ws running))))))))))

(defn lsp-req-references (arena dm ws id paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (let pos (lsp-position-of paramsOpt)
      (begin
        (match (dm-get-text dm uri)
          (Some text
            (lsp-respond id (Some (LSPArray (lsp-loc-list-any
              (references-at text uri (Pos.line-of pos) (Pos.col-of pos) (lsp-include-declaration paramsOpt))))) None))
          (None (lsp-respond id (Some (LSPArray Nil)) None)))
        (lsp-loop arena dm ws 1)))))

; context.includeDeclaration, defaulting to true when the client omits
; the context entirely -- which is what the protocol says a server
; should assume.
(defn lsp-include-declaration (paramsOpt)
  (match (lsp-obj-get paramsOpt "context")
    (Some (LSPObject ctx)
      (match (map-get ctx "includeDeclaration")
        (Some (LSPBool b) b)
        (_ 1)))
    (_ 1)))

(defn lsp-loc-list-any (locs)
  (match locs
    (Nil Nil)
    (Cons l rest (Cons (lsp-location-any l) (lsp-loc-list-any rest)))))

(defn lsp-req-document-highlight (arena dm ws id paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (let pos (lsp-position-of paramsOpt)
      (begin
        (match (dm-get-text dm uri)
          (Some text
            (lsp-respond id (Some (LSPArray (lsp-highlight-list-any (document-highlights-at text (Pos.line-of pos) (Pos.col-of pos))))) None))
          (None (lsp-respond id (Some (LSPArray Nil)) None)))
        (lsp-loop arena dm ws 1)))))

; DocumentHighlightKind 1 is Text -- this server does not distinguish
; a read from a write, and saying "Text" is the honest answer rather
; than colouring every occurrence as if it were a write.
(defn lsp-highlight-list-any (rngs)
  (match rngs
    (Nil Nil)
    (Cons r rest
      (Cons (LSPObject (map-insert (map-insert (map-new) "range" (lsp-range-to-any r)) "kind" (LSPInt 1)))
            (lsp-highlight-list-any rest)))))

(defn lsp-req-signature-help (arena dm ws id paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (let pos (lsp-position-of paramsOpt)
      (begin
        (match (dm-get-text dm uri)
          (Some text
            (match (dm-get-symtable dm uri)
              (Some tbl
                (match (signature-help-at text tbl (Pos.line-of pos) (Pos.col-of pos))
                  (Some sh (lsp-respond id (Some (lsp-sighelp-any sh)) None))
                  (None (lsp-respond id (Some LSPNull) None))))
              (None (lsp-respond id (Some LSPNull) None))))
          (None (lsp-respond id (Some LSPNull) None)))
        (lsp-loop arena dm ws 1)))))

(defn lsp-sighelp-any (sh)
  (match sh
    (SigHelp sigs activeSig activeParam
      (LSPObject
        (map-insert
          (map-insert
            (map-insert (map-new) "signatures" (LSPArray (lsp-siginfo-list-any sigs)))
            "activeSignature" (LSPInt (lsp-opt-int activeSig)))
          "activeParameter" (LSPInt (lsp-opt-int activeParam)))))))

(defn lsp-opt-int (o) (match o (Some n n) (None 0)))

(defn lsp-siginfo-list-any (sigs)
  (match sigs
    (Nil Nil)
    (Cons s rest (Cons (lsp-siginfo-any s) (lsp-siginfo-list-any rest)))))

(defn lsp-siginfo-any (s)
  (match s
    (SigInfo label docOpt params activeParam
      (LSPObject
        (map-insert
          (map-insert
            (map-insert (map-new) "label" (LSPString label))
            "documentation" (match docOpt (Some d (LSPString d)) (None LSPNull)))
          "parameters" (LSPArray (lsp-paraminfo-list-any params)))))))

(defn lsp-paraminfo-list-any (params)
  (match params
    (Nil Nil)
    (Cons p rest
      (match p
        (ParamInfo label _
          (Cons (LSPObject (map-insert (map-new) "label" (LSPString label)))
                (lsp-paraminfo-list-any rest)))))))

(defn lsp-req-type-definition (arena dm ws id paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (let pos (lsp-position-of paramsOpt)
      (begin
        (match (dm-get-text dm uri)
          (Some text
            (match (dm-get-symtable dm uri)
              (Some tbl
                (match (type-definition-at text tbl uri (Pos.line-of pos) (Pos.col-of pos))
                  (Some loc (lsp-respond id (Some (lsp-location-any loc)) None))
                  (None (lsp-respond id (Some LSPNull) None))))
              (None (lsp-respond id (Some LSPNull) None))))
          (None (lsp-respond id (Some LSPNull) None)))
        (lsp-loop arena dm ws 1)))))

(defn lsp-req-implementation (arena dm ws id paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (let pos (lsp-position-of paramsOpt)
      (begin
        (match (dm-get-text dm uri)
          (Some text
            (lsp-respond id (Some (LSPArray (lsp-loc-list-any (implementations-at text uri (Pos.line-of pos) (Pos.col-of pos))))) None))
          (None (lsp-respond id (Some (LSPArray Nil)) None)))
        (lsp-loop arena dm ws 1)))))

(defn lsp-req-semantic-tokens-range (arena dm ws id paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (begin
      (match (dm-get-text dm uri)
        (Some text
          (match (dm-get-symtable dm uri)
            (Some tbl
              (lsp-respond id
                (Some (LSPObject (map-insert (map-new) "data"
                        (LSPArray (lsp-int-list-any
                          (semantic-tokens-range-for text tbl (lsp-range-start-line paramsOpt) (lsp-range-end-line paramsOpt)))))))
                None))
            (None (lsp-respond id (Some LSPNull) None))))
        (None (lsp-respond id (Some LSPNull) None)))
      (lsp-loop arena dm ws 1))))

(defn lsp-range-start-line (paramsOpt)
  (match (lsp-obj-get paramsOpt "range")
    (Some (LSPObject r) (lsp-pos-line-of r "start"))
    (_ 0)))

(defn lsp-range-end-line (paramsOpt)
  (match (lsp-obj-get paramsOpt "range")
    (Some (LSPObject r) (lsp-pos-line-of r "end"))
    (_ 1000000)))

(defn lsp-pos-line-of (r key)
  (match (map-get r key)
    (Some (LSPObject p) (lsp-any-int (map-get p "line")))
    (_ 0)))

(defn lsp-req-initialize (arena dm ws id paramsOpt)
  (let ws2
    (match (lsp-obj-get paramsOpt "workspaceFolders")
      (Some (LSPArray folders) (WS (lsp-folder-uris folders)))
      (_ ws))
    (begin
      (lsp-respond id (Some (lsp-initialize-result-any)) None)
      (lsp-loop arena dm ws2 1))))

(defn lsp-folder-uris (folders)
  (match folders
    (Nil Nil)
    (Cons (LSPObject obj) rest (Cons (lsp-any-str (map-get obj "uri")) (lsp-folder-uris rest)))
    (Cons _ rest (lsp-folder-uris rest))))

; The capability registry builds real typed ServerCapabilities values;
; json_rpc's encoder only knows LSPAny -> JSON. capability-any bridges
; the one place these two type worlds meet, by hand, since
; ServerCapabilities has no LSPAny encoding of its own (it's a Zyl-side
; ADT, never round-tripped from the wire) -- only the handful of fields
; this server actually turns on need real values; the rest advertise
; false/absent.
(defn lsp-initialize-result-any ()
  (LSPObject
    (map-insert
      (map-insert (map-new) "capabilities" (lsp-capabilities-any))
      "serverInfo" (LSPObject (map-insert (map-insert (map-new) "name" (LSPString "Zyl Language Server")) "version" (LSPString "0.1.0"))))))

(defn lsp-capabilities-any ()
  (let m0 (map-new)
    (let m1 (map-insert m0 "textDocumentSync" (lsp-sync-options-any))
      (let m2 (map-insert m1 "hoverProvider" (LSPBool 1))
        (let m3 (map-insert m2 "definitionProvider" (LSPBool 1))
          (let m4 (map-insert m3 "documentSymbolProvider" (LSPBool 1))
            (let m5 (map-insert m4 "completionProvider" (lsp-completion-options-any))
              (let m6 (map-insert m5 "semanticTokensProvider" (lsp-semantic-legend-any))
                (let m7 (map-insert m6 "codeActionProvider" (LSPBool 1))
                  (let m8 (map-insert m7 "foldingRangeProvider" (LSPBool 1))
                    (let m9 (map-insert m8 "selectionRangeProvider" (LSPBool 1))
                      (let m10 (map-insert m9 "documentFormattingProvider" (LSPBool 1))
                        (let m11 (map-insert m10 "renameProvider" (LSPObject (map-insert (map-new) "prepareProvider" (LSPBool 1))))
                          (let m12 (map-insert m11 "workspaceSymbolProvider" (LSPBool 1))
                            (let m13 (map-insert m12 "executeCommandProvider" (LSPObject (map-insert (map-new) "commands" (LSPArray (Cons (LSPString "zyl.evalDocument") Nil)))))
                              (let m14 (map-insert m13 "callHierarchyProvider" (LSPBool 1))
                                (let m15 (map-insert m14 "inlayHintProvider" (LSPBool 1))
                                  (LSPObject (lsp-capabilities-rest m15)))))))))))))))))))

; The second half of the advertisement, split off for the same reason
; the request table is: one `let` chain holding every capability nests
; past readable. Everything here was added alongside the handlers in
; lsp-handle-request-2.
(defn lsp-capabilities-rest (m)
  (let n1 (map-insert m "referencesProvider" (LSPBool 1))
    (let n2 (map-insert n1 "documentHighlightProvider" (LSPBool 1))
      (let n3 (map-insert n2 "typeDefinitionProvider" (LSPBool 1))
        (let n4 (map-insert n3 "implementationProvider" (LSPBool 1))
          (let n5 (map-insert n4 "documentRangeFormattingProvider" (LSPBool 1))
            (map-insert n5 "signatureHelpProvider" (lsp-sighelp-options-any))))))))

; Open/close notifications wanted, incremental sync, and didSave with
; the full text attached -- the server re-analyses on save as well as on
; change, and needs the text to do it.
(defn lsp-sync-options-any ()
  (LSPObject
    (map-insert
      (map-insert
        (map-insert (map-new) "openClose" (LSPBool 1))
        "change" (LSPInt 2))
      "save" (LSPObject (map-insert (map-new) "includeText" (LSPBool 1))))))

; `(` starts a form and is where a completion list is most useful; `:`
; leads a keyword atom such as `:le`; `/` separates the segments of a
; module path inside `(use ...)`.
(defn lsp-completion-options-any ()
  (LSPObject
    (map-insert
      (map-insert (map-new) "triggerCharacters"
        (LSPArray (Cons (LSPString "(") (Cons (LSPString ":") (Cons (LSPString "/") Nil)))))
      "resolveProvider" (LSPBool 0))))

(defn lsp-sighelp-options-any ()
  (LSPObject
    (map-insert
      (map-insert (map-new) "triggerCharacters" (LSPArray (Cons (LSPString "(") (Cons (LSPString " ") Nil))))
      "retriggerCharacters" (LSPArray (Cons (LSPString " ") Nil)))))

(defn lsp-semantic-legend-any ()
  (match (semantic-tokens-legend)
    (STLeg types mods
      (LSPObject
        (map-insert
          (map-insert
            (map-insert (map-new) "legend"
              (LSPObject (map-insert (map-insert (map-new) "tokenTypes" (LSPArray (lsp-str-list-any types)))
                                     "tokenModifiers" (LSPArray (lsp-str-list-any mods)))))
            "full" (LSPBool 1))
          "range" (LSPBool 1))))))

(defn lsp-str-list-any (xs)
  (match xs (Nil Nil) (Cons h t (Cons (LSPString h) (lsp-str-list-any t)))))

(defn lsp-req-hover (arena dm ws id paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (let pos (lsp-position-of paramsOpt)
      (begin
        (match (dm-get-text dm uri)
          (Some text
            (match (dm-get-symtable dm uri)
              (Some tbl
                (match (hover-at text tbl (Pos.line-of pos) (Pos.col-of pos))
                  (Some h (lsp-respond id (Some (lsp-hover-any h)) None))
                  (None (lsp-respond id (Some LSPNull) None))))
              (None (lsp-respond id (Some LSPNull) None))))
          (None (lsp-respond id (Some LSPNull) None)))
        (lsp-loop arena dm ws 1)))))

(defn Pos.line-of (p) (match p (Pos l _ l)))
(defn Pos.col-of (p) (match p (Pos _ c c)))

; `contents` as a MarkupContent object rather than a bare string: the
; hover text is markdown (fenced code plus prose) and a bare string is
; rendered as plaintext by every client that follows the spec.
(defn lsp-hover-any (h)
  (match h
    (Hov mc rngOpt
      (match mc
        (MC kind value
          (let base (map-insert (map-new) "contents" (lsp-markup-any kind value))
            (LSPObject (match rngOpt
                         (Some rng (map-insert base "range" (lsp-range-to-any rng)))
                         (None base)))))))))

(defn lsp-markup-any (kind value)
  (LSPObject
    (map-insert (map-insert (map-new) "kind" (LSPString (lsp-markup-kind-str kind)))
                "value" (LSPString value))))

(defn lsp-markup-kind-str (kind)
  (match kind (MKMarkdown "markdown") (MKPlainText "plaintext")))

(defn lsp-req-definition (arena dm ws id paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (let pos (lsp-position-of paramsOpt)
      (begin
        (match (dm-get-text dm uri)
          (Some text
            (match (dm-get-symtable dm uri)
              (Some tbl
                (match (definition-at text tbl uri (Pos.line-of pos) (Pos.col-of pos))
                  (Some loc (lsp-respond id (Some (lsp-location-any loc)) None))
                  (None (lsp-respond id (Some LSPNull) None))))
              (None (lsp-respond id (Some LSPNull) None))))
          (None (lsp-respond id (Some LSPNull) None)))
        (lsp-loop arena dm ws 1)))))

(defn lsp-location-any (loc)
  (match loc
    (Loc uri rng
      (LSPObject (map-insert (map-insert (map-new) "uri" (LSPString uri)) "range" (lsp-range-to-any rng))))))

(defn lsp-req-completion (arena dm ws id paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (let pos (lsp-position-of paramsOpt)
      (begin
        (match (dm-get-text dm uri)
          (Some text
            (match (dm-get-symtable dm uri)
              (Some tbl
                (lsp-respond id (Some (LSPArray (lsp-completion-list-any
                  (completion-items-at text tbl (Pos.line-of pos) (Pos.col-of pos))))) None))
              (None (lsp-respond id (Some (LSPArray Nil)) None))))
          (None (lsp-respond id (Some (LSPArray Nil)) None)))
        (lsp-loop arena dm ws 1)))))

(defn lsp-completion-list-any (items)
  (match items
    (Nil Nil)
    (Cons ci rest (Cons (lsp-completion-item-any ci) (lsp-completion-list-any rest)))))

(defn lsp-completion-item-any (ci)
  (match ci
    (CI label kind _ _ _ _ detail documentation _ _ _ _ _ _ _
      (let obj0 (map-insert (map-new) "label" (LSPString label))
        (let obj1 (match kind (Some k (map-insert obj0 "kind" (LSPInt (lsp-cik-int k)))) (None obj0))
          (let obj2 (match detail (Some d (map-insert obj1 "detail" (LSPString d))) (None obj1))
            (LSPObject (match documentation
                         (Some mc (map-insert obj2 "documentation" (lsp-mc-any mc)))
                         (None obj2)))))))))

(defn lsp-mc-any (mc)
  (match mc (MC kind value (lsp-markup-any kind value))))

; The first twenty-five are the protocol's own numbering. The six after
; them are Zyl-specific kinds with no protocol number of their own, each
; mapped to the standard kind a client already renders sensibly --
; a capability and a region read as constants, a variant as an enum
; member, a trait method as a method, and both an FFI call and an actor
; spawn as functions.
(defn lsp-cik-int (k)
  (match k
    (CIKText 1) (CIKMethod 2) (CIKFunction 3) (CIKConstructor 4) (CIKField 5)
    (CIKVariable 6) (CIKClass 7) (CIKInterface 8) (CIKModule 9) (CIKProperty 10)
    (CIKUnit 11) (CIKValue 12) (CIKEnum 13) (CIKKeyword 14) (CIKSnippet 15) (CIKColor 16)
    (CIKFile 17) (CIKReference 18) (CIKFolder 19) (CIKEnumMember 20) (CIKConstant 21)
    (CIKStruct 22) (CIKEvent 23) (CIKOperator 24) (CIKTypeParameter 25)
    (CIKCapability 21) (CIKRegion 21) (CIKVariant 20) (CIKTraitMethod 2)
    (CIKFFICall 3) (CIKActorSpawn 3)
    (_ 22)))

(defn lsp-req-document-symbol (arena dm ws id paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (begin
      (match (dm-get-text dm uri)
        (Some text (lsp-respond id (Some (LSPArray (lsp-dsym-list-any (document-symbols-for text)))) None))
        (None (lsp-respond id (Some (LSPArray Nil)) None)))
      (lsp-loop arena dm ws 1))))

(defn lsp-dsym-list-any (syms)
  (match syms
    (Nil Nil)
    (Cons s rest (Cons (lsp-dsym-any s) (lsp-dsym-list-any rest)))))

(defn lsp-dsym-any (s)
  (match s
    (DSym name detail kind tags rng selRng children data
      (LSPObject
        (map-insert (map-insert (map-insert (map-insert (map-new)
          "name" (LSPString name))
          "kind" (LSPInt (lsp-sk-int kind)))
          "range" (lsp-range-to-any rng))
          "selectionRange" (lsp-range-to-any selRng))))))

(defn lsp-sk-int (k)
  (match k
    (SKFile 1) (SKModule 2) (SKNamespace 3) (SKPackage 4) (SKClass 5) (SKMethod 6) (SKProperty 7) (SKField 8) (SKConstructor 9) (SKEnum 10)
    (SKInterface 11) (SKFunction 12) (SKVariable 13) (SKConstant 14) (SKString 15) (SKNumber 16) (SKBoolean 17) (SKArray 18) (SKObject 19)
    (_ 12)))

(defn lsp-req-semantic-tokens (arena dm ws id paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (begin
      (match (dm-get-text dm uri)
        (Some text
          (match (dm-get-symtable dm uri)
            (Some tbl (lsp-respond id (Some (LSPObject (map-insert (map-new) "data" (LSPArray (lsp-int-list-any (semantic-tokens-for text tbl)))))) None))
            (None (lsp-respond id (Some LSPNull) None))))
        (None (lsp-respond id (Some LSPNull) None)))
      (lsp-loop arena dm ws 1))))

(defn lsp-int-list-any (xs)
  (match xs (Nil Nil) (Cons h t (Cons (LSPInt h) (lsp-int-list-any t)))))

(defn lsp-req-code-action (arena dm ws id paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (begin
      (lsp-respond id (Some (LSPArray (lsp-action-list-any (code-actions-for (dm-get-diagnostics dm uri))))) None)
      (lsp-loop arena dm ws 1))))

(defn lsp-action-list-any (actions)
  (match actions
    (Nil Nil)
    (Cons a rest (Cons (lsp-action-any a) (lsp-action-list-any rest)))))

(defn lsp-action-any (a)
  (match a
    (CA title kind diag _ _ edit _ _ _
      (LSPObject (map-insert (map-new) "title" (LSPString title))))))

(defn lsp-req-folding-range (arena dm ws id paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (begin
      (match (dm-get-text dm uri)
        (Some text (lsp-respond id (Some (LSPArray (lsp-fold-list-any (folding-ranges-for text)))) None))
        (None (lsp-respond id (Some (LSPArray Nil)) None)))
      (lsp-loop arena dm ws 1))))

(defn lsp-fold-list-any (frs)
  (match frs
    (Nil Nil)
    (Cons f rest (Cons (lsp-fold-any f) (lsp-fold-list-any rest)))))

(defn lsp-fold-any (f)
  (match f
    (FR startLine endLine _ _ _ _
      (LSPObject (map-insert (map-insert (map-new) "startLine" (LSPInt startLine)) "endLine" (LSPInt endLine))))))

(defn lsp-req-selection-range (arena dm ws id paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (begin
      (match (dm-get-text dm uri)
        (Some text
          (match (lsp-obj-get paramsOpt "positions")
            (Some (LSPArray positions) (lsp-respond id (Some (LSPArray (lsp-selrange-list-any text positions))) None))
            (_ (lsp-respond id (Some (LSPArray Nil)) None))))
        (None (lsp-respond id (Some (LSPArray Nil)) None)))
      (lsp-loop arena dm ws 1))))

(defn lsp-selrange-list-any (text positions)
  (match positions
    (Nil Nil)
    (Cons (LSPObject p) rest
      (Cons (lsp-selrange-any (selection-range-at text (lsp-any-int (map-get p "line")) (lsp-any-int (map-get p "character"))))
            (lsp-selrange-list-any text rest)))
    (Cons _ rest (lsp-selrange-list-any text rest))))

(defn lsp-selrange-any (sr)
  (match sr (SelR rng _ (LSPObject (map-insert (map-new) "range" (lsp-range-to-any rng))))))

(defn lsp-req-formatting (arena dm ws id paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (begin
      (match (dm-get-text dm uri)
        (Some text
          (let formatted (format-document text)
            (lsp-respond id (Some (LSPArray (Cons (LSPObject (map-insert (map-insert (map-new) "range" (lsp-whole-doc-range text)) "newText" (LSPString formatted))) Nil))) None)))
        (None (lsp-respond id (Some (LSPArray Nil)) None)))
      (lsp-loop arena dm ws 1))))

(defn lsp-whole-doc-range (text)
  (Rng (Pos 0 0) (Pos (lsp-count-lines text) 0)))

(defn lsp-count-lines (text)
  (lsp-count-lines-loop text 0 0 (str-length text)))

(defn lsp-count-lines-loop (text i n len)
  (if (>= i len)
    n
    (if (= (ffi-call "zyl_cstr_byte_at" text i 1000) 10)
      (lsp-count-lines-loop text (+ i 1) (+ n 1) len)
      (lsp-count-lines-loop text (+ i 1) n len))))

(defn lsp-req-prepare-rename (arena dm ws id paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (let pos (lsp-position-of paramsOpt)
      (begin
        (match (dm-get-text dm uri)
          (Some text
            (match (prepare-rename-at text (Pos.line-of pos) (Pos.col-of pos))
              (Some rng (lsp-respond id (Some (lsp-range-to-any rng)) None))
              (None (lsp-respond id (Some LSPNull) None))))
          (None (lsp-respond id (Some LSPNull) None)))
        (lsp-loop arena dm ws 1)))))

(defn lsp-req-rename (arena dm ws id paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (let pos (lsp-position-of paramsOpt)
      (let new-name (lsp-get-str paramsOpt "newName" "")
        (begin
          (match (dm-get-text dm uri)
            (Some text
              (match (rename-at text uri (Pos.line-of pos) (Pos.col-of pos) new-name)
                (Some we (lsp-respond id (Some (lsp-workspace-edit-any we)) None))
                (None (lsp-respond id (Some LSPNull) None))))
            (None (lsp-respond id (Some LSPNull) None)))
          (lsp-loop arena dm ws 1))))))

(defn lsp-workspace-edit-any (we)
  (match we
    (WE changesOpt _ _
      (LSPObject (map-insert (map-new) "changes" (match changesOpt (Some m (lsp-changes-any m)) (None (LSPObject (map-new)))))))))

(defn lsp-changes-any (m)
  (LSPObject (map-map-values lsp-edits-any m)))

(defn lsp-edits-any (edits)
  (LSPArray (lsp-edit-list-any edits)))

(defn lsp-edit-list-any (edits)
  (match edits
    (Nil Nil)
    (Cons e rest (Cons (lsp-edit-any e) (lsp-edit-list-any rest)))))

(defn lsp-edit-any (e)
  (match e (TE rng newText (LSPObject (map-insert (map-insert (map-new) "range" (lsp-range-to-any rng)) "newText" (LSPString newText))))))

(defn lsp-req-workspace-symbol (arena dm ws id paramsOpt)
  (let query (lsp-get-str paramsOpt "query" "")
    (begin
      (lsp-respond id (Some (LSPArray (lsp-syminfo-list-any (ws-symbols-for-query dm query)))) None)
      (lsp-loop arena dm ws 1))))

; workspace/executeCommand -> "zyl.evalDocument": compile+run the given
; document's CURRENT (possibly unsaved) buffer text and return its
; captured stdout+stderr as the command result. Only command this server
; knows; only real dependency is repl_integration.zyl's repl-eval-text,
; unusable until zyl_system_cmd stopped segfaulting on every call (see
; that file's own header comment -- fixed in runtime/actor_runtime.c by
; replacing its vfork-via-system() body with posix_spawn, same fix
; zyl_cc_compile/zyl_run_bin already had).
(defn lsp-req-execute-command (arena dm ws id paramsOpt)
  (let cmd (lsp-get-str paramsOpt "command" "")
    (if (> (str-eq cmd "zyl.evalDocument") 0)
      (let uri (lsp-first-arg-uri paramsOpt)
        (begin
          (match (dm-get-text dm uri)
            (Some text
              (match (repl-eval-text text)
                (EvalOk out (lsp-respond id (Some (lsp-eval-result-any 1 out)) None))
                (EvalFail out (lsp-respond id (Some (lsp-eval-result-any 0 out)) None))))
            (None (lsp-respond id (Some LSPNull) None)))
          (lsp-loop arena dm ws 1)))
      (begin
        (lsp-respond id None (Some (RErr -32601 (str-concat "unknown command: " cmd) None)))
        (lsp-loop arena dm ws 1)))))

; `arguments` is a bare JSON array; this server's only command takes
; exactly one argument, the target document's URI as a plain string
; (see editors/vscode/src/extension.ts's zyl.evalDocument command).
(defn lsp-first-arg-uri (paramsOpt)
  (match (lsp-obj-get paramsOpt "arguments")
    (Some (LSPArray args)
      (match args
        (Cons (LSPString s) _ s)
        (_ "")))
    (_ "")))

(defn lsp-eval-result-any (ok output)
  (LSPObject
    (map-insert (map-insert (map-new) "ok" (LSPBool ok)) "output" (LSPString output))))

; ===========================================================================
; CALL HIERARCHY — see lsp/services/call_hierarchy for the scope/honesty
; notes (per-document only, fromRanges reuse the target's own declaration
; range rather than a real call-site position -- Wall 1).
; ===========================================================================

(defn lsp-req-prepare-call-hierarchy (arena dm ws id paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (let pos (lsp-position-of paramsOpt)
      (begin
        (match (dm-get-text dm uri)
          (Some text
            (match (dm-get-symtable dm uri)
              (Some tbl
                (let items (call-hierarchy-prepare text tbl uri (Pos.line-of pos) (Pos.col-of pos))
                  (if (> (list-length items) 0)
                    (lsp-respond id (Some (LSPArray (lsp-chitem-full-list-any items))) None)
                    (lsp-respond id (Some LSPNull) None))))
              (None (lsp-respond id (Some LSPNull) None))))
          (None (lsp-respond id (Some LSPNull) None)))
        (lsp-loop arena dm ws 1)))))

(defn lsp-chitem-full-list-any (items)
  (match items
    (Nil Nil)
    (Cons h t (Cons (lsp-chitem-any-full h) (lsp-chitem-full-list-any t)))))

(defn lsp-chitem-any (item)
  (let rng (lsp-range-to-any (CHI.range item))
    (LSPObject
      (map-insert
        (map-insert
          (map-insert
            (map-insert (map-new) "name" (LSPString (CHI.name item)))
            "kind" (LSPInt 12))
          "uri" (LSPString (CHI.uri item)))
        "range" rng)
      )))

; deftype CallHierarchyItem's wire shape needs BOTH "range" and
; "selectionRange"; lsp-chitem-any above builds everything except
; selectionRange (map-insert composition got unwieldy past 4 keys) --
; add it here instead of growing that one expression further.
(defn lsp-chitem-any-full (item)
  (let base (lsp-chitem-any item)
    (match base
      (LSPObject obj (LSPObject (map-insert obj "selectionRange" (lsp-range-to-any (CHI.range item)))))
      (_ base))))

(deftype NameUri (NU String String))

(defn lsp-call-hierarchy-item-of (paramsOpt)
  (match (lsp-obj-get paramsOpt "item")
    (Some (LSPObject obj)
      (let name (lsp-any-str (map-get obj "name"))
        (let uri (lsp-any-str (map-get obj "uri"))
          (if (> (str-length name) 0) (Some (NU name uri)) None)))
      )
    (_ None)))

(defn lsp-req-incoming-calls (arena dm ws id paramsOpt)
  (match (lsp-call-hierarchy-item-of paramsOpt)
    (Some pr
      (match pr
        (NU name uri
          (begin
            (match (dm-get-text dm uri)
              (Some text
                (match (dm-get-symtable dm uri)
                  (Some tbl (lsp-respond id (Some (LSPArray (lsp-incoming-list-any (call-hierarchy-incoming arena text tbl uri name)))) None))
                  (None (lsp-respond id (Some LSPNull) None))))
              (None (lsp-respond id (Some LSPNull) None)))
            (lsp-loop arena dm ws 1)))))
    (None (begin (lsp-respond id (Some LSPNull) None) (lsp-loop arena dm ws 1)))))

(defn lsp-incoming-list-any (calls)
  (match calls
    (Nil Nil)
    (Cons h t (Cons (lsp-incoming-any h) (lsp-incoming-list-any t)))))

(defn lsp-incoming-any (c)
  (let item (CHIncoming.item c)
    (LSPObject
      (map-insert (map-insert (map-new) "from" (lsp-chitem-any-full item)) "fromRanges" (LSPArray (Cons (lsp-range-to-any (CHI.range item)) Nil))))))

(defn lsp-req-outgoing-calls (arena dm ws id paramsOpt)
  (match (lsp-call-hierarchy-item-of paramsOpt)
    (Some pr
      (match pr
        (NU name uri
          (begin
            (match (dm-get-text dm uri)
              (Some text
                (match (dm-get-symtable dm uri)
                  (Some tbl (lsp-respond id (Some (LSPArray (lsp-outgoing-list-any (call-hierarchy-outgoing arena text tbl uri name)))) None))
                  (None (lsp-respond id (Some LSPNull) None))))
              (None (lsp-respond id (Some LSPNull) None)))
            (lsp-loop arena dm ws 1)))))
    (None (begin (lsp-respond id (Some LSPNull) None) (lsp-loop arena dm ws 1)))))

(defn lsp-outgoing-list-any (calls)
  (match calls
    (Nil Nil)
    (Cons h t (Cons (lsp-outgoing-any h) (lsp-outgoing-list-any t)))))

(defn lsp-outgoing-any (c)
  (let item (CHOutgoing.item c)
    (LSPObject
      (map-insert (map-insert (map-new) "to" (lsp-chitem-any-full item)) "fromRanges" (LSPArray (Cons (lsp-range-to-any (CHI.range item)) Nil))))))

; ===========================================================================
; INLAY HINTS — see lsp/services/inlay_hints for what this is (real
; parameter-name hints, not type hints) and why. `range` in the request
; is ignored: hints are computed for the whole document regardless
; (simple, correct; only a perf nicety would come from filtering, not
; wired up).
; ===========================================================================

(defn lsp-req-inlay-hint (arena dm ws id paramsOpt)
  (let uri (lsp-text-document-uri paramsOpt)
    (begin
      (match (dm-get-text dm uri)
        (Some text
          (match (dm-get-symtable dm uri)
            (Some tbl (lsp-respond id (Some (LSPArray (lsp-ihint-list-any (inlay-hints-for text tbl)))) None))
            (None (lsp-respond id (Some LSPNull) None))))
        (None (lsp-respond id (Some LSPNull) None)))
      (lsp-loop arena dm ws 1))))

(defn lsp-ihint-list-any (hints)
  (match hints
    (Nil Nil)
    (Cons h t (Cons (lsp-ihint-any h) (lsp-ihint-list-any t)))))

(defn lsp-ihint-any (h)
  (match h
    (IH pos label _ _ _ _ _
      (LSPObject
        (map-insert
          (map-insert (map-new) "position" (lsp-pos-to-any pos))
          "label" (LSPString label))))))

(defn lsp-syminfo-list-any (syms)
  (match syms
    (Nil Nil)
    (Cons s rest (Cons (lsp-syminfo-any s) (lsp-syminfo-list-any rest)))))

(defn lsp-syminfo-any (s)
  (match s
    (SymInfo name kind _ locOpt _ _
      (LSPObject
        (map-insert (map-insert (map-insert (map-new)
          "name" (LSPString name))
          "kind" (LSPInt (lsp-sk-int kind)))
          "location" (match locOpt (Some loc (lsp-location-any loc)) (None LSPNull)))))))
