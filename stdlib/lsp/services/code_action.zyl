; === Zyl LSP — Code Action + Inlay Hints + Format Service ===
; Module: lsp/services/code_action
;
; Code actions: quick-fixes built from the SAME data the diagnostic
; already carries (compiler_bridge.zyl's bridge-balance-diag stashes a
  ; "fixIt" string in the diagnostic's `data` field) -- one real quickfix
; per balance error, offering exactly the text sb-hint already computed.
; Non-balance diagnostics (caught compiler panics, see
  ; lsp/document_manager) have no fix-it text yet -- no fabricated
; suggestions for those.
;
; Inlay hints moved to lsp/services/inlay_hints.zyl (parameter-name
  ; hints via a dedicated recursive-descent text scan -- real TYPE hints
  ; still aren't possible; see that file's header for why).
;
; Format: a real, if simple, formatter -- reindents every line to
; (paren depth * 2) spaces, using the same character classification as
; lsp/source_index. Does not reflow/rewrap expressions across lines;
; a re-indent-only formatter is standard for Lisp-family tooling and is
; what this data (depth per line) can honestly support.

(use core/core)
(use core/list)
(use core/option)
(use core/map)
(use lsp/lsp_types)
; The formatter moved to text/format, where `zyl fmt` and a pre-commit hook
; reach it too; this service is one of its callers, not its owner.
(use text/format)
(use compiler/sexp_balance)

(defn code-actions-for (diagnostics)
  (ca-from-diags diagnostics))

(defn ca-from-diags (diags)
  (match diags
    (Nil Nil)
    (Cons d rest
      (match (ca-fixit-of d)
        (Some fixit (Cons (ca-quickfix-action d fixit) (ca-from-diags rest)))
        (None (ca-from-diags rest))))))

(defn ca-fixit-of (d)
  (match d
    (Diag _ _ _ _ _ _ _ _ dataOpt
      (match (lsp-some-obj dataOpt)
        (Some obj
          (match (lsp-some-str (map-get obj "fixIt"))
            (Some s (Some s))
            (_ None)))
        (_ None)))))

; WHAT A QUICKFIX NEEDS, AND WHY THERE ARE NONE YET.
;
; `fixIt` is the replacement text for the diagnostic's range, so a quickfix can
; only be offered where the compiler knows an actual edit: the text to put
; there. Everything mechanical -- rename a shadowed binding, underscore an
; unused parameter, insert a missing `use`, show a declared signature that does
; not match the call -- is known at the raise site and is none of it prose.
;
; The blocker is not the code actions, which are built and working. It is how
; diagnostics reach this server at all. Every checker in stdlib/compiler/
; reports by calling `zyl_panic` with a formatted message, so a diagnostic
; arrives here as TEXT (see compiler_bridge.zl's diagnostic-from-panic). The
; balance check is the exception: it returns a value, which is why it is the
; only path that can carry a field at all -- and why what it carries had to be
; corrected above.
;
; So the work is to give the checks that can have fixes a value-returning path,
; the way the balance check has one, with the edit as a field beside the range.
; Until then `ca-fixit-of` correctly finds nothing, and the editor offers no
; quickfix rather than a corrupting one.

(defn ca-range-of (d)
  (match d (Diag r _ _ _ _ _ _ _ _ r)))

(defn ca-quickfix-action (d fixit)
  (CA (str-concat "Fix: " fixit) (Some (CAK "quickfix")) (Some d) None None
    (Some (WE None (Some (Cons (WEE (TE (ca-range-of d) fixit)) Nil)) None))
    None None None))
