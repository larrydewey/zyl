; === Zyl LSP — Hover Service ===
; Module: lsp/services/hover
;
; Resolve the identifier under the cursor via lsp/source_index (a text
; scan -- the LSP does not use the compiler's own positions, see
; compiler_bridge.zyl's header), then look the NAME up: first among the
; document's own definitions, then among the language's built-in forms
; and operators (lsp/builtins). Hovering `shl`, `Secret` or `ffi-pin`
; now answers with the language's own documentation rather than nothing.
;
; The reported range is the identifier itself, so the client highlights
; exactly the word the answer is about.

(use core/core)
(use core/list)
(use core/option)
(use lsp/lsp_types)
(use lsp/source_index)
(use lsp/compiler_bridge)

(defn hover-at (text tbl line col)
  (let word (si-word-at text line col)
    (if (= (str-length word) 0)
      None
      (match (bridge-hover-for-name tbl word)
        (Some md (Some (Hov (MC MKMarkdown md) (Some (hover-word-range text line col word)))))
        (None None)))))

(defn hover-word-range (text line col word)
  (let offset (si-offset-of-pos text line col)
    (let start (si-word-scan-back text offset)
      (let startcol (- col (- offset start))
        (Rng (Pos line startcol) (Pos line (+ startcol (str-length word))))))))
