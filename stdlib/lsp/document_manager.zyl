; === Zyl LSP — Document Manager ===
; Module: lsp/document_manager
;
; Per-document analysis cache. See lsp/compiler_bridge's header comment
; for why this stops at macro expansion + the pre-inference checks + a
; flat SymTable pass, rather than running compiler/type_inference's
; collect-definitions.
;
; The checks that run here are the ones compiler/pipeline.zyl's
; compile-run-checks runs (the same front end selfhost/driver.zyl uses),
; in the same order, minus two: duplicate definitions, call arity,
; mutability rules, match exhaustiveness, and the Secret capability's
; constant-time obligations. Each reports failure by calling
; `zyl_panic`, which is `exit(1)` if uncaught -- fine for a one-shot CLI
; compile, fatal for a server that must keep running across many edits
; of not-yet-valid code. Everything past the balance check therefore
; runs inside `try`/`catch`; a panic becomes one Diagnostic instead of
; killing the process.
;
; Passes from the compiler's pipeline that are deliberately NOT run:
;
;   - capability_check (cc-check-program), the package capability rules
;     of spec v5.0 §31.9. It needs the grants and denials that
;     mr-resolve-program-full returns; dm-frontend calls the plain
;     mr-resolve-program, which returns only the resolved forms.
;   - type_inference's collect-definitions, for the reasons set out at
;     length in lsp/compiler_bridge.zyl's header.
;
; Because every check panics on its FIRST problem, a document reports
; one diagnostic at a time -- fix it, save, see the next. That matches
; the compiler's own behavior exactly, which is the point: the editor
; should never claim a program is fine that `zyl` would reject, nor the
; reverse. The passes left out above are the known exceptions: a
; capability violation, for one, shows up only when `zyl` compiles it.

(use allocator/allocator)
(use core/core)
(use core/list)
(use core/option)
(use core/result)
(use core/map)
(use lsp/lsp_types)
(use lsp/vfs)
(use compiler/ast)
(use compiler/lexer)
(use compiler/parser)
(use compiler/expr_inner)
(use compiler/module_resolver)
(use compiler/macro_expand)
(use compiler/mutability_check)
(use compiler/duplicate_check)
(use compiler/arity_check)
(use compiler/exhaustiveness_check)
(use compiler/secret_check)
(use compiler/unused_check)
(use compiler/sexp_balance)
(use lsp/compiler_bridge)

(deftype DocState
  (DS Document Int SymTable (List Diagnostic)))
  ; document, version analyzed at, symbol table, diagnostics

(defn DocState.doc (s) (match s (DS d _ _ _ d)))
(defn DocState.version (s) (match s (DS _ v _ _ v)))
(defn DocState.symtable (s) (match s (DS _ _ t _ t)))
(defn DocState.diagnostics (s) (match s (DS _ _ _ g g)))

(deftype DocManager
  (DM (Map String DocState)))

(defn dm-new () (DM (map-new)))

(defn dm-get (dm uri)
  (match dm (DM states (map-get states uri))))

(defn dm-get-text (dm uri)
  (match (dm-get dm uri)
    (Some st (Some (Document.text (DocState.doc st))))
    (None None)))

(defn dm-get-symtable (dm uri)
  (match (dm-get dm uri)
    (Some st (Some (DocState.symtable st)))
    (None None)))

(defn dm-get-diagnostics (dm uri)
  (match (dm-get dm uri)
    (Some st (DocState.diagnostics st))
    (None Nil)))

(defn dm-open-uris (dm)
  (match dm (DM states (dm-uri-list (map-entries states)))))

(defn dm-uri-list (entries)
  (match entries
    (Nil Nil)
    (Cons e rest (Cons (ME.key e) (dm-uri-list rest)))))

(defn dm-put (dm uri st)
  (match dm (DM states (DM (map-insert states uri st)))))

(defn dm-on-open (arena dm uri text version languageId)
  (let doc (Doc text version uri languageId)
    (dm-put dm uri (dm-analyze arena doc))))

(defn dm-on-change (arena dm uri edits new-version)
  (match (dm-get dm uri)
    (Some st
      (let old-doc (DocState.doc st)
        (let new-text (vfs-apply-edits (Document.text old-doc) edits)
          (let new-doc (Doc new-text new-version uri (Document.languageId old-doc))
            (dm-put dm uri (dm-analyze arena new-doc))))))
    (None dm)))

; Full-document replace (didChange with no range, or a didSave-triggered
; re-analysis of text already known to the client) -- skips vfs-apply-edits.
(defn dm-on-full-change (arena dm uri text new-version)
  (match (dm-get dm uri)
    (Some st
      (let old-doc (DocState.doc st)
        (let new-doc (Doc text new-version uri (Document.languageId old-doc))
          (dm-put dm uri (dm-analyze arena new-doc)))))
    (None dm)))

(defn dm-on-close (dm uri)
  (match dm (DM states (DM (map-remove states uri)))))

(defn dm-analyze (arena doc)
  (let text (Document.text doc)
    (let balance (sb-check-string text)
      (if (not (sb-result-balanced balance))
        (DS doc (Document.version doc) (st-new) (dm-balance-diags balance))
        (dm-analyze-parsed arena doc text)))))

(defn dm-balance-diags (balance)
  (match (diagnostic-from-balance balance)
    (Some d (Cons d Nil))
    (None Nil)))

(defn dm-analyze-parsed (arena doc text)
  (let front (try (Ok (dm-frontend arena (lsp-uri-path (Document.uri doc)) text)) (catch e (Err e)))
    (match front
      (Err msg (DS doc (Document.version doc) (st-new) (Cons (diagnostic-from-panic msg text) Nil)))
      (Ok exprs (dm-check-and-index doc text exprs)))))

; Parse, resolve modules, expand macros. Anything that fails here left
; no usable program behind, so there is nothing to index and the
; document reports one diagnostic and an empty symbol table.
; The resolver works on the raw parse tree and needs the document's path,
; which is how it finds the package this file belongs to (spec v5.0
; §31.3) and therefore what its definitions are named.
(defn dm-frontend (arena path text)
  (let prog (zyl-parse arena text)
    (me-expand-program (mr-resolve-program arena prog path))))

; Past the front end there IS a program, so the symbol table is built
; first and kept whatever the checks then say. A document that fails
; exhaustiveness still offers hover, completion and go-to-definition
; for every name it declares -- which is exactly when you want them.
(defn dm-check-and-index (doc text exprs)
  (let tbl (st-build exprs)
    (let warns (dm-unused-warnings exprs text)
      (let outcome (try (Ok (dm-run-checks exprs)) (catch e (Err e)))
        (match outcome
          (Ok _ (DS doc (Document.version doc) tbl warns))
          (Err msg (DS doc (Document.version doc) tbl (Cons (diagnostic-from-panic msg text) warns))))))))

; unused_check's warnings, captured instead of printed, as Warning diagnostics.
(defn dm-unused-warnings (exprs text)
  (let _ (ffi-call "zyl_warn_capture" 1 1000)
    (let _ (try (uc-check-program exprs) (catch _e 0))
      (let w (ffi-call "zyl_warn_take" 1000)
        (let _ (ffi-call "zyl_warn_capture" 0 1000)
          (diagnostics-from-warnings w text))))))

; The checks compiler/pipeline.zyl's compile-run-checks runs, in the same
; order. See this file's header for the ones it leaves out and why.
(defn dm-run-checks (exprs)
  (let _ (dc-check-program exprs)
    (let _ (ac-check-program exprs)
      (let _ (mc-check-program exprs)
        (let _ (ec-check-program exprs)
          (sc-check-program exprs))))))
