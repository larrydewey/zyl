; === Zyl LSP — REPL Integration ===
; Module: lsp/repl_integration
; Backs the server's one executeCommand, `zyl.evalDocument` (see
; lsp-req-execute-command in lsp/lsp_server.zyl).
;
; Evaluate a document's current text by shelling out to the real `zyl`
; CLI (same self-hosted compiler the LSP server itself runs on) via
; zyl_system_cmd (a real spawn+wait through `/bin/sh -c`, implemented
; with posix_spawn in runtime/actor_runtime.c -- NOT zyl_exec_cmd, which
; execl()s and replaces the calling process image entirely; that's fine
; for driver.zyl's own cli-link, its last action before exiting anyway,
; but would silently kill this long-running LSP server on the first
; eval request), then running the resulting binary and capturing its
; output. This path compiles and runs the buffer as a real program; it
; does not use the REPL's in-process ICNF interpreter (repl/interp.zyl,
; behind `zyl repl`). A single fixed temp path is fine: the LSP server
; processes one JSON-RPC request at a time (see lsp/lsp_server's read
; loop), so there is never a concurrent second eval to collide with.

(use core/core)
(use core/list)
(use core/option)
(use allocator/allocator)

(deftype EvalResult
  (EvalOk String)   ; captured stdout+stderr
  (EvalFail String)) ; captured stdout+stderr from a failed compile/run

(defn repl-eval-text (text)
  (let src-path "/tmp/zyl_lsp_eval.zyl"
    (let bin-path "/tmp/zyl_lsp_eval.bin"
      (let out-path "/tmp/zyl_lsp_eval.out"
        (let fh (file-open src-path "w")
          (let _ (file-write fh text)
            (let _ (file-close fh)
              (let compile-cmd (str-concat "zyl " (str-concat src-path (str-concat " -o " (str-concat bin-path (str-concat " > " (str-concat out-path " 2>&1"))))))
                (let compile-status (ffi-call "zyl_system_cmd" compile-cmd 1000)
                  (if (!= compile-status 0)
                    (EvalFail (repl-slurp out-path))
                    (repl-run-and-capture bin-path out-path)))))))))))

(defn repl-run-and-capture (bin-path out-path)
  (let run-cmd (str-concat bin-path (str-concat " > " (str-concat out-path " 2>&1")))
    (let status (ffi-call "zyl_system_cmd" run-cmd 1000)
      (let output (repl-slurp out-path)
        (if (= status 0) (EvalOk output) (EvalFail output))))))

(defn repl-slurp (path)
  (let fd (file-open path "r")
    (if (<= fd 0)
      ""
      (let output (file-read fd 1048576)
        (let _ (file-close fd)
          output)))))
