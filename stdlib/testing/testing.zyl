; ===========================================================================
; PROPERTY TESTING HELPERS
; ===========================================================================

; Generate int property test
; Returns: Unit
(defn property-int (name gen-fn property-fn)
  (test-property name gen-int property-fn))

; Generate bool property test
; Returns: Unit
(defn property-bool (name gen-fn property-fn)
  (test-property name gen-bool property-fn))

; Generate string property test
; Returns: Unit
(defn property-string (name gen-fn property-fn)
  (test-property name gen-string property-fn))

; Generate float property test
; Returns: Unit
(defn property-float (name gen-fn property-fn)
  (test-property name gen-float property-fn))
