; === Zyl Standard Library — Testing Framework ===
; Module: testing/testing
; Provides: assertions as functions, for passing where a function value is
; wanted. Everything else in spec 20.5 is built in and needs no import:
; test, test-suite with setup and teardown, test-property with gen-int,
; gen-bool, gen-string and gen-float, test-compile, run-tests, and the
; assert-equal, assert-true, assert-false and assert-fail forms.

; Returns: Unit
(defn assert-equal-values (expected actual)
  (assert-equal expected actual))

; Returns: Unit
(defn assert-true-value (value)
  (assert-true value))

; Returns: Unit
(defn assert-false-value (value)
  (assert-false value))

; Fails unless calling `thunk` raises an error.
; Returns: Unit
(defn assert-fail-call (thunk)
  (assert-fail (thunk)))
