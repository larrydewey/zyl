; === Zyl Standard Library — Testing Framework ===
; Module: testing
; Provides: Test helpers and utilities

; ===========================================================================
; TEST HELPERS
; ===========================================================================

; Run a single test
; Returns: Unit
(defn test-run (test-name test-body)
  (test test-name test-body))

; Run a test suite
; Returns: Unit
(defn test-suite-run (suite-name tests)
  (test-suite suite-name tests))

; ===========================================================================
; ASSERTION HELPERS
; ===========================================================================

; Assert equal values
; Returns: Unit
(defn assert-equal-values (expected actual)
  (assert-equal expected actual))

; Assert true value
; Returns: Unit
(defn assert-true-value (value)
  (assert-true value))

; Assert false value
; Returns: Unit
(defn assert-false-value (value)
  (assert-false value))

; Assert fail expression
; Returns: Unit
(defn assert-fail-expr (expr)
  (assert-fail expr))

