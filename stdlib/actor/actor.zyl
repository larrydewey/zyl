; === Zyl Standard Library — Actor Operations ===
; Module: actor
; Provides: spawn, send, and actor lifecycle operations backed by the C runtime.

; ===========================================================================
; SPAWN
; ===========================================================================

; Spawn a new actor with the given closure
; Returns: ActorRef (Int)
(defn actor-spawn (closure)
  (spawn closure))

; ===========================================================================
; SEND
; ===========================================================================

; Send a message to an actor
; Returns: Unit
(defn actor-send (actor message)
  (send actor message))

; Send a message with timeout, wrapped in a Result.
; Returns: Result<Unit, Int>
(defn actor-send-with-timeout (actor message timeout)
  (try
    (Ok (send actor message))
    (catch e
      (Err e))))

; ===========================================================================
; ACTOR LIFECYCLE
; ===========================================================================

; Check if an actor is alive (has not been terminated).
; Returns: Bool
(defn actor-is-alive (actor)
  (if (== (ffi-call "zyl_actor_is_alive" actor 1000) 1) true false))

; Wait for an actor to finish its thread (blocks until it exits).
; Returns: Unit
(defn actor-wait (actor)
  (ffi-call "zyl_actor_wait" actor 1000))

; Terminate an actor: stop its message loop and join its thread.
; Returns: Unit
(defn actor-terminate (actor)
  (ffi-call "zyl_actor_terminate" actor 1000))
