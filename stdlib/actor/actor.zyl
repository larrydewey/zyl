; === Zyl Standard Library — Actor Operations ===
; Module: actor/actor
; Provides: spawn and join. Actors communicate only through channels
; (chan, chan-tx, chan-rx, chan-send, chan-recv); see
; docs/concurrency-determinism-design.md.

; Spawn a new actor running the closure.
; Returns: Actor
(defn actor-spawn (closure)
  (spawn closure))

; True until this program joins the actor (deterministic, never a race).
; Returns: Bool
(defn actor-is-alive (actor)
  (ffi-call "zyl_actor_is_alive" actor 1000))

; Wait for the actor to finish; its output is emitted here and its panic re-raised here.
; Returns: Unit
(defn actor-wait (actor)
  (ffi-call "zyl_actor_wait" actor 1000))
