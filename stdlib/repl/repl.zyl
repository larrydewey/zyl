; === Zyl Standard Library — REPL ===
; Module: repl/repl
;
; The session: prompt, read, evaluate, print, repeat, plus the meta
; commands that make a REPL a place to work rather than a calculator.
;
; Two modes. On a terminal the full editor runs (repl/reader): arrows,
; history, completion, highlighting, multi-line entries. On a pipe --
; a test harness, `echo ... | zyl repl`, a script -- there is nothing to
; put in raw mode and no cursor to move, so entries are read as plain
; lines and nothing is echoed. Both modes evaluate through exactly the
; same path, which is what keeps the scripted case honest.

(use allocator/allocator)
(use core/core)
(use core/list)
(use core/option)
(use compiler/sexp_balance)
(use lsp/builtins)
(use repl/terminal)
(use repl/line_editor)
(use repl/reader)
(use repl/history)
(use repl/highlight)
(use repl/eval)
(use repl/interp)

(defn repl-version () "0.1")

; ===========================================================================
; ENTRY POINT
; ===========================================================================

; Run a session to completion. Returns 0.
;
; The arena made here belongs to the editor: cursor motions, the digits
; in an escape sequence, the odd scratch string, all of it per
; keystroke. It is reset at every prompt, so a session that runs for a
; day costs the same as one that runs for a minute. Evaluation does not
; use it -- each entry compiles into an arena of its own (repl/eval).
(defn repl-run (arena)
  (repl-run-in arena (ffi-call "zyl_getcwd" 1000)))

; `dir` is the directory the user started in, which is not the working
; directory by the time this runs: the REPL compiles code, so it has
; already moved to the bundle (stdlib/ and actor_runtime.c live there).
; The saved session belongs to the user's directory, not the compiler's.
;
; A terminal session picks up where the last one in that directory left
; off. A piped one does not: a script should do the same thing on every
; machine, whatever happens to be saved next to it.
(defn repl-run-in (_arena dir)
  (let arena (arena-create 1048576)
    (if (= (term-is-tty 0) 1)
      (repl-interactive arena (repl-start-session dir))
      (repl-scripted (session-new dir)))))

; A session starts from three places, in this order: the modules every
; session begins with, the startup file (~/.zyl/replrc), and whatever
; the last session in this directory left behind. Each is replayed
; entry by entry through the ordinary path, so nothing in a saved
; session can do what a typed entry could not.
(defn repl-start-session (dir)
  (match (session-load-rc (session-new dir))
    (Restored sess1 nrc
      (match (session-restore sess1)
        (Restored sess2 n
          (begin
            (repl-announce-restore nrc n)
            sess2))))))

(defn repl-announce-restore (nrc n)
  (begin
    (if (> nrc 0) (repl-note (str-concat "replrc: " (str-concat (repl-int nrc) " entries"))) 0)
    (if (> n 0)
      (repl-note (str-concat "restored " (str-concat (repl-int n)
                    " entries from .zyl-session — :reset to start clean")))
      0)))

(defn repl-int (n)
  (ffi-call "zyl_int_text" n 1000))

(defn repl-interactive (arena sess)
  (let entries (hist-load)
    (begin
      (repl-banner)
      (term-write (ansi-paste-on))
      (let code (repl-loop arena (es-new entries) sess)
        (begin
          (term-write (ansi-paste-off))
          (term-raw-off)
          code)))))

(defn repl-banner ()
  (begin
    (print (str-concat "Zyl REPL " (str-concat (repl-version) " — :help for commands, :q to quit")))
    (term-flush)
    0))

(defn repl-prompt () "\e[38;5;75mzyl>\e[0m ")
(defn repl-cprompt () "\e[38;5;244m····\e[0m ")

; ===========================================================================
; THE LOOP
; ===========================================================================

; Raw mode is entered for the edit and left for the evaluation: while an
; entry is being evaluated the terminal must behave normally, so that a
; program that reads stdin, or one the user interrupts with Ctrl-C,
; works the way it would outside the REPL.
(defn repl-loop (arena st sess)
  (begin
    (arena-reset arena)
    (term-raw-on)
    (let res (reader-read-line arena st (repl-prompt) (repl-cprompt)
                               (repl-candidates sess))
      (begin
        (term-raw-off)
        (repl-after-read arena res sess)))))

(defn repl-after-read (arena res sess)
  (match res
    (LineEof _ (repl-goodbye))
    (LineCancel st (repl-loop arena st sess))
    (LineOk text st (repl-handle arena st sess text))))

(defn repl-goodbye ()
  (begin
    (print "Goodbye!")
    0))

; A submitted entry: remember it, then either run a meta command or
; evaluate it.
(defn repl-handle (arena st sess text)
  (let trimmed (rd-trim text)
    (if (= (str-length trimmed) 0)
      (repl-loop arena st sess)
      (let st2 (repl-remember st trimmed)
        (if (= (repl-meta-p trimmed) 1)
          (repl-meta-interactive arena st2 sess trimmed)
          (repl-eval arena st2 sess trimmed))))))

(defn repl-meta-interactive (arena st sess text)
  (match (repl-meta-apply sess (Hist.entries (ES.hist st)) text)
    (MetaQuit (repl-goodbye))
    (MetaDone sess2 (repl-loop arena st (repl-persist sess2)))))

(defn repl-remember (st entry)
  (begin
    (hist-append entry)
    (ES.with-hist st (Hist (hist-push (Hist.entries (ES.hist st)) entry) -1 ""))))

(defn repl-eval (arena st sess text)
  (let outcome (eval-entry sess text)
    (begin
      (repl-report (EvalOutcome.result outcome))
      (repl-loop arena st (repl-persist (EvalOutcome.session outcome))))))

; The session writes itself out after every entry rather than at exit:
; a session that is killed, or that ends with the machine, should still
; be there tomorrow. The file is small and the write is one syscall.
(defn repl-persist (sess)
  (begin
    (session-save sess)
    sess))

(defn repl-report (result)
  (match result
    (EvalValue text (repl-value text))
    (EvalUnit 0)
    (EvalDefined name (repl-note (str-concat "defined " name)))
    (EvalBound name text (repl-note (str-concat name (str-concat " = " text))))
    (EvalNote text (repl-note text))
    (EvalFailed msg (repl-error msg))))

; The result line. A value the entry produced is the answer to what was
; typed, so it gets its own marker rather than looking like output the
; program printed.
(defn repl-value (text)
  (begin
    (term-write "\e[38;5;71m=>\e[0m ")
    (term-write text)
    (term-write "\n")
    0))

(defn repl-note (text)
  (begin
    (term-write (str-concat "\e[38;5;244m" (str-concat text "\e[0m\n")))
    0))

; Diagnostics arrive already formatted by the compiler's own reporter --
; `error[CODE]`, the source line, a caret and a help line -- so the REPL
; prints them as they are rather than paraphrasing.
; Written with term-write, not print: codegen picks print's format from
; a static kind analysis, and a bare String PARAMETER is indistinguishable
; from an Int there (see kind-of in codegen.zyl), so `(print msg)` prints
; the pointer. term-write takes the pointer and writes the bytes.
(defn repl-error (msg)
  (begin
    (term-write msg)
    (term-write "\n")
    0))

; ===========================================================================
; META COMMANDS
; ===========================================================================

(defn repl-meta-p (text)
  (if (= (str-length text) 0) 0 (if (= (term-byte-at text 0) 58) 1 0)))

; What a meta command leaves behind: the session it produced, or the
; decision to end the run. Both loops -- the editor's and the scripted
; one -- go through this, so `:defs` means the same thing typed at a
; prompt and piped in from a file.
(deftype MetaResult
  (MetaDone Session)
  (MetaQuit))

(defn repl-meta-apply (sess entries text)
  (let cmd (repl-meta-word text)
    (let rest (rd-trim (str-substring text (+ 1 (str-length cmd))
                                      (- (str-length text) (+ 1 (str-length cmd)))))
      (repl-meta-run sess entries cmd rest))))

; The command word after the leading colon.
(defn repl-meta-word (text)
  (str-substring text 1 (- (repl-meta-end text 1) 1)))

(defn repl-meta-end (text i)
  (let n (str-length text)
    (if (>= i n)
      n
      (if (= (term-byte-at text i) 32) i (repl-meta-end text (+ i 1))))))

(defn repl-meta-run (sess entries cmd rest)
  (if (= (repl-cmd-p cmd "q" "quit") 1) (MetaQuit)
  (if (= (repl-cmd-p cmd "h" "help") 1) (repl-kept sess (repl-help))
  (if (= (repl-cmd-p cmd "history" "hist") 1) (repl-kept sess (repl-show-history entries))
  (if (= (repl-cmd-p cmd "clear" "cls") 1) (repl-kept sess (term-write (ansi-clear-screen)))
  (if (= (repl-cmd-p cmd "reset" "r") 1) (repl-do-reset sess)
  (if (= (repl-cmd-p cmd "load" "l") 1) (repl-do-load sess rest)
  (if (= (repl-cmd-p cmd "save" "s") 1) (repl-kept sess (repl-do-save sess rest))
  (if (= (repl-cmd-p cmd "doc" "d") 1) (repl-kept sess (repl-do-doc rest))
  (if (= (repl-cmd-p cmd "t" "type") 1) (repl-kept sess (repl-do-type sess rest))
  (if (= (repl-cmd-p cmd "time" "tm") 1) (repl-do-time sess rest)
  (if (= (repl-cmd-p cmd "defs" "browse") 1) (repl-kept sess (repl-show-defs sess))
  (repl-kept sess (repl-unknown cmd))))))))))))))

(defn repl-cmd-p (cmd short long)
  (if (str-eq cmd short) 1 (if (str-eq cmd long) 1 0)))

; The command already printed whatever it had to say; this is only the
; session it leaves behind.
(defn repl-kept (sess _printed)
  (MetaDone sess))

(defn repl-unknown (cmd)
  (repl-note (str-concat "unknown command :" (str-concat cmd " — :help lists them"))))

(defn repl-help ()
  (begin
    (print "Commands")
    (print "  :help              this list")
    (print "  :quit              leave the session")
    (print "  :history           entries from this and earlier sessions")
    (print "  :defs              definitions in scope")
    (print "  :doc NAME          documentation for a built-in or special form")
    (print "  :type EXPR         the type of an expression, without running it")
    (print "  :time EXPR         evaluate it and say how long it took")
    (print "  :load PATH         read a file's definitions into the session")
    (print "  :save PATH         write the session's definitions to a file")
    (print "  :reset             forget every definition")
    (print "  :clear             clear the screen")
    (print "Editing")
    (print "  Enter              evaluate, or continue an unfinished form")
    (print "  Up/Down            move within an entry, then through history")
    (print "  Tab                complete a name")
    (print "  Ctrl-R             search history")
    (print "  Ctrl-A/E  Ctrl-K/U/W  Ctrl-Y   line editing and yank")
    (print "  Ctrl-C             abandon this entry    Ctrl-D  leave")
    0))

(defn repl-show-history (entries)
  (begin
    (repl-print-history (list-reverse entries) 1)
    0))

(defn repl-print-history (entries i)
  (match entries
    (Nil 0)
    (Cons h t
      (begin
        (term-write (str-concat "  " (str-concat h "\n")))
        (repl-print-history t (+ i 1))))))

(defn repl-show-defs (sess)
  (begin
    (repl-show-uses (Session.uses sess))
    (repl-show-globals (Session.globals sess))
    (repl-show-defn-text (Session.defs sess))))

(defn repl-show-uses (uses)
  (match uses
    (Nil 0)
    (Cons u rest
      (begin
        (term-write (str-concat "  (use " (str-concat u ")\n")))
        (repl-show-uses rest)))))

(defn repl-show-globals (gs)
  (match gs
    (Nil 0)
    (Cons b rest
      (match b
        (Bind n v
          (begin
            (term-write (str-concat "  " (str-concat n (str-concat " = "
              (str-concat (in-val-text v) "\n")))))
            (repl-show-globals rest)))))))

(defn repl-show-defn-text (defs)
  (if (= (str-length (rd-trim defs)) 0)
    0
    (begin
      (term-write (hl-colorize defs))
      (term-write "\n")
      0)))

; :reset forgets the session and the file it was saved to, so that the
; next session in this directory starts clean too.
(defn repl-do-reset (sess)
  (let fresh (session-reset sess)
    (begin
      (session-save fresh)
      (repl-kept fresh (repl-note "session reset")))))

; A path the user typed resolves against the directory they started in,
; not against the working directory: the REPL moved to the bundle before
; the first prompt, because compiling needs stdlib/ and actor_runtime.c
; to be there. `:load lib.zyl` means the lib.zyl next to them.
(defn repl-path (sess path)
  (if (= (str-length path) 0)
    path
    (if (= (term-byte-at path 0) 47)
      path
      (str-concat (Session.dir sess) (str-concat "/" path)))))

; :load reads a file and adds its modules and definitions to the
; session, so a project's code can be brought in and poked at.
(defn repl-do-load (sess raw)
  (let path (repl-path sess raw)
    (repl-load-file sess path)))

(defn repl-load-file (sess path)
  (let fd (file-open path "r")
    (if (<= fd 0)
      (repl-kept sess (repl-note (str-concat "cannot read " path)))
      (let text (file-read fd 4194304)
        (begin
          (file-close fd)
          (repl-load-text sess path text))))))

; The file's modules go in first, then its definitions as one block.
(defn repl-load-text (sess path text)
  (match (repl-load-uses sess (repl-file-uses text))
    (Err msg (repl-kept sess (repl-error msg)))
    (Ok sess2 (repl-load-defs sess2 path (repl-strip-uses text)))))

(defn repl-load-uses (sess modules)
  (match modules
    (Nil (Ok sess))
    (Cons m rest
      (let outcome (eval-entry sess (str-concat "(use " (str-concat m ")")))
        (match (EvalOutcome.result outcome)
          (EvalFailed msg (Err msg))
          (_ (repl-load-uses (EvalOutcome.session outcome) rest)))))))

(defn repl-load-defs (sess path text)
  (if (= (str-length (rd-trim text)) 0)
    (repl-loaded sess path)
    (let outcome (eval-entry sess text)
      (match (EvalOutcome.result outcome)
        (EvalFailed msg (repl-kept sess (repl-error msg)))
        (_ (repl-loaded (EvalOutcome.session outcome) path))))))

(defn repl-loaded (sess path)
  (repl-kept sess (repl-note (str-concat "loaded " path))))

; A loaded file's `(use ...)` lines join the session's module set rather
; than staying in the text: the session is assembled as one program, and
; a use line repeated inside it would resolve the same module twice.
(defn repl-strip-uses (text)
  (repl-strip-scan text 0 (str-length text) ""))

(defn repl-strip-scan (text i n acc)
  (if (>= i n)
    acc
    (let e (repl-line-end text i n)
      (let line (str-substring text i (- e i))
        (repl-strip-scan text (+ e 1) n
          (if (= (rd-starts-with (rd-trim line) "(use ") 1)
            acc
            (str-concat acc (str-concat line "\n"))))))))

; The modules a loaded file asks for, in the order it asks for them.
(defn repl-file-uses (text)
  (repl-uses-scan text 0 (str-length text) Nil))

(defn repl-uses-scan (text i n acc)
  (if (>= i n)
    (list-reverse acc)
    (let e (repl-line-end text i n)
      (let line (rd-trim (str-substring text i (- e i)))
        (repl-uses-scan text (+ e 1) n
          (if (= (rd-starts-with line "(use ") 1)
            (Cons (repl-use-module line) acc)
            acc))))))

(defn repl-use-module (line)
  (let start 5
    (str-substring line start (- (repl-use-end line start) start))))

(defn repl-use-end (line i)
  (let n (str-length line)
    (if (>= i n)
      n
      (if (= (term-byte-at line i) 41) i (repl-use-end line (+ i 1))))))

(defn repl-line-end (text i n)
  (if (>= i n)
    n
    (if (= (term-byte-at text i) 10) i (repl-line-end text (+ i 1) n))))

(defn repl-do-save (sess raw)
  (if (= (str-length raw) 0)
    (repl-note ":save needs a path")
    (repl-save-file sess (repl-path sess raw))))

(defn repl-save-file (sess path)
  (let fd (file-open path "w")
    (if (<= fd 0)
      (repl-note (str-concat "cannot write " path))
      (begin
        (file-write fd (Session.defs sess))
        (file-close fd)
        (repl-note (str-concat "saved to " path))))))

; :doc answers from the same table the editor's hover uses, so the two
; never disagree.
; :time runs an expression and reports how long it took. The clock is
; monotonic and read either side of the entry, so what it measures is
; the whole entry -- compiling it included, since at the prompt that is
; part of what you waited for.
(defn repl-do-time (sess text)
  (if (= (str-length text) 0)
    (repl-kept sess (repl-note ":time needs an expression"))
    (let start (ffi-call "zyl_now_ms" 1000)
      (let outcome (eval-entry sess text)
        (let elapsed (- (ffi-call "zyl_now_ms" 1000) start)
          (begin
            (repl-report (EvalOutcome.result outcome))
            (repl-note (str-concat (repl-int elapsed) " ms"))
            (MetaDone (EvalOutcome.session outcome))))))))

; :type says what an expression's type is without evaluating it.
(defn repl-do-type (sess text)
  (if (= (str-length text) 0)
    (repl-note ":type needs an expression")
    (match (eval-type-of sess text)
      (Err msg (repl-error msg))
      (Ok t (repl-typed text t)))))

(defn repl-typed (text t)
  (begin
    (term-write (hl-colorize text))
    (term-write (str-concat "\e[38;5;244m : \e[0m" (str-concat t "\n")))
    0))

(defn repl-do-doc (name)
  (if (= (str-length name) 0)
    (repl-note ":doc needs a name")
    (repl-doc-find (builtins-all) name)))

(defn repl-doc-find (bs name)
  (match bs
    (Nil (repl-note (str-concat "no documentation for " name)))
    (Cons b rest
      (if (str-eq (ZB.name b) name)
        (repl-doc-print b)
        (repl-doc-find rest name)))))

; term-write, not print: codegen picks print's format from a static kind
; analysis with no return-type inference, so `(print (f x))` for a
; String-returning f prints the pointer (see kind-of in codegen.zyl).
(defn repl-doc-print (b)
  (begin
    (term-write (hl-colorize (ZB.sig b)))
    (term-write "\n")
    (term-write (str-concat "  " (str-concat (ZB.doc b) "\n")))
    0))

; ===========================================================================
; COMPLETION CANDIDATES
; ===========================================================================

; Everything Tab should offer: the meta commands, the language's own
; names (the table lsp/builtins keeps in step with expr_inner.zyl), and
; every name the session has defined.
(defn repl-candidates (sess)
  (list-append (repl-meta-names)
    (list-append (repl-builtin-names (builtins-all))
      (list-append (repl-global-names (Session.globals sess))
                   (repl-session-names (Session.defs sess))))))

(defn repl-global-names (gs)
  (match gs
    (Nil Nil)
    (Cons b rest (match b (Bind n _ (Cons n (repl-global-names rest)))))))

(defn repl-meta-names ()
  (Cons ":help" (Cons ":quit" (Cons ":history" (Cons ":defs" (Cons ":doc"
    (Cons ":load" (Cons ":save" (Cons ":reset" (Cons ":clear" Nil)))))))))) 

(defn repl-builtin-names (bs)
  (match bs
    (Nil Nil)
    (Cons b rest (Cons (ZB.name b) (repl-builtin-names rest)))))

; Scan the session's definition text for the names it introduces. A
; lexical scan, not a parse: it runs on every keystroke-driven
; completion and must stay cheap, and a name that is half-typed is still
; a name worth offering.
(defn repl-session-names (defs)
  (repl-names-scan defs 0 (str-length defs) Nil))

(defn repl-names-scan (text i n acc)
  (if (>= i n)
    (list-reverse acc)
    (if (= (repl-defn-start text i n) 1)
      (let ns (eval-skip-space text (repl-skip-word text (eval-skip-space text (+ i 1) n) n) n)
        (let e (repl-name-end text ns n)
          (repl-names-scan text e n (Cons (str-substring text ns (- e ns)) acc))))
      (repl-names-scan text (+ i 1) n acc))))

; True at a '(' that opens a definition form.
(defn repl-defn-start (text i n)
  (if (= (term-byte-at text i) 40)
    (let s (eval-skip-space text (+ i 1) n)
      (repl-def-word (str-substring text s (- (repl-skip-word text s n) s))))
    0))

(defn repl-def-word (w)
  (if (str-eq w "defn") 1
  (if (str-eq w "def") 1
  (if (str-eq w "deftype") 1
  (if (str-eq w "defstruct") 1
  (if (str-eq w "defmacro") 1
  0))))))

(defn repl-skip-word (text i n)
  (if (>= i n)
    n
    (let b (term-byte-at text i)
      (if (= (eval-space-p b) 1) i
      (if (= b 40) i
      (if (= b 41) i
      (repl-skip-word text (+ i 1) n)))))))

(defn repl-name-end (text i n)
  (repl-skip-word text i n))

; ===========================================================================
; SCRIPTED MODE
; ===========================================================================

; Input that is not a terminal: read entries as whole lines, evaluate
; each, print nothing but what the entries themselves produce. Multi-
; line forms still work -- lines accumulate until the form is complete.
(defn repl-scripted (sess)
  (repl-script-loop sess "" ""))

(defn repl-script-loop (sess pending acc)
  (match (repl-script-line pending)
    (SNone (repl-script-finish sess acc))
    (SLine line rest (repl-script-entry sess line rest acc))))

(deftype ScriptLine
  (SLine String String)
  (SNone))

; One line out of the pending buffer, reading more input when the buffer
; holds no complete line yet. A single read from a pipe routinely
; returns many lines at once, so the leftovers are carried forward.
(defn repl-script-line (pending)
  (let nl (repl-find-nl pending 0 (str-length pending))
    (if (>= nl 0)
      (SLine (str-substring pending 0 nl)
             (str-substring pending (+ nl 1) (- (str-length pending) (+ nl 1))))
      (let chunk (file-read 0 65536)
        (if (> (str-length chunk) 0)
          (repl-script-line (str-concat pending chunk))
          (if (> (str-length (rd-trim pending)) 0)
            (SLine pending "")
            (SNone)))))))

(defn repl-find-nl (s i n)
  (if (>= i n)
    -1
    (if (= (term-byte-at s i) 10) i (repl-find-nl s (+ i 1) n))))

(defn repl-script-entry (sess line rest acc)
  (let text (if (= (str-length acc) 0) line (str-concat acc (str-concat "\n" line)))
    (if (= (rd-complete-p text) 1)
      (repl-script-eval sess text rest)
      (repl-script-loop sess rest text))))

(defn repl-script-eval (sess text rest)
  (let trimmed (rd-trim text)
    (if (= (str-length trimmed) 0)
      (repl-script-loop sess rest "")
      (if (= (repl-meta-p trimmed) 1)
        (repl-script-meta sess trimmed rest)
        (let outcome (eval-entry sess trimmed)
          (begin
            (repl-report (EvalOutcome.result outcome))
            (repl-script-loop (EvalOutcome.session outcome) rest "")))))))

; A script gets the same meta commands a prompt does; there is simply no
; history behind it to show.
(defn repl-script-meta (sess text rest)
  (match (repl-meta-apply sess Nil text)
    (MetaQuit 0)
    (MetaDone sess2 (repl-script-loop sess2 rest "")))) 

(defn repl-script-finish (sess acc)
  (if (= (str-length (rd-trim acc)) 0)
    0
    (let outcome (eval-entry sess (rd-trim acc))
      (begin
        (repl-report (EvalOutcome.result outcome))
        0))))

; ===========================================================================
; BOOTSTRAP
; ===========================================================================

; The REPL compiles code, which means it needs the bundle directory --
; stdlib/ for module resolution and actor_runtime.c for linking -- on
; whatever machine it runs on. Prefer a real installed ~/.zyl (or
; $ZYL_HOME) and fall back to the directory the binary itself sits in,
; the same resolution order the compiler driver uses.
(defn repl-zyl-home-candidate ()
  (let zh (ffi-call "zyl_getenv" "ZYL_HOME" 1000)
    (if (> zh 0)
      zh
      (let home (ffi-call "zyl_getenv" "HOME" 1000)
        (if (> home 0) (str-concat home "/.zyl") "")))))

(defn repl-resolve-bundledir (argv0dir)
  (let candidate (repl-zyl-home-candidate)
    (if (> (str-length candidate) 0)
      (if (> (ffi-call "zyl_path_exists" (str-concat candidate "/stdlib") 1000) 0)
        candidate
        argv0dir)
      argv0dir)))

; Everything a session needs, from any entry point: `zyl repl`, the
; standalone binary, or a test harness.
(defn repl-main (arena)
  (let dir (ffi-call "zyl_getcwd" 1000)
    (let home (str-concat dir "")
      (begin
        (let argv0 (ffi-call "zyl_arg_str" 0 1000)
          (ffi-call "zyl_chdir"
                    (repl-resolve-bundledir (ffi-call "zyl_dirname_cstr" argv0 1000))
                    1000))
        (repl-run-in arena home)))))
