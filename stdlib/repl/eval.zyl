; === Zyl Standard Library — REPL evaluation ===
; Module: repl/eval
;
; An entry becomes a value in three steps: build a program around it,
; run the real compiler's phases over that program (compiler/pipeline,
; stopping at ICNF), and evaluate the lowered result in this process
; (repl/interp). No `cc`, no child process, no assembly.
;
; The session is what survives between entries:
;
;   uses     — the modules in scope, extended by entering `(use ...)`
;   defs     — the text of every definition entered so far
;   globals  — the values bound by `(def name expr)`, as live values
;
; Definitions are carried as text and re-lowered with each entry, which
; costs milliseconds and keeps type inference whole-program, exactly as
; it is for a file. Values are carried as values: nothing that was run
; is ever run again, so a `(def out (file-open ...))` opens one file,
; not one per later entry.
;
; A global reaches the entry as a parameter of the function the entry is
; wrapped in, and only when the entry's text mentions it. That is what
; makes `x` in `(+ x 1)` resolve to a binding from three entries ago
; without top-level mutable state in the generated program, and why an
; unused global costs nothing and raises no unused-parameter warning.

(use allocator/allocator)
(use core/core)
(use core/list)
(use core/option)
(use core/result)
(use compiler/pipeline)
(use compiler/icnf)
(use compiler/expr_inner)
(use compiler/type_annotate)
(use compiler/derive)
(use compiler/type_system)
(use repl/terminal)
(use repl/history)
(use repl/interp)

; What an entry did.
(deftype EvalResult
  (EvalValue String)     ; the value's text, for the result line
  (EvalUnit)             ; ran, with nothing worth showing
  (EvalDefined String)   ; a definition, now in scope
  (EvalBound String String) ; a `def`: name, and the value's text
  (EvalNote String)      ; something happened worth one line
  (EvalFailed String))   ; diagnostics, ready to print

; `lifted` holds the lambda bodies of earlier entries. A closure value
; stored in a global names the function it was lifted to
; (`_lambda_<id>`), and that function only exists in the table of the
; entry that created it: every entry re-lowers the session's text, and a
; lambda is given a fresh name each time. Keeping the lifted bodies is
; what lets a closure made three entries ago still be callable now. The
; names cannot collide -- ic-fresh-id is a process-lifetime counter, so
; it never repeats while the session lives.
;
; A binding the session keeps carries its name, its value, and the text
; that produced it. The text is what makes the binding restorable in a
; later session: a value cannot be written to a file, but the expression
; that built it can.
(deftype Global (Global String Val String))

(defn Global.name (g) (match g (Global n _ _ n)))
(defn Global.value (g) (match g (Global _ v _ v)))
(defn Global.source (g) (match g (Global _ _ s s)))

(deftype Session (Session (List String) String (List Global) (List Icnf) Int String))

(defn Session.uses (s) (match s (Session u _ _ _ _ _ u)))
(defn Session.defs (s) (match s (Session _ d _ _ _ _ d)))
(defn Session.globals (s) (match s (Session _ _ g _ _ _ g)))
(defn Session.lifted (s) (match s (Session _ _ _ l _ _ l)))
(defn Session.count (s) (match s (Session _ _ _ _ n _ n)))

; The directory the session was started in: where its saved state
; lives, which is what makes that state per project rather than global.
(defn Session.dir (s) (match s (Session _ _ _ _ _ d d)))

; The modules a session starts with. Deliberately small and additive:
; `(use collections/vec)` at the prompt extends it, and a module that
; collides with another is then the user's choice rather than a default
; they never asked for.
(defn session-default-uses ()
  (Cons "core/core"
    (Cons "core/list"
      (Cons "core/option"
        (Cons "core/result"
          (Cons "allocator/allocator" Nil))))))

(defn session-new (dir)
  (Session (session-default-uses) "" Nil Nil 0 dir))

(defn session-reset (s)
  (Session (session-default-uses) "" Nil Nil (Session.count s) (Session.dir s)))

(defn session-with-defs (s text)
  (Session (Session.uses s) (str-concat (Session.defs s) (str-concat "\n" text))
           (Session.globals s) (Session.lifted s) (+ (Session.count s) 1)
           (Session.dir s)))

(defn session-with-use (s module)
  (Session (list-append (Session.uses s) (Cons module Nil)) (Session.defs s)
           (Session.globals s) (Session.lifted s) (+ (Session.count s) 1)
           (Session.dir s)))

; Newest last: a session's bindings are replayed in the order they were
; made, and one may well be built from another.
(defn session-with-global (s name v src)
  (Session (Session.uses s) (Session.defs s)
           (list-append (session-drop-global (Session.globals s) name)
                        (Cons (Global name v src) Nil))
           (Session.lifted s) (+ (Session.count s) 1) (Session.dir s)))

(defn session-with-lifted (s fns)
  (Session (Session.uses s) (Session.defs s) (Session.globals s)
           (list-append (eval-lifted-of fns) (Session.lifted s))
           (Session.count s) (Session.dir s)))

(defn is-nil-list (xs) (match xs (Nil 1) (Cons _ _ 0)))

; The lifted lambda bodies of one compile. Everything else in the table
; is re-created by the next entry's compile from the same text.
(defn eval-lifted-of (fns)
  (match fns
    (Nil Nil)
    (Cons f rest
      (if (= (eval-lambda-name-p (in-fn-name f)) 1)
        (Cons f (eval-lifted-of rest))
        (eval-lifted-of rest)))))

(defn eval-lambda-name-p (name)
  (eval-contains name "_lambda_"))

(defn eval-contains (s sub)
  (eval-contains-at s sub 0))

(defn eval-contains-at (s sub i)
  (if (> (+ i (str-length sub)) (str-length s))
    0
    (if (str-eq (str-substring s i (str-length sub)) sub)
      1
      (eval-contains-at s sub (+ i 1)))))

(defn session-drop-global (gs name)
  (match gs
    (Nil Nil)
    (Cons g rest
      (if (str-eq (Global.name g) name)
        (session-drop-global rest name)
        (Cons g (session-drop-global rest name))))))

(defn session-bump (s)
  (Session (Session.uses s) (Session.defs s) (Session.globals s)
           (Session.lifted s) (+ (Session.count s) 1) (Session.dir s)))

; ===========================================================================
; READING AN ENTRY
; ===========================================================================

; The head symbol of `(head ...)`, or "" if the entry is not a form.
(defn eval-head (text)
  (let n (str-length text)
    (let i (eval-skip-space text 0 n)
      (if (>= i n)
        ""
        (if (= (term-byte-at text i) 40)
          (let start (eval-skip-space text (+ i 1) n)
            (str-substring text start (- (eval-symbol-end text start n) start)))
          "")))))

(defn eval-skip-space (text i n)
  (if (>= i n)
    i
    (if (= (eval-space-p (term-byte-at text i)) 1)
      (eval-skip-space text (+ i 1) n)
      i)))

(defn eval-space-p (b)
  (if (= b 32) 1 (if (= b 9) 1 (if (= b 10) 1 (if (= b 13) 1 0)))))

(defn eval-symbol-end (text i n)
  (if (>= i n)
    n
    (let b (term-byte-at text i)
      (if (= (eval-space-p b) 1) i
      (if (= b 40) i
      (if (= b 41) i
      (eval-symbol-end text (+ i 1) n)))))))

; The word after the head: a definition's name, or a use's module.
(defn eval-second-word (text)
  (let n (str-length text)
    (let i (eval-skip-space text 0 n)
      (let after-head (eval-symbol-end text (eval-skip-space text (+ i 1) n) n)
        (let s (eval-skip-space text after-head n)
          (str-substring text s (- (eval-symbol-end text s n) s)))))))

; Whether the entry is a definition to keep rather than an expression to
; evaluate. `def` is not in this list: the REPL binds it as a value.
(defn eval-definition-p (text)
  (let head (eval-head text)
    (if (str-eq head "defn") 1
    (if (str-eq head "deftype") 1
    (if (str-eq head "defstruct") 1
    (if (str-eq head "defstruct+") 1
    (if (str-eq head "defmacro") 1
    (if (str-eq head "trait") 1
    (if (str-eq head "impl") 1
    (if (str-eq head "derive") 1
    0))))))))))

; ===========================================================================
; BUILDING THE PROGRAM
; ===========================================================================

(defn eval-use-lines (uses)
  (match uses
    (Nil "")
    (Cons u rest (str-concat (str-concat "(use " (str-concat u ")\n"))
                             (eval-use-lines rest)))))

; The name of the function an entry is wrapped in. Long enough not to
; collide with anything a user would write, and looked up by suffix
; because module resolution qualifies it (§31.2).
(defn eval-entry-name () "__zyl_repl_entry")

; Globals the entry actually mentions, in binding order.
(defn eval-used-globals (globals text)
  (match globals
    (Nil Nil)
    (Cons g rest
      (if (= (eval-mentions text (Global.name g)) 1)
        (Cons g (eval-used-globals rest text))
        (eval-used-globals rest text)))))

; A whole-token occurrence of `name` in `text`: `x` does not match
; inside `xs` or `max`.
(defn eval-mentions (text name)
  (eval-mentions-at text name 0))

(defn eval-mentions-at (text name i)
  (let n (str-length name)
    (if (> (+ i n) (str-length text))
      0
      (if (= (eval-token-match text name i n) 1)
        1
        (eval-mentions-at text name (+ i 1))))))

(defn eval-token-match (text name i n)
  (if (str-eq (str-substring text i n) name)
    (if (= (eval-boundary-p text (- i 1)) 1)
      (eval-boundary-p text (+ i n))
      0)
    0))

; Positions outside the text count as boundaries; inside, anything that
; cannot continue an identifier does.
(defn eval-boundary-p (text i)
  (if (< i 0)
    1
    (if (>= i (str-length text))
      1
      (eval-delimiter-p (term-byte-at text i)))))

(defn eval-delimiter-p (b)
  (if (= (eval-space-p b) 1) 1
  (if (= b 40) 1
  (if (= b 41) 1
  (if (= b 34) 1
  (if (= b 39) 1
  0))))))

(defn eval-param-list (gs)
  (match gs
    (Nil "")
    (Cons g rest (str-concat (Global.name g) (str-concat " " (eval-param-list rest))))))

(defn eval-global-values (gs)
  (match gs
    (Nil Nil)
    (Cons g rest (Cons (Global.value g) (eval-global-values rest)))))

; The program for evaluating one expression: the session's modules, its
; definitions, and the expression wrapped in a function that takes the
; globals it mentions.
; Each prompt `def` is also a top-level def of the program, so a later
; definition can refer to it: its value comes from the runtime table the
; binding filled (zyl-repl-global), and the dead `(if false SRC ...)`
; branch gives it SRC's type without evaluating SRC again.
(defn eval-global-defs (gs)
  (match gs
    (Nil "")
    (Cons g rest
      (str-concat "(def " (str-concat (Global.name g) (str-concat " (if false " (str-concat (Global.source g)
        (str-concat " (zyl-repl-global \"" (str-concat (Global.name g) (str-concat "\")))\n" (eval-global-defs rest)))))))))))

(defn eval-program-expr (sess text gs)
  (str-concat (eval-use-lines (Session.uses sess))
    (str-concat (eval-global-defs (Session.globals sess))
    (str-concat (Session.defs sess)
      (str-concat "\n(defn " (str-concat (eval-entry-name)
        (str-concat " (" (str-concat (eval-param-list gs)
          (str-concat ") " (str-concat text ")\n"))))))))))

; The program for checking a definition: the same, with the new
; definition in place and a trivial entry so that something references
; the module set.
(defn eval-program-defs (sess text)
  (str-concat (eval-use-lines (Session.uses sess))
    (str-concat (eval-global-defs (Session.globals sess))
    (str-concat (Session.defs sess)
      (str-concat "\n" (str-concat text
        (str-concat "\n(defn " (str-concat (eval-entry-name) " () 0)\n"))))))))

; ===========================================================================
; RUNNING AN ENTRY
; ===========================================================================

; Compile to lowered functions, or hand back the diagnostics. Every
; reporting path in the compiler ends in zyl_panic, which unwinds to
; here rather than ending the session.
; Returns: Result(List(Icnf), String)
(defn eval-lower (arena src)
  (try (Ok (compile-to-fns arena src "<repl>")) (catch e (Err e))))

; Interpreting is wrapped too: an interpreted program can divide by
; zero, call something undefined, or `error` on purpose, and all three
; arrive here as a message.
; Returns: Result(Val, String)
(defn eval-interpret (fns name vals)
  (let _ (ffi-call "zyl_iglobal_clear" 1000)
    (try (Ok (in-call-fn fns name vals)) (catch e (Err e)))))

; ===========================================================================
; TYPES
; ===========================================================================

; The type of an expression, without running it: the front end and type
; inference, then the entry function's own body inferred against the
; result. Inference is whole-program here exactly as it is for a file,
; so a name defined three entries ago is typed the way the compiler
; types it.
; Returns: Result(String, String)
(defn eval-type-of (sess text)
  (let gs (eval-used-globals (Session.globals sess) text)
    (let scratch (arena-create 8388608)
      (let saved (eval-heap-swap scratch)
        (let res (eval-type-run scratch sess text gs)
          (begin
            (eval-heap-swap saved)
            (let copied (eval-copy-type res)
              (begin
                (arena-destroy scratch)
                copied))))))))

(defn eval-copy-type (res)
  (match res
    (Err msg (Err (eval-copy-str msg)))
    (Ok text (Ok (eval-copy-str text)))))

(defn eval-type-run (_scratch sess text gs)
  (let arena (eval-entry-arena)
    (let out (try (Ok (eval-type-infer arena sess text gs)) (catch e (Err e)))
      (begin
        (arena-destroy arena)
        out))))

(defn eval-type-infer (arena sess text gs)
  (let exprs (dv-expand-program (compile-to-exprs arena (eval-program-expr sess text gs) "<repl>"))
    (match (eval-entry-body exprs)
      (None "?")
      (Some body (ta-type-text exprs body)))))

; The body of the function the entry was wrapped in.
(defn eval-entry-body (exprs)
  (match exprs
    (Nil None)
    (Cons e rest
      (match (Expr.inner e)
        (EDefn name _ body
          (if (= (eval-ends-with name (eval-entry-name)) 1)
            (Some body)
            (eval-entry-body rest)))
        (_ (eval-entry-body rest))))))

(deftype EvalOutcome (EvalOutcome EvalResult Session))

(defn EvalOutcome.result (o) (match o (EvalOutcome r _ r)))
(defn EvalOutcome.session (o) (match o (EvalOutcome _ s s)))

(defn eval-entry (sess text)
  (let head (eval-head text)
    (if (str-eq head "use")
      (eval-add-use sess text)
      (if (str-eq head "def")
        (eval-add-global sess text)
        (if (= (eval-definition-p text) 1)
          (eval-add-definition sess text)
          (eval-expression sess text))))))

; A definition is accepted once the whole session still compiles with
; it. Nothing runs: a definition has no effect until something calls it.
; A definition is checked in a throwaway arena: nothing it lowers to is
; kept, because the next entry re-lowers it from the session's text.
(defn eval-add-definition (sess text)
  (let name (eval-second-word text)
    (let arena (eval-entry-arena)
      (let scratch (arena-create 8388608)
        (let saved (eval-heap-swap scratch)
          (let res (eval-lower arena (eval-program-defs sess text))
            (let copied (eval-copy-result res saved scratch arena)
              (eval-definition-result copied sess text name))))))))

; Leave the scratch window, carrying only the diagnostics out of it.
(defn eval-copy-result (res saved scratch arena)
  (begin
    (eval-heap-swap saved)
    (let out (eval-copy-lower res)
      (begin
        (arena-destroy scratch)
        (arena-destroy arena)
        out))))

(defn eval-copy-lower (res)
  (match res
    (Err msg (Err (eval-copy-str msg)))
    (Ok _ (Ok 0))))

(defn eval-definition-result (res sess text name)
  (match res
    (Err msg (EvalOutcome (EvalFailed msg) sess))
    (Ok _ (EvalOutcome (EvalDefined name) (session-with-defs sess text)))))

; `(use module)` extends the session's module set, and is rejected if
; the module does not resolve or collides with one already in scope.
(defn eval-add-use (sess text)
  (let module (eval-second-word text)
    (let probe (session-with-use sess module)
      (let arena (eval-entry-arena)
        (let scratch (arena-create 8388608)
          (let saved (eval-heap-swap scratch)
            (let res (eval-lower arena (eval-program-defs probe ""))
              (let copied (eval-copy-result res saved scratch arena)
                (eval-use-result copied sess probe module)))))))))

(defn eval-use-result (res sess probe module)
  (match res
    (Err msg (EvalOutcome (EvalFailed msg) sess))
    (Ok _ (EvalOutcome (EvalNote (str-concat "using " module)) probe))))

; `(def name expr)` evaluates expr once, now, and binds the value for
; every later entry. Top-level `def` is not a compiled construct in this
; language (see codegen's cg-load-nonslot); at the prompt it is the
; natural way to name a value, so the REPL gives it that meaning.
; `def` binds a value the session keeps, so it runs against the
; session's own heap arena: the value, and everything it points at, stay
; valid for as long as the binding does.
(defn eval-add-global (sess text)
  (let name (eval-second-word text)
    (let body (eval-def-body text name)
      (let saved (eval-heap-swap (eval-session-heap))
        (match (eval-value-of sess body 1)
          (Outcome res sess2
            (let bound (eval-bind-global name body res sess2)
              (begin
                (eval-heap-swap saved)
                bound))))))))

(defn eval-bind-global (name src res sess)
  (match res
    (Err msg (EvalOutcome (EvalFailed msg) sess))
    (Ok v (let _ (ffi-call "zyl_repl_global_set" name (val-word v) 1000)
            (EvalOutcome (EvalBound name (in-val-text v))
                         (session-with-global sess name v src))))))

; The expression inside `(def name <expr>)`, with the trailing paren of
; the `def` form removed.
(defn eval-def-body (text name)
  (let n (str-length text)
    (let start (eval-def-body-start text name n)
      (str-substring text start (- (eval-def-body-end text n) start)))))

(defn eval-def-body-start (text _name n)
  (let i (eval-skip-space text 0 n)
    (let after-head (eval-symbol-end text (eval-skip-space text (+ i 1) n) n)
      (eval-skip-space text (eval-symbol-end text (eval-skip-space text after-head n) n) n))))

(defn eval-def-body-end (text n)
  (eval-trim-back text (- n 1)))

(defn eval-trim-back (text i)
  (if (< i 0)
    0
    (if (= (eval-space-p (term-byte-at text i)) 1)
      (eval-trim-back text (- i 1))
      (if (= (term-byte-at text i) 41) i (+ i 1)))))

; An expression keeps nothing, so everything it allocates -- the
; compiler's garbage, the values it built, the text of its own result --
; goes in a scratch heap arena. Only the line to print is copied out,
; after the real heap is back in place and before the scratch is gone.
(defn eval-expression (sess text)
  (let scratch (arena-create 8388608)
    (let saved (eval-heap-swap scratch)
      (match (eval-value-of sess text 0)
        (Outcome res sess2
          (let shown (eval-shown-of res)
            (begin
              (eval-heap-swap saved)
              (let copied (eval-copy-shown shown)
                (begin
                  (arena-destroy scratch)
                  (EvalOutcome copied (session-bump sess2)))))))))))

; The result line, still inside the scratch window (rendering a value's
; text allocates).
(defn eval-shown-of (res)
  (match res
    (Err msg (EvalFailed msg))
    (Ok v (eval-result-of v))))

(defn eval-copy-shown (r)
  (match r
    (EvalFailed msg (EvalFailed (eval-copy-str msg)))
    (EvalValue text (EvalValue (eval-copy-str text)))
    (EvalUnit (EvalUnit))
    (EvalNote text (EvalNote (eval-copy-str text)))
    (EvalDefined name (EvalDefined (eval-copy-str name)))
    (EvalBound name text (EvalBound (eval-copy-str name) (eval-copy-str text)))))

; `print` and anything else whose value is a bare 0 would otherwise put
; a pointless `=> 0` under every line that already printed itself.
(defn eval-result-of (v)
  (match v
    (VInt n (if (= n 0) (EvalUnit) (EvalValue (in-val-text v))))
    (_ (EvalValue (in-val-text v)))))

; A value, and the session that producing it left behind -- evaluating
; an expression can lift a lambda the session must keep.
(deftype Outcome (Outcome (Result Val String) Session))

; Each entry compiles into an arena of its own, which is then thrown
; away -- unless the entry lifted a lambda, because a closure value the
; session keeps points at the lifted function's body, and that body
; lives in the arena that produced it. An entry that creates no closure
; leaves nothing behind.
(defn eval-entry-arena ()
  (arena-create 8388608))

; The other half of an entry's memory is the heap: compiling a program
; builds a canonical key per identifier, a mangled label per definition
; and a diagnostic per warning, all through str-concat, and a bump
; allocator never takes any of it back. So an entry runs against a heap
; arena of its own.
;
; Which arena depends on whether the entry keeps anything:
;
;   an expression, a definition, a use  -> a scratch arena, destroyed
;     when the entry finishes. Nothing it allocated outlives it, except
;     the one string the REPL copies out to print.
;
;   `def`                               -> the session's own arena, kept
;     for the life of the session, because the value being bound lives
;     in it and so does everything it points at.
;
; That is what keeps a long session flat: typing expressions costs no
; permanent memory, and binding a value costs exactly the value.
(defn eval-session-heap ()
  (ffi-call "zyl_session_arena" 1000))

(defn eval-heap-swap (arena)
  (ffi-call "zyl_heap_swap" arena 1000))

; Copy a string out of an arena that is about to be destroyed, into
; whichever heap arena is current now.
(defn eval-copy-str (s)
  (str-concat "" s))

; The heart of it: build the program, run the compiler's phases, find
; the function the entry was wrapped in, and evaluate it with the
; session's globals as its arguments. Lambdas lifted by this compile are
; retained, and the ones retained earlier are appended to the table so a
; closure from an earlier entry is still callable.
; `keep` says whether anything this entry produces can outlive it. An
; expression's value is printed and dropped, so its arena goes too,
; closures and all; a `def` binds its value, so a lambda lifted while
; producing it has to stay callable.
(defn eval-value-of (sess text keep)
  (let arena (eval-entry-arena)
    (let gs (eval-used-globals (Session.globals sess) text)
      (match (eval-lower arena (eval-program-expr sess text gs))
        (Err msg (eval-discard arena (Outcome (Err msg) sess)))
        (Ok fns (eval-after-run arena sess fns keep
                  (eval-run-entry (list-append fns (Session.lifted sess))
                                  (eval-global-values gs))))))))

; Keep the compile arena exactly when it holds something the session
; still refers to -- the body of a lifted lambda that a closure names.
(defn eval-after-run (arena sess fns keep res)
  (let lifted (eval-lifted-of fns)
    (if (= keep 0)
      (eval-discard arena (Outcome (eval-heapify res) sess))
      (if (= (is-nil-list lifted) 1)
        (eval-discard arena (Outcome (eval-heapify res) sess))
        (Outcome res (session-with-lifted sess fns))))))

; A String value can point straight into the entry's compile arena --
; a literal, interned there by the lexer and handed through untouched --
; so it is copied into the heap before that arena is destroyed. Blocks
; need no copying: the interpreter allocates those from the heap.
(defn eval-heapify (res)
  (match res
    (Err msg (Err (eval-copy-str msg)))
    (Ok v (Ok (eval-heapify-val v)))))

(defn eval-heapify-val (v)
  (match v
    (VStr p (VStr (in-word-of-str (eval-copy-str (in-str-of-word p)))))
    (_ v)))

(defn eval-discard (arena out)
  (begin
    (arena-destroy arena)
    out))

(defn eval-run-entry (fns vals)
  (match (eval-entry-fn fns)
    (None (Err "error[E_INTERNAL]: the entry did not survive lowering"))
    (Some name (eval-interpret fns name vals))))

; Module resolution qualifies every top-level name (§31.2), so the entry
; is found by the suffix it was given rather than by an exact match.
(defn eval-entry-fn (fns)
  (match fns
    (Nil None)
    (Cons f rest
      (let n (in-fn-name f)
        (if (= (eval-ends-with n (eval-entry-name)) 1)
          (Some n)
          (eval-entry-fn rest))))))

(defn eval-ends-with (s suffix)
  (let ns (str-length s)
    (let nf (str-length suffix)
      (if (< ns nf)
        0
        (str-eq (str-substring s (- ns nf) nf) suffix)))))

; ===========================================================================
; SAVED SESSIONS
; ===========================================================================

; A file's whole contents, or "" if it cannot be read -- a missing
; session file or rc file is a first run, not an error.
(defn eval-read-file (path)
  (let fd (file-open path "r")
    (if (<= fd 0)
      ""
      (let text (file-read fd 4194304)
        (begin
          (file-close fd)
          text)))))

; A session writes itself to `.zyl-session` in the directory it was
; started in, and reads it back the next time a session starts there.
; That is what makes the state per project: two checkouts do not share
; definitions, and neither does a session started in /tmp.
;
; The file is ordinary Zyl source -- `(use ...)` lines, the definitions
; as entered, and a `(def ...)` per binding -- so it can be read, edited
; by hand, and loaded with `:load` like any other file. Restoring it
; replays those entries, which means a `def` whose expression had an
; effect has that effect again; `:reset` starts clean, and deleting the
; file is the other way to say the same thing.
(defn session-file (dir)
  (str-concat dir "/.zyl-session"))

(defn session-save (sess)
  (let path (session-file (Session.dir sess))
    (if (= (session-empty-p sess) 1)
      0
      (let fd (file-open path "w")
        (if (<= fd 0)
          -1
          (begin
            (file-write fd (session-text sess))
            (file-close fd)
            0))))))

(defn session-empty-p (sess)
  (if (> (str-length (Session.defs sess)) 0)
    0
    (match (Session.globals sess)
      (Nil (if (= (list-length (Session.uses sess))
                  (list-length (session-default-uses))) 1 0))
      (Cons _ _ 0))))

(defn session-text (sess)
  (str-concat "; Zyl REPL session state. Loaded when a session starts here.\n"
    (str-concat (eval-use-lines (Session.uses sess))
      (str-concat (Session.defs sess)
        (str-concat "\n" (session-global-lines (Session.globals sess)))))))

(defn session-global-lines (gs)
  (match gs
    (Nil "")
    (Cons g rest
      (str-concat (str-concat "(def " (str-concat (Global.name g)
                    (str-concat " " (str-concat (Global.source g) ")\n"))))
                  (session-global-lines rest)))))

; Read the saved session back, entry by entry, so that each one goes
; through exactly the path it would have taken if it had been typed.
; Returns the session, and how many entries were restored.
(deftype Restored (Restored Session Int))

(defn Restored.session (r) (match r (Restored s _ s)))
(defn Restored.count (r) (match r (Restored _ n n)))

(defn session-restore (sess)
  (let text (eval-read-file (session-file (Session.dir sess)))
    (if (= (str-length text) 0)
      (Restored sess 0)
      (session-replay sess (session-forms text 0 (str-length text) "" Nil) 0))))

(defn session-replay (sess forms n)
  (match forms
    (Nil (Restored sess n))
    (Cons f rest
      (let outcome (eval-entry sess f)
        (match (EvalOutcome.result outcome)
          (EvalFailed _ (session-replay sess rest n))
          (_ (session-replay (EvalOutcome.session outcome) rest (+ n 1))))))))

; Split a file into top-level forms: everything between a '(' at depth 0
; and the ')' that closes it, with comments and strings respected.
(defn session-forms (text i n acc out)
  (if (>= i n)
    (list-reverse out)
    (let b (term-byte-at text i)
      (if (= b 59)
        (session-forms text (session-line-end text i n) n acc out)
        (if (= b 40)
          (let e (session-form-end text i n 0)
            (session-forms text e n acc (Cons (str-substring text i (- e i)) out)))
          (session-forms text (+ i 1) n acc out))))))

(defn session-line-end (text i n)
  (if (>= i n)
    n
    (if (= (term-byte-at text i) 10) (+ i 1) (session-line-end text (+ i 1) n))))

; The index just past the form that starts at `i`.
(defn session-form-end (text i n depth)
  (if (>= i n)
    n
    (let b (term-byte-at text i)
      (if (= b 34)
        (session-form-end text (session-string-end text (+ i 1) n) n depth)
        (if (= b 59)
          (session-form-end text (session-line-end text i n) n depth)
          (if (= b 40)
            (session-form-end text (+ i 1) n (+ depth 1))
            (if (= b 41)
              (if (<= depth 1) (+ i 1) (session-form-end text (+ i 1) n (- depth 1)))
              (session-form-end text (+ i 1) n depth))))))))

(defn session-string-end (text i n)
  (if (>= i n)
    n
    (let b (term-byte-at text i)
      (if (= b 92)
        (session-string-end text (+ i 2) n)
        (if (= b 34) (+ i 1) (session-string-end text (+ i 1) n))))))

; ===========================================================================
; STARTUP FILE
; ===========================================================================

; ~/.zyl/replrc (or $ZYL_REPLRC) is read before the first prompt, and is
; the same thing as a saved session: Zyl source, one form per entry.
; This is where a `(use ...)` you always want, or a helper you always
; reach for, belongs.
(defn eval-rc-path ()
  (let p (ffi-call "zyl_getenv" "ZYL_REPLRC" 1000)
    (if (> p 0) p (str-concat (hist-dir) "/replrc"))))

(defn session-load-rc (sess)
  (let text (eval-read-file (eval-rc-path))
    (if (= (str-length text) 0)
      (Restored sess 0)
      (session-replay sess (session-forms text 0 (str-length text) "" Nil) 0))))
