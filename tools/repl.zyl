
(use allocator/allocator)
(use compiler/lexer)
(use compiler/parser)
(use compiler/ast)
(use compiler/expr_inner)
(use compiler/module_resolver)
(use compiler/macro_expand)
(use compiler/monomorphization)
(use compiler/icnf)
(use compiler/trait_dispatch)
(use compiler/closure_inline)
(use compiler/assert_lowering)
(use compiler/codegen)
(use compiler/region_inference)
(use compiler/optimization)

(def repl-banner "Zyl REPL — type expressions, :q to quit")

(defn repl-print-banner ()
  (print repl-banner))

; str-trim doesn't exist anywhere else in the codebase (not stdlib, not
; a builtin, not FFI-backed) -- repl.zyl calling it was always a latent
; bug, never reachable before because the file never linked at all.
; Implemented locally rather than added to the shared stdlib: this file
; compiles standalone via module_resolver, outside assemble.py's
; bundle, so it carries zero risk to the self-hosting fixed point.
(defn str-trim-ws-byte (b)
  (or (= b 32) (or (= b 9) (or (= b 10) (= b 13)))))

(defn str-trim-start-idx (s i len)
  (if (>= i len)
    i
    (if (str-trim-ws-byte (ffi-call "zyl_cstr_byte_at" s i 1000))
      (str-trim-start-idx s (+ i 1) len)
      i)))

(defn str-trim-end-idx (s i)
  (if (< i 0)
    0
    (if (str-trim-ws-byte (ffi-call "zyl_cstr_byte_at" s i 1000))
      (str-trim-end-idx s (- i 1))
      (+ i 1))))

(defn str-trim (s)
  (let len (str-length s)
    (let start (str-trim-start-idx s 0 len)
      (let end (str-trim-end-idx s (- len 1))
        (if (> end start)
          (str-substring s start (- end start))
          "")))))

(defn repl-read-line (fd)
  (let buf (arena-alloc-zeroed (arena-create 1048576) 4096)
    (let n (file-read fd 4095)
      (if (> n 0)
        (let line (str-substring buf 0 n)
          (Some (str-trim line)))
        None))))

; str-eq returns 1 for equal, 0 for not-equal (see zyl_cstr_eq in
; actor_runtime.c) -- this used to check `= 0`, i.e. "not equal to :q
; OR not equal to :quit", which is true for every line except one that
; is somehow both at once, so it quit on the very first input
; regardless of content.
(defn repl-is-quit (line)
  (or (= (str-eq line ":q") 1) (= (str-eq line ":quit") 1)))

(defn repl-wrap-expr (arena line) String
  (str-concat "(defn main () " (str-concat line ")")))

(defn repl-parse (arena src)
  (zyl-parse arena src))

(defn repl-resolve (arena exprs)
  (mr-resolve-program arena exprs))

(defn repl-expand (exprs)
  (me-expand-program exprs))

(defn repl-infer (exprs)
  (collect-definitions (inferer-new) exprs))

; Real contract injection (compiler/contract_injection.zyl) is NOT used
; here: that module's accessors/constructors don't match the actual
; DefnNode/TestDecl/TestSuiteNode shapes in expr_inner.zyl (see
; driver.zyl's identical passthrough for the full explanation), and its
; own `ci-expand-program` (1 arg) collides by name with closure_inline.
; zyl's unrelated, differently-shaped `ci-expand-program` (2 args) --
; used below by repl-closure-inline. Importing both here, as this file
; used to, made module_resolver pull in contract_injection.zyl's
; version, whose body references AST accessors that don't exist under
; the real deftypes, causing exactly the cascade of undefined-reference
; link errors driver.zyl's own comment warns about. Pass exprs through
; unchanged until contract injection is properly rewritten to match the
; real deftypes.
(defn repl-contracts (exprs)
  exprs)

(defn repl-monomorphize (inferer exprs)
  (let mono-ctx (mono-context-populate-adt-order (mono-context-new inferer) inferer)
    (monomorphize mono-ctx exprs)))

(defn repl-trait-dispatch (exprs)
  (td-expand-program exprs))

(defn repl-closure-inline (arena exprs)
  (ci-expand-program arena exprs))

(defn repl-assert-lowering (exprs)
  (al-expand-program exprs))

(defn repl-icnf (arena exprs)
  (ic-program arena exprs))

(defn repl-region-infer (fns)
  (ri-transform-fns fns))

; compiler/optimization.zyl is NOT called here: it's written against
; src/optimization.rs's SSA-form ICNFNode/IFS representation, while this
; pipeline's own compiler/icnf.zyl lowering produces a different,
; simpler tree-shaped Icnf (IFn name params body) that codegen.zyl
; consumes directly. Feeding a real `(List IFn)` into opt-optimize's
; `IFS` pattern never matches (see driver.zyl's identical passthrough
; for the full explanation), so opt-optimize always returns Nil --
; silently dropping every function, which used to make repl-codegen
; emit a binary with no main at all. Pass fns through unchanged.
(defn repl-optimize (fns)
  fns)

(defn repl-codegen (arena fns)
  (let opt-fns (repl-optimize fns)
    (let st (cg-program (cg-new arena) opt-fns)
      (let buf (cg-buffer st)
        (let out (file-open "/tmp/repl_out.s" "w")
          (let n (file-write out buf)
            (let d1 (file-close out)
              (let cc (ffi-call "zyl_cc_compile" "/tmp/repl_out.s" 1000)
                (if (= cc 0)
                  (ffi-call "zyl_run_bin" "/tmp/repl_out" 1000)
                  -1))))))))

(defn repl-compile-and-run (arena line)
  (let wrapped (repl-wrap-expr arena line)
    (let prog (repl-parse arena wrapped)
      (let exprs0 (convert-ast-list prog)
        (let exprs1 (repl-resolve arena exprs0)
          (let exprs (repl-expand exprs1)
            (let inferer (repl-infer exprs)
              (let ci-exprs (repl-contracts exprs)
                (let mono-exprs (repl-monomorphize inferer ci-exprs)
                  (let td-exprs (repl-trait-dispatch mono-exprs)
                    (let ci-exprs2 (repl-closure-inline arena td-exprs)
                      (let al-exprs (repl-assert-lowering ci-exprs2)
                        (let fns (repl-icnf arena al-exprs)
                          (let region-fns (repl-region-infer fns)
                            (repl-codegen arena region-fns))))))))))))))))


(defn repl-loop (arena)
  (let fd (file-open "/dev/stdin" "r")
    (if (> fd 0)
      (let line (repl-read-line fd)
        (if line
          (if (repl-is-quit line)
            (begin (print "Goodbye!") 0)
            (let result (repl-compile-and-run arena line)
              (if (> result 0)
                (print (str-concat "Error: " (ffi-call "zyl_cstr_from_int" arena result 1000)))
                (print (str-concat "=> " (ffi-call "zyl_cstr_from_int" arena result 1000)))))
              (repl-loop arena))
          (repl-loop arena)))
      -1)))

(defn main ()
  (let arena (arena-create 1048576)
    (print "Zyl REPL — type expressions, :q to quit")
    (repl-loop arena)))
