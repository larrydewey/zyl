; === Zyl REPL — standalone entry point ===
;
; The session itself lives in stdlib/repl/*, so that `zyl repl` (see
; selfhost/driver.zyl) and this binary run the same code. This file is
; only the `main` that a standalone build needs.

(use allocator/allocator)
(use repl/repl)

(defn main ()
  (repl-main (arena-create 1048576)))
