; FFI Advanced Regression Tests — ffi-call, ffi-pin, ffi-unpin, pinning, timeouts.
; Spec §20: FFI calls require timeout parameter (last argument).

(use core/core)
(use ffi/ffi)
(use collections/vec)

(extern "puts" (String) Int)
(extern "abs" (Int) Int)

; Basic FFI call with timeout.
(
  test
  "ffi-basic"
  (
    let
    result
    (ffi-call "puts" "hello from ffi" 1000)
    (
      assert-true
      (> result 0)
    )
  )
)

; FFI pin/unpin: a (Pin String) slot holds the string and gives it back.
; (This test used to pass the slot's address to puts as if it were the
; string, and wrote its assertion as an ignored second argument of
; ffi-unpin.)
(test "ffi-pin-unpin"
  (let pinned (ffi-pin "test string")
    (assert-true (str-eq (ffi-unpin pinned) "test string"))))

; FFI with integer arguments.
(
  test
  "ffi-int-args"
  (
    let
    result
    (ffi-call "abs" -42 1000)
    (
      assert-equal
      result
      42
    )
  )
)

; FFI safe call wrapper (if available).
; ffi-safe-call not implemented — test syntax only.
(
  test
  "ffi-safe-call-syntax"
  (
    assert-equal
    1
    1
  )
)

; Vector for FFI buffers.
(
  test
  "ffi-vec-buffer"
  (
    assert-equal
    (vec-len
      (vec-push
        (vec-push (vec-create-default 10) 1)
        2))
    2
  )
)

; FFI callback not supported.

(run-tests)