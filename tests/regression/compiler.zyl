; Compiler Regression Tests — stdlib/compiler: lexer, parser, AST types

(use allocator/allocator)
(use compiler/lexer)
(use compiler/parser)
(use compiler/ast)
(use compiler/sexp_balance)

(defn tk-at (toks n)
  (if (<= n 0)
    toks
    (tk-at (toks-tail toks) (- n 1))))

(defn ah (xs)
  (match xs
    (Cons a rest a)
    (Nil (AList Nil))))

; nth element of an Ast list.
(defn nth-ast (xs n)
  (match xs
    (Cons a rest
      (if (<= n 0) a (nth-ast rest (- n 1))))
    (Nil (AList Nil))))

; True when the Ast node is an identifier equal to `s`.
(defn ident-eq (arena a s)
  (match a
    (AstIdent n (if (> (str-eq n (str-intern arena s)) 0) 1 0))
    (AstInt d1 0)
    (AstFloat d2 0)
    (AString d3 0)
    (AstBool d4 0)
    (AList d5 0)))

; Token classifier: 1 when the token matches the expected constructor,
; 0 otherwise (all constructors enumerated).
(defn tok-is (t want)
  (match t
    (TkEof (= 0 want))
    (TkLParen (= 8 want))
    (TkRParen (= 9 want))
    (TkLBrace (= 10 want))
    (TkRBrace (= 11 want))
    (TkLBracket (= 12 want))
    (TkRBracket (= 13 want))
    (TkColon (= 14 want))
    (TkInt d6 (= 2 want))
    (TkFloat d7 (= 3 want))
    (TkString d8 (= 4 want))
    (TkBool d9 (= 5 want))
    (TkIdent d10 (= 1 want))
    (TkSymbol d11 (= 6 want))
    (TkKeyword d12 (= 7 want))))

; Payload of an AstInt node; -1 otherwise.
(defn atom-int (a)
  (match a
    (AstInt v v)
    (AstIdent d13 -1)
    (AstFloat d14 -1)
    (AString d15 -1)
    (AstBool d16 -1)
    (AList d17 -1)))

; Lexer produces a (List Token) ending in TkEof
(test "lex-stream"
  (let arena (arena-create 0)
    (let toks (zyl-lex arena "(+ 1 2)")
      (begin
        ; 5 tokens + EOF
        (assert-equal (list-length toks) 6)
        ; token 0: '('
        (assert-true (= (tok-is (toks-head toks) 8) 1))
        ; token 3: int 2
        (assert-true (= (tok-is (toks-head (tk-at toks 3)) 2) 1))
        ; token 4: ')'
        (assert-true (= (tok-is (toks-head (tk-at toks 4)) 9) 1))
        ; token 5: EOF
        (assert-true (= (tok-is (toks-head (tk-at toks 5)) 0) 1))
        0))))

; Reader builds nested Ast forms
(test "parse-nested-ast"
  (let arena (arena-create 0)
    (let prog (zyl-parse arena "(defn f (x) (* x x))")
      (begin
        (assert-equal (list-length prog) 1)
        ; head identifier is "defn"
        (assert-true (> (ident-eq arena (nth-ast (kids-of-form (ah prog)) 0) "defn") 0))
        ; body (4th element) is a 3-element list form (* x x)
        (assert-equal (list-len-or-0 (nth-ast (kids-of-form (ah prog)) 3)) 3)
        0))))

; Children of an AList node; empty otherwise.
(defn kids-of-form (a)
  (match a
    (AList kids kids)
    (AstIdent d18 Nil)
    (AstInt d19 Nil)
    (AstFloat d20 Nil)
    (AString d21 Nil)
    (AstBool d22 Nil)))

; Number of children when `a` is an AList; 0 otherwise.
(defn list-len-or-0 (a)
  (match a
    (AList kids (list-length kids))
    (AstIdent d23 0)
    (AstInt d24 0)
    (AstFloat d25 0)
    (AString d26 0)
    (AstBool d27 0)))

; Line component of a location-carrying BalanceResult; -1 otherwise.
(defn br-line (r)
  (match r
    (Balanced -1)
    (UnbalancedOpenString -1)
    (UnclosedOpen closer line col line)
    (UnbalancedClose closer line col line)
    (MismatchedPair opener closer line col line)))

; Column component of a location-carrying BalanceResult; -1 otherwise.
(defn br-col (r)
  (match r
    (Balanced -1)
    (UnbalancedOpenString -1)
    (UnclosedOpen closer line col col)
    (UnbalancedClose closer line col col)
    (MismatchedPair opener closer line col col)))

; sexp_balance: native structural balance check, exercised directly
; (not just via the compile-fail black-box tests, which only prove the
; compiler exits nonzero) so a regression in the reported location or
; in bracket-type discrimination shows up as a specific assertion
; failure instead of just "still fails to compile, for some reason".
(test "balance-ok"
  (let r (sb-check-string "(defn f (x) (* x x))")
    (begin
      (assert-equal (sb-result-balanced r) 1)
      0)))

(test "balance-unclosed-open"
  (let r (sb-check-string "(defn main () (begin (print (+ 1 2)) 0)")
    (begin
      (assert-equal (sb-result-balanced r) 0)
      ; reports the OPENER's position (the outermost '(', the only
      ; frame still on the stack), not the EOF position.
      (assert-equal (br-line r) 1)
      (assert-equal (br-col r) 1)
      (assert-true (> (str-length (sb-hint r)) 0))
      0)))

(test "balance-unexpected-close"
  (let r (sb-check-string "(defn main () (begin (print (+ 1 2)) 0)))")
    (begin
      (assert-equal (sb-result-balanced r) 0)
      (assert-equal (br-line r) 1)
      (assert-equal (br-col r) 41)
      0)))

(test "balance-mismatched-bracket"
  (let r (sb-check-string "(defn main (] (begin (print (+ 1 2)) 0))")
    (begin
      (assert-equal (sb-result-balanced r) 0)
      (assert-equal (br-line r) 1)
      (assert-equal (br-col r) 13)
      0)))

; ")(" nets to a valid open/close COUNT but is never validly nested --
; the old depth-counter this validator replaced let it through silently.
(test "balance-reversed-pair-rejected"
  (let r (sb-check-string ")(")
    (begin
      (assert-equal (sb-result-balanced r) 0)
      0)))

(run-tests)
