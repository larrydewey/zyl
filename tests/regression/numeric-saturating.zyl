(numeric saturating)
; Spec 20.1 saturating arithmetic: Int + - * clamp to INT_MAX or INT_MIN,
; by the sign the true result would have, on every emission path.

(defn big () 9223372036854775807)
(defn small () (- -9223372036854775807 1))
(defn zero () 0)

(test "sat-add-imm" (assert-equal (+ (big) 1) (big)))
(test "sat-add-reg" (assert-equal (+ (big) (big)) (big)))
(test "sat-add-negative" (assert-equal (+ (small) (small)) (small)))
(test "sat-sub-imm" (assert-equal (- (small) 1) (small)))
(test "sat-sub-reg" (assert-equal (- (big) (small)) (big)))
(test "sat-sub-other-way" (assert-equal (- (small) (big)) (small)))
(test "sat-mul-imm" (assert-equal (* (big) 2) (big)))
(test "sat-mul-pow2" (assert-equal (* (small) 8) (small)))
(test "sat-mul-reg-positive" (assert-equal (* (big) (big)) (big)))
(test "sat-mul-mixed-signs" (assert-equal (* (big) -2) (small)))
(test "sat-mul-two-negatives" (assert-equal (* (small) -2) (big)))
(test "sat-negate-min" (assert-equal (- (small)) (big)))
(test "sat-literal-fold" (assert-equal (+ 9223372036854775807 1) (big)))
(test "sat-literal-mul-fold" (assert-equal (* -4294967296 4294967296) (small)))
(test "sat-plain" (assert-equal (- 50 8) 42))
(test "sat-edge-exact" (assert-equal (+ 9223372036854775806 1) (big)))

(defn sum-big (n) (if (= n 0) 0 (+ (big) (sum-big (- n 1)))))
(test "sat-recursive-sum" (assert-equal (sum-big 3) (big)))

(defn count-up (i n acc) (if (>= i n) acc (count-up (+ i 1) n (+ acc i))))
(test "sat-loop" (assert-equal (count-up 0 100 0) 4950))

(test "sat-div-zero-still-traps" (assert-equal (div! 7 (zero)) 0) (:expect-panic true))
(test "sat-div-min-minus-one-still-traps" (assert-equal (div! (small) -1) 0) (:expect-panic true))

(run-tests)
