; Actor Regression Tests: spawn and join (channels are tests/regression/channels.zyl)
; Spec §15, §513-524

(capabilities actor)

(use core/core)
(use actor/actor)

; Basic spawn returns actor ref
(test "actor-spawn"
  (let a (spawn (fn () 42))
    (assert-true (actor-is-alive a))))

; Actor terminates automatically when body returns
(test "actor-auto-terminate"
  (let a (spawn (fn () 0))
    (actor-wait a)
    0))

; Send message to actor
; Multiple actors
(test "actor-multiple"
  (let a1 (spawn (fn () 1))
    (let a2 (spawn (fn () 2))
      (actor-wait a1)
      (actor-wait a2)
      0)))

; Actor with computation
(test "actor-computation"
  (let a (spawn (fn () (+ 1 2 3 4 5)))
    (actor-wait a)
    0))

; Send multiple messages
; Actor that spawns another actor
(test "actor-spawn-nested"
  (let outer (spawn
    (fn ()
      (let inner (spawn (fn () 99))
        (actor-wait inner)
        0)))
    (actor-wait outer)
    0))

; Actor with Int message (Send-capable)
; Actor with Float message (Send-capable)
; Actor with Bool message (Send-capable)
; Actor termination
; Actor wait returns
(test "actor-wait-returns"
  (let a (spawn (fn () 42))
    (actor-wait a)
    0))



; Int, Float and Bool values cross a channel (all Send-capable)
(test "actor-typed-values"
  (let ci (chan 1)
    (let cf (chan 1)
      (let cb (chan 1)
        (let ti (chan-tx ci)
          (let tf (chan-tx cf)
            (let tb (chan-tx cb)
              (let a (spawn (fn () (begin (chan-send ti 123) (chan-send tf 3.14) (chan-send tb true))))
                (begin
                  (assert-equal (chan-recv (chan-rx ci)) 123)
                  (assert-equal (chan-recv (chan-rx cf)) 3.14)
                  (assert-true (chan-recv (chan-rx cb)))
                  (actor-wait a))))))))))

; Output is buffered per actor and emitted at its join
(test "actor-output-at-join"
  (let a (spawn (fn () (print "from the actor")))
    (begin (actor-wait a) (assert-false (actor-is-alive a)))))

(run-tests)
(numeric checked)
