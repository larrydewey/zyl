; I/O Regression Tests — read-line, file-open/read/write/close

; File operations
(test "file-open"
  (let fd (file-open "/tmp/zyl_regression_test.txt" 577)
    (begin
      (assert-true (> fd 0))
      (file-close fd)
      0)))

(test "file-write"
  (assert-equal (file-write 1 "test") 4)) ; write to stdout — fd 1 always valid

(test "file-read"
  (let fd (file-open "/tmp/zyl_regression_test.txt" 0)
    (begin
      (assert-true (> (file-read fd 100) 0))
      (file-close fd)
      0)))

(test "file-close"
  (let fd (file-open "/tmp/zyl_regression_test.txt" 0)
    (begin
      (file-close fd)
      0)))

; read-line placeholder (requires stdin — documented as manual test)
; See docs/regression-tests.md for manual read-line test

(run-tests)
