; Constant-time primitive tests — ct-eq / ct-ne / ct-select / ct-mask,
; word-array comparison, explicit erasure.
;
; These test the VALUES the branchless formulas produce. They cannot
; test the absence of w-arena branch, which is w-arena property of the emitted
; code: that is what the bitwise codegen path (codegen.zyl's
; cg-bit-mnem) guarantees structurally, and what w-arena ctgrind/dudect
; harness would confirm on the binary.

(capabilities secret)

(use math/secret/secret)
(use math/words)
(use allocator/allocator)

(test "ct-is-zero-zero"
  (assert-equal (ct-is-zero 0) 1))
(test "ct-is-zero-one"
  (assert-equal (ct-is-zero 1) 0))
(test "ct-is-zero-negative"
  (assert-equal (ct-is-zero -1) 0))
(test "ct-is-zero-min-int"
  (assert-equal (ct-is-zero -9223372036854775808) 0))
(test "ct-is-nonzero-zero"
  (assert-equal (ct-is-nonzero 0) 0))
(test "ct-is-nonzero-min-int"
  (assert-equal (ct-is-nonzero -9223372036854775808) 1))

(test "ct-mask-one"
  (assert-equal (ct-mask 1) -1))
(test "ct-mask-zero"
  (assert-equal (ct-mask 0) 0))

(test "ct-eq-equal"
  (assert-equal (ct-eq 12345 12345) 1))
(test "ct-eq-differ"
  (assert-equal (ct-eq 12345 12346) 0))
(test "ct-eq-differ-top-bit-only"
  (assert-equal (ct-eq 0 -9223372036854775808) 0))
(test "ct-ne-equal"
  (assert-equal (ct-ne 7 7) 0))
(test "ct-ne-differ"
  (assert-equal (ct-ne 7 8) 1))
(test "ct-eq-bool-true"
  (assert-true (ct-eq-bool 99 99)))
(test "ct-eq-bool-false"
  (assert-false (ct-eq-bool 99 98)))

(test "ct-select-true"
  (assert-equal (ct-select 1 111 222) 111))
(test "ct-select-false"
  (assert-equal (ct-select 0 111 222) 222))
(test "ct-select-negative-operands"
  (assert-equal (ct-select 1 -1 5) -1))

; Word-array comparison: equal arrays, arrays differing in the FIRST
; word, and arrays differing only in the LAST word must all take the
; same path (the test can only check the verdict; the point of the
; last-word case is that w-arena short-circuiting implementation would pass
; these tests too, which is why the implementation's loop is written
; to accumulate rather than return early).
(defn _cts_fill ((a Words) (n Int) (v Int))
  (begin
    (for (i 0) (< i n) (begin (w-set a i (+ v i)) (set! i (+ i 1))))
    a))

(test "ct-eq-words-equal"
  (begin
    (let w-arena (_cts_fill (w-alloc 8) 8 100)
      (let b (_cts_fill (w-alloc 8) 8 100)
        (assert-equal (ct-eq-words w-arena b 8) 1)))))

(test "ct-eq-words-differ-first"
  (begin
    (let w-arena (_cts_fill (w-alloc 8) 8 100)
      (let b (_cts_fill (w-alloc 8) 8 100)
        (begin
          (w-set b 0 999)
          (assert-equal (ct-eq-words w-arena b 8) 0))))))

(test "ct-eq-words-differ-last"
  (begin
    (let w-arena (_cts_fill (w-alloc 8) 8 100)
      (let b (_cts_fill (w-alloc 8) 8 100)
        (begin
          (w-set b 7 999)
          (assert-equal (ct-eq-words w-arena b 8) 0))))))

(test "ct-ne-words-equal"
  (begin
    (let w-arena (_cts_fill (w-alloc 4) 4 1)
      (let b (_cts_fill (w-alloc 4) 4 1)
        (assert-equal (ct-ne-words w-arena b 4) 0)))))

(test "ct-eq-words-bool"
  (begin
    (let w-arena (_cts_fill (w-alloc 4) 4 1)
      (let b (_cts_fill (w-alloc 4) 4 1)
        (assert-true (ct-eq-words-bool w-arena b 4))))))

; Erasure: after zeroize every word reads back as 0.
(test "zeroize-clears-words"
  (begin
    (let w-arena (_cts_fill (w-alloc 4) 4 7)
      (begin
        (zeroize w-arena 4)
        (assert-equal (+ (+ (w-get w-arena 0) (w-get w-arena 1)) (+ (w-get w-arena 2) (w-get w-arena 3))) 0)))))

(test "zeroize-returns-byte-count"
  (begin
    (let w-arena (w-alloc 4)
      (assert-equal (zeroize w-arena 4) 32))))

(run-tests)
