; Tail Call Regression Tests — direct calls in tail position reuse the
; caller's frame (codegen.zyl's cg-tail), so deep loops run in constant stack.

(defn tc-even (n) (if (= n 0) true (tc-odd (- n 1))))
(defn tc-odd (n) (if (= n 0) false (tc-even (- n 1))))

(defn tc-count (i acc)
  (if (>= i 50000000) acc (tc-count (+ i 1) (+ acc 2))))

(defn tc-sum6 (a b c d e f)
  (if (= a 0) (+ b (+ c (+ d (+ e f)))) (tc-sum6 (- a 1) b c d e (+ f 1))))

(defn tc-via-match (x)
  (match x
    (Some v (let w (* v 2) (tc-count 0 w)))
    (None -1)))

(defn tc-via-begin (n)
  (begin
    (let-mut k n (set! k (+ k 1)))
    (tc-count 0 n)))

(defn tc-str-loop (i s)
  (if (= i 0) s (tc-str-loop (- i 1) (str-concat s "x"))))

(test "mutual tail recursion"
  (begin
    (assert-equal (tc-even 30000000) true)
    (assert-equal (tc-odd 30000001) true)))

(test "self tail recursion"
  (assert-equal (tc-count 0 0) 100000000))

(test "six register arguments"
  (assert-equal (tc-sum6 20000000 1 2 3 4 5) 20000015))

(test "tail call from match arm and begin"
  (begin
    (assert-equal (tc-via-match (Some 3)) 100000006)
    (assert-equal (tc-via-match None) -1)
    (assert-equal (tc-via-begin 7) 100000007)))

(test "string accumulator"
  (assert-equal (tc-str-loop 3 "a") "axxx"))

(run-tests)
