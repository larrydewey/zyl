; with-resource (spec 12.9): the body runs with the resource bound, then
; (Drop.drop r) runs on the way out, normally or by an error, before the
; error propagates. An Int resource is a file descriptor (file-close).

(use core/core)

(deftype Res (Res String))

(impl Drop Res (defn drop (self) (match self (Res n (print (str-concat "drop " n))))))

(defn value-of (fail)
  (with-resource (r (Res "a"))
    (begin
      (print "body a")
      (if fail (error "boom") 7))))

(test "wr-value" (assert-equal (value-of false) 7))

(test "wr-drop-before-error"
  (assert-equal (try (value-of true) (catch e (if (str-eq e "boom") -1 0))) -1))

(test "wr-nested-order"
  (assert-equal
    (with-resource (a (Res "outer"))
      (with-resource (b (Res "inner"))
        (begin (print "body") 3)))
    3))

(test "wr-file-descriptor"
  (assert-equal
    (with-resource (fd (file-open "/tmp/zyl_regression_with_resource.txt" "w"))
      (file-write fd "data"))
    4))

(run-tests)
