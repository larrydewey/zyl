; SHA-3 / SHAKE Known-Answer Tests (FIPS 202).
; The 135/136/137 lengths straddle SHA3-256's 136-byte rate, where the
; sponge has to start a new block for the padding.

(use math/hash/sha3)
(use math/words)
(use allocator/allocator)

(defn _sha3_arena () (arena-create 0))

(test "sha3-256-empty"
  (assert-equal (sha3-256-hex-of-string (_sha3_arena) "") "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a"))
(test "sha3-256-abc"
  (assert-equal (sha3-256-hex-of-string (_sha3_arena) "abc") "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532"))
(test "sha3-256-alphabet"
  (assert-equal (sha3-256-hex-of-string (_sha3_arena) "abcdefghijklmnopqrstuvwxyz") "7cab2dc765e21b241dbc1c255ce620b29f527c6d5e7f5f843e56288f0d707521"))
(test "sha3-256-len-135"
  (assert-equal (sha3-256-hex-of-string (_sha3_arena) "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") "8094bb53c44cfb1e67b7c30447f9a1c33696d2463ecc1d9c92538913392843c9"))
(test "sha3-256-len-136"
  (assert-equal (sha3-256-hex-of-string (_sha3_arena) "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") "3fc5559f14db8e453a0a3091edbd2bc25e11528d81c66fa570a4efdcc2695ee1"))
(test "sha3-256-len-137"
  (assert-equal (sha3-256-hex-of-string (_sha3_arena) "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") "f8d6846cedd2ccfadf15c5879ef95af724d799eed7391fb1c91f95344e738614"))
(test "sha3-256-len-200"
  (assert-equal (sha3-256-hex-of-string (_sha3_arena) "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") "cce34485baf2bf2aca99b94833892a4f52896d3d153f7b840cc4f9fe695f1387"))
(test "sha3-512-empty"
  (assert-equal (sha3-512-hex-of-string (_sha3_arena) "") "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26"))
(test "sha3-512-abc"
  (assert-equal (sha3-512-hex-of-string (_sha3_arena) "abc") "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0"))
(test "sha3-512-len-71"
  (assert-equal (sha3-512-hex-of-string (_sha3_arena) "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") "070faf98d2a8fddf8ed886408744dc06456096c2e045f26f3c7b010530e6bbb3db535a54d636856f4e0e1e982461cb9a7e8e57ff8895cff1619af9f0e486e28c"))
(test "sha3-512-len-72"
  (assert-equal (sha3-512-hex-of-string (_sha3_arena) "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") "a8ae722a78e10cbbc413886c02eb5b369a03f6560084aff566bd597bb7ad8c1ccd86e81296852359bf2faddb5153c0a7445722987875e74287adac21adebe952"))
(test "shake128-empty"
  (let a (_sha3_arena)
    (let msg (w-from-string a "")
      (assert-equal (w-hex-bytes (shake128-bytes a msg 0 32) 32) "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26"))))
(test "shake128-abc"
  (let a (_sha3_arena)
    (let msg (w-from-string a "abc")
      (assert-equal (w-hex-bytes (shake128-bytes a msg 3 32) 32) "5881092dd818bf5cf8a3ddb793fbcba74097d5c526a6d35f97b83351940f2cc8"))))
(test "shake128-abc-long"
  (let a (_sha3_arena)
    (let msg (w-from-string a "abc")
      (assert-equal (w-hex-bytes (shake128-bytes a msg 3 64) 64) "5881092dd818bf5cf8a3ddb793fbcba74097d5c526a6d35f97b83351940f2cc844c50af32acd3f2cdd066568706f509bc1bdde58295dae3f891a9a0fca578378"))))
(test "shake256-empty"
  (let a (_sha3_arena)
    (let msg (w-from-string a "")
      (assert-equal (w-hex-bytes (shake256-bytes a msg 0 64) 64) "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762fd75dc4ddd8c0f200cb05019d67b592f6fc821c49479ab48640292eacb3b7c4be"))))
(test "shake256-abc"
  (let a (_sha3_arena)
    (let msg (w-from-string a "abc")
      (assert-equal (w-hex-bytes (shake256-bytes a msg 3 32) 32) "483366601360a8771c6863080cc4114d8db44530f8f1e1ee4f94ea37e78b5739"))))
(test "shake128-multi-block-squeeze"
  (let a (_sha3_arena)
    (let msg (w-from-string a "abc")
      (assert-equal (w-hex-bytes (shake128-bytes a msg 3 200) 200) ""))))

(test "keccak-padded-len-exact-rate"
  (assert-equal (keccak-padded-len 136 136) 272))
(test "keccak-padded-len-empty"
  (assert-equal (keccak-padded-len 0 136) 136))

(run-tests)
