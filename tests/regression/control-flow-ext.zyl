; Extended Control Flow Regression Tests — nested loops, else-arms, multi init, breaks.
; Multi-statement loop bodies require an explicit (begin ...) — a raw single
; expression is the only implicit body form.

(use core/core)

; while with a compound condition and begin body.
(
  test
  "while-compound"
  (
    let-mut
    _cfe_i
    0
    (
      let-mut
      _cfe_acc
      0
      (
        begin
        (
          while
          (
            and
            (
              <
              _cfe_i
              10
            )
            (
              <
              _cfe_acc
              25
            )
          )
          (
            begin
            (
              set!
              _cfe_acc
              (
                +
                _cfe_acc
                5
              )
            )
            (
              set!
              _cfe_i
              (
                +
                _cfe_i
                1
              )
            )
          )
        )
        _cfe_acc
      )
    )
    (
      assert-equal
      _cfe_acc
      25
    )
  )
)

; for with a begin body doing an increment.
(
  test
  "for-begin-body"
  (
    let-mut
    _cfe_acc
    0
    (
      begin
      (
        for
        (i 0)
        (
          <
          i
          5
        )
        (
          begin
          (
            set!
            _cfe_acc
            (
              +
              _cfe_acc
              i
            )
          )
          (
            set!
            i
            (
              +
              i
              1
            )
          )
        )
      )
      _cfe_acc
    )
    (
      assert-equal
      _cfe_acc
      10
    )
  )
)

; for with two loop variables using multi-binding syntax.
(
  test
  "for-multi-init"
  (
    let-mut
    _cfe_acc
    0
    (
      for
      ((i 0) (j 10))
      (
        <
        i
        3
      )
      (
        begin
        (
          set!
          _cfe_acc
          (
            +
            _cfe_acc
            i
            j
          )
        )
        (
          set!
          i
          (
            +
            i
            1
          )
        )
        (
          set!
          j
          (
            +
            j
            1
          )
        )
      )
    )
    (
      assert-equal
      _cfe_acc
      36
    )
  )
)

; cond with an else fallback.
(
  test
  "cond-else"
  (
    assert-equal
    (
      cond
      (
        false 1
      )
      (
        false 2
      )
      (
        else 3
      )
    )
    3
  )
)

; nested loops: sum of a grid.
(
  test
  "nested-loops"
  (
    let-mut
    _cfe_sum
    0
    (
      let-mut
      i
      0
      (
        let-mut
        j
        0
        (
          begin
          (
            while
            (
              <
              i
              3
            )
            (
              begin
              (
                set!
                j
                0
              )
              (
                while
                (
                  <
                  j
                  3
                )
                (
                  begin
                  (
                    set!
                    _cfe_sum
                    (
                      +
                      _cfe_sum
                      i
                      j
                    )
                  )
                  (
                    set!
                    j
                    (
                      +
                      j
                      1
                    )
                  )
                )
              )
              (
                set!
                i
                (
                  +
                  i
                  1
                )
              )
            )
          )
          _cfe_sum
        )
      )
    )
    (
      assert-equal
      _cfe_sum
      18
    )
  )
)

(run-tests)