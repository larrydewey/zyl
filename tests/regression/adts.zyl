; ADT Regression Tests — deftype, match, exhaustiveness, recursive ADTs

; Simple ADT
(deftype _ad_Option (AdSome Int) AdNone)

; ADT construction
(test "adt-some"
  (assert-true (match (AdSome 42)
    (AdSome v v)
    (AdNone 0))))

; ADT with no fields
(deftype _ad_Status (Active) (Inactive))
(test "adt-no-field-variant"
  (assert-true (match Active
    (Active true)
    (Inactive false))))

; Recursive ADT
(deftype _ad_List (AdCons Int _ad_List) AdNil)

(test "adt-list-cons"
  (assert-true true))

; ADT with String field
(deftype _ad_Atom (A-Ident String) (A-Int Int) (A-Bool Bool))
(test "adt-ident"
  (assert-equal (match (A-Ident "hello")
    (A-Ident s 0)
    (A-Int 1)
    (A-Bool 2)) 0))
(test "adt-int"
  (assert-equal (match (A-Int 42)
    (A-Ident 0)
    (A-Int n n)
    (A-Bool 1)) 42))
(test "adt-bool"
  (assert-true (match (A-Bool true)
    (A-Ident false)
    (A-Int false)
    (A-Bool b b))))

; ADT with multiple variants and different field types
; (arm results must be type-homogeneous: 0 / (* n 2) / 0)
(test "adt-mixed-variants"
  (assert-equal (match (A-Int 99)
    (A-Ident _ 0)
    (A-Int n (* n 2))
    (A-Bool _ 0)) 198))

; Nested ADT construction
(deftype _ad_Box (Boxed _ad_Atom))

(test "adt-nested"
  (assert-equal (match (Boxed (A-Int 7))
    (Boxed a (match a (A-Int n n) (_ 0)))) 7))

(run-tests)
