; Secret types and impl-not — the accepting side.
;
; A `Secret` field, a field of a type implementing the Secret trait, and a
; type named by (impl-not Show X) are redacted by print: `<secret>` or
; `<hidden>`. Destructuring a record with one match arm is not a branch, a
; wrapper may show its public fields, and `wipe` is callable directly.

(defstruct StLogin (user String) (pw Secret))
(derive StLogin Show)

(deftype StKey (StKeyW Int))
(impl Secret StKey (defn wipe (self) 0))

(defstruct StVault (label String) (k StKey))
(derive StVault Show)

(defstruct StHandle (fd Int))
(impl-not Show StHandle)

(defstruct StConn (host String) (h StHandle))
(derive StConn Show)

(trait StLabel (label (self) String))
(impl StLabel StVault (defn label (self) self.label))

(defn st-key-word ((k StKey)) (match k (StKeyW w (+ w 1))))

(test "redacted-print"
  (begin
    (print (make-StLogin "ann" 1234))
    (print (make-StVault "main" (StKeyW 7)))
    (print (make-StConn "db" (make-StHandle 3)))
    (print (make-StHandle 4))
    0))

(test "public-parts-stay-usable"
  (let v (make-StVault "main" (StKeyW 7))
    (begin
      (assert-true (str-eq (v.label) "main"))
      (assert-true (let l (make-StLogin "ann" 1) (str-eq l.user "ann")))
      (assert-equal (let c (make-StConn "db" (make-StHandle 3)) c.h.fd) 3))))

(test "single-arm-destructure-and-wipe"
  (begin
    (let _w (st-key-word (StKeyW 4)) 0)
    (assert-equal ((StKeyW 1).wipe) 0)))

(run-tests)
