; Partial operations are spelled (docs/soundness.md): every `name!` stops the
; program on the input it cannot serve, with a message that names the index
; and the bound and points at `name?`; every `name?` returns None there and
; Some everywhere else. One test per pair, plus the two `expect!` forms.

(use core/core)
(use core/option)
(use core/result)
(use collections/vec)
(use collections/slice)
(use text/view)
(use simd/simd)

(defn v3 () (vec-push (vec-push (vec-push (vec-new-cap 4) 10) 20) 30))

; The caught message, or "" when nothing stopped.
(defn stops-with (thunk) (try (let _ (thunk) "") (catch e e)))

(defn starts (s p) (view-starts-with (view-of s) p))

(test "vec-get! in range, vec-get? Some"
  (begin
    (assert-equal (vec-get! (v3) 2) 30)
    (assert-equal (match (vec-get? (v3) 2) (Some x x) (None -1)) 30)
    (assert-equal (match (vec-get? (v3) 3) (Some x x) (None -1)) -1)
    (assert-equal (match (vec-get? (v3) -1) (Some x x) (None -1)) -1)))

(test "vec-get! out of range names the index and the length"
  (assert-true (starts (stops-with (fn () (vec-get! (v3) 7)))
                       "E_INDEX_OUT_OF_BOUNDS: vec-get! index 7 is outside a Vec of 3 elements")))

(test "vec-set! writes, appends at len, stops past it"
  (begin
    (assert-equal (vec-get! (vec-set! (v3) 1 99) 1) 99)
    (assert-equal (vec-len (vec-set! (v3) 3 40)) 4)
    (assert-equal (vec-get! (vec-set! (v3) 3 40) 3) 40)
    (assert-true (starts (stops-with (fn () (vec-set! (v3) 4 1)))
                         "E_INDEX_OUT_OF_BOUNDS: vec-set! index 4 is outside a Vec of 3 elements"))
    (assert-true (starts (stops-with (fn () (vec-set! (v3) -1 1))) "E_INDEX_OUT_OF_BOUNDS: vec-set! index -1"))))

(test "vec-set? is Some in range and at len, None past it"
  (begin
    (assert-equal (match (vec-set? (v3) 0 5) (Some w (vec-get! w 0)) (None -1)) 5)
    (assert-equal (match (vec-set? (v3) 3 5) (Some w (vec-len w)) (None -1)) 4)
    (assert-equal (match (vec-set? (v3) 4 5) (Some w (vec-len w)) (None -1)) -1)))

(test "vec-set! at len grows a full Vec"
  (let v (vec-push (vec-new-cap 1) 1)
    (assert-equal (vec-get! (vec-set! v 1 2) 1) 2)))

(test "vec-last! and vec-last?"
  (begin
    (assert-equal (vec-last! (v3)) 30)
    (assert-equal (match (vec-last? (v3)) (Some x x) (None -1)) 30)
    (assert-equal (match (vec-last? (vec-new)) (Some x x) (None -1)) -1)
    (assert-true (starts (stops-with (fn () (vec-last! (vec-new)))) "E_INDEX_OUT_OF_BOUNDS: vec-last! of an empty Vec"))))

(test "slice-vec! and slice-vec?"
  (begin
    (assert-equal (slice-len (slice-vec! (v3) 1 2)) 2)
    (assert-equal (match (slice-vec? (v3) 1 2) (Some s (slice-get! s 1)) (None -1)) 30)
    (assert-equal (match (slice-vec? (v3) 2 2) (Some s (slice-len s)) (None -1)) -1)
    (assert-true (starts (stops-with (fn () (slice-vec! (v3) 2 2)))
                         "E_INDEX_OUT_OF_BOUNDS: slice-vec! range 2..4 is outside a Vec of 3 elements"))))

(test "slice-sub! and slice-sub?"
  (let s (slice-vec! (v3) 0 3)
    (begin
      (assert-equal (slice-get! (slice-sub! s 1 2) 0) 20)
      (assert-equal (match (slice-sub? s 1 2) (Some t (slice-len t)) (None -1)) 2)
      (assert-equal (match (slice-sub? s 1 3) (Some t (slice-len t)) (None -1)) -1)
      (assert-true (starts (stops-with (fn () (slice-sub! s 1 3)))
                           "E_INDEX_OUT_OF_BOUNDS: slice-sub! range 1..4 is outside a slice of 3 elements")))))

(test "slice-get! and slice-get?"
  (let s (slice-vec! (v3) 1 2)
    (begin
      (assert-equal (slice-get! s 0) 20)
      (assert-equal (match (slice-get? s 1) (Some x x) (None -1)) 30)
      (assert-equal (match (slice-get? s 2) (Some x x) (None -1)) -1)
      (assert-true (starts (stops-with (fn () (slice-get! s 2)))
                           "E_INDEX_OUT_OF_BOUNDS: slice-get! index 2 is outside a slice of 2 elements")))))

(test "view-slice! and view-slice?"
  (begin
    (assert-equal (view-to-string (view-slice! "hello" 1 3)) "ell")
    (assert-equal (match (view-slice? "hello" 1 3) (Some v (view-len v)) (None -1)) 3)
    (assert-equal (match (view-slice? "hello" 3 3) (Some v (view-len v)) (None -1)) -1)
    (assert-true (starts (stops-with (fn () (view-slice! "hello" 3 3)))
                         "E_INDEX_OUT_OF_BOUNDS: view-slice! range 3..6 is outside a string of 5 bytes"))))

(test "view-sub! and view-sub?"
  (let v (view-of "hello")
    (begin
      (assert-equal (view-to-string (view-sub! v 1 3)) "ell")
      (assert-equal (match (view-sub? v 4 1) (Some w (view-to-string w)) (None "")) "o")
      (assert-equal (match (view-sub? v 4 2) (Some w (view-to-string w)) (None "")) "")
      (assert-true (starts (stops-with (fn () (view-sub! v 4 2)))
                           "E_INDEX_OUT_OF_BOUNDS: view-sub! range 4..6 is outside a view of 5 bytes")))))

(test "i64x2 lanes"
  (let a (i64x2 1 2)
    (begin
      (assert-equal (i64x2-get! a 1) 2)
      (assert-equal (match (i64x2-get? a 1) (Some x x) (None -1)) 2)
      (assert-equal (match (i64x2-get? a 2) (Some x x) (None -1)) -1)
      (assert-equal (i64x2-get! (i64x2-set! a 0 7) 0) 7)
      (assert-equal (match (i64x2-set? a 1 7) (Some w (i64x2-get! w 1)) (None -1)) 7)
      (assert-equal (match (i64x2-set? a 2 7) (Some w (i64x2-get! w 1)) (None -1)) -1)
      (assert-true (starts (stops-with (fn () (i64x2-get! a 2)))
                           "E_INDEX_OUT_OF_BOUNDS: i64x2-get! lane 2 is outside a vector of 2 lanes"))
      (assert-true (starts (stops-with (fn () (i64x2-set! a -1 0))) "E_INDEX_OUT_OF_BOUNDS: i64x2-set! lane -1")))))

(test "i32x4 lanes"
  (let a (i32x4-splat 3)
    (begin
      (assert-equal (i32x4-get! a 3) 3)
      (assert-equal (match (i32x4-get? a 3) (Some x x) (None -1)) 3)
      (assert-equal (match (i32x4-get? a 4) (Some x x) (None -1)) -1)
      (assert-equal (i32x4-get! (i32x4-set! a 2 -5) 2) -5)
      (assert-equal (match (i32x4-set? a 4 1) (Some _ 1) (None -1)) -1)
      (assert-true (starts (stops-with (fn () (i32x4-get! a 4)))
                           "E_INDEX_OUT_OF_BOUNDS: i32x4-get! lane 4 is outside a vector of 4 lanes"))
      (assert-true (starts (stops-with (fn () (i32x4-set! a 4 1))) "E_INDEX_OUT_OF_BOUNDS: i32x4-set! lane 4")))))

(test "u8x16 lanes"
  (let a (u8x16-splat 9)
    (begin
      (assert-equal (u8x16-get! a 15) 9)
      (assert-equal (match (u8x16-get? a 15) (Some x x) (None -1)) 9)
      (assert-equal (match (u8x16-get? a 16) (Some x x) (None -1)) -1)
      (assert-equal (u8x16-get! (u8x16-set! a 5 200) 5) 200)
      (assert-equal (match (u8x16-set? a 16 1) (Some _ 1) (None -1)) -1)
      (assert-true (starts (stops-with (fn () (u8x16-get! a 16)))
                           "E_INDEX_OUT_OF_BOUNDS: u8x16-get! lane 16 is outside a vector of 16 lanes"))
      (assert-true (starts (stops-with (fn () (u8x16-set! a 16 1))) "E_INDEX_OUT_OF_BOUNDS: u8x16-set! lane 16")))))

(test "option-expect! and result-expect!"
  (begin
    (assert-equal (option-expect! (Some 4) "no value") 4)
    (assert-equal (stops-with (fn () (option-expect! None "no value"))) "no value")
    (assert-equal (result-expect! (Ok 5) "no value") 5)
    (assert-equal (stops-with (fn () (result-expect! (Err "bad") "no value"))) "no value")))

(run-tests)
