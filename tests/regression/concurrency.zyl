(capabilities actor)

(use actor/actor)
(use atomic/atomic)
; Concurrency Regression Tests: spawn, join, AtomicBuf across actors

; Spawn basic
(test "spawn-basic"
  (let actor (spawn (fn () 0))
    (assert-true (actor-is-alive actor))))

; Spawn and wait
(test "spawn-wait"
  (let actor (spawn (fn () 0))
    (actor-wait actor)
    (assert-true true)))

; Send basic
; Actor terminate
; Actor wait
(test "actor-wait"
  (let actor (spawn (fn () 0))
    (actor-wait actor)
    (assert-true true)))

; A closure inside an actor body
(test "closure-in-actor"
  (let actor (spawn (fn () (let h (fn (msg) (+ msg 1)) (h 99))))
    (actor-wait actor)
    (assert-false (actor-is-alive actor))))

; Workers update shared AtomicBuf slots in any interleaving; only the frozen totals are read.
(defn rb-work ((b AtomicBuf) (n Int))
  (if (= n 0) unit
    (begin
      (atomicbuf-add! b 0 1)
      (atomicbuf-add! b 1 2)
      (atomicbuf-max! b 2 n)
      (atomicbuf-min! b 3 n)
      (atomicbuf-or! b 4 (shl 1 (rem! n 60)))
      (atomicbuf-and! b 5 (bit-not (shl 1 (rem! n 60))))
      (atomicbuf-xor! b 6 n)
      (atomicbuf-add! b 7 9223372036854775807)
      (atomicbuf-add! b 7 -9223372036854775807)
      (rb-work b (- n 1)))))

(test "atomicbuf-across-actors"
  (let b (atomicbuf-new 8)
    (let a1 (spawn (fn () (rb-work b 20000)))
      (let a2 (spawn (fn () (rb-work b 20000)))
        (let a3 (spawn (fn () (rb-work b 20000)))
          (begin
            (atomicbuf-add b 0 1)
            (actor-wait a1)
            (actor-wait a2)
            (actor-wait a3)
            (let v (atomicbuf-freeze! b)
              (begin
                (assert-equal (atomicview-get! v 0) 60001)
                (assert-equal (atomicview-get! v 1) 120000)
                (assert-equal (atomicview-get! v 2) 20000)
                (assert-equal (atomicview-get! v 3) 1)
                (assert-equal (atomicview-get! v 4) 1152921504606846975)
                (assert-equal (atomicview-get! v 5) -1152921504606846976)
                (assert-equal (atomicview-get! v 6) 20000)
                (assert-equal (atomicview-get! v 7) 0)))))))))

; A freeze while a holder is unjoined is E_ATOMIC_SHARED (or None), whatever the schedule.
(test "atomicbuf-freeze-waits-for-the-join"
  (let b (atomicbuf-new 1)
    (let a (spawn (fn () (atomicbuf-add b 0 5)))
      (begin
        (assert-true (atomicbuf-held b))
        (actor-wait a)
        (assert-false (atomicbuf-held b))
        (assert-equal (match (atomicbuf-freeze? b) (Some v (atomicview-get! v 0)) (None -1)) 5)))))

(test "atomicbuf-freeze-with-a-live-holder"
  (let b1 (atomicbuf-new 1)
    (let b2 (atomicbuf-new 1)
      (let a (spawn (fn () (begin (atomicbuf-add b1 0 1) (atomicbuf-add b2 0 1))))
        (begin
          (assert-equal (atomicbuf-freeze? b1) None)
          (assert-equal (try (begin (atomicbuf-freeze! b2) "no error") (catch e (str-substring e 0 15))) "E_ATOMIC_SHARED")
          (actor-wait a))))))

; Only the spawner's join releases a holder; another actor's join leaves the buffer held.
(test "atomicbuf-join-by-another-actor-releases-nothing"
  (let b (atomicbuf-new 1)
    (let h (spawn (fn () (atomicbuf-add b 0 1)))
      (let j (spawn (fn () (actor-wait h)))
        (begin
          (actor-wait j)
          (actor-wait h)
          (assert-true (atomicbuf-held b)))))))

; Holders spawned by holders count until their own spawner joins them.
(test "atomicbuf-nested-holders"
  (let b (atomicbuf-new 1)
    (let outer (spawn (fn () (let inner (spawn (fn () (atomicbuf-add b 0 2))) (begin (atomicbuf-add b 0 1) (actor-wait inner)))))
      (begin
        (actor-wait outer)
        (assert-equal (atomicview-get! (atomicbuf-freeze! b) 0) 3)))))

(run-tests)
