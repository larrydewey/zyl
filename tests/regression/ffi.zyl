; FFI Regression Tests — ffi-call, ffi-pin, ffi-unpin, timeout

; FFI pin
(use ffi/ffi)
(test "ffi-pin"
  (assert-true (> (ffi-pin-value 42) 0)))

; FFI unpin
(test "ffi-unpin"
  (assert-equal (ffi-unpin-value (ffi-pin-value 42)) 42))

; FFI safe call
(test "ffi-safe"
  (assert-equal (ffi-safe-call 99) (result-ok 99)))

; FFI pin + call
(test "ffi-pin-call"
  (assert-equal (result-unwrap (ffi-pin-call-unpin 123) 0) 123))

(run-tests)
