; C ABI regression tests: calls between C and generated code.

(capabilities ffi)

(use allocator/allocator)

(defstruct _abi_Box (v Int) (w Int))

(extern "qsort" (Ptr Int Int (Fn (Ptr Ptr) Int)) Unit)
(extern "snprintf" (Ptr Int String Int Int Int Int Int Int) Int)

; The buffer is a (bytebuf Heap N) and its address is bytebuf-ptr, not
; alloc-malloc: a program cannot obtain untracked raw memory (E_FFI_
; RESTRICTED), so this file is also the proof that the sanctioned route
; works from program source -- qsort with a callback and 9-argument
; varargs, through a buffer the region system owns.
;
; The comparator is the one place that reads through a pointer it did not
; allocate, because glibc hands it the addresses. Reading through a foreign
; pointer is inherent to FFI and stays possible; what a program may not do
; is *create* memory nothing tracks.
;
; glibc's qsort keeps its own state in callee-saved registers across the
; comparator call. Generated code uses rbx (variant construction) and r12
; (the saved rsp around every C call); functions used to clobber both
; without saving them, so qsort came back with a wrongly ordered array.
(defn _abi-cmp (pa pb)
  (let a (struct-get (make-_abi_Box (alloc-read-int pa) 0) "v")
    (let b (struct-get (make-_abi_Box (alloc-read-int pb) 0) "v")
      (if (< a b) -1 (if (> a b) 1 0)))))

(defn _abi-fill ((b ByteBuf) (i Int) (n Int))
  (if (>= i n)
    0
    (begin
      (store-i64 :le b (* i 8) (- 1000 (* (% (* i 37) 64) 3)))
      (_abi-fill b (+ i 1) n))))

(defn _abi-sorted ((b ByteBuf) (i Int) (n Int))
  (if (>= i n)
    1
    (if (> (load-i64 :le b (* (- i 1) 8)) (load-i64 :le b (* i 8)))
      0
      (_abi-sorted b (+ i 1) n))))

(defn _abi-qsort-ok ()
  (let b (bytebuf Heap 512)
    (let p (bytebuf-ptr b)
      (begin
        (_abi-fill b 0 64)
        (ffi-call "qsort" p 64 8 _abi-cmp 1000)
        (_abi-sorted b 1 64)))))

(test "c-callback-preserves-callee-saved"
  (assert-equal (_abi-qsort-ok) 1))

; A C call with more than six arguments passes the rest on the stack and
; used to get no rsp realignment. snprintf is varargs; with a nonzero al
; it spills the SSE registers with movaps, which faults on a misaligned
; stack, so these calls segfaulted at some call depths.
(defn _abi-fmt9 (buf a b c d e f)
  (ffi-call "snprintf" buf 64 "%lld-%lld-%lld-%lld-%lld-%lld" a b c d e f 1000))

(defn _abi-deep (buf k)
  (if (= k 0) (_abi-fmt9 buf 1 2 3 4 5 6) (+ 0 (_abi-deep buf (- k 1)))))

(defn _abi-buf () (bytebuf-ptr (bytebuf Heap 64)))

(test "c-call-arity-9-depth-0"
  (assert-equal (_abi-deep (_abi-buf) 0) 11))
(test "c-call-arity-9-depth-1"
  (assert-equal (_abi-deep (_abi-buf) 1) 11))
(test "c-call-arity-9-depth-2"
  (let buf (_abi-buf)
    (begin
      (_abi-deep buf 2)
      (assert-equal (str-length (alloc-cstr buf)) 11))))

(run-tests)
