; Secret capability (TCSecret) / constant-time checker — accepting side.
;
; compiler/secret_check.zyl rejects a program that lets a Secret steer
; control flow, address memory, divide, print, escape, or cross the FFI
; boundary unpinned. Those rejections are the tests/compile-fail/secret-
; *.zyl files. THIS file is the other half: every shape below carries a
; real `Secret`-annotated parameter and must still compile and produce
; the right value, so that the checker is proven not to reject ordinary
; constant-time code.
;
; Each test therefore exercises one accepted pattern:
;   - branchless arithmetic and masking on a secret
;   - a public loop bound with a public index over secret DATA
;   - `if` on a public value whose ARMS are secret (ct-select's shape)
;   - declassification, explicit (declassify) and by name (ct-eq-bool)
;   - a pinned FFI handover
;   - explicit erasure, which also silences E_ZEROIZE_MISSING

(use math/secret/secret)
(use math/words)
(use allocator/allocator)

; --- branchless arithmetic on a secret --------------------------------------

(defn _sec_mix ((k Secret) (pub Int))
  (bit-xor (bit-and k pub) (shl pub 1)))

(test "secret-arithmetic-is-allowed"
  (assert-equal (_sec_mix 12 5) (bit-xor (bit-and 12 5) 10)))

; --- public condition, secret arms (what ct-select is) -----------------------

(defn _sec_select-public ((k Secret) (other Secret) (pub Int))
  (if (> pub 0) k other))

(test "public-branch-with-secret-arms-is-allowed"
  (assert-equal (_sec_select-public 9 4 1) 9))

; --- constant-time comparison, declassified by name --------------------------

(defn _sec_tag-ok ((tag Secret) (expected Secret))
  (ct-eq-bool tag expected))

(test "ct-eq-bool-declassifies-the-verdict"
  (assert-true (_sec_tag-ok 4242 4242)))

(test "ct-eq-bool-rejects-a-wrong-tag"
  (assert-false (_sec_tag-ok 4242 4243)))

; --- explicit declassification ----------------------------------------------

(defn _sec_public-verdict ((k Secret) (guess Int))
  (declassify (ct-eq k guess)))

(test "declassify-turns-a-secret-derived-bit-public"
  (assert-equal (_sec_public-verdict 77 77) 1))

(test "declassify-result-may-steer-control-flow"
  (if (= (_sec_public-verdict 77 78) 1)
    (assert-fail "a wrong guess must not compare equal")
    (assert-equal 1 1)))

; --- public index over secret data, plus erasure -----------------------------
;
; The loop bound and the index are public (a key length); only the words
; read are secret. That is the pattern every hash and cipher in
; stdlib/math uses, and it must keep compiling.

(defn _sec_fold-words ((base Secret) (n Int))
  (let-mut acc 0
    (begin
      (for (i 0) (< i n)
        (begin
          (set! acc (bit-xor acc (w-get base i)))
          (set! i (+ i 1))))
      (zeroize base n)
      (declassify acc))))

(test "public-index-over-secret-words-is-allowed"
  (let ar (arena-create 0)
    (let a (w-alloc ar 3)
      (begin
        (w-set a 0 5)
        (w-set a 1 6)
        (w-set a 2 0)
        (assert-equal (_sec_fold-words a 3) 3)))))

(test "fold-erases-the-buffer-it-was-given"
  (let ar (arena-create 0)
    (let a (w-alloc ar 2)
      (begin
        (w-set a 0 9)
        (w-set a 1 9)
        (_sec_fold-words a 2)
        (assert-equal (+ (w-get a 0) (w-get a 1)) 0)))))

; --- pinned FFI handover ------------------------------------------------------
;
; A Secret may cross the FFI boundary, but only through ffi-pin (the Pin
; region, which zyl_pin_alloc mlocks). Raw is E_FFI_PIN_REQUIRED.

(defn _sec_pinned-roundtrip ((k Secret))
  (let p (ffi-pin k)
    (let d1 (ffi-unpin p)
      (begin
        (zeroize-bytes 0 0)
        (declassify 1)))))

(test "pinned-ffi-handover-is-allowed"
  (assert-equal (_sec_pinned-roundtrip 31337) 1))

(run-tests)
