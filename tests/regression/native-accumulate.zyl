; Native backend: accumulator tails, loop rotation, coalesced moves, view bytes.

(deftype T (Lf) (Nd T T))

(defn fib ((n Int)) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(defn fact ((n Int)) (if (= n 0) 1 (* n (fact (- n 1)))))
(defn xsum ((n Int)) (if (= n 0) 0 (bit-xor (* n 3) (xsum (- n 1)))))
(defn band ((n Int)) (if (= n 0) -1 (bit-and (+ n 255) (band (- n 1)))))
(defn mk ((d Int)) (if (= d 0) (Lf) (Nd (mk (- d 1)) (mk (- d 1)))))
(defn cnt ((t T)) (match t (Lf 1) (Nd l r (+ 1 (+ (cnt l) (cnt r))))))
; mixed tails: an accumulating one, a plain return and a self call
(defn mix ((n Int) (k Int))
  (if (<= n 0) k (if (= (% n 3) 0) (mix (- n 1) (+ k 1)) (+ n (mix (- n 2) k)))))
; wrapping stays exact under reassociation
(defn big ((n Int)) (if (= n 0) 0 (+ 4611686018427387904 (big (- n 1)))))
(defn swp ((a Int) (b Int) (n Int)) (if (= n 0) (- a b) (swp b a (- n 1))))
(defn marks ((b ByteBuf) (j Int) (s Int) (n Int))
  (if (>= j n) 0 (begin (store-u8 :le b j 7) (marks b (+ j s) s n))))
(defn bsum ((b ByteBuf) (i Int) (n Int) (acc Int))
  (if (>= i n) acc (bsum b (+ i 1) n (+ acc (load-u8 :le b i)))))

(test "accumulate"
  (begin
    (assert-equal (fib 25) 75025)
    (assert-equal (fact 20) 2432902008176640000)
    (assert-equal (fact 21) -4249290049419214848)
    (assert-equal (xsum 1000) 2000)
    (assert-equal (band 3) 256)
    (assert-equal (cnt (mk 10)) 2047)
    (assert-equal (mix 50 0) 458)
    (assert-equal (big 5) 4611686018427387904)
    (assert-equal (swp 3 10 5) 7)))

(test "view-bytes"
  (let b (bytebuf Heap 64)
    (begin
      (assert-equal (marks b 1 3 64) 0)
      (assert-equal (bsum b 0 64 0) 147)
      (assert-equal (bsum b 60 70 0) 7))))

(run-tests)
