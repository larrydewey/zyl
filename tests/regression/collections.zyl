; Collections Regression Tests — Vec, Map, Set, StringBuffer, allocator

(use allocator/allocator)
(use collections/collections)
(use collections/vec)

; Vec basic operations
(test "vec-create"
  (assert-equal (vec-len (vec-new-cap 10)) 0))
(test "vec-len"
  (assert-equal (vec-len (vec-new-cap 10)) 0))
(test "vec-cap"
  (assert-equal (vec-cap (vec-new-cap 10)) 10))
(test "vec-set!"
  (assert-equal (vec-get! (vec-set! (vec-new-cap 10) 0 42) 0) 42))
(test "vec-get-oob"
  (assert-equal (vec-get-or (vec-new-cap 10) 99 -1) -1))
(test "vec-push"
  (assert-equal (vec-len (vec-push (vec-new-cap 10) 1)) 1))
(test "vec-push-2"
  (assert-equal (vec-len (vec-push (vec-push (vec-new-cap 10) 1) 2)) 2))
(test "vec-pop"
  (assert-equal (vec-len (vec-pop (vec-push (vec-new-cap 10) 42))) 0))
(test "vec-pop-empty"
  (assert-equal (vec-len (vec-pop (vec-new-cap 10))) 0))

; Map basic operations
(test "intmap-new"
  (assert-equal (intmap-len (intmap-new 10)) 0))
(test "intmap-len"
  (assert-equal (intmap-len (intmap-new 10)) 0))
(test "intmap-put"
  (assert-equal (intmap-len (intmap-put (intmap-new 10) 1 42)) 1))
(test "intmap-get"
  (assert-equal (intmap-get (intmap-put (intmap-new 10) 1 42) 1 0) 42))
(test "map-get-miss"
  (assert-equal (intmap-get (intmap-new 10) 99 0) 0))
(test "map-has-y"
  (assert-true (intmap-has (intmap-put (intmap-new 10) 1 42) 1)))
(test "map-has-n"
  (assert-false (intmap-has (intmap-new 10) 99)))
(test "intmap-remove"
  (assert-equal (intmap-len (intmap-remove (intmap-put (intmap-new 10) 1 42) 1)) 0))
; intmap-remove used to allocate new-len slots but keep the old cap, so the
; puts that followed wrote past the new arrays and corrupted other keys.
(test "map-remove-then-put"
  (let m (intmap-put (intmap-put (intmap-put (intmap-remove (intmap-put (intmap-put (intmap-new 4) 1 10) 2 20) 2) 3 30) 4 40) 5 50)
    (begin
      (assert-equal (intmap-get m 1 0) 10)
      (assert-equal (intmap-get m 3 0) 30)
      (assert-equal (intmap-get m 4 0) 40)
      (assert-equal (intmap-get m 5 0) 50)
      (assert-false (intmap-has m 2))
      (assert-equal (intmap-len m) 4))))
(test "map-remove-to-empty-then-put"
  (let m (intmap-put (intmap-put (intmap-remove (intmap-put (intmap-new 1) 7 70) 7) 8 80) 9 90)
    (begin
      (assert-equal (intmap-get m 8 0) 80)
      (assert-equal (intmap-get m 9 0) 90)
      (assert-equal (intmap-len m) 2))))
; intmap-put used to look for an existing key only in slot 0, so overwriting
; any other key appended a duplicate entry.
(test "map-put-overwrite-not-first"
  (let m (intmap-put (intmap-put (intmap-put (intmap-new 4) 1 10) 2 20) 2 99)
    (begin
      (assert-equal (intmap-len m) 2)
      (assert-equal (intmap-get m 2 0) 99)
      (assert-equal (intmap-len (intmap-remove m 2)) 1)
      (assert-false (intmap-has (intmap-remove m 2) 2)))))
(test "map-put-zero-key-empty"
  (assert-equal (intmap-len (intmap-put (intmap-new 4) 0 5)) 1))

; Set basic operations
(test "set-create"
  (assert-equal (set-len (set-create 10)) 0))
(test "set-len"
  (assert-equal (set-len (set-create 10)) 0))
(test "set-add"
  (assert-equal (set-len (set-add (set-create 10) 42)) 1))
(test "set-add-dup"
  (assert-equal (set-len (set-add (set-add (set-create 10) 42) 42)) 1))
(test "set-has-y"
  (assert-true (set-contains (set-add (set-create 10) 42) 42)))
(test "set-has-n"
  (assert-false (set-contains (set-create 10) 42)))
(test "set-remove"
  (assert-equal (set-len (set-remove (set-add (set-create 10) 42) 42)) 0))

; Allocator operations
(test "alloc-malloc"
  (let p (alloc-malloc 64)
    (begin (alloc-free p) (assert-true true))))
(test "alloc-write-int"
  (let p (alloc-malloc 64)
    (begin
      (alloc-write-int p 42)
      (assert-true true))))
(test "alloc-strlen"
  (assert-equal (alloc-strlen "hello") 5))

; buf-append
(test "buf-append"
  (let b (buf-new (arena-create 4096) 64)
    (begin
      (buf-append b "hello")
      (assert-equal (str-length (buf-str b)) 5)
      0)))

; A capacity of 0 or below is fine: the first push allocates room.
(test "collections-accept-zero-and-negative-capacity"
  (let v (vec-new)
    (begin
      (assert-equal (vec-get! (vec-push v 5) 0) 5)
      (assert-equal (vec-get! (vec-push (vec-new-cap -3) 7) 0) 7)
      (assert-equal (vec-len (vec-push (vec-push (vec-new-cap -1) 1) 2)) 2)
      0)))

; Generational arena handles: a destroyed arena's handle is reused under a
; new generation, so the old value is stale -- a second destroy is a no-op
; and it is not live -- and the new value is.
(test "arena-generations"
  (let a (arena-create 4096)
    (begin
      (arena-alloc a 64)
      (arena-destroy a)
      (assert-false (ffi-call "zyl_arena_live" a 1000))
      (arena-destroy a)
      (let b (arena-create 4096)
        (begin
          (assert-true (ffi-call "zyl_arena_live" b 1000))
          (assert-false (= a b))
          (arena-destroy a)
          (assert-true (ffi-call "zyl_arena_live" b 1000))
          (assert-equal (arena-used b) 0)
          (arena-alloc b 32)
          (assert-equal (arena-used b) 32)
          (arena-destroy b)
          0)))))

; Allocating through a destroyed arena stops the program; it never reaches
; memory the arena gave back.
(test "arena-use-after-destroy"
  (let a (arena-create 4096)
    (begin
      (arena-destroy a)
      (assert-equal (try (begin (arena-alloc a 8) 0) (catch e (if (ffi-call "zyl_err_is" e "E_USE_AFTER_FREE" 1000) 1 2))) 1)
      0)))

(run-tests)
