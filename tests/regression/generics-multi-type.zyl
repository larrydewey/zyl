; Generic ADT multi-instance regression — a generic ADT must be usable with
; ANY concrete type, with distinct instances coexisting in one program.
; Guards the 2026-08-25 rewrite: positional instantiation records, per-site
; polymorphic call inference, record merging for multi-param ADTs.

(deftype _g_Opt (GoSome T) (GoNone))

(defn _g-opt-int (o)
  (match o
    (GoSome v v)
    (GoNone 0)))

(defn _g-opt-tag (o)
  (match o
    (GoSome s 1)
    (GoNone 0)))

(defn main ()
  (begin
    ; Opt used with Int and String in the same program — the instances
    ; must not poison each other (the old first-site monomorphization bug:
    ; whichever site inferred first fixed the shared scheme for all sites).
    (print (_g-opt-int (GoSome 42)))
    (print (_g-opt-tag (GoSome "hi")))
    0))
