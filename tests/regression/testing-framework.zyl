; Testing framework (spec 20.5): test, the assertions, test-suite with
; setup and teardown, test-property and test-compile.

(use core/core)

(test "tf-basic" (assert-equal (+ 2 2) 4))

(test "tf-assert-bool"
  (begin
    (assert-true (> 5 3))
    (assert-false (< 10 1))))

(test "tf-assert-fail" (assert-fail (error "expected")))

(test "tf-assert-fail-message" (assert-fail (unwrap None) "unwrap of None raises"))

; setup runs before and teardown after each test, outer suite first.
(test-suite "suite"
  (setup (print "setup outer"))
  (teardown (print "teardown outer"))
  (test "one" (assert-equal 1 1))
  (test-suite "inner"
    (setup (print "setup inner"))
    (teardown (print "teardown inner"))
    (test "two" (assert-equal 2 2)))
  (test-property "commutes" gen-int (fn (a b) (= (+ a b) (+ b a)))))

(test-property "int-identity" gen-int (fn (x) (= (- (+ x 1) 1) x)))
(test-property "bool-excluded-middle" gen-bool (fn (b) (or b (not b))))
(test-property "string-concat-length" gen-string
  (fn (s t) (= (str-length (str-concat s t)) (+ (str-length s) (str-length t)))))
(test-property "float-add-zero" gen-float (fn (x) (= (+ x 0.0) x)))
(test-property "int-assoc" gen-int (fn (a b c) (= (+ (+ a b) c) (+ a (+ b c)))))

(test-compile (+ 1 2))
(test-compile (+ 1 "a") (:expect-error true))
(test-compile (let-mut x 1 (set! x 2)))

; --- expect-panic (spec 20.5.2): the body must raise; returning normally
; fails. Uses assert-true, which panics via zyl_panic.
(test "expect-panic-body-raises" (assert-true false) (:expect-panic true))

(test-suite "expect-panic-suite"
  (test "carries-the-option" (assert-true false) (:expect-panic true)))

; The option survives a multi-form body and a second option form.
(test "begin-body" (begin (assert-equal 1 1) (assert-true false)) (:expect-panic true))
(test "repeated-option" (assert-true false) (:expect-panic true) (:expect-panic true))

; :expect-panic false is the default: the body must still not raise.
(test "expect-panic-false" (assert-equal 1 1) (:expect-panic false))

(run-tests)
