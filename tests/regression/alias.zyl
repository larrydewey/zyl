; Alias Regression Tests — transparent type wrappers
; Spec §10, §113-115, §21.12

(use core/core)
(use collections/collections)
(use collections/vec)
(use collections/intmap)

; Alias with struct field (transparent)
(defstruct _al_User (id Int) (name String))

(test "alias-struct-field-transparent"
  (let u (make-_al_User 1 "charlie")
    (assert-equal (struct-get u "id") 1)
    (assert-true (str-equal (struct-get u "name") "charlie"))))

; Alias for function param documentation (aliases are transparent)
(alias _al_Port Int)
(alias _al_FD Int)

(test "alias-multiple-same-base-transparent"
  (let p 8080
    (let f 3
      (assert-equal (+ p f) 8083))))

; Alias in collections - using actual vec API (vec-create + vec-push)
(test "alias-in-vec"
  (let v (vec-push (vec-push (vec-push (vec-new-cap 10) 1) 2) 3)
    (assert-equal (vec-len v) 3)
    (assert-equal (vec-get! v 0) 1)
    (assert-equal (vec-get! v 1) 2)
    (assert-equal (vec-get! v 2) 3)))

(test "alias-in-map"
  (let m (intmap-new 10)
    (let m1 (intmap-put m 42 999)
      (assert-equal (intmap-get m1 42 0) 999))))

; Alias with pattern matching
(deftype _al_Option (AlSome Int) AlNone)

(test "alias-in-match"
  (assert-equal
    (match (AlSome 123)
      (AlSome x x)
      (AlNone 0))
    123))

; Alias with type predicates - using is-zero as example
(test "alias-type-predicates"
  (begin
    (assert-true (is-zero 0))
    (assert-false (is-zero 42))))

; Alias with let-mut
(test "alias-let-mut"
  (let-mut x 1
    (set! x 2)
    (assert-equal x 2)))

; An alias is transparent: an annotation naming it takes exactly its target.
(alias _al_Meters Int)
(alias _al_Names (List String))
(alias _al_Len _al_Meters)
(defn _al_double ((m _al_Meters)) (* m 2))
(defn _al_first ((ns _al_Names)) (match ns (Cons h _ h) (Nil "")))
(defn _al_grow ((n _al_Len)) (+ n 1))
(deftype _al_Box (AlBox _al_Meters))

(test "alias-annotation-is-its-target" (assert-equal (_al_double 21) 42))
(test "alias-compound-target" (assert-equal (_al_first ["a" "b"]) "a"))
(test "alias-of-alias" (assert-equal (_al_grow 1) 2))
(test "alias-field-type" (assert-equal (match (AlBox 3) (AlBox m (+ m 1))) 4))

(run-tests)