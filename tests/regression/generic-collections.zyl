; Generic Collections Regression Tests — Vec<T>, Map<K,V> and generic ADTs
; holding Strings, Floats and ADTs (spec §4.2, §6.3, §6.5).
;
; Values read back out of a container used to reach codegen as plain
; words: a String printed as its address and compared by address. The
; type-annotation pass now carries the element type to each use.

(use collections/vec)
(use core/map)
(use core/option)

(deftype GcVal (GcInt Int) (GcStr String) (GcList (Vec GcVal)))

(defn gc-joined (a b) (str-concat a b))

; --- Vec -------------------------------------------------------------------

(test "vec-of-strings-compares-by-content"
  (let v (vec-push (vec-push (vec-create-default 4) (gc-joined "he" "llo")) "world")
    (begin
      (assert-equal (vec-get v 0) "hello")
      (assert-equal (vec-get v 1) "world")
      (assert-equal (vec-len v) 2))))

(test "vec-of-strings-last-and-set"
  (let v (vec-set (vec-push (vec-create-default 4) "a") 0 (gc-joined "b" "c"))
    (assert-equal (vec-last v) "bc")))

(test "vec-of-floats-does-float-arithmetic"
  (let v (vec-push (vec-push (vec-create-default 4) 1.5) 2.25)
    (assert-equal (+ (vec-get v 0) (vec-get v 1)) 3.75)))

(test "vec-of-ints-still-works"
  (let v (vec-push (vec-push (vec-create-default 4) 3) 4)
    (assert-equal (* (vec-get v 0) (vec-get v 1)) 12)))

(defn gc-first (v) (vec-get v 0))

(test "generic-helper-over-vec-of-strings"
  (assert-equal (gc-first (vec-push (vec-create-default 1) (gc-joined "x" "y"))) "xy"))

; --- ADTs ------------------------------------------------------------------

(defn gc-text (v)
  (match v
    (GcInt _ "int")
    (GcStr s s)
    (GcList _ "list")))

(test "adt-string-field-compares-by-content"
  (assert-equal (gc-text (GcStr (gc-joined "ab" "c"))) "abc"))

(test "vec-of-adts"
  (let v (vec-push (vec-push (vec-create-default 2) (GcStr "s")) (GcInt 1))
    (begin
      (assert-equal (gc-text (vec-get v 0)) "s")
      (assert-equal (gc-text (vec-get v 1)) "int"))))

(test "nested-vec-in-adt"
  (let inner (vec-push (vec-create-default 1) (GcStr (gc-joined "de" "ep")))
    (match (GcList inner)
      (GcList xs (assert-equal (gc-text (vec-get xs 0)) "deep"))
      (_ (assert-equal 0 1)))))

; --- Map -------------------------------------------------------------------

(test "map-string-to-adt"
  (let m (map-insert (map-insert (map-new) "a" (GcStr (gc-joined "x" "!"))) "b" (GcInt 7))
    (begin
      (match (map-get m "a")
        (Some x (assert-equal (gc-text x) "x!"))
        (None (assert-equal 0 1)))
      (match (map-get m "b")
        (Some x (assert-equal (gc-text x) "int"))
        (None (assert-equal 0 1))))))

(test "map-string-to-string"
  (let m (map-insert (map-new) "k" (gc-joined "v" "1"))
    (match (map-get m "k")
      (Some s (assert-equal s "v1"))
      (None (assert-equal 0 1)))))

; --- Option / structs --------------------------------------------------------

(test "option-of-string"
  (match (Some (gc-joined "o" "k"))
    (Some s (assert-equal s "ok"))
    (None (assert-equal 0 1))))

(defstruct GcPerson (name String) (age Int))

(test "struct-string-field"
  (let p (make-GcPerson (gc-joined "An" "n") 30)
    (begin
      (assert-equal (struct-get p "name") "Ann")
      (assert-equal (struct-get p "age") 30))))

(run-tests)
