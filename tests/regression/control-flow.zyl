; Control Flow Regression Tests — if, while, for, cond, begin, nested

; If without else (uses Unit)
(test "if-then-unit"
  (let-mut _cf_flag false
    (if true (set! _cf_flag true))
    (assert-true _cf_flag)))

; If with else
(test "if-with-else"
  (assert-equal (if false 1 2) 2))

; Nested if
(test "nested-if"
  (assert-equal (if true (if true 1 2) 3) 1))

; While loop that doesn't run
(test "while-false"
  (assert-equal (while false 0) 0))

; While loop that runs
(test "while-runs"
  (assert-equal
    (let-mut _cf_counter 0
      (while (< _cf_counter 2) (set! _cf_counter (+ _cf_counter 1)) _cf_counter)
      _cf_counter)
    2))

; For loop basic
(test "for-loop-basic"
  (let-mut _cf_acc 0
    (for (i 0) (< i 3) (begin (set! _cf_acc (+ _cf_acc i)) (set! i (+ i 1))))
    (assert-equal _cf_acc 3)))

; For loop sum
(test "for-loop-sum"
  (let-mut _cf_acc 0
    (for (i 1) (<= i 4) (begin (set! _cf_acc (+ _cf_acc i)) (set! i (+ i 1))))
    (assert-equal _cf_acc 10)))

; For loop empty
(test "for-loop-empty"
  (assert-equal (let-mut _cf_acc 0 (for (i 0) (< i 0) (begin (set! _cf_acc (+ _cf_acc 1)) _cf_acc)) 0) 0))

; For loop early exit
; Loop with early exit via loop-variable mutation. Iterations: i=0,1,2
; accumulate 0+1+2; at i=2 the if sets i=8 (skipping 3..7), then acc+=8,
; i=9 accumulates 9, i=10 exits. Total = 0+1+8+9 = 18.
(test "for-loop-early-exit"
  (assert-equal (let-mut _cf_acc 0 (for (i 0) (< i 10) (begin (if (== i 2) (set! i 8)) (set! _cf_acc (+ _cf_acc i)) (set! i (+ i 1)) _cf_acc))) 18))

; Cond — first branch
(test "cond-first"
  (assert-equal (cond (true 1) (false 2)) 1))

; Cond — second branch
(test "cond-second"
  (assert-equal (cond (false 99) (true 42)) 42))

; Cond — multiple branches
(test "cond-branch-2"
  (assert-equal (cond (false 1) (true 2)) 2))
(test "cond-branch-3"
  (assert-equal (cond (false 1) (false 2) (true 3)) 3))

; Cond — single arm
(test "cond-single-arm"
  (assert-equal (cond (true "only arm")) "only arm"))

; Begin with multiple expressions
(test "begin-multi"
  (assert-equal (begin (print "first") (print "second") 42) 42))

; Deeply nested control flow
(test "deep-nested-control"
  (assert-equal (let a (+ 1 (let b (* 2 3) (+ b 4))) a) 11))

; While with struct
(test "while-with-struct"
  (assert-equal (let-mut _cf_counter 0 (let s (make-_cf_Point 0 100) (while (< _cf_counter 3) (set! _cf_counter (+ _cf_counter 1)) _cf_counter)) 3) 3))

(run-tests)

; Helper struct for while test
(defstruct _cf_Point (x) (y))
