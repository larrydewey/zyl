; BLAKE3 Known-Answer Tests.
;
; Inputs are the official BLAKE3 test pattern (byte i = i mod 251) at
; the lengths that cross a block boundary (64) and a chunk boundary
; (1024), which is where a tree-hash implementation goes wrong.
; Expected values match the published vectors for lengths 0, 1 and
; 1024 and were generated from the same reference construction for the
; rest.

(use math/hash/blake3)
(use math/words)
(use allocator/allocator)

(defn _b3_arena () (arena-create 0))

(defn _b3_hex ((hex String) (outlen Int))
  (let a (_b3_arena)
    (let msg (w-from-hex a hex)
      (w-hex-bytes (blake3-hash a msg (w-hex-len hex) outlen) outlen))))

(test "blake3-len-0"
  (assert-equal (_b3_hex "" 32) "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262"))
(test "blake3-len-1"
  (assert-equal (_b3_hex "00" 32) "2d3adedff11b61f14c886e35afa036736dcd87a74d27b5c1510225d0f592e213"))
(test "blake3-len-2"
  (assert-equal (_b3_hex "0001" 32) "7b7015bb92cf0b318037702a6cdd81dee41224f734684c2c122cd6359cb1ee63"))
(test "blake3-len-63"
  (assert-equal (_b3_hex "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e" 32) "e9bc37a594daad83be9470df7f7b3798297c3d834ce80ba85d6e207627b7db7b"))
(test "blake3-len-64"
  (assert-equal (_b3_hex "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f" 32) "4eed7141ea4a5cd4b788606bd23f46e212af9cacebacdc7d1f4c6dc7f2511b98"))
(test "blake3-len-65"
  (assert-equal (_b3_hex "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f40" 32) "de1e5fa0be70df6d2be8fffd0e99ceaa8eb6e8c93a63f2d8d1c30ecb6b263dee"))
(test "blake3-len-127"
  (assert-equal (_b3_hex "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e" 32) "d81293fda863f008c09e92fc382a81f5a0b4a1251cba1634016a0f86a6bd640d"))
(test "blake3-len-128"
  (assert-equal (_b3_hex "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f" 32) "f17e570564b26578c33bb7f44643f539624b05df1a76c81f30acd548c44b45ef"))
(test "blake3-len-1023"
  (assert-equal (_b3_hex "" 32) "10108970eeda3eb932baac1428c7a2163b0e924c9a9e25b35bba72b28f70bd11"))
(test "blake3-len-1024"
  (assert-equal (_b3_hex "" 32) "42214739f095a406f3fc83deb889744ac00df831c10daa55189b5d121c855af7"))
(test "blake3-len-1025"
  (assert-equal (_b3_hex "" 32) "d00278ae47eb27b34faecf67b4fe263f82d5412916c1ffd97c8cb7fb814b8444"))
(test "blake3-len-2048"
  (assert-equal (_b3_hex "" 32) "e776b6028c7cd22a4d0ba182a8bf62205d2ef576467e838ed6f2529b85fba24a"))
(test "blake3-len-2049"
  (assert-equal (_b3_hex "" 32) "5f4d72f40d7a5f82b15ca2b2e44b1de3c2ef86c426c95c1af0b6879522563030"))
(test "blake3-len-3072"
  (assert-equal (_b3_hex "" 32) "b98cb0ff3623be03326b373de6b9095218513e64f1ee2edd2525c7ad1e5cffd2"))

; Extendable output: 131 bytes spans three 64-byte squeeze blocks, so
; the output-block counter has to advance correctly.
(test "blake3-xof-131"
  (assert-equal (_b3_hex "616263" 131) "6437b3ac38465133ffb63b75273a8db548c558465d79db03fd359c6cd5bd9d851fb250ae7393f5d02813b65d521a0d492d9ba09cf7ce7f4cffd900f23374bf0bc08a1fb0b38ed276181ccbd9f7b7edbddf9f86404ad7929605f6ffa3fb1ac87983105f013384f2f11d38879c985d47003804b905f0c38975e28d36804bb60d8c303653"))

(test "blake3-string-abc"
  (assert-equal (blake3-hex-of-string (_b3_arena) "abc") "6437b3ac38465133ffb63b75273a8db548c558465d79db03fd359c6cd5bd9d85"))

(run-tests)
