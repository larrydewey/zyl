; HMAC-SHA256 / HKDF-SHA256 / PBKDF2-HMAC-SHA256 Known-Answer Tests
; Vectors: RFC 4231 (HMAC), RFC 5869 (HKDF), RFC 7914 / NIST (PBKDF2).

(use math/hash/hmac)
(use math/crypto/kdf/hkdf)
(use math/crypto/kdf/pbkdf2)
(use math/words)
(use allocator/allocator)

(defn _kdf_arena () w-arena)

; --- RFC 4231 HMAC-SHA256 -------------------------------------------------

(test "hmac-rfc4231-case1"
  (begin
    (let k (w-from-hex "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
      (let m (w-from-string "Hi There")
        (assert-equal (w-hex-bytes (hmac-sha256 k 20 m 8) 32)
          "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")))))

(test "hmac-rfc4231-case2"
  (begin
    (let k (w-from-string "Jefe")
      (let m (w-from-string "what do ya want for nothing?")
        (assert-equal (w-hex-bytes (hmac-sha256 k 4 m 28) 32)
          "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")))))

(test "hmac-rfc4231-case3"
  (begin
    (let k (w-from-hex "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
      (let m (w-from-hex "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd")
        (assert-equal (w-hex-bytes (hmac-sha256 k 20 m 50) 32)
          "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe")))))

; Key longer than the 64-byte block must be hashed down first.
(test "hmac-rfc4231-case6-long-key"
  (begin
    (let k (w-from-hex "")
      (let m (w-from-string "Test Using Larger Than Block-Size Key - Hash Key First")
        (assert-equal (w-hex-bytes (hmac-sha256 k 131 m 54) 32)
          "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")))))

(test "hmac-verify-accepts"
  (begin
    (let k (w-from-string "Jefe")
      (let m (w-from-string "what do ya want for nothing?")
        (let tag (w-from-hex "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
          (assert-true (hmac-sha256-verify k 4 m 28 tag)))))))

(test "hmac-verify-rejects"
  (begin
    (let k (w-from-string "Jefe")
      (let m (w-from-string "what do ya want for nothing?")
        (let tag (w-from-hex "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3844")
          (assert-false (hmac-sha256-verify k 4 m 28 tag)))))))

; --- RFC 5869 HKDF-SHA256 -------------------------------------------------

(test "hkdf-rfc5869-case1-prk"
  (begin
    (let ikm (w-from-hex "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
      (let salt (w-from-hex "000102030405060708090a0b0c")
        (assert-equal (w-hex-bytes (hkdf-extract salt 13 ikm 22) 32)
          "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")))))

(test "hkdf-rfc5869-case1-okm"
  (begin
    (let ikm (w-from-hex "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
      (let salt (w-from-hex "000102030405060708090a0b0c")
        (let info (w-from-hex "f0f1f2f3f4f5f6f7f8f9")
          (assert-equal (w-hex-bytes (hkdf ikm 22 salt 13 info 10 42) 42)
            "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865"))))))

; Empty salt must behave as 32 zero bytes (RFC 5869 s2.2).
(test "hkdf-empty-salt"
  (begin
    (let ikm (w-from-hex "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
      (let empty (w-alloc 1)
        (assert-equal (w-hex-bytes (hkdf ikm 22 empty 0 empty 0 42) 42)
          "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8")))))

; --- PBKDF2-HMAC-SHA256 ---------------------------------------------------

(test "pbkdf2-1-iteration"
  (begin
    (let p (w-from-string "password")
      (let s (w-from-string "salt")
        (assert-equal (w-hex-bytes (pbkdf2-sha256 p 8 s 4 1 32) 32)
          "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b")))))

(test "pbkdf2-2-iterations"
  (begin
    (let p (w-from-string "password")
      (let s (w-from-string "salt")
        (assert-equal (w-hex-bytes (pbkdf2-sha256 p 8 s 4 2 32) 32)
          "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43")))))

; Multi-block output (40 bytes spans two 32-byte blocks).
(test "pbkdf2-multi-block"
  (begin
    (let p (w-from-string "passwordPASSWORDpassword")
      (let s (w-from-string "saltSALTsaltSALTsaltSALTsaltSALTsalt")
        (assert-equal (w-hex-bytes (pbkdf2-sha256 p 24 s 36 4096 40) 40)
          "348c89dbcbd32b2f32d814b8116e84cf2b17347ebc1800181c4e2a1fb8dd53e1c635518c7dac47e9")))))

(run-tests)
