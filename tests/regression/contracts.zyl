; Contract System Regression Tests — requires, ensures, invariant, recover, checkpoint
; Spec §23: a violated requires/ensures/invariant raises E_CONTRACT_VIOLATION;
; a passing one leaves the program's value unchanged.

(use core/core)
(use core/result)
(use core/list)

; An invariant inside a body is a check; at the top level it would never run (E_MALFORMED_FORM).
(defstruct _ct_Counter
  (value Int))
(defn _ct-counter-ok (c)
  (begin
    (
      invariant
      (
        >= (struct-get c "value") 0
      )
    )
    (struct-get c "value")))

(test "contract-struct-invariant"
  (assert-equal (_ct-counter-ok (make-_ct_Counter 3)) 3))

; requires + ensures in a function body (both no-op overlays)
(
  defn
  _ct-with-requires
  (x)
  (
    begin
    (
      requires
      (
        >= x 0
      )
    )
    (
      ensures
      (
        >= x 0
      )
    )
    (
      *
      x
      x
    )
  )
)

(
  test
  "contract-requires"
  (
    assert-equal
    (_ct-with-requires 3)
    9
  )
)

; recover keeps the body value (fallback arm is the overlay)
(
  defn
  _ct-with-recover
  ()
  (
    recover
    (
      try
      (result-ok 5)
      (
        catch
        e
        (result-err e)
      )
    )
    (
      String
      (result-err "fallback")
    )
  )
  )

(
  test
  "contract-recover"
  (
    assert-true
    (result-is-ok (_ct-with-recover))
  )
)

; checkpoint preserves the body value
(
  defn
  _ct-checkpoint-test
  ()
  (
    let-mut
    x
    10
    (
      checkpoint
      (
        begin
        (
          set!
          x
          20
        )
        x
      )
    )
  )
)

(
  test
  "contract-checkpoint"
  (
    assert-equal
    (_ct-checkpoint-test)
    20
  )
)

; Local contract off wraps a single body
(
  contracts
  off
  (
    defn
    _ct-no-contract
    (a b)
    (
      div!
      a
      b
    )
  )
)

(
  test
  "contract-local-off"
  (
    assert-equal
    (_ct-no-contract 10 2)
    5
  )
)

; Plain function with no contracts
(
  defn
  _ct-empty-contract
  (x)
  x
)

(
  test
  "contract-empty"
  (
    assert-equal
    (_ct-empty-contract 42)
    42
  )
)

; Violations raise E_CONTRACT_VIOLATION, catchable like any error.
(defn _ct-div (a b)
  (requires (> b 0))
  (div! a b))

(defn _ct-abs (x)
  (ensures (>= result 0))
  (if (< x 0) (- 0 x) x))

(defn _ct-bad-abs (x)
  (begin
    (ensures (>= result 0))
    x))

(defn _ct-count (i)
  (begin
    (invariant (< i 100))
    (if (= i 0) 0 (_ct-count (- i 1)))))

(defn _ct-msg (thunk) (try (begin (thunk) "") (catch e e)))

(test "contract-requires-violated"
  (begin
    (assert-equal (_ct-div 10 2) 5)
    (assert-true (str-eq (_ct-msg (fn () (_ct-div 1 0)))
      "E_CONTRACT_VIOLATION: precondition of _ct-div failed: (> b 0)"))))

(test "contract-ensures-binds-result"
  (begin
    (assert-equal (_ct-abs -3) 3)
    (assert-true (str-eq (_ct-msg (fn () (_ct-bad-abs -2)))
      "E_CONTRACT_VIOLATION: postcondition of _ct-bad-abs failed: (>= result 0)"))))

(test "contract-invariant"
  (begin
    (assert-equal (_ct-count 5) 0)
    (assert-true (str-eq (_ct-msg (fn () (_ct-count 100)))
      "E_CONTRACT_VIOLATION: invariant of _ct-count failed: (< i 100)"))))

; recover runs the first arm's fallback when the body raises.
(defn _ct-recovered () (recover (_ct-div 1 0) ((String) 42)))

(test "contract-recover-fallback"
  (assert-equal (_ct-recovered) 42))

; A bare (contracts off) directive strips the next definition's clauses.
(contracts off)
(defn _ct-unchecked (b) (requires (> b 0)) b)

(test "contract-off-directive"
  (assert-equal (_ct-unchecked -1) -1))

; (contracts warn) reports a violation on stderr and continues.
(contracts warn)
(defn _ct-soft (b) (requires (> b 0)) (+ b 100))

(test "contract-warn-profile"
  (assert-equal (_ct-soft -1) 99))

; checkpoint restores the let-mut variables its body set!, then re-raises.
(defn _ct-rollback ()
  (let-mut x 10
    (let-mut y 1
      (begin
        (try (checkpoint (begin (set! x 20) (set! y 2) (panic "fail"))) (catch e 0))
        (+ (* x 10) y)))))

(test "checkpoint-rolls-back"
  (assert-equal (_ct-rollback) 101))

; recover arms are tested in order; an E_ code matches by message prefix.
(test "recover-typed-arms"
  (begin
    (assert-equal (recover (_ct-div 1 0) ((E_CONTRACT_VIOLATION) -1) ((String) -2)) -1)
    (assert-equal (recover (panic "E_OTHER: boom") ((E_CONTRACT_VIOLATION) -1) (_ -2)) -2)
    (assert-equal (try (recover (panic "E_OTHER: x") ((E_CONTRACT_VIOLATION) -1)) (catch e 99)) 99)))

;; checkpoint restores an outer let-mut even when the body binds the same name again.
(defn _ct-cp-shadow ()
  (let-mut x 1
    (begin
      (try (checkpoint (begin (set! x 2) (let-mut x 100 (begin (set! x 200) (panic "c"))))) (catch e unit))
      x)))

(test "checkpoint-shadowed-name-rolls-back"
  (assert-equal (_ct-cp-shadow) 1))

;; A for loop's own counter is not an outer variable to save.
(defn _ct-cp-for ()
  (let-mut n 0
    (begin
      (checkpoint (for (i 0) (< i 3) (begin (set! n (+ n i)) (set! i (+ i 1)))))
      n)))

(test "checkpoint-for-loop"
  (assert-equal (_ct-cp-for) 3))

;; checkpoint's saved copies capture none of the body's names.
(defn _ct-cp-hygiene ()
  (let _cp0 42
    (let-mut x 1
      (begin
        (checkpoint (begin (set! x 2) _cp0))))))

(test "checkpoint-hygiene"
  (assert-equal (_ct-cp-hygiene) 42))

;; recover's caught error captures none of the arms' names.
(defn _ct-rc-hygiene ()
  (let _rc_err 7
    (recover (panic "boom") ((String) _rc_err))))

(test "recover-hygiene"
  (assert-equal (_ct-rc-hygiene) 7))

;; A runtime error's report starts with error[CODE]; a code arm still matches it.
(defn _ct-rc-div (a b) (recover (div! a b) ((E_DIVISION_BY_ZERO) 0)))
(defn _ct-rc-add (a b) (recover (+ a b) ((E_OVERFLOW) 0)))

(test "recover-runtime-codes"
  (begin
    (assert-equal (_ct-rc-div 1 0) 0)
    (assert-equal (_ct-rc-add 9223372036854775807 1) 0)
    (assert-equal (try (recover (div! 1 0) ((E_OVERFLOW) 0)) (catch e -1)) -1)))

;; Conditions may compute through helpers, lambdas, named functions, methods and the standard library (E_CONTRACT_EFFECT otherwise).
(defn _ct-all (p xs) (match xs (Nil true) (Cons h t (and (p h) (_ct-all p t)))))
(defn _ct-pos (x) (> x 0))
(defstruct _ct_Pt (x Int))
(impl Show _ct_Pt (defn show (p) (str-concat "pt" (p.x.show))))
(defn _ct-pure-conds (xs)
  (begin
    (requires (_ct-all (fn (x) (> x 0)) xs))
    (requires (_ct-all _ct-pos xs))
    (requires (= (list-length xs) 3))
    (requires (= ((make-_ct_Pt 1).show) "pt1"))
    (ensures (= result 6))
    (list-sum! xs)))

(test "contract-pure-conditions"
  (assert-equal (_ct-pure-conds [1 2 3]) 6))

;; A condition that stops is the contract's own outcome: the panic propagates, under warn too.
(defn _ct-stops (n) (begin (requires (> (div! 10 n) 0)) n))
(contracts warn (defn _ct-stops-warn (n) (begin (requires (> (div! 10 n) 0)) n)))

(test "contract-condition-panics"
  (begin
    (assert-equal (_ct-stops 2) 2)
    (assert-equal (recover (_ct-stops 0) ((E_DIVISION_BY_ZERO) -1)) -1)
    (assert-equal (recover (_ct-stops-warn 0) ((E_DIVISION_BY_ZERO) -1)) -1)))

(run-tests)
