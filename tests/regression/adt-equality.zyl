; ADT Equality Regression Tests — `==`, `=` and `!=` on ADT and struct
; values compare contents (spec §6.5), wherever the values come from.
;
; Content comparison used to happen only when one operand was written as
; a constructor, and even then only one level deep (zyl_variant_eq):
; values held in parameters compared by address, and a nested ADT or a
; String field compared by address too. Each ADT now gets an equality
; function generated by the type-annotation pass.

(use core/list)
(use core/option)

(deftype EqShape (EqCircle Int) (EqRect Int Int) (EqNamed String EqShape))

(defstruct EqPoint (x Int) (y Int))

(defn eq-same (a b) (== a b))
(defn eq-differ (a b) (!= a b))
(defn eq-joined (a b) (str-concat a b))
(defn eq-names () (Cons "a" (Cons "b" Nil)))

(test "parameters-compare-by-content"
  (begin
    (assert-true (eq-same (EqRect 1 2) (EqRect 1 2)))
    (assert-false (eq-same (EqRect 1 2) (EqRect 1 3)))
    (assert-false (eq-same (EqCircle 1) (EqRect 1 3)))))

(test "not-equal"
  (begin
    (assert-false (eq-differ (EqCircle 4) (EqCircle 4)))
    (assert-true (eq-differ (EqCircle 4) (EqCircle 5)))))

(test "string-and-nested-fields"
  (begin
    (assert-true (== (EqNamed (eq-joined "a" "b") (EqCircle 1)) (EqNamed "ab" (EqCircle 1))))
    (assert-false (== (EqNamed "ab" (EqCircle 1)) (EqNamed "ab" (EqCircle 2))))))

(test "generic-lists"
  (begin
    (assert-true (== (eq-names) (Cons "a" (Cons (eq-joined "" "b") Nil))))
    (assert-false (== (eq-names) (Cons "a" Nil)))
    (assert-true (== (Cons (EqCircle 1) Nil) (Cons (EqCircle 1) Nil)))))

(test "structs-and-options"
  (begin
    (assert-true (== (make-EqPoint 1 2) (make-EqPoint 1 2)))
    (assert-false (== (make-EqPoint 1 2) (make-EqPoint 2 1)))
    (assert-true (= (Some 1.5) (Some 1.5)))
    (assert-true (== (Some (EqRect 1 2)) (Some (EqRect 1 2))))
    (assert-false (== (Some 1) None))))

(test "values-in-variables"
  (let a (eq-same (EqRect 0 0) (EqRect 0 0))
    (let p (EqNamed "p" (EqRect 3 4))
      (let q (EqNamed (eq-joined "" "p") (EqRect 3 4))
        (assert-true (if a (== p q) false))))))

(test "assert-equal-compares-nested-content"
  (begin
    (assert-equal (EqNamed (eq-joined "a" "b") (EqRect 1 2)) (EqNamed "ab" (EqRect 1 2)))
    (assert-equal (eq-names) (Cons "a" (Cons "b" Nil)))))

(run-tests)
