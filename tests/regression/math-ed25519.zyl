; Ed25519 Known-Answer Tests (RFC 8032 s7.1).
;
; Signing runs two full scalar multiplications and verification runs
; two more, each 256 constant-time double-and-add steps over the
; generic Montgomery field -- these are the slowest tests in the suite
; by a wide margin, which is the price of the shared, separately-tested
; field arithmetic (see the module header).

(use math/crypto/asymmetric/ed25519)
(use math/words)
(use allocator/allocator)

(defn _ed_arena () (arena-create 0))

(test "ed25519-public-key-0"
  (let a (_ed_arena)
    (let seed (w-from-hex a "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
      (assert-equal (w-hex-bytes (ed25519-public-key a seed) 32) "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"))))
(test "ed25519-sign-0"
  (let a (_ed_arena)
    (let seed (w-from-hex a "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
      (let msg (w-from-hex a "")
        (assert-equal (w-hex-bytes (ed25519-sign a seed msg 0) 64) "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b")))))
(test "ed25519-verify-0"
  (let a (_ed_arena)
    (let pub (w-from-hex a "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
      (let msg (w-from-hex a "")
        (let sig (w-from-hex a "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b")
          (assert-true (ed25519-verify a pub msg 0 sig)))))))
(test "ed25519-public-key-1"
  (let a (_ed_arena)
    (let seed (w-from-hex a "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
      (assert-equal (w-hex-bytes (ed25519-public-key a seed) 32) "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"))))
(test "ed25519-sign-1"
  (let a (_ed_arena)
    (let seed (w-from-hex a "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
      (let msg (w-from-hex a "72")
        (assert-equal (w-hex-bytes (ed25519-sign a seed msg 1) 64) "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00")))))
(test "ed25519-verify-1"
  (let a (_ed_arena)
    (let pub (w-from-hex a "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c")
      (let msg (w-from-hex a "72")
        (let sig (w-from-hex a "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00")
          (assert-true (ed25519-verify a pub msg 1 sig)))))))
(test "ed25519-public-key-2"
  (let a (_ed_arena)
    (let seed (w-from-hex a "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7")
      (assert-equal (w-hex-bytes (ed25519-public-key a seed) 32) "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025"))))
(test "ed25519-sign-2"
  (let a (_ed_arena)
    (let seed (w-from-hex a "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7")
      (let msg (w-from-hex a "af82")
        (assert-equal (w-hex-bytes (ed25519-sign a seed msg 2) 64) "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a")))))
(test "ed25519-verify-2"
  (let a (_ed_arena)
    (let pub (w-from-hex a "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025")
      (let msg (w-from-hex a "af82")
        (let sig (w-from-hex a "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a")
          (assert-true (ed25519-verify a pub msg 2 sig)))))))

; A flipped signature bit, a flipped message bit and a wrong public key
; must all be rejected.
(test "ed25519-verify-rejects-bad-signature"
  (let a (_ed_arena)
    (let pub (w-from-hex a "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c")
      (let msg (w-from-hex a "72")
        (let sig (w-from-hex a "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00")
          (begin
            (w-set sig 0 (bit-xor (w-get sig 0) 1))
            (assert-false (ed25519-verify a pub msg 1 sig))))))))

(test "ed25519-verify-rejects-modified-message"
  (let a (_ed_arena)
    (let pub (w-from-hex a "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c")
      (let msg (w-from-hex a "72")
        (let sig (w-from-hex a "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00")
          (begin
            (w-set msg 0 (bit-xor (w-get msg 0) 1))
            (assert-false (ed25519-verify a pub msg 1 sig))))))))

(run-tests)
