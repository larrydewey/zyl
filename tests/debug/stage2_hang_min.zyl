; MINIMAL stage2 blocker repro (2026-08-24, refined).
;
; stage1 SIGSEGVs while compiling THIS EXACT input (all four functions
; together). Any three compile fine. The crash surfaces inside the lexer
; (lex_loop TCO region) but is believed to be state corruption from an
; earlier phase (ic-program/cg-program process 4 matches / 8 arms).
;
; Repro:
;   cp tests/debug/stage2_hang_min.zyl /tmp/zyl_boot_in.zyl
;   ./stage1.bin          -> SIGSEGV (ulimit -s unlimited also fails)
;
; Next session: instrument stage1's own compiled ic-collect-vt /
; cg-param-env / env-lookup with dbg-log writes to find which structure
; gets corrupted between function 3 and function 4.
(deftype Option (Some T) Nil)

(defn option-unwrap (opt default)
  (match opt
    (Some v v)
    (Nil default)))

(defn is-some (opt) (match opt (Some _ true) (Nil false)))

(defn is-none (opt) (match opt (Some _ false) (Nil true)))

(defn omap (opt f)
  (match opt
    (Some v (Some (f v)))
    (Nil Nil)))

(defn main () 0)
