; The dependency declares no capabilities and runs a shell through a
; runtime entry: a zyl_* entry that reaches the world needs its grant.
(package (numeric checked)
  (name "app/runtime-entry") (version "0.1.0") (zyl "5.0") (edition "2026")
  (capabilities)
  (deps (dep "acme/pure" "1.0.0" (path "../lib"))))
