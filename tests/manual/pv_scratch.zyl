; Phase 2c — Parser verification + AST manipulation helpers.
; Lexes and parses a program exercising the major special forms, then
; verifies the pool-AST structure via ast-helpers accessors.

(use allocator/allocator)
(use compiler/lexer)
(use compiler/parser)
(use compiler/ast-helpers)

; --- module-level parse results shared by the tests below ---
; (Zyl tests are independent functions, so each test parses its own input.)

; DEFN(10): str=name, kids=params, a=body. CALL(8): a=head, kids=args.
; Verify name, arity, and body call shape for a top-level defn.
(defn main ()
  (let arena (arena-create 0)
    (begin
      (let tokens (zyl-lex arena "(defn foo (x y) (+ x y))")
        (let ctx (parse-ctx arena)
          (let prog (post-process arena ctx tokens
                      (begin
                        (form-cache-init arena ctx)
                        (parse-program arena ctx)))
            (let body-kids (pool-kids (alloc-read-int ctx) prog)
              (begin
                ; one top-level form
                (assert-equal (kids-len body-kids) 1)
                (let defn-id (kids-get body-kids 0)
                  (begin
                    (assert-equal (pool-kind (alloc-read-int ctx) defn-id) 10)
                    (assert-true (str-eq (defn-name (alloc-read-int ctx) defn-id) (str-intern arena "foo")))
                    (assert-equal (kids-len (defn-params (alloc-read-int ctx) defn-id)) 2)
                    (let body (defn-body (alloc-read-int ctx) defn-id)
                      (begin
                        (assert-equal (pool-kind (alloc-read-int ctx) body) 8)
                        (assert-equal (kids-len (call-args (alloc-read-int ctx) body)) 2)
                        (print "pv-defn ok")))))))))))))
