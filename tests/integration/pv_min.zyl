; Minimal reader smoke test — recursive Ast edition.

(use allocator/allocator)
(use compiler/lexer)
(use compiler/parser)
(use compiler/ast)
(use testing/testing)

(defn pv-hd (xs)
  (match xs
    (Cons a rest a)
    (Nil (AList Nil))))

; nth element of an Ast list.
(defn nth-ast (xs n)
  (match xs
    (Cons a rest
      (if (<= n 0) a (nth-ast rest (- n 1))))
    (Nil (AList Nil))))

; Children of an AList node; empty otherwise.
(defn kids-of (a)
  (match a
    (AList kids kids)
    (AstIdent d1 Nil)
    (AstInt d2 Nil)
    (AstFloat d3 Nil)
    (AString d4 Nil)
    (AstBool d5 Nil)))

(test "pv-min"
  (let arena (arena-create 0)
    (let prog (zyl-parse arena "(defn foo (x) x)")
      (begin
        ; one form, head "defn", name "foo", one param
        (assert-equal (list-length prog) 1)
        ; head identifier of the single form is "defn"
        (match (nth-ast (kids-of (pv-hd prog)) 0)
          (AstIdent h (assert-true (> (str-eq h (str-intern arena "defn")) 0)))
          (AstInt d6 (assert-equal 1 2))
          (AstFloat d7 (assert-equal 1 2))
          (AString d8 (assert-equal 1 2))
          (AstBool d9 (assert-equal 1 2))
          (AList d10 (assert-equal 1 2)))
        ; params form holds exactly 1 element
        (match (nth-ast (kids-of (pv-hd prog)) 2)
          (AList params (assert-equal (list-length params) 1))
          (AstIdent d11 (assert-equal 1 2))
          (AstInt d12 (assert-equal 1 2))
          (AstFloat d13 (assert-equal 1 2))
          (AString d14 (assert-equal 1 2))
          (AstBool d15 (assert-equal 1 2)))
        0))))

(run-tests)
