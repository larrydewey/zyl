; Parser verification — recursive Ast edition.
; Lexes and parses programs exercising the reader, then verifies the
; structure via the ast.zyl discriminators (no pools, no indices).

(use allocator/allocator)
(use compiler/lexer)
(use compiler/parser)
(use compiler/ast)
(use testing/testing)

; First top-level form of a parsed program.
(defn pv-hd (xs)
  (match xs
    (Cons a rest a)
    (None (AList None))))

(defn pv-drop (xs n)
  (if (is-nil xs)
    xs
    (if (<= n 0)
      xs
      (pv-drop (list-cdr xs) (- n 1)))))
(defn pv-first (prog)
  (match prog
    (Cons a rest a)
    (None (AList None))))

(test "pv-defn-shape"
  (let arena (arena-create 0)
    (let prog (zyl-parse arena "(defn foo (x y) (+ x y))")
      (begin
        ; one top-level form: (defn foo (x y) (+ x y))
        (assert-equal (list-length prog) 1)
        (let d (pv-first prog)
          (let kids (ast-kids d)
            (begin
              ; head symbol is "defn"
              (assert-true (str-eq (ast-name (pv-hd kids)) (str-intern arena "defn")))
              ; name, params, body
              (assert-true (str-eq (ast-name (pv-hd (list-cdr kids))) (str-intern arena "foo")))
              (assert-equal (list-length (ast-kids (pv-hd (pv-drop kids 2)))) 2)
              (let body (pv-hd (pv-drop kids 3))
                (begin
                  ; body is the list (+ x y): head "+", two ident args
                  (assert-equal (ast-code body) 5)
                  (assert-equal (list-length (ast-kids body)) 3)
                  (assert-true (str-eq (ast-name (pv-hd (ast-kids body))) (str-intern arena "+")))
                  0)))))))))

(test "pv-atoms"
  (let arena (arena-create 0)
    (let prog (zyl-parse arena "(defn main () (begin (print 42) (print \"hi\") (print true) (print 1.5) 0))")
      (let body-form (pv-hd (pv-drop (ast-kids (pv-first prog)) 3))
        (let body-kids (ast-kids body-form)
          (begin
            ; begin form kids: head "begin" + 5 elements = 6
            (assert-equal (list-length body-kids) 6)
            ; element 1: (print 42) -> its arg atom 42
            (let e42 (match (list-cdr body-kids) (Cons w1 rest w1) (None (AList None)))
              (let a42 (match (list-cdr (ast-kids e42)) (Cons w2 rest w2) (None (AInt 0)))
                (begin
                  (assert-equal (ast-code a42) 1)
                  (assert-equal (ast-int a42) 42)
                  ; element 2: (print "hi") -> string literal
                  (let ehi (match (list-cdr (list-cdr body-kids)) (Cons w3 rest w3) (None (AList None))))
                    (begin
                      (assert-true (str-eq (ast-text (match (list-cdr (ast-kids ehi)) (Cons w4 rest w4) (None (AString "")))) (str-intern arena "hi")))
                      ; element 3: (print true) -> bool literal
                      (let etr (match (list-cdr (list-cdr (list-cdr body-kids))) (Cons w5 rest w5) (None (AList None))))
                        (begin
                          (assert-true (ast-bool (match (list-cdr (ast-kids etr)) (Cons w6 rest w6) (None (ABool false)))))
                          ; element 4: (print 1.5) -> float literal text
                          (let efl (match (list-cdr (list-cdr (list-cdr (list-cdr body-kids)))) (Cons w7 rest w7) (None (AList None))))
                            (begin
                              (assert-true (str-eq (ast-text (match (list-cdr (ast-kids efl)) (Cons w8 rest w8) (None (AString "")))) (str-intern arena "1.5")))
                              0))))))))))))

(test "pv-nesting"
  (let arena (arena-create 0)
    (let prog (zyl-parse arena "(defn f (x) (if (> x 0) (foo x) (bar (baz x))))")
      (let ifform (pv-hd (pv-drop (ast-kids (pv-first prog)) 3))
        (begin
          (assert-equal (ast-code ifform) 5)
          (assert-equal (list-length (ast-kids ifform)) 4)
          ; then-branch is a call to foo
          (assert-true (str-eq (ast-name (pv-hd (ast-kids (pv-hd (pv-drop (ast-kids ifform) 2))))) (str-intern arena "foo")))
          ; else-branch nests bar(baz(x))
          (let else-call (pv-hd (pv-drop (ast-kids ifform) 3))
            (begin
              (assert-true (str-eq (ast-name (pv-hd (ast-kids else-call))) (str-intern arena "bar")))
              (assert-equal (list-length (ast-kids else-call)) 2)
              0)))))))

(run-tests)
