; Parser verification — recursive Ast edition.
; Lexes and parses programs exercising the reader, then verifies the
; structure via total helper functions that structurally match Ast
; variants (all constructors enumerated, no wildcard catch-alls).

(use allocator/allocator)
(use compiler/lexer)
(use compiler/parser)
(use compiler/ast)
(use testing/testing)

; First top-level form of a parsed program.
(defn pv-first (prog)
  (match prog
    (Cons a rest a)
    (Nil (AList Nil))))

; nth element of an Ast list.
(defn nth-ast (xs n)
  (match xs
    (Cons a rest
      (if (<= n 0) a (nth-ast rest (- n 1))))
    (Nil (AList Nil))))

; Number of children when `a` is an AList; 0 otherwise.
(defn ast-list-len (a)
  (match a
    (AList kids (list-length kids))
    (AstIdent d1 0)
    (AstInt d2 0)
    (AstFloat d3 0)
    (AString d4 0)
    (AstBool d5 0)))

; Payload of an AstInt node; 0 otherwise.
(defn atom-int (a)
  (match a
    (AstInt v v)
    (AstIdent d6 0)
    (AstFloat d7 0)
    (AString d8 0)
    (AstBool d9 0)
    (AList d10 0)))

; True when `a` is an AstIdent whose name equals `s`.
(defn ident-eq (arena a s)
  (match a
    (AstIdent n (if (> (str-eq n (str-intern arena s)) 0) 1 0))
    (AstInt d11 0)
    (AstFloat d12 0)
    (AString d13 0)
    (AstBool d14 0)
    (AList d15 0)))

; String payload of an AString node; "" otherwise.
(defn atom-str (arena a)
  (match a
    (AString s s)
    (AstIdent d16 (str-intern arena ""))
    (AstInt d17 (str-intern arena ""))
    (AstFloat d18 (str-intern arena ""))
    (AstBool d19 (str-intern arena ""))
    (AList d20 (str-intern arena ""))))

; Float literal text of an AstFloat node; "" otherwise.
(defn atom-float (arena a)
  (match a
    (AstFloat t t)
    (AstIdent d21 (str-intern arena ""))
    (AstInt d22 (str-intern arena ""))
    (AString d23 (str-intern arena ""))
    (AstBool d24 (str-intern arena ""))
    (AList d25 (str-intern arena ""))))

(test "pv-defn-shape"
  (let arena (arena-create 0)
    (let prog (zyl-parse arena "(defn foo (x y) (+ x y))")
      (begin
        ; one top-level form: (defn foo (x y) (+ x y))
        (assert-equal (list-length prog) 1)
        ; head symbol is "defn"
        (assert-true (> (ident-eq arena (nth-ast (kids-of (pv-first prog)) 0) "defn") 0))
        ; name is "foo"
        (assert-true (> (ident-eq arena (nth-ast (kids-of (pv-first prog)) 1) "foo") 0))
        ; params form holds two names
        (assert-equal (ast-list-len (nth-ast (kids-of (pv-first prog)) 2)) 2)
        ; body is the 3-element list (+ x y) headed by "+"
        (let body (nth-ast (kids-of (pv-first prog)) 3)
          (begin
            (assert-equal (ast-list-len body) 3)
            (assert-true (> (ident-eq arena (nth-ast (kids-of body) 0) "+") 0))
            0))))))

; Children of an AList node; empty list otherwise.
(defn kids-of (a)
  (match a
    (AList kids kids)
    (AstIdent d26 Nil)
    (AstInt d27 Nil)
    (AstFloat d28 Nil)
    (AString d29 Nil)
    (AstBool d30 Nil)))

(test "pv-atoms"
  (let arena (arena-create 0)
    (let prog (zyl-parse arena "(defn main () (begin (print 42) (print \"hi\") (print true) (print 1.5) 0))")
      (let bkids (kids-of (nth-ast (kids-of (pv-first prog)) 3))
        (begin
          ; begin form: head "begin" + 5 elements = 6
          (assert-equal (list-length bkids) 6)
          ; element 1: (print 42) -> arg atom 42
          (assert-equal (atom-int (nth-ast (kids-of (nth-ast bkids 1)) 1)) 42)
          ; element 2: (print "hi") -> string literal
          (assert-true (> (str-eq (atom-str arena (nth-ast (kids-of (nth-ast bkids 2)) 1)) (str-intern arena "hi")) 0))
          ; element 3: (print true) -> bool literal
          (assert-equal (atom-int-as-bool (nth-ast (kids-of (nth-ast bkids 3)) 1)) 1)
          ; element 4: (print 1.5) -> float literal text
          (assert-true (> (str-eq (atom-float arena (nth-ast (kids-of (nth-ast bkids 4)) 1)) (str-intern arena "1.5")) 0))
          0)))))

; 1 when the node is AstBool true; 0 otherwise (including AstBool false).
(defn atom-int-as-bool (a)
  (match a
    (AstBool b (if b 1 0))
    (AstIdent d31 0)
    (AstInt d32 0)
    (AstFloat d33 0)
    (AString d34 0)
    (AList d35 0)))

(test "pv-nesting"
  (let arena (arena-create 0)
    (let prog (zyl-parse arena "(defn f (x) (if (> x 0) (foo x) (bar (baz x))))")
      (let ikids (kids-of (nth-ast (kids-of (pv-first prog)) 3))
        (begin
          ; if form has 4 elements
          (assert-equal (list-length ikids) 4)
          ; then-branch is a call to foo
          (assert-true (> (ident-eq arena (nth-ast (kids-of (nth-ast ikids 2)) 0) "foo") 0))
          ; else-branch nests bar(baz(x)): bar with 2 elements
          (let els (kids-of (nth-ast ikids 3))
            (begin
              (assert-true (> (ident-eq arena (nth-ast els 0) "bar") 0))
              (assert-equal (list-length els) 2)
              0)))))))

(run-tests)
