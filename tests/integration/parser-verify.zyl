; Parser verification — recursive Ast edition.
; Lexes and parses programs exercising the reader, then verifies the
; structure via the ast.zyl discriminators (no pools, no indices).

(use allocator/allocator)
(use compiler/lexer)
(use compiler/parser)
(use compiler/ast)
(use testing/testing)

; First top-level form of a parsed program.
(defn pv-hd (xs)
  (match xs
    (Cons a rest a)
    (None (AList None))))
(defn pv-first (prog)
  (match prog
    (Cons a rest a)
    (None (AList None))))

(test "pv-defn-shape"
  (let arena (arena-create 0)
    (let prog (zyl-parse arena "(defn foo (x y) (+ x y))")
      (begin
        ; one top-level form: (defn foo (x y) (+ x y))
        (assert-equal (list-length prog) 1)
        (let d (pv-first prog)
          (let kids (ast-kids d)
            (begin
              ; head symbol is "defn"
              (assert-true (str-eq (ast-name (pv-hd kids)) (str-intern arena "defn")))
              ; name, params, body
              (assert-true (str-eq (ast-name (pv-hd (list-cdr kids))) (str-intern arena "foo")))
              (assert-equal (list-length (ast-kids (pv-hd (list-drop kids 2)))) 2)
              (let body (pv-hd (list-drop kids 3))
                (begin
                  ; body is the list (+ x y): head "+", two ident args
                  (assert-equal (ast-code body) 5)
                  (assert-equal (list-length (ast-kids body)) 3)
                  (assert-true (str-eq (ast-name (pv-hd (ast-kids body))) (str-intern arena "+")))
                  0)))))))))

(test "pv-atoms"
  (let arena (arena-create 0)
    (let prog (zyl-parse arena "(defn main () (begin (print 42) (print \"hi\") (print true) (print 1.5) 0))")
      (let body-kids (ast-kids (pv-hd (list-drop (ast-kids (pv-first prog)) 3)))
        (begin
          ; (begin ...) has 5 elements
          (assert-equal (list-length body-kids) 5)
          (let p1 (pv-hd (ast-kids (pv-hd body-kids)))
            (begin
              (assert-equal (ast-code p1) 1)
              (assert-equal (ast-int p1) 42)
              ; string literal
              (assert-true (> (alloc-strlen (ast-text (pv-hd (ast-kids (pv-hd (list-cdr body-kids)))))) 0))
              ; bool literal
              (assert-true (ast-bool (pv-hd (ast-kids (pv-hd (list-drop body-kids 2))))))
              ; float literal text
              (assert-true (str-eq (ast-text (pv-hd (ast-kids (pv-hd (list-drop body-kids 3))))) (str-intern arena "1.5")))
              0)))))))

(test "pv-nesting"
  (let arena (arena-create 0)
    (let prog (zyl-parse arena "(defn f (x) (if (> x 0) (foo x) (bar (baz x))))")
      (let ifform (pv-hd (list-drop (ast-kids (pv-first prog)) 3))
        (begin
          (assert-equal (ast-code ifform) 5)
          (assert-equal (list-length (ast-kids ifform)) 4)
          ; then-branch is a call to foo
          (assert-true (str-eq (ast-name (pv-hd (ast-kids (pv-hd (list-drop (ast-kids ifform) 2))))) (str-intern arena "foo")))
          ; else-branch nests bar(baz(x))
          (let else-call (pv-hd (list-drop (ast-kids ifform) 3))
            (begin
              (assert-true (str-eq (ast-name (pv-hd (ast-kids else-call))) (str-intern arena "bar")))
              (assert-equal (list-length (ast-kids else-call)) 2)
              0)))))))

(run-tests)
