; Phase 3 — self-hosted ICNF + codegen end-to-end (recursive AST edition).
; Parses a program with the Zyl reader, lowers it with compiler/icnf,
; generates x86_64 assembly with compiler/codegen, and writes the .s file
; to /tmp/zyl_selfhost.s.
;
; Build & run the generated program:
;   cc /tmp/zyl_selfhost.s -o prog && ./prog
; Expected output: 3 / 40 / hello / 3.750000 / 3

(use allocator/allocator)
(use compiler/lexer)
(use compiler/parser)
(use compiler/ast)
(use compiler/expr_inner)
(use compiler/icnf)
(use compiler/codegen)
(use testing/testing)

(defn write-asm (st path)
  (let out (file-open path "w")
    (let nbytes (file-write out (cg-buffer st))
      (let d1 (file-close out)
        nbytes))))

; Lower + emit in a top-level defn (keeps inference out of the test
; macro's context, which mis-unifies List(Ast) with an Option instance).
(defn run-selfhost-codegen ()
  (let arena (arena-create 1048576)
    (let src "(defn main () (begin (print (+ 1 2)) (print (* 10 4)) (if true (print \"hello\") (print \"no\")) (print (+ 1.5 2.25)) (print (ffi-call \"strlen\" \"abc\" 1000)) 0))"
      (let prog (zyl-parse arena src)
        (let exprs (convert-ast-list prog)
          (let fns (ic-program arena exprs)
            (begin
              ; one top-level defn lowered
              (assert-equal (list-length fns) 1)
              (assert-true (> (write-asm (cg-program (cg-new arena) fns) "/tmp/zyl_selfhost.s") 100))
              (print "selfhost: wrote /tmp/zyl_selfhost.s")
              0)))))))

(test "selfhost-codegen"
  (run-selfhost-codegen))

(run-tests)
