(capabilities actor)

(use actor/actor)

; Integration Test: multi-actor message passing

; Multi-actor message passing
(defn am-twice (rx tx) (chan-send tx (* 2 (chan-recv rx))))

(test "actor-multi-message"
  (let in1 (chan 1)
    (let in2 (chan 1)
      (let out1 (chan 1)
        (let out2 (chan 1)
          (let r1 (chan-rx in1)
            (let r2 (chan-rx in2)
              (let t1 (chan-tx out1)
                (let t2 (chan-tx out2)
                  (let actor1 (spawn (fn () (am-twice r1 t1)))
                    (let actor2 (spawn (fn () (am-twice r2 t2)))
                      (begin
                        (chan-send (chan-tx in1) 1)
                        (chan-send (chan-tx in2) 2)
                        (assert-equal (+ (chan-recv (chan-rx out1)) (chan-recv (chan-rx out2))) 6)
                        (actor-wait actor1)
                        (actor-wait actor2)))))))))))))

(run-tests)
(numeric checked)
