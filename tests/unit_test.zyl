                                         ; Shadow generic stdlib types with concrete versions
 ; (deftype List (Cons Int (List Int)) Nil)
 ; (deftype Option (Some Int) None)  ; shadows None — use stdlib Option
 ; (deftype Result (Ok Int) (Err Int))  ; shadows None — use stdlib Result

                                        ; --- Module Imports ---
(use io/io)
(use allocator/allocator)
(use core/core)
(use core/option)
(use core/result)
(use core/list)
(use collections/collections)
(use collections/vec)
(use collections/map)
(use collections/set)
(use actor/actor)
(use ffi/ffi)
(use atomic/atomic)

(test "xor true false"
      (assert-true (xor true false)))

(test "xor false true"
      (assert-true (xor false true)))

(test "xor true true"
      (assert-false (xor true true)))

(test "xor false false"
      (assert-false (xor false false)))

(test "nand true true"
      (assert-false (nand true true)))

(test "nand true false"
      (assert-true (nand true false)))

(test "nor false false"
      (assert-true (nor false false)))

(test "nor true false"
      (assert-false (nor true false)))

(test "implies true true"
      (assert-true (implies true true)))

(test "implies true false"
      (assert-false (implies true false)))

(test "implies false true"
      (assert-true (implies false true)))

(test "implies false false"
      (assert-true (implies false false)))

(test "is-bool true"
      (assert-true (is-bool true)))

(test "is-bool false"
      (assert-true (is-bool false)))

(test "is-zero zero"
      (assert-true (is-zero 0)))

(test "is-zero non-zero"
      (assert-false (is-zero 5)))

(test "is-even even"
      (assert-true (is-even 4)))

(test "is-even odd"
      (assert-false (is-even 3)))

(test "is-odd odd"
      (assert-true (is-odd 3)))

(test "is-odd even"
      (assert-false (is-odd 4)))

(test "abs negative"
      (assert-equal (abs -5) 5))

(test "abs positive"
      (assert-equal (abs 5) 5))

(test "max greater"
      (assert-equal (max 10 5) 10))

(test "max equal"
      (assert-equal (max 5 5) 5))

(test "min less"
      (assert-equal (min 5 10) 5))

(test "min equal"
      (assert-equal (min 5 5) 5))

(test "clamp within"
      (assert-equal (clamp 5 1 10) 5))

(test "clamp below"
      (assert-equal (clamp -5 1 10) 1))

(test "clamp above"
      (assert-equal (clamp 15 1 10) 10))

(test "signum positive"
      (assert-equal (signum 5) 1))

(test "signum negative"
      (assert-equal (signum -5) -1))

(test "signum zero"
      (assert-equal (signum 0) 0))

(test "square value"
      (assert-equal (square 7) 49))

(test "cube value"
      (assert-equal (cube 3) 27))

(test "float zero"
      (assert-equal 0.0 0.0))

(test "float neg"
      (assert-equal (- 1.5) -1.5))

(test "float div"
      (assert-equal (/ 10.0 4.0) 2.5))

(test "float cmp"
      (assert-true (> 3.14 2.71)))

(test "float arith"
      (assert-equal (+ 1.5 2.5 3.0) 7.0))

(test "print-int works"
      (print-int 42))

(test "print-float works"
      (print-float 3.14))

(test "print-string works"
      (print-string "hello"))

(test "print-bool true"
      (print-bool true))

(test "print-bool false"
      (print-bool false))

(test "str-concat"
      (assert-equal (str-concat "hello" " world") "hello world"))

(test "str-length abc"
      (assert-equal (str-length "abc") 3))

(test "str-length empty"
      (assert-equal (str-length "") 0))

(test "str-substring"
      (assert-equal (str-substring "hello world" 6 5) "world"))

(test "str-equal true"
      (assert-true (str-equal "abc" "abc")))

(test "str-equal false"
      (assert-false (str-equal "abc" "def")))

(test "option-some"
      (assert-true (option-is-some (option-some 42))))

(test "option-none"
      (assert-true (option-is-none (option-none))))

(test "option-unwrap-or some"
      (assert-equal (option-unwrap-or (option-some 42) 0) 42))

(test "option-unwrap-or none"
      (assert-equal (option-unwrap-or (option-none) 99) 99))

(test "option-map some"
      (let double (fn (x) (* x 2))
        (assert-equal (option-map (option-some 5) double) (option-some 10))))

(test "option-map none"
      (let double (fn (x) (* x 2))
        (assert-true (option-is-none (option-map (option-none) double)))))

(test "option-and some"
      (assert-true (option-is-some (option-and (option-some 1) (option-some 2)))))

(test "option-and none"
      (assert-true (option-is-none (option-and (option-none) (option-some 2)))))

(test "option-or some"
      (assert-true (option-is-some (option-or (option-some 1) (option-some 2)))))

(test "option-or none"
      (assert-true (option-is-some (option-or (option-none) (option-some 2)))))

(test "option-flatmap"
      (assert-equal (option-flatmap (option-some 5) (fn (x) (option-some (* x 2)))) (option-some 10)))

(test "option-to-result ok"
      (assert-true (result-is-ok (option-to-result (option-some 42) "error"))))

(test "option-to-result none"
      (assert-true (result-is-err (option-to-result (option-none) "error"))))

(test "option-from-result ok"
      (assert-equal (option-unwrap-or (option-from-result (result-ok 42) 0) 0) 42))

(test "option-from-result err"
      (assert-equal (option-unwrap-or (option-from-result (result-err "e") 0) 0) 0))

(test "option-inspect"
      (let print-and-return (fn (x) (print "x"))
        (assert-true (option-is-some (option-inspect (option-some 1) print-and-return)))))

(test "result-ok"
      (assert-true (result-is-ok (result-ok 42))))

(test "result-err"
      (assert-true (result-is-err (result-err "err"))))

(test "result-unwrap-or ok"
      (assert-equal (result-unwrap-or (result-ok 42) 0) 42))

(test "result-unwrap-or err"
      (assert-equal (result-unwrap-or (result-err "e") 99) 99))

(test "result-map ok"
      (assert-equal (result-map (result-ok 5) (fn (x) (* x 2))) (result-ok 10)))

(test "result-map err"
      (assert-true (result-is-err (result-map (result-err "e") (fn (x) (* x 2))))))

(test "result-and-then ok"
      (let double-ok (fn (x) (result-ok (* x 2)))
        (assert-equal (result-and-then (result-ok 5) double-ok) (result-ok 10))))

(test "result-and-then ok-2"
      (let double-ok (fn (x) (result-ok (* x 2)))
        (assert-equal (result-and-then (result-ok 5) double-ok) (result-ok 10))))

(test "result-or-else ok"
      (let fallback (fn (e) (result-ok 0))
        (assert-equal (result-or-else (result-ok 42) fallback) (result-ok 42))))

(test "result-or-else err"
      (let recover (fn (x) (result-ok 99))
        (assert-equal (result-or-else (result-err "e") recover) (result-ok 99))))

(test "result-inspect"
      (let print-and-return (fn (x) (print "x"))
        (assert-true (result-is-ok (result-inspect (result-ok 1) print-and-return)))))

(test "result-to-option ok"
      (assert-true (option-is-some (result-to-option (result-ok 42)))))

(test "result-to-option err"
      (assert-true (option-is-none (result-to-option (result-err "e")))))

(test "result-from-option none"
      (assert-true (result-is-err (result-from-option (option-none) "err"))))

(test "result-from-option some"
      (assert-true (result-is-ok (result-from-option (option-some 42) "err"))))

(test "result-flatmap ok"
      (let double-ok (fn (x) (result-ok (* x 2)))
        (assert-equal (result-flatmap (result-ok 5) double-ok) (result-ok 10))))

(test "result-flatmap ok-2"
      (let double-ok (fn (x) (result-ok (* x 2)))
        (assert-equal (result-flatmap (result-ok 5) double-ok) (result-ok 10))))

(test "try-catch success"
      (assert-equal (try 42 (catch e 0)) 42))

(test "try-catch error"
      (assert-true (result-is-ok (try (result-ok 1) (catch e (result-err e))))))

(test "identity"
      (let id (fn (x) x)
        (assert-equal (id 42) 42)))

(test "const"
      (let const-fn (fn (a _b) a)
        (assert-equal (const-fn 1 2) 1)))

(test "flip"
      (let sub (fn (a b) (- a b))
        (assert-equal (sub 10 3) 7)))

(test "fn as value"
      (let f (fn (x) (* x 2))
        (assert-equal (f 21) 42)))

(test "fn as arg"
      (let apply (fn (f x) (f x))
        (assert-equal (apply (fn (x) (+ x 1)) 5) 6)))

(test "fn captures via arg"
      (let f (fn (x) (+ x 0))
        (assert-equal (f 10) 10)))

(test "mut binding increments"
      (let-mut counter 0
               (set! counter (+ counter 1))
               (assert-equal counter 1)
               (set! counter (+ counter 1))
               (assert-equal counter 2)))

(test "nested closures"
      (let outer (fn (x) (fn (y) (+ x y)))
        (let add5 (outer 5)
          (assert-equal (add5 3) 8))))

                                        ; (test "recursive closure"
                                        ;   (let fact (fn (n) (if (<= n 1) 1 (* n (fact (- n 1)))))
                                        ;     (assert-equal (fact 5) 120)))

(test "list-car none"
      (assert-true (option-is-none (list-car (list-range 0 0)))))

(test "list-car some"
      (assert-equal (option-unwrap-or (list-car (list-range 42 43)) 0) 42))

(test "list-cdr"
      (assert-equal (list-length (list-cdr (list-range 1 3))) 1))

(test "list-len empty"
      (assert-equal (list-length (list-range 0 0)) 0))

(test "list-len 1"
      (assert-equal (list-length (list-range 1 2)) 1))

(test "list-sum empty"
      (assert-equal (list-sum (list-range 0 0)) 0))

(test "list-sum 1"
      (assert-equal (list-sum (list-range 5 6)) 5))

(test "list-rev empty"
      (assert-equal (list-length (list-reverse (list-range 0 0))) 0))

(test "list-append"
      (assert-equal (list-length (list-append (list-range 1 2) (list-range 3 5))) 3))

(test "list-range"
      (assert-equal (list-length (list-range 1 5)) 4))

(test "list-take"
      (assert-equal (list-length (list-take 3 (list-range 1 10))) 3))

(test "list-drop"
      (assert-equal (list-length (list-drop 2 (list-range 1 10))) 7))

(test "list-nth ok"
      (assert-true (option-is-some (list-nth 2 (list-range 1 10)))))

(test "list-nth bad"
      (assert-true (option-is-none (list-nth 100 (list-range 1 5)))))

(test "list-contains y"
      (assert-true (list-contains 3 (list-range 1 5))))

(test "list-contains n"
      (assert-false (list-contains 10 (list-range 1 5))))

(test "list-count"
      (assert-equal (list-count (fn (x) (> x 2)) (list-range 1 5)) 2))

(test "list-map"
      (assert-equal (list-sum (list-map (fn (x) (* x 2)) (list-range 1 3))) 6))

(test "list-filter"
      (assert-equal (list-length (list-filter (fn (x) (> x 2)) (list-range 1 5))) 2))

(test "list-fold"
      (assert-equal (list-fold (fn (acc x) (+ acc x)) 0 (list-range 1 5)) 10))

(test "assoc-empty"
      (assert-false (assoc-has 1 (assoc-empty))))

(test "assoc-put"
      (assert-true (assoc-has 1 (assoc-put 1 "val" (assoc-empty)))))

(test "assoc-get"
      (assert-equal (assoc-get 1 "default" (assoc-put 1 "found" (assoc-empty))) "found"))

(test "assoc-get missing"
      (assert-equal (assoc-get 99 "default" (assoc-put 1 "val" (assoc-empty))) "default"))

(test "assoc-has y"
      (assert-true (assoc-has 1 (assoc-put 1 "val" (assoc-empty)))))

(test "assoc-has n"
      (assert-false (assoc-has 99 (assoc-put 1 "val" (assoc-empty)))))

(test "assoc-remove"
      (assert-false (assoc-has 1 (assoc-remove 1 (assoc-put 1 "val" (assoc-empty))))))

(test "assoc-size"
      (assert-equal (assoc-size (assoc-put 1 "a" (assoc-put 2 "b" (assoc-empty)))) 2))

(test "assoc-keys"
      (assert-true (> (list-length (assoc-keys (assoc-put 1 "a" (assoc-empty)))) 0)))

(test "assoc-values"
      (assert-true (> (list-length (assoc-values (assoc-put 1 "a" (assoc-empty)))) 0)))

(test "assoc-map"
      (assert-equal (assoc-get 1 "" (assoc-map (fn (v) "y") (assoc-put 1 "x" (assoc-empty)))) "y"))

(test "assoc-fold"
      (assert-equal (assoc-fold (fn (acc _k v) (+ acc 1)) 0 (assoc-put 1 "a" (assoc-put 2 "b" (assoc-empty)))) 2))

(test "vec-create"
      (assert-equal (vec-len (vec-create 0 10)) 0))

(test "vec-len"
      (assert-equal (vec-len (vec-create 0 10)) 0))

(test "vec-cap"
      (assert-equal (vec-cap (vec-create 0 10)) 10))

(test "vec-set"
      (assert-equal (vec-get (vec-set (vec-create 0 10) 0 42) 0) 42))

(test "vec-get oob"
      (assert-equal (vec-get (vec-create 0 10) 99) -1))

(test "vec-push"
      (assert-equal (vec-len (vec-push (vec-create 0 10) 1)) 1))

(test "vec-push 2"
      (assert-equal (vec-len (vec-push (vec-push (vec-create 0 10) 1) 2)) 2))

(test "vec-pop"
      (assert-equal (vec-len (vec-pop (vec-push (vec-create 0 10) 42))) 0))

(test "vec-pop keeps values"
      ; Note: reads through a popped Vec hit the doubly-nested-let struct
      ; binding limitation, so verify length here and contents via vec-last.
      (let v (vec-push (vec-push (vec-create 0 10) 42) 43)
        (begin
          (assert-equal (vec-len (vec-pop v)) 1)
          (assert-equal (vec-last v) 43))))

(test "vec-pop empty"
      (assert-equal (vec-len (vec-pop (vec-create 0 10))) 0))

(test "map-create"
      (assert-equal (map-len (map-create 0 10)) 0))

(test "map-len"
      (assert-equal (map-len (map-create 0 10)) 0))

(test "map-put"
      (assert-equal (map-len (map-put (map-create 0 10) 1 42)) 1))

(test "map-get"
      (assert-equal (map-get (map-put (map-create 0 10) 1 42) 1 0) 42))

(test "map-get miss"
      (assert-equal (map-get (map-create 0 10) 99 0) 0))

(test "map-has y"
      (assert-true (map-has (map-put (map-create 0 10) 1 42) 1)))

(test "map-has n"
      (assert-false (map-has (map-create 0 10) 99)))

(test "map-remove"
      (assert-equal (map-len (map-remove (map-put (map-create 0 10) 1 42) 1)) 0))

(test "set-create"
      (assert-equal (set-len (set-create 0 10)) 0))

(test "set-len"
      (assert-equal (set-len (set-create 0 10)) 0))

(test "set-add"
      (assert-equal (set-len (set-add (set-create 0 10) 42)) 1))

(test "set-add dup"
      (assert-equal (set-len (set-add (set-add (set-create 0 10) 42) 42)) 1))

(test "set-has y"
      (assert-true (set-contains (set-add (set-create 0 10) 42) 42)))

(test "set-has n"
      (assert-false (set-contains (set-create 0 10) 42)))

(test "set-remove"
      (assert-equal (set-len (set-remove (set-add (set-create 0 10) 42) 42)) 0))

(test "spawn"
      (let actor (spawn (fn () 0))
        (assert-true (actor-is-alive actor))))

(test "actor terminate"
      (let actor (spawn (fn () 0))
        (begin
         (actor-terminate actor)
         0)))

(test "actor wait"
      (let actor (spawn (fn () 0))
        (begin
         (actor-wait actor)
         0)))

(test "send-basic"
      (let actor (spawn (fn () 0))
        (send actor 42)
        (actor-wait actor)
        0))

(test "file-open"
      (let fd (file-open "/tmp/zyl_test.txt" 577)
        (begin
          (assert-true (> fd 0))
          (file-close fd)
          0)))

(test "file-write"
      (assert-equal (file-write 1 "test") 4))

(test "file-read"
      (let fd (file-open "/tmp/zyl_test.txt" 0)
        (begin
         (assert-true (> (file-read fd 100) 0))
         (file-close fd)
         0)))

(test "file-close"
      (let fd (file-open "/tmp/zyl_test.txt" 0)
        (begin
         (file-close fd)
         0)))

(test "ffi-pin"
      (assert-true (>= (ffi-pin-value 42) 0)))

(test "ffi-unpin"
      (assert-equal (ffi-unpin-value (ffi-pin-value 42)) 42))

(test "ffi-safe"
      (assert-equal (ffi-safe-call 99) (result-ok 99)))

(test "ffi-pin-call"
      (assert-equal (result-unwrap (ffi-pin-call-unpin 123) 0) 123))

(test "buf-append"
      (let p (alloc-malloc 64)
        (begin
         (alloc-write-int p 0)
         (buf-append p "hello")
         (assert-equal (alloc-strlen p) 5)
         0)))

(test "alloc-malloc"
      (let p (alloc-malloc 64)
        (begin
          (assert-true (> p 0))
          (alloc-free p)
          0)))

(test "alloc-write-int"
      (let p (alloc-malloc 64)
        (begin
         (alloc-write-int p 42)
         (assert-true true)
         0)))

(test "alloc-read-int"
      (assert-true true))

(test "alloc-strlen"
      (assert-equal (alloc-strlen (alloc-malloc 64)) 0))

(test "atomic-load"
      (let p (alloc-malloc 8)
        (begin
          (atomic-store p 99)
          (assert-equal (atomic-load p) 99))))

(test "atomic-store"
      (let p (alloc-malloc 8)
        (begin
          (assert-equal (atomic-store p 42) 42)
          0)))

(test "atomic-add"
      (let p (alloc-malloc 8)
        (begin
          (atomic-store p 0)
          (assert-equal (atomic-add p 10) 10)
          0)))

(test "atomic-sub"
      (let p (alloc-malloc 8)
        (begin
          (atomic-store p 100)
          (assert-equal (atomic-sub p 25) 75)
          0)))

(test "atomic-max"
      (let p (alloc-malloc 8)
        (begin
          (atomic-store p 10)
          (assert-equal (atomic-max p 20) 20)
          0)))

(test "atomic-min"
      (let p (alloc-malloc 8)
        (begin
          (atomic-store p 20)
          (assert-equal (atomic-min p 10) 10)
          0)))

(test "atomic-cas"
      (let p (alloc-malloc 8)
        (begin
          (atomic-store p 0)
          (assert-true (atomic-cas p 0 99))
          (assert-equal (atomic-load p) 99)
          0)))

(test "OutputStream dispatch"
      (let out (make-stdout)
        (assert-equal (OutputStream.write out "test") 4)))

(test "OutputStream flush"
      (let out (make-stdout)
        (assert-equal (OutputStream.flush out) 0)))

(test "StringBuffer"
      (let sb (make-string-buffer)
        (begin
         (OutputStream.write sb "buffered")
         (OutputStream.flush sb)
         (assert-true (option-is-some (option-some 1))))))

(test "div zero"
      (assert-equal (/ 0 1) 0))

(test "neg div"
      (assert-equal (/ -10 2) -5))

(test "neg mul"
      (assert-equal (* -3 4) -12))

(test "modulo-like"
      (assert-equal (- 10 2 2 2 2) 2))

(test "deep nesting"
      (assert-true true)

      (defn returns-unit () (begin))
      (test "empty begin"
            (assert-equal (returns-unit) 0))

      (defn multi-return () (begin (print "first") (print "second") 42))
      (test "multi return"
            (assert-equal (multi-return) 42))

      (test "struct match"
            (assert-equal (struct-get (make-Point 5 7) "x") 5))

      (test "let-mut struct"
            (let-mut p (make-Point 1 2)
                     (set! p (make-Point 10 20))
                     (assert-equal (struct-get p "x") 10)))

      (defn no-args () 42)
      (test "no args"
            (assert-equal (no-args) 42))

      (defn one-arg (x) (+ x 1))
      (test "one arg"
            (assert-equal (one-arg 5) 6))

      (defn many-args (a b c d e) (+ a b c d e))
      (test "many args"
            (assert-equal (many-args 1 2 3 4 5) 15)))

; --- Run All Tests ---
(run-tests)
