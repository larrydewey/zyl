; Compile-fail: an `if` condition derived from a Secret parameter is a
; conditional jump on key material. The compiler must reject this with
; E_CT_VIOLATION (compiler/secret_check.zyl).

(use core/core)

(defn _cf_leaky_compare ((key Secret) (guess Int))
  (if (= key guess) 1 0))

(defn main () (_cf_leaky_compare 7 7))
