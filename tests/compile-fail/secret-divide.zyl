; Compile-fail: x86's divider is variable-latency in its operands, so a
; Secret dividend is a timing channel exactly like a branch. Must be
; rejected with E_CT_VIOLATION (compiler/secret_check.zyl).

(use core/core)

(defn _cf_reduce ((key Secret) (modulus Int))
  (mod key modulus))

(defn main () (_cf_reduce 99 7))
