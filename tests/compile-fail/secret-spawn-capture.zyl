; Compile-fail: a spawned closure that captures a Secret carries it to another actor.
; expect-error: E_SECRET_ESCAPE
(capabilities secret actor)
(use actor/actor)

(defn leak ((k Secret)) (let f (fn () k) (let v (f) (actor-wait (spawn (fn () (begin (print (declassify 0)) (+ v 1))))))))
(defn main () (begin (leak 63) 0))
