; Compile-fail: a Secret handed to ffi-call raw, rather than through
; (ffi-pin ...), leaves key material in ordinary pageable memory for the
; duration of the call. Must be rejected with E_FFI_PIN_REQUIRED
; (compiler/secret_check.zyl).

(use core/core)

(defn _cf_ffi_raw ((key Secret))
  (ffi-call "zyl_abs" key 1000))

(defn main () (_cf_ffi_raw 5))
