; Compile-fail: the taint is interprocedural. `_cf_derive` has no branch
; of its own, but it RETURNS a value derived from its Secret parameter,
; so every caller's result is secret too — and `_cf_use` then branches on
; it. Must be rejected with E_CT_VIOLATION (compiler/secret_check.zyl's
; secret-returning-function fixpoint).

(use core/core)

(defn _cf_derive ((key Secret) (pub Int))
  (bit-xor key pub))

(defn _cf_use ((key Secret))
  (if (> (_cf_derive key 3) 0) 1 0))

(defn main () (_cf_use 8))
