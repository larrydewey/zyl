; Compile-fail: indexing a word array with a Secret picks the cache line
; by key material — the channel that killed AES T-tables. Must be
; rejected with E_CT_VIOLATION (compiler/secret_check.zyl).

(use core/core)
(use math/words)
(use allocator/allocator)

(defn _cf_sbox_lookup ((table Int) (key Secret))
  (w-get table key))

(defn main ()
  (let ar (arena-create 0)
    (_cf_sbox_lookup (w-alloc ar 4) 2)))
