; expect-error: E_CT_VIOLATION
; expect-at: secret-div-bang.zyl:9:9
; x86's divider is variable-latency in its operands, so a Secret dividend
; is a timing channel exactly like a branch. Naming the divider `div!`
; rather than `/` does not reach a different instruction.
(use core/core)

(defn _cf_div ((key Secret) (k Int))
  (div! key k))

(defn main () (_cf_div 99 7))
