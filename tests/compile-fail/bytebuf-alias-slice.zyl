; A slice is a handle into the same location, so naming it as well as the
; buffer it came from is the same violation.
; expect-error: E_MUT_CONFLICT
(defn main ()
  (let b (bytebuf Stack 16)
    (let v (byteslice b 0 4)
      (begin
        (store-u8 :le v 0 65)
        (store-u8 :le b 0 66)
        0))))
