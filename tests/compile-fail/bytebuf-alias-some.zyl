; Compile-fail: a bytebuf wrapped in Some and matched out is the same location (L4).
; expect-error: E_MUT_CONFLICT
(defn main ()
  (let b (bytebuf Heap 16)
    (let t (Some b)
      (match t
        (Some c (begin
          (store-u8 :le c 0 65)
          (store-u8 :le b 0 66)
          (print (load-u8 :le c 0))
          0))
        (None 0)))))
