; Arenas, the heap and pin arenas, and frame regions (docs/regions-design.md).
(use base)
(use thread)
(use heap)


(defmacro rt-ld64 (a) (ffi-call "%load64" a 1))
(defmacro rt-st64 (a v) (ffi-call "%store64" a v 1))

(defn rt-utext (n) (ffi-call "zyl_int_text" n 1))

(defn rt-oom (requested why) (zyl_arena_oom requested why))

; Out of memory cannot unwind (handlers allocate): report and exit(1).
(defn zyl_arena_oom (requested why)
  (let b (rt-budget)
    (let msg (str-concat "PANIC: error[E_OUT_OF_MEMORY]: " (str-concat why (str-concat "\n  = requested " (str-concat (rt-utext requested)
               (str-concat " bytes; " (str-concat (rt-utext (rt-ld64 (+ b 16))) (str-concat " bytes already allocated; budget "
               (str-concat (rt-utext (rt-ld64 (+ b 8))) " bytes\n  = help: set ZYL_MAX_MEMORY to a byte count to raise the budget, or ZYL_MAX_MEMORY=0 to remove it\n"))))))))
      (let _ (rt-write-fd 2 (rt-w msg) (rt-strlen (rt-w msg)))
        (ffi-call "%syscall1" 231 1 1)))))

; --- arenas: {head, block_size, total_capacity, total_used, futex lock word}; a block is {mem, cap, used, next} ---

(defn rt-threads () (ffi-call "%global" "threads_started" 8 1))

; Set before a second thread can reach an arena; it never goes back.
(defn zyl_threads_started_mark () (let _ (rt-st64 (rt-threads) 1) 0))

; Macros: a is always a plain variable.
(defmacro rt-lock (a) (if (= (ffi-call "%load64" (ffi-call "%global" "threads_started" 8 1) 1) 0) 0 (zyl_rt_mutex_lock (+ a 32))))
(defmacro rt-unlock (a) (if (= (ffi-call "%load64" (ffi-call "%global" "threads_started" 8 1) 1) 0) 0 (zyl_rt_mutex_unlock (+ a 32))))

(defn rt-align16 (n) (bit-and (+ n 15) -16))

(defn rt-new-block (a cap0)
  (let cap (if (< cap0 (rt-ld64 (+ a 8))) (rt-ld64 (+ a 8)) cap0)
    (let _ (if (rt-charge cap) 0 (rt-oom cap "memory budget exhausted"))
      (let b (rt-raw-malloc 32)
        (if (= b 0) (let _ (rt-refund cap) (rt-oom 32 "out of memory allocating an arena block header"))
          (let m (rt-raw-malloc cap)
            (if (= m 0) (let _ (zyl_rt_free b) (let _ (rt-refund cap) (rt-oom cap "out of memory allocating an arena block")))
              (let _ (rt-st64 b m)
                (let _ (rt-st64 (+ b 8) cap)
                  (let _ (rt-st64 (+ b 16) 0)
                    (let _ (rt-st64 (+ b 24) (rt-ld64 a))
                      (let _ (rt-st64 a b)
                        (let _ (rt-st64 (+ a 16) (+ (rt-ld64 (+ a 16)) cap)) b)))))))))))))

(defn zyl_arena_create (block-size)
  (let bs (if (< block-size 16) 65536 block-size)
    (let a (rt-raw-malloc 72)
      (if (= a 0) 0 (let _ (rt-fill0 a 72) (let _ (rt-st64 (+ a 8) bs) (let _ (rt-new-block a bs) a)))))))

; A 16-aligned bump allocation, or 0 for a bad arena or size (over 2^48).
(defn rt-arena-bump (arena size)
  (if (or (= arena 0) (or (< size 0) (> size 281474976710656))) 0
    (let need (rt-align16 size)
      (let _ (rt-lock arena)
        (let b0 (rt-ld64 arena)
          (let b (if (or (= b0 0) (> need (- (rt-ld64 (+ b0 8)) (rt-ld64 (+ b0 16))))) (rt-new-block arena need) b0)
            (let p (+ (rt-ld64 b) (rt-ld64 (+ b 16)))
              (let _ (rt-st64 (+ b 16) (+ (rt-ld64 (+ b 16)) need))
                (let _ (rt-st64 (+ arena 24) (+ (rt-ld64 (+ arena 24)) need))
                  (let _ (rt-unlock arena) p))))))))))

(defn zyl_arena_alloc (arena size) (rt-arena-bump arena size))

; Zeroed after the lock: the range is already exclusively ours.
(defn zyl_arena_alloc_zeroed (arena size)
  (let p (rt-arena-bump arena size) (if (= p 0) 0 (let _ (rt-fill0 p size) p))))

; rep stosb zeroing and 0xDE poisoning.
(defn rt-fill0 (p n) (if (> n 0) (ffi-call "%fill" p 0 n 1) 0))

(defn rt-fill-de (p n) (if (> n 0) (ffi-call "%fill" p 222 n 1) 0))

; Poisons, refunds and frees every block (a stale pointer then reads 0xDE garbage).
(defn rt-free-blocks (b)
  (if (= b 0) 0
    (let next (rt-ld64 (+ b 24))
      (let _ (rt-fill-de (rt-ld64 b) (rt-ld64 (+ b 16)))
        (let _ (rt-refund (rt-ld64 (+ b 8)))
          (let _ (zyl_rt_free (rt-ld64 b)) (let _ (zyl_rt_free b) (rt-free-blocks next))))))))

(defn zyl_arena_reset (arena)
  (if (= arena 0) 0
    (let _ (rt-lock arena)
      (let _ (rt-free-blocks (rt-ld64 arena))
        (let _ (rt-st64 arena 0) (let _ (rt-st64 (+ arena 16) 0) (let _ (rt-st64 (+ arena 24) 0) (let _ (rt-unlock arena) 0))))))))

(defn zyl_arena_destroy (arena)
  (if (= arena 0) 0
    (let _ (rt-lock arena) (let _ (rt-free-blocks (rt-ld64 arena)) (let _ (rt-unlock arena) (let _ (zyl_rt_free arena) 0))))))

(defn zyl_arena_used (arena)
  (if (= arena 0) 0 (let _ (rt-lock arena) (let v (rt-ld64 (+ arena 24)) (let _ (rt-unlock arena) v)))))

(defn zyl_arena_capacity (arena)
  (if (= arena 0) 0 (let _ (rt-lock arena) (let v (rt-ld64 (+ arena 16)) (let _ (rt-unlock arena) v)))))

; Whether ptr..ptr+8 lies within the used bytes of some block of arena.
(defn rt-in-blocks (b p)
  (if (= b 0) false
    (if (and (>= p (rt-ld64 b)) (<= (+ p 8) (+ (rt-ld64 b) (rt-ld64 (+ b 16))))) true (rt-in-blocks (rt-ld64 (+ b 24)) p))))

(defn rt-addr-in-arena (arena p)
  (if (= arena 0) false (let _ (rt-lock arena) (let f (rt-in-blocks (rt-ld64 arena) p) (let _ (rt-unlock arena) f)))))

; --- the heap and pin arenas ---

(defn rt-arenas () (ffi-call "%global" "arenas" 24 1))
(defn rt-heap () (rt-ld64 (rt-arenas)))
(defn rt-pin () (rt-ld64 (+ (rt-arenas) 8)))

(defn zyl_arenas_init ()
  (let g (rt-arenas)
    (let _ (if (= (rt-ld64 g) 0) (rt-st64 g (zyl_arena_create 1048576)) 0)
      (let _ (if (= (rt-ld64 (+ g 8)) 0) (rt-st64 (+ g 8) (zyl_arena_create 262144)) 0) 0))))

(defn zyl_arenas_destroy ()
  (let g (rt-arenas)
    (let _ (if (= (rt-ld64 (+ g 8)) 0) 0 (let _ (zyl_arena_destroy (rt-ld64 (+ g 8))) (rt-st64 (+ g 8) 0)))
      (let _ (if (= (rt-ld64 g) 0) 0 (let _ (zyl_arena_destroy (rt-ld64 g)) (rt-st64 g 0))) 0))))

(defn rt-heap-fail (msg n) (let m (str-concat msg (str-concat (rt-utext n) "\n")) (let _ (rt-write-fd 2 (rt-w m) (rt-strlen (rt-w m))) 0)))

; A hidden qword count before the payload (zyl_variant_eq reads it); single-threaded bumps skip the lock call chain.
(defn zyl_heap_alloc (size)
  (let a (rt-heap)
    (if (or (= a 0) (<= size 0)) 0
      (if (> size 281474976710656) (rt-heap-fail "zyl_heap_alloc: size too large size=" size)
        (let q (/ (+ size 7) 8)
          (let need (rt-align16 (+ (* q 8) 8))
            (let b (rt-ld64 a)
              (if (and (= (rt-ld64 (rt-threads)) 0) (and (> b 0) (<= need (- (rt-ld64 (+ b 8)) (rt-ld64 (+ b 16))))))
                (let base (+ (rt-ld64 b) (rt-ld64 (+ b 16)))
                  (let _ (rt-st64 (+ b 16) (+ (rt-ld64 (+ b 16)) need))
                    (let _ (rt-st64 (+ a 24) (+ (rt-ld64 (+ a 24)) need))
                      (let _ (rt-st64 base q) (+ base 8)))))
                (let base (rt-arena-bump a (+ (* q 8) 8))
                  (if (= base 0) (rt-heap-fail "zyl_heap_alloc: FAILED size=" size)
                    (let _ (rt-st64 base q) (+ base 8))))))))))))

(defn zyl_heap_swap (arena)
  (let g (rt-arenas) (let old (rt-ld64 g) (let _ (if (= arena 0) 0 (rt-st64 g arena)) old))))

(defn zyl_session_arena ()
  (let g (+ (rt-arenas) 16) (let _ (if (= (rt-ld64 g) 0) (rt-st64 g (zyl_arena_create 1048576)) 0) (rt-ld64 g))))

(defn zyl_heap_block_p (w)
  (if (or (< w 4096) (not (= (bit-and w 7) 0))) false
    (if (rt-addr-in-arena (rt-heap) w) true (rt-addr-in-arena (zyl_session_arena) w))))

; Whether ptr came from ffi-pin (lies in a live pin block).
(defn zyl_pin_owns (ptr) (if (or (= ptr 0) (= (rt-pin) 0)) false (rt-addr-in-arena (rt-pin) ptr)))

(defn zyl_pin_word (value)
  (if (= (rt-pin) 0) 0 (let s (rt-arena-bump (rt-pin) 8) (let _ (if (= s 0) 0 (rt-st64 s value)) s))))

; Best-effort mlock of the pages under [addr, addr+len); 1 on success.
(defn zyl_mlock (addr len)
  (if (or (= addr 0) (<= len 0)) 0
    (let start (bit-and addr -4096)
      (if (= (ffi-call "%syscall2" 149 start (+ (- addr start) len) 1) 0) 1 0))))

(defn zyl_pin_alloc (size)
  (if (or (= (rt-pin) 0) (<= size 0)) 0
    (let p (rt-arena-bump (rt-pin) size) (let _ (if (= p 0) 0 (zyl_mlock p size)) p))))

; --- frame regions: {prev, bump, end, blocks|scope bit}, then a scope's {kind, block, align, limit, used} ---

; Size classes 1K/4K/16K/64K, carved from 1 MiB mappings kept per thread.
(defn rt-class-size (c) (if (= c 0) 1024 (if (= c 1) 4096 (if (= c 2) 16384 65536))))

(defn rt-rpool () (ffi-call "%tls" "rpool" 32 1))
(defn rt-live () (ffi-call "%global" "region_live" 8 1))

(defn rt-rmap (n)
  (let _ (if (rt-charge n) 0 (rt-oom n "memory budget exhausted"))
    (let p (ffi-call "%syscall6" 9 0 n 3 34 -1 0 1)
      (if (and (< p 0) (> p -4096)) (let _ (rt-refund n) (rt-oom n "mmap failed for a region block")) p))))

; A block header is {next, size, big (int), cls (int)}: 24 bytes.
(defn rt-rblock-init (b size big cls)
  (let _ (rt-st64 b 0)
    (let _ (rt-st64 (+ b 8) size)
      (let _ (ffi-call "%store32" (+ b 16) big 1) (let _ (ffi-call "%store32" (+ b 20) (bit-and cls 4294967295) 1) b)))))

(defn rt-carve (c chunk sz off)
  (if (> (+ off sz) 1048576) 0
    (let b (rt-rblock-init (+ chunk off) sz 0 c)
      (let slot (+ (rt-rpool) (* c 8))
        (let _ (rt-st64 b (rt-ld64 slot)) (let _ (rt-st64 slot b) (rt-carve c chunk sz (+ off sz))))))))

(defn rt-pick-class (need c) (if (and (< c 4) (> (+ need 24) (rt-class-size c))) (rt-pick-class need (+ c 1)) c))

; A block for a region that already holds nblocks blocks.
(defn rt-rblock-get (need nblocks)
  (let c (rt-pick-class need (if (< nblocks 4) nblocks 3))
    (if (>= c 4)
      (let n (bit-and (+ (+ need 24) 4095) -4096) (rt-rblock-init (rt-rmap n) n 1 -1))
      (let slot (+ (rt-rpool) (* c 8))
        (let _ (if (= (rt-ld64 slot) 0) (rt-carve c (rt-rmap 1048576) (rt-class-size c) 0) 0)
          (let b (rt-ld64 slot) (let _ (rt-st64 slot (rt-ld64 b)) (let _ (rt-st64 b 0) b))))))))

(defmacro rt-rblocks (r) (bit-and (ffi-call "%load64" (+ r 24) 1) -2))
(defmacro rt-rscoped (r) (= (bit-and (ffi-call "%load64" (+ r 24) 1) 1) 1))
(defmacro rt-rset-blocks (r b) (ffi-call "%store64" (+ r 24) (bit-or b (bit-and (ffi-call "%load64" (+ r 24) 1) 1)) 1))

(defn rt-count-blocks (b n) (if (or (= b 0) (>= n 4)) n (rt-count-blocks (rt-ld64 b) (+ n 1))))

(defn rt-push-block (r b)
  (let _ (rt-st64 b (rt-rblocks r))
    (let _ (rt-rset-blocks r b)
      (let _ (ffi-call "%fetch-add" (rt-live) (rt-ld64 (+ b 8)) 1)
        (let _ (rt-st64 (+ r 8) (+ b 24)) (rt-st64 (+ r 16) (+ b (rt-ld64 (+ b 8)))))))))

(defn rt-exhausted (p)
  (let kind (rt-ld64 p)
    (ffi-call "zyl_panic" (str-concat "E_REGION_EXHAUSTED: " (str-concat (if (= kind 2) "fixed" "arena")
      (str-concat " region of " (str-concat (rt-utext (if (= kind 2) (rt-ld64 (+ p 8)) (rt-ld64 (+ p 24)))) " bytes is full")))) 1)))

; with-region scope: kind 1 arena (blocks of `block`, at most `limit`), kind 2 fixed; page-aligned blocks keep padding deterministic.
(defn rt-policy-alloc (r size attempt)
  (let p (+ r 32)
    (let align (rt-ld64 (+ p 16))
      (let payload (* (/ (+ size 7) 8) 8)
        (let bump (rt-ld64 (+ r 8))
          (let at (bit-and (- (+ (+ bump 8) align) 1) (- 0 align))
            (let end (+ at payload)
              (if (and (> bump 0) (<= end (rt-ld64 (+ r 16))))
                (let used (+ (rt-ld64 (+ p 32)) (- end bump))
                  (if (and (> (rt-ld64 (+ p 24)) 0) (> used (rt-ld64 (+ p 24)))) (rt-exhausted p)
                    (let _ (rt-st64 (+ p 32) used) (let _ (rt-st64 (+ r 8) end) (let _ (rt-st64 (- at 8) (/ payload 8)) at)))))
                (if (or (>= attempt 1) (and (= (rt-ld64 p) 2) (> (rt-rblocks r) 0))) (rt-exhausted p)
                  (let need (+ (+ (+ payload 8) align) 24)
                    (let want0 (if (= (rt-ld64 p) 2) (+ (+ (+ (rt-ld64 (+ p 8)) 8) align) 24) (if (< (rt-ld64 (+ p 8)) need) need (rt-ld64 (+ p 8))))
                      (let want (bit-and (+ want0 4095) -4096)
                        (let b (rt-rblock-init (rt-rmap want) want 1 0)
                          (let _ (rt-push-block r b) (rt-policy-alloc r size (+ attempt 1))))))))))))))))

; size bytes in region rp (0: the heap) with the hidden qword count before them.
; A bare dispatch, so the heap path pays no prologue.
; A bare dispatch with an inline bump: the heap path pays no prologue, a fitting frame-region block no call.
(defn zyl_ralloc (size rp)
  (if (= rp 0) (zyl_heap_alloc size)
    (if (or (<= size 0) (> size 65536)) (rt-ralloc-in size rp)
      (let bump (rt-ld64 (+ rp 8))
        (let need (+ (bit-and (+ size 7) -8) 8)
          (if (and (> bump 0) (and (not (rt-rscoped rp)) (<= (+ bump need) (rt-ld64 (+ rp 16)))))
            (let _ (rt-st64 (+ rp 8) (+ bump need)) (let _ (rt-st64 bump (shr (+ size 7) 3)) (+ bump 8)))
            (rt-ralloc-in size rp)))))))

(defn rt-ralloc-in (size rp)
    (if (<= size 0) 0
      (if (rt-rscoped rp) (rt-policy-alloc rp size 0)
        (if (> size 281474976710656) (rt-heap-fail "zyl_ralloc: size too large size=" size)
          (let need (+ (* (/ (+ size 7) 8) 8) 8)
            (let _ (if (or (= (rt-ld64 (+ rp 8)) 0) (< (- (rt-ld64 (+ rp 16)) (rt-ld64 (+ rp 8))) need))
                     (rt-push-block rp (rt-rblock-get need (rt-count-blocks (rt-rblocks rp) 0))) 0)
              (let base (rt-ld64 (+ rp 8))
                (let _ (rt-st64 (+ rp 8) (+ base need)) (let _ (rt-st64 base (/ (+ size 7) 8)) (+ base 8))))))))))

; Returns one block: a big one is unmapped, a pool block goes back to this thread's pool.
(defn rt-release-block (b)
  (let _ (ffi-call "%fetch-add" (rt-live) (- 0 (rt-ld64 (+ b 8))) 1)
    (if (= (ffi-call "%load32" (+ b 16) 1) 1)
      (let n (rt-ld64 (+ b 8)) (let _ (ffi-call "%syscall2" 11 b n 1) (rt-refund n)))
      (let slot (+ (rt-rpool) (* (ffi-call "%load32" (+ b 20) 1) 8)) (let _ (rt-st64 b (rt-ld64 slot)) (rt-st64 slot b))))))

(defn rt-release-chain (b stop) (if (or (= b 0) (= b stop)) 0 (let next (rt-ld64 b) (let _ (rt-release-block b) (rt-release-chain next stop)))))

(defn rt-region-free-blocks (r)
  (let _ (rt-release-chain (rt-rblocks r) 0) (let _ (rt-rset-blocks r 0) (let _ (rt-st64 (+ r 8) 0) (rt-st64 (+ r 16) 0)))))

(defn zyl_region_enter (rp)
  (let _ (rt-st64 rp (ffi-call "%tls-get" "zyl_region_top" 1))
    (let _ (rt-st64 (+ rp 8) 0) (let _ (rt-st64 (+ rp 16) 0) (let _ (rt-st64 (+ rp 24) 0) (let _ (ffi-call "%tls-set" "zyl_region_top" rp 1) 0))))))

(defn zyl_region_scope_enter (hp kind block align limit)
  (let _ (rt-st64 hp (ffi-call "%tls-get" "zyl_region_top" 1))
    (let _ (rt-st64 (+ hp 8) 0)
      (let _ (rt-st64 (+ hp 16) 0)
        (let _ (rt-st64 (+ hp 24) 1)
          (let _ (rt-st64 (+ hp 32) kind)
            (let _ (rt-st64 (+ hp 40) block)
              (let _ (rt-st64 (+ hp 48) (if (< align 8) 8 align))
                (let _ (rt-st64 (+ hp 56) limit)
                  (let _ (rt-st64 (+ hp 64) 0) (let _ (ffi-call "%tls-set" "zyl_region_top" hp 1) 0)))))))))))

(defn zyl_region_free (rp) (let _ (if (> (rt-rblocks rp) 0) (rt-region-free-blocks rp) 0) 0))

(defn rt-last-block (b) (if (= (rt-ld64 b) 0) b (rt-last-block (rt-ld64 b))))

; A self tail call: keep the oldest (smallest) block, emptied; release the rest.
(defn zyl_region_recycle (rp)
  (let b (rt-rblocks rp)
    (if (= b 0) 0
      (if (and (= (rt-ld64 b) 0) (= (ffi-call "%load32" (+ b 16) 1) 0))
        ; One pool block: just empty it.
        (let _ (rt-st64 (+ rp 8) (+ b 24)) 0)
      (let keep (rt-last-block b)
        (if (= (ffi-call "%load32" (+ keep 16) 1) 1) (let _ (rt-region-free-blocks rp) 0)
          (let _ (rt-release-chain b keep)
            (let _ (rt-rset-blocks rp keep)
              (let _ (rt-st64 (+ rp 8) (+ keep 24)) (let _ (rt-st64 (+ rp 16) (+ keep (rt-ld64 (+ keep 8)))) 0))))))))))

; Pop and release; the result region never names a dead frame.
(defn zyl_region_exit (rp)
  (let _ (if (> (rt-rblocks rp) 0) (rt-region-free-blocks rp) 0)
    (let _ (ffi-call "%tls-set" "zyl_region_top" (rt-ld64 rp) 1)
      (let _ (if (= (ffi-call "%tls-get" "zyl_cur_region" 1) rp) (ffi-call "%tls-set" "zyl_cur_region" 0 1) 0) 0))))

; Unwinding: release every region pushed after mark.
(defn zyl_region_unwind (mark)
  (let top (ffi-call "%tls-get" "zyl_region_top" 1)
    (if (or (= top 0) (= top mark)) (let _ (ffi-call "%tls-set" "zyl_cur_region" 0 1) 0)
      (let _ (if (> (rt-rblocks top) 0) (rt-region-free-blocks top) 0)
        (let _ (ffi-call "%tls-set" "zyl_region_top" (rt-ld64 top) 1) (zyl_region_unwind mark))))))

(defn zyl_region_mark () (ffi-call "%tls-get" "zyl_region_top" 1))

(defn zyl_region_live_bytes () (rt-ld64 (rt-live)))

; Defines the chain heads generated code names (fs:zyl_cur_region@tpoff); never called.
(defn rt-region-tls () (+ (ffi-call "%tls" "zyl_cur_region" 8 1) (ffi-call "%tls" "zyl_region_top" 8 1)))

; (ffi-pin v): v copied to a stable Pin-arena word; (ffi-unpin p) reads it back, refusing any other pointer.
(defn zyl_ffi_pin (value) (zyl_pin_word value))

(defn zyl_ffi_unpin (ptr)
  (if (= ptr 0) 0
    (if (zyl_pin_owns ptr) (rt-ld64 ptr)
      (let m "zyl: ffi-unpin: pointer not from ffi-pin/Pin arena\n" (let _ (rt-write-fd 2 (rt-w m) (rt-strlen (rt-w m))) 0)))))
