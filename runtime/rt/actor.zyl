; Actors: a thread per spawned body, joined in spawn order at exit; channels (chan.zyl) are the only communication.
(use base)
(use thread)
(use heap)
(use alloc)
(use out)
(use chan)

(extern "zyl_rt_atexit" (Int) Int)
(extern "zyl_rt_try_call" (Int Int) Int)
(extern "zyl_try_push" () Int)

(defmacro ac-ld (a) (ffi-call "%load64" a 1))
(defmacro ac-st (a v) (ffi-call "%store64" a v 1))

; --- the system: {next_id, initialized, exit abandoned}; 1024 slots of {entry, state, thread, joined} ---

(defn ac-max () 1024)
(defn ac-sys () (ffi-call "%global" "actor_sys" 24 1))
(defn ac-slot (id) (+ (ffi-call "%global" "actor_slots" 32768 1) (* id 32)))
(defn ac-inited () (not (= (ac-ld (+ (ac-sys) 8)) 0)))
(defn ac-next () (ac-ld (ac-sys)))

(defn zyl_actor_init ()
  (if (ac-inited) 0
    (let s (ac-sys)
      (let _ (ac-st s 0)
        (let _ (zyl_chan_init)
        (let _ (ac-st (+ s 8) 1)
          (let _ (ffi-call "zyl_rt_atexit" (ffi-call "%fn" "zyl_actor_wait_all" 1) 1) 0)))))))

; An uncaught panic on main: actors are abandoned, their buffered output dropped.
(defn zyl_actor_abandon () (let _ (ac-st (+ (ac-sys) 16) 1) 0))

; Addresses compare unsigned: below 4096 is no pointer.
(defn ac-ptr-p (w) (or (< w 0) (>= w 4096)))

; A capturing lambda is a [2051230803, code, env] triple: spawn its code with its env.
(defn zyl_actor_spawn (entry state)
  (let _ (zyl_actor_init)
    (if (and (ac-ptr-p entry) (= (ac-ld entry) 2051230803))
      (ac-spawn (ac-ld (+ entry 8)) (ac-ld (+ entry 16)) (ac-ld (+ entry 16)))
      (ac-spawn entry state 0))))

; An Actor as its id word (the REPL interpreter's view of a spawn result).
(defn zyl_actor_id (a) a)

; Spawns are serialized by the channel lock's owner bookkeeping; ids are handed out in program order per spawner.
(defn ac-spawn (entry state env)
  (let id (ffi-call "%fetch-add" (ac-sys) 1 1)
    (if (>= id (ac-max)) (ffi-call "zyl_panic" "E_ACTOR_LIMIT: at most 1024 actors per program" 1)
      (let a (ac-slot id)
        (let _ (ac-st a entry)
          (let _ (ac-st (+ a 8) state)
            (let _ (ac-st (+ a 24) 0)
              (let _ (zyl_chan_actor_spawn (+ id 2) env)
                (let _ (zyl_threads_started_mark)
                  (let t (zyl_rt_thread_create (ffi-call "%fn" "zyl_actor_thread_entry" 1) id 0 0)
                    (if (= t 0)
                      (let _ (zyl_chan_actor_done (+ id 2) 0) (ffi-call "zyl_panic" "E_OUT_OF_MEMORY: no thread for an actor" 1))
                      (let _ (ac-st (+ a 16) t) id))))))))))))

; The body under a try frame: a panic ends only this actor, and its message waits for the joiner.
(defn zyl_actor_body ()
  (let a (ac-slot (- (zyl_owner_self) 2)) (ffi-call "%call1" (ac-ld a) (ac-ld (+ a 8)) 1)))

(defn zyl_actor_thread_entry (arg)
  (let _ (bs-altstack 8388608)
  (let id (bit-and arg 4294967295)
    (let _ (zyl_owner_set (+ id 2))
    (let _ (zyl_chan_actor_enter)
      (let f (zyl_try_push)
        (let prev (ac-ld (+ f 64))
          (if (= (ffi-call "zyl_rt_try_call" f (ffi-call "%fn" "zyl_actor_body" 1) 1) 0)
            (let _ (ac-st (ffi-call "%tls" "try_top" 8 1) prev)
              (let _ (zyl_rt_free f) (zyl_chan_actor_done (+ id 2) 0)))
            (let m (ac-ld (+ f 72))
              (let c (rt-strdup (if (= m 0) (rt-w "error") m))
                (let _ (zyl_rt_free f) (zyl_chan_actor_done (+ id 2) (if (= c 0) (rt-w "error") c)))))))))))))

; A known actor id, or -1.
(defn ac-valid (id) (and (ac-inited) (and (>= id 0) (< id (if (> (ac-next) (ac-max)) (ac-max) (ac-next))))))

; Joined means its output is emitted and its panic re-raised here; a second wait does nothing.
(defn zyl_actor_wait (id)
  (if (not (ac-valid id)) 0
    (let a (ac-slot id)
      (if (not (= (ac-ld (+ a 24)) 0)) 0
        (let m (zyl_chan_actor_join (+ id 2))
          (let _ (zyl_rt_thread_join (ac-ld (+ a 16)))
            (let _ (ac-st (+ a 24) 1)
              (let _ (zyl_out_actor_emit (+ id 2))
                (if (= m 0) 0 (ffi-call "zyl_panic" (ffi-call "%str" m 1) 1))))))))))

; Deterministic: true until this program joins the actor.
(defn zyl_actor_is_alive (id) (if (not (ac-valid id)) 0 (if (= (ac-ld (+ (ac-slot id) 24)) 0) 1 0)))

; --- exit: main's channels close, then every unjoined actor is joined in spawn order ---

(defn ac-join-rest (i n first)
  (if (>= i n) first
    (let a (ac-slot i)
      (if (not (= (ac-ld (+ a 24)) 0)) (ac-join-rest (+ i 1) n first)
        (let m (zyl_chan_actor_join (+ i 2))
          (let _ (zyl_rt_thread_join (ac-ld (+ a 16)))
            (let _ (ac-st (+ a 24) 1)
              (let _ (zyl_out_actor_emit (+ i 2))
                (ac-join-rest (+ i 1) n (if (= first 0) m first))))))))))

; The REPL's end of an entry: join every unjoined actor in spawn order, then re-raise the first panic.
(defn zyl_actor_join_unjoined ()
  (if (not (ac-inited)) 0
    (let m (ac-join-rest 0 (if (> (ac-next) (ac-max)) (ac-max) (ac-next)) 0)
      (if (= m 0) 0 (ffi-call "zyl_panic" (ffi-call "%str" m 1) 1)))))

; The first unjoined panic (spawn order) is reported after every actor's output, and the exit code becomes 1.
(defn zyl_actor_wait_all ()
  (if (or (not (ac-inited)) (not (= (ac-ld (+ (ac-sys) 16)) 0))) 0
    (let _ (zyl_chan_main_done)
      (let n (if (> (ac-next) (ac-max)) (ac-max) (ac-next))
        (let m (ac-join-rest 0 n 0)
          (if (= m 0) 0
            (let _ (zyl_out_flush)
              (let _ (zyl_err_puts (rt-w "PANIC: "))
                (let _ (zyl_err_puts m) (let _ (zyl_err_puts (rt-w "\n")) (zyl_chan_exit 1)))))))))))

; --- main on a big stack: mmap ladder 64G..1G with a low guard page, else inline ---

(defn bs-size (i)
  (if (= i 0) 68719476736 (if (= i 1) 17179869184 (if (= i 2) 4294967296 1073741824))))

; ctx: {fn, result}
(defn zyl_bigstack_tramp (ctx)
  (let _ (ac-st (ffi-call "%tls" "is_main" 8 1) 1)
  (let _ (bs-guard-install (ac-ld (+ (bs-info) 8))) (let _ (ac-st (+ ctx 8) (ffi-call "%call0" (ac-ld ctx) 1)) 0))))

; Under a memory budget the stack is part of it: a quarter, at least 64 MiB, charged up front.
(defn bs-cap (sz)
  (let b (rt-budget-limit)
    (if (= b 0) sz
      (let q (/ b 4) (let c (if (< q 67108864) 67108864 q) (if (< c sz) c sz))))))

; --- stack overflow: a fault at the stack's end is E_STACK_OVERFLOW, not a bare SIGSEGV ---

; {guard page, stack size} of main's stack.
(defn bs-info () (ffi-call "%global" "bigstack_info" 16 1))

; This thread's alternate signal stack (in its TLS, so every thread has one)
; and its stack size, for the report.
(defn bs-altstack (size)
  (let ss (ffi-call "%tls" "segv_altstack_t" 24 1)
    (let _ (ac-st (ffi-call "%tls" "stack_size" 8 1) size)
      (let _ (ac-st ss (ffi-call "%tls" "segv_altstack" 32768 1))
        (let _ (ac-st (+ ss 8) 0)
          (let _ (ac-st (+ ss 16) 32768)
            (ffi-call "%syscall2" 131 ss 0 1)))))))

; SIGSEGV on an alternate stack, from main's thread before any actor exists;
; SA_SIGINFO|ONSTACK|RESTORER|NODEFER|RESETHAND.
(defn bs-guard-install (size)
  (let _ (bs-altstack size)
    (let sa (ffi-call "%global" "segv_sigaction" 32 1)
      (let _ (ac-st sa (ffi-call "%fn" "zyl_segv_handler" 1))
        (let _ (ac-st (+ sa 8) (+ 4 (+ 134217728 (+ 67108864 (+ 1073741824 2147483648)))))
          (let _ (ac-st (+ sa 16) (ffi-call "%fn" "zyl_segv_restorer" 1))
            (let _ (ac-st (+ sa 24) 0)
              (ffi-call "%syscall4" 13 11 sa 0 8 1))))))))

; Never reached: the handler does not return. The kernel requires a restorer.
(defn zyl_segv_restorer () (ffi-call "%syscall1" 231 1 1))

; A fault beside the stack pointer, or in main's guard page, is the stack running
; out; anything else is re-raised (the handler is already reset to the default).
(defn zyl_segv_handler (_sig info uc)
  (let addr (ac-ld (+ info 16))
    (let sp (ac-ld (+ uc 160))
      (let g (ac-ld (bs-info))
        (if (or (< (if (> addr sp) (- addr sp) (- sp addr)) 65536)
                (and (> g 0) (and (>= addr g) (< addr (+ g 4096)))))
          (bs-overflow)
          (ffi-call "%syscall2" 62 (ffi-call "%syscall0" 39 1) 11 1))))))

(defn bs-overflow ()
  (let _ (zyl_out_flush)
    (let _ (rt-oom-say "PANIC: error[E_STACK_OVERFLOW]: the stack is full: recursion went deeper than the ")
      (let _ (rt-oom-num (ac-ld (ffi-call "%tls" "stack_size" 8 1)))
        (let _ (rt-oom-say (if (= (ac-ld (ffi-call "%tls" "is_main" 8 1)) 1)
                             "-byte stack\n  = help: make the recursive call a tail call (carry the result in an accumulator), or raise ZYL_MAX_MEMORY; the stack is a quarter of it\n"
                             "-byte stack of an actor\n  = help: make the recursive call a tail call (carry the result in an accumulator); an actor's stack is fixed, so deep work belongs in main\n"))
          (ffi-call "%syscall1" 231 1 1))))))

(defn zyl_call_on_big_stack (f)
  (let ctx (zyl_rt_malloc 24)
    (if (= ctx 0) (ffi-call "%call0" f 1) (let _ (ac-st ctx f) (bs-try f ctx 0)))))

(defn bs-unmap (p sz) (ffi-call "%syscall2" 11 p sz 1))

(defn bs-try (f ctx i)
  (if (>= i 4)
    (let _ (zyl_rt_free ctx) (ffi-call "%call0" f 1))
    (let sz (bs-cap (bs-size i))
      (let p (if (rt-charge sz) (ffi-call "%syscall6" 9 0 sz 3 16418 -1 0 1) -12)
        (if (and (< p 0) (> p -4096)) (let _ (if (= p -12) 0 (rt-refund sz)) (bs-try f ctx (+ i 1)))
          (let _ (ffi-call "%syscall3" 10 p 4096 0 1)
            (let _ (ac-st (bs-info) p)
            (let _ (ac-st (+ (bs-info) 8) sz)
            (let _ (ac-st (+ ctx 8) 0)
              (let h (zyl_rt_thread_create (ffi-call "%fn" "zyl_bigstack_tramp" 1) ctx p sz)
                (if (= h 0) (let _ (bs-unmap p sz) (let _ (rt-refund sz) (bs-try f ctx (+ i 1))))
                  (let _ (zyl_rt_thread_join h)
                    (let _ (bs-unmap p sz)
                      (let _ (rt-refund sz)
                        (let r (ac-ld (+ ctx 8)) (let _ (zyl_rt_free ctx) r))))))))))))))))
