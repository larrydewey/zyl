; The environment (envp from zyl_save_args or a _start), the exit registry and exit_group.
(use base)

(defmacro ev-ld (a) (ffi-call "%load64" a 1))
(defmacro ev-st (a v) (ffi-call "%store64" a v 1))

; --- environment ---

(defn ev-envp-cell () (ffi-call "%global" "rt_envp" 8 1))

; The process's envp (NULL-terminated char*[]); a _start calls this directly.
(defn zyl_rt_set_env (envp) (let _ (ev-st (ev-envp-cell) envp) 0))

(defn zyl_rt_envp () (ev-ld (ev-envp-cell)))

; getenv: the bytes after "name=" in the first matching entry, or 0; "" and NULL are never set.
(defn zyl_rt_getenv (name)
  (if (or (= name 0) (= (rt-ld8 name) 0)) 0
    (let e (zyl_rt_envp) (if (= e 0) 0 (ev-scan e name)))))

(defn ev-scan (e name)
  (let p (ev-ld e)
    (if (= p 0) 0 (let v (ev-match p name) (if (= v 0) (ev-scan (+ e 8) name) v)))))

; Byte by byte, so a short entry is never read past its NUL.
(defn ev-match (p n)
  (let c (rt-ld8 n)
    (if (= c 0) (if (= (rt-ld8 p) 61) (+ p 1) 0)
      (if (= (rt-ld8 p) c) (ev-match (+ p 1) (+ n 1)) 0))))

; --- exit registry: {lock, count, fn[32]}; run newest first, each entry once, as glibc's exit ---

(defn ev-max () 32)
(defn ev-reg () (ffi-call "%global" "rt_exit_reg" 272 1))

(defn ev-lock (g) (if (= (ffi-call "%xchg" g 1 1) 0) 0 (let _ (ffi-call "%syscall0" 24 1) (ev-lock g))))
(defn ev-unlock (g) (ffi-call "%xchg" g 0 1))

; Registers a C-ABI handler (a zyl_* address); 0, or -1 when the registry is full.
(defn zyl_rt_atexit (f)
  (let g (ev-reg)
    (let _ (ev-lock g)
      (let n (ev-ld (+ g 8))
        (if (>= n (ev-max)) (let _ (ev-unlock g) -1)
          (let _ (ev-st (+ g (* (+ n 2) 8)) f) (let _ (ev-st (+ g 8) (+ n 1)) (let _ (ev-unlock g) 0))))))))

; Pops the newest handler under the lock; 0 when none is left.
(defn ev-pop ()
  (let g (ev-reg)
    (let _ (ev-lock g)
      (let n (ev-ld (+ g 8))
        (if (= n 0) (let _ (ev-unlock g) 0)
          (let f (ev-ld (+ g (* (+ n 1) 8))) (let _ (ev-st (+ g 8) (- n 1)) (let _ (ev-unlock g) f))))))))

; Runs every registered handler; the one libc atexit hook and zyl_rt_exit both come here.
(defn zyl_rt_run_atexit () (let f (ev-pop) (if (= f 0) 0 (let _ (ffi-call "%call0" f 1) (zyl_rt_run_atexit)))))

; exit(3) without libc: the handlers, stdout's flush, then exit_group.
(defn zyl_rt_exit (code)
  (let _ (zyl_rt_run_atexit) (let _ (ffi-call "zyl_term_flush" 1) (ev-exit-group code))))

(defn ev-exit-group (code) (let _ (ffi-call "%syscall1" 231 code 1) (let _ (ffi-call "%syscall1" 60 code 1) (ev-exit-group code))))
