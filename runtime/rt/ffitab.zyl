; dlsym(RTLD_DEFAULT, n) when libc is linked (hosted); a freestanding program has no foreign symbols.
(defn ft-dlsym (n)
  (let f (ffi-call "%fn-weak" "dlsym" 1) (if (= f 0) 0 (ffi-call "%call2" f 0 n 1))))
