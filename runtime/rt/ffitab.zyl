; The interpreter's symbol table: runtime entries by name, dlsym for the rest; zyl_call_argv.
(use base)
(use ctab)


(defmacro ft-ld64 (a) (ffi-call "%load64" a 1))
(defmacro ft-st64 (a v) (ffi-call "%store64" a v 1))

; 1024 slots of {name, address}; filled once, then probe-only.
(defn ft-slots () (ffi-call "%global" "ffitab_slots" 16384 1))

(defn ft-probe (t n h)
  (let s (+ t (* h 16))
    (let k (ft-ld64 s)
      (if (or (= k 0) (= (rt-strcmp k n) 0)) s (ft-probe t n (bit-and (+ h 1) 1023))))))

(defn ft-put (t name addr)
  (let n (rt-w name)
    (let s (ft-probe t n (bit-and (rt-str-hash n) 1023))
      (if (= (ft-ld64 s) 0) (let _ (ft-st64 (+ s 8) addr) (ft-st64 s n)) 0))))

; State 0 empty, 1 filling, 2 ready; the first caller fills, the others wait.
(defn ft-table ()
  (let g (ffi-call "%global" "ffitab_state" 8 1)
    (let v (ft-ld64 g)
      (if (= v 2) (ft-slots)
        (if (and (= v 0) (= (ffi-call "%cas" g 0 1 1) 0))
          (let _ (ft-fill (ft-slots)) (let _ (ffi-call "%fence" 1) (let _ (ffi-call "%xchg" g 2 1) (ft-slots))))
          (let _ (ffi-call "%syscall0" 24 1) (ft-table)))))))

; The slot holding name, or 0.
(defn ft-find (n)
  (let s (let t (ft-table) (ft-probe t n (bit-and (rt-str-hash n) 1023)))
    (if (= (ft-ld64 s) 0) 0 s)))

; Whether name is one of this runtime's own entries (the compiler types those itself).
(defn zyl_runtime_export_p (name)
  (let n (rt-w name) (if (= n 0) false (> (ft-find n) 0))))

; Own entries first, then whatever the dynamic loader sees (RTLD_DEFAULT); 0 when neither has it.
(defn zyl_ffi_lookup (name)
  (let n (rt-w name)
    (if (= n 0) 0
      (let s (ft-find n) (if (> s 0) (ft-ld64 (+ s 8)) (ft-dlsym n))))))

(defn zyl_ffi_addr (name) (zyl_ffi_lookup name))

; --- calls through a raw address (never a closure: libc lives above 4 GiB) ---

(defn ft-note (m) (let _ (rt-write-fd 2 (rt-w m) (rt-strlen (rt-w m))) 0))

; Unsigned hex, as printf's %llx.
(defn ft-hex (n acc)
  (let d (str-substring "0123456789abcdef" (bit-and n 15) 1)
    (let r (shr n 4) (if (= r 0) (str-concat d acc) (ft-hex r (str-concat d acc))))))

(defn zyl_call_argv (f argc argv)
  (if (< f 4096) (ft-note (str-concat "zyl: ffi call to invalid address 0x" (str-concat (ft-hex f "") "\n")))
    (if (or (< argc 0) (> argc 6)) (ft-argc-bad argc)
    (if (= argc 0) (ffi-call "%call0" f 1)
      (let a0 (ft-ld64 argv)
        (if (= argc 1) (ffi-call "%call1" f a0 1)
          (let a1 (ft-ld64 (+ argv 8))
            (if (= argc 2) (ffi-call "%call2" f a0 a1 1)
              (let a2 (ft-ld64 (+ argv 16))
                (if (= argc 3) (ffi-call "%call3" f a0 a1 a2 1)
                  (let a3 (ft-ld64 (+ argv 24))
                    (if (= argc 4) (ffi-call "%call4" f a0 a1 a2 a3 1)
                      (let a4 (ft-ld64 (+ argv 32))
                        (if (= argc 5) (ffi-call "%call5" f a0 a1 a2 a3 a4 1)
                          (ffi-call "%call6" f a0 a1 a2 a3 a4 (ft-ld64 (+ argv 40)) 1)))))))))))))))

(defn ft-argc-bad (argc)
  (ft-note (str-concat "zyl: ffi call with " (str-concat (ffi-call "zyl_int_text" argc 1) " arguments (max 6)\n"))))
; --- generated from the C ZYL_FFI_SYMBOLS list: same names, same order ---

