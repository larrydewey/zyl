; The interpreter's test transcript, exit, read-line and the word cells; printing is out.zyl.
(use base)
(use heap)
(use alloc)
(use out)

(extern "zyl_rt_exit" (Int) Int)

(defmacro rt-ld64 (a) (ffi-call "%load64" a 1))
(defmacro rt-st64 (a v) (ffi-call "%store64" a v 1))

(defn io-put (s) (zyl_out_puts (rt-w s)))

; printf's "%s" of NULL.
(defn io-puts-or-null (w) (if (= w 0) (io-put "(null)") (zyl_out_puts w)))

(defn io-put-int (n) (zyl_out_int n))

; --- the lines zyl_run_tests writes, for the interpreter's own runner ---

(defn zyl_itest_start (name)
  (let _ (io-put "test: ") (let _ (io-puts-or-null name) (let _ (io-put " ... ") (zyl_out_flush)))))

(defn zyl_itest_outcome (ok) (io-put (if (= ok 0) "FAIL\n" "ok\n")))

; A failed interpreted test, with the first line of its panic message, as zyl_run_tests writes it.
(defn zyl_itest_fail (msg)
  (let m (rt-w msg)
    (let _ (io-put "FAIL: ") (let _ (io-line m 0) (io-put "\n")))))

(defn io-line (m i)
  (let b (ffi-call "%load8" (+ m i) 1)
    (if (or (= b 0) (= b 10)) 0 (let _ (zyl_out_write (+ m i) 1) (io-line m (+ i 1))))))

(defn zyl_itest_summary (passed failed)
  (let _ (io-put "\ntest result: ")
    (let _ (io-put-int passed)
      (let _ (io-put " passed, ")
        (let _ (io-put-int failed)
          (let _ (io-put " failed, ")
            (let _ (io-put-int (+ passed failed))
              (let _ (io-put " total\n") (if (> failed 0) 1 0)))))))))

; (exit code): flush, then end the process.
(defn zyl_exit (code)
  (let _ (zyl_out_flush) (ffi-call "zyl_rt_exit" code 1)))

; (read-line): one line from stdin without its newline (or a trailing CR); "" at end of input.
(defn zyl_read_line ()
  (let _ (zyl_out_flush)
    (let buf (zyl_rt_malloc 128)
      (if (= buf 0) (rt-w "")
        (let r (io-read-loop buf 128 0)
          (let b (rt-ld64 r)
            (let n0 (rt-ld64 (+ r 8))
              (let n (if (and (> n0 0) (= (rt-ld8 (+ b (- n0 1))) 13)) (- n0 1) n0)
                (let out (rt-w (zyl_heap_alloc (+ n 1)))
                  (let _ (if (= out 0) 0 (let _ (rt-copy out b n) (rt-st8 (+ out n) 0)))
                    (let _ (zyl_rt_free b)
                      (if (= out 0) (rt-w "") out))))))))))))

; Bytes until newline or end of input; the result {buf, n} is a per-thread pair.
(defn io-read-loop (buf cap n)
  (let c (ffi-call "%tls" "io_rl" 24 1)
    (if (and (= (ffi-call "%syscall3" 0 0 (+ c 16) 1 1) 1) (not (= (rt-ld8 (+ c 16)) 10)))
      (if (>= (+ n 1) cap)
        (let nb (zyl_rt_realloc buf (* cap 2))
          (if (= nb 0) (io-read-done c buf n)
            (let _ (rt-st8 (+ nb n) (rt-ld8 (+ c 16))) (io-read-loop nb (* cap 2) (+ n 1)))))
        (let _ (rt-st8 (+ buf n) (rt-ld8 (+ c 16))) (io-read-loop buf cap (+ n 1))))
      (io-read-done c buf n))))

(defn io-read-done (c buf n) (let _ (rt-st64 c buf) (let _ (rt-st64 (+ c 8) n) c)))

; --- sixteen process-wide word cells for compiler passes ---

(defn io-cells () (ffi-call "%global" "cells" 128 1))
(defn zyl_cell_get (i) (if (and (>= i 0) (< i 16)) (rt-ld64 (+ (io-cells) (* i 8))) 0))
(defn zyl_cell_set (i v) (let _ (if (and (>= i 0) (< i 16)) (rt-st64 (+ (io-cells) (* i 8)) v) 0) 0))
