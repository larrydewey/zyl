; Start-up and shutdown: the stack limit, the arenas, the exit-time teardown; stdio's flush and atexit.
(use base)

(extern "atexit" (Int) Int)
(extern "zyl_rt_atexit" (Int) Int)
(extern "fflush" (Int) Int)
(extern "zyl_arenas_init" () Int)
(extern "zyl_arenas_destroy" () Int)
(extern "zyl_ffi_abandoned" () Int)

(defmacro sr-ld64 (a) (ffi-call "%load64" a 1))
(defmacro sr-st64 (a v) (ffi-call "%store64" a v 1))

(defn sr-ult (a b) (< (bit-xor a (- -9223372036854775807 1)) (bit-xor b (- -9223372036854775807 1))))

; RLIMIT_STACK's soft limit up to the hard one, so deep recursion can grow past 8 MB.
(defn sr-raise-stack-limit ()
  (let rl (ffi-call "%tls" "start_rlimit" 16 1)
    (if (and (= (ffi-call "%syscall2" 97 3 rl 1) 0) (sr-ult (sr-ld64 rl) (sr-ld64 (+ rl 8))))
      (let _ (sr-st64 rl (sr-ld64 (+ rl 8))) (let _ (ffi-call "%syscall2" 160 3 rl 1) 0))
      0)))

; Every generated main calls this first; the teardown is registered before the actor drain, so it runs after it.
; libc's exit (main returning to crt) reaches the registry through the one libc atexit hook.
(defn zyl_ensure_arenas ()
  (let g (ffi-call "%global" "start_once" 8 1)
    (let _ (if (= (sr-ld64 g) 0)
             (let _ (sr-st64 g 1)
               (let _ (sr-raise-stack-limit) (let _ (ffi-call "atexit" (ffi-call "%fn" "zyl_rt_run_atexit" 1) 1) (ffi-call "zyl_rt_atexit" (ffi-call "%fn" "zyl_runtime_cleanup" 1) 1))))
             0)
      (let _ (ffi-call "%call0" (ffi-call "%fn" "zyl_actor_init" 1) 1) (let _ (ffi-call "zyl_arenas_init" 1) 0)))))

; An abandoned FFI call may still be using arena memory.
(defn zyl_runtime_cleanup ()
  (if (= (bit-and (ffi-call "zyl_ffi_abandoned" 1) 4294967295) 0) (let _ (ffi-call "zyl_arenas_destroy" 1) 0) 0))

(defn zyl_term_flush () (let _ (ffi-call "fflush" (sr-ld64 (ffi-call "%fn" "stdout" 1)) 1) 0))

; Registers the terminal restore handler (os.zyl calls this once, on the first raw_on).
(defn zyl_term_atexit () (let _ (ffi-call "zyl_rt_atexit" (ffi-call "%fn" "zyl_term_restore_atexit" 1) 1) 0))
