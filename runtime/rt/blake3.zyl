; BLAKE3 (one implementation on the build path: labels, archive, lock and graph hashes).
(use base)

(extern "malloc" (Int) Int)
(extern "free" (Int) Int)

(defmacro b3-ld (a) (ffi-call "%load32" a 1))
(defmacro b3-st (a v) (ffi-call "%store32" a v 1))
(defmacro b3-m (blk i) (ffi-call "%load32" (+ blk (* i 4)) 1))
; rotr32 of the low 32 bits of x (mask = 2^(32-n)-1, p = 2^(32-n)); words stay unmasked until store32.
(defmacro b3-rotr (x n mask p) (bit-or (bit-and (shr x n) mask) (* x p)))

; The G mix; a b c d are state names rebound for body.
(defmacro b3-g (a b c d mx my body)
  (let a (+ (+ a b) mx)
    (let d (let _t (bit-xor d a) (b3-rotr _t 16 65535 65536))
      (let c (+ c d)
        (let b (let _t (bit-xor b c) (b3-rotr _t 12 1048575 1048576))
          (let a (+ (+ a b) my)
            (let d (let _t (bit-xor d a) (b3-rotr _t 8 16777215 16777216))
              (let c (+ c d)
                (let b (let _t (bit-xor b c) (b3-rotr _t 7 33554431 33554432)) body)))))))))

; Hasher layout (bytes): cv stack 54x32, then scalars and scratch blocks.
(defmacro b3-slen (h) (+ h 1728))
(defmacro b3-ccv (h) (+ h 1736))
(defmacro b3-ctr (h) (+ h 1768))
(defmacro b3-buf (h) (+ h 1776))
(defmacro b3-blen (h) (+ h 1840))
(defmacro b3-blks (h) (+ h 1848))
(defmacro b3-out (h) (+ h 1856))
(defmacro b3-par (h) (+ h 1920))
(defmacro b3-iv (h) (+ h 2016))
(defmacro b3-fcv (h) (+ h 2048))
(defmacro b3-fblk (h) (+ h 2080))
(defmacro b3-dig (h) (+ h 2144))
(defn b3-size () 2208)

(defmacro b3-get (a) (ffi-call "%load64" a 1))
(defmacro b3-set (a v) (ffi-call "%store64" a v 1))

; One compression: 16 state words in registers, message words read from blk; 16 words to out.
(defn b3-compress (cv blk ctr blen flags out)
(let _v0 (ffi-call "%load32" (+ cv 0) 1)
(let _v1 (ffi-call "%load32" (+ cv 4) 1)
(let _v2 (ffi-call "%load32" (+ cv 8) 1)
(let _v3 (ffi-call "%load32" (+ cv 12) 1)
(let _v4 (ffi-call "%load32" (+ cv 16) 1)
(let _v5 (ffi-call "%load32" (+ cv 20) 1)
(let _v6 (ffi-call "%load32" (+ cv 24) 1)
(let _v7 (ffi-call "%load32" (+ cv 28) 1)
(let _v8 1779033703
(let _v9 3144134277
(let _v10 1013904242
(let _v11 2773480762
(let _v12 (bit-and ctr 4294967295)
(let _v13 (bit-and (shr ctr 32) 4294967295)
(let _v14 blen
(let _v15 flags
(b3-g _v0 _v4 _v8 _v12 (b3-m blk 0) (b3-m blk 1)
(b3-g _v1 _v5 _v9 _v13 (b3-m blk 2) (b3-m blk 3)
(b3-g _v2 _v6 _v10 _v14 (b3-m blk 4) (b3-m blk 5)
(b3-g _v3 _v7 _v11 _v15 (b3-m blk 6) (b3-m blk 7)
(b3-g _v0 _v5 _v10 _v15 (b3-m blk 8) (b3-m blk 9)
(b3-g _v1 _v6 _v11 _v12 (b3-m blk 10) (b3-m blk 11)
(b3-g _v2 _v7 _v8 _v13 (b3-m blk 12) (b3-m blk 13)
(b3-g _v3 _v4 _v9 _v14 (b3-m blk 14) (b3-m blk 15)
(b3-g _v0 _v4 _v8 _v12 (b3-m blk 2) (b3-m blk 6)
(b3-g _v1 _v5 _v9 _v13 (b3-m blk 3) (b3-m blk 10)
(b3-g _v2 _v6 _v10 _v14 (b3-m blk 7) (b3-m blk 0)
(b3-g _v3 _v7 _v11 _v15 (b3-m blk 4) (b3-m blk 13)
(b3-g _v0 _v5 _v10 _v15 (b3-m blk 1) (b3-m blk 11)
(b3-g _v1 _v6 _v11 _v12 (b3-m blk 12) (b3-m blk 5)
(b3-g _v2 _v7 _v8 _v13 (b3-m blk 9) (b3-m blk 14)
(b3-g _v3 _v4 _v9 _v14 (b3-m blk 15) (b3-m blk 8)
(b3-g _v0 _v4 _v8 _v12 (b3-m blk 3) (b3-m blk 4)
(b3-g _v1 _v5 _v9 _v13 (b3-m blk 10) (b3-m blk 12)
(b3-g _v2 _v6 _v10 _v14 (b3-m blk 13) (b3-m blk 2)
(b3-g _v3 _v7 _v11 _v15 (b3-m blk 7) (b3-m blk 14)
(b3-g _v0 _v5 _v10 _v15 (b3-m blk 6) (b3-m blk 5)
(b3-g _v1 _v6 _v11 _v12 (b3-m blk 9) (b3-m blk 0)
(b3-g _v2 _v7 _v8 _v13 (b3-m blk 11) (b3-m blk 15)
(b3-g _v3 _v4 _v9 _v14 (b3-m blk 8) (b3-m blk 1)
(b3-g _v0 _v4 _v8 _v12 (b3-m blk 10) (b3-m blk 7)
(b3-g _v1 _v5 _v9 _v13 (b3-m blk 12) (b3-m blk 9)
(b3-g _v2 _v6 _v10 _v14 (b3-m blk 14) (b3-m blk 3)
(b3-g _v3 _v7 _v11 _v15 (b3-m blk 13) (b3-m blk 15)
(b3-g _v0 _v5 _v10 _v15 (b3-m blk 4) (b3-m blk 0)
(b3-g _v1 _v6 _v11 _v12 (b3-m blk 11) (b3-m blk 2)
(b3-g _v2 _v7 _v8 _v13 (b3-m blk 5) (b3-m blk 8)
(b3-g _v3 _v4 _v9 _v14 (b3-m blk 1) (b3-m blk 6)
(b3-g _v0 _v4 _v8 _v12 (b3-m blk 12) (b3-m blk 13)
(b3-g _v1 _v5 _v9 _v13 (b3-m blk 9) (b3-m blk 11)
(b3-g _v2 _v6 _v10 _v14 (b3-m blk 15) (b3-m blk 10)
(b3-g _v3 _v7 _v11 _v15 (b3-m blk 14) (b3-m blk 8)
(b3-g _v0 _v5 _v10 _v15 (b3-m blk 7) (b3-m blk 2)
(b3-g _v1 _v6 _v11 _v12 (b3-m blk 5) (b3-m blk 3)
(b3-g _v2 _v7 _v8 _v13 (b3-m blk 0) (b3-m blk 1)
(b3-g _v3 _v4 _v9 _v14 (b3-m blk 6) (b3-m blk 4)
(b3-g _v0 _v4 _v8 _v12 (b3-m blk 9) (b3-m blk 14)
(b3-g _v1 _v5 _v9 _v13 (b3-m blk 11) (b3-m blk 5)
(b3-g _v2 _v6 _v10 _v14 (b3-m blk 8) (b3-m blk 12)
(b3-g _v3 _v7 _v11 _v15 (b3-m blk 15) (b3-m blk 1)
(b3-g _v0 _v5 _v10 _v15 (b3-m blk 13) (b3-m blk 3)
(b3-g _v1 _v6 _v11 _v12 (b3-m blk 0) (b3-m blk 10)
(b3-g _v2 _v7 _v8 _v13 (b3-m blk 2) (b3-m blk 6)
(b3-g _v3 _v4 _v9 _v14 (b3-m blk 4) (b3-m blk 7)
(b3-g _v0 _v4 _v8 _v12 (b3-m blk 11) (b3-m blk 15)
(b3-g _v1 _v5 _v9 _v13 (b3-m blk 5) (b3-m blk 0)
(b3-g _v2 _v6 _v10 _v14 (b3-m blk 1) (b3-m blk 9)
(b3-g _v3 _v7 _v11 _v15 (b3-m blk 8) (b3-m blk 6)
(b3-g _v0 _v5 _v10 _v15 (b3-m blk 14) (b3-m blk 10)
(b3-g _v1 _v6 _v11 _v12 (b3-m blk 2) (b3-m blk 12)
(b3-g _v2 _v7 _v8 _v13 (b3-m blk 3) (b3-m blk 4)
(b3-g _v3 _v4 _v9 _v14 (b3-m blk 7) (b3-m blk 13)
(let _ (ffi-call "%store32" (+ out 32) (bit-xor _v8 (ffi-call "%load32" (+ cv 0) 1)) 1)
(let _ (ffi-call "%store32" (+ out 36) (bit-xor _v9 (ffi-call "%load32" (+ cv 4) 1)) 1)
(let _ (ffi-call "%store32" (+ out 40) (bit-xor _v10 (ffi-call "%load32" (+ cv 8) 1)) 1)
(let _ (ffi-call "%store32" (+ out 44) (bit-xor _v11 (ffi-call "%load32" (+ cv 12) 1)) 1)
(let _ (ffi-call "%store32" (+ out 48) (bit-xor _v12 (ffi-call "%load32" (+ cv 16) 1)) 1)
(let _ (ffi-call "%store32" (+ out 52) (bit-xor _v13 (ffi-call "%load32" (+ cv 20) 1)) 1)
(let _ (ffi-call "%store32" (+ out 56) (bit-xor _v14 (ffi-call "%load32" (+ cv 24) 1)) 1)
(let _ (ffi-call "%store32" (+ out 60) (bit-xor _v15 (ffi-call "%load32" (+ cv 28) 1)) 1)
(let _ (ffi-call "%store32" (+ out 0) (bit-xor _v0 _v8) 1)
(let _ (ffi-call "%store32" (+ out 4) (bit-xor _v1 _v9) 1)
(let _ (ffi-call "%store32" (+ out 8) (bit-xor _v2 _v10) 1)
(let _ (ffi-call "%store32" (+ out 12) (bit-xor _v3 _v11) 1)
(let _ (ffi-call "%store32" (+ out 16) (bit-xor _v4 _v12) 1)
(let _ (ffi-call "%store32" (+ out 20) (bit-xor _v5 _v13) 1)
(let _ (ffi-call "%store32" (+ out 24) (bit-xor _v6 _v14) 1)
(let _ (ffi-call "%store32" (+ out 28) (bit-xor _v7 _v15) 1) out)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))

(defn b3-zero64 (p i) (if (>= i 64) p (let _ (b3-set (+ p i) 0) (b3-zero64 p (+ i 8)))))

(defn b3-init (h)
  (let _ (b3-set (b3-slen h) 0)
    (let _ (b3-set (b3-ctr h) 0)
      (let _ (b3-set (b3-blen h) 0)
        (let _ (b3-set (b3-blks h) 0)
          (let _ (b3-zero64 (b3-buf h) 0)
            (let iv (b3-iv h)
              (let _ (b3-st iv 1779033703)
                (let _ (b3-st (+ iv 4) 3144134277)
                  (let _ (b3-st (+ iv 8) 1013904242)
                    (let _ (b3-st (+ iv 12) 2773480762)
                      (let _ (b3-st (+ iv 16) 1359893119)
                        (let _ (b3-st (+ iv 20) 2600822924)
                          (let _ (b3-st (+ iv 24) 528734635)
                            (let _ (b3-st (+ iv 28) 1541459225)
                              (let _ (rt-copy (b3-ccv h) iv 32) h))))))))))))))))

(defn b3-start-flag (h) (if (= (b3-get (b3-blks h)) 0) 1 0))

; Folds cv (32 bytes at p) into the stack, merging while total_chunks is even.
(defn b3-push-cv (h p total)
  (let n (b3-get (b3-slen h))
    (if (and (= (bit-and total 1) 0) (> n 0))
      (let par (b3-par h)
        (let _ (rt-copy par (+ h (* (- n 1) 32)) 32)
          (let _ (rt-copy (+ par 32) p 32)
            (let _ (b3-set (b3-slen h) (- n 1))
              (let _ (b3-compress (b3-iv h) par 0 64 4 (b3-out h))
                (b3-push-cv h (b3-out h) (shr total 1)))))))
      (let _ (rt-copy (+ h (* n 32)) p 32) (b3-set (b3-slen h) (+ n 1))))))

; The buffer is full: close the chunk (16th block) or compress one block.
(defn b3-flush (h)
  (let ctr (b3-get (b3-ctr h))
    (let _ (if (= (b3-get (b3-blks h)) 15)
             (let _ (b3-compress (b3-ccv h) (b3-buf h) ctr 64 (bit-or (b3-start-flag h) 2) (b3-out h))
               (let _ (b3-push-cv h (b3-out h) (+ ctr 1))
                 (let _ (b3-set (b3-ctr h) (+ ctr 1))
                   (let _ (rt-copy (b3-ccv h) (b3-iv h) 32) (b3-set (b3-blks h) 0)))))
             (let _ (b3-compress (b3-ccv h) (b3-buf h) ctr 64 (b3-start-flag h) (b3-out h))
               (let _ (rt-copy (b3-ccv h) (b3-out h) 32) (b3-set (b3-blks h) (+ (b3-get (b3-blks h)) 1)))))
      (let _ (b3-set (b3-blen h) 0) (b3-zero64 (b3-buf h) 0)))))

(defn b3-update (h p n)
  (if (<= n 0) h
    (let _ (if (= (b3-get (b3-blen h)) 64) (b3-flush h) 0)
      (let bl (b3-get (b3-blen h))
        (let take (if (> (- 64 bl) n) n (- 64 bl))
          (let _ (rt-copy (+ (b3-buf h) bl) p take)
            (let _ (b3-set (b3-blen h) (+ bl take))
              (b3-update h (+ p take) (- n take)))))))))

; Folds the stack innermost first; each fold becomes the output node.
(defn b3-fold (h k ctr blen flags len)
  (if (= k 0) (b3-emit h 0 blen (bit-or flags 8) 0 len)
    (let fb (b3-fblk h)
      (let _ (b3-compress (b3-fcv h) fb ctr blen flags (b3-out h))
        (let _ (rt-copy fb (+ h (* (- k 1) 32)) 32)
          (let _ (rt-copy (+ fb 32) (b3-out h) 32)
            (let _ (rt-copy (b3-fcv h) (b3-iv h) 32)
              (b3-fold h (- k 1) 0 64 4 len))))))))

; Root output blocks, counter obc, until len digest bytes are written.
(defn b3-emit (h obc blen flags off len)
  (if (>= off len) h
    (let _ (b3-compress (b3-fcv h) (b3-fblk h) obc blen flags (b3-out h))
      (let take (if (> (- len off) 64) 64 (- len off))
        (let _ (rt-copy (+ (b3-dig h) off) (b3-out h) take)
          (b3-emit h (+ obc 1) blen flags (+ off take) len))))))

; Writes out_len (1..64) digest bytes at b3-dig.
(defn b3-finalize (h out-len)
  (let _ (rt-copy (b3-fcv h) (b3-ccv h) 32)
    (let _ (rt-copy (b3-fblk h) (b3-buf h) 64)
      (b3-fold h (b3-get (b3-slen h)) (b3-get (b3-ctr h)) (b3-get (b3-blen h)) (bit-or (b3-start-flag h) 2) out-len))))

; A fresh hasher, or 0 when malloc fails.
(defn b3-new () (let h (ffi-call "malloc" (b3-size) 1) (if (= h 0) 0 (b3-init h))))

; BLAKE3 of n bytes at p into len bytes at dst; false when out of memory.
(defn rt-blake3-raw (p n dst len)
  (let h (b3-new)
    (if (= h 0) false
      (let _ (b3-update h p n)
        (let _ (b3-finalize h len)
          (let _ (rt-copy dst (b3-dig h) len) (let _ (ffi-call "free" h 1) true)))))))

(defn b3-hexdigits () "0123456789abcdef")

(defn rt-hex-bytes (d g i n)
  (if (>= i n) d
    (let b (rt-ld8 (+ g i))
      (let x (rt-w (b3-hexdigits))
        (let _ (rt-st8 (+ d (* i 2)) (rt-ld8 (+ x (shr b 4))))
          (let _ (rt-st8 (+ d (+ (* i 2) 1)) (rt-ld8 (+ x (bit-and b 15))))
            (rt-hex-bytes d g (+ i 1) n)))))))

(defn b3-clamp (ob) (if (<= ob 0) 32 (if (> ob 64) 64 ob)))

; Lowercase hex of the finished hasher, in the arena; frees h.
(defn b3-hex-out (arena h ob)
  (let _ (b3-finalize h ob)
    (let d (rt-w (ffi-call "zyl_arena_alloc_zeroed" arena (+ (* ob 2) 1) 1))
      (let _ (rt-hex-bytes d (b3-dig h) 0 ob)
        (let _ (rt-st8 (+ d (* ob 2)) 0)
          (let _ (ffi-call "free" h 1) (ffi-call "%str" d 1)))))))

; BLAKE3 over src[0..len) as outbytes bytes of lowercase hex; len < 0 means strlen.
(defn zyl_blake3_hex (arena src len outbytes)
  (let s (rt-w src)
    (if (= s 0) (ffi-call "%str" 0 1)
      (let n (if (< len 0) (rt-strlen s) len)
        (let h (b3-new)
          (if (= h 0) (ffi-call "%str" 0 1)
            (let _ (b3-update h s n) (b3-hex-out arena h (b3-clamp outbytes)))))))))

; read(2) to end of file; an error ends the stream as fread's short count did.
(defn b3-read-all (h fd buf)
  (let got (ffi-call "%syscall3" 0 fd buf 65536 1)
    (if (> got 0) (let _ (b3-update h buf got) (b3-read-all h fd buf)) (if (= got -4) (b3-read-all h fd buf) h))))

; BLAKE3 of a file's contents as lowercase hex, streamed; 0 if it cannot be opened.
(defn zyl_blake3_file_hex (arena path outbytes)
  (let p (rt-w path)
    (if (= p 0) (ffi-call "%str" 0 1)
      (let f (ffi-call "%syscall3" 2 p 0 0 1)
        (if (< f 0) (ffi-call "%str" 0 1)
          (let h (b3-new)
            (let buf (if (= h 0) 0 (ffi-call "malloc" 65536 1))
              (if (= buf 0)
                (let _ (if (= h 0) 0 (ffi-call "free" h 1)) (let _ (ffi-call "%syscall1" 3 f 1) (ffi-call "%str" 0 1)))
                (let _ (b3-read-all h f buf)
                  (let _ (ffi-call "free" buf 1)
                    (let _ (ffi-call "%syscall1" 3 f 1) (b3-hex-out arena h (b3-clamp outbytes)))))))))))))
