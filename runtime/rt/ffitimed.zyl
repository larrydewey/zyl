; Timed FFI: a foreign call runs on the caller's worker thread; an overrun raises E_FFI_TIMEOUT and is abandoned, never killed.
(use base)
(use out)
(use thread)
(use heap)
(use alloc)
(use actor)


(defmacro ff-ld (a) (ffi-call "%load64" a 1))
(defmacro ff-st (a v) (ffi-call "%store64" a v 1))

; worker: lock 0, cond 8, state 16 (0 idle, 1 pending, 2 done), abandoned 24, self_id 32, fn 40, argc 48, argv 56 (16 words), result 184

(defn ff-worker-cell () (ffi-call "%tls" "ffi_worker" 8 1))
(defn ff-on-worker-cell () (ffi-call "%tls" "ffi_on_worker" 8 1))
(defn ff-any-abandoned () (ffi-call "%global" "ffi_any_abandoned" 8 1))

(defn zyl_ffi_abandoned () (ff-ld (ff-any-abandoned)))
(defn zyl_ffi_on_worker () (ff-ld (ff-on-worker-cell)))

(defn ff-lock (w) (zyl_rt_mutex_lock (ff-ld w)))
(defn ff-unlock (w) (zyl_rt_mutex_unlock (ff-ld w)))
(defn ff-cond (w) (ff-ld (+ w 8)))

; fn with exactly argc words from a; above 7 through the C bridge (no %call8+ primitive yet).
(defn ff-invoke (f argc a)
  (if (= argc 0) (ffi-call "%call0" f 1)
  (if (= argc 1) (ffi-call "%call1" f (ff-ld a) 1)
  (if (= argc 2) (ffi-call "%call2" f (ff-ld a) (ff-ld (+ a 8)) 1)
  (if (= argc 3) (ffi-call "%call3" f (ff-ld a) (ff-ld (+ a 8)) (ff-ld (+ a 16)) 1)
  (if (= argc 4) (ffi-call "%call4" f (ff-ld a) (ff-ld (+ a 8)) (ff-ld (+ a 16)) (ff-ld (+ a 24)) 1)
  (if (= argc 5) (ffi-call "%call5" f (ff-ld a) (ff-ld (+ a 8)) (ff-ld (+ a 16)) (ff-ld (+ a 24)) (ff-ld (+ a 32)) 1)
  (if (= argc 6) (ffi-call "%call6" f (ff-ld a) (ff-ld (+ a 8)) (ff-ld (+ a 16)) (ff-ld (+ a 24)) (ff-ld (+ a 32)) (ff-ld (+ a 40)) 1)
  (if (= argc 7) (ffi-call "%call7" f (ff-ld a) (ff-ld (+ a 8)) (ff-ld (+ a 16)) (ff-ld (+ a 24)) (ff-ld (+ a 32)) (ff-ld (+ a 40)) (ff-ld (+ a 48)) 1)
    (zyl_ffi_invoke_wide f argc a))))))))))

(defn zyl_ffi_worker_main (w)
  (let _ (zyl_owner_set (ff-ld (+ w 32)))
    (let _ (ff-st (ff-on-worker-cell) 1)
      (let _ (ff-lock w) (ff-serve w)))))

; Locked: runs each request; an abandoned worker frees itself after its call returns.
(defn ff-serve (w)
  (if (not (= (ff-ld (+ w 16)) 1))
    (let _ (zyl_rt_cond_wait (ff-cond w) (ff-ld w)) (ff-serve w))
    (let f (ff-ld (+ w 40))
      (let argc (ff-ld (+ w 48))
        (let a (ffi-call "%tls" "ffi_args" 128 1)
          (let _ (rt-copy a (+ w 56) 128)
            (let _ (ff-unlock w)
              (let r (ff-invoke f argc a)
                (let _ (ff-lock w)
                  (let _ (ff-st (+ w 184) r)
                    (let _ (ff-st (+ w 16) 2)
                      (if (not (= (ff-ld (+ w 24)) 0))
                        (ff-finish w)
                        (let _ (zyl_rt_cond_broadcast (ff-cond w)) (ff-serve w))))))))))))))

(defn ff-finish (w)
  (let m (ff-ld w)
    (let c (ff-cond w)
      (let _ (zyl_rt_mutex_unlock m)
        (let _ 0
          (let _ 0
            (let _ (zyl_rt_free c)
              (let _ (zyl_rt_free m)
                (let _ (zyl_rt_free w) 0)))))))))

(defn ff-oom () (ffi-call "zyl_panic" "E_OUT_OF_MEMORY: no memory for an FFI worker" 1))

(defn ff-worker-get ()
  (let c (ff-worker-cell)
    (let w (ff-ld c) (if (= w 0) (ff-worker-new c) w))))

; futex mutex and cond words (malloc'd and checked); the worker is a detached runtime thread.
(defn ff-worker-new (cell)
  (let w (zyl_rt_calloc 1 192)
    (if (= w 0) (ff-oom)
      (let m (zyl_rt_malloc 40)
        (let c (zyl_rt_malloc 48)
          (let ca (zyl_rt_malloc 8)
            (let at (zyl_rt_malloc 56)
              (if (or (or (= m 0) (= c 0)) (or (= ca 0) (= at 0))) (ff-oom)
                (let _ (ffi-call "%store64" m 0 1)
                  (let _ 0
                    (let _ 0
                      (let _ (ffi-call "%store64" c 0 1)
                        (let _ 0
                          (let _ (zyl_rt_free ca)
                            (let _ (ff-st w m)
                              (let _ (ff-st (+ w 8) c)
                                (let _ (ff-st (+ w 32) (zyl_owner_self))
                                  (ff-start cell w at))))))))))))))))))

(defn ff-start (cell w at)
  (let _ (zyl_threads_started_mark)
    (let h (zyl_rt_thread_create (ffi-call "%fn" "zyl_ffi_worker_main" 1) w 0 0)
      (let _ (zyl_rt_free at)
        (if (= h 0) (ffi-call "zyl_panic" "E_FFI_TIMEOUT: could not start the FFI worker thread" 1)
          (let _ (zyl_rt_thread_detach h) (let _ (ffi-call "%store64" (ffi-call "%tls" "ffi_tid" 8 1) h 1) (let _ (ff-st cell w) w))))))))

; CLOCK_MONOTONIC now plus ms, normalised.
(defn ff-deadline (ms)
  (let ts (ffi-call "%tls" "ffi_ts" 16 1)
    (let _ (ffi-call "%syscall2" 228 1 ts 1)
      (let s (+ (ff-ld ts) (/ ms 1000))
        (let ns (+ (ff-ld (+ ts 8)) (* (% ms 1000) 1000000))
          (if (>= ns 1000000000)
            (let _ (ff-st ts (+ s 1)) (let _ (ff-st (+ ts 8) (- ns 1000000000)) ts))
            (let _ (ff-st ts s) (let _ (ff-st (+ ts 8) ns) ts))))))))

(defn ff-copy-args (dst src argc i)
  (if (>= i argc) 0 (let _ (ff-st (+ dst (* i 8)) (ff-ld (+ src (* i 8)))) (ff-copy-args dst src argc (+ i 1)))))

; src holds the argc (at most 16) argument words; both stdio buffers are flushed around the call, so output stays in order.
(defn ff-core (f name ms0 argc src)
  (let _ (zyl_out_flush) (let r (ff-core-go f name ms0 argc src) (let _ (ff-libc-flush) r))))

(defn ff-libc-flush () (let f (ffi-call "%fn-weak" "fflush" 1) (if (> f 0) (ffi-call "%call1" f 0 1) 0)))

(defn ff-core-go (f name ms0 argc src)
  (let sym (if (= name 0) "?" (ffi-call "%str" name 1))
    (if (< f 4096)
      (ffi-call "zyl_panic" (str-concat "E_FFI_SYMBOL_NOT_FOUND: no such FFI symbol: " sym) 1)
      (if (or (< argc 0) (> argc 16))
        (ffi-call "zyl_panic" "E_ARITY_MISMATCH: ffi-call passes more than 16 arguments" 1)
        (let ms (if (< ms0 1) 1 ms0)
          (let w (ff-worker-get)
            (let ts (ff-deadline ms)
              (let _ (ff-lock w)
                (let _ (ff-st (+ w 40) f)
                  (let _ (ff-st (+ w 48) argc)
                    (let _ (ffi-call "%fill" (+ w 56) 0 128 1)
                      (let _ (ff-copy-args (+ w 56) src argc 0)
                        (let _ (ff-st (+ w 16) 1)
                          (let _ (zyl_rt_cond_broadcast (ff-cond w))
                            (ff-await w ts sym ms)))))))))))))))

; Locked: waits for the result until the deadline; a timeout abandons the worker.
(defn ff-await (w ts sym ms)
  (if (= (ff-ld (+ w 16)) 2)
    (let r (ff-ld (+ w 184)) (let _ (ff-st (+ w 16) 0) (let _ (ff-unlock w) r)))
    (let rc (bit-and (zyl_rt_cond_timedwait (ff-cond w) (ff-ld w) ts) 4294967295)
      (if (and (= rc 110) (not (= (ff-ld (+ w 16)) 2)))
        (let _ (ff-st (+ w 24) 1)
          (let _ (ff-unlock w)
            (let _ (ff-st (ff-worker-cell) 0)
              (let _ (ffi-call "%xchg" (ff-any-abandoned) 1 1)
                (ffi-call "zyl_panic" (str-concat "E_FFI_TIMEOUT: ffi call `" (str-concat sym (str-concat "` exceeded its timeout of " (str-concat (ffi-call "zyl_int_text" ms 1) " ms")))) 1)))))
        (ff-await w ts sym ms)))))

; The words past argc are not read.
(defn ff-in-args (a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15)
  (let b (ffi-call "%tls" "ffi_in" 128 1)
    (let _ (ff-st b a0) (let _ (ff-st (+ b 8) a1) (let _ (ff-st (+ b 16) a2) (let _ (ff-st (+ b 24) a3)
    (let _ (ff-st (+ b 32) a4) (let _ (ff-st (+ b 40) a5) (let _ (ff-st (+ b 48) a6) (let _ (ff-st (+ b 56) a7)
    (let _ (ff-st (+ b 64) a8) (let _ (ff-st (+ b 72) a9) (let _ (ff-st (+ b 80) a10) (let _ (ff-st (+ b 88) a11)
    (let _ (ff-st (+ b 96) a12) (let _ (ff-st (+ b 104) a13) (let _ (ff-st (+ b 112) a14) (let _ (ff-st (+ b 120) a15)
      b))))))))))))))))))

; Called with 4 + argc words (C varargs at the call site); only the first argc argument slots are read.
(defn zyl_ffi_timed (f name ms argc a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15)
  (ff-core f name ms argc (ff-in-args a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15)))

; The interpreter's entry: the argument words in an array.
(defn zyl_ffi_timed_argv (f name ms argc argv)
  (let b (ffi-call "%tls" "ffi_in" 128 1)
    (let _ (ff-copy-args b argv (if (> argc 16) 16 argc) 0)
      (ff-core f name ms argc b))))

; A foreign call with 8..16 words from argv (argc above 16 calls with 16, as the C did).
(defmacro fw (a i) (ffi-call "%load64" (+ a (* i 8)) 1))

(defn zyl_ffi_invoke_wide (f argc a)
  (if (= argc 8) (ffi-call "%call8" f (fw a 0) (fw a 1) (fw a 2) (fw a 3) (fw a 4) (fw a 5) (fw a 6) (fw a 7) 1)
  (if (= argc 9) (ffi-call "%call9" f (fw a 0) (fw a 1) (fw a 2) (fw a 3) (fw a 4) (fw a 5) (fw a 6) (fw a 7) (fw a 8) 1)
  (if (= argc 10) (ffi-call "%call10" f (fw a 0) (fw a 1) (fw a 2) (fw a 3) (fw a 4) (fw a 5) (fw a 6) (fw a 7) (fw a 8) (fw a 9) 1)
  (if (= argc 11) (ffi-call "%call11" f (fw a 0) (fw a 1) (fw a 2) (fw a 3) (fw a 4) (fw a 5) (fw a 6) (fw a 7) (fw a 8) (fw a 9) (fw a 10) 1)
  (if (= argc 12) (ffi-call "%call12" f (fw a 0) (fw a 1) (fw a 2) (fw a 3) (fw a 4) (fw a 5) (fw a 6) (fw a 7) (fw a 8) (fw a 9) (fw a 10) (fw a 11) 1)
  (if (= argc 13) (ffi-call "%call13" f (fw a 0) (fw a 1) (fw a 2) (fw a 3) (fw a 4) (fw a 5) (fw a 6) (fw a 7) (fw a 8) (fw a 9) (fw a 10) (fw a 11) (fw a 12) 1)
  (if (= argc 14) (ffi-call "%call14" f (fw a 0) (fw a 1) (fw a 2) (fw a 3) (fw a 4) (fw a 5) (fw a 6) (fw a 7) (fw a 8) (fw a 9) (fw a 10) (fw a 11) (fw a 12) (fw a 13) 1)
  (if (= argc 15) (ffi-call "%call15" f (fw a 0) (fw a 1) (fw a 2) (fw a 3) (fw a 4) (fw a 5) (fw a 6) (fw a 7) (fw a 8) (fw a 9) (fw a 10) (fw a 11) (fw a 12) (fw a 13) (fw a 14) 1)
    (ffi-call "%call16" f (fw a 0) (fw a 1) (fw a 2) (fw a 3) (fw a 4) (fw a 5) (fw a 6) (fw a 7) (fw a 8) (fw a 9) (fw a 10) (fw a 11) (fw a 12) (fw a 13) (fw a 14) (fw a 15) 1))))))))))
