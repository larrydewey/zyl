; Child processes: /bin/sh -c, cc, a compiled binary; clone(CLONE_VM|CLONE_VFORK) on its own stack, as posix_spawn.
(use base)
(use crypto)

(extern "malloc" (Int) Int)
(extern "free" (Int) Int)
(extern "zyl_rt_getenv" (Int) Int)
(extern "zyl_rt_envp" () Int)

(defmacro pr-ld64 (a) (ffi-call "%load64" a 1))
(defmacro pr-st64 (a v) (ffi-call "%store64" a v 1))

; A C int result, sign-extended.
(defn pr-int (x) (let v (bit-and x 4294967295) (if (> v 2147483647) (- v 4294967296) v)))

(defn pr-environ () (ffi-call "zyl_rt_envp" 1))

; Per-thread scratch: pid, status, argv[8], out_path[512].
(defn pr-scratch () (ffi-call "%tls" "proc_scratch" 592 1))
(defn pr-pid (s) s)
(defn pr-status (s) (+ s 8))
(defn pr-argv (s) (+ s 16))
(defn pr-out (s) (+ s 80))

; The exit status of the spawned child (spawn result rc), or -1; wait4 as waitpid, no EINTR retry.
(defn pr-wait (s rc)
  (if (not (= (pr-int rc) 0)) -1
    (if (< (pr-int (ffi-call "%syscall4" 61 (pr-int (ffi-call "%load32" (pr-pid s) 1)) (pr-status s) 0 0 1)) 0) -1
      (let st (ffi-call "%load32" (pr-status s) 1)
        (if (= (bit-and st 127) 0) (bit-and (shr st 8) 255) -1)))))

; --- spawn: a 64 KiB mapping holds the block, the PATH buffer and the child's stack ---
; block: file 0, argv 8, envp 16, logpath 24, usepath 32, err 40, PATH 48; buffer at 64; stack top at 65504.

(defn pr-map-size () 65536)
(defn pr-buf (k) (+ k 64))
(defn pr-buf-max () 4400)

; posix_spawn(p): 0 with the pid at s, else the errno (the failed child already reaped).
(defn pr-spawn (s file argv logp usepath)
  (let k (ffi-call "%syscall6" 9 0 (pr-map-size) 3 131106 -1 0 1)
    (if (and (< k 0) (> k -4096)) (- 0 k)
      (let _ (pr-st64 k file)
        (let _ (pr-st64 (+ k 8) argv)
          (let _ (pr-st64 (+ k 16) (pr-environ))
            (let _ (pr-st64 (+ k 24) logp)
              (let _ (pr-st64 (+ k 32) (if usepath 1 0))
                (let _ (pr-st64 (+ k 48) (if usepath (ffi-call "zyl_rt_getenv" (rt-w "PATH") 1) 0))
                  (let top (+ k 65504)
                    (let _ (pr-st64 top (ffi-call "%fn" "zyl_rt_spawn_child" 1))
                      (let _ (pr-st64 (+ top 8) 0)
                        (let _ (pr-st64 (+ top 16) k)
                          (pr-spawn-done s k (ffi-call "%syscall2" 56 16657 top 1)))))))))))))))

; The parent resumes once the child has exec'd or exited; its stack is then free.
(defn pr-spawn-done (s k pid)
  (let err (if (< pid 0) (- 0 pid) (pr-ld64 (+ k 40)))
    (let _ (if (and (> pid 0) (not (= err 0))) (ffi-call "%syscall4" 61 pid 0 0 0 1) 0)
      (let _ (if (and (> pid 0) (= err 0)) (ffi-call "%store32" s pid 1) 0)
        (let _ (ffi-call "%syscall2" 11 k (pr-map-size) 1) err)))))

; The child's clone returns here (the stub's ret pops it); rsi is the stack top. Syscalls only; never returns.
(defn zyl_rt_spawn_child (_flags top)
  (let k (pr-ld64 (+ top 16))
    (let lp (pr-ld64 (+ k 24))
      (let r (if (= lp 0) 0 (pr-redirect lp))
        (pr-die k (if (< r 0) r
                    (if (= (pr-ld64 (+ k 32)) 0)
                      (ffi-call "%syscall3" 59 (pr-ld64 k) (pr-ld64 (+ k 8)) (pr-ld64 (+ k 16)) 1)
                      (pr-execvp k (pr-ld64 k)))))))))

; posix_spawn's failure: the errno for the parent, then _exit(127).
(defn pr-die (k r) (let _ (pr-st64 (+ k 40) (- 0 r)) (let _ (ffi-call "%syscall1" 60 127 1) (pr-die k r))))

; addopen(1, lp, O_WRONLY|O_CREAT|O_TRUNC, 0644) then adddup2(1, 2); -errno on failure.
(defn pr-redirect (lp)
  (let fd (ffi-call "%syscall4" 257 -100 lp 577 420 1)
    (if (< fd 0) fd
      (let r (if (= fd 1) 0 (let d (ffi-call "%syscall2" 33 fd 1 1) (let _ (ffi-call "%syscall1" 3 fd 1) d)))
        (if (< r 0) r (let d (ffi-call "%syscall2" 33 1 2 1) (if (< d 0) d 0)))))))

(defn pr-has-slash (p) (let c (rt-ld8 p) (if (= c 0) false (if (= c 47) true (pr-has-slash (+ p 1))))))
(defn pr-strnlen (p n i) (if (or (>= i n) (= (rt-ld8 (+ p i)) 0)) i (pr-strnlen p n (+ i 1))))
(defn pr-chrnul (p c) (let b (rt-ld8 p) (if (or (= b 0) (= b c)) p (pr-chrnul (+ p 1) c))))

; glibc's __execvpex: no '/' searches PATH (unset: /bin:/usr/bin); -errno.
(defn pr-execvp (k f)
  (if (= (rt-ld8 f) 0) -2
    (if (pr-has-slash f) (ffi-call "%syscall3" 59 f (pr-ld64 (+ k 8)) (pr-ld64 (+ k 16)) 1)
      (let path (let p (pr-ld64 (+ k 48)) (if (= p 0) (rt-w "/bin:/usr/bin") p))
        (let fl (+ (pr-strnlen f 255 0) 1)
          (if (> fl 255) -36 (pr-path-loop k f fl path false)))))))

; Missing or not executable (EACCES, ENOENT, ESTALE, ENOTDIR, ENODEV, ETIMEDOUT) tries the next entry.
(defn pr-path-next-p (e) (or (= e 13) (or (= e 2) (or (= e 116) (or (= e 20) (or (= e 19) (= e 110)))))))

(defn pr-path-loop (k f fl subp got)
  (let p (pr-chrnul subp 58)
    (let el (- p subp)
      (let r2 (if (> (+ el (+ fl 1)) (pr-buf-max)) -36 (pr-exec-at k subp el f fl))
        (if (not (pr-path-next-p (- 0 r2))) r2
          (let g (or got (= r2 -13))
            (if (= (rt-ld8 p) 0) (if g -13 r2) (pr-path-loop k f fl (+ p 1) g))))))))

; dir ++ "/" ++ file (an empty dir is the file alone), then execve.
(defn pr-exec-at (k dir el f fl)
  (let b (pr-buf k)
    (let _ (rt-copy b dir el)
      (let _ (rt-st8 (+ b el) 47)
        (let _ (rt-copy (+ b (+ el (if (> el 0) 1 0))) f fl)
          (ffi-call "%syscall3" 59 b (pr-ld64 (+ k 8)) (pr-ld64 (+ k 16)) 1))))))

; /bin/sh -c cmd, so callers keep pipes, redirection and && as system() gave them.
(defn zyl_system_cmd (cmd)
  (let c (rt-w cmd)
    (if (= c 0) -1
      (let s (pr-scratch)
        (let a (pr-argv s)
          (let _ (pr-st64 a (rt-w "sh"))
            (let _ (pr-st64 (+ a 8) (rt-w "-c"))
              (let _ (pr-st64 (+ a 16) c)
                (let _ (pr-st64 (+ a 24) 0)
                  (pr-wait s (pr-spawn s (rt-w "/bin/sh") a 0 false)))))))))))

; --- zyl_exec_cmd: cmd as a /bin/sh script in $TMPDIR (else /tmp), then exec; returns only on failure ---

; snprintf's cut: the first lim-1 bytes of a ++ b.
(defn pr-cat2 (a b lim)
  (let la (rt-strlen a)
    (let lb (rt-strlen b)
      (let n (let t (+ la lb) (if (> t (- lim 1)) (- lim 1) t))
        (let p (ffi-call "malloc" (+ n 1) 1)
          (if (= p 0) 0
            (let ka (if (> la n) n la)
              (let _ (rt-copy p a ka)
                (let _ (rt-copy (+ p ka) b (- n ka)) (let _ (rt-st8 (+ p n) 0) p))))))))))

(defn pr-write-all (fd p len)
  (if (<= len 0) 0
    (let n (ffi-call "%syscall3" 1 fd p len 1)
      (if (> n 0) (pr-write-all fd (+ p n) (- len n)) (if (= n -4) (pr-write-all fd p len) 0)))))

(defn pr-write-str (fd w) (pr-write-all fd w (rt-strlen w)))

; mkstemp: the trailing XXXXXX become [a-zA-Z0-9] from getrandom; O_RDWR|O_CREAT|O_EXCL 0600, retried on EEXIST.
(defn pr-mkstemp (path)
  (let n (rt-strlen path)
    (if (or (< n 6) (not (rt-mem-eq (+ path (- n 6)) (rt-w "XXXXXX") 6))) -1
      (pr-mkstemp-try (+ path (- n 6)) path 238328))))

(defn pr-mkstemp-try (x path left)
  (if (= left 0) -1
    (let r (ffi-call "%tls" "proc_rand" 8 1)
      (if (not (= (zyl_random_fill r 8) 8)) -1
        (let _ (pr-fill-x x (pr-ld64 r) 0)
          (let fd (ffi-call "%syscall4" 257 -100 path 194 384 1)
            (if (>= fd 0) fd (if (= fd -17) (pr-mkstemp-try x path (- left 1)) -1))))))))

(defn pr-fill-x (x v i)
  (if (>= i 6) 0
    (let _ (rt-st8 (+ x i) (rt-ld8 (+ (rt-w "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789") (ffi-call "%urem" v 62 1))))
      (pr-fill-x x (ffi-call "%udiv" v 62 1) (+ i 1)))))

(defn zyl_exec_cmd (cmd)
  (let c (rt-w cmd)
    (let td (ffi-call "zyl_rt_getenv" (rt-w "TMPDIR") 1)
      (let path (pr-cat2 (if (= td 0) (rt-w "/tmp") td) (rt-w "/zyl_link_XXXXXX") 512)
        (if (= path 0) -1
          (let fd (pr-mkstemp path)
            (if (< fd 0) (let _ (ffi-call "free" path 1) -1)
              (let _ (pr-write-str fd (rt-w "#!/bin/sh\n"))
                (let _ (pr-write-str fd (if (= c 0) (rt-w "(null)") c))
                  (let _ (pr-write-str fd (rt-w "\n"))
                    (let _ (ffi-call "%syscall1" 3 fd 1)
                      (let _ (ffi-call "%syscall2" 90 path 493 1)
                        (let a (pr-argv (pr-scratch))
                          (let _ (pr-st64 a (rt-w "sh"))
                            (let _ (pr-st64 (+ a 8) path)
                              (let _ (pr-st64 (+ a 16) 0)
                                (let _ (ffi-call "%syscall3" 59 (rt-w "/bin/sh") a (pr-environ) 1)
                                  (let _ (ffi-call "%syscall1" 87 path 1)
                                    (let _ (ffi-call "free" path 1) -1)))))))))))))))))))

; --- cc: asm path to a binary next to it ---

; st_mtim of path into {sec, nsec} at out; false when stat fails.
(defn pr-mtime (path out)
  (let b (ffi-call "%tls" "proc_stat" 144 1)
    (if (not (= (ffi-call "%syscall2" 4 path b 1) 0)) false
      (let _ (pr-st64 out (pr-ld64 (+ b 88))) (let _ (pr-st64 (+ out 8) (pr-ld64 (+ b 96))) true)))))

(defn pr-cc-argv (a asm out)
  (let _ (pr-st64 a (rt-w "cc"))
    (let _ (pr-st64 (+ a 8) (rt-w "-no-pie"))
      (let _ (pr-st64 (+ a 16) asm)
        (let k (let _ (pr-st64 (+ a 24) (rt-w "rt.o")) 4)
          (let _ (pr-st64 (+ a (* k 8)) (rt-w "-o"))
            (let _ (pr-st64 (+ a (* (+ k 1) 8)) out)
              (let _ (pr-st64 (+ a (* (+ k 2) 8)) (rt-w "-lpthread")) (pr-st64 (+ a (* (+ k 3) 8)) 0)))))))))

; out = asm minus ".s", else asm ++ ".bin"; false when it would not fit 512 bytes.
(defn pr-out-path (asm out)
  (let len (rt-strlen asm)
    (if (and (>= len 2) (and (= (rt-ld8 (+ asm (- len 2))) 46) (= (rt-ld8 (+ asm (- len 1))) 115)))
      (if (>= (- len 2) 512) false (let _ (rt-copy out asm (- len 2)) (let _ (rt-st8 (+ out (- len 2)) 0) true)))
      (if (>= (+ len 4) 512) false
        (let _ (rt-copy out asm len) (let _ (rt-copy (+ out len) (rt-w ".bin") 5) true))))))

(defn zyl_cc_compile (path)
  (let asm (rt-w path)
    (if (= asm 0) -1
      (let s (pr-scratch)
        (if (not (pr-out-path asm (pr-out s))) -1
          (let _ (pr-cc-argv (pr-argv s) asm (pr-out s))
            (pr-wait s (pr-spawn s (rt-w "cc") (pr-argv s) 0 true))))))))

; The toolchain's stdout and stderr go to logpath (O_WRONLY|O_CREAT|O_TRUNC, 0644).
(defn zyl_cc_compile_log (path logpath)
  (let asm (rt-w path)
    (let lp (rt-w logpath)
      (if (or (= asm 0) (= lp 0)) -1
        (let s (pr-scratch)
          (if (not (pr-out-path asm (pr-out s))) -1
            (let _ (pr-cc-argv (pr-argv s) asm (pr-out s))
              (pr-wait s (pr-spawn s (rt-w "cc") (pr-argv s) lp true)))))))))

; Runs a compiled binary to completion; its exit status or -1.
(defn zyl_run_bin (path)
  (let b (rt-w path)
    (if (= b 0) -1
      (let s (pr-scratch)
        (let a (pr-argv s)
          (let _ (pr-st64 a b)
            (let _ (pr-st64 (+ a 8) 0)
              (pr-wait s (pr-spawn s b a 0 false)))))))))
