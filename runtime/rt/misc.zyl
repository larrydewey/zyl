; Raw memory for stdlib/allocator, the header-less str-append path, environment lookups.
(use base)
(use thread)
(use heap)
(use numeric)

(extern "zyl_rt_getenv" (Int) Int)

(defmacro rt-ld64 (a) (ffi-call "%load64" a 1))
(defmacro rt-st64 (a v) (ffi-call "%store64" a v 1))

(defn rt-note (msg) (let _ (rt-write-fd 2 (rt-w msg) (rt-strlen (rt-w msg))) 0))

; alloc-malloc memory may be handed to foreign C that free()s it: libc's allocator when hosted, the runtime's otherwise.
(defn zyl_mem_alloc (size)
  (let f (ffi-call "%fn-weak" "malloc" 1) (if (and (zyl_rt_hosted_p) (> f 0)) (ffi-call "%call1" f size 1) (zyl_rt_malloc size))))

(defn zyl_mem_free (ptr)
  (let f (ffi-call "%fn-weak" "free" 1) (let _ (if (and (zyl_rt_hosted_p) (> f 0)) (ffi-call "%call1" f ptr 1) (zyl_rt_free ptr)) 0)))
(defn zyl_mem_read (ptr) (if (= ptr 0) (rt-note "zyl: mem-read: null pointer\n") (rt-ld64 ptr)))
(defn zyl_mem_write (ptr value) (if (= ptr 0) (let _ (rt-note "zyl: mem-write: null pointer\n") value) (let _ (rt-st64 ptr value) value)))

; Writes byte b at index i (the terminator is not managed).
(defn zyl_cstr_byte_set (ptr i b)
  (if (or (= ptr 0) (< i 0)) 0 (if (< ptr 4096) (let _ (rt-bad-str ptr "cstr-byte-set") 0) (let _ (rt-st8 (+ ptr i) (bit-and b 255)) 0))))

; The variable's value, or 0 when unset.
(defn zyl_getenv (name) (ffi-call "zyl_rt_getenv" (rt-w name) 1))

; Regions are on unless ZYL_REGIONS=0 at compile time.
(defn zyl_regions_enabled ()
  (let e (ffi-call "zyl_rt_getenv" (rt-w "ZYL_REGIONS") 1) (not (and (> e 0) (and (= (rt-ld8 e) 48) (= (rt-ld8 (+ e 1)) 0))))))

; Page poisoning, off unless ZYL_REGION_POISON=1 (or 2).
;
; A region block goes back to its class pool on release and is handed out
; again on the next allocation of that size, so a stale pointer into a
; freed frame region does not fault: it reads whatever the next allocation
; wrote there. That is the worst shape a use-after-free can take in a
; bump allocator -- silent, and dependent on an allocation pattern nobody
; thought to test -- and it is exactly the property region inference is
; supposed to guarantee (docs/soundness.md L2).
;
; With this on, a released block is filled with 0xDE (rt-poison,
; runtime/rt/alloc.zyl) before it returns to the pool, so a stale read
; gets recognizable garbage instead of a plausible wrong answer.
;
; This comment used to describe mprotect(PROT_NONE) here, restored on
; reuse. That was tried and withdrawn: mprotect works in whole pages and
; rounds the length up, so protecting a pooled block whose class size is
; not a page multiple denies three still-live neighbours. No mprotect
; call exists in the runtime; the withdrawn attempt is recorded at the
; bottom of runtime/rt/alloc.zyl so nobody retries it blind, and
; docs/memory-poisoning-design.md is the write-up of the whole mechanism.
;
; Off by default: it costs a memset per released block, and the project's
; determinism and performance requirements outrank a debug aid. The
; poison gates (verify/poison.sh, verify/poison-selfhost.sh) turn it on.
;
; The level is read from the environment on every call -- zyl_rt_getenv
; scans `environ` and does not cache -- so the guard costs a short scan per
; block release and per block acquisition in a normal build. Only the fill
; is skipped; the scan is not. If that ever shows up in a benchmark,
; caching the level at startup is the fix, and it is a reseed.
(defn zyl_region_poison_enabled ()
  (> (zyl_region_poison_level) 0))

; 0 = off, 1 = fill released blocks with 0xDE, 2 = also disable the block
; pool (every block its own mmap, so release is a real munmap).
;
; Only the exact strings "1" and "2" enable anything: "true", "yes" and
; "3" all read as 0. A gate that silently measures nothing is worse than
; no gate, so the accepted spellings are deliberately narrow.
(defn zyl_region_poison_level ()
  (let e (ffi-call "zyl_rt_getenv" (rt-w "ZYL_REGION_POISON") 1)
    (if (= e 0)
      0
      (if (and (= (rt-ld8 e) 49) (= (rt-ld8 (+ e 1)) 0)) 1
        (if (and (= (rt-ld8 e) 50) (= (rt-ld8 (+ e 1)) 0)) 2 0)))))

; --- str-append without a StrBuf header: a per-thread 64-slot end cache {dst[64], end[64]} ---

(defn rt-lshr64 (x n) (bit-and (shr x n) (- (shl 1 (- 64 n)) 1)))

(defn rt-zsa-index (dst)
  (let x1 (rt-wmul (bit-xor dst (rt-lshr64 dst 33)) -49064778989728563)
    (let x2 (rt-wmul (bit-xor x1 (rt-lshr64 x1 33)) -4265267296055464877)
      (bit-and (bit-xor x2 (rt-lshr64 x2 33)) 63))))

(defn zyl_str_append_scan (dst src cap)
  (let c (ffi-call "%tls" "zsa" 1024 1)
    (let i (rt-zsa-index dst)
      (let d (if (= (rt-ld64 (+ c (* i 8))) dst) (rt-ld64 (+ (+ c 512) (* i 8))) (+ dst (rt-strlen dst)))
        (let n (rt-strlen src)
          (if (and (> cap 0) (> (+ (+ (- d dst) n) 1) cap)) (ffi-call "zyl_panic" "E_CODEGEN_BUFFER_LIMIT: codegen buffer limit exceeded" 1)
            (let _ (rt-copy d src n)
              (let _ (rt-st8 (+ d n) 0)
                (let _ (rt-st64 (+ c (* i 8)) dst) (let _ (rt-st64 (+ (+ c 512) (* i 8)) (+ d n)) dst))))))))))
