; Number text and escape decoding.
(use base)

;; Digits are produced from v <= 0 so INT64_MIN needs no special case.
(defn rt-ndigits (v) (rt-nd v -10 1))

(defn rt-nd (v t k) (if (or (> v t) (= k 19)) k (rt-nd v (* t 10) (+ k 1))))

; "00".."99", two bytes per pair.
(defn rt-digit-pairs () "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899")

; Writes the digits of v ending at offset k: two per division by 100.
(defn rt-put-digits (p v k)
  (if (<= v -100)
    (let q (/ v 100)
      (let r (- (* q 100) v)
        (let t (+ (rt-w (rt-digit-pairs)) (* r 2))
          (let _ (rt-st8 (+ p (- k 1)) (rt-ld8 t))
            (let _ (rt-st8 (+ p k) (rt-ld8 (+ t 1)))
              (rt-put-digits p q (- k 2)))))))
    (if (<= v -10)
      (let t (+ (rt-w (rt-digit-pairs)) (* (- 0 v) 2))
        (let _ (rt-st8 (+ p (- k 1)) (rt-ld8 t)) (rt-st8 (+ p k) (rt-ld8 (+ t 1)))))
      (rt-st8 (+ p k) (- 48 v)))))

(defn rt-int-text (n rp)
  (let v (if (> n 0) (- 0 n) n)
    (let sign (if (< n 0) 1 0)
      (let len (+ (rt-ndigits v) sign)
        (let p (rt-alloc (+ len 1) rp)
          (let _ (if (= sign 1) (rt-st8 p 45) 0)
            (let _ (rt-put-digits p v (- len 1))
              (let _ (rt-st8 (+ p len) 0) (ffi-call "%str" p 1)))))))))

(defn zyl_int_text (n) (rt-int-text n 0))
(defn zyl_int_text_r (n) (rt-int-text n (rt-cur-region)))

(defn rt-arena-str (arena n)
  (ffi-call "%word" (ffi-call "zyl_arena_alloc_zeroed" arena n 1) 1))

(defn zyl_cstr_sub (arena s start len)
  (let w (rt-w s)
    (if (or (= w 0) (or (< start 0) (< len 0))) (ffi-call "%str" 0 1)
      (if (< w 4096) (rt-bad-null w "cstr-sub")
        (let n (rt-strlen w)
          (let ln (if (> (+ start len) n) (if (< (- n start) 0) 0 (- n start)) len)
            (let p (rt-arena-str arena (+ ln 1))
              (let _ (rt-copy p (+ w start) ln) (let _ (rt-st8 (+ p ln) 0) (ffi-call "%str" p 1))))))))))

(defn zyl_cstr_from_int (arena value)
  (let t (rt-w (rt-int-text value 0))
    (let n (rt-strlen t)
      (let p (rt-arena-str arena (+ n 1))
        (let _ (rt-copy p t (+ n 1)) (ffi-call "%str" p 1))))))

(defn rt-llong-min () (- -9223372036854775807 1))

(defn rt-digit-of (c) (if (and (>= c 48) (<= c 57)) (- c 48) (if (and (>= c 97) (<= c 102)) (- c 87) (if (and (>= c 65) (<= c 70)) (- c 55) -1))))

; C's overflow tests, kept exactly (v stays positive, so the negative test never fires).
(defn rt-acc-ok (neg v digit base)
  (if neg (not (< v (/ (+ (rt-llong-min) digit) base))) (not (> v (/ (- 9223372036854775807 digit) base)))))

(defn rt-to-int-loop (p neg v)
  (let c (rt-ld8 p)
    (if (and (>= c 48) (<= c 57))
      (if (rt-acc-ok neg v (- c 48) 10) (rt-to-int-loop (+ p 1) neg (+ (* v 10) (- c 48))) 0)
      (if neg (- 0 v) v))))

(defn zyl_cstr_to_int (s)
  (let w (rt-w s)
    (if (= w 0) 0
      (if (< w 4096) (let _ (rt-bad-str w "cstr-to-int") 0)
        (if (= (rt-ld8 w) 45) (rt-to-int-loop (+ w 1) true 0) (rt-to-int-loop w false 0))))))

(defn rt-to-int-base-loop (p neg v base)
  (let d (rt-digit-of (rt-ld8 p))
    (if (or (< d 0) (>= d base))
      (if neg (- 0 v) v)
      (if (rt-acc-ok neg v d base) (rt-to-int-base-loop (+ p 1) neg (+ (* v base) d) base) 0))))

(defn rt-base-of (p)
  (if (= (rt-ld8 p) 48)
    (let c (rt-ld8 (+ p 1))
      (if (or (= c 120) (= c 88)) 16 (if (or (= c 111) (= c 79)) 8 (if (or (= c 98) (= c 66)) 2 10))))
    10))

(defn zyl_cstr_to_int_base (s)
  (let w (rt-w s)
    (if (= w 0) 0
      (if (< w 4096) (let _ (rt-bad-str w "cstr-to-int-base") 0)
        (let neg (= (rt-ld8 w) 45)
          (let p (if neg (+ w 1) w)
            (let base (rt-base-of p)
              (rt-to-int-base-loop (if (= base 10) p (+ p 2)) neg 0 base))))))))

(defn rt-ident-byte (c)
  (if (or (and (>= c 65) (<= c 90)) (or (and (>= c 97) (<= c 122)) (or (and (>= c 48) (<= c 57)) (= c 95)))) c 95))

(defn rt-sanitize-loop (d s i n)
  (if (>= i n) 0 (let _ (rt-st8 (+ d i) (rt-ident-byte (rt-ld8 (+ s i)))) (rt-sanitize-loop d s (+ i 1) n))))

(defn zyl_cstr_sanitize (arena s)
  (let w (rt-w s)
    (if (= w 0) (ffi-call "%str" 0 1)
      (if (< w 4096) (rt-bad-null w "cstr-sanitize")
        (let n (rt-strlen w)
          (let p (rt-arena-str arena (+ n 1))
            (let _ (rt-sanitize-loop p w 0 n) (ffi-call "%str" p 1))))))))

(defn rt-hexval (c) (if (and (>= c 48) (<= c 57)) (- c 48) (if (and (>= c 97) (<= c 102)) (- c 87) (if (and (>= c 65) (<= c 70)) (- c 55) -1))))

; The byte an escape \c stands for, or -1 (\x is handled apart).
(defn rt-escape-byte (c)
  (if (= c 110) 10 (if (= c 116) 9 (if (= c 114) 13 (if (= c 48) 0 (if (= c 34) 34 (if (= c 92) 92 (if (= c 101) 27 -1))))))))

(defn rt-hex-escape-ok (s i end)
  (and (< (+ i 3) end) (and (>= (rt-hexval (rt-ld8 (+ s (+ i 2)))) 0) (>= (rt-hexval (rt-ld8 (+ s (+ i 3)))) 0))))

; Returns the end offset in out, or -1 on a bad escape.
(defn rt-decode-loop (s i end out o)
  (if (>= i end) o
    (let c (rt-ld8 (+ s i))
      (if (= c 92)
        (if (>= (+ i 1) end) -1
          (let n (rt-ld8 (+ s (+ i 1)))
            (let e (rt-escape-byte n)
              (if (>= e 0)
                (let _ (rt-st8 (+ out o) e) (rt-decode-loop s (+ i 2) end out (+ o 1)))
                (if (and (= n 120) (rt-hex-escape-ok s i end))
                  (let _ (rt-st8 (+ out o) (+ (* 16 (rt-hexval (rt-ld8 (+ s (+ i 2))))) (rt-hexval (rt-ld8 (+ s (+ i 3))))))
                    (rt-decode-loop s (+ i 4) end out (+ o 1)))
                  -1)))))
        (let _ (rt-st8 (+ out o) c) (rt-decode-loop s (+ i 1) end out (+ o 1)))))))

(defn zyl_cstr_decode (arena s start end)
  (let w (rt-w s)
    (if (= w 0) (ffi-call "%str" 0 1)
      (if (< w 4096) (rt-bad-null w "cstr-decode")
        (let p (rt-arena-str arena (+ (+ (- end start) 1) 1))
          (let o (rt-decode-loop w start end p 0)
            (if (< o 0) (ffi-call "%str" 0 1) (let _ (rt-st8 (+ p o) 0) (ffi-call "%str" p 1)))))))))

(defn rt-count-nl (s i end n)
  (if (>= i end) n (let c (rt-ld8 (+ s i)) (if (= c 0) n (rt-count-nl s (+ i 1) end (if (= c 10) (+ n 1) n))))))

(defn zyl_cstr_count_newlines (s end)
  (let w (rt-w s)
    (if (= w 0) 0 (if (< w 4096) (let _ (rt-bad-str w "cstr-count-newlines") 0) (rt-count-nl w 0 end 0)))))

(defn rt-last-nl (s i) (if (< i 0) -1 (if (= (rt-ld8 (+ s i)) 10) i (rt-last-nl s (- i 1)))))

(defn zyl_cstr_last_newline (s end)
  (let w (rt-w s)
    (if (= w 0) -1 (if (< w 4096) (let _ (rt-bad-str w "cstr-last-newline") -1) (rt-last-nl w (- end 1))))))

(defn rt-escapes-loop (s i end)
  (if (>= i end) true
    (if (= (rt-ld8 (+ s i)) 92)
      (if (>= (+ i 1) end) false
        (if (>= (rt-escape-byte (rt-ld8 (+ s (+ i 1)))) 0) (rt-escapes-loop s (+ i 2) end)
          (if (and (= (rt-ld8 (+ s (+ i 1))) 120) (rt-hex-escape-ok s i end)) (rt-escapes-loop s (+ i 4) end) false)))
      (rt-escapes-loop s (+ i 1) end))))

(defn zyl_cstr_escapes_ok (s start end)
  (let w (rt-w s) (if (= w 0) false (rt-escapes-loop w start end))))
