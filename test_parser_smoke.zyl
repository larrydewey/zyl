(use allocator/allocator)
(use compiler/lexer)
(use compiler/parser)

(defn main ()
  (let arena (arena-create 0)
    (let ctx (zyl-parse arena "(defn add (a b) (+ a b))")
      (let pool (alloc-read-int ctx)
        (let prog (alloc-read-int (+ ctx 8))
          (begin
            (print "program kind: ")
            (print (pool-kind pool prog))
            (print "")
            (print "done")))))))