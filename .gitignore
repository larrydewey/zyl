# Build artifacts
/build/
/target

# Compiler output
*.bin
*.s
!build/boot/stage2.s
!build/boot/stage2.bin

# REPL / temporary test files
a.out
a.out.bin
a.out.s
out
henp
t.zyl
t.bin
t.s.s
.aider*

# Python (test scripts)
__pycache__/
*.pyc

# Package builds leave their artefacts beside the package (spec v5.0
# §31.12: the binary, its assembly, its buildinfo, and any native
# objects). The test fixtures under tests/packages-build/ are built by
# the suite, so only their sources belong in the repository.
tests/packages-build/*/app/build/
tests/packages-build/*/app/*.buildinfo
tests/packages-build/native/app/native
vendor/
zyl.lock
