(deftype Nums (End) (Link Int Nums))

(defn build (n acc)
  (if (= n 0) acc (build (- n 1) (Link n acc))))

(defn total (l)
  (match l
    (End 0)
    (Link h t (+ h (total t)))))

;; The list lives in the region; only the Int leaves it.
(defn region-total (n)
  (with-region (fixed :size 65536)
    (total (build n (End)))))

(defn main ()
  (print (region-total 1000))
  0)
