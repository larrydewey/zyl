(use allocator/allocator)

(defn main ()
  (let a (arena-create 0)
    (let src (alloc-malloc 32)
      (begin
        (alloc-write-int (+ src 0) (+ (* 10 8)))
        (alloc-write-int (+ src 8) (+ (* 9 8)))
        (ffi-call "zyl_cstr_byte_set" src 0 104)
        (ffi-call "zyl_cstr_byte_set" src 1 105)
        (ffi-call "zyl_cstr_byte_set" src 2 0)
        (print (ffi-call "zyl_cstr_byte_at" src 0 1000))
        (print (ffi-call "zyl_cstr_byte_at" src 1 1000))
        (print (ffi-call "zyl_cstr_byte_at" src 2 1000))
        (print (ffi-call "zyl_cstr_byte_at" src 5 1000))
        (let sub (ffi-call "zyl_cstr_sub" a src 1 2 1000))
        (print (ffi-call "zyl_cstr_byte_at" sub 0 1000))
        (let wn (ffi-call "zyl_cstr_to_int" src 1000))
        (print wn)
        (let s2 (ffi-call "zyl_cstr_from_int" a 12345 1000))
        (print (ffi-call "zyl_cstr_len" s2 1000))
        (let i 0)
        (begin
          (while (< i 5)
            (begin
              (print i)
              (set! i (+ i 1))))
          (print "done"))))))