{
  "name": "zyl",
  "displayName": "Zyl",
  "description": "Language support for Zyl: a deterministic Lisp systems language with region-based memory, capability types, and actor concurrency.",
  "version": "0.2.0",
  "publisher": "zyl-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "zyl",
    "lisp",
    "systems",
    "deterministic"
  ],
  "activationEvents": [
    "onLanguage:zyl",
    "workspaceContains:**/*.zyl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "zyl",
        "aliases": ["Zyl", "zyl"],
        "extensions": [".zyl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zyl",
        "scopeName": "source.zyl",
        "path": "./syntaxes/zyl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "zyl",
        "path": "./snippets/zyl.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "zyl",
        "scopes": {
          "keyword": ["keyword.control.zyl"],
          "function": ["entity.name.function.zyl"],
          "type": ["entity.name.type.zyl"],
          "enumMember": ["variable.other.enummember.zyl"],
          "property": ["variable.other.property.zyl"],
          "operator": ["keyword.operator.zyl"],
          "macro": ["entity.name.function.macro.zyl"],
          "comment": ["comment.line.semicolon.zyl"],
          "string": ["string.quoted.double.zyl"],
          "number": ["constant.numeric.zyl"]
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Zyl",
      "properties": {
        "zyl.lsp.enable": {
          "type": "boolean",
          "default": true,
          "description": "Run the Zyl language server. Turn this off to keep syntax highlighting and snippets without diagnostics or navigation."
        },
        "zyl.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the zyl-lsp binary. Leave empty to search $ZYL_HOME/bin, ~/.zyl/bin, the workspace's build/boot directory, and finally $PATH."
        },
        "zyl.lsp.arguments": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Extra arguments passed to the language server on start."
        },
        "zyl.lsp.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Log the JSON-RPC traffic between VS Code and the Zyl language server."
        },
        "zyl.inlayHints.parameterNames": {
          "type": "boolean",
          "default": true,
          "description": "Show parameter-name hints at call sites."
        },
        "zyl.compiler.path": {
          "type": "string",
          "default": "",
          "description": "Path to the zyl compiler, used by the build task. Leave empty to search $ZYL_HOME/bin, ~/.zyl/bin and $PATH."
        }
      }
    },
    "commands": [
      {
        "command": "zyl.restartLSP",
        "title": "Restart Language Server",
        "category": "Zyl"
      },
      {
        "command": "zyl.stopLSP",
        "title": "Stop Language Server",
        "category": "Zyl"
      },
      {
        "command": "zyl.evalDocument",
        "title": "Run Current File",
        "category": "Zyl"
      },
      {
        "command": "zyl.showServerLog",
        "title": "Show Language Server Log",
        "category": "Zyl"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "zyl.evalDocument",
          "when": "editorLangId == zyl",
          "group": "z_commands"
        }
      ],
      "commandPalette": [
        {
          "command": "zyl.evalDocument",
          "when": "editorLangId == zyl"
        }
      ]
    },
    "keybindings": [
      {
        "command": "zyl.evalDocument",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorLangId == zyl"
      }
    ],
    "configurationDefaults": {
      "[zyl]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",<>?",
        "editor.semanticHighlighting.enabled": true
      }
    },
    "taskDefinitions": [
      {
        "type": "zyl",
        "required": ["file"],
        "properties": {
          "file": {
            "type": "string",
            "description": "The .zyl file to compile."
          },
          "output": {
            "type": "string",
            "description": "Output binary path. Defaults to the source file without its extension."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.3.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0"
  }
}
