{
  "name": "zyl",
  "displayName": "Zyl",
  "description": "Language support for Zyl: a deterministic Lisp systems language with region-based memory, capability types, and actor concurrency.",
  "version": "0.4.0",
  "publisher": "zyl-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/larrydewey/zyl",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "zyl",
    "lisp",
    "systems",
    "deterministic"
  ],
  "activationEvents": [
    "onLanguage:zyl",
    "onLanguage:zyl-pkg",
    "workspaceContains:**/*.zyl",
    "workspaceContains:**/zyl.pkg"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "zyl",
        "aliases": ["Zyl", "zyl"],
        "extensions": [".zyl"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "zyl-pkg",
        "aliases": ["Zyl Package Manifest"],
        "filenames": ["zyl.pkg"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zyl",
        "scopeName": "source.zyl",
        "path": "./syntaxes/zyl.tmLanguage.json"
      },
      {
        "language": "zyl-pkg",
        "scopeName": "source.zyl.pkg",
        "path": "./syntaxes/zyl-pkg.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "zyl",
        "path": "./snippets/zyl.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "zyl",
        "scopes": {
          "keyword": ["keyword.control.zyl"],
          "function": ["entity.name.function.zyl"],
          "type": ["entity.name.type.zyl"],
          "enumMember": ["variable.other.enummember.zyl"],
          "property": ["variable.other.property.zyl"],
          "operator": ["keyword.operator.zyl"],
          "macro": ["entity.name.function.macro.zyl"],
          "comment": ["comment.line.semicolon.zyl"],
          "string": ["string.quoted.double.zyl"],
          "number": ["constant.numeric.zyl"]
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Zyl",
      "properties": {
        "zyl.lsp.enable": {
          "type": "boolean",
          "default": true,
          "description": "Run the Zyl language server. Turn this off to keep syntax highlighting and snippets without diagnostics or navigation."
        },
        "zyl.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the zyl-lsp binary. Leave empty to search $ZYL_HOME/bin, ~/.zyl/bin, the workspace's build/boot directory, and finally $PATH."
        },
        "zyl.lsp.arguments": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Extra arguments passed to the language server on start."
        },
        "zyl.lsp.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Log the JSON-RPC traffic between VS Code and the Zyl language server. Takes effect when the Zyl Language Server output channel's log level is Trace (Developer: Set Log Level)."
        },
        "zyl.inlayHints.parameterNames": {
          "type": "boolean",
          "default": true,
          "description": "Show parameter-name hints at call sites."
        },
        "zyl.compiler.path": {
          "type": "string",
          "default": "",
          "description": "Path to the zyl compiler, used by the build task. Leave empty to search $ZYL_HOME/bin, ~/.zyl/bin, the workspace's build/boot/zyl-self, and finally $PATH."
        }
      }
    },
    "commands": [
      {
        "command": "zyl.restartLSP",
        "title": "Restart Language Server",
        "category": "Zyl"
      },
      {
        "command": "zyl.stopLSP",
        "title": "Stop Language Server",
        "category": "Zyl"
      },
      {
        "command": "zyl.runCurrentFile",
        "title": "Run Current File",
        "category": "Zyl"
      },
      {
        "command": "zyl.showServerLog",
        "title": "Show Language Server Log",
        "category": "Zyl"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "zyl.runCurrentFile",
          "when": "editorLangId == zyl",
          "group": "z_commands"
        }
      ],
      "commandPalette": [
        {
          "command": "zyl.runCurrentFile",
          "when": "editorLangId == zyl"
        }
      ]
    },
    "keybindings": [
      {
        "command": "zyl.runCurrentFile",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorLangId == zyl"
      }
    ],
    "configurationDefaults": {
      "[zyl]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",<>?",
        "editor.semanticHighlighting.enabled": true
      }
    },
    "problemMatchers": [
      {
        "name": "zyl",
        "owner": "zyl",
        "source": "zyl",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": [
          {
            "regexp": "^(?:PANIC: )?(error|warning)\\[([A-Z0-9_]+)\\]: (.*)$",
            "severity": 1,
            "code": 2,
            "message": 3
          },
          {
            "regexp": "^\\s*--> (.*):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "zyl",
        "properties": {
          "file": {
            "type": "string",
            "description": "The .zyl file to compile."
          },
          "output": {
            "type": "string",
            "description": "Output binary path. Defaults to the source file without its extension."
          },
          "command": {
            "type": "string",
            "enum": ["build", "test", "fetch"],
            "description": "Package subcommand (spec §31.11), run from the directory holding zyl.pkg."
          },
          "package": {
            "type": "string",
            "description": "Directory holding the package's zyl.pkg."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "tsc -p ./ --noEmit && esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node20",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.1"
  }
}
