{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zyl",
  "scopeName": "source.zyl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#identifiers" },
    { "include": "#parens" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.zyl",
          "match": ";.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zyl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.zyl",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zyl",
          "match": "\\b(if|while|for|cond|begin|match|try|catch|spawn|send|ffi-call|ffi-pin|ffi-unpin|assert|error|unwrap|defn|let|let-mut|set!|def|deftype|defstruct|defstruct\\+|alias|trait|impl|derive|use|export|module|fn|lambda|with-resource|test-suite|test|assert-equal|assert-fail|assert-true|assert-false|test-property|setup|teardown|run-tests|test-compile|requires|ensures|invariant|recover|checkpoint|contracts|pub|error)\\b"
        },
        {
          "name": "keyword.operator.zyl",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.zyl",
          "match": "\\b(print|read-line|exit|close|file-open|file-read|file-write|file-close|buf-append|len|vec|map|tuple|str-concat|str-substring|str-length|str-eq|str-intern|int?|float?|bool?|string?|struct?|alias?|list-head|list-tail|list-length|list-reverse|list-map|list-filter|vec-push|vec-pop|map-get|map-put|map-remove|map-keys|map-values)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.zyl",
          "match": "\\b(Int|Float|Bool|String|Unit|Vec|Map|Result|Option|List|Array|Tuple|Struct|Alias|TCap|TMut|TAtomic|TBox|TPin|TFun|CapKind|TCCap|TCMut|TCAtomic|TCBox|TCPin)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.zyl",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.zyl",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.zyl",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.zyl",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.zyl",
          "match": "="
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.parameter.zyl",
          "match": "\\b[a-z_][a-zA-Z0-9_'-]*\\b"
        },
        {
          "name": "entity.name.type.zyl",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "variable.other.zyl",
          "match": "\\b[a-z_][a-zA-Z0-9_'-]*\\b"
        }
      ]
    },
    "parens": {
      "patterns": [
        {
          "name": "punctuation.section.parens.begin.zyl",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.zyl",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.zyl",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.zyl",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.braces.begin.zyl",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.zyl",
          "match": "\\}"
        }
      ]
    }
  }
}