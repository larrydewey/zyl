{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zyl",
  "scopeName": "source.zyl",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#definitions"
    },
    {
      "include": "#keyword-atoms"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#special-forms"
    },
    {
      "include": "#bitwise"
    },
    {
      "include": "#byte-ops"
    },
    {
      "include": "#atomics"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#capabilities"
    },
    {
      "include": "#regions"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#ffi-symbols"
    },
    {
      "include": "#constructors"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.zyl",
          "begin": ";",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.zyl"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zyl",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.zyl"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.zyl"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.zyl",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "match": "(\\()\\s*(defn|fn|macro|defmacro)\\s+([^\\s()\\[\\]{}\";]+)",
          "captures": {
            "1": {
              "name": "punctuation.section.parens.begin.zyl"
            },
            "2": {
              "name": "storage.type.function.zyl"
            },
            "3": {
              "name": "entity.name.function.zyl"
            }
          }
        },
        {
          "match": "(\\()\\s*(deftype|defstruct\\+|defstruct|trait|alias)\\s+([^\\s()\\[\\]{}\";]+)",
          "captures": {
            "1": {
              "name": "punctuation.section.parens.begin.zyl"
            },
            "2": {
              "name": "storage.type.class.zyl"
            },
            "3": {
              "name": "entity.name.type.zyl"
            }
          }
        },
        {
          "match": "(\\()\\s*(impl)\\s+([^\\s()\\[\\]{}\";]+)\\s+([^\\s()\\[\\]{}\";]+)",
          "captures": {
            "1": {
              "name": "punctuation.section.parens.begin.zyl"
            },
            "2": {
              "name": "storage.type.class.zyl"
            },
            "3": {
              "name": "entity.name.type.zyl"
            },
            "4": {
              "name": "entity.other.inherited-class.zyl"
            }
          }
        },
        {
          "match": "(\\()\\s*(def)\\s+([^\\s()\\[\\]{}\";]+)",
          "captures": {
            "1": {
              "name": "punctuation.section.parens.begin.zyl"
            },
            "2": {
              "name": "storage.type.zyl"
            },
            "3": {
              "name": "variable.other.constant.zyl"
            }
          }
        },
        {
          "match": "(\\()\\s*(use)\\s+([A-Za-z0-9_/+-]+)",
          "captures": {
            "1": {
              "name": "punctuation.section.parens.begin.zyl"
            },
            "2": {
              "name": "keyword.control.import.zyl"
            },
            "3": {
              "name": "entity.name.namespace.zyl"
            }
          }
        }
      ]
    },
    "keyword-atoms": {
      "patterns": [
        {
          "name": "constant.other.keyword.zyl",
          "match": ":[A-Za-z][A-Za-z0-9_-]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.zyl",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.octal.zyl",
          "match": "\\b0o[0-7_]+\\b"
        },
        {
          "name": "constant.numeric.binary.zyl",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.zyl",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.zyl",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "special-forms": {
      "patterns": [
        {
          "name": "keyword.control.zyl",
          "match": "(?<![^\\s()\\[\\]{}\";])(defn|def|let|let-mut|set!|fn|lambda|if|cond|when|while|for|match|begin|try|catch|unwrap|error|assert|range|with-resource|deftype|defstruct\\+|defstruct|struct-get|make-struct|make-variant|trait|impl|derive|defmacro|macro|alias|use|module|export|print|read-line|exit|close|file-open|file-read|file-write|file-close|buf-append|spawn|send|ffi-call|ffi-pin|ffi-unpin|requires|ensures|contracts|recover|checkpoint|invariant|test-suite|test-property|test-compile|test|assert-equal|assert-true|assert-false|assert-fail|setup|teardown|run-tests)(?![^\\s()\\[\\]{}\";])"
        }
      ]
    },
    "bitwise": {
      "patterns": [
        {
          "name": "keyword.operator.bitwise.zyl",
          "match": "(?<![^\\s()\\[\\]{}\";])(bit-and|bit-or|bit-xor|bit-not|ashr|shl|shr)(?![^\\s()\\[\\]{}\";])"
        }
      ]
    },
    "byte-ops": {
      "patterns": [
        {
          "name": "support.function.byte.zyl",
          "match": "(?<![^\\s()\\[\\]{}\";])(byteslice-sub|byteslice|bytebuf-append|bytebuf-len|bytebuf-cap|bytebuf-ptr|bytebuf|align-check|byte|load-u8|load-i8|load-u16|load-i16|load-u32|load-i32|load-u64|load-i64|store-u8|store-i8|store-u16|store-i16|store-u32|store-i32|store-u64|store-i64)(?![^\\s()\\[\\]{}\";])"
        }
      ]
    },
    "atomics": {
      "patterns": [
        {
          "name": "support.function.atomic.zyl",
          "match": "(?<![^\\s()\\[\\]{}\";])(bytebuf-atomic-fetch-add|bytebuf-atomic-load|bytebuf-atomic-store|bytebuf-atomic-add|bytebuf-atomic-sub|bytebuf-atomic-cas|bytebuf-atomic-max|bytebuf-atomic-min)(?![^\\s()\\[\\]{}\";])"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.zyl",
          "match": "(?<![^\\s()\\[\\]{}\";])(str-concat|str-substring|str-length|str-len|str-eq|str-intern|declassify|ct-eq-bool|ct-eq-words-bool|ct-declassify|list-length|list-reverse|list-append|list-map|list-filter|list-nth|car|cdr|cadr|caddr|cddr|list-rest|is-nil|map-get|map-insert|map-remove|map-has|map-new|map-entries|vec-get|vec-set|vec-push|vec-pop|arena-create|arena-alloc|arena-reset|arena-destroy|min|max|abs|clamp|signum|square|cube|identity|compose|flip|apply)(?![^\\s()\\[\\]{}\";])"
        }
      ]
    },
    "capabilities": {
      "patterns": [
        {
          "name": "storage.modifier.capability.zyl",
          "match": "\\b(Secret|TCap|TMut|TAtomic|TBox|TPin|TFun)\\b"
        }
      ]
    },
    "regions": {
      "patterns": [
        {
          "name": "storage.modifier.region.zyl",
          "match": "\\b(Stack|Heap|Global|Circular|Pin)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.zyl",
          "match": "\\b(Int|Float|Bool|String|Unit|List|Option|Result|Vec|Map|Array|Tuple)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.zyl",
          "match": "\\b(true|false|Nil|Cons|Some|None|Ok|Err)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.zyl",
          "match": "(?<![^\\s()\\[\\]{}\";])(and|or|not)(?![^\\s()\\[\\]{}\";])"
        },
        {
          "name": "keyword.operator.comparison.zyl",
          "match": "(?<![^\\s()\\[\\]{}\";])(!=|<=|>=|=|<|>)(?![^\\s()\\[\\]{}\";])"
        },
        {
          "name": "keyword.operator.arithmetic.zyl",
          "match": "(?<![^\\s()\\[\\]{}\";])([+*/%-])(?![^\\s()\\[\\]{}\";])"
        }
      ]
    },
    "ffi-symbols": {
      "patterns": [
        {
          "match": "(ffi-call)\\s+(\"[^\"]*\")",
          "captures": {
            "1": {
              "name": "keyword.control.zyl"
            },
            "2": {
              "name": "entity.name.function.ffi.zyl"
            }
          }
        }
      ]
    },
    "constructors": {
      "patterns": [
        {
          "name": "entity.name.type.zyl",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.zyl",
          "match": "(?<![^\\s()\\[\\]{}\";])[a-z_][A-Za-z0-9_'+*/<>=!?-]*"
        }
      ]
    }
  }
}
