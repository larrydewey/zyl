{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*;\\s*#region\\b",
      "end": "^\\s*;\\s*#endregion\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^.*\\([^)\"]*\"?$",
    "decreaseIndentPattern": "^\\s*\\)"
  },
  "wordPattern": "[^\\s()\\[\\]{}\";]+",
  "onEnterRules": [
    {
      "beforeText": "^\\s*;.*$",
      "action": { "indent": "none", "appendText": "; " }
    }
  ]
}
